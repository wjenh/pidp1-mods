#ifndef SKIPMACROS_AH
#define SKIPMACROS_AH
// Various defines to reduce confusion over skip use.
// These are primarily for Claude to avoid confusion with modern compiler if/then assumptions.

// ---- sza (skip-group, `i`-invertible): skip if AC == 0 / AC != 0 -------
#define SKIP_NEXT_IF_AC_ZERO sza
#define SKIP_NEXT_IF_AC_NOT_ZERO sza i

// ---- spa (skip-group, `i`-invertible): skip if AC's sign bit is clear
// "positive" includes +0, matching this project's existing spa
// usage (see the NAMING note above).
#define SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO spa
#define SKIP_NEXT_IF_AC_NOT_POSITIVE_OR_ZERO spa i

// ---- sma (skip-group, `i`-invertible): skip if AC's sign bit is set
// "negative" includes -0 (see the NAMING note above; also see
// DECISIONS.md's sub/sma -0 caution before using this in a range
// comparison rather than a bare sign test).
#define SKIP_NEXT_IF_AC_NEGATIVE sma
#define SKIP_NEXT_IF_AC_NOT_NEGATIVE sma i

// ---- szf (skip-group, `i`-invertible, takes a flag-number operand) -----
#define SKIP_NEXT_IF_FLAG_SET szf i
#define SKIP_NEXT_IF_FLAG_CLEAR szf

// ---- szs (skip-group, `i`-invertible, takes a sense-switch-number operand) ----
#define SKIP_NEXT_IF_SWITCH_SET szs i
#define SKIP_NEXT_IF_SWITCH_CLEAR szs

// Combined sma sza, NOT i invertable: skip if the AC is zero or negative
// "negative" includes -0.
#define SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE sma sza

// ---- sad / sas (memory-reference equality pair, NOT `i`-invertible) --
// `i` on these means indirect addressing, never inversion; a stray
// trailing `i` after either macro below still means indirect addressing,
// completely unrelated to which of the two macros was chosen. To invert
// an equality skip, use the OTHER macro, exactly as CODING.md section 1
// already documents for the raw opcodes.
#define SKIP_NEXT_IF_DIFFERENT sad     // skip if AC != operand
#define SKIP_NEXT_IF_SAME sas          // skip if AC == operand

#endif
