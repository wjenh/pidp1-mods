#ifndef GETALN_AH
#define GETALN_AH

// Read a line of ascii characters into the memory address passed in the IO register.
// One character is placed in each word.
// The line is terminated by the null character, 0, and the line terminatior (nl or cr) dropped.
// The memory area is not bounds checked!
// The current DCS2 channel is used.
// If an error occurs, the IO register will have the DCS2 rcs error code, else 0.
// The AC register is preserved.
// Call via jda getaln.
// Can be called cross-bank.
// If so, IO must contain the full 16 bit address to use.

#include <DCS/dcs2defs.ah>
#include <DCS/getach.ac>

getaln,  0
local rtn, next, loop, done, bad, mem
        dac rtn
        // We need to determine if eem is on.
        // If not, both the return address and the buffer address
        // need to be masked to 12 bits to avoid colliding with the
        // indirect bit which will also be set if the current bank is an odd number.
        and [0200000
        sza
        jmp next        // eem is on, ok to continue
        lai             // off, mask the addresses
        and [07777]
        lac rtn
        and [07777]
        dac rtn
next,   dio mem
loop,   jda getach
        lai
        sza i
        jmp loop
        spa
        jmp bad
        dio i mem
        sad ['\r'
        jmp done
        sad ['\n'
        jmp done
        idx mem
        jmp loop
done,   cli
// overwrite the cr or lf with 0
        dzm i mem
bad,    lac getaln
        jmp i rtn
rtn, 0
mem, 0
    endloc

#endif
