#ifndef GETLIN_AH
#define GETLIN_AH

// Read a line of characters into the memory address passed in the IO register.
// One character is placed in each word.
// The line is terminated by the nl character, flxnl, 077.
// The memory area is not bounds checked!
// The current DCS2 channel is used.
// If an error occurs, the IO register will have the DCS2 error code, else 0.
// The AC register is preserved.
// Call via jda getlin.

#include <DCS/dcs2defs.ah>
#include <DCS/getch.ac>

getlin,  0
    local rtn, mem, loop, done, bad
    dac rtn
    dio mem
    // We need to check for eem on.
    // If not, addresses must be masked to 12 bits.
    and [0200000
    sza      // on, ok to proceed
    jmp loop
    lac rtn
    and [07777
    dac rtn
    lai             // the buffer address is still in IO
    and [07777
    dac mem
loop,
    jda getch
    lai
    sad [flxerr
    jmp bad
    dio i mem
    law flxnl
    sad i mem
    jmp done
    idx mem
    jmp loop
done,
    lac getlin
    cli
    jmp i rtn
bad,
    rle
    lac getlin
    jmp i rtn
rtn,  0
mem,  0
    endloc

#endif
