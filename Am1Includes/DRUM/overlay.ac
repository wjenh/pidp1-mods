// The drum overlay manager.
// It loads an overlay into its window from the drum when
// it is called and the overlay is not resident, then calls the entry.
// This is specifically for use with am1's %%ovcall,
// see Docs/UsingOverlays.md.
// For am1's %%ovload it loads the overlay the same way and calls nothing,
// returning the address of the symbol named in AC.
//
// Include it once in the root of a program with overlays, in any bank, before
// the first %%ovcall or %%ovload.
//
// Each transfer polls cks for the drum's end with breaks left as they are.
// The drum automatically requests a break at the end of every transfer, so a program running with
// breaks on needs a handler for the drum's channel or turn it off before using %%ovcall.
//
// Defines ovEnter, ovFetch, ovInit, the in-an-overlay flag ovActive, the retry count
// ovRetries, the error hook ovErrHook, and the error halts ovErrNest,
// ovErrStamp, ovErrDrum and ovErrSwap, each stopping with its OV_ERR_ number in AC.
// A program that must not halt sets ovErrHook to a full address and on an error
// the manager jumps there instead of halting.
// See Docs/UsingOverlays.md, "When the manager halts".
//
// A persistent overlay is written back when it is evicted, in one of two ways, chosen
// per window by its %%window line:
// - a swap, the default, one transfer reads the incoming overlay as it writes the
//   outgoing one, using the drum's simultaneous read and write;
// - in a window declared twopass, the outgoing overlay is written back in a transfer of
//   its own, then the incoming one is read.
// Slower, but each transfer is made again
//   after a halt, so a stop mid-eviction loses nothing.
// The outgoing overlay's table entry says which, by OV_TWOPASS.
// OV_TWO_PASS, which once chose two passes for a whole program, is an error.
//
// A call to a resident overlay reads only the entry's resident word and touches neither IO
// nor the drum; the first entry's address is found at the first call and kept.
//
// 12-Oct-2026 Claude: written, with am1's drum overlays.
// 12-Oct-2026 Claude: the error hook, ovErrHook.
// 12-Oct-2026 Claude: the single-pass swap, OV_SINGLE_PASS.
// 19-Oct-2026 wje rework to deal with the Type 340 display dra overlap.
// 19-Oct-2026 wje single pass, i.e. simultaneous read/write, now the default.
// 21-Oct-2026 Claude: ovFetch, for am1's %%ovload.
// 22-Oct-2026 Claude: both evictions, chosen per window by twopass; OV_TWO_PASS is an error.
// 22-Oct-2026 Claude: the resident path about halved: the tail chosen by dap, the first
//    entry found once, IO kept only on the load path, the entry's other words read only for
//    a transfer, dra's error tested in IO.
// 23-Oct-2026 wje cleanup

#ifndef OVERLAY_AC
#define OVERLAY_AC

#ifdef OV_TWO_PASS
#error OV_TWO_PASS is no longer supported, use window's twopass option
#endif

// Transparently handle the drum/type340 dra conflict.
#define _OVL_dia iot 61
#define _OVL_dwc iot 62
#define _OVL_dra iot 2062
#define _OVL_dcl iot 63

#ifndef DRUMDEFS_AH
#include <DRUM/type23alt.ah>
#endif

#include <DRUM/overlay.ah>

    local ovRtn, ovArg, ovEnt, ovEntry, ovWant, ovFirst, ovPtr, \
        ovRes, ovTblP, ovInitR, ovBegin, ovFetched, ovFind, ovFindNext, ovFindX, \
        ovEvict, ovLoad, ovLoaded, ovRun, ovRunCall, \
        ovXfer, ovXferStart, ovXferIdle, ovXferBusy, ovXferX, ovXferBad, \
        ovXDia, ovXDwc, ovXDcl, ovTries, \
        ovFailNest, ovFailStamp, ovFailDrum, ovErrTo, ovErrToX, ovErrHooked
    addlocal ovFailSwap, ovSwapN, ovWriteBack

// The %%ovcall entry.
// Makes the overlay resident if it is not, then calls the entry point.
// Entry: AC is the jsp return, the address of two data words, a full 16 bit address,
// of the overlay's table entry, followed by the entry point.
// IO is the argument for the entry.
// Exit: AC and IO are as the entry returned them, returns past the data
// words with eem on.
// Called via jsp, or eem and jsp i from another bank.
// The entry is called by jsp i with eem on with IO unchanged and returns with eem on.
ovEnter,
    dac ovRtn
    law ovRunCall
    jmp ovBegin

// The %%ovload entry.
// It only makes the overlay resident if it is not, it calls nothing.
// Entry: AC is the  the address of two data words, the full address
// of the overlay's table entry, and then of the symbol.
// Exit: AC is the symbol's full address, IO is preserved; returns past the data
// words with eem on.
// Called via jsp, or eem and jsp i from another bank.
ovFetch,
    dac ovRtn
    law ovFetched

    // Both entries, AC the tail to take once the overlay is resident, the body
    // ovEnter describes.
    // Nothing up to the resident test touches IO.
ovBegin,
    dap ovRun
    lac ovActive
    sza
    jmp ovFailNest
    eem

    // The two data words; ovRtn becomes the return.
    lac i ovRtn
    dac ovEnt
    idx ovRtn
    lac i ovRtn
    dac ovEntry
    idx ovRtn

    // The overlay's number, from its entry's place among the entries.
    lac ovFirst
    sza i                   // skip once the first entry is known
    jsp ovFind
    lac ovEnt
    sub ovFirst
    sar 2s                  // OV_ENT_WORDS words an entry
    add [1]
    dac ovWant

    // The window's word, through the entry's OV_ENT_RES.
    // Resident already: take the tail.
    // None resident: load it.
    law OV_ENT_RES
    add ovEnt
    dac ovPtr
    lac i ovPtr
    dac ovRes
    lac i ovRes
    sad ovWant              // skip if another, or none
    jmp ovRun
    dio ovArg
    sza i                   // skip if another
    jmp ovLoad

    // Another is resident, its number in AC.
    // Persistent, write it back from its entry first, the read bit dropped,
    // the write bit and track given to dwc, and its length kept in ovSwapN.
ovEvict,
    sub [1]
    ral 2s                  // OV_ENT_WORDS words an entry
    add ovFirst
    dac ovPtr
    lac i ovPtr
    and [OV_DIA_TRACK]
    ior [OV_DWC_WRITE]
    dac ovXDwc
    lac i ovPtr
    and [OV_DIA_ADDR]
    dac ovXDia
    idx ovPtr
    lac i ovPtr
    dac ovSwapN
    idx ovPtr
    lac i ovPtr
    dac ovXDcl
    idx ovPtr
    lac i ovPtr
    sma                     // skip if persistent
    jmp ovLoad
    ral 1s                  // OV_TWOPASS, bit 1, to the sign
    spa                     // skip unless its window is twopass
    jmp ovWriteBack

    // The swap.
    // One transfer reads the incoming overlay into the window as it
    // writes the outgoing one to its track.
    // Am1 puts every overlay of a swap window at the same drum address,
    // and ovXDcl, the outgoing one's dcl word is the same for incoming and outgoing data.
    // The count is the longer length, 0 for an entire track.
    lac ovSwapN
    add [OV_DWC_LENGTH]     // the length less one, carried out of the field
    and [OV_DWC_LENGTH]
    dac ovSwapN
    lac ovEnt
    dac ovPtr
    idx ovPtr               // the incoming entry's OV_ENT_DWC
    lac i ovPtr
    add [OV_DWC_LENGTH]
    and [OV_DWC_LENGTH]
    sub ovSwapN
    spa                     // skip if the incoming one's is the longer
    cla
    add ovSwapN
    add [1]
    and [OV_DWC_LENGTH]     // a whole track 0 again
    ior ovXDwc
    dac ovXDwc
    lac i ovEnt
    dac ovXDia

    // As for a read, the window holds nothing until the header is checked.
    // A swap that ends in error is not made again (ovXferBad).
    dzm i ovRes
    jsp ovXfer
    jmp ovLoaded

    // A twopass window, the outgoing overlay written at its
    // drum address and length, its words still in core and the window
    // still naming it; a failed write is made again as a read is.
ovWriteBack,
    lac ovSwapN
    ior ovXDwc
    dac ovXDwc
    jsp ovXfer

    // Read it from its entry in order OV_ENT_DIA, OV_ENT_DWC, OV_ENT_DCL.
    // The window is marked as holding nothing until the header is checked, a halt
    // from here on leaves nothing resident.
ovLoad,
    dzm i ovRes
    lac i ovEnt
    dac ovXDia
    lac ovEnt
    dac ovPtr
    idx ovPtr
    lac i ovPtr
    dac ovXDwc
    idx ovPtr
    lac i ovPtr
    dac ovXDcl
    jsp ovXfer

    // The header, OV_HDR_STAMP at the window's first word, must match the
    // table's stamp, and OV_HDR_NUMBER the overlay's number.
ovLoaded,
    lac i ovXDcl
    sas i ovTblP            // skip if the stamps agree
    jmp ovFailStamp
    law OV_HDR_NUMBER
    add ovXDcl
    dac ovPtr
    lac i ovPtr
    sas ovWant              // skip if the numbers agree
    jmp ovFailStamp
    lac ovWant
    dac i ovRes
    lio ovArg

    // Resident: the tail the entry chose, eem on.
ovRun,
    jmp .
ovRunCall,
    idx ovActive            // 0 to 1, the nesting check having passed
    jsp i ovEntry
    dzm ovActive
    eem
    jmp i ovRtn

    // An %%ovload.
ovFetched,
    lac ovEntry
    jmp i ovRtn

// The first entry's address loaded into ovFirst.
// The entries begin at the first table word past the stamp with the
// sign set.
// A window's word holds a number, an entry's first word OV_DIA_READ.
// The table does not move while the program is in core and
// a load of the program sets ovFirst back to 0.
// IO is preserved, AC is not.
// Called via jsp, from this bank only, with eem on.
ovFind,
    dap ovFindX
    lac ovTblP
    dac ovPtr
ovFindNext,
    idx ovPtr
    lac i ovPtr
    sma                     // skip at the first entry
    jmp ovFindNext
    lac ovPtr
    dac ovFirst
ovFindX,
    jmp .

// One drum transfer of ovXDia, ovXDwc, and ovXDcl.
// It is made when the drum is idle and waits for the transfer to complete.
// One that ends in error is made again counting each in ovRetries, OV_TRIES in all before ovErrDrum.
// A swap that ends in error goes to ovFailSwap instead and is never made again.
// AC and IO are not preserved.
// Called via jsp, from this bank only.
ovXfer,
    dap ovXferX
ovXferStart,
    law i OV_TRIES
    dac ovTries
ovXferIdle,
    cks
    rir 1s                  // the busy bit, bit 17, to the sign
    spi                     // skip if the drum is idle
    jmp ovXferIdle
    lio ovXDia
    _OVL_dia
    lio ovXDwc
    _OVL_dwc
    lio ovXDcl
    _OVL_dcl
ovXferBusy,
    cks
    rir 1s
    spi                     // skip once the transfer is over
    jmp ovXferBusy
    cli
    _OVL_dra
    spi                     // skip if it ended without error, dra's bit 0
    jmp ovXferBad
ovXferX,
    jmp .
ovXferBad,
    // A swap is the one transfer that both reads and writes.
    lac ovXDia
    and ovXDwc
    spa                     // skip unless a swap
    jmp ovFailSwap
    isp ovTries             // skip after the last try
    jmp .+2
    jmp ovFailDrum
    idx ovRetries
    jmp ovXferIdle

// Makes the manager ready at a program's start: no overlay running, no retry counted.
// The windows' words are kept since what they say the windows hold
// is still there, and so is ovErrHook, which the program sets.
// IO is preserved, AC is not.
// Returns with eem on.
// Called via jsp, or farjsp from another bank.
ovInit,
    dac ovInitR
    dzm ovActive
    dzm ovRetries
    eem
    jmp i ovInitR

// An error, transfer to the program's hook if ovErrHook is set else back past the
// jda into the error's halt.
// Entry: AC is the OV_ERR_ number, stored by the jda.
// Exit, to the hook: AC the number, IO the failing %%ovcall's or %%ovload's return
// past its data words, ovActive 0, eem on; the hook never returns here.
// Back, with no
// hook: AC the number, IO preserved.
// Called via jda, from this bank only.
ovErrTo, 0
    dap ovErrToX
    lac ovErrHook
    sza                     // skip unless a hook is set
    jmp ovErrHooked
    lac ovErrTo
ovErrToX,
    jmp .
ovErrHooked,
    dzm ovActive
    lio ovRtn
    lac ovErrTo
    eem
    jmp i ovErrHook

// Each error goes first to ovErrTo, then falls into its halt, each halt with
// its OV_ERR_ number in AC.
// An %%ovcall or %%ovload while an overlay runs; there is no going on.
// It has not yet stepped ovRtn past the two data words, as the others have.
ovFailNest,
    idx ovRtn
    idx ovRtn
    law OV_ERR_NEST
    jda ovErrTo
ovErrNest,
    hlt
    jmp ovErrNest
// The header read is not this build's, or not this overlay's, the drum holds
// another build's overlays.
// Continue reads it again, as after ovlload.
ovFailStamp,
    law OV_ERR_STAMP
    jda ovErrTo
ovErrStamp,
    hlt
    jmp ovLoad
// A transfer failed OV_TRIES times.
// Continue tries it OV_TRIES times again.
ovFailDrum,
    law OV_ERR_DRUM
    jda ovErrTo
ovErrDrum,
    hlt
    jmp ovXferStart
// A swap ended in error, after a halt part-way.
// The outgoing overlay's wordsare lost, its track holding new words up
// to where the transfer stopped and those of its last eviction after.
// Continue reads the incoming overlay alone, a read made again as any read is.
ovFailSwap,
    law OV_ERR_SWAP
    jda ovErrTo
ovErrSwap,
    hlt
    jmp ovLoad

// The in-an-overlay flag, and every transfer made again since ovInit.
ovActive, 0
ovRetries, 0
// The error hook: 0 to halt on an error, else the full address to go to.
ovErrHook, 0

ovTblP, ovTable:*           // the table's full address
ovFirst, 0                  // the first entry's full address, 0 until the first call
ovRtn, 0
ovArg, 0
ovEnt, 0
ovEntry, 0
ovWant, 0
ovPtr, 0
ovRes, 0
ovInitR, 0
ovXDia, 0
ovXDwc, 0
ovXDcl, 0
ovTries, 0
ovSwapN, 0                  // the outgoing length, then the swap's count
    endloc

#undef _OVL_dia
#undef _OVL_dwc
#undef _OVL_dra
#undef _OVL_dcl
#endif
