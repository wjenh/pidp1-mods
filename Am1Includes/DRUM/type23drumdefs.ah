#ifndef DRUMDEFS_AH
#define DRUMDEFS_AH
/*
 * IMPORTANT - the Type 340 display uses dra also for one of its IOTs.
 * If you use both, you will get the error below.
 * The special define _NO_DRA_ can be used to skip defining dra at all.
 * It is useful if you want to use both, but not reject the dra defined by the other one.
 * BE CAREFUL to not mix them!
 */

#ifndef _NO_DRA_DSS
#ifdef dra
#warning "dra is already defined, you are probably using the Type 340 display, use t23dra instead of dra."
#warning "dra and dss will now be undefined, you might also need to use type340dra and t340dss."
#undef dra
#undef dss
#define dra _Pragma("GCC error \"dra has been disabled, use type340dra and type23dra instead.\"")
#define dss _Pragma("GCC error \"dra has been disabled, use type340dra and type23dra instead.\"")
#else
#define dra iot 2062
#define dss iot 2063
#endif
#endif

// The drum has 32 tracks each 4096 words
#define TRACKS  0d32

// This defines the IOT instructions for the Type 23 drum.
#define dia iot 61
#define dba iot 2061
#define dwc iot 62
#define t23dra iot 2062
#define dcl iot 63
#define t23dss iot 2063

// Additional flags, not compatible with native macro, only macro1.
// These flags are in the IO register.
#define drmrd 400000
#define drmwrt 400000

// Bits for dss
#define drms16 40
#define drmsch 20

// The bit set if a cks is done.
#define cksdrm 1
#define CKSDRM 1

// A macro to check for ready
// NOTE this is a multi-instruction macro, DON'T jmp .-x to a location before it!
#define DRUM_WAIT_READY cks;lai;and [CKSDRM;sza;jmp .-4

#endif
