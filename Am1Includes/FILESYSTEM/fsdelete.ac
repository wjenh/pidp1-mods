// fsdelete.ac -- fsDelete: remove an open file from its volume's directory; its blocks become
// free.
// Include FILESYSTEM/fs.ah, then this file once, in any bank, and place that bank's
// constants. It includes fsopen.ac. Called as fsdir.ac's entries are.
// 10-Nov-2026, Claude: the library.
// 11-Nov-2026, Claude: the slot's count raised, so other descriptors of the file stay refused.
// 12-Nov-2026, Claude: moved here from MICROTAPE/mtfdelete.ac and renamed fs and FS_.

#ifndef FSDELETE_AC
#define FSDELETE_AC

#include <FILESYSTEM/fs.ah>
#include <FILESYSTEM/fsopen.ac>
#include <AIDS/skipmacros.ah>

local dlRtn, dlFd, dlH, dlQ, dlE, dlA, dlN, dlS, dlSbm, dl1, dl2, dl3, dlBad, dlRo, dlEnd

// Delete a file by its open descriptor: its entry is cleared and the directory written, and
// the descriptor is closed. Any other descriptor open on the file is refused from then on,
// even once a create has taken the same slot and blocks. The file's words are not erased. A read-only file is refused. On a
// write error the entry is put back in the handle and the descriptor stays open. Sequence
// breaks are off throughout and turned on again only if they were on.
// Entry: AC = the descriptor's 16-bit address; it is the whole parameter block. Exit: AC =
// FS_OK, FS_EBADFD (fsopen.ac's fsFdOk), FS_EREADONLY, or the block layer's error. IO is clobbered. Called via
// jda.
fsDelete, 0
    dac dlRtn
    eem
    lac fsDelete
    dac dlFd
    FS_SBS_OFF(dlSbm)
    lac dlFd
    farjda(fsFdOk:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp dlBad
    lac dlFd
    add [FS_FINFO]
    dac dlQ
    lac i dlQ
    and [FS_IRO]
    SKIP_NEXT_IF_AC_ZERO
    jmp dlRo

    // The entry, kept in fseSv, then cleared.
    lac dlFd
    dac dlQ
    lac i dlQ
    dac dlH                     // FS_FHANDLE
    idx dlQ
    lac i dlQ                   // FS_FSLOT
    sal 3s                      // times FS_ENTW
    add [FS_HDIR+FS_DENT0]
    add dlH
    dac dlE
    dac dlA
    lac [fseSv:.]
    dac dlQ
    law i FS_ENTW
    dac dlN
dl1,
    lac i dlA
    dac i dlQ
    dzm i dlA
    idx dlA
    idx dlQ
    isp dlN
    jmp dl1
    lac dlH
    farjda(fsWrDir:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp dl2
    lac dlFd
    add [FS_FSLOT]
    dac dlQ
    lac i dlQ
    add [FS_HSLOTS]
    add dlH
    dac dlQ
    idx i dlQ                   // the file's other descriptors are no longer valid
    lac dlFd
    add [FS_FFLAGS]
    dac dlQ
    dzm i dlQ
    cla
    jmp dlEnd

    // The write failed: the entry back.
dl2,
    dac dlS
    lac [fseSv:.]
    dac dlQ
    law i FS_ENTW
    dac dlN
dl3,
    lac i dlQ
    dac i dlE
    idx dlE
    idx dlQ
    isp dlN
    jmp dl3
    lac dlS
    jmp dlEnd
dlBad,
    law FS_EBADFD
    jmp dlEnd
dlRo,
    law FS_EREADONLY
dlEnd,
    dac dlS
    FS_SBS_RESTORE(dlSbm)
    lac dlS
    jmp i dlRtn

dlRtn, 0
dlFd, 0
dlH, 0
dlQ, 0
dlE, 0
dlA, 0
dlN, 0
dlS, 0
dlSbm, 0
endloc

// The entry while it is written; global so its full address can be taken.
fseSv,
    table FS_ENTW

#endif
