// fsdir.ac -- the file system's directory. fsRdDir reads it into a handle and fsWrDir writes
// it back as its two copies, for the other fs files and a device's mount and format; fsDirOk
// tells a directory block of this file system; fsLookup finds a name, packed into sixbit by
// UTIL/sixbit.ac; fsEntry gives an entry by its slot, and fsFree the free blocks and the
// gaps, from the handle, without the device.
// Include FILESYSTEM/fs.ah, then this file once, in any bank, and place that bank's
// constants. It includes fsblock.ac and UTIL/sixbit.ac, which land beside it unless they were
// included before.
// Every entry is entered by jda with the window open, farjda (memory.ah) from another bank,
// with AC a 16-bit address; it returns with the window open and AC the status, FS_OK or an
// FS_E code. Not reentrant; not to be called from a break routine. fsLookup, fsEntry and
// fsFree do not move the device; fsRdDir and fsWrDir leave the sequence breaks to their caller.
// 10-Nov-2026, Claude: the library, as MICROTAPE/mtfdir.ac.
// 12-Nov-2026, Claude: moved here and renamed; blocks move through fsblock.ac, and the volume's
// blocks come from the handle.

#ifndef FSDIR_AC
#define FSDIR_AC

#include <FILESYSTEM/fs.ah>
#include <FILESYSTEM/fsblock.ac>
#include <UTIL/sixbit.ac>
#include <AIDS/skipmacros.ah>

// The block buffer follows the directory in the handle, so the two copies go out in one write.
assert FS_HBUF == FS_HDIR + FS_BLKW
assert FS_HGEN == FS_HSTATE + 1
assert FS_DEALLOC == FS_DEFIRST + 1
assert FS_ENTW == 010

local rdRtn, rd1, rd2, rd3, rdNo, rdOk, rdRet, wdRtn, dkRtn, dkP, dkB, dkNo, dkRet, mdBlks, \
    enRtn, enP, enK, enRange, enRet, frRtn, frP, frNeed, frTot, frLarge, frFit, frPos, frF, \
    frEnd, \
    frA, frK, frE, frGap, frIter, frLoop, frScan, frNext, frBig, frFitT, frAdv, frDone, frRet, \
    mdH, mdP, mxBlk, mxCnt, mxOff, mxWr, mdXfer, mx1, mxx, mdCopy, mdCopyN, mcS, mcD, mcN, \
    mc1, mcx, mdMounted, mm1, mmx, lkRtn, lkP, lkD, lkE, lkN, lkSlot, lkFree, lkLoop, lkCmp, \
    lkC1, lkNext, lkRet, nmPack, nmArg, nmBad, nmx, nmS, nmD

// Read the directory into the handle: block 1 if it reads cleanly and is this file system's,
// else block 2, copied over it. Then the handle is mounted, with the directory's generation.
// The handle's mount count goes up, so descriptors opened before are refused.
// Entry: AC = the handle's 16-bit address, its unit and device words set by a device's mount.
// Exit: AC = FS_OK, FS_ENOFS when neither copy is good, or the block layer's error. IO is
// clobbered. Called via jda.
fsRdDir, 0
    dac rdRtn
    lac fsRdDir
    dac mdH
    add [FS_HBLKS]
    dac mdP
    lac i mdP
    dac mdBlks                  // what a good copy's header must say
    lac mdH
    add [FS_HSTATE]
    dac mdP
    dzm i mdP                   // not mounted until a copy has passed
    lac mdH
    add [FS_HMOUNT]
    dac mdP
    idx i mdP                   // the old mount's descriptors are no longer valid
    law FS_DIRBLK
    dac mxBlk
    law 1
    dac mxCnt
    law FS_HDIR
    dac mxOff
    dzm mxWr
    jsp mdXfer
    SKIP_NEXT_IF_AC_ZERO
    jmp rd1
    lac mdH
    add [FS_HDIR]
    lio mdBlks
    jda fsDirOk
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rdOk
    jmp rd2
rd1,
    sad [FS_EBADBLOCK]          // skip unless a bad block, which the copy may cover
    jmp rd2
    jmp rdRet

    // The copy, into the block buffer, then over the directory.
rd2,
    law FS_DIRBLK2
    dac mxBlk
    law FS_HBUF
    dac mxOff
    jsp mdXfer
    SKIP_NEXT_IF_AC_ZERO
    jmp rd3
    lac mdH
    add [FS_HBUF]
    lio mdBlks
    jda fsDirOk
    SKIP_NEXT_IF_AC_ZERO
    jmp rdNo
    lac mdH
    add [FS_HBUF]
    dac mcS
    lac mdH
    add [FS_HDIR]
    dac mcD
    jsp mdCopy
    jmp rdOk
rd3,
    sad [FS_EBADBLOCK]
    jmp rdNo
    jmp rdRet
rdNo,
    law FS_ENOFS
    jmp rdRet
rdOk,
    lac mdH
    add [FS_HDIR+FS_DGEN]
    dac mdP
    lio i mdP
    lac mdH
    add [FS_HSTATE]
    dac mdP
    law 1
    dac i mdP
    idx mdP
    dio i mdP                   // FS_HGEN
    cla
rdRet,
    jmp i rdRtn

// Write the handle's directory to the volume as its two copies, blocks 1 and 2 in one pass, with
// a new generation in the directory and in the handle. The block buffer is overwritten.
// Entry: AC = the handle's 16-bit address. Exit: AC = the block layer's status. IO is
// clobbered. Called via jda.
fsWrDir, 0
    dac wdRtn
    lac fsWrDir
    dac mdH
    add [FS_HDIR+FS_DGEN]
    dac mdP
    lac i mdP
    add [1]
    and [0377777]               // kept positive
    dac i mdP
    lia
    lac mdH
    add [FS_HGEN]
    dac mdP
    dio i mdP
    lac mdH
    add [FS_HDIR]
    dac mcS
    lac mdH
    add [FS_HBUF]
    dac mcD
    jsp mdCopy
    law FS_DIRBLK
    dac mxBlk
    law 2
    dac mxCnt
    law FS_HDIR
    dac mxOff
    law 1
    dac mxWr
    jsp mdXfer
    jmp i wdRtn

// Whether a directory block is this file system's: the magic, the version and the volume's
// blocks.
// Entry: AC = the block's 16-bit address, IO = the volume's blocks (the handle's FS_HBLKS).
// Exit: AC = 0 if it is, else nonzero. IO is preserved. Called via jda.
fsDirOk, 0
    dac dkRtn
    dio dkB
    lac fsDirOk
    dac dkP
    lac i dkP
    sas [FS_MAGIC]              // skip if the magic
    jmp dkNo
    idx dkP
    lac i dkP
    sas [FS_VERSION]
    jmp dkNo
    lac dkP
    add [FS_DBLKS-FS_DVER]
    dac dkP
    lac i dkP
    sas dkB
    jmp dkNo
    cla
    jmp dkRet
dkNo,
    law 1
dkRet,
    jmp i dkRtn

// Copy directory slot FS_PINDEX's FS_ENTW words to FS_PDEST.
// Entry: AC = the parameter block's 16-bit address: the handle, the slot and the destination.
// Exit: AC = FS_OK, FS_ENOFS if the handle is not mounted, or FS_ERANGE for a slot past
// FS_NENT-1. IO is clobbered. Called via jda.
fsEntry, 0
    dac enRtn
    eem
    lac fsEntry
    dac enP
    lac i enP
    dac mdH
    idx enP
    lac i enP
    dac enK
    idx enP
    lac i enP
    dac mcD
    jsp mdMounted
    SKIP_NEXT_IF_AC_ZERO
    jmp enRet
    lac enK
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp enRange
    sub [FS_NENT]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp enRange
    lac enK
    sal 3s                      // times FS_ENTW
    add [FS_HDIR+FS_DENT0]
    add mdH
    dac mcS
    law i FS_ENTW
    dac mcN
    jsp mdCopyN
    cla
    jmp enRet
enRange,
    law FS_ERANGE
enRet,
    jmp i enRtn

// The free blocks, from the handle's directory: the total, the largest gap, and the first gap
// of FS_PNEED blocks. A gap is a run of blocks from FS_FIRSTBLK on that no entry holds.
// Entry: AC = the parameter block's 16-bit address: the handle and FS_PNEED. Exit: AC =
// FS_OK or FS_ENOFS; FS_PTOTAL, FS_PLARGEST and FS_PFIT set, FS_PFIT -1 when no gap is
// large enough or FS_PNEED is 0. IO is clobbered. Called via jda.
fsFree, 0
    dac frRtn
    eem
    lac fsFree
    dac frP
    lac i frP
    dac mdH
    lac frP
    add [FS_PNEED]
    dac mdP
    lac i mdP
    dac frNeed
    jsp mdMounted
    SKIP_NEXT_IF_AC_ZERO
    jmp frRet
    lac mdH
    add [FS_HBLKS]
    dac mdP
    lac i mdP
    dac frEnd
    dzm frTot
    dzm frLarge
    law i 1
    dac frFit
    law FS_FIRSTBLK
    dac frPos
    law i FS_NENT+1             // a gap before each entry, and the last; a bound on a bad directory
    dac frIter

    // The entry with the lowest first block at or past frPos: frF, its blocks frA; frF is
    // frEnd, the volume's blocks, when there is none.
frLoop,
    lac frEnd
    dac frF
    dzm frA
    lac mdH
    add [FS_HDIR+FS_DENT0]
    dac frE
    law i FS_NENT
    dac frK
frScan,
    lac i frE                   // the name's first word, 0 for a free slot
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp frNext
    lac frE
    add [FS_DEFIRST]
    dac mdP
    lac i mdP
    sub frPos
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp frNext                  // before frPos
    lac i mdP
    sub frF
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp frNext                  // not lower
    lac i mdP
    dac frF
    idx mdP
    lac i mdP
    dac frA
frNext,
    lac frE
    add [FS_ENTW]
    dac frE
    isp frK
    jmp frScan

    // The gap from frPos to frF: counted, the largest kept, the first large enough kept.
    lac frF
    sub frPos
    dac frGap
    add frTot
    dac frTot
    lac frGap
    sub frLarge
    sma sza                     // skip unless larger
    jmp frBig
    jmp frFitT
frBig,
    lac frGap
    dac frLarge
frFitT,
    lac frFit
    SKIP_NEXT_IF_AC_NEGATIVE    // skip while none is kept
    jmp frAdv
    lac frNeed
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp frAdv
    lac frGap
    sub frNeed
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp frAdv
    lac frPos
    dac frFit
frAdv,
    lac frF
    sad frEnd                   // skip unless the volume's end
    jmp frDone
    add frA
    dac frPos
    isp frIter
    jmp frLoop
frDone,
    lac frP
    add [FS_PTOTAL]
    dac mdP
    lac frTot
    dac i mdP
    idx mdP
    lac frLarge
    dac i mdP
    idx mdP
    lac frFit
    dac i mdP
    cla
frRet,
    jmp i frRtn

// Look a name up in the handle's directory, packing it into sixbit on the way. Names match
// whatever their case, since packing takes lower case as upper.
// Entry: AC = the parameter block's 16-bit address: the handle (FS_PHANDLE), the name's 16-bit
// address, an am1 ascii string (FS_PNAME), and where its 3 sixbit words go (FS_PNAMED).
// Exit: AC = FS_OK with IO the slot; FS_ENOTFOUND with IO the first free slot, or -1 when
// there is none; FS_ENAME (nmPack's rules) or FS_ENOFS. Called via jda.
fsLookup, 0
    dac lkRtn
    eem
    lac fsLookup
    dac lkP
    lac i lkP
    dac mdH
    idx lkP
    lac i lkP
    dac nmS
    idx lkP
    lac i lkP
    dac nmD
    dac lkD
    jsp mdMounted
    SKIP_NEXT_IF_AC_ZERO
    jmp lkRet
    jsp nmPack
    SKIP_NEXT_IF_AC_ZERO
    jmp lkRet
    law i 1
    dac lkFree
    dzm lkSlot
    lac mdH
    add [FS_HDIR+FS_DENT0]
    dac lkE
lkLoop,
    lac i lkE                   // the name's first word, 0 for a free slot
    SKIP_NEXT_IF_AC_ZERO
    jmp lkCmp
    lac lkFree
    sma                         // skip while no free slot is kept
    jmp lkNext
    lac lkSlot
    dac lkFree
    jmp lkNext
lkCmp,
    lac lkE
    dac mcS
    lac lkD
    dac mcD
    law i FS_DENAMEW
    dac lkN
lkC1,
    lac i mcS
    sas i mcD                   // skip if this word matches
    jmp lkNext
    idx mcS
    idx mcD
    isp lkN
    jmp lkC1
    lio lkSlot
    cla
    jmp lkRet
lkNext,
    lac lkE
    add [FS_ENTW]
    dac lkE
    idx lkSlot
    sas [FS_NENT]               // skip past the last slot
    jmp lkLoop
    lio lkFree
    law FS_ENOTFOUND
lkRet,
    jmp i lkRtn

// Pack the am1 ascii string at nmS into FS_DENAMEW sixbit words at nmD, both 16-bit
// addresses, with UTIL/sixbit.ac's am1ToSixbit: at most 9 characters, blank-padded, lower case
// raised. Exit: AC = 0, or FS_ENAME for a name too long, with a control character, empty, or
// with a leading blank (it would pack as a free slot's zero word). IO is clobbered.
// Called via jsp.
nmPack,
    dap nmx
    lac nmD
    dac nmArg
    lio [FS_DENAMEW]
    lac nmS
    farjda(am1ToSixbit:*)
nmArg, 0
    SKIP_NEXT_IF_AC_ZERO
    jmp nmBad
    lac i nmD
    and [0770000]               // the first character
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp nmBad
    cla
    jmp nmx
nmBad,
    law FS_ENAME
nmx,
    jmp .

// Move blocks between the volume and the handle mdH: mxCnt blocks from block mxBlk, at mxOff
// in the handle (FS_HDIR or FS_HBUF), written when mxWr is nonzero, else read.
// Exit: AC = the block layer's status. IO is clobbered. Called via jsp.
mdXfer,
    dap mxx
    lac mdH
    dac fsdPb+FS_BHANDLE
    lac mxBlk
    dac fsdPb+FS_BBLOCK
    lac mxCnt
    dac fsdPb+FS_BCOUNT
    lac mdH
    add mxOff
    dac fsdPb+FS_BBUF
    lac [fsdPb:.]
    lio mxWr
    sni                         // skip if writing
    jmp mx1
    farjda(fsBWrite:*)
    jmp mxx
mx1,
    farjda(fsBRead:*)
mxx,
    jmp .

// Copy FS_BLKW words, or mcN's negative count at mdCopyN, from mcS to mcD, both 16-bit
// addresses, which are left past the words. Called via jsp. AC is clobbered, IO is preserved.
mdCopy,
    dap mcx
    law i FS_BLKW
    dac mcN
    jmp mc1
mdCopyN,
    dap mcx
mc1,
    lac i mcS
    dac i mcD
    idx mcS
    idx mcD
    isp mcN
    jmp mc1
mcx,
    jmp .

// Whether the handle mdH is mounted. Exit: AC = 0 if it is, else FS_ENOFS. IO is preserved.
// Called via jsp.
mdMounted,
    dap mmx
    lac mdH
    add [FS_HSTATE]
    dac mdP
    lac i mdP
    sas [1]                     // skip if mounted
    jmp mm1
    cla
    jmp mmx
mm1,
    law FS_ENOFS
mmx,
    jmp .

rdRtn, 0
wdRtn, 0
dkRtn, 0
dkP, 0
dkB, 0
mdBlks, 0
enRtn, 0
enP, 0
enK, 0
frRtn, 0
frP, 0
frNeed, 0
frTot, 0
frLarge, 0
frFit, 0
frPos, 0
frF, 0
frA, 0
frK, 0
frE, 0
frGap, 0
frIter, 0
frEnd, 0
mdH, 0
mdP, 0
mxBlk, 0
mxCnt, 0
mxOff, 0
mxWr, 0
mcS, 0
mcD, 0
mcN, 0
lkRtn, 0
lkP, 0
lkD, 0
lkE, 0
lkN, 0
lkSlot, 0
lkFree, 0
nmS, 0
nmD, 0
endloc

// The block layer's parameter block for this file's transfers, FS_BW words; global so its
// full address can be taken.
fsdPb,
    table FS_BW

#endif
