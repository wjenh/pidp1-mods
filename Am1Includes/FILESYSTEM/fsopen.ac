// fsopen.ac -- open a file of a mounted volume into a file descriptor (fs.ah, FS_FILE), by
// its name or its directory slot, and close it, writing its entry back if it changed.
// Include FILESYSTEM/fs.ah, then this file once, in any bank, and place that bank's
// constants. It includes fsdir.ac. Called as fsdir.ac's entries are.
// fsFdOk is the check every call taking a descriptor makes first.
// 10-Nov-2026, Claude: the library.
// 11-Nov-2026, Claude: the slot's count recorded at the open and checked by fsFdOk.
// 12-Nov-2026, Claude: moved here from MICROTAPE/mtfopen.ac and renamed fs and FS_.

#ifndef FSOPEN_AC
#define FSOPEN_AC

#include <FILESYSTEM/fs.ah>
#include <FILESYSTEM/fsdir.ac>
#include <AIDS/skipmacros.ah>

// opFill copies the entry's words in this order.
assert FS_FHANDLE == 0
assert FS_FSLOT == 1
assert FS_FFIRST == 2
assert FS_FALLOC == 3
assert FS_FLEN == 4
assert FS_FPOS == 5
assert FS_FINFO == 6
assert FS_FFLAGS == 7
assert FS_FMOUNT == 010
assert FS_FSTAMP == 011
assert FS_HSLOTS == FS_HBUF + FS_BLKW
assert FS_HANDLEW == FS_HSLOTS + FS_NENT
assert FS_DELEN == FS_DEFIRST + 2
assert FS_DEINFO == FS_DEFIRST + 3

local onRtn, oiRtn, ocRtn, opP, opH, opK, opFd, opQ, opE, opS, opSbm, onRet, \
    oiNofs, oiRange, oiNf, oiRet, opFill, ofx, ocDone, ocBad, ocRet, fkRtn, fkD, fkH, fkQ,     fkM, fkBad

// Open a file by its name.
// Entry: AC = the parameter block's 16-bit address: the handle (FS_PHANDLE), the name's 16-bit
// address, an am1 ascii string (FS_PNAME), and the descriptor's (FS_PFD). Exit: AC = FS_OK
// with the descriptor open at position 0; FS_ENOTFOUND, FS_ENAME or FS_ENOFS. IO is
// clobbered. Called via jda.
fsOpenName, 0
    dac onRtn
    eem
    lac fsOpenName
    dac opP
    lac i opP
    dac opH
    dac fsoPb+FS_PHANDLE
    idx opP
    lac i opP
    dac fsoPb+FS_PNAME
    idx opP
    lac i opP
    dac opFd
    lac [fsoNm:.]
    dac fsoPb+FS_PNAMED
    lac [fsoPb:.]
    farjda(fsLookup:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp onRet
    dio opK
    jsp opFill
    cla
onRet,
    jmp i onRtn

// Open a file by its directory slot, as fsEntry lists them.
// Entry: AC = the parameter block's 16-bit address: the handle (FS_PHANDLE), the slot
// (FS_PINDEX) and the descriptor's 16-bit address (FS_PFD). Exit: AC = FS_OK with the
// descriptor open at position 0; FS_ENOTFOUND for a free slot, FS_ERANGE for a slot past
// FS_NENT-1, or FS_ENOFS. IO is clobbered. Called via jda.
fsOpenIndex, 0
    dac oiRtn
    eem
    lac fsOpenIndex
    dac opP
    lac i opP
    dac opH
    idx opP
    lac i opP
    dac opK
    idx opP
    lac i opP
    dac opFd
    lac opH
    add [FS_HSTATE]
    dac opQ
    lac i opQ
    sas [1]                     // skip if mounted
    jmp oiNofs
    lac opK
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp oiRange
    sub [FS_NENT]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp oiRange
    lac opK
    sal 3s                      // times FS_ENTW
    add [FS_HDIR+FS_DENT0+FS_DENAME]
    add opH
    dac opQ
    lac i opQ
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp oiNf
    jsp opFill
    cla
    jmp oiRet
oiNofs,
    law FS_ENOFS
    jmp oiRet
oiRange,
    law FS_ERANGE
    jmp oiRet
oiNf,
    law FS_ENOTFOUND
oiRet,
    jmp i oiRtn

// Close a file: if a write lengthened it or an information-word setter changed it, its entry
// in the handle takes the new length and information word and the directory is written. On an
// error the descriptor stays open and changed, so the close may be repeated. A descriptor
// fsFdOk refuses is closed with nothing written.
// Entry: AC = the descriptor's 16-bit address; it is the whole parameter block. Exit: AC =
// FS_OK, FS_EBADFD (fsFdOk), or the block layer's error. IO is clobbered. Called via jda.
fsClose, 0
    dac ocRtn
    eem
    lac fsClose
    dac opFd
    jda fsFdOk
    SKIP_NEXT_IF_AC_ZERO
    jmp ocBad
    lac opFd
    add [FS_FFLAGS]
    dac opQ
    lac i opQ
    and [FS_FCHANGED]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ocDone
    FS_SBS_OFF(opSbm)
    lac opFd
    dac opQ
    lac i opQ
    dac opH                     // FS_FHANDLE
    idx opQ
    lac i opQ                   // FS_FSLOT
    sal 3s
    add [FS_HDIR+FS_DENT0+FS_DELEN]
    add opH
    dac opE
    lac opFd
    add [FS_FLEN]
    dac opQ
    lac i opQ
    dac i opE
    idx opE                     // FS_DEINFO
    lac opFd
    add [FS_FINFO]
    dac opQ
    lac i opQ
    dac i opE
    lac opH
    farjda(fsWrDir:*)
    dac opS
    FS_SBS_RESTORE(opSbm)
    lac opS
    SKIP_NEXT_IF_AC_ZERO
    jmp ocRet
ocDone,
    lac opFd
    add [FS_FFLAGS]
    dac opQ
    dzm i opQ
    cla
    jmp ocRet
ocBad,
    lac opFd
    add [FS_FFLAGS]
    dac opQ
    dzm i opQ
    law FS_EBADFD
ocRet,
    jmp i ocRtn

// Whether a descriptor may be used: it is open, its handle is mounted and has not been mounted
// or formatted again since the file was opened, its slot still holds a file at its first
// block, and the slot has not been cleared since. So a descriptor left open across a remount,
// a pack that moved its file, or a delete or replace through another descriptor or call is
// refused, even after a create has taken the same slot and first block.
// Entry: AC = the descriptor's 16-bit address. Exit: AC = FS_OK or FS_EBADFD. IO is
// preserved. Called via jda.
fsFdOk, 0
    dac fkRtn
    lac fsFdOk
    dac fkD
    add [FS_FFLAGS]
    dac fkQ
    lac i fkQ
    and [FS_FOPEN]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp fkBad
    lac i fkD                   // FS_FHANDLE
    dac fkH
    add [FS_HSTATE]
    dac fkQ
    lac i fkQ
    sas [1]                     // skip if mounted
    jmp fkBad
    lac fkH
    add [FS_HMOUNT]
    dac fkQ
    lac i fkQ
    dac fkM
    lac fkD
    add [FS_FMOUNT]
    dac fkQ
    lac i fkQ
    sas fkM                     // skip if the same mount
    jmp fkBad
    lac fkD
    add [FS_FSLOT]
    dac fkQ
    lac i fkQ
    sal 3s                      // times FS_ENTW
    add [FS_HDIR+FS_DENT0]
    add fkH
    dac fkQ
    lac i fkQ                   // the name's first word, 0 for a free slot
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp fkBad
    lac fkQ
    add [FS_DEFIRST]
    dac fkQ
    lac i fkQ
    dac fkM
    lac fkD
    add [FS_FFIRST]
    dac fkQ
    lac i fkQ
    sas fkM                     // skip if the same first block
    jmp fkBad
    lac fkD
    add [FS_FSLOT]
    dac fkQ
    lac i fkQ
    add [FS_HSLOTS]
    add fkH
    dac fkQ
    lac i fkQ
    dac fkM
    lac fkD
    add [FS_FSTAMP]
    dac fkQ
    lac i fkQ
    sas fkM                     // skip if the slot has not been cleared since the open
    jmp fkBad
    cla
    jmp i fkRtn
fkBad,
    law FS_EBADFD
    jmp i fkRtn

// Fill the descriptor opFd from slot opK of the handle opH, open at position 0, with the
// handle's mount count and the slot's count for fsFdOk.
// Called via jsp. AC is clobbered, IO is preserved.
opFill,
    dap ofx
    lac opK
    sal 3s
    add [FS_HDIR+FS_DENT0+FS_DEFIRST]
    add opH
    dac opE
    lac opFd
    dac opQ
    lac opH
    dac i opQ                   // FS_FHANDLE
    idx opQ
    lac opK
    dac i opQ                   // FS_FSLOT
    idx opQ
    lac i opE
    dac i opQ                   // FS_FFIRST
    idx opE
    idx opQ
    lac i opE
    dac i opQ                   // FS_FALLOC
    idx opE
    idx opQ
    lac i opE
    dac i opQ                   // FS_FLEN
    idx opQ
    dzm i opQ                   // FS_FPOS
    idx opE
    idx opQ
    lac i opE
    dac i opQ                   // FS_FINFO
    idx opQ
    law FS_FOPEN
    dac i opQ                   // FS_FFLAGS
    lac opH
    add [FS_HMOUNT]
    dac opE
    idx opQ
    lac i opE
    dac i opQ                   // FS_FMOUNT
    lac opK
    add [FS_HSLOTS]
    add opH
    dac opE
    idx opQ
    lac i opE
    dac i opQ                   // FS_FSTAMP
ofx,
    jmp .

onRtn, 0
oiRtn, 0
ocRtn, 0
opP, 0
opH, 0
opK, 0
opFd, 0
opQ, 0
opE, 0
opS, 0
opSbm, 0
fkRtn, 0
fkD, 0
fkH, 0
fkQ, 0
fkM, 0
endloc

// fsLookup's parameter block for this file's calls, and the packed name it returns; global so
// their full addresses can be taken.
fsoPb,
    table 3
fsoNm,
    table FS_DENAMEW

#endif
