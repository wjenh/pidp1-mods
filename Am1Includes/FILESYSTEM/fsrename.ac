// fsrename.ac -- fsRename: give a file of a mounted volume a new name, replacing a file of
// that name if asked, in one directory write.
// Include FILESYSTEM/fs.ah, then this file once, in any bank, and place that bank's
// constants. It includes fsdir.ac. Called as fsdir.ac's entries are.
// 11-Nov-2026, Claude: the call.
// 11-Nov-2026, Claude: a replaced file's slot count raised, so its descriptors stay refused.
// 12-Nov-2026, Claude: moved here from MICROTAPE/mtfrename.ac and renamed fs and FS_.

#ifndef FSRENAME_AC
#define FSRENAME_AC

#include <FILESYSTEM/fs.ah>
#include <FILESYSTEM/fsdir.ac>
#include <AIDS/skipmacros.ah>

// The name is the entry's first FS_DENAMEW words, as fsLookup packs it.
assert FS_DENAME == 0
assert FS_ENTW == 010

local rnRtn, rnP, rnH, rnNew, rnRep, rnK, rnJ, rnE, rnR, rnQ, rnS, rnSbm, rnFree, rnSame, \
    rnUndo, rnU1, rnRo, rnHas, rnEnd, cpS, cpD, cpN, rnCopy, rc1, rcx, rnClr, rz1, rzx

// Rename a file. The old name must be on the volume. A file of the new name is refused unless
// FS_PREPLACE is nonzero; then its entry is cleared in the same directory write, so a halt
// leaves the volume either as it was or with both changes. A read-only file may be renamed but
// not replaced. A new name that is the file's own, in any case, succeeds with nothing written.
// A descriptor open on the renamed file stays valid; one open on a replaced file is refused
// from then on, even once a create has taken the replaced file's slot and blocks.
// Sequence breaks are off throughout and turned on again only if they were on.
// Entry: AC = the parameter block's 16-bit address: the handle (FS_PHANDLE), the old name's
// 16-bit address (FS_PNAME), the new name's (FS_PNEWNAME), both am1 ascii strings, and
// FS_PREPLACE. Exit: AC = FS_OK; FS_ENOTFOUND for the old name, FS_ENAME for either,
// FS_EEXISTS, FS_EREADONLY for a read-only file to replace, FS_ENOFS, or the block layer's
// error, after which the handle's directory is as it was. IO is clobbered. Called via jda.
fsRename, 0
    dac rnRtn
    eem
    lac fsRename
    dac rnP
    FS_SBS_OFF(rnSbm)
    dzm rnR                     // no entry replaced yet
    lac i rnP
    dac rnH
    dac fsrPb+FS_PHANDLE
    idx rnP
    lac i rnP
    dac fsrPb+FS_PNAME
    idx rnP
    lac i rnP
    dac rnNew
    idx rnP
    lac i rnP
    dac rnRep

    // The old name's slot; its packed name is kept in fsrOld for an undo.
    lac [fsrOld:.]
    dac fsrPb+FS_PNAMED
    lac [fsrPb:.]
    farjda(fsLookup:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp rnEnd
    dio rnK

    // The new name: free, the file's own, or another file's.
    lac rnNew
    dac fsrPb+FS_PNAME
    lac [fsrNew:.]
    dac fsrPb+FS_PNAMED
    lac [fsrPb:.]
    farjda(fsLookup:*)
    sad [FS_ENOTFOUND]          // skip unless the name is free
    jmp rnFree
    SKIP_NEXT_IF_AC_ZERO
    jmp rnEnd
    dio rnJ
    lac rnJ
    sad rnK                     // skip unless the file's own name
    jmp rnSame
    lac rnRep
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rnHas

    // The file to replace: refused if read-only, else kept in fsrSv and cleared.
    lac rnJ
    sal 3s                      // times FS_ENTW
    add [FS_HDIR+FS_DENT0]
    add rnH
    dac rnQ
    add [FS_DEINFO]
    dac rnE
    lac i rnE
    and [FS_IRO]
    SKIP_NEXT_IF_AC_ZERO
    jmp rnRo
    lac rnQ
    dac rnR
    dac cpS
    lac [fsrSv:.]
    dac cpD
    law i FS_ENTW
    dac cpN
    jsp rnCopy
    lac rnR
    dac cpD
    law i FS_ENTW
    dac cpN
    jsp rnClr

    // The new name into the file's entry, then the directory to the volume.
rnFree,
    lac rnK
    sal 3s
    add [FS_HDIR+FS_DENT0]
    add rnH
    dac rnE
    lac [fsrNew:.]
    dac cpS
    lac rnE
    dac cpD
    law i FS_DENAMEW
    dac cpN
    jsp rnCopy
    lac rnH
    farjda(fsWrDir:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp rnUndo
    lac rnR
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rnEnd                   // AC 0, FS_OK: nothing replaced
    lac rnJ
    add [FS_HSLOTS]
    add rnH
    dac rnQ
    idx i rnQ                   // the replaced file's descriptors are no longer valid
    cla
    jmp rnEnd

    // The write failed: the old name back, and the replaced entry if there was one.
rnUndo,
    dac rnS
    lac [fsrOld:.]
    dac cpS
    lac rnE
    dac cpD
    law i FS_DENAMEW
    dac cpN
    jsp rnCopy
    lac rnR
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rnU1
    lac [fsrSv:.]
    dac cpS
    lac rnR
    dac cpD
    law i FS_ENTW
    dac cpN
    jsp rnCopy
rnU1,
    lac rnS
    jmp rnEnd
rnSame,
    cla
    jmp rnEnd
rnHas,
    law FS_EEXISTS
    jmp rnEnd
rnRo,
    law FS_EREADONLY
rnEnd,
    dac rnS
    FS_SBS_RESTORE(rnSbm)
    lac rnS
    jmp i rnRtn

// Copy cpN's negative count of words from cpS to cpD, both 16-bit addresses, which are left
// past the words. Called via jsp. AC is clobbered, IO is preserved.
rnCopy,
    dap rcx
rc1,
    lac i cpS
    dac i cpD
    idx cpS
    idx cpD
    isp cpN
    jmp rc1
rcx,
    jmp .

// Zero cpN's negative count of words from cpD, a 16-bit address, which is left past them.
// Called via jsp. AC is clobbered, IO is preserved.
rnClr,
    dap rzx
rz1,
    dzm i cpD
    idx cpD
    isp cpN
    jmp rz1
rzx,
    jmp .

rnRtn, 0
rnP, 0
rnH, 0
rnNew, 0
rnRep, 0
rnK, 0
rnJ, 0
rnE, 0
rnR, 0
rnQ, 0
rnS, 0
rnSbm, 0
cpS, 0
cpD, 0
cpN, 0
endloc

// fsLookup's parameter block for this file's calls, the two packed names, and the replaced
// entry while the directory is written; global so their full addresses can be taken.
fsrPb,
    table 3
fsrOld,
    table FS_DENAMEW
fsrNew,
    table FS_DENAMEW
fsrSv,
    table FS_ENTW

#endif
