// Definitions for the lightpen
#ifndef LIGHTPEN

// Macros for getting the size in pixels of a character and spacing.
// SPACINGSIZE is how much autospacing will move between characters.
#define CHARSIZEX(size) ((2 + size) * 5)
#define CHARSIZEY(size) ((2 + size) * 7)
#define SPACINGSIZE(size) (4 + size)

// Modifier for dpy, set aperture
#define LIGHTPEN 3000

// Aperture equivalents, also in IO
#define APERTURE050    0d3
#define APERTURE100    0d6
#define APERTURE150    0d8
#define APERTURE200    0d11
#define APERTURE250    0d14
#define APERTURE300    0d17

// Example:
// lio [APERTURE150
// dpy-i LIGHTPEN
#endif
