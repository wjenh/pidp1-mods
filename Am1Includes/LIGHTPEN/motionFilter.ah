#ifndef MOTIONFILTER_AH
#define MOTIONFILTER_AH
// These constants are used for the motionFilter.ac chained exponential motion filters.
// It must be included, but if you want to override the alpha settings, use the alpha modfier routines in
// motionfilter.ac.

// THe SHIFT constants are full instructions.
// This allows easy initialization to 0.
// The alpha values for the 2 filters.
// A shift of 0 is 1/64, 0.0156 in traditional floating point terms.
// This increases by powers of 2, so a shift of 1<<3 is 1/8, or 0.125.
// Velocity Alpha smooths out jitter.
#define VELOCITY_ALPHA_SHIFT sar 2s

// Acceleration filtering uses two alphas, not one.
// ACCEL_ATTACK_SHIFT applies when the sample reinforces the current direction of
// travel, the pen is speeding up.
// Keep fast, a low value, so the prediction doesn't fall behind a rapidly
// moving lightpen and lose lock.
//
// ACCEL_DECAY_SHIFT applies when the sample opposes the current direction of travel.
// Keep slow, a high value, so a single such sample doesn't overshoot the
// extrapolated position where the pen has actually settled.
#define ACCEL_ATTACK_ALPHA_SHIFT nop    // a shift of 0
#define ACCEL_DECAY_ALPHA_SHIFT sar 3s

// The state is kept as 5 consecutive locations with the address of the first passed to the subroutines.
// Declare this as a table, e.g.:
// xstate,
// table FILTER_STATE_SIZE

// This is analagous to the C struct below, but in assembler.
// typedef struct {
//    int prev_position;            // Previous raw position
//    int prev_velocity;            // Previous raw velocity (Fixed-point)
//    int smoothed_velocity;        // Filtered velocity state (Fixed-point)
//    int smoothed_acceleration;    // Filtered acceleration state (Fixed-point)
//    int last_output;              // Last position actually returned to the caller,
//                                  // used only by the position-delta cap below.
// } State;
//
#define FILTER_STATE_SIZE 5         // This can be used with a table directive to allocate storage

#ifndef MAX_POSITION_DELTA
// Largest distance in Type 340 coordinate units the returned position is allowed to move
// in a single motionFilterUpdate call.
// If the candidate position  after the 0..1023 range clamp is farther than this from the position
// returned last call, the update is frozen and the previous output is returned unchanged instead.
// This guards against the extrapolation overshooting visibly even when the raw lightpen samples
// themselves are small.
// Define MAX_POSITION_DELTA before including this file to override.
#define MAX_POSITION_DELTA 0d100
#endif

#endif
