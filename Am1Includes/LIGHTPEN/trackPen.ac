#ifndef TRACKPEN_AC
#define TRACKPEN_AC
// This code is used to follow the light pen.
// It draws invisible tracking markers around the global xPosition and yPosition locations.
// If the pen is moved but still being tracked, it updaes the positions and returns 1 in AC.
// The amount the positions are updated and the spacing between markers is set by the constants below.
// If the pen is lifted or tracking is lost, it returns 0 in AC and the locations are not changed.
// This changes the aperture setting.
// It is called by a jsp.

#include <SYMGEN/type33iots.ah>
#include <LIGHTPEN/lightpen.ah>

#define TRACK_PEN_APERTURE APERTURE300
#define TRACK_PEN_SPACING 0d25
#define TRACK_PEN_DELTA (TRACK_PEN_SPACING / 2)
// A brightness of 4 is invisible.
#define TRACK_PEN_BRIGHTNESS 4

trackPen,      // xPosition and yPosition are the center of the tracking location.
    local rtn, hit, miss, ck1, ck1a, ck2, ck2a, ctr
    addlocal ydelta, ydelta, lpx, lpy
    dap rtn

    law TRACK_PEN_APERTURE
    lia
    dpy-i LIGHTPEN
    lac xPosition
    sub [TRACK_PEN_SPACING
    dac lpx
    lac yPosition
    sub [TRACK_PEN_SPACING
    dac lpy
    law i TRACK_PEN_DELTA
    dac xdelta
    dac ydelta
    law i 3
    dac ctr
    lac lpy
    clf 3
ck1,            // 3 vertical on left side
    lia         // AC has latest y
    ril 8s
    lac lpx
    ral 8s
    dpy TRACK_PEN_BRIGHTNESS << 6
    szf 3
    jmp hit
    isp ctr
    jmp .+2
    jmp ck1a
    lac ydelta
    add [TRACK_PEN_DELTA
    dac ydelta
    lac lpy
    add [TRACK_PEN_SPACING
    dac lpy
    jmp ck1

ck1a, lio lpy   // draw top center
    ril 8s
    lac lpx
    add [TRACK_PEN_SPACING
    dac lpx
    ral 8s
    dpy TRACK_PEN_BRIGHTNESS << 6
    lac xdelta
    add [TRACK_PEN_DELTA
    dac xdelta
    szf 3
    jmp hit

    // set up for right side
    lac xdelta
    add [TRACK_PEN_DELTA
    dac xdelta
    lac lpx
    add [TRACK_PEN_SPACING
    dac lpx
    law i 3
    dac ctr
    lac lpy
ck2,            // 3 vertical on right side
    lia
    ril 8s
    lac lpx
    ral 8s
    dpy TRACK_PEN_BRIGHTNESS << 6
    szf 3
    jmp hit
    isp ctr
    jmp .+2
    jmp ck2a
    lac ydelta
    sub [TRACK_PEN_DELTA
    dac ydelta
    lac lpy
    sub [TRACK_PEN_SPACING
    dac lpy
    jmp ck2

ck2a,           // bottom center
    lac xdelta
    sub [TRACK_PEN_DELTA
    dac xdelta
    lac lpx
    sub [TRACK_PEN_SPACING
    dac lpx
    ral 8s
    lio lpy
    ril 8s
    dpy TRACK_PEN_BRIGHTNESS << 6
    szf i 3
    jmp miss        // lost tracking

hit,
    lac xPosition
    add xdelta
    dac xPosition
    lac yPosition
    add ydelta
    dac yPosition
    law 1
    jmp rtn
miss,
    cla
rtn, jmp .

lpx, 0
lpy, 0
xdelta, 0
ydelta, 0
ctr, 0
    endloc 
#endif
