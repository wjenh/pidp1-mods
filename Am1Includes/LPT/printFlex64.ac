#ifndef PRINTFLEX64_AC
#define PRINTFLEX64_AC
// Code to send a line of text produced by the 'text' assembler directive to the printer.
// A 0 word must follow the text string.
// IO has one of the LPT_x line spacing values for terminating the line,
// AC has the address of the text to print.
// Neither AC for IO is preserved.
// Call via jda printFlex.
// This is only for the Type 64 line printer.
#include <LPT/type64defs.ah>

printFlex, 0
    local rtn, loop, done, finish
    dap rtn
    lai
    ior [pas i
    dac finish
loop,
    lio i printFlex
    sni
    jmp done
    lpb
    idx printFlex
    jmp loop
done, xct finish
rtn, jmp .
finish, 0

// Given a pointer to text in AC terminated by a 0 word, send to printer
printOne, 0
    local rtn, loop
    dap rtn
loop,
    lio i printOne
    sni
    jmp rtn
    lpb
    idx printOne
    jmp loop
rtn, jmp .
    endloc 2

    endloc 1
#endif
