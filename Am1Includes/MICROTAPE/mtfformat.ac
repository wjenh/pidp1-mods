// mtfformat.ac -- mtfFormat: give a tape an empty directory, both copies, and mount it.
// Include MICROTAPE/mtfs.ah, then this file once, in any bank, and place that bank's
// constants. It includes mtfdir.ac. Called as mtfdir.ac's entries are.
// 10-Nov-2026, Claude: the library.

#ifndef MTFFORMAT_AC
#define MTFFORMAT_AC

#include <MICROTAPE/mtfs.ah>
#include <MICROTAPE/mtfdir.ac>
#include <AIDS/skipmacros.ah>

local fmRtn, fmP, fmH, fmF, fmQ, fmA, fmN, fmS, fmSbm, fmBlk, fmOff, fmV, fmZ, fmNew, fmZero, \
    fmEnd, fmForeign, fmRd, fr1, fr2, fr3, frx

// Format a tape: an empty directory written as both copies, and the handle mounted on it.
// Without force, a tape whose directory blocks hold another program's data is refused: one of
// blocks 1 and 2 must be this file system's, or both all zeros, as a blank tape reads. Files'
// blocks are not touched. Sequence breaks are off throughout and turned on again only if they
// were on.
// Entry: AC = the parameter block's 16-bit address: the handle (MTF_PHANDLE), the drive
// (MTF_PDRIVE) and force (MTF_PFORCE, nonzero to format whatever is there). Exit: AC = MTF_OK,
// MTF_EFOREIGN, or the block layer's error; the handle is mounted only on MTF_OK. IO is
// clobbered. Called via jda.
mtfFormat, 0
    dac fmRtn
    eem
    lac mtfFormat
    dac fmP
    MTF_SBS_OFF(fmSbm)
    lac i fmP
    dac fmH
    idx fmP
    lac i fmP
    dac fmA                     // the drive, for a moment
    idx fmP
    lac i fmP
    dac fmF

    // The handle: its drive, not mounted.
    lac fmH
    dac fmQ
    lac fmA
    dac i fmQ
    idx fmQ
    dzm i fmQ                   // MTF_HSTATE
    lac fmH
    add [MTF_HMOUNT]
    dac fmQ
    idx i fmQ                   // the old mount's descriptors are no longer valid

    // Unless forced, what blocks 1 and 2 hold: fmV counts this file system's, fmZ the zeros.
    lac fmF
    SKIP_NEXT_IF_AC_ZERO
    jmp fmNew
    dzm fmV
    dzm fmZ
    law MTF_DIRBLK
    dac fmBlk
    law MTF_HDIR
    dac fmOff
    jsp fmRd
    law MTF_DIRBLK2
    dac fmBlk
    law MTF_HBUF
    dac fmOff
    jsp fmRd
    lac fmV
    SKIP_NEXT_IF_AC_ZERO
    jmp fmNew
    lac fmZ
    sas [2]                     // skip if both zeros
    jmp fmForeign

    // The empty directory: zeros, then the header.
fmNew,
    lac fmH
    add [MTF_HDIR]
    dac fmA
    law i MTWDS
    dac fmN
fmZero,
    dzm i fmA
    idx fmA
    isp fmN
    jmp fmZero
    lac fmH
    add [MTF_HDIR]
    dac fmA
    lac [MTF_MAGIC]
    dac i fmA
    idx fmA
    law MTF_VERSION
    dac i fmA
    idx fmA
    dzm i fmA                   // MTF_DGEN; the write makes it 1
    idx fmA
    lac [MTBLKS]
    dac i fmA
    lac fmH
    farjda(mtfWrDir:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp fmEnd
    lac fmH
    add [MTF_HSTATE]
    dac fmQ
    law 1
    dac i fmQ
    cla
fmEnd,
    dac fmS
    MTF_SBS_RESTORE(fmSbm)
    lac fmS
    jmp i fmRtn
fmForeign,
    law MTF_EFOREIGN
    jmp fmEnd

// Read block fmBlk into the handle at fmOff and class it: this file system's counts in fmV,
// all zeros in fmZ, a bad block or another's in neither. Any other error ends the call.
// Called via jsp. AC and IO are clobbered.
fmRd,
    dap frx
    lac fmH
    dac fmQ
    lac i fmQ
    dac mtffPb+MTB_PDRIVE
    lac fmBlk
    dac mtffPb+MTB_PBLOCK
    law 1
    dac mtffPb+MTB_PCOUNT
    lac fmH
    add fmOff
    dac mtffPb+MTB_PBUF
    dac fmA
    lac [mtffPb:.]
    farjda(mtbRead:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp fr1
    lac fmA
    farjda(mtfDirOk:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp fr2
    idx fmV
    jmp frx
fr1,
    sad [MTF_EBADBLOCK]         // skip unless a bad block, which is neither
    jmp frx
    jmp fmEnd
fr2,
    law i MTWDS
    dac fmN
fr3,
    lac i fmA
    SKIP_NEXT_IF_AC_ZERO
    jmp frx
    idx fmA
    isp fmN
    jmp fr3
    idx fmZ
frx,
    jmp .

fmRtn, 0
fmP, 0
fmH, 0
fmF, 0
fmQ, 0
fmA, 0
fmN, 0
fmS, 0
fmSbm, 0
fmBlk, 0
fmOff, 0
fmV, 0
fmZ, 0
endloc

// The block layer's parameter block for this file's reads, MTB_PW words; global so its full
// address can be taken.
mtffPb,
    table MTB_PW

#endif
