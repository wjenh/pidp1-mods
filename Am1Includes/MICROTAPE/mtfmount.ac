// mtfmount.ac -- mtfMount: open a tape's file system on a drive, its directory read into a tape
// handle (mtfs.ah, MTF_TAPE), which the other calls then take.
// Include MICROTAPE/mtfs.ah, then this file once, in any bank, and place that bank's
// constants. It includes mtfdir.ac. Called as mtfdir.ac's entries are.
// 10-Nov-2026, Claude: the library.

#ifndef MTFMOUNT_AC
#define MTFMOUNT_AC

#include <MICROTAPE/mtfs.ah>
#include <MICROTAPE/mtfdir.ac>

local mnRtn, mnP, mnH, mnQ, mnS, mnSbm

// Mount a tape: the handle takes the drive and the directory, the copy in block 2 if block 1
// is bad. Sequence breaks are off throughout and turned on again only if they were on.
// Entry: AC = the parameter block's 16-bit address: the handle (MTF_PHANDLE) and the drive
// (MTF_PDRIVE). Exit: AC = MTF_OK, MTF_ENOFS for a tape without this file system, or the block
// layer's error; the handle is mounted only on MTF_OK. IO is clobbered. Called via jda.
mtfMount, 0
    dac mnRtn
    eem
    lac mtfMount
    dac mnP
    MTF_SBS_OFF(mnSbm)
    lac i mnP
    dac mnH
    dac mnQ
    idx mnP
    lac i mnP
    dac i mnQ                   // MTF_HDRIVE
    lac mnH
    farjda(mtfRdDir:*)
    dac mnS
    MTF_SBS_RESTORE(mnSbm)
    lac mnS
    jmp i mnRtn

mnRtn, 0
mnP, 0
mnH, 0
mnQ, 0
mnS, 0
mnSbm, 0
endloc

#endif
