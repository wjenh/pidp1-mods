// mtfopen.ac -- open a file of a mounted tape into a file descriptor (mtfs.ah, MTF_FILE), by
// its name or its directory slot, and close it, writing its entry back if it changed.
// Include MICROTAPE/mtfs.ah, then this file once, in any bank, and place that bank's
// constants. It includes mtfdir.ac. Called as mtfdir.ac's entries are.
// mtfFdOk is the check every call taking a descriptor makes first.
// 10-Nov-2026, Claude: the library.
// 11-Nov-2026, Claude: the slot's count recorded at the open and checked by mtfFdOk.

#ifndef MTFOPEN_AC
#define MTFOPEN_AC

#include <MICROTAPE/mtfs.ah>
#include <MICROTAPE/mtfdir.ac>
#include <AIDS/skipmacros.ah>

// opFill copies the entry's words in this order.
assert MTF_FTAPE == 0
assert MTF_FSLOT == 1
assert MTF_FFIRST == 2
assert MTF_FALLOC == 3
assert MTF_FLEN == 4
assert MTF_FPOS == 5
assert MTF_FINFO == 6
assert MTF_FFLAGS == 7
assert MTF_FMOUNT == 010
assert MTF_FSTAMP == 011
assert MTF_HSLOTS == MTF_HBUF + MTWDS
assert MTF_TAPEW == MTF_HSLOTS + MTF_NENT
assert MTF_DELEN == MTF_DEFIRST + 2
assert MTF_DEINFO == MTF_DEFIRST + 3

local onRtn, oiRtn, ocRtn, opP, opH, opK, opFd, opQ, opE, opS, opSbm, onRet, \
    oiNofs, oiRange, oiNf, oiRet, opFill, ofx, ocDone, ocBad, ocRet, fkRtn, fkD, fkH, fkQ,     fkM, fkBad

// Open a file by its name.
// Entry: AC = the parameter block's 16-bit address: the handle (MTF_PHANDLE), the name's 16-bit
// address, an am1 ascii string (MTF_PNAME), and the descriptor's (MTF_PFD). Exit: AC = MTF_OK
// with the descriptor open at position 0; MTF_ENOTFOUND, MTF_ENAME or MTF_ENOFS. IO is
// clobbered. Called via jda.
mtfOpenName, 0
    dac onRtn
    eem
    lac mtfOpenName
    dac opP
    lac i opP
    dac opH
    dac mtfoPb+MTF_PHANDLE
    idx opP
    lac i opP
    dac mtfoPb+MTF_PNAME
    idx opP
    lac i opP
    dac opFd
    lac [mtfoNm:.]
    dac mtfoPb+MTF_PNAMED
    lac [mtfoPb:.]
    farjda(mtfLookup:*)
    SKIP_NEXT_IF_AC_ZERO
    jmp onRet
    dio opK
    jsp opFill
    cla
onRet,
    jmp i onRtn

// Open a file by its directory slot, as mtfEntry lists them.
// Entry: AC = the parameter block's 16-bit address: the handle (MTF_PHANDLE), the slot
// (MTF_PINDEX) and the descriptor's 16-bit address (MTF_PFD). Exit: AC = MTF_OK with the
// descriptor open at position 0; MTF_ENOTFOUND for a free slot, MTF_ERANGE for a slot past
// MTF_NENT-1, or MTF_ENOFS. IO is clobbered. Called via jda.
mtfOpenIndex, 0
    dac oiRtn
    eem
    lac mtfOpenIndex
    dac opP
    lac i opP
    dac opH
    idx opP
    lac i opP
    dac opK
    idx opP
    lac i opP
    dac opFd
    lac opH
    add [MTF_HSTATE]
    dac opQ
    lac i opQ
    sas [1]                     // skip if mounted
    jmp oiNofs
    lac opK
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp oiRange
    sub [MTF_NENT]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp oiRange
    lac opK
    sal 3s                      // times MTF_ENTW
    add [MTF_HDIR+MTF_DENT0+MTF_DENAME]
    add opH
    dac opQ
    lac i opQ
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp oiNf
    jsp opFill
    cla
    jmp oiRet
oiNofs,
    law MTF_ENOFS
    jmp oiRet
oiRange,
    law MTF_ERANGE
    jmp oiRet
oiNf,
    law MTF_ENOTFOUND
oiRet,
    jmp i oiRtn

// Close a file: if a write lengthened it or an information-word setter changed it, its entry
// in the handle takes the new length and information word and the directory is written. On an
// error the descriptor stays open and changed, so the close may be repeated. A descriptor
// mtfFdOk refuses is closed with nothing written.
// Entry: AC = the descriptor's 16-bit address; it is the whole parameter block. Exit: AC =
// MTF_OK, MTF_EBADFD (mtfFdOk), or the block layer's error. IO is clobbered. Called via jda.
mtfClose, 0
    dac ocRtn
    eem
    lac mtfClose
    dac opFd
    jda mtfFdOk
    SKIP_NEXT_IF_AC_ZERO
    jmp ocBad
    lac opFd
    add [MTF_FFLAGS]
    dac opQ
    lac i opQ
    and [MTF_FCHANGED]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ocDone
    MTF_SBS_OFF(opSbm)
    lac opFd
    dac opQ
    lac i opQ
    dac opH                     // MTF_FTAPE
    idx opQ
    lac i opQ                   // MTF_FSLOT
    sal 3s
    add [MTF_HDIR+MTF_DENT0+MTF_DELEN]
    add opH
    dac opE
    lac opFd
    add [MTF_FLEN]
    dac opQ
    lac i opQ
    dac i opE
    idx opE                     // MTF_DEINFO
    lac opFd
    add [MTF_FINFO]
    dac opQ
    lac i opQ
    dac i opE
    lac opH
    farjda(mtfWrDir:*)
    dac opS
    MTF_SBS_RESTORE(opSbm)
    lac opS
    SKIP_NEXT_IF_AC_ZERO
    jmp ocRet
ocDone,
    lac opFd
    add [MTF_FFLAGS]
    dac opQ
    dzm i opQ
    cla
    jmp ocRet
ocBad,
    lac opFd
    add [MTF_FFLAGS]
    dac opQ
    dzm i opQ
    law MTF_EBADFD
ocRet,
    jmp i ocRtn

// Whether a descriptor may be used: it is open, its handle is mounted and has not been mounted
// or formatted again since the file was opened, its slot still holds a file at its first
// block, and the slot has not been cleared since. So a descriptor left open across a remount,
// a pack that moved its file, or a delete or replace through another descriptor or call is
// refused, even after a create has taken the same slot and first block.
// Entry: AC = the descriptor's 16-bit address. Exit: AC = MTF_OK or MTF_EBADFD. IO is
// preserved. Called via jda.
mtfFdOk, 0
    dac fkRtn
    lac mtfFdOk
    dac fkD
    add [MTF_FFLAGS]
    dac fkQ
    lac i fkQ
    and [MTF_FOPEN]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp fkBad
    lac i fkD                   // MTF_FTAPE
    dac fkH
    add [MTF_HSTATE]
    dac fkQ
    lac i fkQ
    sas [1]                     // skip if mounted
    jmp fkBad
    lac fkH
    add [MTF_HMOUNT]
    dac fkQ
    lac i fkQ
    dac fkM
    lac fkD
    add [MTF_FMOUNT]
    dac fkQ
    lac i fkQ
    sas fkM                     // skip if the same mount
    jmp fkBad
    lac fkD
    add [MTF_FSLOT]
    dac fkQ
    lac i fkQ
    sal 3s                      // times MTF_ENTW
    add [MTF_HDIR+MTF_DENT0]
    add fkH
    dac fkQ
    lac i fkQ                   // the name's first word, 0 for a free slot
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp fkBad
    lac fkQ
    add [MTF_DEFIRST]
    dac fkQ
    lac i fkQ
    dac fkM
    lac fkD
    add [MTF_FFIRST]
    dac fkQ
    lac i fkQ
    sas fkM                     // skip if the same first block
    jmp fkBad
    lac fkD
    add [MTF_FSLOT]
    dac fkQ
    lac i fkQ
    add [MTF_HSLOTS]
    add fkH
    dac fkQ
    lac i fkQ
    dac fkM
    lac fkD
    add [MTF_FSTAMP]
    dac fkQ
    lac i fkQ
    sas fkM                     // skip if the slot has not been cleared since the open
    jmp fkBad
    cla
    jmp i fkRtn
fkBad,
    law MTF_EBADFD
    jmp i fkRtn

// Fill the descriptor opFd from slot opK of the handle opH, open at position 0, with the
// handle's mount count and the slot's count for mtfFdOk.
// Called via jsp. AC is clobbered, IO is preserved.
opFill,
    dap ofx
    lac opK
    sal 3s
    add [MTF_HDIR+MTF_DENT0+MTF_DEFIRST]
    add opH
    dac opE
    lac opFd
    dac opQ
    lac opH
    dac i opQ                   // MTF_FTAPE
    idx opQ
    lac opK
    dac i opQ                   // MTF_FSLOT
    idx opQ
    lac i opE
    dac i opQ                   // MTF_FFIRST
    idx opE
    idx opQ
    lac i opE
    dac i opQ                   // MTF_FALLOC
    idx opE
    idx opQ
    lac i opE
    dac i opQ                   // MTF_FLEN
    idx opQ
    dzm i opQ                   // MTF_FPOS
    idx opE
    idx opQ
    lac i opE
    dac i opQ                   // MTF_FINFO
    idx opQ
    law MTF_FOPEN
    dac i opQ                   // MTF_FFLAGS
    lac opH
    add [MTF_HMOUNT]
    dac opE
    idx opQ
    lac i opE
    dac i opQ                   // MTF_FMOUNT
    lac opK
    add [MTF_HSLOTS]
    add opH
    dac opE
    idx opQ
    lac i opE
    dac i opQ                   // MTF_FSTAMP
ofx,
    jmp .

onRtn, 0
oiRtn, 0
ocRtn, 0
opP, 0
opH, 0
opK, 0
opFd, 0
opQ, 0
opE, 0
opS, 0
opSbm, 0
fkRtn, 0
fkD, 0
fkH, 0
fkQ, 0
fkM, 0
endloc

// mtfLookup's parameter block for this file's calls, and the packed name it returns; global so
// their full addresses can be taken.
mtfoPb,
    table 3
mtfoNm,
    table MTF_DENAMEW

#endif
