// mtfs.ah -- definitions for the Microtape file system and its block layer: the status
// codes, the parameter blocks, the tape's layout, the directory, the tape handle and the file
// descriptor, the information word, and the macros that reserve a handle or a descriptor.
// Definitions only; the code is in the mt*.ac files, which include this.
// See README.md beside it for the calls.
// 10-Nov-2026, Claude: the library.
// 11-Nov-2026, Claude: mtfRename's parameter words.

#ifndef MTFS_AH
#define MTFS_AH

#include <MICROTAPE/type550defs.ah>
#include <memory.ah>

// The status every call returns in AC: 0 for success, else one of these.
#define MTF_OK 0
#define MTF_ENODRIVE 1      // the drive is not 1-8
#define MTF_ENOTAPE 2       // no tape on the drive, or it has run off its reel
#define MTF_ELOCKED 3       // a write to a write-locked drive
#define MTF_EHALTED 4       // a halt stopped the tape; the call may be repeated
#define MTF_EBADBLOCK 5     // a block did not total zero, or a word was missed
#define MTF_EENDZONE 6      // the tape ran into an end zone during a transfer
#define MTF_ENOFS 7         // the tape has no file-system directory
#define MTF_EFOREIGN 010    // format refused: the directory blocks hold another program's data
#define MTF_ENAME 011       // a name empty, too long, or with a character outside sixbit
#define MTF_EEXISTS 012     // a file of that name is already on the tape
#define MTF_ENOTFOUND 013   // no file of that name or index
#define MTF_EDIRFULL 014    // every directory slot is in use
#define MTF_ENOSPACE 015    // no gap on the tape is large enough
#define MTF_ERANGE 016      // a block, count or position past the tape or the file's allocation
#define MTF_EREADONLY 017   // the file is marked read-only
#define MTF_EBADFD 020      // the descriptor is not open
#define MTF_ESMALLBUF 021   // pack's buffer is smaller than one block
#define MTF_ETIMEOUT 022    // a search saw no block mark in MTB_POLLS polls

// mtbRead's and mtbWrite's parameter block, MTB_PW words.
#define MTB_PDRIVE 0        // the drive, 1-8
#define MTB_PBLOCK 1        // the first block, 0 to MTBLKS-1
#define MTB_PCOUNT 2        // the number of blocks, at least 1
#define MTB_PBUF 3          // the buffer's 16-bit address, MTWDS words a block
#define MTB_PW 4

// The file system's parameter blocks. Every call's block starts with the tape handle's
// 16-bit address; the words after it are the call's own.
#define MTF_PHANDLE 0
#define MTF_PDRIVE 1        // mtfMount, mtfFormat: the drive, 1-8
#define MTF_PFORCE 2        // mtfFormat: nonzero formats whatever the directory blocks hold
#define MTF_PINDEX 1        // mtfEntry: the slot, 0 to MTF_NENT-1
#define MTF_PDEST 2         // mtfEntry: where its MTF_ENTW words go, a 16-bit address
#define MTF_PNEED 1         // mtfFree: the blocks wanted, 0 for none
#define MTF_PTOTAL 2        // mtfFree, set: the free blocks
#define MTF_PLARGEST 3      // mtfFree, set: the largest gap's blocks
#define MTF_PFIT 4          // mtfFree, set: the first gap of MTF_PNEED blocks, or -1
#define MTF_PNAME 1         // mtfOpenName, mtfCreate, mtfLookup: the name's 16-bit address, an
                            // am1 ascii string
#define MTF_PFD 2           // mtfOpenName, mtfOpenIndex: the descriptor's 16-bit address
#define MTF_PNAMED 2        // mtfLookup: where the name's 3 sixbit words go, a 16-bit address
#define MTF_PBLOCKS 2       // mtfCreate: the blocks to allocate, 1 to MTF_MAXBLKS
#define MTF_PINFO 3         // mtfCreate: the information word
#define MTF_PCFD 4          // mtfCreate: the descriptor's 16-bit address
#define MTF_PNEWNAME 2      // mtfRename: the new name's 16-bit address, an am1 ascii string;
                            // MTF_PNAME is the old name's
#define MTF_PREPLACE 3      // mtfRename: nonzero to replace a file of the new name
// mtfRead's, mtfWrite's, mtfSeek's and mtfTrim's blocks start with the descriptor, not the
// handle.
#define MTF_PFDESC 0        // the descriptor's 16-bit address
#define MTF_PBUF 1          // mtfRead, mtfWrite: the buffer's 16-bit address
#define MTF_PCOUNT 2        // mtfRead, mtfWrite: the words to move, at least 0
#define MTF_PPOS 1          // mtfSeek: the new position, 0 to the length
#define MTF_PVALUE 1        // mtfProtect, mtfSetType, mtfSetApp: the new value
// mtfPack's block starts with the handle.
#define MTF_PSCRATCH 1      // the scratch buffer's 16-bit address
#define MTF_PSIZE 2         // its size in words, at least MTWDS; whole blocks of it are used

// Polls of mrs a search waits for the next block mark before giving up, at 55 us a poll about
// 3.3 s. The longest gap is a newly mounted tape's first search: it starts at the load point,
// before the 10 feet of end zone, so block 0's mark comes after the 200 ms start and 1.5 s of
// end zone.
#define MTB_POLLS 0d60000

// cks sets IO bit 6 while the processor is in sequence break mode.
#define MTF_CKSSBM 004000

// Turns sequence breaks off, keeping in save whether they were on.
// AC is preserved, IO is clobbered.
#define MTF_SBS_OFF(save)
    cks
    dio save
    lsm
#enddef

// Turns sequence breaks on again if save says they were on, first clearing the requests made
// while they were off; the tape requests one at every flag. AC is preserved, IO is clobbered.
// The cbs clears every pending and held request, so a call must not be made from a break
// routine. Not to be skipped over: it is several words.
#define MTF_SBS_RESTORE(save)
    lio save
    ril 6s                  // bit 6, the sequence break mode, to the sign
    spi i                   // skip if breaks were on
    jmp .+3
    cbs
    esm
#enddef

// The tape's layout: block 0 unused, so a search back to the directory turns at its reverse
// mark and never in the end zone; the directory and its copy; then the files.
#define MTF_DIRBLK 1
#define MTF_DIRBLK2 2
#define MTF_FIRSTBLK 3

// The directory block's header.
#define MTF_DMAGIC 0        // MTF_MAGIC: the tape holds this file system
#define MTF_DVER 1          // MTF_VERSION
#define MTF_DGEN 2          // the generation, new for every write of the directory
#define MTF_DBLKS 3         // MTBLKS, the blocks on the tape
#define MTF_MAGIC 0556446   // MTF in sixbit
#define MTF_VERSION 1

// The directory's entries, MTF_NENT of MTF_ENTW words from word MTF_DENT0.
#define MTF_DENT0 010
#define MTF_ENTW 010
#define MTF_NENT 037
#define MTF_DENAME 0        // 3 words, 9 sixbit characters, blank-padded; all zero: free
#define MTF_DENAMEW 3
#define MTF_DEFIRST 3       // the first block
#define MTF_DEALLOC 4       // the blocks allocated
#define MTF_DELEN 5         // the length in words
#define MTF_DEINFO 6        // the information word
#define MTF_DEMOVE 7        // 0; while pack moves the file, its new first block

// The information word: bit 0 read-only (the library enforces it), bits 1-5 the
// application's, bits 6-17 the file type, the application's.
#define MTF_IRO 0400000
#define MTF_IAPP 0370000
#define MTF_ITYPE 007777
#define MTF_IAPPMAX 037     // the application field's largest value, right-justified

// An information word's fields, from the word in AC to AC, right-justified. IO is preserved.
#define MTF_INFO_RO and [MTF_IRO]
#define MTF_INFO_APP and [MTF_IAPP]; sar 9s; sar 3s
#define MTF_INFO_TYPE and [MTF_ITYPE]

// A tape handle, MTF_TAPEW words, one per mounted tape.
#define MTF_HDRIVE 0        // the drive, 1-8
#define MTF_HSTATE 1        // 0 not mounted, 1 mounted
#define MTF_HGEN 2          // the directory's generation as read
#define MTF_HMOUNT 3        // counts the mounts and formats, so a descriptor knows its own
#define MTF_HDIR 010        // the directory, MTWDS words
#define MTF_HBUF 0410       // the block buffer, MTWDS words
#define MTF_TAPEW 01010

// A file descriptor, MTF_FILEW words.
#define MTF_FTAPE 0         // the tape handle's 16-bit address
#define MTF_FSLOT 1         // the directory slot, 0 to MTF_NENT-1
#define MTF_FFIRST 2        // the first block
#define MTF_FALLOC 3        // the blocks allocated
#define MTF_FLEN 4          // the length in words
#define MTF_FPOS 5          // the position in words
#define MTF_FINFO 6         // the information word
#define MTF_FFLAGS 7        // MTF_FOPEN, MTF_FCHANGED
#define MTF_FMOUNT 010      // the handle's MTF_HMOUNT when the file was opened
#define MTF_FILEW 011
#define MTF_FOPEN 1
#define MTF_FCHANGED 2

// A file's largest allocation: its length and position in words must stay positive.
#define MTF_MAXBLKS 0777

// Reserve a tape handle or a file descriptor at the current location, zero when the program is
// loaded: not mounted, not open. A program restarted without a reload finds them as it left
// them, and should mount and open afresh.
#define MTF_TAPE(name)
name,
    table MTF_TAPEW, 0
#enddef

#define MTF_FILE(name)
name,
    table MTF_FILEW, 0
#enddef

#endif
