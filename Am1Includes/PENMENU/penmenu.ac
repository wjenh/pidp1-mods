// penmenu.ac -- the pen menu's code: a bar of items, each a button or a list that drops below
// it, a list's row able to own one sublist beside it, and a Select box, OK, beside the lit row
// that acts on it. Three entries, pmInit at the program's start, pmHit for each light-pen hit
// the program gives the menu, pmTick on each pass of the program's main loop; and the word
// pmOpen, nonzero while a list is open.
// The program defines PM_BAR (penmenu.ah), includes penmenu.ah, then this file once, in any
// bank, and penmenulist.ac once, in bank 0 or 1. The code runs with the extend window open,
// reaches the list by its 16-bit addresses, and issues no IOT: the program reads the pen and the
// clock and starts the display. It is not reentrant; call it from the main loop only. Every
// entry is entered by jda with the window open, farjda (memory.ah) from another bank: AC the
// clock in ms, IO the argument; it returns with the window open, its answer in AC. The bank's
// literals are placed by the program's constants.
// Lighting a row is moving the pen onto it; the light stays when the pen leaves. A row owning
// a sublist opens it while lit, and is never acted on itself. There is one box, beside the lit
// row of the list, or of the open sublist, and none while no row is lit.
// 04-Nov-2026, Claude: the library, from Sketchpad's menu.

#ifndef PENMENU_AC
#define PENMENU_AC

// The menu at the program's start: every label's place written, every label normal, no list
// open, the box shut. Call it before the display may reach the menu.
// Entry: AC = the clock (not used). Exit: AC = 0. IO is preserved. Called via jda.
pmInit, 0
    local miRtn, miBar, miSub, miSNext, miNext, miDone, miP, miC, miD, miQ, miR, miK, miN
    dac miRtn
    lac [jump (pmEnd:*) next(parameter)]
    dac i [pmSel:*]
    dac i [pmBoxG:*]
    dzm pmOpen
    dzm pmSD
    dzm pmAny
    law PMNOROW
    dac pmLit
    dac pmSLit
    dac pmLastCol

    // Each bar item: its label normal at its column; an item's list from row 0 in the column,
    // and each of its sublists from the row owning it, PMSUBDX on.
    lac [pmRbar:.]
    dac miP
    dzm miC
miBar,
    lac miC
    sad pmBarN          // skip while items remain
    jmp miDone
    lac i miP
    dac miQ
    lac [PMNORM]
    dac i miQ
    idx miQ
    idx miQ
    lac miC
    ral 7s
    add [PMMARGIN]
    and [01777]
    ior [x(0) next(character)]
    dac i miQ
    lac miP
    add [2]
    dac miQ
    lac i miQ
    sza i               // skip if the item owns a list
    jmp miNext
    dac miD
    dzm pmIBase
    lac miC
    ral 7s
    add [PMMARGIN]
    dac pmIX
    lac miD
    jda pmInRows
    lac pmIN
    dac miN
    lac i miD
    dac miQ
    dzm miK
miSub,
    lac miK
    sad miN             // skip while rows remain
    jmp miNext
    lac miQ
    add [2]
    dac miR
    lac i miR
    sza i               // skip if the row owns a sublist
    jmp miSNext
    dac miD
    lac miK
    dac pmIBase
    lac miC
    ral 7s
    add [PMSUBDX + PMMARGIN]
    dac pmIX
    lac miD
    jda pmInRows
miSNext,
    lac miQ
    add [PMRECW]
    dac miQ
    idx miK
    jmp miSub
miNext,
    lac miP
    add [PMRECW]
    dac miP
    idx miC
    jmp miBar
miDone,
    cla
    jmp i miRtn
miRtn, 0
miP, 0
miC, 0
miD, 0
miQ, 0
miR, 0
miK, 0
miN, 0
    endloc

// Place a list's or a sublist's rows: each label normal, its y from row pmIBase down, its x
// pmIX, and the tail word pointed at the box.
// Entry: AC = the descriptor's 16-bit address; pmIBase, pmIX. Exit: pmIN = the row count. AC and
// IO are clobbered. Called via jda.
pmInRows, 0
    local irRtn, irLoop, irP, irR, irB, irY, irK
    dap irRtn
    lac pmInRows
    dac irP
    lac i irP
    dac irR
    idx irP
    lac i irP
    dac pmIN
    idx irP
    lac i irP
    dac irB
    lac [jump (pmBox:*) next(parameter)]
    dac i irB
    lac pmIBase
    jda pmRowY
    dac irY
    lac pmIN
    sza i               // skip unless the list is empty
    jmp irRtn
    cma
    dac irK
irLoop,
    lac i irR
    dac irB
    lac [PMNORM]
    dac i irB
    idx irB
    lac irY
    and [01777]
    ior [y(0) next(point)]
    dac i irB
    idx irB
    lac pmIX
    and [01777]
    ior [x(0) next(character)]
    dac i irB
    lac irY
    sub [PMPITCH]
    dac irY
    lac irR
    add [PMRECW]
    dac irR
    isp irK
    jmp irLoop
irRtn, jmp .
irP, 0
irR, 0
irB, 0
irY, 0
irK, 0
    endloc

// A light-pen hit given to the menu. On the bar, a column whose item fires: at a press's first
// hit, or when the pen comes from another column, so a pen resting on a label fires it once.
// With a list open, another column closes it first, and its own column, at a press's first hit,
// closes it with nothing acted on. A button answers its action; an item owning a list opens it.
// Below the bar, with a list open: a hit on its rows lights the row under it, opening the row's
// sublist if it owns one; on the open sublist's rows, lights that row; on the box, at a press's
// first hit only, acts on the lit row and closes the list. Any other hit does nothing.
// Entry: AC = the clock; IO = the hit as drc gives it, x and y each without its low bit, x in
// the high 9 bits. Exit: AC = the action of the button hit or of the row OK chose, or 0. IO is
// clobbered. Called via jda.
pmHit, 0
    local mhRtn, mhFr1, mhFr2, mhBelow, mhBFresh, mhFire, mhList, mhOwn, mhRows, mhSubs, \
        mhBox, mhNone, mhCol, mhP, mhQ, mhRel
    dac mhRtn

    // The hit's x and y in the 340's units, each low bit restored as 0.
    dio pmHW
    lac pmHW
    and [0777]
    sal 1s
    dac pmHY
    lac pmHW
    sar 9s
    and [0777]
    sal 1s
    dac pmHX

    // pmFresh, at or above 0 for a press's first hit, PMGAPMS having passed since the last.
    lac pmAny
    sza i               // skip unless the first hit since pmInit
    jmp mhFr1
    lac pmHit
    PUI_SINCE(pmLastAt)
    sub [PMGAPMS]
    jmp mhFr2
mhFr1,
    cla
mhFr2,
    dac pmFresh
    lac pmHit
    dac pmLastAt
    law 1
    dac pmAny
    lac pmHY
    sub [PMBARYMIN]
    spa                 // skip if on the bar
    jmp mhBelow

    // The bar: the column, an item in it, and whether it fires.
    lac pmHX
    sar 7s
    dac mhCol
    sub pmBarN
    sma                 // skip if the bar has an item in the column
    jmp mhNone
    lac pmOpen
    sza i               // skip if a list is open
    jmp mhBFresh
    lac mhCol
    sad pmOCol          // skip unless the open list's column
    jmp mhOwn
mhBFresh,
    lac pmFresh
    sma                 // skip unless a press's first hit
    jmp mhFire
    lac mhCol
    sad pmLastCol       // skip if the pen came from another column
    jmp mhNone
mhFire,
    lac pmOpen
    sza                 // skip unless a list is open
    jsp pmClose
    lac mhCol
    dac pmLastCol
    ral 1s
    add mhCol
    add [pmRbar:.]
    dac mhP
    add [2]
    dac mhQ
    lac i mhQ
    sza                 // skip unless the item owns a list
    jmp mhList
    idx mhP
    lac i mhP           // the button's action
    jmp i mhRtn
mhList,
    lio mhCol
    dio pmOCol
    jda pmOpenL
    jmp mhNone
mhOwn,
    lac pmFresh
    spa                 // skip on a press's first hit
    jmp mhNone
    jsp pmClose
    jmp mhNone

    // Below the bar: the list's rows, the sublist's, or the box, by x within the column.
mhBelow,
    lac pmOpen
    sza i               // skip if a list is open
    jmp mhNone
    lac pmOCol
    ral 7s
    dac mhRel
    lac pmHX
    sub mhRel
    dac mhRel
    sub [PMLEDGE]
    spa                 // skip if at or right of the list's edge
    jmp mhRows
    lac pmSD
    sza i               // skip if a sublist is open
    jmp mhBox
    lac mhRel
    sub [PMSEDGE]
    spa                 // skip if at or right of the sublist's edge
    jmp mhSubs
mhBox,
    lac pmFresh
    spa                 // skip on a press's first hit
    jmp mhNone
    jsp pmSelect
    jmp i mhRtn
mhRows,
    lac pmON
    dac pmRN
    dzm pmRBase
    lac pmHY
    jda pmRowOf
    sad [PMNOROW]       // skip if on a row
    jmp mhNone
    sad pmLit           // skip unless the row is lit already
    jmp mhNone
    jda pmLight
    jmp mhNone
mhSubs,
    lac pmSN
    dac pmRN
    lac pmSFirst
    dac pmRBase
    lac pmHY
    jda pmRowOf
    sad [PMNOROW]       // skip if on a row
    jmp mhNone
    sad pmSLit          // skip unless the row is lit already
    jmp mhNone
    jda pmLightS
mhNone,
    cla
    jmp i mhRtn
mhRtn, 0
mhCol, 0
mhP, 0
mhQ, 0
mhRel, 0
    endloc

// The menu's tick, each pass of the main loop: a list with no menu hit for PMIDLEMS closes.
// Entry: AC = the clock. Exit: AC = 0. IO is clobbered. Called via jda.
pmTick, 0
    local tkRtn, tkOut
    dac tkRtn
    lac pmOpen
    sza i               // skip if a list is open
    jmp tkOut
    lac pmTick
    PUI_SINCE(pmLastAt)
    sub [PMIDLEMS]
    spa                 // skip once PMIDLEMS have passed with no menu hit
    jmp tkOut
    jsp pmClose
tkOut,
    cla
    jmp i tkRtn
tkRtn, 0
    endloc

// The row a y falls on, in a run of pmRN rows whose first is row pmRBase below the bar: the
// first whose band, from PMSLOP below its baseline up, holds the y.
// Entry: AC = y; pmRBase, pmRN. Exit: AC = the row, from the run's first, or PMNOROW below
// every row. IO is clobbered. Called via jda.
pmRowOf, 0
    local roRtn, roLoop, roNext, roNone, roB, roI
    dap roRtn
    lac pmRBase
    jda pmRowY
    sub [PMSLOP]
    dac roB
    dzm roI
roLoop,
    lac roI
    sad pmRN            // skip while rows remain
    jmp roNone
    lac pmRowOf
    sub roB
    spa                 // skip if at or above this row's band
    jmp roNext
    lac roI
    jmp roRtn
roNext,
    lac roB
    sub [PMPITCH]
    dac roB
    idx roI
    jmp roLoop
roNone,
    law PMNOROW
roRtn, jmp .
roB, 0
roI, 0
    endloc

// Row k's baseline, PMROWY0 less k pitches.
// Entry: AC = k. Exit: AC = the y. IO is preserved. Called via jda.
pmRowY, 0
    local ryRtn, ryLoop, ryDone, ryK, ryY
    dap ryRtn
    lac [PMROWY0]
    dac ryY
    lac pmRowY
    sza i               // skip unless row 0
    jmp ryDone
    cma
    dac ryK
ryLoop,
    lac ryY
    sub [PMPITCH]
    dac ryY
    isp ryK
    jmp ryLoop
ryDone,
    lac ryY
ryRtn, jmp .
ryK, 0
ryY, 0
    endloc

// Open a list: every row normal, none lit, no sublist, its bar item lit, and last the selector
// pointed at its first row, since only then can the display reach it.
// Entry: AC = the list's descriptor's 16-bit address; pmOCol = its column. AC and IO are
// clobbered. Called via jda.
pmOpenL, 0
    local olRtn, olRows, olShow, olP, olK
    dap olRtn
    lac pmOpenL
    dac olP
    lac i olP
    dac pmOR
    idx olP
    lac i olP
    dac pmON
    idx olP
    lac i olP
    dac pmOT
    law PMNOROW
    dac pmLit
    dzm pmSD
    lac pmOR
    dac pmPR
    lac [PMNORM]
    dac pmPW
    dzm olK
olRows,
    lac olK
    sad pmON            // skip while rows remain
    jmp olShow
    jda pmPaint
    idx olK
    jmp olRows
olShow,
    lac [PMLIT]
    jda pmBarW
    law 1
    dac pmOpen
    lac i pmOR
    ior [jump next(parameter)]
    dac i [pmSel:*]
olRtn, jmp .
olP, 0
olK, 0
    endloc

// Close the open list. The selector goes back to the end first, so the display no longer
// reaches the list; then the box shuts, the sublist closes, and the bar item is normal again.
// AC and IO are clobbered. Called via jsp.
pmClose,
    local clRtn
    dap clRtn
    lac [jump (pmEnd:*) next(parameter)]
    dac i [pmSel:*]
    dac i [pmBoxG:*]
    jsp pmSubC
    lac [PMNORM]
    jda pmBarW
    dzm pmOpen
    law PMNOROW
    dac pmLit
clRtn, jmp .
    endloc

// Write the open list's bar item's parameter word.
// Entry: AC = the word. AC is clobbered, IO preserved. Called via jda.
pmBarW, 0
    local bwRtn, bwP
    dap bwRtn
    lac pmOCol
    ral 1s
    add pmOCol
    add [pmRbar:.]
    dac bwP
    lac i bwP
    dac bwP
    lac pmBarW
    dac i bwP
bwRtn, jmp .
bwP, 0
    endloc

// Close the open sublist, if any: the list's tail word back to the box.
// AC is clobbered, IO preserved. Called via jsp.
pmSubC,
    local scRtn
    dap scRtn
    lac pmSD
    sza i               // skip if a sublist is open
    jmp scRtn
    lac [jump (pmBox:*) next(parameter)]
    dac i pmOT
    dzm pmSD
    law PMNOROW
    dac pmSLit
scRtn, jmp .
    endloc

// Light a row of the open list, the one lit before normal again. The box shuts and any sublist
// closes; then the row's own sublist, if it owns one, opens, its rows normal and none lit, the
// tail word pointed at it last; or else the box stands beside the row.
// Entry: AC = the row. AC and IO are clobbered. Called via jda.
pmLight, 0
    local lgRtn, lgSub, lgShow, lgBox, lgOld, lgP, lgQ, lgK
    dap lgRtn
    lac pmLit
    dac lgOld
    lac pmLight
    dac pmLit
    lac pmOR
    dac pmPR
    lac [PMNORM]
    dac pmPW
    lac lgOld
    jda pmPaint
    lac [PMLIT]
    dac pmPW
    lac pmLit
    jda pmPaint
    jsp pmHide
    jsp pmSubC
    lac pmLit
    ral 1s
    add pmLit
    add pmOR
    dac lgP
    add [2]
    dac lgQ
    lac i lgQ
    sza i               // skip if the row owns a sublist
    jmp lgBox
    dac pmSD
    dac lgQ
    lac i lgQ
    dac pmSR
    idx lgQ
    lac i lgQ
    dac pmSN
    lac pmLit
    dac pmSFirst
    law PMNOROW
    dac pmSLit
    lac pmSR
    dac pmPR
    lac [PMNORM]
    dac pmPW
    dzm lgK
lgSub,
    lac lgK
    sad pmSN            // skip while rows remain
    jmp lgShow
    jda pmPaint
    idx lgK
    jmp lgSub
lgShow,
    lac i pmSR
    ior [jump next(parameter)]
    dac i pmOT
    jmp lgRtn
lgBox,
    lac pmLit
    dac pmBRow
    lac pmOCol
    ral 7s
    add [PMBOXDX]
    dac pmBX
    lac i lgP
    jda pmPlace
lgRtn, jmp .
lgOld, 0
lgP, 0
lgQ, 0
lgK, 0
    endloc

// Light a row of the open sublist, the one lit before normal again, and stand the box beside
// it.
// Entry: AC = the row, from the sublist's first. AC and IO are clobbered. Called via jda.
pmLightS, 0
    local lsRtn, lsOld, lsP
    dap lsRtn
    lac pmSLit
    dac lsOld
    lac pmLightS
    dac pmSLit
    lac pmSR
    dac pmPR
    lac [PMNORM]
    dac pmPW
    lac lsOld
    jda pmPaint
    lac [PMLIT]
    dac pmPW
    lac pmSLit
    jda pmPaint
    lac pmSLit
    add pmSFirst
    dac pmBRow
    lac pmOCol
    ral 7s
    add [PMSUBDX + PMBOXDX]
    dac pmBX
    lac pmSLit
    ral 1s
    add pmSLit
    add pmSR
    dac lsP
    lac i lsP
    jda pmPlace
lsRtn, jmp .
lsOld, 0
lsP, 0
    endloc

// Write a row's parameter word; PMNOROW is passed over.
// Entry: AC = the row; pmPR = its run's records' 16-bit address, pmPW = the word. AC is
// clobbered, IO preserved. Called via jda.
pmPaint, 0
    local ppRtn, ppP
    dap ppRtn
    lac pmPaint
    sad [PMNOROW]       // skip if a row is given
    jmp ppRtn
    ral 1s
    add pmPaint
    add pmPR
    dac ppP
    lac i ppP
    dac ppP
    lac pmPW
    dac i ppP
ppRtn, jmp .
ppP, 0
    endloc

// Stand the box beside a row and open its gate: its y and x first, and the leader's length
// for the row's label, so the display never draws it where it is leaving.
// Entry: AC = the row's label's block, its 16-bit address; pmBRow = the row, from the bar's
// first; pmBX = the box's left side. AC and IO are clobbered. Called via jda.
pmPlace, 0
    local plRtn, plP
    dap plRtn
#if PMLEADER
    lac pmPlace
    add [3]
    jda pmLen
    add [pmLeadT:.]
    dac plP
    lac i plP
    dac i [pmLeadV:*]
#endif
    lac pmBRow
    jda pmRowY
    add [PMBOXRISE]
    and [01777]
    ior [y(0) next(point)]
    dac i [pmBoxY:*]
    lac pmBX
    and [01777]
    ior [x(0) next(vector)]
    dac i [pmBoxX:*]
    lac [jump (pmBoxP:*) next(parameter)]
    dac i [pmBoxG:*]
plRtn, jmp .
plP, 0
    endloc

// Shut the box's gate. AC is clobbered, IO preserved. Called via jsp.
pmHide,
    local hdRtn
    dap hdRtn
    lac [jump (pmEnd:*) next(parameter)]
    dac i [pmBoxG:*]
hdRtn, jmp .
    endloc

// Act on the lit row: the open sublist's when one is open, else the list's; close the list.
// With no row lit, or a row owning a sublist, nothing, the list staying open.
// Exit: AC = the row's action, or 0. IO is clobbered. Called via jsp.
pmSelect,
    local seRtn, seList, seRec, seNone, seK, seP, seA
    dap seRtn
    lac pmSD
    sza i               // skip if a sublist is open
    jmp seList
    lac pmSLit
    sad [PMNOROW]       // skip if one of its rows is lit
    jmp seNone
    dac seK
    lac pmSR
    jmp seRec
seList,
    lac pmLit
    sad [PMNOROW]       // skip if a row is lit
    jmp seNone
    dac seK
    lac pmOR
seRec,
    dac seP
    lac seK
    ral 1s
    add seK
    add seP
    add [1]
    dac seP
    lac i seP
    dac seA
    sza i               // skip if the row acts
    jmp seNone
    jsp pmClose
    lac seA
    jmp seRtn
seNone,
    cla
seRtn, jmp .
seK, 0
seP, 0
seA, 0
    endloc

// A label's characters, the codes before its end that are not shifts, at most 8.
// Entry: AC = the text's 16-bit address. Exit: AC = the count. IO is preserved. Called via jda.
pmLen, 0
    local lnRtn, lnWord, lnCode, lnNext, lnDone, lnP, lnW, lnC, lnN
    dap lnRtn
    lac pmLen
    dac lnP
    dzm lnN
lnWord,
    lac i lnP
    dac lnW
    idx lnP
    law i 3
    dac lnC
lnCode,
    lac lnW
    ral 6s
    dac lnW
    and [077]
    sad [037]           // skip unless the end
    jmp lnDone
    sad [035]           // skip unless an upper shift
    jmp lnNext
    sad [036]           // skip unless a lower shift
    jmp lnNext
    idx lnN
    sad [0d8]           // skip unless the eighth
    jmp lnDone
lnNext,
    isp lnC
    jmp lnCode
    jmp lnWord
lnDone,
    lac lnN
lnRtn, jmp .
lnP, 0
lnW, 0
lnC, 0
lnN, 0
    endloc

// The menu's state: a list open, its column, its records, row count and tail word, its lit row;
// the open sublist's descriptor (0 for none), records, count, first row and lit row; the last
// menu hit's time, whether there has been one, its column when it fired, and whether this hit
// begins a press; the hit; and the words the routines above pass among themselves.
pmOpen, 0
pmOCol, 0
pmOR, 0
pmON, 0
pmOT, 0
pmLit, 0
pmSD, 0
pmSR, 0
pmSN, 0
pmSFirst, 0
pmSLit, 0
pmLastAt, 0
pmAny, 0
pmLastCol, 0
pmFresh, 0
pmHW, 0
pmHX, 0
pmHY, 0
pmIBase, 0
pmIX, 0
pmIN, 0
pmRBase, 0
pmRN, 0
pmPR, 0
pmPW, 0
pmBRow, 0
pmBX, 0

// The leader's vector for a label of n characters, 0 to 8.
pmLeadT,
    deltax(PMLEADLEN(0d0)) deltay(0) left visible end
    deltax(PMLEADLEN(0d1)) deltay(0) left visible end
    deltax(PMLEADLEN(0d2)) deltay(0) left visible end
    deltax(PMLEADLEN(0d3)) deltay(0) left visible end
    deltax(PMLEADLEN(0d4)) deltay(0) left visible end
    deltax(PMLEADLEN(0d5)) deltay(0) left visible end
    deltax(PMLEADLEN(0d6)) deltay(0) left visible end
    deltax(PMLEADLEN(0d7)) deltay(0) left visible end
    deltax(PMLEADLEN(0d8)) deltay(0) left visible end

// The tables made from the program's PM_BAR: the bar's records, one per column, then each list's
// descriptor and records, then each sublist's.
pmBarN, (pmEbar - pmRbar) / PMRECW
pmRbar,
    PM_BAR(PM_BSUB, PM_BACT)
pmEbar, ;
    PM_BAR(PM_DLIST, PM_NIL)
    PM_BAR(PM_DSUBS, PM_NIL)

#endif
