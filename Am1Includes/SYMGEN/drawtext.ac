#ifndef TYPE33DRAWTEXT
#define TYPE33DRAWTEXT
#include <SYMGEN/drawchar.ac>

// Draw a line of characters starting at the current display location.
// The characters consist of a list of words produced by the text pseudo-op, flex code.
// AC contains the address of the list produced by text.
// A word following the last entry must be 013, stop.
// Auto-space must be enabled.
// Uses AC and IO registers.
// Called via jda.
drawtext, 0
    local rtn, shift, cnt, chr, top, loop, nxt, toupper, tolower, wait, bye
    dap rtn
    dzm shift
    lac [nop
    dac wait
top, lac i drawtext     // fetch next word from text
    sad [13
    jmp bye             // end marker
    dac chr             // we have to dig out the 3 chars
    lac [-3
    dac cnt
    idx drawtext        // set up for next word
loop,
    lac chr
    cli
    rcl 6s              // lop off the top 6 bits, into IO
    dac chr
    lai                 // original high 6 bits now in AC low 6 bits
    sad [72             // lower case shift
    jmp tolower
    sad [74             // upper case shift
    jmp toupper
    ior shift           // was it shifted
    xct wait
    jda drawcharn       // finally
    lac [ioh
    dac wait
nxt,isp cnt
    jmp loop
    jmp top

toupper, law 0100
    dac shift
    jmp nxt
tolower, dzm shift
    jmp nxt

bye, xct wait
rtn, jmp .

shift, 0
cnt, 0
chr, 0
wait, 0
    endloc
#endif
