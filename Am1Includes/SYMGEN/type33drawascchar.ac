#ifndef TYPE33DRAWASCCHAR
#define TYPE33DRAASCWCHAR
#include <SYMGEN/type33iots.ah>
#include <SYMGEN/type33ascchars.ac>

// Draw one ascii character at the current display location, 
// AC contains the ascii char.
// Both AC and IO registers are used.
// Does NOT wait until drawing is complete, caller must issue an ioh.
// Called via jda.
drawasccharn, 0
    local rtn
    dap rtn
    lac drawasccharn
    sub [0x20   // no nonprinting chars
    sal 1s      // the table has 2 entries per character
    add [t33ascchrs
    dac drawasccharn
    lio i drawasccharn
    iot i gpl
    idx drawasccharn
    lio i drawasccharn
    iot C gpr
rtn, jmp .
    endloc

// Draw one character at the current display location, 
// AC contains the ascii char.
// Both AC and IO registers are used.
// Waits until drawing is complete.
// Called via jda.
drawascchar, 0
    local rtn
    dap rtn
    lac drawascchar
    jda drawasccharn
    ioh
rtn, jmp .
    endloc
#endif
