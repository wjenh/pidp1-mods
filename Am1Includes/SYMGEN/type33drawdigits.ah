#ifndef TYPE33DRAWDIGITS
#define TYPE33DRAWDIGITS
#include <SYMGEN/type33digits.ah>

// Draw one one digit 0-9 at the current display location, 
// AC contains the value.
// Uses AC and IO registers.
// Called via jda.
drawdigit, 0
    local rtn
    dac rtn
    lac drawdigit
    sal 1s      // the table has 2 entries per character
    add [t33digits
    dac drawdigit
    lio i drawdigit
    iot i gpl
    ioh
    idx drawdigit
    lio i drawdigit
    iot i gpr
    ioh
    jmp i rtn
rtn, 0
    endloc
#endif
