#ifndef TYPE33RENDER
#define TYPE33RENDER

// Draw a buffer of bit patterns, 2 words per 5x7 character, that are in gpl, gpr format.
// The buffer starting address is in AC, the number of word pairs in the buffer is in IO.
// Uses IO and AC.
// Called via jda.
renderchars, 0
    local rtn, top, count
    dac rtn
    lai
    cma
    dac count           // -count
top, lio i renderchars  // fetch next char bits word from buffer
    iot C gpl
    idx renderchars
    lio i renderchars   // second word
    ioh
    iot C gpr
    idx renderchars
    ioh

    isp count
    jmp top
    jmp i rtn

rtn, 0
count, 0
    endloc
#endif
