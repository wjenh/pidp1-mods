#ifndef TYPETEXT_AC
#define TYPETEXT_AC
// Type a line of characters on the typewriter.
// The characters consist of a list of words produced by the text pseudo-op, flex code.
// AC contains the address of the list produced by text.
// A word following the last entry must be 013, stop.
// Uses AC and IO registers.
// Called via jda.
typetext, 0
    local rtn, cnt, chr, top, loop, nxt
    dap rtn
top, lac i typetext     // fetch next word from text
    sad [13
    jmp rtn             // end marker
    dac chr             // we have to dig out the 3 chars
    lac [-3
    dac cnt
    idx typetext        // set up for next word
loop,
    lac chr
    cli
    rcl 6s              // lop off the top 6 bits, into IO
    dac chr
    lai                 // original high 6 bits now in AC low 6 bits
    lia
    tyo i
nxt,isp cnt
    jmp loop
    jmp top
rtn, jmp .

cnt, 0
chr, 0
    endloc
#endif
