#ifndef TYPE340IOTS_AH
#define TYPE340IOTS_AH
/* Just the IOT defines for the Type 340 display.
 * See the documentation for details on use.
 * The defines for the Type 340 processor's instructions are in type340cmds.ah,
 * allowing them to be included separately.
 *
 * IMPORTANT - the Type 23 Parallel Drum uses dra and dss also.
 * If you use both, you will get the error below.
 * Instead, use the alt version to get t340dra and t340dss.
 */

#ifndef _NO_DRA_DSS
#ifdef dra
#warning "dra is already defined, you are probably using the Type 23 drum, use t340dra and t340dss instead."
#warning "dra and will now be undefined, you might also need to use t23dra and t23dss."
#undef dra
#undef dss
#define dra _Pragma("GCC error \"dra has been disabled, use t340dra and t23dra instead.\"")
#define dss _Pragma("GCC error \"dss has been disabled, use t340dss and t23dss instead.\"")
#else
#define dra iot 016
#define dss iot 0217
#endif
#endif

#define dla iot 015
#define drs iot 0115
#define dcf iot 0215
#define t340dra iot 016
#define t340dss iot 0217
#define drc iot 0116
#define drp iot 0216
#define dsp iot 0117
#define dsv iot 0417
#define dsh iot 01017

#endif
