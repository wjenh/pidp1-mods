#ifndef MEMCPY_AH
#define MEMCPY_AH
// Copy from one location to another.
// AC has the count of words to copy.
// The word following the call has the address to copy from.
// The next word has the address to copy to.
// Call using jda.
// This is cross-bank safe.
memcpy, 0
local rtn, ok, loop, src, dest
// AC is in memcpy, return PC in AC
    dac rtn
    // See if eem is on.
    // If not, mask the arg/return addr to 12 bits.
    and [0200000]
    sza
    jmp ok      // it's on, ok to proceed
    lac rtn     // off, mask the addresses
    and [07777
    dac rtn
ok,
    lio i rtn
    dio src
    idx rtn
    lio i rtn
    dio dest
    idx rtn
    lac memcpy
    cma
loop, add [1
    lsw
    lac i src
    dac i dest
    idx src
    idx dest
    lsw
    sza
    jmp loop
    jmp i rtn
rtn, 0
src, 0
dest, 0
endloc

#endif
