// Useful things for extended memory access
// eem will be silently managed for the data accessors, farlac, farlio,
// fardac, fardio transparently, leaving eem off.
// For farjmp, eem will be left on.
// For farjsp and farjda, eem will be on when the subroutine is entered.
// When they return, eem will remain on.
//
// Using farenter will properly set up the subroutine return for cross-bank return and turn off eem.
// Using farrtn will properly return leaving eem on.
//
// DO NOT use skip instructions to skip any of these, e.g:
//     sza // skip next instruction if AC is 0
//     jsp foo
// because these are all multi-instruction macros, the code will fail.
//
// For more fine-grained control, the crossBankjmp, crossBankjda, crossBankjsp versions can be used.
// These allow control of whether an initial eem is done or not:
// crossBankjmp(xx:*, TRUE), crossBankjmp(xx:*, FALSE);
// This allows eliminating a superflous eem if it is already on.

#ifndef MEMORY_AH
#define MEMORY_AH
#include <stddefs.ah>

#define MEM_CONCAT_HIDDEN(prefix, cond) prefix ## cond
#define MEM_CONCAT(prefix, cond) MEM_CONCAT_HIDDEN(prefix, cond)

#define farjmp(a) \
    eem; jmp i [a]

#define CROSS_BANK_JMP1(a) eem; jmp i [a]
#define CROSS_BANK_JMP0(a) jmp i [a]
#define crossBankjmp(a, cond) MEM_CONCAT(CROSS_BANK_JMP, cond)(a)

#define farjsp(a) \
    eem; jsp i [a]

#define CROSS_BANK_JSP1(a) eem; jsp i [a]
#define CROSS_BANK_JSP0(a) jsp i [a]
#define crossBankjsp(a, cond) MEM_CONCAT(CROSS_BANK_JSP, cond)(a)

#define farjda(a) \
    eem; dac i [a]; jsp i [a+1]

#define CROSS_BANK_JDA1(a) eem; dac i [a]; jsp i [a+1]
#define CROSS_BANK_JDA0(a) dac i [a]; jsp i [a+1]
#define crossBankjda(a, cond) MEM_CONCAT(CROSS_BANK_JDA, cond)(a)

// This guarantees a proper return setup
// NOTE that it turns off eem!
#define farenter(a) \
    dac a; lem

#define farrtn(a) \
    eem; jmp i a

#define farlac(a) \
    eem; lac i [a]; lem

#define farlio(a) \
    eem; lio i [a]; lem

#define fardac(a) \
    eem; dac i [a]; lem

#define fardio(a) \
    eem; dio i [a]; lem

#endif
