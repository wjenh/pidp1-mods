// Useful things for extended memory access
// eem will be turned off for all but jmp, jsp, jda
#ifndef MEMORY_AH
#define MEMORY_AH

#define farjmp(a) \
    eem; jmp i [a]

#define farjsp(a) \
    eem; jsp i [a]

#define farjda(a) \
    eem; dac i [a]; jsp i [a+1]

#define farlac(a) \
    eem; lac i [a]; lem

#define farlio(a) \
    eem; lio i [a]; lem

#define fardac(a) \
    eem; dac i [a]; lem

#define fardio(a) \
    eem; dio i [a]; lem

#endif
