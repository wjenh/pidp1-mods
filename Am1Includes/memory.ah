// Useful things for extended memory access
// eem will be silently managed for the data accessors, farlac, farlio,
// fardac, fardio transparently, leaving eem off.
// For farjmp, eem will be left on.
// For farjsp and farjda, eem will be on when the subroutine is entered.
// When they return, eem will remain on.
//
// Using farenter will properly set up the subroutine return for cross-bank return and turn off eem.
// Using farrtn will properly return leaving eem on.
//
// DO NOT use skip instructions to skip any of these, e.g:
//     sza // skip next instruction if AC is 0
//     jsp foo
// because these are all multi-instruction macros, the code will fail.
//
// For more fine-grained control, the crossBankjmp, crossBankjda, crossBankjsp,
// crossBankrtn, and similar for the lac/dac/lio/dio versions can be used.
//
// These allow control of whether an initial eem is done or not:
// crossBankjmp(xx:*, TRUE), crossBankjmp(xx:*, FALSE);
//
// This allows eliminating a superflous eem if it is already on.
// THESE ARE COMPILE TIME expansions, the assembler can't know what the eem state is.
// If used incorrectly, the indirect resolves in the wrong bank and the code will fail .
// Use these where the eem-on state is obvious.
//
// EEM and NOEEM can also be used for more clarity.

#ifndef MEMORY_AH
#define MEMORY_AH
#include <stddefs.ah>

#define EEM 1
#define NOEEM 0

#define MEM_CONCAT_HIDDEN(prefix, cond) prefix ## cond
#define MEM_CONCAT(prefix, cond) MEM_CONCAT_HIDDEN(prefix, cond)

#define farjmp(a) \
    eem; jmp i [a]

#define CROSS_BANK_JMP1(a) eem; jmp i [a]
#define CROSS_BANK_JMP0(a) jmp i [a]
#define crossBankjmp(a, cond) MEM_CONCAT(CROSS_BANK_JMP, cond)(a)

#define farjsp(a) \
    eem; jsp i [a]

#define CROSS_BANK_JSP1(a) eem; jsp i [a]
#define CROSS_BANK_JSP0(a) jsp i [a]
#define crossBankjsp(a, cond) MEM_CONCAT(CROSS_BANK_JSP, cond)(a)

#define farjda(a) \
    eem; dac i [a]; jsp i [a+1]

#define CROSS_BANK_JDA1(a) eem; dac i [a]; jsp i [a+1]
#define CROSS_BANK_JDA0(a) dac i [a]; jsp i [a+1]
#define crossBankjda(a, cond) MEM_CONCAT(CROSS_BANK_JDA, cond)(a)

// This guarantees a proper return setup
// NOTE that it turns off eem!
#define farenter(a) \
    dac a; lem

#define farrtn(a) \
    eem; jmp i a

#define CROSS_BANK_RTN1(a) eem; jmp i a
#define CROSS_BANK_RTN0(a) jmp i a
#define crossBankrtn(a, cond) MEM_CONCAT(CROSS_BANK_RTN, cond)(a)

#define farlac(a) \
    eem; lac i [a]; lem

#define CROSS_BANK_LAC1(a) eem; lac i [a]; lem
#define CROSS_BANK_LAC0(a) lac i [a]
#define crossBanklac(a, cond) MEM_CONCAT(CROSS_BANK_LAC, cond)(a)

#define farlio(a) \
    eem; lio i [a]; lem

#define CROSS_BANK_LIO1(a) eem; lio i [a]; lem
#define CROSS_BANK_LIO0(a) lio i [a]
#define crossBanklio(a, cond) MEM_CONCAT(CROSS_BANK_LIO, cond)(a)

#define fardac(a) \
    eem; dac i [a]; lem

#define CROSS_BANK_DAC1(a) eem; dac i [a]; lem
#define CROSS_BANK_DAC0(a) dac i [a]
#define crossBankdac(a, cond) MEM_CONCAT(CROSS_BANK_DAC, cond)(a)

#define fardio(a) \
    eem; dio i [a]; lem

#define CROSS_BANK_DIO1(a) eem; dio i [a]; lem
#define CROSS_BANK_DIO0(a) dio i [a]
#define crossBankdio(a, cond) MEM_CONCAT(CROSS_BANK_DIO, cond)(a)

#endif
