#ifndef MEMSET_AH
#define MEMSET_AH
// Set an area of memory to a given value.
// Call using jda.
// AC has the count of words to set.
// IO has the value to set.
// The word following the call has the address to begin the setting.
// This does not use extended addressing, it operates in the current bank.
memset, 0
local ptr, rtn, ctr, loop
// AC is in memset (the word count, deposited by jda); AC on entry to
// memset+1 is the return PC, pointing at the target-address data word
// that immediately follows the jda call in the caller.
    dac rtn
    lac i rtn
    dac ptr
    idx rtn
    dzm ctr
// Count ctr up from 0 to the requested word count (held in memset),
// testing *before* each write so a count of 0 does nothing -- the
// idx+sad "count up to a target" idiom, using the runtime value in
// memset as the target instead of a compile-time [const]. (The previous
// version negated the count into memset via cma and counted a separate,
// never-negated 'count' local up from 0 instead, so spa's positive test
// fired after exactly one iteration regardless of the requested count --
// only ever the first word got set.)
loop,
    lac ctr
    sad memset      // skip if ctr != count (still work to do)
    jmp i rtn        // ctr == count (no-skip): done, nothing more to write
    dio i ptr          // ctr != count (skip case): write the fill value...
    idx ptr             // ...advance the pointer...
    idx ctr              // ...and advance the counter
    jmp loop
rtn, 0
ctr, 0
ptr, 0
endloc

#endif
