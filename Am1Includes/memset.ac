#ifndef MEMSET_AH
#define MEMSET_AH
// Set an area of memory to a given value.
// Call using jda.
// AC has the count of words to set.
// IO has the value to set.
// The word following the call has the address to begin the setting.
// This is cross-bank safe.
memset, 0
local ptr, ok, rtn, ctr, loop
// Original AC is in memset, rtn addr in AC.
    dac rtn
    // Check bit 1 to see if eem is on.
    // If not, all addresses used have to be masked to 12 bits
    // to avoid collison between the bank number and the i bit
    // if called in an odd-numbered bank.
    and [0200000]
    sza
    jmp ok        // eem is on, nothing to worry about
    lac rtn
    and [07777]
    dac rtn       // addr is now safe
ok,
    lac i rtn
    dac ptr
    idx rtn
    dzm ctr
    // Loop for as many words as we have to set.
loop,
    lac ctr
    sad memset  // skip if ctr != count (still work to do)
    jmp i rtn   // ctr == count (no-skip): done, nothing more to write
    dio i ptr   // ctr != count (skip case): write the fill value,
    idx ptr     // advance the pointer,
    idx ctr     // and advance the counter.
    jmp loop
rtn, 0
ctr, 0
ptr, 0
endloc

#endif
