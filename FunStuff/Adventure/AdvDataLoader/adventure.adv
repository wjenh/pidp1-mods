# ---------------------------------------------------------------------
# Object aliases (TASK-FR7 7b group 1, S14, 03-Sep-26). adven.dat section
# 4 gives many objects more than one vocabulary word; objNames can hold
# only one per object, because findObj advances objNames, objLoc and
# objTake together on a single index. Each row here is {word, object},
# scanned by findObj only after that walk has missed, so the common path
# is unchanged and an alias resolves to exactly the same pointers its
# primary name would.
#
# The list is the mechanical difference between adven.dat section 4's
# 1xxx codes and this corpus's object rows -- nothing is invented and
# nothing is left out. DWARF/DWARV and KNIFE/KNIVE are section-4 object
# words too but are NOT aliases: neither has an object row, and both are
# answered inside objPresenceGate (f4 5110 and 5130).
# ---------------------------------------------------------------------
alias voc key object KEYS
alias voc headl object LAMP
alias voc lante object LAMP
alias voc velve object PILLOW
alias voc issue object MAGAZINE
alias voc spelu object MAGAZINE
alias voc qspel object MAGAZINE
alias voc ratio object FOOD
alias voc jar object BOTTLE
alias voc h2o object WATER
alias voc beans object PLANT
alias voc figur object SHADOWFIG
alias voc geyse object VOLCANO
alias voc machi object VENDING
alias voc moss object CARPETMOSS
alias voc gold object NUGGET
alias voc bars object SILVER
alias voc box object CHEST
alias voc treas object CHEST
alias voc egg object EGGS
alias voc nest object EGGS
alias voc ming object VASE
alias voc shard object VASE
alias voc potte object VASE
alias voc pyram object PLATINUM
alias voc persi object RUG

# ---------------------------------------------------------------------
# Verbs (TASK-VERB-EMISSION.md). One statement per verbTab row:
#   verb <NAME> voc <vocword> <argspec> handler <handler>
# <NAME> is a corpus-only unique key (not necessarily the vocabulary
# spelling -- am1 voc_* symbols are often 5-char-truncated, e.g.
# EXAMINE -> voc_exami); 'voc's word is the actual vocabulary suffix,
# emitted verbatim as "voc_<word>:2"; <argspec> is one of:
#   move <DIRNAME>   -- ARG = "DIR_<DIRNAME>" (a movement row)
#   none             -- ARG = 0 (the common case)
#   msgref <msgname> -- ARG = "msg_<msgname>:1" (a one-message doSpeak
#                        special, F5#7/F5#8)
#   karg <n>         -- ARG = the literal integer n (the doFoo family's
#                        k-value, F6)
# 'handler's word is emitted verbatim as "<handler>:0" -- like an
# object's loc/msg fields, the generator does not interpret or validate
# it, the assembler is the final arbiter.
#
# Row order is match precedence (vtScan, adventure.am1, is a linear
# scan, first match wins) -- extracted verbatim from the original hand
# table's order by extract_verbtab.py and MUST NOT be re-sorted.
#
# The historical group-header notes that used to sit inline in the hand
# table (F5#7/F5#8 doSpeak explanation, F6 doFoo k-values, F9D, the
# TASK-PARSER-WORDORDER filler-verb group) now live in generated
# adv_verbtab.ac's header instead of here, alongside the F16 bank-3
# relief move note -- see advdataloader.c's emitVerbTab(). Per-row
# historical annotations (F16/F17/Stage-NN, etc.) stayed with their row
# below, same convention as the objects section above.
#
# The WEST row below is an ordinary 'move WEST' statement -- nothing
# about it here is special. It IS functionally special outside this
# table: vtHit (adventure.am1) compares the matched row's own word
# against [voc_west:2] by literal address to feed the spelled-out-WEST
# joke counter (iwest, F5#8). That dispatch-time special case needs no
# corpus representation; don't add one.
# ---------------------------------------------------------------------
verb NORTH voc north move NORTH handler doMove
verb N voc n move NORTH handler doMove
verb SOUTH voc south move SOUTH handler doMove
verb S voc s move SOUTH handler doMove
verb EAST voc east move EAST handler doMove
verb E voc e move EAST handler doMove
verb WEST voc west move WEST handler doMove
verb W voc w move WEST handler doMove
verb IN voc in move IN handler doMove
# F16: INSIDE, adven.dat 19
verb INSID voc insid move IN handler doMove
verb OUT voc out move OUT handler doMove
# F16: OUTSIDE, adven.dat 11
verb OUTSI voc outsi move OUT handler doMove
# F16: adven.dat 11
verb EXIT voc exit move OUT handler doMove
# F16: adven.dat 11
verb LEAVE voc leave move OUT handler doMove
verb UP voc up move UP handler doMove
verb U voc u move UP handler doMove
# F16: adven.dat 29
