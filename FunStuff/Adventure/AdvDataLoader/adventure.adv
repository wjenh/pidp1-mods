# TASK-FR2 step 4 (06-Sep-26): de-aliased.  LEFT and RIGHT are adven.dat
# motions 36 and 37, not synonyms of NE (47) and SE (48) -- the earlier
# binding was read off R_VOLCANO_FORK, where LEFT happens to share a row
# with NE and RIGHT with SE, and it was wrong everywhere else.  It also
# gave the wrong refusal: adven.f4 50's "IF(K.EQ.7.OR.K.EQ.36.OR.K.EQ.37)
# SPK=10" puts LEFT/RIGHT in FORWARD's class (msg 10), not the compass
# class (msg 9) that 43..50 gets.
verb LEFT voc left move LEFT handler doMove
verb RIGHT voc right move RIGHT handler doMove
# TASK-FR2 step 4 (06-Sep-26): de-aliased off DIR_IN.  F17 was right that
# ENTER is not DIR_BARRE (adven.dat's BARRE is word 40); it settled on IN
# because R_ROAD's Building-entry row carries both words.  But motion 3's
# word list is ENTER and nothing else, and motion 19's is IN/INSID/INWAR,
# so the two are distinct words that merely share some rows.  Where they
# do NOT share one -- adven.dat's `3 1 3 11 32 44` -- the alias sent the
# player nowhere, because that LOC has no IN row at all.
# See TASK-F17-ENTER-INWARD-COLLISION.md; INWARD below stays on IN, which
# IS one of motion 19's three words.
# FR27 N7 (05-Sep-26) already narrowed what reaches here: tlEnterVerb does
# adven.f4 19999's "ENTER <word> -> 2800", so only BARE ENTER travels.
verb ENTER voc enter move ENTER handler doMove
# F17: universal synonym of IN (adven.dat 19), same
# DIR_BARRE correction as voc_enter above
verb INWARD voc inward move IN handler doMove
# Stage 25
verb ORIEN voc orien move ORIEN handler doMove
# Stage 26
verb CAVER voc caver move CAVER handler doMove
# Stage 26
verb DARK voc dark move DARK handler doMove
# Stage 29
verb GIANT voc giant move GIANT handler doMove

# ---------------------------------------------------------------------
# TASK-FR2 step 1 (04-Sep-26): the motion words above, as verb rows.
# Each one sets curDir and falls into doMove, which finds no matching
# exit yet and answers moveBlocked's msg 12, "I DON'T KNOW HOW TO APPLY
# THAT WORD HERE." That is what adven.f4's label 50 prints for a motion
# word with no travel row (SPK=12, the default there), so the words are
# right even before their rows exist.
#
# 'bank 3' names the memory bank the voc_* string is in. Bank 2, which
# holds every other vocabulary word, had 102 words free and these need
# more, so the strings went to bank 3 beside TASK-FR7 7b's object
# synonyms -- same reason, same place. STREA and STEPS carry no bank
# clause because their strings already exist in bank 2 (voc_stream, used
# by adven.f4 892's ENTER STREAM special, and voc_steps, object 1007).
#
# STEPS changes an existing answer, and deliberately. adven.dat has the
# word twice -- motion 34 at section-4 line 918 and object 1007 at line
# 979 -- and adven.f4's VOCAB scan (line 236, called at 901 with INIT=-1)
# returns the FIRST table entry, so the player's STEPS is the motion
# word and the object is reachable only from inside the program. That
# function's own header comment says so in as many words. Before this
# row, the port answered STEPS as a noun; it now answers it as a motion
# word, matching the source. The object row stays -- printStepsHere and
# objLoc still need it.
# ---------------------------------------------------------------------
verb ROAD   voc road    bank 3 move ROAD   handler doMove
verb HILL   voc hill    bank 3 move ROAD   handler doMove
verb UPSTR  voc upstr   bank 3 move UPSTR  handler doMove
verb DOWNS  voc downs   bank 3 move DOWNS  handler doMove
verb FORES  voc fores   bank 3 move FORES  handler doMove
verb VALLE  voc valle   bank 3 move VALLE  handler doMove
verb STAIR  voc stair   bank 3 move STAIR  handler doMove
verb BUILD  voc build   bank 3 move BUILD  handler doMove
verb HOUSE  voc house   bank 3 move BUILD  handler doMove
verb GULLY  voc gully   bank 3 move GULLY  handler doMove
verb STREA  voc stream  move STREA  handler doMove
verb ROCK   voc rock    bank 3 move ROCK   handler doMove
verb BED    voc bed     bank 3 move BED    handler doMove
verb COBBL  voc cobbl   bank 3 move COBBL  handler doMove
verb SURFA  voc surfa   bank 3 move SURFA  handler doMove
verb LOW    voc low     bank 3 move LOW    handler doMove
verb CANYO  voc canyo   bank 3 move CANYO  handler doMove
verb PIT    voc pit     bank 3 move PIT    handler doMove
verb OUTDO  voc outdo   bank 3 move OUTDO  handler doMove
verb CRACK  voc crack   bank 3 move CRACK  handler doMove
verb STEPS  voc steps   move STEPS  handler doMove
verb DOME   voc dome    bank 3 move DOME   handler doMove
verb DEBRI  voc debri   bank 3 move DEBRI  handler doMove
verb HOLE   voc hole    bank 3 move HOLE   handler doMove
verb WALL   voc wall    bank 3 move WALL   handler doMove
verb BROKE  voc broke   bank 3 move BROKE  handler doMove
verb Y2     voc y2      bank 3 move Y2     handler doMove
verb FLOOR  voc floor   bank 3 move FLOOR  handler doMove
verb ROOM   voc room    bank 3 move ROOM   handler doMove
verb SLIT   voc slit    bank 3 move SLIT   handler doMove
verb SLAB   voc slab    bank 3 move SLAB   handler doMove
verb SLABR  voc slabr   bank 3 move SLAB   handler doMove
verb DEPRE  voc depre   bank 3 move DEPRE  handler doMove
verb ENTRA  voc entra   bank 3 move ENTRA  handler doMove
verb SHELL  voc shell   bank 3 move SHELL  handler doMove
verb RESER  voc reser   bank 3 move RESER  handler doMove

# TASK-FR27 N13 (05-Sep-26).  adven.dat gives motion 21 two words, NULL
# and NOWHE; without a row here they were not vocabulary at all and the
# game answered SORRY, I DON'T KNOW THE WORD "NULL".  They are NOT
# doMove rows: adven.f4 1005 tests "IF(K.EQ.NULL)GOTO 2" at label 8,
# ahead of the travel scan, so the word never meets a travel row (LOC
# 10's `10 9 11 20 21 43` carries a 21 that the source can never reach)
# and label 50's msg 12 is wrong for it.  doNull is label 8's own
# exception: stay, run the dwarves, describe the room.
verb NULL   voc null    bank 3 move NULL   handler doNull
verb NOWHE  voc nowhe   bank 3 move NULL   handler doNull
