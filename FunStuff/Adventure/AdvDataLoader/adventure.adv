# Objects (SPEC-PHASE2.md) -- extracted from adventure.am1's OBJ_* defines and its six
# objLoc/objTake/objNames/objInvMsg/objHereMsg/objTreasure table bodies.

# objTreasure: keys
object KEYS name voc_keys loc 0 take yes invmsg INV_KEYS heremsg HERE_KEYS treasure 0

# objTreasure: lamp
object LAMP name voc_lamp loc 0 take yes invmsg INV_LAMP heremsg HERE_LAMP treasure 0

# objTreasure: nugget -- object 50 (adven.dat "50 LARGE GOLD NUGGET"), K=12
object NUGGET name voc_nugget loc R_NUGGET take yes invmsg INV_NUGGET heremsg HERE_NUGGET treasure 0d12

# objTreasure (between rows 2,3): (< CHEST's object 55, adven.f4 line 1983's scoring table --
# objTreasure (between rows 2,3): F9A retrofit, TASK-F9A-ENDGAME-BOOKKEEPING.md: objTreasure
# objTreasure (between rows 2,3): is now 0/K, K=12/14/16, not a plain 0/1 flag. ptSweep and
# objTreasure (between rows 2,3): checkTrollPayment both test nonzero, not ==1, so this is
# objTreasure (between rows 2,3): provably unaffected -- see F9A-RESULTS.md.
# objTreasure: axe
object AXE name voc_axe loc AXE_NOWHERE take yes invmsg INV_AXE heremsg HERE_AXE treasure 0

# objTreasure: bird
