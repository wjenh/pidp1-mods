# Objects (SPEC-PHASE2.md) -- extracted from adventure.am1's OBJ_* defines and its six
# objLoc/objTake/objNames/objInvMsg/objHereMsg/objTreasure table bodies.

# objTreasure: keys
object KEYS name voc_keys loc 0 take yes invmsg INV_KEYS heremsg HERE_KEYS treasure 0

# objTreasure: lamp
object LAMP name voc_lamp loc 0 take yes invmsg INV_LAMP heremsg HERE_LAMP treasure 0

# objTreasure: nugget -- object 50 (adven.dat "50 LARGE GOLD NUGGET"), K=12
object NUGGET name voc_nugget loc R_NUGGET take yes invmsg INV_NUGGET heremsg HERE_NUGGET treasure 0d12

# objTreasure (between rows 2,3): (< CHEST's object 55, adven.f4 line 1983's scoring table --
# objTreasure (between rows 2,3): F9A retrofit, TASK-F9A-ENDGAME-BOOKKEEPING.md: objTreasure
# objTreasure (between rows 2,3): is now 0/K, K=12/14/16, not a plain 0/1 flag. ptSweep and
# objTreasure (between rows 2,3): checkTrollPayment both test nonzero, not ==1, so this is
# objTreasure (between rows 2,3): provably unaffected -- see F9A-RESULTS.md.
# objTreasure: axe
object AXE name voc_axe loc AXE_NOWHERE take yes invmsg INV_AXE heremsg HERE_AXE treasure 0

# objTreasure: bird
object BIRD name voc_bird loc R_BIRD take yes invmsg INV_BIRD heremsg HERE_BIRD treasure 0

# objTreasure: snake
object SNAKE name voc_snake loc R_MTKING take no invmsg none heremsg HERE_SNAKE treasure 0

# objTreasure: cage
object CAGE name voc_cage loc R_COBBLE take yes invmsg INV_CAGE heremsg HERE_CAGE treasure 0

# objLoc: adven.dat section 7 "5 11" -- LOC 11, the already-built Debris Room
# objTreasure: rod
object ROD name voc_rod loc R_DEBRIS take yes invmsg INV_ROD heremsg HERE_ROD treasure 0

# objLoc: Stage 22: diamond, adven.dat "51 27"
# objTake: Stage 22: diamond
# objInvMsg: Stage 22
# objHereMsg: Stage 22
# objTreasure: diamond -- object 51, K=12 (< CHEST)
object DIAMOND name voc_diamond loc R_FISSURE_WEST take yes invmsg INV_DIAMOND heremsg HERE_DIAMOND treasure 0d12

# objLoc: Stage 22: silver, adven.dat "52 28"
# objTake: silver
# objTreasure: silver -- object 52, K=12 (< CHEST)
object SILVER name voc_silver loc R_HOLE take yes invmsg INV_SILVER heremsg HERE_SILVER treasure 0d12

# objLoc: Stage 22: jewelry, adven.dat "53 29"
# objTake: jewelry
# objTreasure: jewelry -- object 53, K=12 (< CHEST)
object JEWELRY name voc_jewel loc R_MTKING_SOUTH take yes invmsg INV_JEWELRY heremsg HERE_JEWELRY treasure 0d12

# objLoc: Stage 22: coins, adven.dat "54 30"
# objTake: coins
# objTreasure: coins -- object 54, K=12 (< CHEST)
object COINS name voc_coins loc R_MTKING_WEST take yes invmsg INV_COINS heremsg HERE_COINS treasure 0d12

# objLoc: Stage 22: rug, adven.dat "62 119 121" (simplified to one LOC)
# objTake: rug -- not takeable until the dragon's dead (doAttack's daKill)
# objHereMsg: patched to msg_HERE_RUG_LOOSE by doAttack's daKill
