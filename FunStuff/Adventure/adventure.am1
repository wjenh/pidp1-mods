voc_dwarv,     ascii "DWARV"

// Verb table -- one 3-word row per vocabulary word: the voc_* word to
// match, the argument stored into curDir on a match (a DIR_* direction
// code on movement rows, 0 everywhere else), and the handler dispatched
// to. Scanned by playGame's vtScan loop; row order IS match precedence
// (preserved verbatim from the old compare chain). A single 0 word ends
// the table
bank 3
0/
#include "Includes/adv_verbtab.ac"

// ---------------------------------------------------------------------
// TASK-FR7 7b group 1 (S14, 03-Sep-26): the object synonyms adven.dat
// section 4 defines and this port did not carry -- LAMP's HEADL and
// LANTE, CHEST's BOX and TREAS, VASE's MING/SHARD/POTTE and the rest.
// Five-character truncations, as every vocabulary word in this program is.
//
// These live in bank 3 rather than with the other 220-odd voc_* strings
// in bank 2, and that placement is forced, not chosen: bank 2 already
// holds every other vocabulary word plus objNames, objInvMsg,
// objHereMsg, objTreasure and the wizardry record, and adding these 26
// words and their table to it overflowed the bank. They are referenced
// only by objAlias below, which is emitted with explicit "voc_x:3" tags,
// so nothing outside this bank has to know where they went.
//
// MOSS and MACHI were already in the bank-2 block, defined but named by
// no object or verb row -- dead strings. They moved here with the rest
// rather than being referenced across banks or duplicated.
