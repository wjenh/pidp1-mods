ADVENTURE 1977 WOODS VERSION
// This is an implementation of the original Woods Fortran IV
// Adventure game from the PDP-10.
// It is based on the actual Fortran source.
// Everything is here and works like the original.
//
// Note that it requires the Type 23 Parallel Drum to be present
// as the room and game text is stored there.
// It also uses DCS2, the updated DCS implementation by wje, as
// well as some PDP1-D instructions.
//
// Before assembling this, its generated include files (message/room
// tables, object tables, drum layout) must be produced by advdataloader
// (PendingRework/AdvDataLoader -- the unified generator  which also
// loads the drum with the game data.
//
// One save slot is available, also on the drum.
//
// When the program has started, telnet to port 2030 and enjoy.
// Both upper and lower case input can be used, input is automatically
// mapped to uppercase.
// The classic 5 characters of significance is also replicated, so
// 'inven', 'inventory', 'invenfoo' are all equivalent.
//
// 31-Aug-26 wje initial version

#include <DCS/dcs2defs.ah>
#include <DRUM/type23drumdefs.ah>
#include <AIDS/skipmacros.ah>
#include <memory.ah>

#include "Includes/adv_defines.ah"

// SAVE_MAGIC (word 0 of the SAVE block) and WIZCOM_MAGIC (word 0 of the WIZCOM block)
// are shared with the AdvDataLoader C tools, which read and preserve those same two words.
// Bump SAVE_MAGIC there on any save-layout change.
#include "AdvDataLoader/advmagic.h"

octal

// Send a bare linefeed.
#define newline law '\n'; lia; tcb

// Ascii space, used to delimit tokens.
#define SP 040

// Backspace (^H) and delete (rubout), recognized by readCmd for line-editing.
#define BS 010
#define DEL 0177

#define AXE_NOWHERE 0d250
#define SNAKE_GONE 0d250
#define TROLL_TREASURE_GONE 0d250
#define FOOD_EATEN 0d250
#define BIRD_GONE 0d250
#define BEAR_GONE 0d250
#define OYSTER_NOWHERE 0d250
#define PEARL_NOWHERE 0d250
#define CLAM_GONE 0d250
#define COINS_GONE 0d250
#define CHEST_NOWHERE 0d250
#define MESSAG_NOWHERE 0d250
#define ROD2_NOWHERE 0d250
#define BATTERIES_NOWHERE 0d250
#define WATER_NOWHERE 0d250
#define OIL_NOWHERE 0d250

// TASK-SCENERY-NOUNS (S15). Two of the five section-7 scenery objects
// have no static room to sit in, for opposite reasons, and both take the
// same 0d250 sentinel every other never-placed object uses.
//   PIRAT: adven.dat "30 0 -1" -- PLACE 0 and FIXED -1, so AT(PIRAT) is
//     false everywhere and every turn. The source's answer to any verb
//     naming the pirate is therefore always 5190's "I SEE NO PIRATE
//     HERE."; the noun has to parse for that message to be reachable.
//   TROLL: adven.dat "33 117 122", but the placement is runtime state --
//     f4 1592/1296's MOVE(TROLL,0) removes him when he is paid off or
//     scared away by the bear, and 1077's MOVE(TROLL,PLAC(TROLL)) puts
//     him back. objLoc would have to be written at each of those sites
//     (and reset in newGame, S4's trap). The port already carries that
//     state in trollGone, so pgTroll tests the flag and owns BOTH rooms,
//     the same shape pgMirror uses for the mirror's runtime placement.
#define PIRAT_NOWHERE 0d250
#define TROLL_NOWHERE 0d250

// Direction codes, set into curDir by the verb-table dispatch (vtHit)
// before it hands off to doMove; stored from each table row's argument
// word, see the "Travel table" section near the end of this file.
//
// The values are adven.dat's OWN section-4 motion numbers (TASK-FR2,
// 06-Sep-26; they were the port's 1..30 plus step 1's appended 31..67
// before that). A section-3 travel row now reads straight:
// `1 2 2 44 29` is motions 2, 44 and 29 -- ROAD, WEST, UP.
//
// The numbering is sparse on purpose. Codes adven.dat uses that no
// DIR_* claims are words handled elsewhere -- 3 ENTER, 8 BACK, 57 LOOK,
// 67 CAVE -- or not ported yet (26 AWKWA, 36 LEFT, 37 RIGHT, 76 MAIN).
// Nothing may index an array by a direction code, and only ONE piece of
// code may assume an ordering: moveBlocked's 43..50 compass range, which
// is adven.f4 50's own test.
//
// TUNNEL has no #define -- it is adven.dat 23's second spelling and
// shares DIR_PASSAGE. Must stay in step with advdataloader.c's dirTable
// and AdvDataLoader/adventure.adv's movement section; the loader
// compares those two to each other and nothing in the build reads this,
// so adventure_fr2_motion_vocabulary_test.py compares all three.
#define DIR_ROAD     0d2   // HILL/ROAD
#define DIR_ENTER    0d3   // ENTER -- TASK-FR2 step 4, de-aliased from DIR_IN
#define DIR_UPSTR    0d4   // UPSTR
#define DIR_DOWNS    0d5   // DOWNS
#define DIR_FORES    0d6   // FORES
#define DIR_FORWARD  0d7   // CONTI/FORWA/ONWAR
#define DIR_VALLE    0d9   // VALLE
#define DIR_STAIR    0d10  // STAIR
#define DIR_OUT      0d11  // EXIT/LEAVE/OUT/OUTSI
#define DIR_BUILD    0d12  // BUILD/HOUSE
#define DIR_GULLY    0d13  // GULLY
#define DIR_STREA    0d14  // STREA -- voc_stream already exists (adven.f4 892's ENTER STREAM)
#define DIR_ROCK     0d15  // ROCK
#define DIR_BED      0d16  // BED
#define DIR_CRAWL    0d17  // CRAWL
#define DIR_COBBL    0d18  // COBBL
#define DIR_IN       0d19  // IN/INSID/INWAR
#define DIR_SURFA    0d20  // SURFA
#define DIR_NULL     0d21  // NOWHE/NULL -- RESERVED -- adven.f4 1005 makes NULL/NOWHE a label-8 special
#define DIR_DARK     0d22  // DARK
#define DIR_PASSAGE  0d23  // PASSA/TUNNE -- TUNNEL shares this code -- one adven.dat word, two spellings
#define DIR_LOW      0d24  // LOW
#define DIR_CANYO    0d25  // CANYO
#define DIR_GIANT    0d27  // GIANT
#define DIR_VIEW     0d28  // VIEW
#define DIR_UP       0d29  // ABOVE/ASCEN/U/UP/UPWAR
#define DIR_DOWN     0d30  // D/DESCE/DOWN/DOWNW
#define DIR_PIT      0d31  // PIT
#define DIR_OUTDO    0d32  // OUTDO
#define DIR_CRACK    0d33  // CRACK
#define DIR_STEPS    0d34  // STEPS -- voc_steps already exists (object 1007, same word)
#define DIR_DOME     0d35  // DOME
#define DIR_LEFT     0d36  // LEFT -- TASK-FR2 step 4, de-aliased from DIR_NE
#define DIR_RIGHT    0d37  // RIGHT -- TASK-FR2 step 4, de-aliased from DIR_SE
#define DIR_HALL     0d38  // HALL
#define DIR_JUMP     0d39  // JUMP
#define DIR_BARRE    0d40  // BARRE
#define DIR_OVER     0d41  // OVER
#define DIR_ACROSS   0d42  // ACROS
#define DIR_EAST     0d43  // E/EAST
#define DIR_WEST     0d44  // W/WEST
#define DIR_NORTH    0d45  // N/NORTH
#define DIR_SOUTH    0d46  // S/SOUTH
#define DIR_NE       0d47  // NE
#define DIR_SE       0d48  // SE
#define DIR_SW       0d49  // SW
#define DIR_NW       0d50  // NW
#define DIR_DEBRI    0d51  // DEBRI
#define DIR_HOLE     0d52  // HOLE
#define DIR_WALL     0d53  // WALL
#define DIR_BROKE    0d54  // BROKE
#define DIR_Y2       0d55  // Y2
#define DIR_CLIMB    0d56  // CLIMB
#define DIR_FLOOR    0d58  // FLOOR
#define DIR_ROOM     0d59  // ROOM
#define DIR_SLIT     0d60  // SLIT
#define DIR_SLAB     0d61  // SLAB/SLABR
#define DIR_XYZZY    0d62  // XYZZY -- RESERVED -- doXyzzy owns the word
#define DIR_DEPRE    0d63  // DEPRE
#define DIR_ENTRA    0d64  // ENTRA
#define DIR_PLUGH    0d65  // PLUGH -- RESERVED -- doPlugh owns the word
#define DIR_SECRE    0d66  // SECRE
#define DIR_CROSS    0d69  // CROSS
#define DIR_BEDQU    0d70  // BEDQU
#define DIR_PLOVE    0d71  // PLOVE -- RESERVED -- doPlove owns the word
#define DIR_ORIEN    0d72  // ORIEN
#define DIR_CAVER    0d73  // CAVER
#define DIR_SHELL    0d74  // SHELL
#define DIR_RESER    0d75  // RESER
#define DIR_FORK     0d77  // FORK

// The 35% roll threshold for doMove's mtkSnakeCheck SW branch.
// Computed exactly as advdataloader converts a RAND 35 percent into RAND_DOMAIN 32.
#define MTK_SW_THRESHOLD 0d11

// Size in words of advScratch, the buffer advPrintMsg reads each
// drum message into before printing it.
// MUST stay larger than the largest message's actual word count,
#define ADVSCRATCH_WORDS 0d500

// WHAT IS PINNED TO BANK 0, AND WHAT IS NOT (TASK-BANK0 B-4, 05-Sep-26).
// Written down here once because every session so far has re-derived it,
// usually while looking for space. The rule is one sentence:
//
//     A table is pinned to bank 0 if any loop that indexes it runs with
//     eem OFF. Everything else is a candidate for bank 3.
//
// Only bank-0 addresses are reachable with eem off, so an eem-off loop
// can only ever touch bank 0. With eem ON an indirect through a memory
// word uses the whole 16-bit address, which is why a buffer whose own
// fill loop runs eem-on can live anywhere (see wzLineBuf, moved to bank
// 3 by B-3 -- wzReadLine is entered by farjsp, which leaves eem set, and
// nothing in it issues lem).
//
// Pinned by that rule, and NOT to be proposed for a move again:
//   * cmdbuf and pendObjBuf, and every token pointer into them --
//     strCmpEq's compare loop runs eem off.
//   * objLoc, objTake, objDropSeq (52 words each), ROOM_CACHE (64), and
//     the var block below the constant pool.
// If a future item wants one of these moved, the change is to the LOOP,
// not to the table.
//
// cmdbuf's two tenants. TASK-FR27 N8 (05-Sep-26) needed somewhere in
// BANK 0 to keep the pending object's text across a readCmd -- bank 0 for
// strCmpEq's sake, whose compare loop runs with eem off and so can only
// reach a bank-0 token -- and bank 0 had 117 words left when this session
// started, which was not enough for the parser state N7-N13 add. The last
// eight words of the input buffer were the room that already existed.
//
// readCmd now stops at CMDBUF_LAST = cmdbuf+30 instead of cmdbuf+63: a
// 31-character command line, against the TWENTY characters adven.dat's
// own GETIN reads (advn2.f4's "ACCEPT 3,(A(I),I=1,4)", FORMAT 4A5). The
// margin convention is unchanged -- the capped word is the last one
// stored, leaving the one after it for rcterm's null.
//
// The buffer went 64 -> 40 words because bank 0's real ceiling is 07750,
// not 07777: am1 puts its read-in loader at 07751-07774 (Tools/AM1's
// xldr.h, LDR_START_ADDR plus twenty words) and the loader is still
// running while it loads, so a single word deposited at 07751 or above
// destroys it mid-tape. -S reports "highest address used" against 4096
// and will not warn about this; the number to check is 07750 / 4072.
//
// Six characters plus a terminator is adven.f4's WD1 exactly: five
// significant characters, which is also strCmpEq's own cap, and one
// spare. WD1X -- the five EXTRA characters the source carries purely so
// an error message can echo a long word whole -- is not kept. The only
// way to see the difference is a handler echoing a pending object back
// after the object left the room between two commands.
#define CMDBUF_WORDS 0d40             // boot's memset and cmdbuf's own table
#define CMDBUF_LAST  (cmdbuf+0d30)
#define pendObjBuf   cmdbuf:0+0d32    // :0 so keepParse can name it from bank 3
                                      //   (adv_defines.ah's FAR_OBJ_LOC idiom)

// SAVE/RESTORE drum layout for the one save slot this game keeps.
// This layout must stay within (SAVE_ENDGAME_OFFSET + SAVE_ENDGAME_WORDS
// and friends) <= SAVE_BLOCK_WORDS.
// The offsets below are relative to the block base, which is 0.
// SAVE_OBJLOC_OFFSET/SAVE_ROOMVIS_OFFSET/SAVE_STATE_OFFSET are computed
// from NOBJS/NROOMS so they self-adjust as those grow.
#define SAVE_MAGIC_OFFSET   0d0
#define SAVE_OBJLOC_OFFSET  0d1
#define SAVE_OBJLOC_WORDS   NOBJS
#define SAVE_ROOMVIS_WORDS  NROOMS
#define SAVE_ROOMVIS_OFFSET (SAVE_OBJLOC_OFFSET+SAVE_OBJLOC_WORDS)
#define SAVE_STATE_OFFSET   (SAVE_ROOMVIS_OFFSET+SAVE_ROOMVIS_WORDS)
// DERIVED, not hand-counted (05-Sep-26). The state record is the run of
// `var` words from objTakePtr up to and including curRoom -- those two
// symbols ARE the record's boundaries, and the five vars deliberately
// left outside it (gaveUp/demoGame/bonus/connOk/knfloc: per-connection
// state, not game state) sit contiguously below objTakePtr.
//
// It was the literal 0d56 until now, and that is a size am1 cannot check:
// `var` allocates downward in declaration order, so INSERTING a var
// anywhere between those two boundaries pushes the same number of words
// off the TOP of a fixed-length record, silently. TASK-FR27 N8 (S25)
// added four -- parseVerb, parseObj, keepVerb, keepObj -- and curRoom,
// lampOn, ea1On and grateLocked fell out. SAVE stopped writing the
// player's location; RESTORE put you back wherever you were standing.
// Same failure family as TASK-BANK0 B-3's buffer, and the same lesson: a
// span's size must be derived from its endpoints, never counted.
#define SAVE_STATE_WORDS    (curRoom-objTakePtr+0d1)
#define SAVE_DWARFLOC_OFFSET (SAVE_STATE_OFFSET+SAVE_STATE_WORDS)
#define SAVE_DWARFLOC_WORDS  0d10
#define SAVE_HINT_OFFSET (SAVE_DWARFLOC_OFFSET+SAVE_DWARFLOC_WORDS)
#define SAVE_HINT_WORDS  0d6
#define SAVE_ENDGAME_OFFSET (SAVE_HINT_OFFSET+SAVE_HINT_WORDS)
#define SAVE_ENDGAME_WORDS  0d30

// objTake and objHereMsg are per-object MUTABLE state, not constants -- the
// chain's takeable bit toggles on UNLOCK/LOCK CHAIN, the rug's on the dragon's
// death, the bear's on being fed, and the bottle/plant/door/vase here-messages
// track contents or condition. Neither table lies inside the "Game state"
// block (objTake is bank 0, objHereMsg bank 2), so each gets a record of its
// own. objDropSeq is the third of the same kind: printObjHere's per-object
// description-order key, rewritten at every drop (TASK-FR31 N41), and just as
// much per-game state as the other two. Block usage with these three: 429 of
// SAVE_BLOCK_WORDS (512).
#define SAVE_OBJTAKE_OFFSET (SAVE_ENDGAME_OFFSET+SAVE_ENDGAME_WORDS)
#define SAVE_OBJTAKE_WORDS  NOBJS
#define SAVE_OBJHEREMSG_OFFSET (SAVE_OBJTAKE_OFFSET+SAVE_OBJTAKE_WORDS)
#define SAVE_OBJHEREMSG_WORDS  NOBJS
#define SAVE_OBJDROPSEQ_OFFSET (SAVE_OBJHEREMSG_OFFSET+SAVE_OBJHEREMSG_WORDS)
#define SAVE_OBJDROPSEQ_WORDS  NOBJS

// Drum defs for the WIZCOM data. The record's validity marker is
// WIZCOM_MAGIC, from the shared advmagic.h above -- this file used to keep
// its own WC_VALID alias for it, retired 02-Sep-26 so one value has one name.
#define WC_MAGIC_OFFSET     (WIZCOM_BASE_OFFSET+0d0)
#define WC_DATA_OFFSET      (WIZCOM_BASE_OFFSET+0d1)
#define WC_DATA_WORDS       0d28
#define WC_MOTD_OFFSET      (WIZCOM_BASE_OFFSET+0d29)   // = base + magic(1) + core(28);
#define WC_MOTD_WORDS       0d222

// The old standard initial address.
4/
// Main program loop
// Open an ascii telnet server on port 2030, wait for a connection,
// play one game, then go back to waiting.
// Polling only, no interrupts needed.
boot,
    lem                     // since we are multibank, loader left eem on
    // initialize the command buffer
    law CMDBUF_WORDS      // must be the buffer's real size: the words after
    cli                   //   cmdbuf are dwarfBitMask and then wizComLoad's
    eem                   //   code, and memset does not know where to stop.
    dac i [memset:3]      // memset is bank 3 (Task 1); jda has no indirect
    jsp i [memset:3+1]    //   form, so this is the jda composition
    cmdbuf:0              // inline argument, read through the full 16-bit
                          //   return address, so it carries its bank
    lem

    cli
    lio [scbrst
    scb

// We call rand18 here to get an initial number.
// Since it uses the same static seed, it would repeat the same
// sequence after every progam load from tape.
// The number is modified in the connect wait below and then
// used to reseed rand18.
// Not a perfect way to get a unique sequence each game run,
// but satisfactory.
// Somewhat confusingly, we use the var objLocPtr for this just
// to avoid allocating another word of storage, it isn't used
// otherwiae until later.
mainloop,
    eem                     // rand18 is bank 3 (Task 1); it needs eem on
    jsp i [rand18:3]
    lem                     // back to bank 0's eem-off default
    dac objLocPtr

    cli
    rcs
    lai
    and [dsfopn
    SKIP_NEXT_IF_AC_ZERO
    jmp waitconn
    lio [scbset advctl]
    scb

// Wait for a connection.
// Increment objLocPtr to be used as a seed for rand18 each cycle.
// This introduces some starting variability in the random number sequence.
waitconn,
    idx objLocPtr
    cli
    rcs
    lai
    and [dsfcon
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp waitconn

    cli
    ssb

    // Now reseed the random number generator.
    eem                     // rand18seed is bank 3 (Task 1)
    lio objLocPtr           // loaded inside the window: direct, bank 0, so
                            //   eem does not change where it reads from
    jsp i [rand18seed:3]
                            // the window above is still open: rand18seed is
                            //   extend-mode transparent (dac rtn / dio /
                            //   jmp i rtn, no eem or lem), so the call below
                            //   does not need one of its own
    crossBankjsp(newGame:3, NOEEM)
    lem     // now turn eem off, the return leaves it on
    jsp playGame
    lio [scbbnd
    scb
    jmp mainloop

// Feneral-purpose drum transfer to any core address and either direction.
// Call via jda drumRead/jda drumWrite, AC = address of a 4-word block:
// track, word-offset, word-count, core-address.
// The transfer target/source is the core-address word contents.
drumRead, 0
    local rtn, diaWord
    dap rtn
    lac i drumRead          // word 0 of the record: track
    sal 6s
    sal 6s
    ior [drmrd
    dac diaWord
    idx drumRead              // word 1: offset
    lac i drumRead
    ior diaWord
    lia
    dia
    idx drumRead               // word 2: count
    lac i drumRead
    lia
    dwc
    idx drumRead                // word 3: core address
    lac i drumRead
    lia
    dcl
    DRUM_WAIT_READY         // wait for the transfer to complete
rtn, jmp 0
diaWord, 0
    endloc

drumWrite, 0
    local rtn, trackBits
    dap rtn
    lac i drumWrite          // word 0 of the record: track
    sal 6s
    sal 6s
    dac trackBits
    idx drumWrite            // word 1: offset
    lac i drumWrite
    ior trackBits            // dia: track/offset only, no read-enable bit.
    lia
    dia
    idx drumWrite            // word 2: count
    lac i drumWrite
    ior [drmwrt
    ior trackBits            // dwc: write-enable bit AND this write's track
    lia
    dwc
    idx drumWrite           // word 3: core address
    lac i drumWrite
    lia
    dcl
    DRUM_WAIT_READY         // wait for the transfer to complete
rtn, jmp 0
trackBits, 0
    endloc

// Equvalent rum transfers for cross-bank callers.
// Called via jda.
drumReadFar, 0
    local rtn
    dac rtn
    lac drumReadFar     // forward the deposited record address
    jda drumRead
    eem
    jmp i rtn
rtn, 0
    endloc

drumWriteFar, 0
    local rtn
    dac rtn
    lac drumWriteFar
    jda drumWrite
    eem
    jmp i rtn
rtn, 0
    endloc

// Compare a null-terminated, packed ascii string such as created by the am1 ascii directive
// against a null-terminated, one-byte-per-word token string, for at most
// the first 5 characters.
// The passed packed string is first unpacked using the unpackAscii library subroutine.
// Extended memory is turned on for the unpacking, unpackAscii knows how to do
// extended addressing, then turned off again.
// Call via jda strCmpEq with AC = address of the candidate word and
// IO = address of the token string.
// Returns AC = 1 for a match, AC = 0 for no match.
// IO is preserved.
strCmpEq, 0
    local rtn, tokPtr, tok0, chr, ix, loop, hit, miss, srtn, buffer
    dac rtn 
    dio tokPtr          // working copy -- advanced by the compare loop
    dio tok0            // untouched copy -- restored to IO at return
    dzm ix
    // Unpack into buffer, then replace the original pointer with buffer.
    lio [buffer
    lac strCmpEq
    eem
    dac i [unpackAscii:3]      // bank 3 since Task 1; jda has no indirect
    jsp i [unpackAscii:3+1]    //   form, so this is the jda composition
    lem
    law buffer
    dac strCmpEq
loop,
    lac i strCmpEq
    dac chr
    lac i tokPtr
    SKIP_NEXT_IF_SAME chr   // skip (keep going) when the characters are equal
    jmp miss                // AC differs from the candidate's character: mismatch
    SKIP_NEXT_IF_AC_NOT_ZERO               // AC still holds the matched character (sas never alters
                            // AC); skip when it's NOT the terminator
    jmp hit                 // AC == 0: terminator on both sides -- match
    idx ix                  // AC != 0 (falls through): one more real character matched
    SKIP_NEXT_IF_DIFFERENT [5
    jmp hit                 // AC == 5 (no skip): 5 real characters matched -- cap
                            // reached, match regardless of what the token has next
    idx strCmpEq            // AC != 5 (skip): keep comparing
    idx tokPtr
    jmp loop
hit,
    law 1
    jmp srtn
miss,
    cla
srtn,
    lio tok0                // restore the caller's IO
    eem
    jmp i rtn
rtn, 0
tokPtr, 0
tok0, 0
chr, 0
ix, 0

// This is used to process the token strings the player enters.
// It is guaranteed that no more than 5 unpacked characters wiil be put in it.
buffer,
    table 0d8
    endloc

// findObj -- search the object table for the object named by the token in IO.
// Called via jsp with IO = token-string address.
// On a match, returns AC = 1 and leaves objLocPtr/objTakePtr pointing at
// the matched object's objLoc/objTake words so the caller can read or
// write *objLocPtr directly without repeating the search.
// On no match, returns AC = 0.
// objLocPtr/objTakePtr are left one past the last table entry and must not be used.
findObj,
    local rtn, namePtr, ix
    addlocal foRodCheckRoom, foRod2, foHitDone
    dac rtn
    lac [objNames:2]
    dac namePtr
    law objLoc
    dac objLocPtr
    law objTake
    dac objTakePtr
    dzm ix
foScan,
    lac ix
    SKIP_NEXT_IF_DIFFERENT [NOBJS
    jmp foMiss           // branch 1 (equal): idx == NOBJS, table exhausted, no match
                         // branch 2 (different): idx != NOBJS, an entry to check
foCheck,
    eem
    lac i namePtr
    lem
    jda strCmpEq
    lem                   // strCmpEq returns with eem on
    SKIP_NEXT_IF_AC_ZERO  // skip when AC == 0 (no match)
    jmp foHit             // AC != 0: match
foAdvance,                // AC == 0: no match -- try next entry
    idx namePtr
    idx objLocPtr
    idx objTakePtr
    idx ix
    jmp foScan
// adven.f4 label 5140, inside the shared noun-resolution block:
//
//     5140 IF(OBJ.NE.ROD.OR..NOT.HERE(ROD2))GOTO 5190
//          OBJ=ROD2
//
// The second black rod has no vocabulary word of its own in the original
// -- "ROD" means whichever of the two is present, and 5140 is what makes
// that true for every transitive verb at once, which is why it lives in
// noun resolution rather than in any one handler.
//
// Added 03-Sep-26 with TASK-FR21 C16, and required by it. C16 gates BLAST
// on repoHiddenRod2, the port's carrier for PROP(ROD2).LT.0, and that flag
// is cleared only by turnLoop's 2604 sweep finding the rod CARRIED -- i.e.
// only by actually taking the rod. Without this substitution "TAKE ROD" in the repository resolves
// to OBJ_ROD, which closedTransport left at the OTHER end of the
// repository, so the reply is "I SEE NO ROD HERE.", the flag never clears
// and BLAST becomes unreachable for the rest of the game. The port's
// `voc_rod2` ("ROD2") is an invented word that is not in adven.dat's
// vocabulary at all, so it is not the answer either.
//
// HERE(ROD2) is "carried, or lying in this room" -- objLoc 0 or curRoom,
// this project's standing convention. Note the port keeps the two rods as
// separate object rows, so the substitution is a pointer swap rather than
// an OBJ assignment: both objLocPtr and objTakePtr move together, since
// every caller reads them as a pair.
foHit,
    lac objLocPtr
    SKIP_NEXT_IF_SAME [OBJ_LOC(OBJ_ROD)
    jmp foHitDone             // not the rod (no skip): ordinary hit
// TASK-FR32 S-5 (S19, 05-Sep-26). 5140 is reached only from 5000's
// FAILURE, so the source has already established .NOT.HERE(ROD) before
// it looks at ROD2 at all; substituting whenever ROD2 happens to be here
// gets the wrong rod whenever both are. adven.f4 11000 places both in
// the repository, and `TAKE ROD` there picked up the black one.
    lac OBJ_LOC(OBJ_ROD)
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (not carried -- try the room)
    jmp foHitDone             // AC == 0: TOTING(ROD) -- HERE, so 5140 never runs
    SKIP_NEXT_IF_DIFFERENT curRoom  // skip when the rod is NOT lying in this room
    jmp foHitDone                   // == curRoom: AT(ROD) -- HERE, ditto
    lac OBJ_LOC(OBJ_ROD2)
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (carried -- HERE)
    jmp foRodCheckRoom        // AC != 0 (no skip): not carried, try the room
    jmp foRod2
foRodCheckRoom,
    SKIP_NEXT_IF_SAME curRoom // skip when objLoc[ROD2] == curRoom (lying here)
    jmp foHitDone             // elsewhere (no skip): ROD2 not HERE -- keep ROD
foRod2,
    law OBJ_LOC(OBJ_ROD2)
    dac objLocPtr
    law OBJ_TAKE(OBJ_ROD2)
    dac objTakePtr
foHitDone,
    law 1
    jmp foRtn
// TASK-FR7 7b group 1 (S14, 03-Sep-26). The objNames walk above is
// exhausted; before answering "no such object", try the alias table.
//
// adven.dat section 4 gives many objects a second and third vocabulary
// word -- LAMP is also HEADL and LANTE, CHEST is also BOX and TREAS,
// VASE is also MING, SHARD and POTTE. None of them can live in objNames:
// the walk above advances namePtr, objLocPtr and objTakePtr in lockstep
// on one index, so a second name row for an object would slide objLoc and
// objTake one place out of correspondence for every object after it.
//
// objAlias is therefore a separate two-word-per-row table, {vocabulary
// word address, OBJ_* index}, generated from the corpus's own 'alias'
// statements. It is scanned only on a miss, so nothing on the common path
// pays for it, and on a hit the two pointers are re-derived from their
// table bases by index -- leaving the caller in exactly the state a
// primary-name hit would have. Falling into foHit rather than returning
// directly is deliberate: an alias must inherit 5140's ROD -> ROD2
// substitution too, the same as the primary word would.
foMiss,
    lac [objAlias:3]
    dac namePtr               // namePtr now walks the alias table instead
    dzm ix
foAliasScan,
    lac ix
    SKIP_NEXT_IF_DIFFERENT [NOBJALIAS
    jmp foNoMatch        // branch 1 (equal): alias table exhausted too -- unknown word
                         // branch 2 (different): another alias row to check
foAliasCheck,
    eem
    lac i namePtr         // row word 0: the alias word's address
    lem
    jda strCmpEq
    lem                   // strCmpEq returns with eem on
    SKIP_NEXT_IF_AC_ZERO  // skip when AC == 0 (no match)
    jmp foAliasHit        // AC != 0: this alias names our object
foAliasAdvance,           // AC == 0: step over BOTH words of this row
    idx namePtr
    idx namePtr
    idx ix
    jmp foAliasScan
foAliasHit,
    idx namePtr           // -> row word 1: the OBJ_* index it aliases
    eem
    lac i namePtr
    lem
    dac ix                // ix is done as a counter; reuse it for the index
    add [objLoc
    dac objLocPtr
    lac ix
    add [objTake
    dac objTakePtr
    jmp foHit
foNoMatch,
    cla
foRtn,
    eem
    jmp i rtn
rtn, 0
namePtr, 0
ix, 0
    endloc

// Loads curRoom's 64-word record from the drum-resident room table.
// It is read into the passed buffer address using the passed room identifier.
//
// This MUST be called every time curRoom changes and BEFORE
// any program logic uses a room since all the logic uses ROOM_CACHE directly.
// Bounds-checks curRoom against 1..NROOMS first.
// An out-of-range curRoom should never happen.
// If it does, this skips the drum read entirely and forces ROOM_CACHE's dark flag on
// and dwarf flag off.
//
// Record layout:
//   word 0:      A packed representation of room number and exit count.
//                The layout, using the silly DEC bit notation where 0 is the msb
//                and 17 is the lsb is:
//                0:1 - reserved, always 0
//                2:9 - exit count, 256 is far above any possible need
//                10:17 - room number, 256 is well above what is needed
//   words 1-2:   long-message track/offset and count doublet
//                ROOMTAB_LONG_MSG is defined as 1 for the offset to this.
//   words 3-4:   short-message track/offset and count doublet,
//                same as the long value if the room def says "SHORT SAME".
//                ROOMTAB_SHORT_MSG is defined as 3 for the offset to this.
//   word 5:      a packed per-room flags word
//                0 - dark flag, 1 for dark, 0 for not
//                1 - dwarf flag, 1 for yes, 0 for no
//                2 - surface flag, 1 if the room is above ground
//                3:17 - reserved for future per-room flags
//                ROOMTAB_FLAGS is defined as 5 for the offset to this.
//   words 6+:   up to MAXEXITS exit entries, 2 words each. They were 3
//               until TASK-FR2 (05-Sep-26) replaced the inline block-message
//               doublet with an index -- 91% of exit rows are unconditional
//               and were spending two of their three words on a 0/0 doublet.
//               Again using the DEC convention, the bits are:
//               word 0, EXIT_FLAGS:
//                  0:6  - direction code, matches the DIR_* defs
//                  7:11 - condition ID, 0 unconditional else index into
//                         adventure.am1's condFlagAddrs dispatch table.
//                 12:17 - roll threshold, 0 unless COND_RAND/COND_RANDMSG
//               word 1, EXIT_DEST:
//                  0:9  - this row's block message as a 1-based index into
//                         msgtab, 0 if the row prints nothing. Its address
//                         is msgTab + MSGTAB_RECORDSIZE * (index - 1).
//                 10:17 - destination room number, 0 if the row names none
//               ROOMTAB_EXITS is defined as 6 for the offset to this.
//
// Seven direction bits is a floor, not a convenience: adven.dat's travel
// table uses 75 distinct motion codes and its highest is 77, so six bits
// cannot hold them however they are renumbered.
//
// MAXEXITS is 29 -- 6 + 2*29 = 64, the whole record, with no slack left.
// Raised from 18 on 06-Sep-26 by the owner's decision for TASK-FR2 step 3,
// which needs 25 for LOC 19; see AdvDataLoader/advdataloader.h for the
// measurement. The drum cost was nil (the record already reserved the
// space); the real cost is dwMoveOne's dmoCand buffer, which is bank 1,
// at one word per exit -- 11 words of the 53 that bank had.
//
// MAXEXITS cannot be raised again without changing ROOMTAB_RECORDSIZE,
// and that is fixed by loadRoom's hardcoded sar 6s / and [77 / sal 6s.
// Access macros are defined in the room include file.
//
// The record size is intentionally 64 words to make addressing it simple.
// track = ROOMTAB_BASE_TRACK + ((curRoom-1) >> 6),
// offset = ((curRoom-1) & 077)  << 6.
//

// Called via jsp with the buffer address following:
// jsp loadRoom
// buffer-address-word
// ...
// The room to load is passed in the IO register.
// On return, AC will be 1 for success, 0 for fail.
loadRoom,
    local rtn, ix, track, offset, count, addr
    dac rtn

    // Room is in IO
    lai
    sub [1
    dac ix                  // ix = curRoom - 1, the 0-based record index
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO                     // if AC is negative..
    jmp lrInvalid           // branch 2 (AC minus, no skip): room < 1 -- invalid
                            // branch 1 (AC >= 0, skip): room >= 1 -- keep checking
lrCheckHigh,
    lai
    sub [NROOMS
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp lrInvalid           // branch 2 (AC > 0, no skip): room > NROOMS -- invalid
                            // branch 1 (AC <= 0, skip): room <= NROOMS -- in range
lrInRange,
    lac ix
    sar 6s                  // (room-1) >> 6, track delta
    add [ROOMTAB_BASE_TRACK
    dac track
    lac ix
    and [77                 // (curRoom-1) & 077, record-within-track
    sal 6s                  // * 0d64 -- word offset within the track
    dac offset
    law ROOMTAB_RECORDSIZE
    dac count
    lac i rtn               // pick up the buffer address
    dac addr                // 4th word of the contiguous drumRead record below
    idx rtn                 // update the return address, note idx must come here, it changes AC
    law track               // track/offset/count/addr are contiguous -- the
    jda drumRead            // 4-word record drumRead expects, see its own header comment
    law 1                   // success flag
    jmp i rtn

lrInvalid,
    lac i rtn               // pick up the buffer address
    dac addr
    idx rtn
    // Force the dark flag on, dwarf flag off.
    lac addr
    add [ROOMTAB_FLAGS]
    dac addr                // point at the caller-buffer flags word (word 5)
    lac i addr
    ior [DARK_FLAG_MASK]
    and [~DWARF_FLAG_MASK]
    dac i addr
    cla                     // fail flag
    jmp i rtn

rtn, 0
ix, 0
track, 0
offset, 0
count, 0
addr, 0
    endloc

// printObjHere -- after a room description prints, list any table-driven
// objects that are actually sitting in curRoom right now: an objLoc
// entry equal to curRoom, or a second location matching curRoom (the
// dragon and the rug), each printed via its objHereMsg entry.
// An objHereMsg of 0 means there is no 'here' message.
// No arguments.
// Called via jsp.
//
// The listing is in objDropSeq order, smallest key first, NOT in object
// order (TASK-FR31 N41): adven.f4 describes a room by walking ATLOC(LOC)'s
// linked list, onto which advn2's DROP prefixes, so the thing just put down
// is named first. See objDropSeq's own declaration comment for the key, and
// bumpDropSeq for where a key is lowered.
//
// One selection pass per line printed: each pass scans the table for the
// smallest key that is still ahead of the last one printed, so the cost is
// (objects here + 1) scans, not a sort of the whole table. The key alone
// would be enough -- keys are unique by construction -- but the pass
// compares (key, index) as a pair so that a table that somehow held a
// duplicate would still print both objects rather than silently dropping
// one.
printObjHere,
    local rtn, locPtr, seqPtr, ix, pohTmp
    addlocal pohBestIx, pohBestSeq, pohHaveBest
    addlocal pohPrevIx, pohPrevSeq, pohHavePrev
    dap rtn
    dzm pohHavePrev           // nothing printed yet: every object is still ahead
pohPass,
    dzm pohHaveBest
    law objLoc
    dac locPtr
    law objDropSeq
    dac seqPtr
    dzm ix
pohScan,
    lac ix
    SKIP_NEXT_IF_DIFFERENT [NOBJS
    jmp pohPassDone     // branch 1 (equal): scanned every object
    lac i locPtr        // branch 2 (different): an entry to check
    SKIP_NEXT_IF_SAME curRoom         // skip when object is here
    jmp pohSecondLoc    // differs: might still be here via a SECOND location
pohHere,                // equal (skip): object is here
    lio ix                    // IO = this object's table index
    jsp repoHiddenTest        // same-bank (bank 0) helper; returns AC = nonzero if suppressed
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (not suppressed) -- fall through as usual
    jmp pohAdvance            // AC != 0 (no skip): hidden, on to the next.
pohCheckPrev,                 // is this object still AHEAD of the last one printed?
    lac pohHavePrev
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (something printed already) -- compare
    jmp pohCheckBest          // AC == 0 (no skip): first line of the description
    lac i seqPtr
    SKIP_NEXT_IF_DIFFERENT pohPrevSeq   // skip when the keys differ -- ordinary compare
    jmp pohPrevTie                      // equal (no skip): the index breaks the tie
    sub pohPrevSeq                      // differ (skip): safe to subtract, no -0 case
    SKIP_NEXT_IF_AC_NEGATIVE  // skip when key < the last printed key (already listed)
    jmp pohCheckBest          // key > it (no skip): still to come
    jmp pohAdvance            // key < it (skip): already listed
pohPrevTie,
    lac ix
    sub pohPrevIx
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE   // skip when index <= it (this object or an earlier one)
    jmp pohCheckBest                   // index > it (no skip): still to come
    jmp pohAdvance                     // (skip): already listed
pohCheckBest,                 // is it the smallest such key seen in this pass?
    lac pohHaveBest
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (a candidate already) -- compare
    jmp pohTakeBest           // AC == 0 (no skip): first candidate of this pass
    lac i seqPtr
    SKIP_NEXT_IF_DIFFERENT pohBestSeq  // skip when the keys differ -- ordinary compare
    jmp pohAdvance                     // equal (no skip): the lower index already holds it
    sub pohBestSeq                     // differ (skip)
    SKIP_NEXT_IF_AC_NEGATIVE  // skip when smaller than the running best -- take it
    jmp pohAdvance            // larger (no skip): keep the running best
pohTakeBest,
    lac ix
    dac pohBestIx
    lac i seqPtr
    dac pohBestSeq
    law 1
    dac pohHaveBest
pohAdvance,
    idx locPtr
    idx seqPtr
    idx ix
    jmp pohScan
pohPassDone,
    lac pohHaveBest
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (a line to print) -- print it
    jmp rtn                   // AC == 0: nothing left here that hasn't been listed
    lac pohBestSeq
    dac pohPrevSeq
    lac pohBestIx
    dac pohPrevIx
    law 1
    dac pohHavePrev
pohTreasureCheck,
    lac pohBestIx
    add [objTreasure:2]
    dac pohTmp
    eem
    lac i pohTmp
    lem
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (not a treasure)
    jmp pohSight              // AC != 0 (no skip): a treasure -- sighting hook, then print
pohPrint,                     // AC == 0 (skip): not a treasure -- print it, unless objHereMsg is 0
    lac pohBestIx
    add [objHereMsg:2]
    dac pohTmp
    eem
    lac i pohTmp
    lem
    SKIP_NEXT_IF_AC_NOT_ZERO           // skip when AC != 0 (a real message -- print it)
    jmp pohPass                        // AC == 0: no HERE line for this object at all
    jda pmsg
    jmp pohPass
pohSight,                               // a treasure?
    lio pohBestIx
    eem
    jsp i [treasureSighted:2]
    lem
    jmp pohPrint
// TASK-FR6 6c. adven.dat section 7 gives an immovable object a SECOND
// location when it is visible from two rooms, and the source's own object
// list carries an entry in both (adven.f4:402, CALL DROP(K+100,FIXD(K))),
// so the room description prints it in both. This port has one location
// word per object; dragonHere's header comment above has the full story.
//
// Only the dragon (object 31) and the rug (object 62) reach here -- both
// "119 121" -- and only while the dragon lives. Rejoining the loop at
// pohHere rather than printing inline is deliberate: repoHiddenTest, the
// treasure-sighting hook and the objHereMsg print then run identically in
// both of the object's rooms, which is what the source's two-entry object
// list does. The rug is a treasure, so its sighting hook genuinely
// matters here.
pohSecondLoc,
    lac ix
    SKIP_NEXT_IF_DIFFERENT [OBJ_DRAGON
    jmp pohSecondRoom          // == the dragon (no skip): it has a second location
    SKIP_NEXT_IF_SAME [OBJ_RUG      // skip when == the rug -- it has one too
    jmp pohAdvance             // any other object: one location only, genuinely not here
pohSecondRoom,
    jsp dragonHere             // same-bank (bank 0) helper -- AC != 0 iff the dragon is
                                  // present, which for LOC 119 is exactly when BOTH of
                                  // these objects are (the rug's second location is
                                  // cleared by the same kill block, MOVE(RUG+100,0))
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp pohAdvance             // AC == 0 (no skip): not the second location either
    jmp pohHere                // AC != 0 (skip): present here after all
rtn, jmp 0
locPtr, 0
seqPtr, 0
ix, 0
pohTmp, 0
pohBestIx, 0
pohBestSeq, 0
pohHaveBest, 0
pohPrevIx, 0
pohPrevSeq, 0
pohHavePrev, 0
    endloc

// bumpDropSeq -- move one object to the front of its room's description
// order, the effect advn2's DROP has by prefixing it onto ATLOC(WHERE)
// (advn2 361-362). Gives it a key one below the lowest in the table, so
// printObjHere lists it first (TASK-FR31 N41).
// IO = the address of the object's objLoc slot -- what objLocPtr holds at
// every drop site, and what FAR_OBJ_LOC(OBJ_x) names at a fixed one. The
// single scan below walks objLoc and objDropSeq in step, so the key slot
// is found by matching that address rather than by arithmetic on it; an
// address that is not in the table (a liquid's stand-in, say) simply
// matches nothing and the call is a no-op.
// AC and IO are clobbered; no return value.
// Called via jsp; bank-0 resident and dual-mode -- banks 1 and 3 call it
// jsp i [bumpDropSeq:0].
bumpDropSeq,
    local rtn, bdsTarget, bdsPtr, bdsLoc, bdsScan, bdsIx, bdsMin
    dac rtn
    lai                        // AC = the objLoc slot address (argument, in IO)
    dac bdsTarget
    law objLoc
    dac bdsLoc
    law objDropSeq
    dac bdsScan
    dzm bdsIx
    dzm bdsPtr                 // 0 = the target has not been matched yet
    lac i bdsScan
    dac bdsMin                 // seed the running minimum with slot 0
bdsScanLoop,
    lac bdsIx
    SKIP_NEXT_IF_DIFFERENT [NOBJS
    jmp bdsDone                // equal: every slot examined
    lac bdsLoc                 // different: another slot to weigh
    SKIP_NEXT_IF_SAME bdsTarget        // skip when this is the object we were handed
    jmp bdsMinTest                     // some other object (no skip): only the minimum matters
    lac bdsScan                        // (skip): remember where its key lives
    dac bdsPtr
bdsMinTest,
    lac i bdsScan
    SKIP_NEXT_IF_DIFFERENT bdsMin      // skip when it differs -- worth comparing
    jmp bdsNext                        // equal (no skip): no improvement
    sub bdsMin                         // differs (skip): safe to subtract, no -0 case
    SKIP_NEXT_IF_AC_NEGATIVE   // skip when below the running minimum -- adopt it
    jmp bdsNext                // above it (no skip): keep what we have
    lac i bdsScan              // (skip): a new minimum
    dac bdsMin
bdsNext,
    idx bdsLoc
    idx bdsScan
    idx bdsIx
    jmp bdsScanLoop
bdsDone,
    lac bdsPtr
    SKIP_NEXT_IF_AC_NOT_ZERO   // skip when AC != 0 (matched a real object) -- write the key
    jmp i rtn                  // AC == 0: not a table address -- nothing to reorder
    lac bdsMin
    sub [1
    dac i bdsPtr               // strictly ahead of every other key in the table
    jmp i rtn
rtn, 0
bdsTarget, 0
bdsPtr, 0
bdsLoc, 0
bdsScan, 0
bdsIx, 0
bdsMin, 0
    endloc

// repoHiddenTest -- is object N (in IO) currently suppressed from printing its
// own HERE line because it's still sitting untouched in the closing-time
// repository pile?
// AC returns nonzero if so, 0 if not
// Called via jsp -- SAME-BANK ONLY
// =======================================================================
repoHiddenTest,
    local rtn
    dap rtn
    lai                        // AC = object index (caller's argument, passed in IO)
    SKIP_NEXT_IF_DIFFERENT [OBJ_BOTTLE
    jmp rhtBottle
    SKIP_NEXT_IF_DIFFERENT [OBJ_PLANT
    jmp rhtPlant
    SKIP_NEXT_IF_DIFFERENT [OBJ_OYSTER
    jmp rhtOyster
    SKIP_NEXT_IF_DIFFERENT [OBJ_LAMP
    jmp rhtLamp
    SKIP_NEXT_IF_DIFFERENT [OBJ_ROD
    jmp rhtRod
    SKIP_NEXT_IF_DIFFERENT [OBJ_SNAKE
    jmp rhtSnake
    SKIP_NEXT_IF_DIFFERENT [OBJ_BIRD
    jmp rhtBird
    SKIP_NEXT_IF_DIFFERENT [OBJ_CAGE
    jmp rhtCage
    SKIP_NEXT_IF_DIFFERENT [OBJ_ROD2
    jmp rhtRod2
    SKIP_NEXT_IF_DIFFERENT [OBJ_PILLOW
    jmp rhtPillow
rhtNotRepo,                       // matched none of the ten -- never hidden
    cla
    jmp rtn
rhtBottle, lac repoHiddenBottle; jmp rtn
rhtPlant,  lac repoHiddenPlant;  jmp rtn
rhtOyster, lac repoHiddenOyster; jmp rtn
rhtLamp,   lac repoHiddenLamp;   jmp rtn
rhtRod,    lac repoHiddenRod;    jmp rtn
rhtSnake,  lac repoHiddenSnake;  jmp rtn
rhtBird,   lac repoHiddenBird;   jmp rtn
rhtCage,   lac repoHiddenCage;   jmp rtn
rhtRod2,   lac repoHiddenRod2;   jmp rtn
rhtPillow, lac repoHiddenPillow; jmp rtn
rtn, jmp 0
    endloc

// checkVaseMishandle -- see adven.f4 lines 1304-1311 (labels 9027/9028).
//
//   9027 IF(OBJ.EQ.VASE.AND.LOC.NE.PLAC(PILLOW))GOTO 9028
//        CALL RSPEAK(54)                     ! "OK." -- ordinary drop
//        GOTO 9021
//   9028 PROP(VASE)=2
//        IF(AT(PILLOW))PROP(VASE)=0
//        CALL PSPEAK(VASE,PROP(VASE)+1)
//        IF(PROP(VASE).NE.0)FIXED(VASE)=-1
//
// PLAC(PILLOW) is the pillow's INITIAL location (adven.dat section 7's
// "10 96"), not its current one, so "LOC.NE.PLAC(PILLOW)" is the static
// room test against R_SOFTROOM below -- it stays true even after the
// pillow has been carried away. AT(PILLOW) is the separate, dynamic half.
//
// Returns AC != 0 when this routine has fully handled the drop (message
// printed AND the object placed), AC == 0 when the caller's ordinary drop
// path should run instead. No arguments. Called via jsp; bank-0 resident
// and dual-mode -- bank 3's doDrop/doThrow call it jsp i [checkVaseMishandle:0].
// =======================================================================
checkVaseMishandle,
    local rtn, cvmIsVase, cvmNotHandled, cvmCheckPillow, cvmOnPillow, cvmBreak, cvmRtn
    dac rtn
    lac objLocPtr
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_VASE)            // the vase's objLoc slot
    jmp cvmIsVase                // AC == [objLoc+0d18] (no skip): it IS the vase
cvmNotHandled,                     // AC != [objLoc+0d18] (skip): some other object -- unhandled
    cla
    jmp cvmRtn
cvmIsVase,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_SOFTROOM
    jmp cvmNotHandled              // AC == R_SOFTROOM (no skip): safe -- ordinary drop handles it
cvmCheckPillow,                      // AC != R_SOFTROOM (skip): label 9028 -- PROP(VASE)=2 unless
                                     //   AT(PILLOW) puts it back to 0. AT(OBJ) is
                                     //   "PLACE(OBJ).EQ.LOC.OR.FIXED(OBJ).EQ.LOC" (adven.f4:79) and
                                     //   the pillow is an ordinary movable object (FIXED 0, adven.dat
                                     //   "10 96" has no second location), so AT(PILLOW) means the
                                     //   pillow is LYING IN THIS ROOM. A carried pillow (objLoc == 0,
                                     //   this project's carried convention) does NOT save the vase --
                                     //   the player has to drop the pillow first. That is the puzzle.
    lac OBJ_LOC(OBJ_PILLOW)
    SKIP_NEXT_IF_SAME curRoom      // skip when the pillow is lying here -- the vase survives
    jmp cvmBreak                   // differs (no skip): no pillow here -- the vase breaks
cvmOnPillow,                         // equal (skip): PROP(VASE)=0, so PSPEAK(VASE,PROP+1) is the
                                     //   object's tier-1 text and FIXED(VASE) is left alone. PROP
                                     //   staying 0 means objHereMsg[VASE] keeps msg_HERE_VASE -- the
                                     //   room lister's own PSPEAK(VASE,PROP) tier -- and objTake[VASE]
                                     //   stays 1, so the vase can be picked back up and carried on.
                                     //   The pillow line is a one-shot drop message, not a here-line.
    lac [msg_HERE_VASE_ON_PILLOW:1]
    jda pmsg
    eem
    lac curRoom                    // ordinary drop placement -- the same store vaseBreakMutate makes,
    dac i objLocPtr                //   minus every part of breaking it
    lio objLocPtr                  // still 1278's DROP -- head of the room's list
    jsp bumpDropSeq
    law 1                          // handled: the caller must NOT also print its own "OK."
    jmp cvmRtn
cvmBreak,                            // no pillow here -- PROP(VASE)=2, FIXED(VASE)=-1
    lac [msg_VASE_BREAK:1]         // PSPEAK(VASE,PROP+1) -- accidental
    jda pmsg                       //   mishandle's OWN text, distinct from the
                                    //   explicit BREAK VASE verb's msg 198.
                                    //   do not merge these.
    eem
    jsp i [vaseBreakMutate:0]      // shared state-mutation tail
    jmp cvmRtn
cvmRtn,
    eem
    jmp i rtn
rtn, 0
    endloc

// vaseBreakMutate -- the shared "actually break the vase" state-mutation tail.
// No arguments. Called via jsp, cross-bank compatible.
vaseBreakMutate,
    local rtn
    dac rtn
    lac curRoom
    dac i objLocPtr                // ordinary drop placement -- the (now broken) vase lands here
    lio objLocPtr                  // still 1278's DROP -- head of the room's list
    jsp bumpDropSeq
    dzm OBJ_TAKE(OBJ_VASE)                // broken -- permanently unmovable, matches FIXED(VASE)=-1
    lac [msg_HERE_VASE_BROKEN:1]
    fardac(FAR_OBJ_HEREMSG(OBJ_VASE))
    law 1
    dac vaseBroken
    law 1
    eem
    jmp i rtn
rtn, 0
    endloc

// checkVendingCoins -- check for coins for the vending machine.
// No arguments. Called via jsp.
checkVendingCoins,
    local rtn, cvcIsCoins, cvcNotHandled, cvcAtVending, cvcRtn
    dac rtn
    lac objLocPtr
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_COINS)            // the coins' objLoc slot
    jmp cvcIsCoins                // AC == [objLoc+0d11] (no skip): it IS the coins
cvcNotHandled,                      // AC != [objLoc+0d11] (skip): some other object -- unhandled
    cla
    jmp cvcRtn
cvcIsCoins,
    lac curRoom
    SKIP_NEXT_IF_SAME [R_MAZE_D140_VEND
    jmp cvcNotHandled              // AC != R_MAZE_D140_VEND (no skip): coins, but not here -- ordinary drop
cvcAtVending,                        // AC == R_MAZE_D140_VEND (skip): at the vending machine -- handle it
    law COINS_GONE
    dac i objLocPtr                // CALL DSTROY(COINS) -- objLocPtr already points at objLoc[COINS]
    lac curRoom
    dac OBJ_LOC(OBJ_BATTERIES)     // CALL DROP(BATTER,LOC)
    lio [OBJ_LOC(OBJ_BATTERIES)]   // 1283's DROP -- head of the room's list
    jsp bumpDropSeq
    dzm batteryUsed                // fresh batteries -- PROP(BATTER)
    lac [msg_BATTERIES_HERE:1]
    fardac(FAR_OBJ_HEREMSG(OBJ_BATTERIES))  // reset in case a previous game's lampTurn
                                                //   left this patched to msg_BATTERIES_DISCARDED
    jda pmsg                       // CALL PSPEAK(BATTER,0) -- the fresh-batteries description
    law 1
cvcRtn,
    eem
    jmp i rtn
rtn, 0
    endloc

// foodHere -- True if FOOD is carried or lying in curRoom
// (adven.f4's HERE(FOOD) test, re-derived from adven.f4 lines 1653-1660
// this stage). Used by doFeed's dfCheckFood -- kept out here, alongside
// checkBearDrop/checkTrollPayment/checkBirdSnake, rather than down by
// doFeed itself: playGame (below) opens one shared local scope at its
// own `local rtn, ...` that stays open across every verb handler nested
// inside it (doTake/doDrop/doThrow/doAttack/doFeed/... all the way to
// pgDone's endloc) -- a small helper declaring its own `local rtn` in
// that span would nest and hide playGame's own rtn (am1 catches this
// with a "local will hide a local of the same name" warning; confirmed
// live this stage after first placing foodHere down by doFeed).
// Returns AC=1 if carried or in curRoom, AC=0 otherwise.
// Called via jsp.
foodHere,
    local rtn
    dac rtn
                          // same shape as checkDark/dwarfHereScan); bank-3
                          // doEat calls it jsp i [foodHere:0].
    lac OBJ_LOC(OBJ_FOOD)          // FOOD's objLoc: 0 if carried, else a room number
    SKIP_NEXT_IF_AC_NOT_ZERO                   // skip when AC != 0 (not carried)
    jmp fhYes                  // AC == 0 (no skip): carried -- here
fhCheckRoom,                    // AC != 0 (skip): not carried -- is it in curRoom?
    lac OBJ_LOC(OBJ_FOOD)
    SKIP_NEXT_IF_SAME curRoom               // skip when EQUAL (in curRoom)
    jmp fhNo                   // AC != curRoom (no skip): neither carried nor here
fhYes,                          // AC == curRoom (skip), or (via the jmp above) carried
    law 1
    jmp i rtn
fhNo,
    cla
    jmp i rtn
rtn, 0
    endloc

// dragonHere -- adven.f4's AT(DRAGON), in full.
//
// AT(OBJ) is "PLACE(OBJ).EQ.LOC .OR. FIXED(OBJ).EQ.LOC" (adven.f4:79):
// adven.dat section 7's "31 119 121" gives the dragon TWO locations and
// the source keeps the second one in FIXED. This port reduced FIXED to
// the boolean objTake (takeable / not), so the second location had
// nowhere to live and the dragon ended up present at LOC 121 only --
// TASK-FR6 6c.
//
// Hard-coding the pair here rather than adding a second-location table
// follows the precedent the port already set for the other two-placed
// objects it ships: printStepsHere hard-codes object 7's LOC 14/15 and
// printShadowFigHere hard-codes object 27's LOC 35/110, both of which
// TASK-FR6 6c lists as defects and neither of which actually is one. The
// only pair left over is the dragon (object 31) and the Persian rug
// (object 62), both "119 121"; the rug needs no AT() test of its own
// (see printObjHere's pohSecondLoc, and doTake, which refuses an
// objTake==0 object on identity alone, before it ever looks at where the
// object is).
//
// The second location disappears the moment the dragon dies, which is
// exactly the source's own CALL MOVE(DRAGON+100,-1) in the kill block
// (adven.f4:1474). doAttack's daKill already moves the dragon itself to
// LOC 120, so gating this on dragonDead reproduces MOVE(...,-1) with no
// extra state.
//
// No arguments. Returns AC != 0 when the dragon is present in curRoom by
// either of its two locations, AC == 0 when it is not. jsp style; bank-0
// resident and dual-mode -- bank 0 calls it `jsp dragonHere`, banks 1 and
// 3 call it `jsp i [dragonHere:0]`.
dragonHere,
    local rtn
    dac rtn
    lac OBJ_LOC(OBJ_DRAGON)
    SKIP_NEXT_IF_SAME curRoom      // skip when the dragon's own loc IS this room
    jmp drhSecond                  // differs (no skip): try the second location
    jmp drhYes                     // equal (skip): present, no further test needed
drhSecond,
    lac dragonDead
    SKIP_NEXT_IF_AC_ZERO           // skip when AC == 0 (alive -- second location still live)
    jmp drhNo                      // AC != 0 (no skip): dead -- MOVE(DRAGON+100,-1)
    lac curRoom
    SKIP_NEXT_IF_SAME [R_CANYONNE  // skip when standing at LOC 119, the second location
    jmp drhNo
drhYes,
    law 1
    jmp i rtn
drhNo,
    cla
    jmp i rtn
rtn, 0
    endloc

// liquidAtRoom -- LIQLOC(LOC): which liquid, if any, is lying about in
// curRoom. Returns AC = 0 (nothing), 1 (water) or 2 (oil), the same
// encoding doFill's old bank-1 liquidHere returned.
//
// adven.f4:80 defines LIQLOC(K) out of COND(K)'s bits 1 and 2:
// bit 2 says "there is a liquid asset here", bit 1 then picks oil over
// water. adven.dat section 9 sets bit 2 at LOCs 1, 3, 4, 7, 38, 95, 113
// and 24, and bit 1 at 24 alone -- so seven water rooms and one oil room,
// listed below in adven.dat's own order.
//
// The port's room records carry no COND bits at all (the corpus differ
// reports zero flag mismatches precisely because there is no flag there
// to mismatch), so the data lives here as a room-number table until the
// corpus grows a liquid flag. TASK-FR20 C10 is what forced the issue:
// liquidHere knew only R_BUILDING and R_EASTPIT, which made ENTER STREAM
// answer WHERE? at the End of Road and made the bottle unfillable
// anywhere but the well house. TASK-FR7 7a's DRINK needs the same
// derivation, which is why this is one shared routine and not a second
// two-room test beside the first.
//
// No arguments; reads curRoom. Called via jsp; bank-0 resident and
// dual-mode -- bank 1's liquidHere and bank 0's own ENTER-water branch
// both use it.
// =======================================================================
liquidAtRoom,
    local rtn
    dac rtn
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_ROAD          // LOC 1
    jmp larWater
    SKIP_NEXT_IF_DIFFERENT [R_BUILDING      // LOC 3
    jmp larWater
    SKIP_NEXT_IF_DIFFERENT [R_VALLEY        // LOC 4
    jmp larWater
    SKIP_NEXT_IF_DIFFERENT [R_SLIT          // LOC 7
    jmp larWater
    SKIP_NEXT_IF_DIFFERENT [R_STREAMPIT     // LOC 38
    jmp larWater
    SKIP_NEXT_IF_DIFFERENT [R_WATERFALL     // LOC 95
    jmp larWater
    SKIP_NEXT_IF_DIFFERENT [R_RESERVOIR     // LOC 113
    jmp larWater
    SKIP_NEXT_IF_SAME [R_EASTPIT            // LOC 24 -- skip when it IS the oil pit
    jmp larNone                             // none of the eight (no skip): a dry room
larOil,                                     // R_EASTPIT (skip): bit 1 as well as bit 2
    law 2
    jmp i rtn
larWater,
    law 1
    jmp i rtn
larNone,
    cla
    jmp i rtn
rtn, 0
    endloc

// printBearFollows -- adven.f4 label 2001's first statement,
// "IF(TOTING(BEAR))CALL RSPEAK(141)".
//
// TASK-FR23 C23 (03-Sep-26): the port had msg 141 in exactly one place,
// objInvMsg[BEAR], so the tame bear announced itself only from INSIDE the
// INVENTORY list and never while walking around. The source is the other
// way round on both counts -- 141 prints ahead of EVERY room description
// (label 2001, before CALL SPEAK(KK)), and label 8200's inventory loop
// explicitly SKIPS the bear ("IF(I.EQ.BEAR.OR..NOT.TOTING(I))GOTO 8201")
// and prints 141 after the list instead. doInventory's invDone does that
// half; this routine does this one.
//
// 2001 is reached on the dark path too (KK becomes RTEXT(16) above it),
// so this sits ahead of enterRoom's own checkDark branch rather than
// inside the lit leg.
//
// No arguments; reads objLoc[BEAR]. jsp style, bank-0 resident, and only
// ever called from bank 0 (enterRoom and doLook).
// =======================================================================
printBearFollows,
    local rtn
    dap rtn
    lac OBJ_LOC(OBJ_BEAR)
    SKIP_NEXT_IF_AC_ZERO           // skip when AC == 0 (carried -- TOTING(BEAR))
    jmp rtn                        // AC != 0 (no skip): not carried -- nothing to say
    lac [msg_INV_BEAR:1]           // msg 141, the same text objInvMsg[BEAR] used to carry
    jda pmsg
rtn, jmp 0
    endloc

// checkPloverCarry --  Scans objLoc for how
// many objects are currently carried (objLoc==0, this project's standing
// "carried" convention) and, if exactly one, which -- mirrors
// doInventory's own objLoc-scan idiom (law objLoc/dac ptr/dzm idx loop)
// rather than adding a new HOLDNG-style running counter, since nothing
// else in this project needs a live carried-item count outside this one
// check.
// Re-derived directly against adven.f4 line 1054 ("TRAVEL 301", the
// Alcove<->Plover Room tunnel):
//   IF(HOLDNG.EQ.0.OR.(HOLDNG.EQ.1.AND.TOTING(EMRALD)))GOTO 2
// Returns AC=1 if the tunnel may be crossed (carrying nothing, or
// carrying the emerald alone), AC=0 otherwise.
// No arguments. Called via jsp.
checkPloverCarry,
    local rtn, ptr, cpcIdx, count, onlyIdx
    dap rtn
    law objLoc
    dac ptr
    dzm cpcIdx
    dzm count
    dzm onlyIdx
cpcScan,
    lac cpcIdx
    SKIP_NEXT_IF_DIFFERENT [NOBJS
    jmp cpcDone                // cpcIdx == NOBJS (no skip): scanned every object
cpcCheck,                        // cpcIdx != NOBJS (skip): an entry to check
    lac i ptr
    SKIP_NEXT_IF_AC_ZERO
    jmp cpcAdvance              // AC != 0 (sza no-skip): not carried
    lac cpcIdx                     // AC == 0 (sza skip, falls through): carried
    dac onlyIdx                    // remember which index (only matters if count ends up 1)
    idx count                      // and bump the running count
cpcAdvance,
    idx ptr
    idx cpcIdx
    jmp cpcScan
cpcDone,
    lac count
    SKIP_NEXT_IF_DIFFERENT [0
    jmp cpcAllowed              // count == 0 (sad no-skip): carrying nothing -- always allowed
    SKIP_NEXT_IF_DIFFERENT [1
    jmp cpcCheckEmerald         // count == 1 (sad no-skip): check whether it's the emerald
    jmp cpcBlocked              // count >= 2 (sad skip, falls through): always blocked
cpcCheckEmerald,
    lac onlyIdx
    SKIP_NEXT_IF_DIFFERENT [0d19                   // EMERALD's object-table index (the 20th entry, 0-based 19)
    jmp cpcAllowed               // the emerald alone (sad no-skip): allowed
    jmp cpcBlocked                // not the emerald (sad skip, falls through): blocked
cpcAllowed,
    law 1
    jmp rtn
cpcBlocked,
    cla
    jmp rtn
rtn, jmp 0
ptr, 0
cpcIdx, 0
count, 0
onlyIdx, 0
    endloc

// Check the dark flag for the current cached room.
// Returns AC = 1 if curRoom is dark and the player's lamp
// lamp isn't both carried and on, AC = 0 otherwise.
// Called via jsp, preserves IO.
checkDark,
    local rtn, cdGotEntry, cdCheckOn, cdIsdark, cdNotDarkAfterAll, cdNotDark
    dac rtn
    lac ROOM_CACHE + ROOMTAB_FLAGS  // the flag is in word 5 (TASK-ROOM-FLAG-WORD)
    IS_DARK             // macro checks the proper bit
    SKIP_NEXT_IF_AC_NOT_ZERO               // skip when AC != 0, curRoom is dark-flagged, check the lamp
    jmp cdNotDark       // AC == 0: not a dark room
cdGotEntry,             // AC != 0: curRoom is dark-flagged, check the lamp
    lac OBJ_LOC(OBJ_LAMP)        // lamp's objLoc entry, 0 if carried, else a room number
    SKIP_NEXT_IF_AC_NOT_ZERO     // skip when != 0 (not carried -- is it in this room?)
    jmp cdCheckOn       // 0: carried -- check whether it's lit
    SKIP_NEXT_IF_SAME curRoom    // skip when == curRoom (lamp lying here)
    jmp cdIsDark        // elsewhere: dark regardless of the switch
cdCheckOn,
    lac lampOn
    SKIP_NEXT_IF_AC_ZERO
    jmp cdNotDarkAfterAll   // branch 1 (nonzero, lamp is on): carried and lit, not dark
                            // branch 2 (zero, lamp is off): carried but unli, dark
cdIsDark,
    law 1
    jmp i rtn

cdNotDarkAfterAll,
    cla
    jmp i rtn

cdNotDark,
    cla
    jmp i rtn
rtn, 0
    endloc

// Check the dwarf flag for the current cached room to see if curRoom is one
// of the rooms dwarves inhabit.
// Returns AC = 1 if so, AC = 0 otherwise.
// Called via jsp.
// Preserves IO.
checkDwarfRoom,
    local rtn
    dac rtn
                          // dwarfTurn/dwMoveOne call cross-bank; bank-0
                          // pirateTurn keeps plain jsp and lems after
    lac ROOM_CACHE + ROOMTAB_FLAGS  // the flag is in word 5 (TASK-ROOM-FLAG-WORD)
    IS_DWARF            // macro checks the proper bit
    SKIP_NEXT_IF_AC_NOT_ZERO               // skip when AC != 0, curRoom is dwarf territory
    jmp cdrRtn          // AC == 0: not dwarf territory
    law 1               // AC != 0: curRoom is dwarf territory
cdrRtn,
    eem
    jmp i rtn
rtn, 0
    endloc

// Check the PIRATE_FORBID flag for the current cached room -- the source's
// COND-bit-3 dwarf/pirate exclusion zone  adven.f4 lines 638/657/697,
// 18 rooms -- the Maze-1 dead-end subset and the volcano/bear cluster.
// Returns AC = 1 if curRoom is one of the 18,
// AC = 0 otherwise. Same section-13 dual-mode shape as checkDwarfRoom
// immediately above (its own bank-1/bank-3 callers use
// jsp i [checkPirateForbidRoom:0]; same-bank bank-0 callers use plain jsp
// and lem after, since this always returns with eem on). Preserves IO.
checkPirateForbidRoom,
    local rtn
    dac rtn
    lac ROOM_CACHE + ROOMTAB_FLAGS  // the flag is in word 5 (TASK-ROOM-FLAG-WORD)
    IS_PIRATE_FORBID    // macro checks the proper bit
    SKIP_NEXT_IF_AC_NOT_ZERO               // skip when AC != 0, curRoom is forbidden
    jmp cpfRtn          // AC == 0: not a forbidden room
    law 1               // AC != 0: curRoom is one of the 18
cpfRtn,
    eem
    jmp i rtn
rtn, 0
    endloc

// Check to see if the nugget is found.
// No-ops for every room except the Nugget of Gold Room.
// Called unconditionally from erGo/dlgo, right after printGrateStatus, so
// nuggetFound latches the first time the player stands in the room
// and sees the nugget, matching the orginal game's "found" = "seen in a room".
// It's for a single real room, so a direct check is done.
// No return value.
// Called via jsp.
// Preserves IO.
checkNuggetFound,
    local rtn
    dap rtn
    lac curRoom
    SKIP_NEXT_IF_SAME [R_NUGGET         // skip when standing in the Nugget Room -- mark it found
    jmp rtn               // any other room -- nothing to do
    law 1
    dac nuggetFound
rtn, jmp 0
    endloc

// printChasmTroll -- After a room description prints, if curRoom
// is either chasm bank (R_CHASM_SW/R_CHASM_NE), print the chasm's own
// line: the rickety bridge and the "STOP! PAY TROLL!" sign
// (msg_HERE_CHASM_BRIDGE, adven.dat object 32 prop 0) while the bridge
// stands, or the wreckage (msg_HERE_CHASM_WRECKAGE, prop 1) once
// mccBearDeath has set chasmDestroyed -- f4 30310's PROP(CHASM)=1.
// Then the troll's own line: present (msg_HERE_TROLL) or gone
// (msg_HERE_TROLL_GONE), reflecting trollGone. Mirrors printGrateStatus's
// shape exactly -- same single-flag-checked-room idiom, just two rooms and
// two message lines instead of one room and a three-way branch.
// Called via jsp.
printChasmTroll,
    local rtn, pctCheckNE, pctGotRoom, pctBridge, pctChasmPrint
    addlocal pctPresent, pctPrint
    dap rtn
    lac curRoom
    SKIP_NEXT_IF_SAME [R_CHASM_SW       // skip when in R_CHASM_SW -- report status
    jmp pctCheckNE         // not R_CHASM_SW -- check the other bank
    jmp pctGotRoom
pctCheckNE,
    lac curRoom
    SKIP_NEXT_IF_SAME [R_CHASM_NE       // skip when in R_CHASM_NE -- report status
    jmp rtn                 // neither chasm bank -- nothing to say
pctGotRoom,
// CLAUDE 04-Sep-26 (TASK-FR31 N40): the chasm line was unconditional, so
// after the bear took the bridge down both banks went on offering a
// rickety bridge and a sign telling the player to pay the troll -- a
// bridge the game's own msg_CHASM_NO_LONGER refuses to let anyone cross.
// chasmDestroyed is the port's PROP(CHASM), set by mccBearDeath alone.
    lac chasmDestroyed
    SKIP_NEXT_IF_AC_NOT_ZERO                  // skip if AC != 0 (chasm permanently destroyed)
    jmp pctBridge           // branch 1 (AC == 0, no skip): bridge still stands
    lac [msg_HERE_CHASM_WRECKAGE:1]  // branch 2 (AC != 0, skip): wreckage, no sign
    jmp pctChasmPrint
pctBridge,
    lac [msg_HERE_CHASM_BRIDGE:1]
pctChasmPrint,
    jda pmsg
    lac trollGone
    SKIP_NEXT_IF_AC_NOT_ZERO                  // skip if AC != 0 (trollGone nonzero -- troll gone)
    jmp pctPresent          // branch 1 (AC == 0, no skip): troll still present
    lac [msg_HERE_TROLL_GONE:1] // branch 2 (AC != 0): troll gone -- falls through
    jmp pctPrint
pctPresent,
    lac [msg_HERE_TROLL:1]
pctPrint,
    jda pmsg
rtn, jmp 0
    endloc

// printFissureBridge -- after a room description prints, if curRoom is
// either bank of the fissure and the crystal bridge is standing, print
// the bridge's own line (TASK-FR31 N37).
//
// adven.dat section 7 gives *FISSURE the row "12 17 27" -- two-placed, at
// both banks -- and object 12's prop-1 text is "A CRYSTAL BRIDGE NOW SPANS
// THE FISSURE.", so while PROP(FISSUR)=1 that line is part of EVERY
// description of either bank, not just of the WAVE that raised it. (Prop
// 2, "THE CRYSTAL BRIDGE HAS VANISHED!", is never a standing description:
// adven.f4 1421's PSPEAK(FISSUR,2-PROP) speaks it once, at the wave that
// lowers the bridge, which is exactly where doWave already prints it.)
// fissureBridge is the port's PROP(FISSUR); startClosing zeroes it (f4
// 1880), so the endgame needs no separate test here.
// Mirrors printChasmTroll's shape -- the same two-rooms/one-flag idiom for
// the other piece of two-placed scenery whose text is state-dependent.
// Called via jsp (bank-0 resident).
printFissureBridge,
    local rtn
    dap rtn
    jsp atFissure          // AC != 0 iff curRoom is either bank ("12 17 27")
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when AC != 0 (at a bank) -- keep checking
    jmp rtn                        // AC == 0: neither bank -- nothing to say
pfbCheckBridge,
    lac fissureBridge
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when AC != 0 (bridge standing) -- print it
    jmp rtn                        // AC == 0: no bridge -- object 12 prop 0 is ">$<", silent
pfbPrint,
    lac [msg_FISSURE_BRIDGE_FORMED:1]
    jda pmsg
rtn, jmp 0
    endloc

// printStepsHere --  adven.f4 817 suppresses the HERE
// line entirely while TOTING(NUGGET); 826 selects "LEAD UP THE DOME" at
// the FIXD room (R_MISTHALL) vs. the default "LEAD DOWN THE PIT" at the
// PLAC room (R_PITTOP).
// Called via jsp (bank-0 resident).
printStepsHere,
    local rtn
    dap rtn
    lac OBJ_LOC(OBJ_NUGGET)
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when AC != 0 (nugget not carried -- steps may show)
    jmp rtn                        // AC == 0: carrying the nugget -- suppressed (f4 817)
pshCheckPittop,
    lac curRoom
    SKIP_NEXT_IF_SAME [R_PITTOP    // skip when in R_PITTOP -- tier 0, "down the pit"
    jmp pshCheckMist
    jmp pshDown
pshCheckMist,
    lac curRoom
    SKIP_NEXT_IF_SAME [R_MISTHALL  // skip when in R_MISTHALL -- tier 1, "up the dome"
    jmp rtn                        // neither steps room -- nothing to say
    jmp pshUp
pshDown,
    lac [msg_STEPS_DOWN:1]
    jmp pshPrint
pshUp,
    lac [msg_STEPS_UP:1]
pshPrint,
    jda pmsg
rtn, jmp 0
    endloc

// printShadowFigHere -- handles the shawoy figure message logic.
// Called via jsp (bank-0 resident).
printShadowFigHere,
    local rtn
    dap rtn
    lac curRoom
    SKIP_NEXT_IF_SAME [R_Y2WINDOW       // skip when in R_Y2WINDOW -- report status
    jmp psfCheckOther        // not R_Y2WINDOW -- check the other window room
    jmp psfPrint
psfCheckOther,
    lac curRoom
    SKIP_NEXT_IF_SAME [R_WINDOWONPIT    // skip when in R_WINDOWONPIT -- report status
    jmp rtn                  // neither window room -- nothing to say
    jmp psfPrint
psfPrint,
    lac [msg_HERE_SHADOWFIG:1]
    jda pmsg
rtn, jmp 0
    endloc

// atFissure -- True if curRoom is R_FISSURE_EAST or
// R_FISSURE_WEST, the two rooms *FISSURE is fixed scenery at (adven.dat
// section 7, "12 17 27"). Mirrors atGrate above exactly: this project
// doesn't model *FISSURE as a real objLoc entry any more than it models
// the grate that way, both are fixed scenery gated by a direct curRoom
// check instead of an object-table lookup. Used by doWave (WAVE ROD only
// does anything at the fissure) and doMove's fissure-death check below.
// Returns AC=1 if at either bank, AC=0 otherwise.
// Called via jsp.
atFissure,
    local rtn
    dac rtn
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_FISSURE_EAST
    jmp afYes              // branch 1 (equal): east bank
                              // branch 2 (different): keep checking
    SKIP_NEXT_IF_SAME [R_FISSURE_WEST    // skip when west bank -- also counts
    jmp afNo                  // differs: not at either
afYes,                         // east bank, or (falling through) west bank
    law 1
    jmp i rtn
afNo,
    cla
    jmp i rtn
rtn, 0
    endloc

// Generic move processing.
// Call via jmp, it's not a subroutine and it never returns.
// Every path below ends the turn via moveGo/moveBlocked/
// dmBlocked/dmDarkDeath, all of which reach turnLoop or pgDone on their
// own with curDir already set by the vtHit dispatch in playGame's
// verb-table scan to the direction code of the verb just matched.
//
// The dark-room fatal-fall roll is NOT made here. TASK-FR22 (03-Sep-26):
// adven.f4 makes it at label 2000, i.e. AFTER "74 LOC=NEWLOC", on the
// room the player has ended the move IN --
//     IF(FORCED(LOC).OR..NOT.DARK(0))GOTO 2001
//     IF(WZDARK.AND.PCT(35))GOTO 90
// -- so leaving a dark room for a lit one, or for a forced-motion room,
// can never kill, and a death drops the player's possessions where the
// move ENDED (label 90's OLDLC2=LOC). This routine used to roll up
// front, on curRoom, before the travel scan, which killed on moves the
// original cannot kill on. The roll now lives in darkDeathRoll, called
// from exactly two places: moveGo (once the destination is curRoom and
// loaded, ahead of enterRoom's description -- 2000's own position) and
// moveStay (the motion commands that leave the player where they are,
// which in the source also fall through label 50/16/30100 to 2000 and
// roll there, on the unchanged LOC). Everything that ends the turn
// without reaching either -- the outright deaths -- matches the source,
// where the roll is skipped for the same reason.
//
// Scans ROOM_CACHE's exit list up to MAXEXITS entries for the first
// whose direction code matches curDir.
// On a match:
//   - if the condition ID is 0, the exit is unconditional, move immediately.
//   - if it's COND_RAND, this row is a weighted random exit.
//     Toll rand18, mask to RAND_DOMAIN_MASK's domain, and
//     compare against the row's stored threshold, a percent the
//     room compiler already converted to be in the domain.
//     Hit: move.
//     Miss: NOT a block, this is an independent per-attempt roll against
//     this row's odds, so a miss falls through to the NEXT row for this same direction.
//     This matches the original source's row-cascade semantics for a randomized exit.
//     A direction's row group is expected to end with a plain unconditional row as the
//     guaranteed catch-all.
//     If it doesn't, exhausting the scan just falls through to the ordinary
//     moveBlocked case below, same as any other exit-not-found.
//   - otherwise, it indexes and indirects through condFlagAddrs to get the
//     flag value it gates on, and then reads the entry's own destination
//     and message fields to decide what the two outcomes are. There are
//     three shapes and advdataloader.h's four-shape table defines them:
//       dest and message  -- flag set: move. Unset: print, stay. The
//                            original form, and the only one that prints
//                            on a failed test.
//       dest, no message  -- flag set: move. Unset: fall through to the
//                            NEXT entry for this direction, silently.
//                            adven.f4 label 12 (TASK-FR2 step 3).
//       message, no dest  -- flag set: print, stay. Unset: fall through
//                            silently. The gated message-only row.
//     A row with neither is rejected by the loader, so dmBlocked always
//     has a message to print.
//
// On no match at all it falls through to the existing moveBlocked handler exactly like before.
// doMoveFromFar -- bank-3 handlers (doBack) re-enter the movement
// machinery here: doMove expects its established eem-OFF entry state,
// and a cross-bank jmp necessarily arrives with eem on, so this 2-word
// thunk normalizes first (same idea as turnLoop's own entry lem).
doMoveFromFar,
    lem
    jmp doMove

doMove,
    local count, ptr, ix, dest, fieldPtr, flagPtr, weight
    addlocal mccNotOver, mccCheckRoom, mccGotRoom, mccPresent, mccFirstCrossing
    addlocal mccChasmGone, mccCheckTrollGone, mccCheckBypass, mccCheckCrossed
    addlocal mccReArm, mccOrdinaryCross, mccBearDeath
    addlocal mccSpicesLost, mccSpicesFall
    addlocal mccSwBankDir, mccNeBankDir
// TASK-FR26 N4 (S17, 04-Sep-26). adven.f4 label 8 runs
//     OLDLC2=OLDLOC
//     OLDLOC=LOC
// BEFORE the travel scan, so a motion word that is then refused has still
// shifted: BACK after "THERE IS NO WAY TO GO THAT DIRECTION." answers msg 91
// ("YOU CAN'T GET THERE FROM HERE") rather than walking the player back, and
// a death two moves later drops the possessions at the right room. This used
// to live in moveGo, where only a move that actually happened reached it.
//
// The four words label 8 exempts (NULL, BACK, LOOK, CAVE) do not come through
// here: LOOK is doLookCmd, CAVE is doCave, NULL is not vocabulary yet
// (TASK-FR27 N13), and doBack does its own single shift -- f4 does it at
// label 20 for BACK, and BACK's successful path re-enters the scan at label
// 9, below the shift, which is what doMoveFromFar lands on here.
dmShiftOldLoc,
    lac prevRoom
    dac oldLc2
    lac curRoom
    dac prevRoom
dmFissureDeathCheck,          // first executable word of doMove since TASK-FR22 moved the
                               // dark-death roll out to darkDeathRoll (see the header above)
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_OVER
    jmp mccCheckRoom          // AC == DIR_OVER (no skip): might be the chasm crossing
    SKIP_NEXT_IF_DIFFERENT [DIR_ACROSS
    jmp mccCheckRoom          // AC == DIR_ACROSS (no skip): a crossing word too (TASK-FR24)
    SKIP_NEXT_IF_DIFFERENT [DIR_CROSS
    jmp mccCheckRoom          // AC == DIR_CROSS (no skip): and so is CROSS
mccNotOver,                    // none of OVER/ACROSS/CROSS (skip): fall through to the
                                 // fissure FORWARD check below.
                                 // ACROSS and CROSS are also the FISSURE's crossing words,
                                 // but mccCheckRoom's own curRoom test sends anything that
                                 // isn't a chasm bank straight to dmSetup, where the
                                 // fissure's ordinary COND/MSG rows handle them.
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_FORWARD
    jmp dfdCheckRoom          // AC == DIR_FORWARD (no skip): might be the fissure death
    SKIP_NEXT_IF_DIFFERENT [DIR_JUMP
    jmp pjPitJumpCheck        // AC == DIR_JUMP (no skip): might be a pit jump, and
                              //   pjPitJumpCheck falls into dfdCheckRoom if it is not
                              //   -- JUMP is the fissure death's word too
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_CLIMB
    jmp wpcCheckRoom          // AC == DIR_CLIMB (no skip): might be the westpit climb
wpcNotClimb,                    // AC != DIR_CLIMB (skip): not CLIMB -- fall through to the
                                    // Plover/Alcove carry-gate check next
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_ALCOVE
    jmp plvAlcoveDir
    SKIP_NEXT_IF_DIFFERENT [R_PLOVER
    jmp plvPloverDir
    SKIP_NEXT_IF_DIFFERENT [R_MTKING
    jmp mtkSnakeCheck
    SKIP_NEXT_IF_DIFFERENT [R_CANYONABOVE
    jmp casSouthCheck
    SKIP_NEXT_IF_DIFFERENT [R_MTKING_CANYON_EW
    jmp cewWestCheck
    SKIP_NEXT_IF_DIFFERENT [R_PITTOP
    jmp ptCheckDir
    SKIP_NEXT_IF_DIFFERENT [R_MISTHALL
    jmp mhCheckDir
    SKIP_NEXT_IF_DIFFERENT [R_SHELLROOM
    jmp sdCheckDir
    SKIP_NEXT_IF_DIFFERENT [R_CHASM_SW
    jmp mccSwBankDir
    SKIP_NEXT_IF_DIFFERENT [R_CHASM_NE
    jmp mccNeBankDir
    SKIP_NEXT_IF_DIFFERENT [R_BUILDING
    jmp bldSewerCheck
    SKIP_NEXT_IF_DIFFERENT [R_FISSURE_WEST
    jmp fwNorthCheck
    SKIP_NEXT_IF_DIFFERENT [R_MISTHALL_WEST
    jmp mwNorthCheck
    jmp dmSetup                // none of the special rooms -- ordinary scan
// mccSwBankDir/mccNeBankDir -- entered only when curRoom is one of the two
// chasm banks and curDir was NOT one of OVER/ACROSS/CROSS (those were
// dispatched by direction above). adven.dat gives each bank a compass
// crossing word as well, and it is the direction of the OTHER bank: LOC
// 117's `117 233660 41 42 69 47` puts NE (47) alongside OVER/ACROSS/CROSS,
// and LOC 122's `122 233660 41 42 69 49` puts SW (49) there. Both mean the
// troll bridge, so both belong at movChasmCrossing with the rest -- the
// crossing is not a table row, it carries the troll re-arm, the bear death
// and the chasm-destroyed case.
// Each bank's own outbound path uses its OWN compass word (SW from the SW
// side to R_CHASM_CORRIDOR, NE from the NE side to R_VOLCANO_CORRIDOR) and
// must fall through to the ordinary scan, which is why this is per-bank
// rather than one shared NE-or-SW test.
mccSwBankDir,
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_NE
    jmp mccGotRoom             // AC == DIR_NE (no skip): the crossing -- curRoom is already
                                  // known to be a bank, so enter past mccCheckRoom's own test
    jmp dmSetup                // AC != DIR_NE (skip): the SW path out, ordinary scan
mccNeBankDir,
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_SW
    jmp mccGotRoom             // AC == DIR_SW (no skip): the crossing
    jmp dmSetup                // AC != DIR_SW (skip): the NE path out, ordinary scan
plvPloverDir,
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_WEST
    jmp plvGate
    SKIP_NEXT_IF_DIFFERENT [DIR_PASSAGE
    jmp plvGate
    SKIP_NEXT_IF_DIFFERENT [DIR_OUT
    jmp plvGate
    jmp dmSetup                // none of WEST/PASSAGE/OUT -- some other Plover exit, ungated
plvAlcoveDir,
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_EAST
    jmp plvGate
    SKIP_NEXT_IF_DIFFERENT [DIR_PASSAGE
    jmp plvGate
    jmp dmSetup                // neither EAST nor PASSAGE -- some other Alcove exit, ungated
plvGate,
    jsp checkPloverCarry
    SKIP_NEXT_IF_AC_ZERO
    jmp dmSetup                // AC != 0 (sza no-skip): allowed -- fall through to the ordinary row
    lac [msg_TUNNEL_TOO_FULL:1]  // AC == 0 (sza skip, falls through): blocked
    jmp moveStayT             // motion that stays put -- still rolls (TASK-FR22)
// sdCheckDir/sdCarryCheck -- entered only when curRoom == R_SHELLROOM.
// AC/ still holds curRoom on entry.
sdCheckDir,
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_SOUTH
    jmp sdCarryCheck
    jmp dmSetup                // not SOUTH -- Shell Room's UP/DOWN exits are ungated
sdCarryCheck,
    lac i [FAR_OBJ_LOC(OBJ_CLAM)]
    SKIP_NEXT_IF_AC_NOT_ZERO    // skip when AC != 0 (not carrying the clam) -- falls through to check the oyster
    jmp sdClamBlocked           // AC == 0 (no skip): carrying the clam -- block
sdCheckOyster,
    lac i [FAR_OBJ_LOC(OBJ_OYSTER)]
    SKIP_NEXT_IF_AC_NOT_ZERO    // skip when AC != 0 (not carrying the oyster) -- falls through to allow
    jmp sdOysterBlocked         // AC == 0 (no skip): carrying the oyster -- block
    jmp dmSetup                 // neither carried -- ordinary SOUTH row (R_JUNCTION)
sdClamBlocked,
    lac [msg_CLAM_TOO_BIG:1]
    jmp moveStayT             // motion that stays put -- still rolls (TASK-FR22)
sdOysterBlocked,
    lac [msg_OYSTER_TOO_BIG:1]
    jmp moveStayT
wpcCheckRoom,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_WESTPIT
    jmp wpcGotClimb           // AC == R_WESTPIT (no skip): the westpit CLIMB special case
wpcOrdinary,                    // AC != R_WESTPIT (skip): CLIMB typed somewhere else (e.g.
                                    // R_NARROWCORRIDOR, R_STEEPINCLINE, R_MAZE_A42) -- those
                                    // rooms' own ordinary EXIT CLIMB rows handle it
    jmp dmSetup
wpcGotClimb,
    lac plantProp
    SKIP_NEXT_IF_DIFFERENT [4
    jmp wpcGrown               // AC == 4 (no skip): fully grown -- LOC 26
wpcNotGrown,                     // AC != 4 (skip): not fully grown -- adven.dat's real chain is
                                    // LOC 31 (an invisible ">$<" forced routing node, "25 724031
                                    // 56") -> LOC 89 ("31 524089 1", msg_WESTPIT_NOCLIMB's text)
                                    // -> back to LOC 25 ("89 25 1") -- a local no-content bounce,
                                    // NOT a teleport to R_SMALLPIT (LOC 37, a real, different,
                                    // already-built room.
    lac [msg_WESTPIT_NOCLIMB:1]
    jda pmsg                       // print and CONTINUE (not pmsgT -- the turn isn't over yet)
    lac [R_WESTPIT
    jmp moveGo                     // re-enter LOC 25: prints its (short) text, ends the turn
wpcGrown,                        // AC == 4 (no skip): fully grown. adven.dat `25 26 56`
                                    // reaches LOC 26, a FORCED location whose only row is
                                    // `26 88 1` -- adven.f4 2000-2001 prints its text and
                                    // travels on to LOC 88 in the same turn, so the player
                                    // never stands in it. It was built as R_PLANTHOLE until
                                    // TASK-FR26 N6 (05-Sep-26).
    lac [msg_PLANTHOLE_LONG:1]     // LOC 26's own room text, byte-identical reuse
    jda pmsg                       // print and CONTINUE (not pmsgT -- the turn isn't over yet)
    law 1
    dac mgForcedHop                // second hop of a forced traversal: f4 71 skips the
                                    // dwarf block check (see moveGo)
    lac [R_NARROWCORRIDOR
    jmp moveGo
// mtkSnakeCheck -- Reached only when curRoom == R_MTKING (dispatch chain above).
// Reproduces adven.dat LOC 19's snake-present travel cascade exactly, under
// adven.f4's real cascade rule (statement 12: a failed condition falls
// to the NEXT row in file order regardless of motion words):
//   NORTH/SOUTH/WEST (rows 448/449/450 fail while the snake is present)
//     -> cascade into row 451's unconditional LOC 32;
//   SW (row 452) -> 35% roll to LOC 74 first, else row 453 (snake here,
//     condition 211 true) -> LOC 32.
// LOC 32 is a FORCED location (adven.f4 line 84) the player never
// occupies: print its text and re-enter LOC 19 -- mtkBounce below gives
// the exact original transcript (snake line + LOC 19's short text), no
// player command consumed, no LOC-32 room built.
// Snake gone: fall straight to the ordinary table rows, which are
// correct on their own (NORTH unconditional -> R_HOLE; SOUTH/WEST COND
// rows pass; SW unconditional -> R_MTKING_CANYON_EW, because rows
// 452->453->454 cascade to LOC 74 regardless of the roll once the snake
// is gone). FORWARD (row 450's synonym) never reaches here (intercepted
// by the fissure check above) and remains unwired at R_MTKING.
mtkSnakeCheck,
    lac pastSnake
    SKIP_NEXT_IF_AC_ZERO
    jmp dmSetup               // pastSnake != 0 (no skip): snake gone -- table rows handle all
mtkSnakePresent,              // pastSnake == 0 (skip): snake still blocking
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_NORTH
    jmp mtkBounce             // AC == DIR_NORTH (no skip): rows 448->451 -> LOC 32
    SKIP_NEXT_IF_DIFFERENT [DIR_SOUTH
    jmp mtkBounce             // AC == DIR_SOUTH (no skip): rows 449->451 -> LOC 32
    SKIP_NEXT_IF_DIFFERENT [DIR_WEST
    jmp mtkBounce             // AC == DIR_WEST (no skip): rows 450->451 -> LOC 32
    SKIP_NEXT_IF_SAME [DIR_SW // skip when AC == DIR_SW -- the SW cascade, falls through
    jmp dmSetup               // AC != DIR_SW (no skip): no snake gate on this direction
mtkSwRoll,                    // AC == DIR_SW (skip): row 452's 35% roll comes FIRST
    eem                     // rand18 is bank 3 (Task 1); it needs eem on
    jsp i [rand18:3]
    lem                     // back to bank 0's eem-off default
    and [RAND_DOMAIN_MASK     // AC = the draw (0..RAND_DOMAIN-1), same domain as dmRand
    sub [MTK_SW_THRESHOLD     // draw - 11; -0 impossible (draw is a masked small positive,
                              // sub only yields -0 from (-0)-(+0) -- DECISIONS.md sub/sma rule)
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp mtkBounce             // AC >= 0 (no skip): draw >= threshold -- miss, row 453 -> LOC 32
mtkSwHit,                     // AC < 0 (skip): draw < threshold -- hit, row 452 -> LOC 74
    lac [R_MTKING_CANYON_EW
    jmp moveGo
mtkBounce,                    // the FORCED LOC-32 bounce: snake text, then re-enter LOC 19
    lac [msg_SNAKE_BLOCKED:1] // LOC 32's own room text, byte-identical reuse (daBearDead precedent)
    jda pmsg                  // print and CONTINUE (not pmsgT -- the turn isn't over yet)
    lac [R_MTKING
    jmp moveGo                // re-enter LOC 19: prints its (short) text, ends the turn

// casSouthCheck -- Reached only when curRoom == R_CANYONABOVE (dispatch chain above).
// adven.dat LOC 69's SOUTH pair (lines 601-602): dragon dead (PROP(31) != 0) ->
// LOC 120 (R_MTKING_CANYON_MID), else the unconditional row -> LOC 119
// (R_CANYONNE). Two live destinations, so per DECISIONS.md ("Boolean
// COND/MSG exit rows support exactly one gated destination") the
// dragon-dead leg is intercepted here; the existing unconditional
// EXIT SOUTH R_CANYONNE table row remains the dragon-alive fallback.
casSouthCheck,
    lac curDir
    SKIP_NEXT_IF_SAME [DIR_SOUTH // skip when AC == DIR_SOUTH -- falls through
    jmp dmSetup               // AC != DIR_SOUTH (no skip): nothing special here
casSouth,                     // AC == DIR_SOUTH (skip): the switch direction
    lac dragonDead
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dmSetup               // AC == 0 (no skip): dragon alive -- table row -> R_CANYONNE
casDragonDead,                // AC != 0 (skip): dragon dead -- row 601 -> LOC 120
    lac [R_MTKING_CANYON_MID
    jmp moveGo

// cewWestCheck -- Reached only when curRoom == R_MTKING_CANYON_EW
// (dispatch chain above). adven.dat LOC 74's WEST pair:
//     74 331120 44     M=331, i.e. PROP(31) != 0 (dragon dead) -> LOC 120
//     74 121    44     else                                    -> LOC 121
// This is the same shape casSouthCheck implements just above for LOC 69's
// SOUTH; LOC 69 and LOC 74 are the two ends of the same dragon-gated pair
// and only one of them was ever built (TASK-FR5 5a). Per DECISIONS.md
// ("Boolean COND/MSG exit rows support exactly one gated destination",
// cited in casSouthCheck's own comment) the dragon-dead leg is intercepted
// here and the existing unconditional EXIT WEST R_MTKING_CANYON_FAR table
// row stays as the dragon-alive fallback.
//
// Note TASK-FR5's own quotation of the row reads "74 311120 44"; the
// actual adven.dat line is 331120. The condition it names (PROP(31) != 0)
// is right either way -- 300 + 31 is the section-3 encoding for "object
// 31's PROP is nonzero" -- but the digits in the task document are a
// transcription error, not a second condition form.
cewWestCheck,
    lac curDir
    SKIP_NEXT_IF_SAME [DIR_WEST  // skip when AC == DIR_WEST -- falls through
    jmp dmSetup               // AC != DIR_WEST (no skip): nothing special here
cewWest,                      // AC == DIR_WEST (skip): the switch direction
    lac dragonDead
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dmSetup               // AC == 0 (no skip): dragon alive -- table row -> LOC 121
cewDragonDead,                // AC != 0 (skip): dragon dead -- row `74 331120 44` -> LOC 120
    lac [R_MTKING_CANYON_MID
    jmp moveGo

// ptCheckDir -- Reached only when curRoom == R_PITTOP. adven.dat line 431
// (`14 150020 30 31 34`, M=150 -- carrying object 50/GOLD): DOWN/PIT/
// STEPS -> LOC 20, the broken-neck death. Line 432's fallback
// (`14 15 30`, not carrying) -> LOC 15 is the table's own unconditional
// EXIT DOWN R_MISTHALL row, reached simply by falling through to dmSetup
// below. No R_PITBOTTOM room is built.
//
// S45, 06-Sep-26: PIT and STEPS answer this row now, and the note that
// stood here ("PIT/STEPS have no DIR_ word in this build ... only DOWN is
// reachable") was three sessions stale -- DIR_PIT (0d31), DIR_STEPS
// (0d34) and DIR_DOME (0d35) all exist, wired by TASK-FR2 step 3, and PIT
// is already a corpus exit word at eight other LOCs. What was left was
// this room and the Hall of Mists: both halves of each row were missing,
// so PIT at the Pit Top answered "THERE IS NO WAY TO GO THAT DIRECTION."
// where the source either kills the player or walks him down to LOC 15.
// The two halves are split the way DOWN's already were -- the gold death
// here, the fallback as a corpus row (`exit PIT R_MISTHALL`,
// `exit STEPS R_MISTHALL`), because a table row cannot reach LOC 20.
// adven.f4's label-12 fall-through is what gives the fallback row its
// other two words in the ORIGINAL; the port has no word-agnostic
// fall-through, so each word needs its own row (S44).
//
// The CRACK/WEST arm is TASK-FR26 N6 (05-Sep-26). adven.dat `14 16 33 44`
// sends both words to LOC 16, a FORCED location whose only row is
// `16 14 1`: adven.f4 2000-2001 prints its text unconditionally -- no dark
// test, no PITCH DARK substitution, no dark-death roll -- then travels
// again in the same turn with no input read. R_CRACK used to be built as a
// room the player stands in; it is now the same bounce mtkBounce/mhBounce/
// bldSewerBounce already are, and the destination is this room, so
// checkDwarfBlock's self-move exemption covers f4 71's FORCED(LOC) skip
// with nothing to write. CRACK had no exit here at all before this (one of
// TASK-FR2's missing-row list); the arm answers both of the row's words.
ptCheckDir,
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_WEST
    jmp ptCrackBounce         // AC == DIR_WEST (no skip): the crack
    SKIP_NEXT_IF_DIFFERENT [DIR_CRACK
    jmp ptCrackBounce         // AC == DIR_CRACK (no skip): the same row's other word
    SKIP_NEXT_IF_DIFFERENT [DIR_PIT
    jmp ptDown                // AC == DIR_PIT (no skip): `14 150020 30 31 34`'s second word (S45)
    SKIP_NEXT_IF_DIFFERENT [DIR_STEPS
    jmp ptDown                // AC == DIR_STEPS (no skip): and its third (S45)
    SKIP_NEXT_IF_SAME [DIR_DOWN  // skip when AC == DIR_DOWN -- falls through
    jmp dmSetup               // AC != DIR_DOWN (no skip): some other Pittop exit, ordinary scan
ptDown,                       // AC == DIR_DOWN (skip): might be the gold death
    lac OBJ_LOC(OBJ_NUGGET)
    SKIP_NEXT_IF_DIFFERENT [0
    jmp ptDeath                // AC == 0 (no skip): carrying -- the fatal fall
ptNotCarrying,                   // AC != 0 (skip): not carrying -- table row -> R_MISTHALL
    jmp dmSetup
ptDeath,
    lac [msg_PITBOTTOM_DEATH_LONG:1]
    jda pmsg
    jmp playerDied
ptCrackBounce,                // the FORCED LOC-16 bounce (TASK-FR26 N6)
    lac [msg_CRACK_LONG:1]    // LOC 16's own room text, byte-identical reuse
    jda pmsg                  // print and CONTINUE (not pmsgT -- the turn isn't over yet)
    lac [R_PITTOP
    jmp moveGo                // re-enter LOC 14: prints its (short) text, ends the turn

// mhCheckDir -- Reached only/ when curRoom == R_MISTHALL. adven.dat line 437
// (`15 150022 29 31 34 35 23 43`, M=150 -- carrying GOLD.
//
// S45, 06-Sep-26: the row names SIX words -- UP(29), PIT(31), STEPS(34),
// DOME(35), PASSA(23) and EAST(43) -- and three of them had no arm here
// and no corpus exit either, so PIT, STEPS and DOME were refused outright
// where the source bounces the gold-carrying player off the dome or walks
// an empty-handed one up to the Pit Top. DOME especially: "THE DOME IS
// UNCLIMBABLE." is the answer the source gives the word, and the port had
// no way to say it. Each new word gets its own arm here and its own
// `exit ... R_PITTOP` row for line 438's not-carrying fallback, because
// the port has no word-agnostic cascade fall-through (S44).
mhCheckDir,
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_UP
    jmp mhMaybeGold           // AC == DIR_UP (no skip): might be the gold bounce
    SKIP_NEXT_IF_DIFFERENT [DIR_EAST
    jmp mhMaybeGold           // AC == DIR_EAST (no skip): might be the gold bounce
    SKIP_NEXT_IF_DIFFERENT [DIR_PASSAGE
    jmp mhMaybeGold           // AC == DIR_PASSAGE (no skip): might be the gold bounce
    SKIP_NEXT_IF_DIFFERENT [DIR_PIT
    jmp mhMaybeGold           // AC == DIR_PIT (no skip): the same row's PIT (S45)
    SKIP_NEXT_IF_DIFFERENT [DIR_STEPS
    jmp mhMaybeGold           // AC == DIR_STEPS (no skip): and its STEPS (S45)
    SKIP_NEXT_IF_DIFFERENT [DIR_DOME
    jmp mhMaybeGold           // AC == DIR_DOME (no skip): and its DOME (S45)
    jmp dmSetup               // none of the six -- some other Misthall exit, ordinary scan
mhMaybeGold,
    lac OBJ_LOC(OBJ_NUGGET)
    SKIP_NEXT_IF_DIFFERENT [0
    jmp mhBounce               // AC == 0 (no skip): carrying -- the Dome bounce
mhNotCarrying,                    // AC != 0 (skip): not carrying -- table row -> R_PITTOP
    jmp dmSetup
mhBounce,                          // the FORCED LOC-22 bounce: dome text, then re-enter LOC 15
    lac [msg_DOME_LONG:1]      // LOC 22's own room text, byte-identical reuse (mtkBounce precedent)
    jda pmsg                   // print and CONTINUE (not pmsgT -- the turn isn't over yet)
    lac [R_MISTHALL
    jmp moveGo                 // re-enter LOC 15: prints its (short) text, ends the turn

// bldSewerCheck -- Reached only when curRoom == R_BUILDING (dispatch chain
// above). TASK-FR2 step 2. adven.dat's `3 79 5 14` sends DOWNSTREAM (5) and
// STREAM (14) from the well house to LOC 79, and LOC 79 is a FORCED location
// (adven.f4 line 84, COND=2): its only row is `79 3 1` -- motion word 1,
// straight back to LOC 3. The player never gets a turn there, and no word
// would leave it if he did, so unlike LOC 16/21/26/40/59 it cannot be
// modelled as a room the player stands in. It is a bounce, exactly the
// shape of mtkBounce (LOC 32) and mhBounce (LOC 22): print LOC 79's own
// text, then re-enter LOC 3, which prints its (short) text and ends the
// turn. That is the source's own transcript -- adven.f4 2000 prints a
// forced LOC's text (always the LONG one; 2001's ABB increment is past the
// FORCED branch), then 2001's `IF(FORCED(LOC))GOTO 8` travels again with
// K=1 and label 16 falls through to 2, so one command costs one dwarf turn.
// Every other direction falls through to the ordinary scan, which owns the
// well house's OUT/OUTDO/WEST rows.
// ENTER STREAM never arrives here: adven.f4 2600's transform is done in the
// parser (tlEnterVerb), ahead of the whole verb dispatch.
// The clause about LOC 79 being unlike 16/26/40/59 is spent: TASK-FR26 N6
// (05-Sep-26) converted those four to this same idiom, so LOC 79 is no
// longer the exception -- it is simply the one whose row carried no word
// to leave by, which is why it was done first. FR27 N7 owns tlEnterVerb.
bldSewerCheck,
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_DOWNS
    jmp bldSewerBounce         // AC == DIR_DOWNS (no skip): DOWNSTREAM -- the sewer pipes
    SKIP_NEXT_IF_SAME [DIR_STREA  // skip when AC == DIR_STREA -- falls through
    jmp dmSetup                // AC != DIR_STREA (no skip): an ordinary well-house direction
bldSewerBounce,                    // AC == DIR_STREA (skip), or DOWNS above: the LOC-79 bounce
    lac [msg_SEWER_LONG:1]     // LOC 79's own room text, byte-identical reuse (mhBounce precedent)
    jda pmsg                   // print and CONTINUE (not pmsgT -- the turn isn't over yet)
    lac [R_BUILDING
    jmp moveGo                 // re-enter LOC 3: prints its (short) text, ends the turn

// fwNorthCheck / mwNorthCheck -- the two low crawls, TASK-FR26 N6.
// adven.dat `27 40 45` and `41 59 45` send NORTH to LOC 40 and LOC 59,
// which are FORCED locations sharing one text and whose only rows are
// `40 41 1` and `59 27 1`. They were built as R_LOWCRAWL_A/B, rooms the
// player stands in, until 05-Sep-26; they are now the same bounce
// mtkBounce/mhBounce/bldSewerBounce already are -- adven.f4 2000-2001
// prints the text unconditionally (no dark test, no PITCH DARK
// substitution, no dark-death roll) and travels on in the same turn.
// Two entry points rather than one shared direction test because the
// destination is the OTHER room of the pair, and the dispatch chain
// above has already told us which of the two we are in.
// The dwarf side falls out right: dmShiftOldLoc has already run at the
// origin, so prevRoom is the room the player really came from and
// doBack's ordinary scan reconstructs f4 label 20's `IF(FORCED(K))
// K=OLDLC2` with nothing to write; and mgForcedHop below carries f4 71's
// FORCED(LOC) skip of the block check, which the self-move bounces never
// needed.
// Neither room's OTHER exits come through here: R_FISSURE_WEST's
// FORWARD/JUMP are intercepted by dfdCheckRoom further up the chain and
// R_MISTHALL_WEST's CLIMB by wpcCheckRoom, both of which run on the
// direction before this room test is reached.
fwNorthCheck,                 // curRoom == R_FISSURE_WEST (LOC 27)
    lac curDir
    SKIP_NEXT_IF_SAME [DIR_NORTH  // skip when AC == DIR_NORTH -- falls through
    jmp dmSetup               // AC != DIR_NORTH (no skip): an ordinary fissure-bank direction
    lac [msg_LOWCRAWL_LONG:1] // LOC 40's own room text, byte-identical reuse
    jda pmsg                  // print and CONTINUE (not pmsgT -- the turn isn't over yet)
    law 1
    dac mgForcedHop
    lac [R_MISTHALL_WEST
    jmp moveGo                // travel on to LOC 41 in the same turn
mwNorthCheck,                 // curRoom == R_MISTHALL_WEST (LOC 41)
    lac curDir
    SKIP_NEXT_IF_SAME [DIR_NORTH  // skip when AC == DIR_NORTH -- falls through
    jmp dmSetup               // AC != DIR_NORTH (no skip): an ordinary west-end direction
    lac [msg_LOWCRAWL_LONG:1] // LOC 59's own room text -- the same message, as in the source
    jda pmsg
    law 1
    dac mgForcedHop
    lac [R_FISSURE_WEST
    jmp moveGo                // travel on to LOC 27 in the same turn

dmSetup,                      // AC != DIR_FORWARD (skip): not FORWARD -- ordinary scan (also
                                 // the landing point below for "not at the fissure", "bridge
                                 // present", and the checks above)
    lac ROOM_CACHE            // exit count loadRoom fetched for curRoom
    GET_EXIT_COUNT
    dac count
    law ROOM_CACHE + EXIT_OFFSET  // first exit entry's direction word
    dac ptr
    dzm ix
dmScan,
    lac ix
    SKIP_NEXT_IF_DIFFERENT count
    jmp moveBlocked          // branch 1 (equal): idx == exit count, table exhausted -- no such exit
                             // branch 2 (different): an entry to check
dmCheckDir,
    lac i ptr
    GET_DIRECTION_CODE
    SKIP_NEXT_IF_DIFFERENT curDir
    jmp dmHit                // branch 1 (equal, no skip): direction matches -- found it
dmAdvance,                   // branch 2 (different, skip): wrong direction, try next entry
    law EXIT_RECORDSIZE      // advance to the next one
    add ptr
    dac ptr
    idx ix
    jmp dmScan
dmHit,
    // ptr points at the matched entry's word 0 (direction code, condition
    // ID, roll threshold). Word 1 -- EXIT_DEST -- holds the destination
    // room and this row's message index; fieldPtr keeps its address,
    // because dmBlocked needs it again further down.
    law EXIT_DEST
    add ptr
    dac fieldPtr
    lac i fieldPtr
    GET_ROOM_NUMBER         // the destination, 0 if this row names none
    dac dest

    lac i ptr               // back to word 0
    GET_CONDITION_ID
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dmGo                // branch 1 (AC == 0, no skip): unconditional exit
                            // branch 2 (AC != 0, skip): conditional -- AC is the condition ID
    SKIP_NEXT_IF_SAME [COND_RAND          // Is this a weighted-random row, not a boolean gate?
    jmp dmMsgCheck          // branch 1 (AC != COND_RAND, no skip): not RAND -- try the message forms
dmRand,                     // branch 2 (AC == COND_RAND, skip): weighted roll -- falls through
    // Independent per-attempt roll against this row's odds. The threshold
    // has its own field in word 0 (it used to occupy the entry's second
    // word, which is now the destination/message word).
    lac i ptr
    GET_RAND_THRESHOLD      // AC = this row's threshold (0..RAND_DOMAIN)
    dac weight
    eem                     // rand18 is bank 3 (Task 1); it needs eem on
    jsp i [rand18:3]
    lem                     // back to bank 0's eem-off default
    and [RAND_DOMAIN_MASK   // AC = the draw (0..RAND_DOMAIN-1)
    sub weight
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp dmAdvance           // branch 1 (AC >= 0, no skip): draw >= weight -- miss, try the next row
dmRandHit,                  // branch 2 (AC < 0, skip): draw < weight -- hit, falls through
    jmp dmGo

// TASK-FR3/FR4 -- the two message-only row types, adven.dat's N>500
// travel rows: a motion that prints a message and leaves the player
// where they are. Neither carries a destination, so neither reaches
// dmGo, and neither is ever looked up in condFlagAddrs.
dmMsgCheck,                 // AC = this row's condition ID, not RAND
    SKIP_NEXT_IF_SAME [COND_MSG
    jmp dmRandMsgCheck      // branch 1 (AC != COND_MSG, no skip): try the weighted form
    jmp dmBlocked           // branch 2 (AC == COND_MSG, skip): unconditional -- print, stay put
dmRandMsgCheck,
    SKIP_NEXT_IF_SAME [COND_RANDMSG
    jmp dmBoolGate          // branch 1 (AC != COND_RANDMSG, no skip): ordinary boolean-flag gate
dmRandMsg,                  // branch 2 (AC == COND_RANDMSG, skip): weighted bounce
    // The same roll as dmRand, and now literally the same fetch. While
    // the message was an inline doublet this row's threshold had to ride
    // in the DESTINATION field, because the message needed both of the
    // entry's other words; a 10-bit message index freed it.
    lac i ptr
    GET_RAND_THRESHOLD      // AC = this row's threshold (0..RAND_DOMAIN)
    dac weight
    eem                     // rand18 is bank 3 (Task 1); it needs eem on
    jsp i [rand18:3]
    lem                     // back to bank 0's eem-off default
    and [RAND_DOMAIN_MASK   // AC = the draw (0..RAND_DOMAIN-1)
    sub weight
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp dmAdvance           // branch 1 (AC >= 0, no skip): draw >= weight -- miss, try the next row
dmRandMsgHit,               // branch 2 (AC < 0, skip): draw < weight -- hit, falls through
    jmp dmBlocked           // print the bounce message and end the turn, without moving
dmBoolGate,
    // AC still has this exit's condition.
    add [condFlagAddrs      // AC = condFlagAddrs + condition ID -- the dispatch table slot
    dac flagPtr
    lac i flagPtr           // AC = the REAL flag word's address (condFlagAddrs[id])
    dac flagPtr
    lac i flagPtr           // AC = the flag's current value
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dmGateFail          // branch 1 (AC == 0, no skip): flag unset -- the test failed
                            // branch 2 (AC != 0, skip): flag set -- falls through, allowed
dmGatePass,
    // TASK-FR2 step 3: the test held, so this row's OWN action runs, and
    // the destination field says which action that is. A row that names a
    // room moves the player; a row that names none is a gated
    // message-only row (`exit <dir> none cond <c> msg <m>`) and prints
    // instead, exactly as the ungated `exit <dir> none msg <m>` does.
    // advdataloader.h's four-shape table is the authority for this and
    // for dmGateFail below; the two must be read together.
    lac dest
    SKIP_NEXT_IF_AC_ZERO
    jmp dmGo                // branch 1 (dest != 0, no skip): a real destination -- move
                            // branch 2 (dest == 0, skip): gated message row -- falls through
    jmp dmBlocked           // print this row's message, stay put

dmGateFail,
    // TASK-FR2 step 3 / TASK-FR19 C12: the test failed, and what happens
    // now is what adven.f4 label 12 does -- the scan walks on to the next
    // entry for this direction WITHOUT printing, unless this row carries
    // a refusal message of its own. It carries one only in the original
    // `exit <dir> <dest> cond <c> msg <m>` shape: a room to go to when
    // the test holds AND a message when it does not. Either field
    // missing means the row is one of the two silent-on-failure shapes.
    lac dest
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dmAdvance           // branch 1 (dest == 0, no skip): gated message row --
                            //   its message is the ACTION, not a refusal; stay silent
                            // branch 2 (dest != 0, skip): may still carry a refusal
    lac i fieldPtr
    GET_MSG_INDEX           // AC = this row's message index, 0 when it has none
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dmAdvance           // branch 1 (index == 0, no skip): silent-fallthrough
                            //   conditional -- try the next entry for this direction
                            // branch 2 (index != 0, skip): the gate-with-refusal row
    jmp dmBlocked           // print the refusal and end the turn

dmGo,
    lac dest
    jmp moveGo
dmBlocked,
    // Every path here comes through dmHit, so fieldPtr still addresses
    // this row's EXIT_DEST word, and every row that reaches here has a
    // message: the loader requires one for COND_MSG, COND_RANDMSG and
    // both of the shapes that print, and dmGateFail has already sent the
    // two message-less shapes to dmAdvance. So the index is never 0.
    lac i fieldPtr
    GET_MSG_INDEX           // AC = 1-based index of the message in msgtab
    sub [1                  // make it 0-based
    sal 1s                  // * MSGTAB_RECORDSIZE -- the table's records are 2 words
    add [msgTab:1]          // AC = the record's address, what pmsg wants
    jmp moveStayT         // print the block message, roll, end the turn (TASK-FR22)
// pjPitJumpCheck -- JUMP only; FORWARD reaches dfdCheckRoom directly, above.
// TASK-FR3's last item (06-Sep-26). adven.dat `35 20 39`, `88 20 39` and
// `110 20 39` each send JUMP, unconditionally and as the LOC's only row for
// the word, to LOC 20 -- a FORCED location whose own only row is `20 0 1`,
// straight to LOC 0 and the death sequence. adven.f4 796 prints a forced
// LOC's text with no dark test and no PITCH DARK substitution, 2001 speaks
// it, and 802's `IF(FORCED(LOC))GOTO 8` travels again with no input read,
// so what the player sees is the broken-neck line and then death -- with no
// object listing and no dwarf turn. That is exactly what ptDeath already
// does for the Pit Top gold fall (`14 150020 30 31 34`), the OTHER row that
// routes to LOC 20, so the two share it and LOC 20 has one implementation.
//
// Killing ahead of the travel scan is the dfdCheckRoom pattern, and here it
// is faithful rather than a shortcut: the only step adven.f4 puts between
// the scan and the move is label 71's dwarf block, and 6012's dwarf-
// candidate filter carries `.OR.FORCED(NEWLOC)`, so no dwarf can ever stand
// in LOC 20 and 71's `ODLOC(I).EQ.NEWLOC` can never hold for this move.
//
// No room is built for LOC 20 -- TASK-FR26 N6's rule is that a forced LOC
// is a bounce, not a room, and the LOC 21 exception exists only because
// corpus exit rows name R_FISSURE_DEATH by symbol and dwMoveOne's FORCED
// exclusion then has to keep dwarves out of it (see isForcedRoom's header).
// Nothing names LOC 20, so neither obligation is created.
pjPitJumpCheck,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_Y2WINDOW
    jmp ptDeath               // AC == R_Y2WINDOW (no skip): adven.dat `35 20 39`
    SKIP_NEXT_IF_DIFFERENT [R_NARROWCORRIDOR
    jmp ptDeath               // AC == R_NARROWCORRIDOR (no skip): `88 20 39`
    SKIP_NEXT_IF_DIFFERENT [R_WINDOWONPIT
    jmp ptDeath               // AC == R_WINDOWONPIT (no skip): `110 20 39`
    SKIP_NEXT_IF_SAME [R_CHASM_SW  // skip when AC == R_CHASM_SW -- the fourth JUMP death,
                              //   falls through into pjChasmJump below
    jmp dfdCheckRoom          // none of the four (no skip): dfdCheckRoom owns JUMP at the
                              //   two fissure banks and sends the rest to dmSetup
// pjChasmJump -- TASK-FR4 item 4g (06-Sep-26, S44). adven.dat rows 728-729
// give LOC 117 a JUMP cascade the port lacked entirely:
//     117 332021 39     -> LOC 21 when PROP(32 *CHASM) is not 0
//     117 596     39    then, unconditionally, -> stay, msg 96
// PROP(32) is the collapsed bridge, which this port models as
// chasmDestroyed (set by mccBearDeath). LOC 21's text and death are dfdGo's
// already -- the same "find the existing implementation and share it" move
// TASK-FR3 made with ptDeath -- so the death has ONE implementation here too.
//
// It is a code arm and not a corpus row, and that is forced rather than
// chosen: R_FISSURE_DEATH is a room record with NO exits, and nothing in
// the port kills on entering it (isForcedRoom is read only by
// darkDeathRoll's skip and dwMoveOne's dwarf filter). An
// `exit JUMP R_FISSURE_DEATH cond ...` row would therefore strand the
// player in a dead end rather than kill them. The fissure banks' own
// identical-looking rows are safe only because dfdCheckRoom kills first.
//
// Killing ahead of the travel scan is faithful for the reason
// pjPitJumpCheck's header gives: NEWLOC is LOC 21, a FORCED location, and
// 6012's `.OR.FORCED(NEWLOC)` keeps every dwarf out of one, so label 71's
// dwarf block cannot fire for this move either.
//
// Only the SW bank has the death row. LOC 122's `122 596 39` is already an
// ordinary corpus row (`exit JUMP none msg FISSURE_JUMP`, TASK-FR2 step 3),
// and the NE bank has no death row at all -- only the SW side overlooks the
// collapsed chasm.
pjChasmJump,                  // AC == R_CHASM_SW (skip): the SW bank
    lac chasmDestroyed
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dmSetup               // AC == 0 (no skip): the bridge still stands -- the ordinary
                              //   scan reaches row 729's `exit JUMP none msg FISSURE_JUMP`
    jmp dfdGo                 // AC != 0 (skip): row 728 -- "YOU DIDN'T MAKE IT." and death
dfdCheckRoom,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_FISSURE_EAST
    jmp dfdCheckBridge        // AC == R_FISSURE_EAST (no skip): east bank
    SKIP_NEXT_IF_SAME [R_FISSURE_WEST       // skip when AC == R_FISSURE_WEST (west bank) -- also counts
    jmp dmSetup                 // differs from both (no skip): not at either bank -- ordinary scan
dfdCheckBridge,                // east bank, or (falling through) west bank
    lac fissureNoBridge
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dmSetup               // AC == 0 (no skip): bridge present -- ordinary scan handles it.
                                 // FORWARD's own row now CROSSES with the bridge up
                                 // (TASK-FR24): adven.dat `17 412021 7` fails its
                                 // PROP(12).NE.1 test once the bridge is there and falls
                                 // through, past `17 412597`, to `17 27 41` -- LOC 27.
                                 // JUMP with the bridge up still stops at its own row's
                                 // msg_FISSURE_JUMP (msg 96).
dfdGo,                         // AC != 0 (skip): no bridge -- the fatal fall
    lac [msg_FISSURE_DEATH_LONG:1]
    jda pmsg
    jmp playerDied

// mccCheckRoom -- curDir == DIR_OVER; confirm curRoom is one of
// the two chasm banks before doing anything special.
mccCheckRoom,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_CHASM_SW
    jmp mccGotRoom            // AC == R_CHASM_SW (no skip): SW bank
    SKIP_NEXT_IF_SAME [R_CHASM_NE           // skip when AC == R_CHASM_NE (NE bank) -- also counts
    jmp dmSetup                  // differs from both (no skip): not at either bank --
                                    // OVER isn't special anywhere else, ordinary scan handles it
mccGotRoom,                      // SW bank, or (falling through) NE bank 
    lac chasmDestroyed
    SKIP_NEXT_IF_AC_NOT_ZERO                     // skip if AC != 0, chasm permanently destroyed
    jmp mccCheckTrollGone         // branch 1 (AC == 0, no skip): chasm intact -- check the troll
mccChasmGone,                       // branch 2 (AC != 0, skip): permanently destroyed -- msg 161,
                                        // every attempt, forever (mccBearDeath below is the only
                                        // way this gets set; see its own comment on reachability)
    lac [msg_CHASM_NO_LONGER:1]
    jmp moveStayT             // motion that stays put -- still rolls (TASK-FR22)
mccCheckTrollGone,
    lac trollGone
    SKIP_NEXT_IF_AC_NOT_ZERO                     // skip if AC != 0 (trollGone nonzero -- troll gone, paid or bypassed)
    jmp mccPresent              // branch 1 (AC == 0, no skip): troll still present -- blocked
mccCheckBypass,                  // branch 2 (AC != 0, skip): troll gone
    lac trollBypassed
    SKIP_NEXT_IF_AC_ZERO                       // skip when AC == 0 (not bypassed -- ordinary paid case)
    jmp mccFirstCrossing          // AC != 0 (no skip): bypassed -- always cross, no re-arm check
mccCheckCrossed,                    // AC == 0 (skip): not bypassed -- check the one-time re-arm
    lac trollCrossed
    SKIP_NEXT_IF_AC_NOT_ZERO                     // skip if AC != 0 (trollCrossed nonzero -- already used the crossing)
    jmp mccFirstCrossing          // AC == 0 (no skip): first free crossing since payment
mccReArm,                           // AC != 0 (skip): already crossed once -- troll steps back out
                                        // and re-arms, blocking this attempt
    lac [msg_TROLL_STEPS_OUT:1]
    jda pmsg
    dzm trollGone
    dzm trollCrossed
    jmp moveStay              // already printed; motion that stays put still
                                 // rolls the dark-death roll (TASK-FR22)
mccFirstCrossing,
    law 1
    dac trollCrossed             // harmless no-op when trollBypassed (never read again once set)
    lac OBJ_LOC(OBJ_BEAR)
    SKIP_NEXT_IF_AC_ZERO                        // skip when AC == 0 (carried) -- falls through to the fatal crossing
    jmp mccOrdinaryCross          // AC != 0 (no skip): bear not carried -- ordinary crossing
mccBearDeath,                        // AC == 0 (skip): bear carried -- the fatal crossing
    law 1
    dac chasmDestroyed
    dac bearDead
    dzm OBJ_TAKE(OBJ_BEAR)                 // immovable again, matches FIXED(BEAR)=-1
    lac [R_CHASM_SW + R_CHASM_NE
    sub curRoom
    dac OBJ_LOC(OBJ_BEAR)                   // bear ends up on the far bank, matches CALL DROP(BEAR,NEWLOC)
// CLAUDE 04-Sep-26 (TASK-FR31 N40): f4 30310's "PROP(BEAR)=3", and
// adven.dat gives the bear prop texts 0/1/2 only -- so PSPEAK(BEAR,3)
// prints nothing and the dead bear has no HERE line at all. This port
// left objHereMsg[BEAR] on whatever doFeed/doUnlock had last patched in,
// so the far bank went on announcing a contented bear wandering about
// while the wreckage line said it was dead at the bottom of the chasm.
// 0 is printObjHere's own "no HERE message for this object".
    cla
    fardac(FAR_OBJ_HEREMSG(OBJ_BEAR))
    lio [OBJ_SPICES
    eem
    jsp i [isTreasureSeen:2]
    lem
    SKIP_NEXT_IF_AC_NOT_ZERO           // skip when AC != 0 (already seen -- no change)
    jmp mccSpicesLost                    // AC == 0 (no skip): never seen -- tally2++
mccSpicesFall,                            // AC != 0 (skip): already seen -- falls through, no change
    lac [msg_BEAR_CROSSING_DEATH:1]
    jda pmsg
// CLAUDE 04-Sep-26 (TASK-FR30 N32): f4 30310 ends "OLDLC2=NEWLOC / GOTO
// 99", so this one death drops everything carried on the FAR bank -- the
// side the player had just reached when the bridge went. The port dropped
// at curRoom, the near bank, and the natural NE->SW crossing then left
// the whole load on the side the destroyed chasm had just cut off.
// Same otherBank arithmetic as mccOrdinaryCross below; jda pmsg above
// left eem off, so curRoom reads correctly here.
    lac [R_CHASM_SW + R_CHASM_NE
    sub curRoom
    jmp playerDiedAt
mccSpicesLost,
    idx tally2
    jmp mccSpicesFall
mccOrdinaryCross,
    lac [R_CHASM_SW + R_CHASM_NE  // otherBank = SW + NE - curRoom (whichever bank curRoom
    sub curRoom                      // isn't), same trick as the loadRoom-free two-location idiom
    jmp moveGo
mccPresent,
    lac [msg_TROLL_REFUSES:1]
    jmp moveStayT             // motion that stays put -- still rolls (TASK-FR22)

count, 0
ptr, 0
ix, 0
dest, 0
fieldPtr, 0
flagPtr, 0
weight, 0
    endloc

// darkDeathRoll -- adven.f4 label 2000's pit-death roll (TASK-FR22).
//
//     2000  IF(LOC.EQ.0)GOTO 99
//           ...
//           IF(FORCED(LOC).OR..NOT.DARK(0))GOTO 2001
//           IF(WZDARK.AND.PCT(35))GOTO 90
//           KK=RTEXT(16)
//     2001  ...
//     90    CALL RSPEAK(23)
//           OLDLC2=LOC
//
// Three gates, all AND-ed, and the 35% draw is taken ONLY when the first
// three pass -- which is why the draw is last here too: an extra rand18
// call would shift every later roll in the turn.
//   * WZDARK -- turnLoop's tlPrompt sets it from the room the player is
//     in when the command is READ (adven.f4 2605's WZDARK=DARK(0), whose
//     own comment at line 64 is "WZDARK SAYS WHETHER THE LOC HE'S
//     LEAVING WAS DARK"). One dark turn has to have passed already.
//   * FORCED(LOC) -- the room the move ENDED in must not be a
//     forced-motion room; the original's player never gets a turn in one.
//   * DARK(0) -- and it must be dark, checkDark's existing lamp rule.
// On a hit: msg 23 and playerDied. playerDied drops everything carried
// at curRoom, which by the time this is called IS label 90's OLDLC2=LOC
// -- the room the move ended in, not the one it started from.
//
// Called via jsp from moveGo (destination already stored in curRoom and
// loaded into ROOM_CACHE) and from moveStay (the player never left, so
// curRoom/ROOM_CACHE are already the room to test). Never returns on the
// fatal branch. Bank 0, eem off on entry and on return; clobbers AC/IO.
darkDeathRoll,
    local rtn, ddrList
    dac rtn
    lac wzdark
    SKIP_NEXT_IF_AC_NOT_ZERO   // skip when wzdark set (the room left was dark -- roll for real)
    jmp i rtn                  // wzdark clear: first dark turn -- no roll
    lio curRoom
    eem                        // bank-3 call: window open for the jsp and its return
    jsp i [isForcedRoom:3]
    lem
    SKIP_NEXT_IF_AC_ZERO       // skip when AC == 0 (not forced -- keep checking)
    jmp i rtn                  // AC != 0: forced-motion room -- f4 2000 skips the roll
    jsp checkDark
    SKIP_NEXT_IF_AC_NOT_ZERO   // skip when AC != 0 (dark and unlit -- roll for real)
    jmp i rtn                  // AC == 0: lit, or not a dark room -- no roll
    eem                     // probabilitySelector2 is bank 3 (Task 1)
    lio [ddrList]
    jsp i [probabilitySelector2:3]
    lem
    SKIP_NEXT_IF_DIFFERENT [-1]
    jmp i rtn                  // AC == -1 (no skip): missed -- survived
ddrDeath,                      // AC != -1 (skip): the roll hit -- fatal fall
    lac [msg_PIT_DEATH:1]
    jda pmsg
    jmp playerDied
rtn, 0
ddrList, 0d34                  // PCT(35): 34 in probabilitySelector2's domain
         0                     // list terminator
    endloc

wzdark, 0
briefFlag, 0
detailCnt, 0
prevRoom, 0
oldLc2, 0 
iwest, 0
foobar, 0                 // FEE FIE FOE FOO progress (f4 FOOBAR,
                          // positive fresh, negated by turnLoop's dance,
                          // transient like the rest of this block)

// ptSweep --  The pirate's two-phase treasure grab, adven.f4 lines 719-745.
//
// Phase 1 (the source's DO 6020 loop, lines 723-727) scans every object
// 0..NOBJS-1 looking for a qualifying treasure (objTreasure[ix]==1) that the
// player is *carrying* (objLoc[ix]==0). Only a carried treasure triggers a
// theft -- adven.f4:726's IF(TOTING(J))GOTO 6022 is the sole path to the
// robbery; a treasure merely lying loose in curRoom does not provoke him.
// PLATINUM is exempt while curRoom is R_PLOVER or R_DARKROOM (the pyramid
// exemption, "too easy" per the source's own comment).
//
// While scanning, phase 1 also accumulates the source's K flag -- 6020's own
// terminal statement, IF(HERE(J))K=1. For the ordinary treasures the scan
// only reaches that test once TOTING has already failed, so HERE reduces to
// "loose in curRoom". The exempt pyramid is the one exception: the source's
// GOTO 6020 lands *on* the terminal statement, so an exempt pyramid still
// counts toward K, and for it HERE keeps its carried half too, the TOTING
// test never having been reached.
//
// Phase 2 (the DO 6023 loop, lines 736-740) runs only when phase 1 found a
// carried treasure, and sweeps qualifying treasures to R_PIRATECHEST --
// carried ones unconditionally (the source's DROP(J,CHLOC)), loose ones only
// when objTake[ix] != 0, which is adven.f4:738's FIXED(J).EQ.0 guard. That
// guard matters: RUG and CHAIN are both "take no" until a specific event
// flips them, and both write sites key off the object's *original* room, so
// a still-fixed RUG or CHAIN carried off to R_PIRATECHEST could never be
// made takeable again -- a treasure lost for good and an unwinnable game.
//
// Returns AC = 1 if anything was stolen, AC = 0 if nothing was, and IO = the
// K flag: 1 if any treasure was HERE, 0 if none was at all. pirateTurn's
// TALLY-reveal fallback needs K specifically (adven.f4:728's K.EQ.0), and
// since phase 1 split "carried" off from "here" that is no longer the same
// condition as "nothing was stolen".
// No arguments. Called via jsp.
// =======================================================================
ptSweep,
    local rtn, ptr, takePtr, ix, here, treasurePtr
    dap rtn

// ---- phase 1 (adven.f4:723-727): is the player carrying a treasure? And,
// along the way, was any treasure HERE at all (the K flag)?
    law objLoc
    dac ptr
    dzm ix
    dzm here
ptScan,
    lac ix
    SKIP_NEXT_IF_DIFFERENT [NOBJS
    jmp ptNoneCarried              // ix == NOBJS (no skip): scanned every object, nothing carried
ptCheck,                             // ix != NOBJS (skip): an entry to check
    lac [objTreasure:2]             // S5 bank-0 relief: objTreasure now bank-2 resident --
    add ix
    dac treasurePtr                 // ptr-objLoc+objTreasure trick (no longer valid cross-bank)
    eem
    lac i treasurePtr
    lem
    SKIP_NEXT_IF_AC_NOT_ZERO                          // skip when AC != 0 (a treasure)
    jmp ptAdvance                    // AC == 0 (no skip): not a treasure -- next index
ptIsTreasure,                          // AC != 0 (skip): a treasure -- check the pyramid exemption
    lac ix
    SKIP_NEXT_IF_DIFFERENT [0d20                       // PLATINUM's object-table index (the 21st entry, 0-based 20)
    jmp ptCheckPyramidRoom           // AC == 20 (no skip): the platinum -- check the room
ptCheckCarried,                         // AC != 20 (skip): not the platinum -- no exemption applies
    lac i ptr
    SKIP_NEXT_IF_AC_NOT_ZERO                          // skip when AC != 0 (not carried)
    jmp ptFound                      // AC == 0 (no skip): carried -- the source's GOTO 6022,
                                         // abandon the K loop and go rob him
ptHereLoose,                           // AC != 0 (skip): not carried, so 6020's HERE(J) has already
                                           // lost its TOTING half and reduces to AT(J). AC still
                                           // holds objLoc[ix] -- sza doesn't alter it
    SKIP_NEXT_IF_SAME curRoom                         // skip when AC == curRoom (loose here)
    jmp ptAdvance                    // AC != curRoom (no skip): elsewhere -- K unchanged
ptHereSet,                             // AC == curRoom (skip), or carried-and-exempt from below
    law 1
    dac here
    jmp ptAdvance
ptCheckPyramidRoom,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_PLOVER
    jmp ptExempt                     // AC == R_PLOVER (no skip): exempt here -- skip the pyramid
    SKIP_NEXT_IF_SAME [R_DARKROOM                  // skip when AC == R_DARKROOM -- also exempt
    jmp ptCheckCarried                   // differs from both (no skip): not exempt -- proceed
ptExempt,                                   // AC == R_DARKROOM (skip): also exempt -- falls through.
                                                // The source's GOTO 6020 still executes the terminal
                                                // IF(HERE(J))K=1, and with TOTING untested HERE keeps
                                                // both halves, so test carried as well as loose here
    lac i ptr
    SKIP_NEXT_IF_AC_NOT_ZERO                          // skip when AC != 0 (not carried)
    jmp ptHereSet                    // AC == 0 (no skip): carried -- HERE(J) holds
    jmp ptHereLoose                  // AC != 0 (skip): not carried -- fall back on AT(J)
ptAdvance,                                // the shared loop-advance target for every
                                              // "nothing more to do with this index" path
    idx ptr
    idx ix
    jmp ptScan
ptNoneCarried,
    lac here
    lia                              // IO = K, the caller's TALLY-reveal gate
    cla                              // AC = 0 -- nothing stolen
    jmp rtn

// ---- phase 2 (adven.f4:736-740): he is robbing the player, so sweep every
// treasure he can lift -- carried, or loose here and not fixed in place --
// off to his hideout. Restarts the walk from index 0: phase 1 stopped at the
// first carried treasure, and the ones before it still have to be collected.
ptFound,
    law objLoc
    dac ptr
    law objTake
    dac takePtr
    dzm ix
ptSwScan,
    lac ix
    SKIP_NEXT_IF_DIFFERENT [NOBJS
    jmp ptSwDone                   // ix == NOBJS (no skip): swept every object
ptSwCheck,                           // ix != NOBJS (skip): an entry to check
    lac [objTreasure:2]
    add ix
    dac treasurePtr
    eem
    lac i treasurePtr
    lem
    SKIP_NEXT_IF_AC_NOT_ZERO                          // skip when AC != 0 (a treasure)
    jmp ptSwAdvance                  // AC == 0 (no skip): not a treasure -- next index
ptSwIsTreasure,                        // AC != 0 (skip): a treasure -- the same pyramid exemption,
                                           // restated by the source at lines 737-738
    lac ix
    SKIP_NEXT_IF_DIFFERENT [0d20
    jmp ptSwPyramidRoom              // AC == 20 (no skip): the platinum -- check the room
ptSwCarried,                            // AC != 20 (skip): not the platinum -- no exemption applies
    lac i ptr
    SKIP_NEXT_IF_AC_NOT_ZERO                          // skip when AC != 0 (not carried)
    jmp ptSwSteal                    // AC == 0 (no skip): carried -- DROP(J,CHLOC), no test needed,
                                         // an object in the player's hands is takeable by definition
ptSwLoose,                             // AC != 0 (skip): not carried -- AT(J) next. AC still holds
                                           // objLoc[ix], unaltered by sza
    SKIP_NEXT_IF_SAME curRoom                         // skip when AC == curRoom (loose here)
    jmp ptSwAdvance                  // AC != curRoom (no skip): elsewhere -- not his to take
ptSwFixedCheck,                        // AC == curRoom (skip): loose here -- adven.f4:738's
                                           // FIXED(J).EQ.0 guard. Skipping it lets him carry off a
                                           // still-"take no" RUG or CHAIN to a room where nothing
                                           // could ever make it takeable again
    lac i takePtr
    SKIP_NEXT_IF_AC_NOT_ZERO                          // skip when AC != 0 (takeable)
    jmp ptSwAdvance                  // AC == 0 (no skip): fixed in place -- he can't lift it
ptSwSteal,                              // AC != 0 (skip): takeable, or carried from above
    law R_PIRATECHEST
    dac i ptr
    jmp ptSwAdvance
ptSwPyramidRoom,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_PLOVER
    jmp ptSwAdvance                  // AC == R_PLOVER (no skip): exempt here -- leave the pyramid
    SKIP_NEXT_IF_SAME [R_DARKROOM                  // skip when AC == R_DARKROOM -- also exempt
    jmp ptSwCarried                      // differs from both (no skip): not exempt -- proceed
ptSwExempt,                                 // AC == R_DARKROOM (skip): also exempt -- falls through
    jmp ptSwAdvance
ptSwAdvance,
    idx ptr
    idx takePtr
    idx ix
    jmp ptSwScan
ptSwDone,
    law 1
    lia                              // IO = 1: the carried treasure that triggered the sweep was
                                         // itself HERE, so K would read 1 -- though the source leaves
                                         // the K loop at 6022 and never consults it on this path,
                                         // and neither does pirateTurn.
                                     // AC = 1 -- something was stolen
    jmp rtn
rtn, jmp 0
ptr, 0
takePtr, 0
ix, 0
here, 0
treasurePtr, 0
    endloc

// pirateTurn --  Per-turn hook, called from turnLoop alongside dwarfTurn/lampTurn,
// implementing the pirate's random treasure-theft mechanic re-derived from adven.f4 lines 710-751
//
// He is NOT a once-only event: TASK-FR14 item 14c (02-Sep-26) restored the
// source's real retirement rule, so he robs the player as often as the
// activation roll allows and stops only when the player has found the chest
// (or is standing in his hideout, or the cave has closed).
//
// TASK-FR32 S-7 (06-Sep-26) added the FOLLOW STATE, which is what the
// activation roll used to stand in for. adven.f4 6016 is
//     DSEEN(I)=(DSEEN(I).AND.LOC.GE.15).OR.(DLOC(I).EQ.LOC.OR.ODLOC(I).EQ.LOC)
//     IF(.NOT.DSEEN(I))GOTO 6030
//     DLOC(I)=LOC
// -- once he has spotted the player he is moved INTO the player's room
// every turn, and 6020's robbery is then a plain IF(TOTING(J)) with no
// roll at all. So a sighting is a promise: the next turn the player
// carries a treasure in dwarf territory, he is robbed. 6024 ends it --
// DLOC(6)=CHLOC, ODLOC(6)=CHLOC, DSEEN(6)=.FALSE., he goes home and has to
// find the player again.
//
// pirateSeen and piratePrevLoc are those two source variables; see their
// declaration in the save-state block for why he does not simply become a
// sixth dwarf. The flat activation roll survives as what it always should
// have been: the chance he WANDERS INTO the player's room on a turn he is
// not already following, i.e. the part of 6010-6014's random walk this port
// does not model. Before S-7 it was re-rolled even while he was standing in
// the room, which is why a rustle meant nothing.
//
// STILL NOT MODELED, and disclosed: he has no location while he is NOT
// following, so "he wandered in" stays a probability rather than a walk
// over the exit graph the way bank 1's dwMoveOne does it for the five
// dwarves. PIRATE-LOGIC-PLAN.md, cited below, is a retired document and is
// not on disk -- treat those two citations as historical.
// No argument, no return value. Called via jsp.
// =======================================================================
pirateTurn,
    local rtn, ptActivateList
    dap rtn

// ---- adven.f4:719's two "he leaves him alone" gates, in the source's own
// order: IF(LOC.EQ.CHLOC.OR.PROP(CHEST).GE.0)GOTO 6030.
//
// Until TASK-FR14 item 14c (02-Sep-26) this was one proxy gate -- "CHEST's
// objLoc has moved off CHEST_NOWHERE", i.e. the chest has ever been PLACED --
// which retired him permanently the instant he first robbed anybody. The
// source retires him only once the player has actually FOUND the chest;
// before that he robs as often as the dice allow.
ptAtHideout,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_PIRATECHEST      // skip when AC != R_PIRATECHEST
    jmp rtn                            // AC == R_PIRATECHEST (no skip): LOC.EQ.CHLOC -- he does
                                           // not rob the player inside his own hideout
ptSeenChest,                           // AC != R_PIRATECHEST (skip): PROP(CHEST).GE.0 next.
                                           // seenTab is this port's stand-in for the source's
                                           // PROP un-negation -- printObjHere marks a treasure
                                           // sighted the first time it lists it in the room, and
                                           // the entry rides along in the save record, exactly as
                                           // PROP(CHEST) would
    lio [OBJ_CHEST
    eem
    jsp i [isTreasureSeen:2]
    lem
    SKIP_NEXT_IF_AC_ZERO               // skip when AC == 0 (never sighted -- he stays active)
    jmp rtn                            // AC != 0 (no skip): the chest has been found -- retired
ptClosingCheck,                            // AC == 0 (skip): chest still unfound -- also check closing
    lac closing
    SKIP_NEXT_IF_AC_ZERO                    // skip (closing == 0) -- keep going
    jmp rtn                                    // closing != 0 (not skipped): retired -- pirate wiped
ptZoneCheck,                              // closing == 0 (skipped): falls through -- keep going
    jsp checkDwarfRoom
    lem                   // checkDwarfRoom returns with eem on
    SKIP_NEXT_IF_AC_NOT_ZERO                            // skip when AC != 0 (in dwarf territory)
    jmp ptLeftZone                     // AC == 0 (no skip): not in dwarf territory -- nothing to do,
                                           // and 6016's "DSEEN(I).AND.LOC.GE.15" drops the escort
ptForbidCheck,                            // NOTE the asymmetry with the forbidden-room check below,
                                           // which does NOT clear pirateSeen: adven.f4 657 skips the
                                           // WHOLE dwarf block for a BITSET(NEWLOC,3) room, so 6016
                                           // never runs there and DSEEN is left exactly as it was.
    jsp checkPirateForbidRoom
    lem                   // also returns with eem on
    SKIP_NEXT_IF_AC_ZERO               // skip when AC == 0 (not forbidden)
    jmp rtn                            // AC != 0 (no skip): forbidden zone -- no roll
ptRoll,                                // AC != 0 (skip): in dwarf territory -- roll for activation
// 6016 first: if he is already following, he is HERE, and there is nothing
// to roll for -- go straight to the sweep, which is 6020's DO loop.
    lac pirateSeen
    SKIP_NEXT_IF_AC_ZERO               // skip when AC == 0 (not seen -- roll for a fresh sighting)
    jmp ptSweepCall                    // AC != 0 (no skip): DSEEN(6) -- 6016's DLOC(6)=LOC, no roll
// Stand-in probability, NOT sourced -- same disclosed-approximate status as
// dwarfTurn's own rolls (PIRATE-LOGIC-PLAN.md section 1). pct=4 realizes a
// 5/100 rate (probabilitySelector2 matches when pct >= draw, inclusive, so
// pct=P is a (P+1)/100 rate).
    eem                     // probabilitySelector2 is bank 3 (Task 1)
    lio [ptActivateList]
    jsp i [probabilitySelector2:3]
    lem
    SKIP_NEXT_IF_DIFFERENT [-1]
    jmp rtn                            // AC == -1 (no skip): missed the roll -- nothing happens
    law 1                              // AC != -1: he has wandered in and spotted the player --
    dac pirateSeen                        //   DSEEN(6)=.TRUE., and he now sticks until 6024
ptSweepCall,                              // AC != -1 (skip): the roll hit -- is the player carrying
                                              // a treasure to steal? ptSweep also hands back the
                                              // source's K flag in IO, which ptNothingStolen needs
    jsp ptSweep
    SKIP_NEXT_IF_AC_NOT_ZERO                            // skip when AC != 0 (something was stolen)
    jmp ptNothingStolen                // AC == 0 (no skip): nothing carried -- TALLY fallback next
ptTheft,                                  // AC != 0 (skip): something was stolen -- announce the theft
    lac [msg_PIRATE_THEFT:1]
    jda pmsg
// adven.f4:733 -- IF(PLACE(MESSAG).EQ.0)CALL MOVE(CHEST,CHLOC). The source
// asks MESSAG, not CHEST, whether this is his first robbery, and says why in
// its own comment at line 718: by now PLACE(CHEST) could be 0 because the
// player threw the chest to the troll, so CHEST's location proves nothing.
// Post-14c this branch is live -- he robs repeatedly, and only the first
// robbery places the chest; a later one must not re-place a chest the player
// has since carried off.
    lac OBJ_LOC(OBJ_MESSAGE)
    SKIP_NEXT_IF_SAME [MESSAG_NOWHERE      // skip when AC == MESSAG_NOWHERE (never placed)
    jmp ptPlaceMessag                  // AC != MESSAG_NOWHERE (no skip): a repeat robbery --
                                           // leave the chest wherever it already is
ptPlaceChest,                          // AC == MESSAG_NOWHERE (skip): his first robbery --
                                           // CHEST appears at his hideout
    law R_PIRATECHEST
    dac OBJ_LOC(OBJ_CHEST)
ptPlaceMessag,                         // adven.f4:734's unconditional CALL MOVE(MESSAG,CHLOC2)
    law R_MAZE_D140_VEND
    dac OBJ_LOC(OBJ_MESSAGE)                  // MESSAG appears at the vending-machine dead end
    jmp ptGoHome                       // 6024: he takes the loot home and stops following

// ---- nothing carried for him to steal: adven.f4 719/727-730's TALLY-based
// fallback (see this routine's own header comment above for the full
// citation). The source's guard is K.EQ.0 -- no treasure HERE at all, which
// is a strictly stronger condition than "he stole nothing", since he only
// steals what is carried. ptSweep returns K in IO, so test that first.
ptNothingStolen,
    lai                              // AC = ptSweep's K flag
    SKIP_NEXT_IF_AC_ZERO             // skip (true: K == 0, no treasure here at all)
    jmp ptRustleCheck                   // false (not skipped): a treasure is lying here -- the
                                            // reveal can't fire, try the ambient roll instead
ptTallyCheck,                           // true (skip landed): TALLY.EQ.TALLY2+1 next (every
                                            // findable treasure but the chest found)
    lac tally
    sub [1
    SKIP_NEXT_IF_SAME tally2         // skip (true: tally-1 == tally2, i.e. TALLY==TALLY2+1)
    jmp ptRustleCheck                   // false (not skipped): fallback doesn't apply -- try the ambient roll
ptCheckMessagPlaced,                    // true (skip landed): PLACE(MESSAG).EQ.0 next. Before 14c this
                                            // was unreachable-in-practice bookkeeping kept for fidelity
                                            // (pirateTurn retired the turn after either path fired);
                                            // post-14c it is live, and it is what stops a second reveal
                                            // once a robbery has already placed MESSAG.
    lac OBJ_LOC(OBJ_MESSAGE)
    SKIP_NEXT_IF_SAME [MESSAG_NOWHERE
    jmp ptRustleCheck                   // false (already placed): fallback doesn't apply
ptCheckLampCarried,                     // true (skip landed): HERE(LAMP) next
    lac OBJ_LOC(OBJ_LAMP)
    SKIP_NEXT_IF_AC_ZERO                 // skip (true: AC == 0, carried) -- lamp confirmed HERE
    jmp ptCheckLampLoose                    // false (not carried): check whether it's loose in curRoom
ptCheckLampOn,                          // true (skip landed, or reached from ptCheckLampLoose below):
                                            // lamp is HERE -- PROP(LAMP).EQ.1 next (this project's lampOn)
    lac lampOn
    SKIP_NEXT_IF_AC_NOT_ZERO             // skip (true: AC != 0, lit)
    jmp ptRustleCheck                      // false (unlit): fallback doesn't apply
ptReveal,                               // true (skip landed): every condition held -- label 6025/6024
    lac [msg_PIRATE_TALLY_REVEAL:1]
    jda pmsg
    law R_PIRATECHEST
    dac OBJ_LOC(OBJ_CHEST)                  // same placement as ptTheft above. Unconditional here,
    law R_MAZE_D140_VEND                       // matching adven.f4:6025's own unconditional MOVE pair
    dac OBJ_LOC(OBJ_MESSAGE)                   // -- ptCheckMessagPlaced above has already established
                                               // that MESSAG is unplaced, so this IS the first time.
                                               // Post-14c the reveal does NOT retire him: the chest is
                                               // placed but not yet seen, so he keeps robbing until the
                                               // player walks into the hideout and finds it
    jmp ptGoHome                       // 6025 ends "GOTO 6024" -- same going-home step as a theft
ptCheckLampLoose,                       // AC still holds objLoc[LAMP] (not carried) -- check curRoom
    SKIP_NEXT_IF_SAME curRoom            // skip (true: AC == curRoom, loose here)
    jmp ptRustleCheck                       // false (elsewhere): lamp not here at all -- fallback fails
    jmp ptCheckLampOn                        // true (skip landed): here after all -- go check lit

// ---- ambient sighting with nothing to steal, fallback didn't fire:
// adven.f4 729's 20%-chance "faint rustling noises" flavor line (msg 127).
ptRustleCheck,
// 729's test is ODLOC(6).NE.DLOC(6) -- he only rustles on a turn he MOVED.
// While he is following, DLOC(6) is curRoom, so that reduces to "the player
// changed rooms since the last turn he was here". A player standing still
// with a following pirate hears nothing, which is the source's behavior and
// the reason this test is here rather than rolling every turn.
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT piratePrevLoc  // skip when curRoom != piratePrevLoc (he moved with us)
    jmp rtn                            // equal: ODLOC(6)==DLOC(6) -- stay silent, and no store is
                                           //   needed since the word already holds curRoom
    dac piratePrevLoc                  // 6016's ODLOC(I)=DLOC(I), for next turn's test
    eem                     // probabilitySelector2 is bank 3 (Task 1)
    lio [ptRustleList]
    jsp i [probabilitySelector2:3]
    lem
    SKIP_NEXT_IF_DIFFERENT [-1]
    jmp rtn                             // AC == -1 (no skip): missed the roll -- stay silent
    lac [msg_PIRATE_RUSTLE:1]           // AC != -1 (skip): hit -- print the ambient line
    jda pmsg
rtn, jmp 0

// ---- adven.f4:6024, reached from both payoff paths (6022's theft and
// 6025's reveal, which ends "GOTO 6024"): DLOC(6)=CHLOC / ODLOC(6)=CHLOC /
// DSEEN(6)=.FALSE.  He is back in his hideout and no longer following, so
// the next robbery needs a fresh sighting.  Storing R_PIRATECHEST rather
// than clearing keeps 729's test honest: it is a room the player is never
// robbed in (ptAtHideout returns above), so it can never read as "he did
// not move" at a real sighting.
ptGoHome,
    dzm pirateSeen
    law R_PIRATECHEST
    dac piratePrevLoc
    jmp rtn

// ---- 6016's "DSEEN(I).AND.LOC.GE.15": the escort does not survive the
// player leaving dwarf territory.  Same branch as dwMoveOne's dmoLeftZone,
// and it uses the same checkDwarfRoom test that routine does.
ptLeftZone,
    dzm pirateSeen
    jmp rtn

ptActivateList, 0d4                // probabilitySelector2 list: id unused (single-outcome test)
                0                     // list terminator
ptRustleList, 0d19                 // pct=19 -> 20/100 realized rate (probabilitySelector2's own
                                        // inclusive-match convention -- RAND-RESULTS.md's P+1 rule,
                                        // same convention ptActivateList/dtFirstList/etc. already use)
                0                     // list terminator
    endloc

// readCmd -- read one line of ascii input into cmdbuf, character by
// character via getach, null-terminating it the same way getaln.ac does.
// Returns AC = 0 on success, AC = 1 if the connection reported an error.
// Called via jsp, no argument.
readCmd,
    local rtn, isLower, ptr
    addlocal rcNoBlank
    dap rtn
// TASK-FR34 (blkLin), 04-Sep-26. This routine is the port's GETIN, and
// advn2.f4:95 opens GETIN with "IF(BLKLIN)TYPE 1 / 1 FORMAT()" -- a
// FORMAT with no data list, so one blank line, immediately before the
// read. Every read of player input in the game arrives here (turnLoop's
// prompt, askYesNo's question, readCmdFar's cross-bank callers), which is
// why this is the single site.
    lac blkLin
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rcNoBlank       // blkLin == 0 (no skip): suppressed
    newline             // blkLin != 0 (skip): the pre-read blank line
rcNoBlank,
    law cmdbuf
    dac ptr
rcloop,
    eem                     // getach is bank 3 (Task 1); the call needs eem on
    dac i [getach:3]        // jda has no indirect form -- jda composition
    jsp i [getach:3+1]
    lai                     // char out of IO BEFORE closing the window
    lem                     // back to readCmd's eem-off default
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rcloop          // branch 1 (AC == 0): stray null byte, ignore, wait for the next one
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp rcerr            // branch 1 (AC negative): getach reported a connection error

// Backspace (^H) / delete (rubout): erase the previous character in
// cmdbuf, if any. DCS2's own echo (dcfecho) already echoed the raw BS/DEL
// byte we received back to the terminal, moving the cursor left one
// column -- but most terminals treat a lone BS as "move left," not an
// erase, so we still need to echo SP BS ourselves to blank the character
// and leave the cursor back where it belongs. This has to run before the
// \r/\n and lower-case checks below: DEL (0177) is numerically >= 'a', so
// if it reached the lower-case fold first it would get silently folded
// into '_' before ever being recognized as a delete.
    SKIP_NEXT_IF_DIFFERENT [BS
    jmp rcbksp            // branch 1 (equal): backspace
                             // branch 2 (different): keep checking
rcbkck2,
    SKIP_NEXT_IF_SAME [DEL              // skip when equal (delete/rubout -- same handling as backspace)
    jmp rcck1                // differs: an ordinary character -- continue below

rcbksp,                       // equal: delete/rubout -- same handling as backspace
    lac ptr
    SKIP_NEXT_IF_DIFFERENT [cmdbuf              // nothing typed yet on this line?
    jmp rcloop             // branch 1 (equal): buffer already empty -- nothing to erase
                              // branch 2 (different): at least one character stored -- erase it.
                              // AC still holds ptr (sad never alters AC), decrement it directly
    sub [1
    dac ptr
    law SP
    lia
    tcb
    law BS
    lia
    tcb
    jmp rcloop

rcck1,
    SKIP_NEXT_IF_DIFFERENT ['\r'
    jmp rcterm           // branch 1 (equal): carriage return -- line done
                           // branch 2 (different): keep checking
rcck2,
    SKIP_NEXT_IF_DIFFERENT ['\n'
    jmp rcterm           // branch 1 (equal): linefeed -- line done

    sub ['a'            // Check for lower case, convert to upper
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO                 // skip if AC >= 0, i.e. ch >= 'a'
    jmp rcstore         // AC < 0 (ch < 'a'): already upper case or a symbol, nothing to do
isLower, add ['A'       // AC has already had the offset subtracted
    lia                 // put it back in IO for rcstore to use

rcstore,
    lac ptr
    SKIP_NEXT_IF_DIFFERENT [CMDBUF_LAST       // the last word we're willing to use (keeps one word free for the terminator)
    jmp rcloop            // branch 1 (equal): buffer is already full, discard this character
                            // branch 2 (different): room left, store it
rcspace,
    dio i ptr             // store the character (still sitting in IO, untouched since getach) at *ptr
    idx ptr
    jmp rcloop
rcterm,
    dzm i ptr
    cla
    jmp rtn
rcerr,
    law 1
rtn, jmp 0
ptr, 0
    endloc

// tokenize -- split cmdbuf into up to two space-separated tokens,
// null-terminating each in place.
// Sets verbTok to the first token's address or 0 if the line was empty and
// nounTok to the second token's address, also 0 if there wasn't one.
// Anything past a second token isignored.
// Called via jsp, no argument.
//
// DUAL-MODE callee since 05-Sep-26 (TASK-FR28 N24): `dac rtn` captures
// the full 16-bit return address and both exits are `jmp i rtn`, so
// bank 0 still calls it `jsp tokenize` and bank 3 calls it
// `jsp i [tokenize:0]`. Everything it touches -- cmdbuf, verbTok,
// nounTok, its own locals -- is bank 0, and a cross-bank caller arrives
// with the PC in bank 0, so the direct references below resolve there
// either way (the same reasoning as ulHereTest's and dwarfHereScan's).
tokenize,
    local rtn, ptr
    dac rtn
    law cmdbuf
    dac ptr
// skip leading spaces
tkskip1,
    lac i ptr
    SKIP_NEXT_IF_SAME [SP           // skip when equal (a space) -- skip it
    jmp tkadv1            // differs: found the verb, or end of line
tkskip1adv,                // equal: a space -- skip it
    idx ptr
    jmp tkskip1
tkadv1,
    lac i ptr
    SKIP_NEXT_IF_AC_ZERO
    jmp tkhaveverb     // branch 1 (nonzero): a real character -- have a verb
                         // branch 2 (zero): end of line already -- no verb
tkempty,
    dzm verbTok
    dzm nounTok
    jmp tkTwoWords
tkhaveverb,
    lac ptr
    dac verbTok
// scan to end of verb token (space or null), null-terminate it
tkverbscan,
    lac i ptr
    SKIP_NEXT_IF_AC_ZERO
    jmp tkvcheck        // branch 1 (nonzero): not yet the terminator
                          // branch 2 (zero): terminator -- verb ends here, no noun
tkvend,
    dzm nounTok
    jmp tkTwoWords
tkvcheck,
    SKIP_NEXT_IF_DIFFERENT [SP
    jmp tkvsep            // branch 1 (is a space): verb ends here
                            // branch 2 (not a space): keep scanning the verb
tkvcont,
    idx ptr
    jmp tkverbscan
tkvsep,
    dzm i ptr          // null-terminate the verb token in place of the space
    idx ptr
// skip any additional spaces before the noun
tkskip2,
    lac i ptr
    SKIP_NEXT_IF_SAME [SP            // skip when equal (a space) -- skip it
    jmp tkafter2           // differs: found the noun, or end of line
tkskip2adv,                 // equal: a space -- skip it
    idx ptr
    jmp tkskip2
tkafter2,
    lac i ptr
    SKIP_NEXT_IF_AC_ZERO
    jmp tkhavenoun      // branch 1 (nonzero): a real character -- have a noun
                          // branch 2 (zero): end of line -- no noun
tknone,
    dzm nounTok
    jmp tkTwoWords
tkhavenoun,
    lac ptr
    dac nounTok
// scan to end of noun token (space or null), null-terminate it, ignore anything after
tknounscan,
    lac i ptr
    SKIP_NEXT_IF_AC_ZERO
    jmp tkncheck         // branch 1 (nonzero): not yet the terminator
                           // branch 2 (zero): terminator -- noun already ends here
tknend,
    jmp tkTwoWords
tkncheck,
    SKIP_NEXT_IF_DIFFERENT [SP
    jmp tknsep            // branch 1 (is a space): noun ends here
                            // branch 2 (not a space): keep scanning the noun
tkncont,
    idx ptr
    jmp tknounscan
tknsep,
    dzm i ptr
// TASK-FR27 N10 (05-Sep-26). advn2.f4's GETIN counts the words itself
// and refuses a THIRD one outright -- lines 115 and 133-135, "IF(SECOND
// .EQ.3)GOTO 20" and FORMAT 21's "PLEASE STICK TO 1- AND 2-WORD
// COMMANDS." -- then GOTO 2, which is GETIN's own ACCEPT: the line is
// read again and no turn is taken, exactly as the blank line is. This
// used to stop at the noun and silently drop the rest, so `TAKE THE
// LAMP` became TAKE THE and answered SORRY, I DON'T KNOW THE WORD "THE".
// The tokens are left as they are and the caller (pgOk) does the
// printing and the re-read; all this does is say there was a third one.
    idx ptr               // step past the separator dzm i ptr just nulled
tkskip3,
    lac i ptr
    SKIP_NEXT_IF_SAME [SP           // skip when equal (a space) -- skip it
    jmp tkafter3          // differs: found a third token, or end of line
    idx ptr
    jmp tkskip3
tkafter3,
    SKIP_NEXT_IF_AC_ZERO            // skip when AC == 0 (end of line -- two words only)
    jmp tkTooMany         // AC != 0: a third token
tkTwoWords,               // the shared "one or two words" return
    cla
    jmp i rtn
tkTooMany,
    law 1
    jmp i rtn             // was a fall-through into the dap-patched `rtn, jmp 0`;
                            // the dual-mode return is a data word, so this exit
                            // has to say so (the one word this change costs)
rtn, 0
ptr, 0
    endloc

// =======================================================================
// vtScan -- scan verbTab for the vocabulary word matching the token
// whose address is in IO.
// vtPtr, which vtHit consumes) on a match; AC = 0 when the token
// matches no row (vtPtr is then spent -- do not use it). IO is
// preserved (strCmpEq preserves it). Returns with eem off.
// =======================================================================
vtScan,
    local rtn
    dap rtn
    lac [verbTab:3]

    dac vtPtr
vtsLoop,
    eem
    lac i vtPtr           // row word 0: vocab-word address (0 = end of table)
    lem                   // off again -- strCmpEq manages its own eem window
    SKIP_NEXT_IF_AC_NOT_ZERO                 // skip when AC != 0 (a real row)
    jmp rtn                // AC == 0: table exhausted -- the 0 IS the miss return
    jda strCmpEq
    lem                    // strCmpEq returns with eem on
    SKIP_NEXT_IF_AC_ZERO   // skip when AC == 0 (no match)
    jmp vtsHit             // AC != 0: this row's word matched
    lac vtPtr              // no match -- advance to the next 3-word row
    add [3
    dac vtPtr
    jmp vtsLoop
vtsHit,
    lac vtPtr              // the hit row -- nonzero (bank 3's base is 030000)
rtn, jmp 0                 // vtsHit falls in (allowed, section 5)
    endloc

// doGo -- the adven.dat 2011 filler/ verbs
// WALK/RUN/TRAVEL/GO/PROCEED/EXPLORE/GOTO/FOLLOW/TURN (adven.dat 1086-1095).
// CONTINUE, also listed under 2011 (line 1091), stays the
// existing DIR_FORWARD motion row: motion word 7 (adven.dat 873) claims
// it first in f4 VOCAB's own first-match orde, f4 2610/2800's WD1=WD2 reclassify.
doGo,
    local ptr
    lac nounTok
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when a second word was given
    jmp dgWhere                    // AC == 0: bare "GO" -- default reply
    lio nounTok
    jsp vtScan                     // is the second word a verb at all?
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when a row matched (vtPtr = the row)
    jmp dgWhere                    // AC == 0: not a verb word -- default reply
    add [2                         // -> the row's handler word
    dac ptr
    eem
    lac i ptr
    lem
    SKIP_NEXT_IF_DIFFERENT [doMove]      // the motion-class handler set:
    jmp vtHit                      // AC == doMove: dispatch the row
    SKIP_NEXT_IF_DIFFERENT [doBack]
    jmp vtHit                      // AC == doBack: dispatch
    SKIP_NEXT_IF_DIFFERENT [doLookCmd]
    jmp vtHit                      // AC == doLookCmd: dispatch
    SKIP_NEXT_IF_DIFFERENT [doCave]
    jmp vtHit                      // AC == doCave: dispatch
    SKIP_NEXT_IF_DIFFERENT [doXyzzy]
    jmp vtHit                      // AC == doXyzzy: dispatch
    SKIP_NEXT_IF_DIFFERENT [doPlugh]
    jmp vtHit                      // AC == doPlugh: dispatch
    SKIP_NEXT_IF_DIFFERENT [doPlove]
    jmp vtHit                      // AC == doPlove: dispatch
dgWhere,                           // none of the seven: not motion-class
    lac [msg_WHERE_MSG:1]
    jmp pmsgT
ptr, 0
    endloc

// enterRoom -- print curRoom's long description the first time it is
// entered, its short description on later visits, and mark it visited --
// unless checkDark says the room is dark and the player has no light, in
// which case the PITCH_DARK message is printed instead and the visited
// flag is left untouched (nothing was actually seen). jsp style.
enterRoom,
    local rtn, visPtr, erRtn
    dac rtn
    jsp printBearFollows       // adven.f4 2001, ahead of the room text on BOTH
                                  // the lit and the dark path (TASK-FR23 C23)
    jsp checkDark
    SKIP_NEXT_IF_AC_NOT_ZERO                  // skip when AC != 0 (dark, no light -- special message only)
    jmp erCheckRoom            // AC == 0: lit -- look the room up
erDark,                        // AC != 0: dark, no light -- special message only
    lac [msg_PITCH_DARK:1]
    jda pmsg
    jsp checkY2Voice
    jmp erRtn
erCheckRoom,
    lac [roomVisited:1]
    add curRoom              // base survives the arithmetic (curRoom <= NROOMS,
    sub [1                   // no carry into the bank field)
    dac visPtr               // visPtr = &roomVisited[curRoom - 1]
    eem
    lac i visPtr
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp erLong               // 0: first visit (or LOOK reset) -- long text
    SKIP_NEXT_IF_SAME [5     // skip when the counter has reached 5
    jmp erBump               // 1..4: short text, bump the counter
erFifth,                     // 5: the every-5th boundary
    law 1
    dac i visPtr             // wrap
    lac briefFlag
    SKIP_NEXT_IF_AC_ZERO          // skip when NOT brief
    jmp erShortGo            // brief: stay short forever
    jmp erLongGo             // full policy: the long text again
erBump,                      // AC still holds the counter (sas preserves it)
    add [1
    dac i visPtr
erShortGo,
    lem                      // R4: end of the bank-1 window (revisit path)
    law ROOM_CACHE + ROOMTAB_SHORT_MSG
    jmp erGo
erLong,
    law 1
    dac i visPtr
erLongGo,
    lem                      // R4: end of the bank-1 window (long path)
    law ROOM_CACHE + ROOMTAB_LONG_MSG   // long-message doublelet
erGo,
    jda pmsg
    jsp checkY2Voice          // f4 803: RSPEAK(8) at 2001, between the room text
                                 // and the 2004 object loop -- not after it
                                 // (TASK-FR25 N2)
    jsp printObjHere
    jsp printStepsHere
    jsp printShadowFigHere
    jsp printChasmTroll
    jsp printFissureBridge
    eem
    jsp i [printGrateStatus:1]  // section-13 call
    lem
    jsp checkNuggetFound
    eem
    jsp i [printPhonyPlant:1]
erRtn,                        // no lem before this: the farrtn-style
    eem                       //   eem below is the next word either way,
    jmp i rtn                 //   and a jump to erRtn always bypassed it
rtn, 0
visPtr, 0
    endloc

// doLook -- always print curRoom's long description (LOOK never touches
// the visited flag), unless checkDark says the room is dark and the
// player has no light, in which case PITCH_DARK prints instead. jsp
// style.
doLook,
    local rtn
    dap rtn
    jsp printBearFollows       // adven.f4 2001 again -- LOOK re-enters the same
                                  // description path (label 8 -> 2000)
    jsp checkDark
    SKIP_NEXT_IF_AC_NOT_ZERO                   // skip when AC != 0 (dark, no light)
    jmp dlgo                    // AC == 0: lit -- print it
dlDark,                         // AC != 0: dark, no light
    lac [msg_PITCH_DARK:1]
    jda pmsg
    jsp checkY2Voice
    jmp rtn
dlgo,
    law ROOM_CACHE + ROOMTAB_LONG_MSG
    jda pmsg
    jsp checkY2Voice          // f4 803, ahead of the object loop (TASK-FR25 N2)
    jsp printObjHere
    jsp printStepsHere
    jsp printShadowFigHere
    jsp printChasmTroll
    jsp printFissureBridge
    eem
    jsp i [printGrateStatus:1]
    lem
    jsp checkNuggetFound
    eem
    jsp i [printPhonyPlant:1]
    lem
rtn, jmp 0
    endloc

// checkY2Voice -- after any description of Y2, PCT(25) of the time "A HOLLOW VOICE SAYS "PLUGH".
// jsp style, no arguments, AC/IO clobbered.
checkY2Voice,
    local rtn, y2VoiceList
    dap rtn
    lac curRoom
    SKIP_NEXT_IF_SAME [R_Y2        // skip when standing at Y2
    jmp rtn                   // anywhere else: silent
    lac closing
    SKIP_NEXT_IF_AC_ZERO           // skip (closing == 0) -- ordinary roll below
    jmp rtn                          // closing != 0 (not skipped): suppressed -- silent
    eem                     // probabilitySelector2 is bank 3 (Task 1)
    lio [y2VoiceList]
    jsp i [probabilitySelector2:3]
    lem
    SKIP_NEXT_IF_DIFFERENT [-1]    // skip when AC != -1 (the roll hit)
    jmp rtn                   // AC == -1: missed -- silent this time
    lac [msg_PLUGH_VOICE:1]
    jda pmsg
rtn, jmp 0
y2VoiceList, 0d24             // pct=24 = exact 25/100 (PCT(25), f4 803)
    0                         // list terminator
    endloc


// =======================================================================
// playGame -- one connected session: greet, then read/parse/act commands
// until QUIT or the connection drops. jsp style.
// =======================================================================
playGame,
    local rtn, invLocPtr, invMsgPtr, invIdx, invAnyCarried, scoreCode, vtGo, demoShort
    dap rtn

    lac [msg_GREETING:1]
    jda pmsg

    jsp wizComLoad
                              // dual-mode callee returns eem-on -- its single
                              //   exit is wclRtn, "eem; jmp i rtn" -- so no
                              //   lem here and no eem on the call below
    crossBankjsp(wzStart:2, NOEEM)
    lem     // now turn eem off, the return leaves it on
    SKIP_NEXT_IF_AC_ZERO
    jmp pgGateOk               // AC != 0 (no skip): gate passed (1=normal, 2=demo) -- proceed
    dzm connOk                     // AC == 0 (skipped): hard stop -- end this connection quietly,
    jmp pgDone                       // same treatment as tlConnDrop (no score report, no room)
pgGateOk,
    sub [1]
    dac demoGame
    farjsp(wzMotdPrint:2)
    lem     // now turn eem off, the return leaves it on
    lio [msg_WELCOME_ASK:1]
    jsp askYesNo                   //   INSTRUCTIONS?"; YES also grants the
    lem                            //   1000-turn lamp instead of 330
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when YES (AC=1) -- fall through to
    jmp pgNoInstr                  //   the instructions; NO jumps past them
    lac [msg_INSTRUCTIONS:1]
    jda pmsg
    law 0d1000
    dac lampLimit
    law 1
    dac instrHinted        //   scoreGame deducts 5 for taking instructions
pgNoInstr,
    jsp enterRoom
// CLAUDE 01-Sep-26: enter the loop at tlPrompt. Since S17 (TASK-FR25,
// 04-Sep-26) turnLoop has no hook block of its own, so this is now just the
// ordinary entry; it is kept as a separate label because the blank-line path
// and playGame both need an entry that is not the top of the loop.
    jmp tlPrompt

// turnCreatures -- adven.f4's label-74 block: the dwarves move and attack,
// then the pirate. TASK-FR25 N1 (S17, 04-Sep-26).
//
// WHICH TURNS RUN IT. Only the ones that reach label 2. In the source the
// block sits between "74 LOC=NEWLOC" and 2000, and label 2 is reached by the
// motion words (including refused ones), NULL, BACK, LOOK, CAVE, and the four
// verbs that end "K=NULL / GOTO 8" -- kill the dragon (9126), pour water on
// the plant (1504), throw the axe and kill a dwarf (9175), and RESTORE
// (8305). An action verb ends at 2011/2012 and goes to 2600/GETIN without
// passing 74, so it gets no dwarf turn at all: two INVENTORYs beside a dwarf
// are two listings and nothing else.
//
// This used to run unconditionally at the top of turnLoop -- every command,
// including INVENTORY, bought a dwarf turn and could be killed by one. The
// 01-Sep-26 note that put it there had the position within the turn right
// (the dwarves act in the room the player has just arrived in, and their
// lines print BEFORE the room text, f4 74 -> 6000 -> 2000) and the set of
// turns wrong. Both properties are preserved by calling it from the motion
// tails instead: moveGo for a move that happened, moveStay for one that did
// not, and the label-2 paths that are not moves at all (LOOK, CAVE, BACK's
// two refusals, a magic word with no row).
//
// A fatal knife never returns here -- dtStickOneHit/dtStickPlural jump to
// playerDied -- so the caller's description is skipped, which is the source's
// 84 -> 99 (a killed player never reaches 2000).
//
// clockTurn/lampTurn/hintTurn are NOT part of this block: they are the
// source's separate label-2600 sequence and still run once per command from
// tlPrompt, where they always did.
//
// jsp style, dual-mode, the enterRoom convention: the return address is kept
// whole in a data word, so a bank-1 or bank-3 caller may reach it as
// `jsp i [turnCreatures:0]`, and it ALWAYS RETURNS WITH eem ON. A bank-0
// caller therefore lems after the call.
turnCreatures,
    local rtn
    dac rtn               // full 16-bit return address (dual-mode)
                           // No entry lem: whatever eem state the caller
                           //   arrives in, the eem below sets it, and the
                           //   pairs after that one manage their own.
    eem                   // S3B: dwarfTurn lives in bank 1 -- section-13
    jsp i [dwarfTurn:1]   //   callee, returns with eem on
    lem
    jsp pirateTurn        // per-turn pirate activation/theft hook. Part of the
                           //   same source block: the pirate is DLOC(6) in
                           //   adven.f4, moved and tested alongside the five
                           //   dwarves, so it belongs on this side of the turn
    eem
    jmp i rtn
rtn, 0
    endloc

turnLoop,
    lem                  // S3B: bank-1 verb handlers/hooks arrive here via an
                           // eem'd indirect jump -- normalize to eem off so
                           // every turn starts in the same extend state

tlPrompt,                // CLAUDE 01-Sep-26: post-hook re-entry point
    lem                  //   the blank-line path below skips turnLoop's own
                           //   lem, so normalize the extend state here too

// adven.f4 856-860, the whole head of the label-2600 block, in the
// source's own order and under the source's own single CLOSED gate:
//
//     IF(.NOT.CLOSED)GOTO 2605
//     IF(PROP(OYSTER).LT.0.AND.TOTING(OYSTER))
//    1    CALL PSPEAK(OYSTER,1)
//     DO 2604 I=1,100
// 2604 IF(TOTING(I).AND.PROP(I).LT.0)PROP(I)=-1-PROP(I)
//
// It runs HERE -- after the previous command's reply, ahead of 2605's
// WZDARK=DARK(0) and of GETIN -- so the oyster's line prints under the
// "OK" of the take that earned it, not under the next command's reply.
//
// TASK-FR15 15a (06-Sep-26; the owner ruled for the faithful repair over
// the narrow one). 860 is a per-turn sweep over EVERYTHING CARRIED, not
// an action taken when a particular object is named. The port used to
// clear one flag inside dtDoTakeGo, keyed on the object the player typed;
// those two agree for every object taken by name and disagree for any
// object that arrives in the player's hands some other way. adven.f4
// 9014's bird/cage bundling is exactly such a route -- TAKE CAGE carried
// the bird and left repoHiddenBird set, so the dropped bird was never
// listed in the repository. dtDoTakeGo's ten per-site clears are gone
// with this change, and so is oysterNagPending: 857-858's own test, run
// once a turn against the flag the sweep is about to clear, IS the
// one-shot the port was arming by hand.
//
// PROP(I).LT.0 is repoHidden*, TOTING(I) is objLoc[obj] == 0. Only the
// ten repository objects ever carry a negative prop -- closedTransport's
// PUT list is the only thing that makes one negative -- so the source's
// 1..100 is this port's ten, listed in rsRepoTab.
//
// All bank-0-local: closed, objLoc and the ten flags all live here, so no
// eem window is needed and the lem above still stands.
    lac closed
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when AC != 0 (cave closed): 857-860 apply
    jmp tlRepoSweepDone              // AC == 0 (no skip): 856's GOTO 2605
// 857-858. The sweep below clears repoHiddenOyster on this same pass,
// which is what makes the line print exactly once.
    lac repoHiddenOyster
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when AC != 0: PROP(OYSTER).LT.0
    jmp tlRepoSweep                  // AC == 0 (no skip): already un-hidden -- nothing to say
    lac OBJ_LOC(OBJ_OYSTER)
    SKIP_NEXT_IF_AC_ZERO           // skip when AC == 0: TOTING(OYSTER)
    jmp tlRepoSweep                  // AC != 0 (no skip): not carried -- nothing to say
    lac [msg_OYSTER_WRITING:1]
    jda pmsg                         // bank-0 print-and-continue; returns with eem off
// 859-860's DO 2604. rsRepoTab is ten {objLoc slot, repoHidden flag}
// PAIRS, each naming its own flag by symbol -- deliberately NOT a single
// table walked in parallel with the flags' memory order, which would pair
// the wrong flag with the wrong object, silently, the day anyone declares
// a var inside that block. The walk ends on the table's own end label, so
// there is no counted literal to go stale either.
tlRepoSweep,
    law rsRepoTab
    dac rsTabP
tlrsLoop,
    lac i rsTabP                     // pair word 0: this object's objLoc slot address
    dac rsObjP
    idx rsTabP
    lac i rsTabP                     // pair word 1: its repoHidden flag's address
    dac rsFlagP
    idx rsTabP
    lac i rsObjP                     // ...then the cell (rule 4)
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when AC != 0 (not carried -- stays hidden)
    dzm i rsFlagP                    // AC == 0 (no skip): TOTING -- un-hide it
    lac rsTabP
    SKIP_NEXT_IF_SAME [rsRepoTabEnd  // skip when the walk has reached the end
    jmp tlrsLoop                     // not yet (no skip): next pair
tlRepoSweepDone,

    jsp checkDark
    dac wzdark
    lac knfloc
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE   // skip when knfloc <= 0 -- nothing to clear
    jmp knflocCheckRoom                 // knfloc > 0 (no skip): check whether the room changed
    jmp knflocClearDone                 // knfloc <= 0 (skip): nothing to clear
knflocCheckRoom,
    lac knfloc
    SKIP_NEXT_IF_SAME curRoom           // skip when knfloc == curRoom -- still the same room
    jmp knflocClear                      // differs (no skip): the player has left -- clear it
    jmp knflocClearDone
knflocClear,
    dzm knfloc
knflocClearDone,

    eem
    jsp i [hintTurn:2]
    lem

    jsp readCmd
    SKIP_NEXT_IF_AC_ZERO
    jmp tlConnDrop      // branch 1 (nonzero): readCmd reported an error -- connection dropped
                         // branch 2 (zero, skipped): success, falls through to pgOk
pgOk,
    newline              // the client's echo of what was typed has no line ending of its own -- start fresh
    jsp tokenize
// TASK-FR27 N10: a third word is refused before anything else looks at
// the line, which is where GETIN refuses it. tlPrompt, not turnLoop, for
// the same reason the blank line below uses it: advn2.f4's GOTO 2 re-runs
// the ACCEPT and nothing else, so no turn is taken.
    SKIP_NEXT_IF_AC_NOT_ZERO                // skip when AC != 0 (a third word)
    jmp tlWordCountOk        // AC == 0: one or two words, carry on
    lac [msg_STICK_TO_TWO_WORDS:1]
    jda pmsg
    jmp tlPrompt
// TASK-FR28 N24 (group S23 batch 2, 05-Sep-26). adven.f4 1468's
// "IF(WD1.NE.'Y'.AND.WD1.NE.'YES')GOTO 2608" -- the line the player
// typed at the dragon is not thrown away, it is EXECUTED as the next
// command. 2608 is the label immediately after 2605's GETIN, so the
// port's equivalent entry is immediately after readCmd's own tokenize:
// pgOk's echo-newline and the word count already ran inside daCheckYes
// (bank 3), which is where the line was read. One word; every bank-3
// arrival is an eem'd indirect jump, and turnLoop/tlConnDrop normalize
// the extend state the same way.
tlResumeLine,
    lem
tlWordCountOk,

    lac verbTok
    SKIP_NEXT_IF_AC_NOT_ZERO                // skip when AC != 0 (have a verb)
    jmp tlPrompt             // AC == 0: blank line, just prompt again
                             //   (CLAUDE 01-Sep-26: tlPrompt, not turnLoop --
                             //   a blank line must not run another dwarf turn)
havVerb,                     // AC != 0: have a verb

// TASK-FR27 N8 (05-Sep-26): adven.f4's VERB and OBJ, and the only three
// places that let them outlive a command.
//
//   2012  VERB=0 ; OBJ=0          -- every completed turn
//   8000  OBJ=0, VERB kept        -- "<verb> WHAT?"
//   5015  OBJ kept, VERB kept (0) -- "WHAT DO YOU WANT TO DO WITH THE x?"
//   3000  both kept               -- SORRY, I DON'T KNOW THE WORD "x".
//
// so the next command can finish the last one: 4000's "IF(OBJ.NE.0)GOTO
// 4090" and 5010's "IF(VERB.NE.0)GOTO 4090". The port had no state at
// all -- all three replies ended at turnLoop and the next line was parsed
// from scratch.
//
// keepVerb/keepObj are what THIS command leaves behind; parseVerb/parseObj
// are what it inherits. Promoting here, in one place, is what makes 2012
// free: a turn that ends any other way arms nothing, so the pair is
// already clear when the next command promotes it. Above the blank-line
// and third-word paths deliberately -- neither is a command, and GETIN
// re-reads without touching VERB or OBJ.
    lac keepVerb
    dac parseVerb
    dzm keepVerb
    lac keepObj
    dac parseObj
    dzm keepObj

    lac turns
    SKIP_NEXT_IF_AC_ZERO
    jmp tlSkipMagicCheck          // turns != 0 (not skipped, false): not the
                                      // first command -- skip the whole check
    lio verbTok                         // turns == 0 (skipped, true): fallthrough
    lac [magicModeWord1:2]
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tlSkipMagicCheck          // verbTok != "MAGIC" (false): skip
    lac nounTok                       // verbTok == "MAGIC" (true): fallthrough
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tlSkipMagicCheck          // no second word (false): can't be "MODE" -- skip
    lio nounTok                       // has a second word (true): fallthrough -- check it
    lac [magicModeWord2:2]
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tlSkipMagicCheck          // nounTok != "MODE" (false): skip
                                      // nounTok == "MODE" (true): fallthrough -- this
                                         // IS "MAGIC MODE" -- enter MAINT
    farjsp(wzMaint:2)               // wzMaint's single exit is wmDone's farrtn, so it
                                        //   returns eem-on -- no lem here, and the read
                                        //   below needs no eem of its own
    crossBanklac(wzMaintResult:2, EEMCLOSE)   // bank-2 field, bare lac can't reach it --
                                                  // same pattern as wizComLoad's farlac(wcValid:2)
    SKIP_NEXT_IF_AC_ZERO
    jmp tlMagicEndConnection      // wzMaintResult != 0 (not skipped, false):
                                      // wizard finished the dialogue and saved --
                                      // end this connection, same treatment as
                                      // wzStart's own hard-stop path
    jmp tlSkipMagicCheck              // wzMaintResult == 0 (skipped, true): not
                                          // a wizard -- continue normal play
tlMagicEndConnection,
    dzm connOk
    jmp pgDone
tlSkipMagicCheck,
// CLAUDE 01-Sep-26: adven.f4:2608's "TURNS=TURNS+1", which had no counterpart
// here at all -- nothing but newGame's "dzm turns" ever wrote the variable, so
// it sat at 0 for a whole session. Three things were broken by that: the score
// report's turn count always printed 0, the demo timeout below (turns >=
// wcShort) could never fire, and the "turns == 0" gate on MAGIC MODE above was
// open on EVERY command instead of only the first. Placed exactly where the
// source puts it: after the MAGIC MODE test (which needs the pre-increment
// value, i.e. 0 on the first command) and before the demo-timeout test (which
// needs the post-increment value). idx clobbers AC, which is dead here -- the
// lac below is the next read.
    idx turns
    lac demoGame
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tlDemoCheckDone        // demoGame == 0 (not skipped, false): not a demo connection -- skip
                                   // demoGame != 0 (skipped, true): fall through
    farlac(wcShort:2)
    dac demoShort
    lac turns
    sub demoShort
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp tlDemoTimeout            // turns - wcShort >= 0, i.e. turns >= wcShort (no skip): hit it
    jmp tlDemoCheckDone        // turns - wcShort < 0, i.e. turns < wcShort (skipped): not yet
tlDemoTimeout,
// adven.f4 1973-1975 (label 13000): CALL MSPEAK(1); GAVEUP=.TRUE.;
// GOTO 20000 -- same law-1/dac-gaveUp/pmsgD idiom as doQuit's own yes-path
// (this is the fourth gaveUp site, see its own var comment above).
    law 1
    dac gaveUp
    lac [msg_DEMO_TIMEOUT:1]
    jmp pmsgD                    // print + pgDone (score/report/connection end) == GOTO 20000
tlDemoCheckDone,

// f4 2608: the foobar dance, once per command -- a fresh
// (positive) FEE/FIE/FOE step is armed (negated) so doFoo can test
// "previous word's k" as 1-k; an armed step that survived a whole
// turn means a word was skipped, so progress resets. The zero case is
// left strictly alone (cma of +0 would make -0, and the sequence test
// compares bit patterns).
    lac foobar
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when a sequence is in flight
    jmp tlFoobarDone          // 0: nothing going on
    SKIP_NEXT_IF_AC_NEGATIVE       // skip when negative (armed last turn)
    jmp tlFoobarArm           // positive: freshly said -- arm it
    dzm foobar                // negative: he skipped a word -- start over
    jmp tlFoobarDone
tlFoobarArm,
    cma
    dac foobar
tlFoobarDone,

// TASK-FR27 N9 (05-Sep-26). adven.f4 2609, in its own place -- after the
// foobar dance and BEFORE the clock and lamp countdowns, which a pending
// SAY skips outright:
//
//   2609 IF(VERB.EQ.SAY.AND.WD2.NE.0)VERB=0
//        IF(VERB.EQ.SAY)GOTO 4090
//
// A bare SAY is 4080 index 3, which is 8000 -- "SAY WHAT?" -- and 8000
// keeps VERB, so the NEXT one-word line is 9030's WD2==0 arm: the word is
// echoed and NOT executed, unless it is one of 9030's four magic codes.
// A two-word line cancels the pending SAY and parses normally. The port
// answered `OKAY, "SAY".` to the bare word and then moved on NORTH.
//
// nounTok carries WD1 into doSay because 9030 with WD2 == 0 uses WD1 for
// both the echo and the vocabulary lookup, and doSay reads nounTok for
// both. gateVerb is set for the same reason vtHit sets it: whatever doSay
// reaches must find f4's VERB there.
    lac parseVerb
    SKIP_NEXT_IF_SAME [doSay]      // skip when a SAY is pending
    jmp tlSayDone
    lac nounTok
    SKIP_NEXT_IF_AC_ZERO           // skip when AC == 0 (a one-word line)
    jmp tlSayCancel                // AC != 0: two words -- VERB=0, parse it normally
    lac verbTok
    dac nounTok
    lac [doSay]
    dac gateVerb
    jmp doSay                      // f4 2609's GOTO 4090, index 3 -> 9030
tlSayCancel,
    dzm parseVerb
tlSayDone,

// CLAUDE 01-Sep-26: only clockTurn/lampTurn are left here. dwarfTurn and
// pirateTurn moved to the top of turnLoop -- see the comment there. The clock
// and the lamp countdown are adven.f4's label-2600 block, which runs between
// the room description and the command read, so this slot is already the
// right one for them and their per-turn accounting is unchanged.
    eem                   // S3B: lampTurn lives in bank 1, clockTurn in bank 2 --
    jsp i [clockTurn:2]   //   one shared window; both are section-13 callees
    jsp i [lampTurn:1]    //   returning with eem on
    lem

    lac nounTok
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when a second word exists
    jmp tlNoTransform
    lio verbTok
    lac [voc_water:2
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_ZERO
    jmp tlLiquidVerb
    lac [voc_oil:2
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_ZERO
    jmp tlLiquidVerb
    lac [voc_enter:2
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_ZERO
    jmp tlEnterVerb
    jmp tlNoTransform
tlLiquidVerb,
    lio nounTok
    lac [voc_plant:2
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_ZERO
    jmp tlCheckPlant
    lac [voc_door:2
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_ZERO
    jmp tlCheckDoor
    jmp tlNoTransform
tlCheckPlant,
    lac OBJ_LOC(OBJ_PLANT)
    SKIP_NEXT_IF_SAME curRoom      // skip when the plant is here (f4 AT())
    jmp tlNoTransform
    jmp tlPour
tlCheckDoor,
    lac OBJ_LOC(OBJ_DOOR)
    SKIP_NEXT_IF_SAME curRoom
    jmp tlNoTransform
// TASK-FR28 N28 (S19, 05-Sep-26). adven.f4 2600 rewrites the SECOND word
// ("IF(AT(VOCAB(WD2,1)))WD2='POUR'") and leaves WD1 alone, so the liquid
// is still the first word when 2630 classifies it: class 2 -> 5000, where
// 5120's rescue decides whether that liquid is here at all, and only then
// does 5010's WD2 test shift POUR into WD1 and reach 9130 with OBJ set.
// This jumped straight into the handler, so `WATER PLANT` with no bottle
// answered doPour's own "YOU AREN'T CARRYING IT!" where the source says
// "I SEE NO WATER HERE." Re-entering vtDispatch with the two tokens in
// the source's post-2800 order runs the whole of that path.
tlPour,
    lac verbTok               // the liquid word becomes the noun (f4's OBJ)
    dac nounTok
    lac [doPour               // f4's VERB, once 5010's WD2 test has shifted
    lia                       //   POUR into WD1: the gate's only argument, in IO,
                              //   exactly as vtHit hands it over
    jsp objPresenceGate       // f4 5000-5190 on the liquid, 5120's rescue included
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (the liquid is here)
    jmp seeNoNoun             // AC != 0: f4 5199, "I SEE NO WATER HERE."
    jmp doPour
tlEnterVerb,
    lio nounTok
    lac [voc_water:2
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_ZERO
    jmp tlWetFeet
    lac [voc_stream:2
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_ZERO
    jmp tlWetFeet
// TASK-FR27 N7 (05-Sep-26). adven.f4 19999's SECOND ENTER line, the one
// this port never had:
//
//   IF(WD1.EQ.'ENTER'.AND.(WD2.EQ.'STREA'.OR.WD2.EQ.'WATER'))GOTO 2010
//   IF(WD1.EQ.'ENTER'.AND.WD2.NE.0)GOTO 2800
//
// so ENTER with ANY other second word is that word alone. Without it the
// pair fell through to the verb table, where ENTER is aliased onto DIR_IN
// (see adventure.adv's own note on motion 3) and the second word was
// dropped unread: `ENTER FOREST` at the End of Road walked into the well
// house, and `ENTER BUILDING` on the hill answered msg 11 where the
// source walks back down to the road.
//
// This is 2800 exactly as pgSecondVerb does it -- WD1 = WD2, WD2 = 0,
// then 2610/2630, which vtDispatch is. The transform block above is only
// entered when nounTok is non-zero, so f4's "WD2.NE.0" is already true.
    lac nounTok
    dac verbTok
    dzm nounTok
    jmp vtDispatch

// TASK-FR20 C10 (03-Sep-26): adven.f4 2600 rewrites ENTER WATER / ENTER
// STREAM into label 2010, which is "SPK=70 (feet wet) if LIQLOC(LOC) is
// water, SPK=43 (WHERE?) otherwise". The hook was here and correct; the
// water test was a bare R_BUILDING compare, so the End of Road -- whose
// own room text is about the stream flowing out of the building -- got
// WHERE?. liquidAtRoom is LIQLOC; 1 is water, and only water counts (the
// oil pit gives WHERE?, since the source's test is LIQLOC.EQ.WATER).
tlWetFeet,
    jsp liquidAtRoom          // bank-0 resident, same bank -- AC = 0, 1 (water) or 2 (oil)
    SKIP_NEXT_IF_DIFFERENT [1
    jmp tlWet                 // AC == 1 (no skip): water here -- wet feet
    lac [msg_WHERE_MSG:1]     // AC != 1 (skip): dry, or the oil pit
    jmp pmsgT
tlWet,
    lac [msg_WET_FEET:1]
    jmp pmsgT
tlNoTransform,

// ---- verb dispatch -------------------------------------------------------
// Table-driven (see the "Verb table" section near the end of this file):
// one 3-word row per vocabulary word -- vocab-word address, argument,
// handler address -- scanned in row order (row order = match precedence,
// preserved from the old compare chain). On a match the argument word is
// stored into curDir unconditionally (it holds a DIR_* code on movement
// rows, 0 everywhere else -- non-movement handlers never read curDir), and
// control dispatches through the handler address via the same dap-patched
// jmp idiom every subroutine return already uses. The old goDir stub is
// gone: movement rows name doMove as their handler directly, and the
// argument column carries what used to be goDir's AC argument.
// vtDispatch -- adven.f4 2630's word-classification entry. verbTok holds
// the word to classify and nounTok the (possibly empty) one after it.
// Reached three ways: by falling through from tlNoTransform on an ordinary
// turn, and by the source's own two re-entries within a single turn --
// 2800 (objPresenceGate's pgSecondVerb, TASK-FR19 C8) and 9035 (doSay's
// magic words, C9), both of which shift WD2 into WD1 and clear WD2 first.
vtDispatch,
    lem                   // 9035 arrives from bank 3 through an eem'd
                            // indirect jump; the other two entries are
                            // already off, so this is a no-op for them
    lio verbTok           // verb token in IO for vtScan/strCmpEq (S3B) --
                            // loaded once: strCmpEq preserves IO
    jsp vtScan
    SKIP_NEXT_IF_AC_NOT_ZERO   // skip when a row matched (vtPtr = the row)
    jmp unknownVerb        // AC == 0: not a verb we know -- word analysis
vtHit,                     // AC != 0: dispatch the matched row
    eem
    lac i vtPtr           // row word 0 again: WHICH vocabulary word matched
    SKIP_NEXT_IF_DIFFERENT [voc_west:2]
    jmp vtWest
vtAfterWest,
    idx vtPtr             // -> row word 1: the argument
    lac i vtPtr
    dac curDir             // DIR_* on movement rows, 0 otherwise (see header)
    idx vtPtr              // -> row word 2: the handler address
    lac i vtPtr            // a bank-0 12-bit handler address, plain data
    lem                   // BEFORE the dispatch -- handlers keep their
                            // current eem-off entry state (R3b spec)
    dap vtGo                // patch it into the dispatch jmp below
    lia                     // IO = that same handler address, objPresenceGate's
                            //   only argument (dap left AC untouched)
    jsp objPresenceGate     // TASK-FR18: adven.f4 5000-5190, the noun-presence
                            //   test the port never had. Sits here because this
                            //   is the port's only "verb known, noun in hand,
                            //   about to dispatch" point, which is exactly what
                            //   f4 reaches via 4000 -> 2800 -> 2630 -> 5000.
    SKIP_NEXT_IF_AC_ZERO    // skip when AC == 0 (present, or not a gated class)
    jmp seeNoNoun           // AC != 0: f4 5199, "I SEE NO <noun> HERE."
vtGo, jmp 0                  // dispatch (never runs unpatched)

vtWest,
    lem
    idx iwest
    lac iwest
    SKIP_NEXT_IF_SAME [0d10        // skip on exactly the 10th
    jmp vtWestBack
    lac [msg_IWEST_JOKE:1]
    jda pmsg
vtWestBack,
    eem
    jmp vtAfterWest

// unknownVerb -- adven.f4 2630's remaining two classes. vtScan has just
// ruled out the three that verbTab carries (1 motion, 3 action, 4
// message), so the word in verbTok is either an object word, which the
// source sends to 5000, or nothing this port knows, which is 3000.
//
// TASK-FR27 N12 (S19, 05-Sep-26). This used to make its own presence
// test -- a single objLoc compare -- so none of 5100's rescues reached a
// FIRST word: bare WATER at a water room and TROLL at either chasm bank
// answered "I SEE NO ... HERE.", DWARF and KNIFE answered "I DON'T KNOW
// THE WORD", and the grate reroute (TASK-FR19 C12) was missing here as
// well as in the gate. The whole analysis is objHere5000 now, shared
// with objPresenceGate, which is where the source keeps it: one block at
// 5000, entered with VERB set or with VERB still 0.
unknownVerb,
    lac verbTok
    dac gateTok               // f4's WD1
// TASK-FR27 N8: f4's VERB, which is 0 on an ordinary turn but is the verb
// a previous "<verb> WHAT?" left pending. 5000 and 5190 both read it, so
// it has to be here and not zeroed as it used to be -- `FIND` / `LAMP`
// with the lamp elsewhere is 5190's own FIND exception, reached from THIS
// path, not from the gate's.
    lac parseVerb
    dac gateVerb
    jsp objHere5000
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (absent, or no such word)
    jmp uvWhatDo              // AC == 0: present -- f4 5010
    SKIP_NEXT_IF_DIFFERENT [0d2
    jmp uvNotObject           // AC == 2 (no skip): no such word at all -- f4 3000
// AC == 1 (skip): known, absent -- f4 5190, which has the same two
// exceptions here as it does in pgRefuse. The WD2 half of its test is
// live on this path (pgRefuse's caller has already cleared WD2 at 2800;
// this one has not), so `LAMP FROB` with the lamp elsewhere still says
// I SEE NO LAMP HERE.
uvAbsent,
    lac nounTok
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (WD2 is 0)
    jmp uvSeeNo               // AC != 0: a second word -- no exception
    lac gateVerb
    SKIP_NEXT_IF_DIFFERENT [doFind]
    jmp uvWhatDo              // 5190's "GOTO 5010"
    SKIP_NEXT_IF_DIFFERENT [doInventory]
    jmp uvWhatDo
    jmp uvSeeNo
// f4 5010:
//
//     5010 IF(WD2.NE.0)GOTO 2800
//          IF(VERB.NE.0)GOTO 4090
//          ... "WHAT DO YOU WANT TO DO WITH THE <WD1>?"
//
// 2800 shifts WD2 into WD1 and clears WD2 but leaves OBJ set, and this
// port's carrier for OBJ is nounTok, so the two arms differ. A second
// word that IS in verbTab dispatches with the object still in nounTok --
// f4 4000's "IF(OBJ.NE.0)GOTO 4090", which is what makes `KEYS DROP`
// drop the keys. A second word that is NOT goes back through this same
// analysis as the new WD1 with WD2 cleared, which is 2630's class-2/-1
// split over again; before N12 that arm answered about the FIRST word,
// so `KEYS LAMP` asked about the keys and `KEYS FROB` never reported
// FROB unknown.
uvWhatDo,
    lac nounTok
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when a second word was given
    jmp uvPendingVerb              // AC == 0: no second word -- 5010's VERB test
    lio nounTok
    jsp vtScan                     // is word 2 in verbTab (class 1, 3 or 4)?
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when it matched a row (vtPtr = row)
    jmp uvSecondNoun               // AC == 0: class 2 or -1 -- 2800, then 2630
    lac verbTok                    // NOUN VERB confirmed: swap the tokens
    lio nounTok
    dac nounTok                    // nounTok = the object word (f4's OBJ)
    dio verbTok                    // verbTok = the verb word (f4's WD1 after 2800)
    jmp vtHit                      // dispatch the row vtScan just matched
uvSecondNoun,                      // f4 2800 with a new WD1 that verbTab does not have
    lac nounTok
    dac verbTok                    // WD1 = WD2 ...
    dzm nounTok                    //   ... WD2 = 0
    jmp unknownVerb                // 2630 again: class 2 -> 5000, -1 -> 3000
// TASK-FR27 N8: 5010's second line, "IF(VERB.NE.0)GOTO 4090". VERB is
// non-zero only when a previous command's 8000 left one pending, and it
// is already in gateVerb (unknownVerb put it there), so the object word
// becomes this verb's noun and the verb runs. `DROP` / `KEYS` drops the
// keys; `TAKE FROB` / `LAMP` takes the lamp.
//
// No second trip through the gate: 4090 is the handler itself, and the
// analysis at 5000 that got here IS the gate's own, run a moment ago with
// this same VERB. curDir is not restored -- f4 re-derives FOO's k at 8250
// and no other action verb reads it, and none of 4080's 8000 entries is a
// FEE/FIE/FOE/FOO/FUM row, so a pending verb can never be one.
uvPendingVerb,
    lac parseVerb
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when AC != 0 (a verb is pending)
    jmp uvWhatDoMsg                // AC == 0: f4 5015
    lac verbTok                    // f4's OBJ: the word just analysed
    dac nounTok
    lac parseVerb
    dap uvGo
uvGo, jmp 0                        // 4090 (never runs unpatched)
uvWhatDoMsg,
    lio parseObj                   // f4 5015 keeps OBJ (=K, set at 5000) and
    eem                            //   VERB, which is already 0 on every path
    jsp i [keepParse:3]            //   that reaches here
    lio verbTok                    // eem stays on: bank-0 symbols carry their
    jmp i [pWhatDo:1]              //   own extend bits (see unknownNoun)
uvSeeNo,
    lio verbTok
    eem
    jmp i [pSeeNo:1]
uvNotObject,
    lio parseObj              // f4 3000 falls to 2600, not 2012: both survive
    eem
    jsp i [keepParseBoth:3]
    lio verbTok
    jmp i [pUnknownWord:1]

// Shared noun-reply stubs (never return; token in IO for the tails:
unknownNoun,              // the NOUN word isn't in the object table (f4 3000)
    lio nounTok
    lac [voc_knife:2
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when AC != 0 (matched KNIFE)
    jmp unCheckKnive               // no match -- try KNIVE
    jmp unKnifeWord
unCheckKnive,
    lio nounTok
    lac [voc_knive:2
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when AC != 0 (matched KNIVE)
    jmp unOrdinary                 // AC == 0 (no skip): neither KNIFE nor KNIVE -- ordinary reply
unKnifeWord,
    lac knfloc
    SKIP_NEXT_IF_SAME curRoom      // skip when knfloc == curRoom -- a knife really is here
    jmp unOrdinary                 // not here (0, or retired at -1) -- ordinary unknown-word reply
// f4 983's KNFLOC=-1, and the -1 is load-bearing: adven.dat's own
// variable note is "0 IF NO KNIFE HERE, LOC IF KNIFE HERE, -1 AFTER
// CAVEAT", and line 756 re-arms the caveat only `IF(KNFLOC.GE.0)`, so
// the negative value is what retires it for the rest of the game.
//
// This was `law -1`, which does not do that. `law -n` is not valid at
// all: law takes a 12-bit value, and a negative operand folds an 18-bit
// negative into the instruction word -- `law -1` assembles as 0o677777,
// which is not a law. knfloc came out positive, dtKnflocDone's
// `SKIP_NEXT_IF_AC_NOT_NEGATIVE` guard could never fire, and knflocClear
// then reset it to 0 on the next turn -- so the "knives vanish" caveat
// re-armed on every later dwarf attack instead of printing once per
// game. Found while moving 5130 into the gate (TASK-FR7 7c); the guard
// site was already correct and only ever needed a genuinely negative
// value to test.
    law i 1                        // AC = -1 (0o777776): the indirect bit
                                   // means "load with negative n", the
                                   // 12-bit operand sign-extended to 18
    dac knfloc                     // once only (f4 983)
    lac [msg_KNIFE_VANISH:1]
    jmp pmsgT
unOrdinary,
    lio parseObj              // f4 3000
    eem
    jsp i [keepParseBoth:3]
    lio nounTok
    jmp i [pUnknownWord:1]
seeNoNoun,                // known object, not present (f4 5199)
    lio nounTok
    eem
    jmp i [pSeeNo:1]
verbWhat,                 // no noun given (f4 8000): "xxx WHAT?"
// TASK-FR27 N8: 8000 is "OBJ=0 ; GOTO 2600" -- the only reply that keeps
// VERB, and the reason `DROP` / `KEYS` finishes the drop. gateVerb is
// f4's VERB at every route into a handler: vtHit stores it through
// objPresenceGate before every dispatch, tlPour and the pending-SAY hook
// store it for their own, and uvPendingVerb inherits it.
    lem                   // most callers are bank-3 handlers arriving through
                          //   an eem'd indirect jump (vtDispatch's own idiom);
                          //   the bank-0 ones are already off
    lac gateVerb
    dac keepVerb
    lio verbTok
    eem
    jmp i [pVerbWhat:1]



// =======================================================================
// objPresenceGate -- adven.f4 4000's second-word half, and the port's
// only route from a resolved verb into the noun analysis at 5000.
//
//   4000 VERB=K
//        IF(WD2.NE.0.AND.VERB.NE.SAY)GOTO 2800
//   2800 WD1=WD2 ; WD2=0 ; GOTO 2610
//   2610 (the WEST joke) -> 2630, which classifies the word and goes to
//        label 8 (motion), 5000 (object), 4000 (action), 2010 (message)
//        or 3000 (no such word).
//
// TASK-FR18 built this as "resolve the noun, then fall back on the word
// classes"; the source is the other way round and TASK-FR2's STEPS note
// (S19, 05-Sep-26) is the case where the difference shows. adven.dat
// carries STEPS twice -- motion word 34 at section-4 line 918 and object
// 1007 at line 979 -- and VOCAB(WD,-1), which is what the parser calls,
// applies no class filter and returns the FIRST table entry, so the
// player's STEPS is the motion word wherever it appears. verbTab and
// objNames overlap on that one word here too and on no other (checked
// against the corpus, 05-Sep-26: 203 verb words, 52 object words, 26
// aliases, one intersection), so the reorder changes STEPS and nothing
// else -- but it changes the SHAPE to the source's, which is what the
// two rescues below depend on.
//
// IO on entry = the verb row's bank-0 handler address, which vtHit hands
// over with `lia` immediately before the dispatch. It stands in for f4's
// VERB, both at 4000's word-class test (motion words go to label 8 and
// message words to 2010, neither of which ever reads WD2, and SAY is
// 4000's named exception) and at 5190's FIND/INVENT exception.
// Returns AC = 0 to run the verb, AC != 0 to refuse with msg 60.
// jsp style, bank 0, same-bank only; entered and left with eem off.
// =======================================================================
objPresenceGate,
    local rtn, pgClass
    dap rtn
    dio gateVerb              // the row's bank-0 handler address
// TASK-FR27 N8: handlerClass runs FIRST now, and unconditionally, because
// its answer is also the test for f4 4000's own first line. VERB=K is set
// for a class-3 word and for nothing else -- 2630 sends class 1 to label
// 8, class 4 to 2010 and neither touches VERB -- and SAY, which 4000 does
// reach, is class 3 despite being handlerClass's named exception below.
// parseVerb is what carries that across the three replies that keep it
// (see pgOk), and it is also f4's VERB at label 50 (`FIND NE`, N13).
    jsp handlerClass
    dac pgClass
    SKIP_NEXT_IF_DIFFERENT [1
    jmp pgNotVerbWord         // AC == 1 (no skip): not an action word at all
    lac gateVerb              // AC == 0 or 2: f4 4000's "VERB=K"
    dac parseVerb
pgNotVerbWord,
    lac pgClass
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (class 3, an action word)
    jmp pgPass                // AC != 0: class 1 or 4, or SAY -- WD2 unread
    lac nounTok
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (no second word)
    jmp pgSecondVerb          // AC != 0: f4 4000's "GOTO 2800"
// f4 4000's "IF(OBJ.NE.0)GOTO 4090", the other half of TASK-FR27 N8: an
// object left pending by the previous command's 5015 reply is this verb's
// object, so `KEYS` / `TAKE` takes the keys. No presence re-test -- 4090
// is the handler and 5000 already ran, last turn, on this same object.
    lac parseObj
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (an object is pending)
    jmp pgPass                // AC == 0: nothing pending -- 4080, intransitive
    dac nounTok
    jmp pgPass
// f4 2800 -> 2610 -> 2630. The word is classified BEFORE any presence
// test, which is the reorder described in the header: an action word
// runs (`TAKE INVENTORY` lists the inventory), a motion word travels
// (`TAKE NORTH` walks north, `TAKE STEPS` takes the steps as motion word
// 34), a message word speaks. vtDispatch re-entered here is 2610, so the
// WEST joke still counts a second-word WEST, as 2610 does.
pgSecondVerb,
    lio nounTok               // token in IO for vtScan
    jsp vtScan
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when a row matched (vtPtr = that row)
    jmp pgSecondNoun          // AC == 0: no verbTab row -- class 2 or -1
    lac nounTok               // f4 2800: WD1 = WD2 ...
    dac verbTok
    dzm nounTok               //   ... WD2 = 0, then GOTO 2610/2630
    jmp vtDispatch
pgSecondNoun,                 // f4 2630 class 2 (or -1): the analysis at 5000
    lac nounTok
    dac gateTok
    jsp objHere5000
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (absent, or no such word)
    jmp pgPass                // AC == 0: present -- f4 5010 -> 4090
    SKIP_NEXT_IF_DIFFERENT [0d2
    jmp pgUnknownWord         // AC == 2 (no skip): f4 3000
// f4 5190, reached only once the noun is known to be absent, so an
// ordinary turn never walks this chain. TASK-FR7 7c's widening (the
// eleven non-action handlers) is gone from here: with the reorder above,
// a class-1 or class-4 first word never reaches the analysis at all,
// which is what 2630 does, so the only survivors are 5190's own two.
pgRefuse,
    lac gateVerb
    SKIP_NEXT_IF_DIFFERENT [doFind]        // 5190: FIND/WHERE answer for an object
    jmp pgPass                             //   that is elsewhere, not deny it exists
    SKIP_NEXT_IF_DIFFERENT [doInventory]   // 5190's INVENT half
    jmp pgPass
pgRefuseFire,
    law 1
    jmp rtn
pgPass,
    cla
rtn, jmp 0
pgClass, 0
    endloc
// f4 3000. Ends the turn where it stands, like unKnifeWord below and
// like every other pUnknownWord caller -- there is no verb left to run,
// so nothing returns to vtHit's dispatch.
pgUnknownWord,
    lio parseObj              // f4 3000 falls to 2600 and keeps VERB and OBJ
    eem
    jsp i [keepParseBoth:3]
    lio nounTok               // the offending word, for the "..." in the text
    jmp i [pUnknownWord:1]
// f4's WD1 and VERB while the analysis below runs. Plain bank-0 words
// rather than locals because objHere5000 has two callers in two
// different local scopes -- objPresenceGate above (VERB set, WD1 = the
// second word) and unknownVerb (VERB 0, WD1 = the first word).
gateTok, 0
gateVerb, 0

// =======================================================================
// handlerClass -- as much of adven.dat's word class as the parser needs,
// read off gateVerb. AC = 0 for an action word (class 3, the 2xxx
// codes): the only class f4 4000 sends to 2800, and so the only one
// whose second word is looked at at all. AC = 1 for a motion word
// (class 1, straight to label 8) and a message word (class 4, to 2010),
// and for gateVerb == 0, which is unknownVerb's "no verb analysed yet"
// -- no caller asks in that state, but the answer is the honest one.
//
// AC = 2 for SAY, split out of the AC = 1 group by TASK-FR27 N8. SAY is
// 4000's named exception, so its second word is not analysed and it
// belongs with the 1's for that question -- but adven.dat 2003 makes it
// an ACTION word, so 4000 IS reached and "VERB=K" does happen, which is
// what a pending SAY (N9) depends on. Callers that only care about the
// second word test for 0; the caller that cares about VERB tests for 1.
//
// The list is keyed on adven.dat's code column, NOT on what reads like
// motion: `WALK`/`RUN`/`GO` are 2011, action words, so they are absent
// here on purpose and their second word does reclassify.
// jsp style, bank 0, same-bank only; clobbers AC.
// =======================================================================
handlerClass,
    local rtn
    dap rtn
    lac gateVerb
    SKIP_NEXT_IF_DIFFERENT [doSay]         // f4 4000: SAY never analyses its second word
    jmp hcSay
    SKIP_NEXT_IF_DIFFERENT [doNull]        // class 1: NULL/NOWHE, f4 label 8's own
    jmp hcOther                            //   exception (TASK-FR27 N13)
    SKIP_NEXT_IF_DIFFERENT [doMove]        // class 1: f4 2630 sends motion words to
    jmp hcOther                            //   label 8 and drops WD2 unread
    SKIP_NEXT_IF_DIFFERENT [doBack]
    jmp hcOther
    SKIP_NEXT_IF_DIFFERENT [doLookCmd]     // LOOK/EXAMI/TOUCH/DESCR, adven.dat 57
    jmp hcOther
    SKIP_NEXT_IF_DIFFERENT [doCave]
    jmp hcOther
    SKIP_NEXT_IF_DIFFERENT [doXyzzy]
    jmp hcOther
    SKIP_NEXT_IF_DIFFERENT [doPlugh]
    jmp hcOther
    SKIP_NEXT_IF_DIFFERENT [doPlove]
    jmp hcOther
    SKIP_NEXT_IF_DIFFERENT [doSpeak]       // class 4: f4 2630 sends message words to
    jmp hcOther                            //   label 2010, WD2 unread as well
    SKIP_NEXT_IF_DIFFERENT [doHelp]        // HELP / ? -- adven.dat 3051, class 4
    jmp hcOther
    SKIP_NEXT_IF_DIFFERENT [doInfo]        // INFO / INFOR -- adven.dat 3142, class 4
    jmp hcOther
    SKIP_NEXT_IF_AC_NOT_ZERO               // skip when AC != 0 (a real handler)
    jmp hcOther                            // AC == 0 (no skip): no verb analysed yet
hcAction,
    cla
    jmp rtn
hcOther,
    law 1
    jmp rtn
hcSay,
    law 2
rtn, jmp 0
    endloc

// =======================================================================
// objHere5000 -- adven.f4 5000 and 5100-5140: the one test that stands
// between naming a noun and doing anything with it.
//
//   5000 IF(FIXED(K).NE.LOC.AND..NOT.HERE(K))GOTO 5100
//   5100   ... the GRATE reroute ...
//   5110   ... a dwarf really in LOC, with DFLAG.GE.2 ...
//   5120   ... the liquid in a carried bottle, or the room's own liquid ...
//          ... the phony plant (OBJ=PLANT2) ...
//   5130   ... the dwarves' knife ...
//   5140   ... ROD -> ROD2 ...
//
// TASK-FR18 gave the port this gate (it had none: every handler tested
// presence for itself and several did not, so ATTACK BIRD killed the
// bird from any room and BREAK VASE smashed a 14-point treasure from
// any room). TASK-FR27 N12 (S19) made it a routine of its own, because
// the source reaches this block from BOTH word paths -- 2630 class 2 for
// a first word, 4000 -> 2800 -> 2630 class 2 for a second one -- and the
// port had a second, thinner copy of it in unknownVerb.
//
// Input:  gateTok  = the word being analysed (f4's WD1)
//         gateVerb = the verb's bank-0 handler address, or 0 when no
//                    verb has been analysed yet (f4's VERB)
// Output: AC = 0   present                          (f4 5010)
//         AC = 1   a noun this port knows, absent   (f4 5190)
//         AC = 2   no such word at all              (f4 3000)
// On a hit objLocPtr/objTakePtr are findObj's, so the caller may use
// them. 5140's ROD -> ROD2 substitution is inside findObj itself (it
// went in with TASK-FR21 C16), so calling findObj here inherits it.
//
// Does NOT return in the two cases the source finishes inside this
// block: 5130's knife (msg 116 and the turn is over) and 5100's grate
// reroute (K becomes a motion word and the source travels).
// jsp style, bank 0, same-bank only; entered and left with eem off.
// =======================================================================
objHere5000,
    local rtn, ohWant, ohRoomWant
    dap rtn
    lio gateTok               // token in IO for findObj (and strCmpEq below)
    jsp findObj
    lem                       // findObj returns with eem on
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (a known object word)
    jmp ohNotObject           // AC == 0: not in the object table
ohHereTest,                   // f4 5000: FIXED(K).EQ.LOC .OR. HERE(K)
    lac i objLocPtr
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (not carried -- try the room)
    jmp ohPresent             // AC == 0: TOTING(K)
    SKIP_NEXT_IF_DIFFERENT curRoom   // skip when it is NOT in this room
    jmp ohPresent                    // == curRoom: PLACE(K).EQ.LOC
    jsp objAtSecond           // FIXED(K).EQ.LOC -- the port's two-placed objects
    lem                       // objAtSecond returns with eem on
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (not there either)
    jmp ohPresent             // AC == 0: AT() by the second placement
// f4 5100 onwards: the four objects the source rescues by name. GRATE is
// first because 5100 is, and because objAtSecond has just answered the
// AT() half of it -- what is left here is the reroute, not a presence
// test.
oh5100,
    lac objLocPtr
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_GRATE)]
    jmp ohGrate               // f4 5100
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_WATER)]
    jmp ohWater               // f4 5120, first half
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_OIL)]
    jmp ohOil
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_PLANT)]
    jmp ohPhonyPlant          // the plant (no skip): f4 5120, second half
    jmp ohAbsent              // any other object: genuinely not here
// TASK-FR19 C12 (S19, 05-Sep-26). adven.f4 5100 in full:
//
//     5100 IF(K.NE.GRATE)GOTO 5110
//          IF(LOC.EQ.1.OR.LOC.EQ.4.OR.LOC.EQ.7)K=DPRSSN
//          IF(LOC.GT.9.AND.LOC.LT.15)K=ENTRNC
//          IF(K.NE.GRATE)GOTO 8
//
// With the grate named but not present, the source stops treating the
// word as a noun at all: at the End of Road, the Valley and the Slit it
// becomes DEPRESSION, in the five rooms behind the grate it becomes
// ENTRANCE, and the turn becomes a move. Everywhere else K is still
// GRATE and the analysis carries on to 5110. The port answered "I SEE NO
// GRATE HERE." at all eleven.
//
// The travel side of this landed with TASK-FR2: DIR_DEPRE and DIR_ENTRA
// are vocabulary, and the ten adven.dat rows they walk are in the corpus
// (including the four conditional ones that skip silently when the grate
// is shut). Two of the eleven rooms have no row for the motion they get
// -- the Slit has no DEPRESSION row and the Cobble Crawl no ENTRANCE row
// -- so the source substitutes the word and then fails the travel, and
// doMove's ordinary "no way to go that direction" answer is that reply.
//
// `GOTO 8` is doMove's own entry, OLDLOC shift included (TASK-FR26 N4
// put the shift there), so this jumps rather than returning a verdict --
// there is no noun left for the caller to refuse.
ohGrate,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_ROAD           // LOC 1
    jmp ohGrateDepre
    SKIP_NEXT_IF_DIFFERENT [R_VALLEY         // LOC 4
    jmp ohGrateDepre
    SKIP_NEXT_IF_DIFFERENT [R_SLIT           // LOC 7 -- substitutes, then fails the travel
    jmp ohGrateDepre
    SKIP_NEXT_IF_DIFFERENT [R_COBBLE         // LOC 10 -- ditto, no ENTRANCE row
    jmp ohGrateEntra
    SKIP_NEXT_IF_DIFFERENT [R_DEBRIS         // LOC 11
    jmp ohGrateEntra
    SKIP_NEXT_IF_DIFFERENT [R_AWKWARD        // LOC 12
    jmp ohGrateEntra
    SKIP_NEXT_IF_DIFFERENT [R_BIRD           // LOC 13
    jmp ohGrateEntra
    SKIP_NEXT_IF_SAME [R_PITTOP              // LOC 14 -- skip when it IS the last one
    jmp ohAbsent                             // none of the eight (no skip): K stays GRATE
ohGrateEntra,
    law DIR_ENTRA
    jmp ohGrateGo
ohGrateDepre,
    law DIR_DEPRE
ohGrateGo,
    dac curDir
    jmp doMove                // f4 5100's "GOTO 8"
// f4 5120's first half: (LIQ(0).EQ.K.AND.HERE(BOTTLE)).OR.K.EQ.LIQLOC(LOC).
// bottleProp is LIQ(0) -- 0 = water, 1 = empty, 2 = oil -- and liquidAtRoom
// is LIQLOC, answering 0 (dry), 1 (water) or 2 (oil), so water needs the two
// encodings kept apart and oil happens to share a value.
//
// Deliberately NOT read off objLoc[WATER]/objLoc[OIL]: resyncLiquidObjLoc
// only zeroes those when the bottle is CARRIED, where f4's HERE(BOTTLE)
// also counts a bottle standing in the room.
ohWater,
    dzm ohWant                // bottleProp 0 == water
    law 1
    dac ohRoomWant            // liquidAtRoom 1 == water
    jmp ohLiquid
ohOil,
    law 2
    dac ohWant                // bottleProp 2 == oil
    dac ohRoomWant            // liquidAtRoom 2 == oil as well
ohLiquid,
    jsp liquidAtRoom
    SKIP_NEXT_IF_DIFFERENT ohRoomWant   // skip when the room's liquid isn't this one
    jmp ohPresent                       // K .EQ. LIQLOC(LOC)
    lac bottleProp
    SKIP_NEXT_IF_SAME ohWant            // skip when the bottle holds this liquid
    jmp ohAbsent                        // empty, or holding the other one
    lac OBJ_LOC(OBJ_BOTTLE)             // LIQ(0).EQ.K -- now HERE(BOTTLE)?
    SKIP_NEXT_IF_AC_NOT_ZERO            // skip when AC != 0 (not carried)
    jmp ohPresent                       // AC == 0: carried
    SKIP_NEXT_IF_SAME curRoom           // skip when the bottle stands in this room
    jmp ohAbsent
    jmp ohPresent
// f4 5120's second half, AT(PLANT2).AND.PROP(PLANT2).NE.0 -- which is
// printPhonyPlant's own two conditions.
ohPhonyPlant,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_TWOPITWEST]
    jmp ohPlantVisible        // == R_TWOPITWEST (no skip)
    SKIP_NEXT_IF_SAME [R_TWOPITEAST]         // skip when == R_TWOPITEAST
    jmp ohAbsent                             // neither Twopit room
ohPlantVisible,
    lac plantDisplayProp
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (the phony plant is showing)
    jmp ohAbsent              // AC == 0: not visible from either room yet
    jmp ohPresent
// f4 5110 and 5130, for the two pseudo-nouns this port models outside the
// object table, so findObj never matches them and the object walk above
// never sees them.
ohNotObject,
    lio gateTok
    lac [voc_dwarf:2]
    jda strCmpEq
    lem                       // strCmpEq returns with eem on
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (the word IS "DWARF")
    jmp ohCheckDwarv          // AC == 0: not "DWARF" -- try adven.dat's second word
    jmp ohDwarfWord
// adven.dat 1017 gives object 17 two words, DWARF and DWARV; only the
// first was here. That did not matter while an unmatched second word fell
// through to the handler, because both ended in the same place -- it
// matters now that TASK-FR7 7c rejects an unmatched word outright, since
// "DWARVES" would otherwise become "I DON'T KNOW THE WORD".
ohCheckDwarv,
    lio gateTok
    lac [voc_dwarv:2]
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (the word IS "DWARV")
    jmp ohCheckKnife          // AC == 0: neither dwarf word -- try KNIFE next
ohDwarfWord,
    jsp dwarfHereScan         // DLOC(I).EQ.LOC .AND. DFLAG.GE.2, over the five
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (no live dwarf in this room)
    jmp ohPresent             // AC != 0: one really is here
// ...and 5110 is not the only way DWARF is present. adven.f4 11000's PUT
// list includes "PROP(DWARF)=PUT(DWARF,115,0)" -- the DWARF object itself
// is placed in the repository at closing time, so HERE(DWARF) is true
// there by PLACE.EQ.LOC and 5110's DLOC loop never has to fire. That is
// what makes ATTACK DWARF and WAKE DWARF reach 1456/9290's GOTO 19000
// (msg 136) in a repository that contains no walking dwarves at all.
// closedTransport skips that PUT because this port has no DWARF row and
// treats the sleeping dwarves as room text; the placement is reproduced
// here instead. No `closed` test is needed alongside it: R_REPOSITORY_NE
// is reachable only through closedTransport.
    lac curRoom
    SKIP_NEXT_IF_SAME [R_REPOSITORY_NE]   // skip when == LOC 115, the PUT room
    jmp ohAbsent
    jmp ohPresent
// adven.f4 5130, moved here by TASK-FR7 7c (S15, 03-Sep-26):
//
//     5130 IF(OBJ.NE.KNIFE.OR.KNFLOC.NE.LOC)GOTO 5140
//          KNFLOC=-1
//          SPK=116
//          GOTO 2011
//
// This used to live in bank 0's unknownNoun/unKnifeWord, reached because
// KNIFE matched nothing and fell through to the handler, which echoed the
// word. 7c closes that fall-through, so the test has to be made HERE --
// ahead of the rejection -- or the dwarves' thrown knives become
// unmentionable.
//
// When a knife IS here, this ends the turn where it stands rather than
// returning a verdict: 2011 speaks and goes to the turn tail, so there is
// no verb left to dispatch or refuse. bank 0's unKnifeWord still holds
// that body, and is jumped to rather than copied, so the once-only
// KNFLOC=-1 and the message text stay in one place. (It re-makes the
// knfloc test on arrival, which is redundant but harmless, and is what
// lets the two callers keep different answers for the other case.)
//
// When no knife is here, 5130's condition fails and the source falls to
// 5140 and then 5190 -- "I SEE NO KNIFE HERE.", NOT the unknown-word
// reply. Since TASK-FR27 N12 (S19) this holds for KNIFE as a first word
// too, which used to answer `SORRY, I DON'T KNOW THE WORD "KNIFE".`
ohCheckKnife,
    lio gateTok
    lac [voc_knife:2]
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (not "KNIFE")
    jmp ohKnifeWord           // AC != 0: KNIFE
    lio gateTok
    lac [voc_knive:2]
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (not "KNIVE" either)
    jmp ohKnifeWord           // AC != 0: adven.dat 1018's second word
    jmp ohNoSuchWord          // AC == 0: no such word anywhere -- f4 3000
ohKnifeWord,
    lac knfloc
    SKIP_NEXT_IF_SAME curRoom // skip when knfloc == curRoom (a knife really is here)
    jmp ohAbsent              // not here (0, or retired at -1): 5130 -> 5140 -> 5190
    jmp unKnifeWord           // here: bank 0's body does KNFLOC=-1 and msg 116
ohNoSuchWord,
    law 0d2
    jmp rtn
// TASK-FR27 N8: f4 5000's first statement is "OBJ=K", above the presence
// test, so BOTH verdicts leave OBJ set and only 2630's earlier "no such
// word" arm (ohNoSuchWord, which the source reaches at 3000 without ever
// entering 5000) leaves it alone. It is what 5015 keeps and what 3000 is
// still holding when it prints -- `KEYS FROB` then `TAKE` takes the keys.
ohAbsent,
    lac gateTok
    dac parseObj
    law 1
    jmp rtn
ohPresent,
    lac gateTok
    dac parseObj
    cla
    jmp rtn
rtn, jmp 0
ohWant, 0
ohRoomWant, 0
    endloc

// =======================================================================
// objAtSecond -- adven.f4's AT(K) for the objects the source places in
// two rooms and this port places in one.
//
// AT() is PLACE.EQ.LOC.OR.FIXED.EQ.LOC, and adven.dat section 7 gives
// nine of this port's objects a PLAC/FIXD pair: DRAGON and RUG
// ("31 119 121" / "62 119 121"), STEPS ("7 14 15"), SHADOWFIG
// ("27 35 110"), GRATE ("3 8 9"), FISSURE ("12 17 27"), CHASM
// ("32 117 122"), TROLL ("33 117 122") and the MIRROR, whose second
// placement is made at run time by 11000. objLoc holds the PLAC room, so
// the caller has already answered that half; this answers the other one,
// and each branch repeats the PLAC test anyway so that it reads as the
// whole AT() rather than as the half the caller happened to leave.
//
// Two of the nine are not static and are reproduced from the state the
// port already keeps rather than by writing objLoc at each MOVE site
// (which would owe newGame a reset -- S4's trap): the troll, whose
// placement adven.f4 1592/1296 clear and 1077 restores, is carried in
// trollGone; the mirror, which 11000 puts in BOTH repository rooms and
// closedTransport deliberately does not relocate, is carried in `closed`.
// The dragon pair lapses when the dragon dies (1474's MOVE(...,-1)),
// which is dragonHere's business.
//
// PIRATE is the tenth section-7 pair and needs no branch: adven.dat
// "30 0 -1" parks it nowhere, so AT(PIRAT) is false on every turn.
//
// Input:  objLocPtr, as findObj left it.
// Output: AC = 0 when the object is AT() curRoom by its second placement,
//         AC != 0 otherwise -- which is every object that has only one.
// jsp style, bank 0; AC/IO clobbered. Callers in other banks use the
// ordinary `jsp i [objAtSecond:0]` form with eem on, the same as findObj.
// =======================================================================
objAtSecond,
    local rtn
    dac rtn
    lem                       // callers in other banks arrive with eem on and
                              //   everything below is bank-0 local, findObj's own
                              //   pattern; the return re-opens the window
    lac objLocPtr
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_DRAGON)]
    jmp oasDragonPair         // the dragon (no skip)
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_RUG)]
    jmp oasDragonPair         // the rug (no skip) -- the same pair of rooms
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_STEPS)]
    jmp oasSteps
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_SHADOWFIG)]
    jmp oasShadow
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_GRATE)]
    jmp oasGrate
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_FISSURE)]
    jmp oasFissure
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_CHASM)]
    jmp oasChasm
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_TROLL)]
    jmp oasTroll
    SKIP_NEXT_IF_SAME [OBJ_LOC(OBJ_MIRROR)]  // skip when it IS the mirror
    jmp oasNo                                // anything else: one location only
oasMirror,
// adven.f4 11000 does "PROP(MIRROR)=PUT(MIRROR,115,0); FIXED(MIRROR)=116"
// -- from closing onwards the mirror is AT() in BOTH repository rooms,
// which are also the only rooms still reachable. Testing `closed`
// reproduces that for every state the player can be in: before closing
// the mirror is at R_MIRRORCANYON and the caller's objLoc compare has
// already answered.
    lac closed
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (not closed -- and not at the
    jmp oasYes                //   canyon either, or the caller would not have asked)
    jmp oasNo
oasDragonPair,
    jsp dragonHere            // AT(DRAGON) over both rooms; the second location
                              // lapses for the rug at the same moment it does
                              // for the dragon (adven.f4:1474's MOVE(...,-1))
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (present by neither location)
    jmp oasYes
    jmp oasNo
oasSteps,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_PITTOP]
    jmp oasYes                // == R_PITTOP (no skip): the PLAC room, LOC 14
    SKIP_NEXT_IF_SAME [R_MISTHALL]           // skip when == the FIXD room, LOC 15
    jmp oasNo
    jmp oasYes
oasShadow,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_Y2WINDOW]
    jmp oasYes                // == R_Y2WINDOW (no skip)
    SKIP_NEXT_IF_SAME [R_WINDOWONPIT]        // skip when == the other window room
    jmp oasNo
    jmp oasYes
oasGrate,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_GRATE]
    jmp oasYes                // == R_GRATE (no skip): the PLAC room, LOC 8
    SKIP_NEXT_IF_SAME [R_BELOW_GRATE]        // skip when == the FIXD room, LOC 9
    jmp oasNo
    jmp oasYes
oasFissure,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_FISSURE_EAST]
    jmp oasYes                // == R_FISSURE_EAST (no skip): the PLAC room, LOC 17
    SKIP_NEXT_IF_SAME [R_FISSURE_WEST]       // skip when == the FIXD room, LOC 27
    jmp oasNo
    jmp oasYes
oasChasm,
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_CHASM_SW]
    jmp oasYes                // == R_CHASM_SW (no skip): the PLAC room, LOC 117
    SKIP_NEXT_IF_SAME [R_CHASM_NE]           // skip when == the FIXD room, LOC 122
    jmp oasNo
    jmp oasYes
oasTroll,
    lac trollGone
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (toll unpaid -- he is still there)
    jmp oasNo                 // AC != 0 (no skip): MOVE(TROLL,0) -- nowhere at all
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_CHASM_SW]
    jmp oasYes                // == R_CHASM_SW (no skip): PLAC, LOC 117
    SKIP_NEXT_IF_SAME [R_CHASM_NE]           // skip when == FIXD, LOC 122
    jmp oasNo
    jmp oasYes
oasYes,
    cla
    jmp oasRtn
oasNo,
    law 1
oasRtn,
    eem                       // returns with eem on, like findObj
    jmp i rtn
rtn, 0
    endloc
doLookCmd,
    local dlcPtr
    lac detailCnt
    sub [0d3
    SKIP_NEXT_IF_AC_NEGATIVE       // skip when fewer than 3 LOOKs so far
    jmp dlcNoWarn
    lac [msg_NO_MORE_DETAIL:1]
    jda pmsg
dlcNoWarn,
    idx detailCnt             // f4 increments unconditionally
    lac [roomVisited:1]
    add curRoom
    sub [1
    dac dlcPtr
    law 1
    eem
    dac i dlcPtr
    lem
    jsp turnCreatures         // f4 30 ends GOTO 2, so LOOK runs the dwarf block
                                 // too, and its lines print before the room text
    lem                       //   (dual-mode: returns with eem on)
    jsp doLook
    jmp turnLoop
dlcPtr, 0
    endloc

// SAVE / RESTORE (Adventure/SAVELOAD.md) -- see the SAVE_* #defines and
// the drumRead/drumWrite subroutines near the top of this file for the
// drum layout and transfer mechanism. Four regions each: objLoc, then
// roomVisited, then the "Game state" var block, then (SAVE only) the
// magic marker last -- and (RESTORE only) the magic marker first, since
// RESTORE must know whether a save exists before touching any real state.
doSave,
    eem
    jmp i [doSave:3]      // wave 4A: body in bank 3 under the same name
                             // (the sv* drum-record tables below stay in
                             // bank 0 -- the body reaches them by :0 value)

svObjLocRec,  SAVE_TRACK
              SAVE_OBJLOC_OFFSET
              SAVE_OBJLOC_WORDS
              objLoc
svRoomVisRec, SAVE_TRACK
              SAVE_ROOMVIS_OFFSET
              SAVE_ROOMVIS_WORDS
              roomVisited:1
svStateRec,   SAVE_TRACK
              SAVE_STATE_OFFSET
              SAVE_STATE_WORDS
              objTakePtr
svDwarfLocRec, SAVE_TRACK
              SAVE_DWARFLOC_OFFSET
              SAVE_DWARFLOC_WORDS
              dwarfLoc
svHintRec,    SAVE_TRACK
              SAVE_HINT_OFFSET
              SAVE_HINT_WORDS
              hintedTab:2
svEndgameRec, SAVE_TRACK
              SAVE_ENDGAME_OFFSET
              SAVE_ENDGAME_WORDS
              seenTab:2
svObjTakeRec, SAVE_TRACK
              SAVE_OBJTAKE_OFFSET
              SAVE_OBJTAKE_WORDS
              objTake
svObjHereMsgRec, SAVE_TRACK
              SAVE_OBJHEREMSG_OFFSET
              SAVE_OBJHEREMSG_WORDS
              objHereMsg:2
svObjDropSeqRec, SAVE_TRACK
              SAVE_OBJDROPSEQ_OFFSET
              SAVE_OBJDROPSEQ_WORDS
              objDropSeq
svMagicRec,   SAVE_TRACK
              SAVE_MAGIC_OFFSET
              1
              svMagicSrc
svMagicSrc,   SAVE_MAGIC

doRestore,
    eem
    jmp i [doRestore:3]

rlMagicRec,   SAVE_TRACK
              SAVE_MAGIC_OFFSET
              1
              rlMagicDst
rlMagicDst,   0
rlObjLocRec,  SAVE_TRACK
              SAVE_OBJLOC_OFFSET
              SAVE_OBJLOC_WORDS
              objLoc
rlRoomVisRec, SAVE_TRACK
              SAVE_ROOMVIS_OFFSET
              SAVE_ROOMVIS_WORDS
              roomVisited:1
rlStateRec,   SAVE_TRACK
              SAVE_STATE_OFFSET
              SAVE_STATE_WORDS
              objTakePtr
rlDwarfLocRec, SAVE_TRACK
              SAVE_DWARFLOC_OFFSET
              SAVE_DWARFLOC_WORDS
              dwarfLoc
rlHintRec,    SAVE_TRACK
              SAVE_HINT_OFFSET
              SAVE_HINT_WORDS
              hintedTab:2
rlEndgameRec, SAVE_TRACK
              SAVE_ENDGAME_OFFSET
              SAVE_ENDGAME_WORDS
              seenTab:2
rlObjTakeRec, SAVE_TRACK
              SAVE_OBJTAKE_OFFSET
              SAVE_OBJTAKE_WORDS
              objTake
rlObjHereMsgRec, SAVE_TRACK
              SAVE_OBJHEREMSG_OFFSET
              SAVE_OBJHEREMSG_WORDS
              objHereMsg:2
rlObjDropSeqRec, SAVE_TRACK
              SAVE_OBJDROPSEQ_OFFSET
              SAVE_OBJDROPSEQ_WORDS
              objDropSeq

doHelp,
    lac [msg_HELP:1]
    jmp pmsgT

// TASK-FR27 N13 (05-Sep-26). Six verbs took a noun and ignored it. In
// adven.f4 the intransitive and transitive tables are separate lists and
// only 4080 names their real bodies; 4090 sends HOURS (31), SUSPEND (30),
// SCORE (24), QUIT (18), BRIEF (26) and FOO (25) to 2011, which speaks
// ACTSPK(VERB) and nothing else. Section 8 gives 13 to the first four --
// and adven.dat's message 13 is a ">$<" placeholder, which SPEAK returns
// from without printing so much as its blank line -- 155 to BRIEF and 147
// to FOO. So `HOURS LAMP` says nothing at all where the port printed the
// opening times, and `SUSPEND LAMP` says nothing where the port SAVED THE
// GAME. The noun still goes through objPresenceGate first, so an absent
// or unknown one is refused there exactly as any other verb's is.
doHours,
    lac nounTok
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (no noun -- f4 4080 index 31)
    jmp turnLoop              // AC != 0: 4090 index 31 -> 2011, ACTSPK 13, silence
    lac [msg_HOURS_HEADER:1]
    jda pmsg
    farjsp(wzHours:2)
    lem     // now turn eem off, the return leaves it on
    jmp turnLoop

// Print out the current score.
doScore,
    eem
    jmp i [doScore:3]     // wave 4A: body in bank 3 under the same name

// checkDwarfBlock -- f4 lines 638-644: if a dwarf that has seen
// the player came FROM the room the player is about to enter, the move
// is cancelled with msg 2. IO = destination on entry.
// IO is preserved for loadRoom.
// On a block this prints the message and ends the turn directly,
// otherwise returns with AC = destination for moveGo's dac.
checkDwarfBlock,
    local rtn, cdbDest, cdbIx, cdbPtr, cdbMaskPtr
    dap rtn
    dio cdbDest
    jsp checkPirateForbidRoom
    lem
    SKIP_NEXT_IF_AC_ZERO                     // skip when AC == 0 (not forbidden)
    jmp cdbPass                            // AC != 0 (no skip): forbidden -- never blocked
    lac cdbDest
    SKIP_NEXT_IF_DIFFERENT curRoom      // skip when dest != curRoom
    jmp cdbPass               // dest == curRoom: self-move, never blocked (f4 638)
    dzm cdbIx
cdbScan,
    lac cdbIx
    SKIP_NEXT_IF_DIFFERENT [5
    jmp cdbPass               // all five checked -- no blocker
    law dwarfBitMask
    add cdbIx
    dac cdbMaskPtr
    lac i cdbMaskPtr          // this dwarf's dwarfSeen bit
    and dwarfSeen
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when the bit is set (dwarf has seen him)
    jmp cdbNext               // bit clear: can't block
    law dwarfPrevLoc
    add cdbIx
    dac cdbPtr
    lac i cdbPtr              // where this dwarf came FROM last turn
    SKIP_NEXT_IF_SAME cdbDest      // skip when == the destination
    jmp cdbNext               // different room: not in the way
cdbBlocked,
    // f4 71: RSPEAK(2), NEWLOC=LOC, then GOTO 74 -- the player stays and the
    // room is re-described, so this is a stay tail, not a bare message
    // (TASK-FR26 N3).
    lac [msg_DWARF_BLOCKS:1]
    jmp moveStayT
cdbNext,
    idx cdbIx
    jmp cdbScan
cdbPass,
    lac cdbDest               // restore the destination for moveGo
rtn, jmp 0
cdbDest, 0
cdbIx, 0
cdbPtr, 0
cdbMaskPtr, 0
    endloc

moveGo,
    lia
    lac closing
    SKIP_NEXT_IF_AC_ZERO           // skip (closing == 0) -- ordinary move below
    jmp mgGateCheck                   // closing != 0 (not skipped): check the destination
mgProceed,                              // closing == 0 (skipped): falls through -- ordinary move
    // TASK-FR26 N6. adven.f4 71 is
    //     IF(NEWLOC.EQ.LOC.OR.FORCED(LOC).OR.BITSET(LOC,3))GOTO 74
    // so the block check is skipped when the room being LEFT is forced --
    // which is the second hop of every forced traversal. The port does
    // both hops in one moveGo, with the origin the room before the forced
    // one, so without this the check would run against the final
    // destination and a dwarf could refuse a move the source lets
    // through. The three cross-room bounces (wpcGrown, fwNorthCheck,
    // mwNorthCheck) set the flag; the self-move bounces (mtkBounce,
    // mhBounce, bldSewerBounce, wpcNotGrown, ptCrackBounce) do not need
    // it, because checkDwarfBlock's own dest == curRoom test is f4 71's
    // first clause. One-shot: cleared here whatever happens next, so a
    // refusal below can never leave it armed for the following turn.
    lac mgForcedHop
    dzm mgForcedHop
    SKIP_NEXT_IF_AC_ZERO      // skip when clear (an ordinary move -- check below)
    jmp mgNoBlock             // set (no skip): forced second hop -- f4 71 skips the check
    jsp checkDwarfBlock
mgNoBlock,
// TASK-FR26 N4 (S17, 04-Sep-26): the OLDLC2/OLDLOC shift used to happen here,
// on the moving path only. adven.f4 does it at label 8, BEFORE the travel
// scan and therefore for a refused move too, so it now lives at doMove's
// entry (dmShiftOldLoc) and this path only walks.
    lai                       // AC = the destination again (IO undisturbed)
    dac curRoom
    jsp loadRoom
    ROOM_CACHE                // address where loadRoom puts the room data
    jsp turnCreatures         // f4 74 -> 6000: the dwarves act in the room just
                                 // entered and print BEFORE its text (TASK-FR25
                                 // N2); a fatal knife never returns
    lem                       //   (dual-mode: returns with eem on)
    jsp darkDeathRoll         // TASK-FR22: f4 2000 rolls HERE, on the room just
                                 // entered, before its description prints -- never
                                 // returns if the roll hits
    jsp enterRoom
    jmp turnLoop
mgGateCheck,
    lai                             // AC = destination (IO preserved) --
                              // fixed from an earlier `lia`/`lai` mixup: this
                              // reads IO into AC, it does not write AC to IO
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip (dest != 0) -- check surface below
    jmp mgProceed             // dest == 0 (not skipped): exempt (f4 NEWLOC.EQ.0)
mgDestCheck,                  // dest != 0 (skipped from mgGateCheck): falls through -- check surface
// f4's "dest < R_BELOW_GRATE" positional predicate (adven.f4 628-632) reimplemented as the explicit
// per-room SURFACE flag.
    eem                               // extend on before the cross-bank call
    jsp i [isSurfaceRoom:3]          // AC = nonzero if dest is SURFACE-flagged
    lem
    SKIP_NEXT_IF_AC_NOT_ZERO         // skip (AC != 0, dest is surface) -- trap below
    jmp mgProceed                        // AC == 0 (not skipped): dest not surface -- ordinary move
mgSurfaceTrapFar,                       // far entry for bank 3's magicClosingGate (eem on)
    lem
mgSurfaceTrap,                          // AC != 0 (skipped): dest is surface -- falls through -- blocked
    // f4 2 sets NEWLOC=LOC after RSPEAK(130) and falls into 71 -> 74 -> 2000,
    // so the refusal is followed by the room again (TASK-FR26 N3).
    lac [msg_CLOSED_EXIT:1]
    jda pmsg
    jsp panicOnce
    jmp moveStay

mgForcedHop, 0                          // TASK-FR26 N6: see mgProceed above

moveBlocked,
    // adven.f4 50, a transcription rather than a translation since the
    // TASK-FR2 renumber (06-Sep-26) made the source's own motion numbers
    // the DIR_* codes:
    //     SPK=12               the default        -- msg_CANT_APPLY
    //     K 43..50   -> SPK=9  the compass words  -- msg_NO_WAY_DIRECTION
    //     K 29, 30   -> SPK=9  UP, DOWN           -- msg_NO_WAY_DIRECTION
    //     K 7,36,37  -> SPK=10 FORWARD/LEFT/RIGHT -- msg_UNSURE_FACING
    //     K 11, 19   -> SPK=11 OUT, IN            -- msg_IN_FROM_OUT
    //     K 62, 65   -> SPK=42 XYZZY, PLUGH       -- not reachable here
    //     K 17       -> SPK=80 CRAWL              -- msg_WHICH_WAY
    // LEFT(36)/RIGHT(37) became directions in FR2 step 4 (06-Sep-26) and
    // are tested below beside FORWARD, the third word of their class.
    // Before that they were aliased onto NE/SE and so answered msg 9 here,
    // the compass class -- one of the two refusals the alias got wrong.
    // ENTER(3) is the other, and it needs NO test: it is not 17, 29, 30,
    // 7, 36, 37, 11 or 19, and mbCompass's range check rejects it below
    // 43, so it reaches mbCantApply -- SPK=12, f4 50's untouched default,
    // which is exactly what the source gives motion 3.  As DIR_IN it used
    // to answer msg 11.
    // XYZZY(62)/PLUGH(65) never arrive -- doXyzzy/doPlugh own those words
    // and never fall through to a travel scan.
    //
    // The VERB.EQ.FIND/INVENT clause landed 05-Sep-26 (TASK-FR27 N13):
    // `FIND NE` is 4000 -> 2800 -> 2630 -> label 8 with VERB still FIND,
    // so it reaches label 50 and answers msg 59, not the direction's own
    // msg 9. The source's tests OVERWRITE one assignment after another
    // and the K tests are mutually exclusive, so the only ones that
    // outrank FIND are the two written below it: 62/65, unreachable, and
    // 17. That is why the CRAWL test is first here and the rest follow.
    //
    // sad/sas compare without disturbing the AC, so curDir is still in it
    // at every test below and is only consumed by the range check.
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_CRAWL
    jmp mbWhichWay            // AC == DIR_CRAWL (no skip): K.EQ.17, f4 50's LAST word
    lac parseVerb             // f4's VERB, kept across 2800 by pgOk/objPresenceGate
    SKIP_NEXT_IF_DIFFERENT [doFind]
    jmp mbRemote
    SKIP_NEXT_IF_DIFFERENT [doInventory]
    jmp mbRemote
    lac curDir
    SKIP_NEXT_IF_DIFFERENT [DIR_UP
    jmp mbNoWay               // AC == DIR_UP (no skip): f4 50's K.EQ.29
    SKIP_NEXT_IF_DIFFERENT [DIR_DOWN
    jmp mbNoWay               // AC == DIR_DOWN (no skip): K.EQ.30
    SKIP_NEXT_IF_DIFFERENT [DIR_FORWARD
    jmp mbFacing              // AC == DIR_FORWARD (no skip): K.EQ.7
    SKIP_NEXT_IF_DIFFERENT [DIR_LEFT
    jmp mbFacing              // AC == DIR_LEFT (no skip): K.EQ.36
    SKIP_NEXT_IF_DIFFERENT [DIR_RIGHT
    jmp mbFacing              // AC == DIR_RIGHT (no skip): K.EQ.37
    SKIP_NEXT_IF_DIFFERENT [DIR_OUT
    jmp mbInOut               // AC == DIR_OUT (no skip): K.EQ.11
    SKIP_NEXT_IF_DIFFERENT [DIR_IN
    jmp mbInOut               // AC == DIR_IN (no skip): K.EQ.19
mbCompass,
    // K.GE.43.AND.K.LE.50 -- adven.dat numbers E/W/N/S/NE/SE/SW/NW
    // contiguously, and this is the ONLY place in the port that may
    // assume anything about the ordering of a direction code.
    sub [DIR_EAST             // AC = curDir - 43
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp mbCantApply           // AC < 0 (no skip): below 43 -- not a compass word
    sub [DIR_NW-DIR_EAST+1    // AC = curDir - 51
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp mbCantApply           // AC >= 0 (no skip): above 50 -- not a compass word
mbNoWay,                      // AC < 0 (skip): 43..50, falls through
    lac [msg_NO_WAY_DIRECTION:1]
    jmp moveStayT             // f4 50: print, then fall to 2000 and roll (TASK-FR22)
mbInOut,
    lac [msg_IN_FROM_OUT:1]
    jmp moveStayT
mbFacing,
    lac [msg_UNSURE_FACING:1]
    jmp moveStayT
mbWhichWay,
    lac [msg_WHICH_WAY:1]
    jmp moveStayT
mbCantApply,
    lac [msg_CANT_APPLY:1]
    jmp moveStayT
mbRemote,                     // f4 50's "IF(VERB.EQ.FIND.OR.VERB.EQ.INVENT)SPK=59"
    lac [msg_FIND_REMOTE:1]
    jmp moveStayT

// NULL / NOWHE -- adven.f4 1005, the first of label 8's four word-level
// exceptions: "IF(K.EQ.NULL)GOTO 2", above the travel scan and above the
// OLDLOC/OLDLC2 shift, so the turn stays put, the dwarves act and the
// room is described. moveStay IS label 2 in this port (doCave and the
// magic words reach it the same way). TASK-FR27 N13: the two words had no
// verb row at all before, so the game answered SORRY, I DON'T KNOW THE
// WORD "NULL".
doNull,
    jmp moveStay

// ---- inventory / objects (table-driven, see the object table near the
// end of this file and the findObj/checkDark routines above) -------------
doInventory,
    eem
    jmp i [doInventory:3] // wave 4A: body in bank 3 under the same name

doTake,
    eem
    jmp i [doTake:3]      // wave 3: body in bank 3 under the same name

doDrop,
    eem
    jmp i [doDrop:3]      // wave 3: body in bank 3 under the same name

// ---- THROW AXE (combat) / THROW BIRD (snake) -----------------------------
// If a dwarf is present this turn, resolve combat,
// otherwise behaves exactly like DROP.
doThrow,
    eem
    jmp i [doThrow:3]     // wave 3: body in bank 3 under the same name

// WAVE ROD while carrying the rod and standing at the fissure, either
// bank, R_FISSURE_EAST or R_FISSURE_WEST togglesfissureBridge, keeping its
// lockstep-derived complement fissureNoBridge in sync.
// Prints the tier-1/tier-2 asymmetric message (adven.f4 lines 1414-1421: PROP(FISSUR)=1-PROP
// (FISSUR) then PSPEAK(FISSUR,2-PROP(FISSUR))), forming the bridge,
// removing it prints tier 2 ("THE CRYSTAL BRIDGE HAS VANISHED!"), never the silent
// tier 0, a real source asymmetry, preserved exactly rather than simplified to a symmetric pair.
// WAVEing anything but the rod, or WAVEing the rod anywhere but the
// fissure, prints msg_WAVE_NO_EFFECT -- the sorce default
// (adven.f4 section 8, ACTSPK(9)=42, "NOTHING HAPPENS.").
// Not carrying the named object at all reuses this
// project's existing generic msg_NOT_CARRYING, same as every other
// transitive verb here (DROP/THROW).
doWave,
    eem
    jmp i [doWave:3]

// Attack dragon.
doAttack,
    eem
    jmp i [doAttack:3]    // wave 3: body in bank 3 under the same name

// Feed the bear.
doFeed,
    eem
    jmp i [doFeed:3]      // wave 3: body in bank 3 under the same name

// dwarfHereScan -- AC=1 iff a live dwarf is in curRoom (f4 5110/8012:
// DLOC(I).EQ.LOC .AND. DFLAG.GE.2). jsp style; clobbers AC.
dwarfHereScan,
    local rtn, dhsPtr, dhsIx
    dac rtn 
    lac dwarfStage
    sub [2
    SKIP_NEXT_IF_AC_NOT_NEGATIVE   // skip when >= 2 (dwarves active)
    jmp dhsNo
    law dwarfLoc
    dac dhsPtr
    dzm dhsIx
dhsScan,
    lac dhsIx
    SKIP_NEXT_IF_DIFFERENT [5
    jmp dhsNo                 // all five checked, none here
    lac i dhsPtr
    SKIP_NEXT_IF_SAME curRoom      // skip when this dwarf is here
    jmp dhsNext
    law 1
    jmp i rtn
dhsNext,
    idx dhsPtr
    idx dhsIx
    jmp dhsScan
dhsNo,
    cla
    jmp i rtn
rtn, 0
dhsPtr, 0
dhsIx, 0
    endloc

// EAT -- FOOD: destroyed, msg 72. The creature
// roster (bird/snake/clam/oyster/dwarf/dragon/troll/bear): msg 71.
// Any other known object present: ACTSPK(EAT) = msg 110 (same text as
// msg_FEED_BEAR_DEAD). Presence per branch (f4's upstream 5000/5110).
doEat,
    eem
    jmp i [doEat:3]       // wave 2: body in bank 3 under the same name

// SAY -- Echoes the word (OKAY, "xxx"); the magic
// words XYZZY/PLUGH/PLOVER are forwarded to their real handlers
// instead (f4 9035's vocab 62/65/71; 2025 FEE...). SAY alone
// echoes "SAY" itself, exactly as f4's WD2=0 fallback does.
doSay,
    eem
    jmp i [doSay:3]       // wave 2: body in bank 3 under the same name

// RUB -- (f4 9160): LAMP -> msg 75 (ACTSPK(RUB)); any other known
// object present -> msg 76.
doRub,
    eem
    jmp i [doRub:3]       // wave 2: body in bank 3 under the same name

// BRIEF -- (f4 8260): msg 156, then
// short text always once a room has been visited (see enterRoom), and
// DETAIL jumps to 3 so LOOK stops apologizing.
doBrief,
    lac nounTok
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (no noun -- f4 4080 index 26)
    jmp dbrOnWhat             // AC != 0: 4090 index 26 -> 2011, ACTSPK 155
    law 1
    dac briefFlag
    law 3
    dac detailCnt
    lac [msg_BRIEF_OK:1]
    jmp pmsgT
dbrOnWhat,                    // see doHours above for the whole of N13's list
    lac [msg_FR8_ON_WHAT:1]
    jmp pmsgT

// CAVE -- f4 label 40, lines 1139-1141: above ground msg 57, underground msg 58.
// f4's LOC.LT.8 positional predicate reimplemented as the explicit per-room SURFACE flag.
doCave,
    lac ROOM_CACHE + ROOMTAB_FLAGS
    IS_SURFACE
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip (surface-flagged) -- check the grate exception
    jmp dcvUnder                       // not surface-flagged (not skipped): underground
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_GRATE     // skip (curRoom != R_GRATE) -- genuinely surface
    jmp dcvUnder                            // curRoom == R_GRATE (not skipped): msg-58 fidelity fix
// f4 40 ends "GOTO 2", so CAVE is a label-2 path: message, dwarf turn, room
// (TASK-FR26 N3). It is one of the four motion words that do NOT shift
// OLDLOC (label 8's own exception list), which is why doCave is reached
// without going through doMove.
dcvSurface,                                  // surface-flagged and not the grate (skipped through both checks)
    lac [msg_CAVE_SURFACE:1]
    jmp moveStayT
dcvUnder,
    lac [msg_CAVE_UNDER:1]
    jmp moveStayT

// doSpeak -- shared handler for the one-message vocabulary words
// (SESAME family/TREES/DIG/LOST/MIST/etc.): the verbTab row's argument
// column carries the message record and vtHit has already parked it in
// curDir.
doSpeak,
    lac curDir
    jmp pmsgT

doInfo,
    lac [msg_INFO_1:1]
    jda pmsg
    lac [msg_INFO_2:1]
    jmp pmsgT

// ---- TASK-FR7 7a: the three missing action verbs ------------------------
//
// NOTHING -- adven.dat 2005, verb 5. Both dispatch tables send it to the
// same place: 4080 index 5 and 4090 index 5 are both 2009, which is
// "K=54" and falls into 2011's RSPEAK. So the word is a no-op that
// answers OK, with or without an object, and adven.dat section 8 gives
// verb 5 the default 0 precisely because 2009 supplies its own.
//
// "With or without an object" needs no code here: a named object has
// already been through objPresenceGate, so NOTHING VASE at the End of
// Road answers msg 60 and never arrives -- which is 5000's own answer in
// the source too, since 2800 sends VASE to 5000 like any other noun.
doNothing,
    lac [msg_OK:1]
    jmp pmsgT

// CALM / PLACATE / TAME -- adven.dat 2010, verb 10. 4090 index 10 is
// 2011, so the transitive form is nothing but ACTSPK(CALM), section 8's
// row "10 14". 4080 index 10 is 8000, the "<verb> WHAT?" question, which
// is verbWhat here.
doCalm,
    lac nounTok
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (an object was named)
    jmp verbWhat              // AC == 0: f4 4080 index 10 -> 8000
    lac [msg_CALM_DEFAULT:1]  // msg 14
    jmp pmsgT

// DRINK -- adven.dat 2015, verb 15. adven.f4 9150, whole:
//
//   9150 IF(OBJ.EQ.0.AND.LIQLOC(LOC).NE.WATER.AND.(LIQ(0).NE.WATER
//        1   .OR..NOT.HERE(BOTTLE)))GOTO 8000
//        IF(OBJ.NE.0.AND.OBJ.NE.WATER)SPK=110
//        IF(SPK.EQ.110.OR.LIQ(0).NE.WATER.OR..NOT.HERE(BOTTLE))GOTO 2011
//        PROP(BOTTLE)=1
//        PLACE(WATER)=0
//        SPK=74
//        GOTO 2011
//
// SPK on entry is ACTSPK(DRINK) = msg 73, so the fall-through case is
// "drink from the stream" and only the bottle case overrides it with 74.
//
// TASK-FR7 7a called the liquid dependency "the real work", because at
// the time the port's rooms carried none of adven.dat section 9's LIQLOC
// bits. They do now: S11's liquidAtRoom (TASK-FR20 C10) is LIQLOC, all
// seven water rooms and the one oil room, so what is left is the shape of
// the source's own three tests. Reusing it also means DRINK and the gate
// agree about where water is, which a second room-compare copy would not
// guarantee.
doDrink,
    lac nounTok
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (an object was named)
    jmp ddrNoNoun             // AC == 0: OBJ == 0
    lio nounTok               // "IF(OBJ.NE.0.AND.OBJ.NE.WATER)SPK=110"
    lac [voc_water:2
    jda strCmpEq
    lem                       // strCmpEq returns with eem on
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (some other object)
    jmp ddrHaveWater          // AC != 0: the word IS "WATER"
    lac [msg_DRINK_NOT_WATER:1]        // msg 110
    jmp pmsgT
ddrNoNoun,                    // the first IF's three clauses
    jsp liquidAtRoom          // bank-0 resident, same bank -- 0, 1 (water), 2 (oil)
    SKIP_NEXT_IF_DIFFERENT [1
    jmp ddrHaveWater          // AC == 1 (no skip): LIQLOC(LOC) is water
    jsp ddrBottleWater
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when the bottle is here with water in it
    jmp verbWhat              // neither: f4's GOTO 8000, "DRINK WHAT?"
ddrHaveWater,                 // the third IF's remaining two clauses
    jsp ddrBottleWater
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when the bottle is here with water in it
    jmp ddrFromStream         // AC == 0: SPK is still ACTSPK(DRINK)
ddrEmptyBottle,
// PROP(BOTTLE)=1 and PLACE(WATER)=0, as the three stores this port keeps
// in step wherever the bottle empties (pouEmptyBottle, pdRevive):
// bottleProp is the state doFill/doPour/doInventory read, objLoc[WATER]
// is what the room lister would otherwise place in the room, and
// objHereMsg[BOTTLE] is the line it prints. objLoc[OIL] needs no store --
// ddrBottleWater has just established that bottleProp was 0, so the oil
// slot is already at its own nowhere sentinel.
    law 1
    dac bottleProp
    law WATER_NOWHERE
    dac OBJ_LOC(OBJ_WATER)
    lac [msg_HERE_BOTTLE_EMPTY:1]
    fardac(FAR_OBJ_HEREMSG(OBJ_BOTTLE))
    lac [msg_FR8_BOTTLE_NOW_EMPTY:1]   // msg 74
    jmp pmsgT
ddrFromStream,
    lac [msg_FR8_DRINK_STREAM:1]       // msg 73
    jmp pmsgT
// ddrBottleWater -- f4's "LIQ(0).EQ.WATER .AND. HERE(BOTTLE)", which 9150
// asks twice. AC != 0 when the bottle is within reach and what is in it is
// water. jsp style, bank 0, same bank only, clobbers AC.
ddrBottleWater,
    dap ddrbwRtn
    lac bottleProp            // LIQ(0): 0 = water, 1 = empty, 2 = oil
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (water)
    jmp ddrbwNo               // AC != 0: empty, or oil
    lac OBJ_LOC(OBJ_BOTTLE)   // HERE(BOTTLE) = TOTING or AT
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (not carried -- try the room)
    jmp ddrbwYes              // AC == 0: TOTING(BOTTLE)
    SKIP_NEXT_IF_SAME curRoom // skip when it is lying in this room
    jmp ddrbwNo               // somewhere else entirely
ddrbwYes,
    law 1
    jmp ddrbwRtn
ddrbwNo,
    cla
ddrbwRtn, jmp 0

doBack,
    eem
    jmp i [doBack:3]      // wave 2: body in bank 3 under the same name

// doFoo -- all five words (FEE/FIE/FOE/FOO/FUM) dispatch here; the
// verbTab argument column carries each word's k (1..5, adven.dat
// specials 3001-3005), parked in curDir by vtHit. The sequence test is
// f4's own: the previous word's k was stored positive, negated by the
// per-turn dance in turnLoop (see there), so "continues correctly"
// means foobar == 1-k bit-for-bit (one's complement: cma(k-1) and
// law 1; sub k produce identical patterns). foobar is transient --
// f4 doesn't persist it either.
doFoo,
    eem
    jmp i [doFoo:3]       // wave 2: body in bank 3 under the same name

doRead,
    eem
    jmp i [doRead:3]      // current bank -> 3; body under the same name there

// FIND -- (f4 9190): carried -> msg 24; lying here (or a live dwarf,
// f4 9192) -> msg 94; anywhere else -> ACTSPK(FIND) = msg 59. The
// liquid clauses need water/oil object slots. CLOSED is F9.
doFind,
    eem
    jmp i [doFind:3]      // wave 2: body in bank 3 under the same name

// BLAST --  adven.f4 9230/1692-1697). Outside
// CLOSED, always ACTSPK(BLAST) = msg 67 (no dynamite exists in this
// build outside the endgame). While closed, the three-way bonus:
//   bonus = 133 (default -- ROD2 left at the OTHER end from you)
//   bonus = 134 if curRoom == R_REPOSITORY_NE (f4: LOC.EQ.115)
//   bonus = 135 if HERE(ROD2) (f4: HERE(ROD2) -- carried or in curRoom),
//     checked LAST so it overrides 134 too, matching the source's own
//     sequential IF/IF/IF (not IF/ELSEIF) shape.
// f4's own guard "PROP(ROD2).LT.0" (ROD2 doesn't exist yet) is dead
// weight in this build: closed can only become nonzero via
// closedTransport, which unconditionally places ROD2 first -- so
// checking `closed` alone is equivalent and simpler (see OBJ_ROD2's own
// comment). Prints msg BONUS, exits to scoring via pgDone (pmsgD).
doBlast,
    eem
    jmp i [doBlast:3]     // wave 2: body in bank 3 under the same name

doWake,
    eem
    jmp i [doWake:3]      // wave 2: body in bank 3 under the same name

doBreak,
    eem
    jmp i [doBreak:3]     // wave 2: body in bank 3 under the same name

// ---- lamp (ON / OFF) -----------------------------------------------------
doLampOn,
    eem
    jmp i [doLampOn:1]    // current bank -> 1; body under the same name there

doLampOff,
    eem
    jmp i [doLampOff:1]

// ---- grate lock/open state (UNLOCK / LOCK / OPEN / CLOSE) ----------------
// All four act on the grate directly, no noun required, but an optional noun
// is still accepted.
// the verb-chain compare only ever looks at verbTok, never nounTok.
//
// UNLIKE ON/OFF, though, all four require actually being at the grate.
doUnlock,
    jsp checkGrateClosing
    eem
    jmp i [doUnlock:1]

doLock,
    jsp checkGrateClosing
    eem
    jmp i [doLock:1]

// ---- XYZZY -----------------------------------------------------------
// Magic word, not a normal verb: from the Building it's a shortcut to the
// Debris Room and back.
// From anywhere else, the classic put-down.
doXyzzy,
    eem
    jmp i [doXyzzy:3]     // wave 2: body in bank 3 under the same name
// (xyElsewhere and the xyGo teleport tail moved with it)

// ---- PLUGH -------------------------------------------------------------
// Second magic word, same shape as XYZZY above, but three rooms
// instead of two: from Y2 OR the Nugget Room, it's a shortcut to the
// Building; from the Building, it always returns to Y2 (the canonical
// anchor -- there's no ambiguity about which underground room to land in,
// since PLUGH is a fixed two-way magic word, not "return to wherever you
// last plugh'd from"). The Nugget Room is included deliberately, not just Y2.
doPlugh,
    eem
    jmp i [doPlugh:3]     // wave 2: body in bank 3 under the same name

// ---- PLOVE ---------------------------------------------------------------
// Third magic word, between Y2 and the Plover
// Room -- adven.dat word 71, adven.f4 lines 1053-1064 ("TRAVEL 301/302").
// Unlike XYZZY/PLUGH, carrying the emerald changes what happens at the
// Y2<->Plover pair specifically: TRAVEL 302 drops it at the player's
// current location first, then treats the move as if it wasn't being
// carried at all (adven.f4's own "HAVING DROPPED IT, GO BACK AND PRETEND
// HE WASN'T CARRYING IT AFTER ALL"). This is PLOVE's one genuine
// difference from PLUGH/XYZZY, the ONLY way to actually carry the
// emerald out of the Plover Room is the Alcove tunnel.
// PLATINUM has no such restriction, adven.f4's travel-table rows for LOC 33/100 only ever
// special-case the emerald specifically, object 59, and passes through
// PLOVE exactly like PLUGH's Y2<->Building pair does.
// Also works from the Dark-Room straight back to the Plover Room
// (adven.dat "101 100 46 71 11") -- but with NO emerald check at all,
// since the source's Dark-Room row has no TOTING(EMRALD)-conditional
// variant. This is deliberate, not an oversight: the Dark-Room is already
// on the far side of the Alcove tunnel's gate, so PLOVE from there isn't
// smuggling anything past it the way Y2<->Plover would.
// Falls through to the same xyElsewhere "put-down" (msg_NOTHING_HAPPENS,
// F11) everywhere else, matching XYZZY/PLUGH's own elsewhere case.
doPlove,
    eem
    jmp i [doPlove:3]     // wave 2: body in bank 3 under the same name

doFill,
    eem
    jmp i [doFill:1]

doPour,
    eem
    jmp i [doPour:1]

doQuit,
    eem
    jmp i [doQuit:3]      // wave 4A: body in bank 3 under the same name

tlConnDrop,
    lem
    dzm connOk
    jmp pgDone

pgDone,
// Score-report prologue. Every real exit (pmsgD/pmsgD1, playerDied's
// third-death and closing-death paths, QUIT/SCORE-yes) reaches here;
// scoreGame's normal/exit mode computes the full score (honoring gaveUp)
// and prints "YOU SCORED..."/the class tier/the next-rating line itself.
    lem
    lac connOk
    SKIP_NEXT_IF_AC_ZERO            // skip when connOk == 0 (dead connection -- no report)
    jmp pgReport
    jmp pgDoneTail
pgReport,
    lio [1                          // mode 1 = normal/exit: full score + printed report
    eem
    jsp i [scoreGame:2]
    lem
pgDoneTail,
rtn, jmp 0
vtPtr, 0                     // GLOBAL (TASK-PARSER-WORDORDER) -- shared by
                              // vtScan/vtHit/doGo/uvWhatDo; see vtScan's header
demoShort, 0                 // scratch for the live-fetched wcShort value
    endloc

// Includes that are code go here by convention.


// Print helpers -- one shared copy of the farjda(advPrintMsg:1) calling
// sequencem, 3 words per site.
// All three take the message-record address in AC -- a msgtab record or
// a ROOM_CACHE/exit-row doublet address, anything advPrintMsg accepts.
// All three clobber AC and IO.
//
// blkLin -- TASK-FR34, 04-Sep-26. This port's adven.f4 BLKLIN
// (COMMON /BLKCOM/, initialised .TRUE. at adven.f4:50). Nonzero means
// "print a blank line ahead of the next message and ahead of the next
// read of input". The original has exactly two emission points -- SPEAK
// (advn2.f4:4-26), which PSPEAK, RSPEAK and MSPEAK all funnel through,
// and GETIN (advn2.f4:95) -- and this port has the same two, advPrintMsg
// and readCmd. NOTHING ELSE MAY EMIT ONE. A blank line added at a call
// site is how the next message added to the game silently loses its
// spacing; every message inherits it from advPrintMsg instead.
//
// Cleared and restored in exactly two places, both so that a run of
// consecutive lines reads as one block rather than double-spaced:
// doInventory's item loop (adven.f4:1621-1623) and wzMaint, the wizard
// MAINT dialogue (advn2.f4:450/485).
blkLin, 1

// pmsg -- print one drum message, then return to the caller.
// Call via jda pmsg.
// No return value.
pmsg, 0
    local rtn
    dap rtn
    lac pmsg
    farjda(advPrintMsg:1)
    lem     // farjda no longer turns eem off
rtn, jmp 0
    endloc

// pmsgFar -- print-and-CONTINUE for CROSS-BANK callers.
pmsgFar, 0
    local rtn
    dac rtn
    lac pmsgFar         // forward the deposited record address
    jda pmsg
    eem
    jmp i rtn
rtn, 0
    endloc

// readCmdFar -- read one input line for CROSS-BANK callers.
readCmdFar,
    local rtn
    dac rtn
    jsp readCmd
    eem
    jmp i rtn
rtn, 0
    endloc

// pmsgT -- print one drum message, then end the turn.
// Entered via jmp with AC = the message-record address; never returns,
// continues at turnLoop.
pmsgT,
    farjda(advPrintMsg:1)
    lem     // farjda no longer turns eem off
    jmp turnLoop

// pmsgD -- print one drum message, then end the game and the connection.
// Entered via jmp with AC = the message-record address; never returns,
// continues at pgDone.
pmsgD,
    farjda(advPrintMsg:1)
    lem     // farjda no longer turns eem off
    jmp pgDone

// moveStayT / moveStay -- the turn tail for a MOTION command that leaves
// the player where they are: a direction with no exit (label 50), a
// conditional row that printed its block message instead of moving
// (label 16's N>500 rows), the Plover carry gate (30100), the troll
// re-arm and refusal (30300). Every one of those ends "NEWLOC=LOC" and
// falls into label 2 -> 74 -> 2000, so the source rolls the dark-death
// roll for them too, on the unchanged LOC, AFTER the message has been
// printed. That ordering is why this is a tail and not a test at the
// head of moveBlocked: adven.f4 prints the "can't go" text first and the
// "YOU FELL INTO A PIT" text second.
// moveStayT enters with AC = a message-record address and prints it
// first; moveStay is the entry for a caller that has already printed.
// Neither returns -- both continue at turnLoop, or at playerDied if the
// roll hits. (TASK-FR22, 03-Sep-26.)
//
// TASK-FR26 N3 (S17, 04-Sep-26): the tail now finishes the source's label-2
// path instead of stopping at the message. "NEWLOC=LOC / GOTO 2" runs
// 71 (the dwarf-block scan, skipped because NEWLOC.EQ.LOC), 74 (the dwarf
// block -- turnCreatures), and 2000, which is the dark-death roll and then
// the room description with its every-fifth-turn long text and its ABB bump.
// So a refused move now answers "THERE IS NO WAY TO GO THAT DIRECTION."
// followed by "YOU'RE AT END OF ROAD AGAIN.", as the original does for every
// GOTO 2 path: msg 12/9/10/11/80 from moveBlocked, the message-only travel
// rows through dmBlocked, the dwarf's msg 2, the Plover carry gate, the troll
// re-arm, CAVE, LOOK, BACK's two refusals and a magic word with no row.
//
// ORDER IS THE SOURCE'S AND MATTERS: message, then dwarves, then the roll,
// then the text. f4 prints the "can't go" line at 50/16, the dwarf lines at
// 6000, and reaches 2000's WZDARK roll and SPEAK(KK) after both.
//
// The label-2 closing gate (RSPEAK(130) when NEWLOC < 9 while CLOSNG) is
// deliberately NOT replicated on this path. For a stay NEWLOC == LOC, so it
// could only fire for a player standing in a surface room while the cave is
// closing, and closing starts underground and the gate itself is what stops
// anyone reaching the surface afterwards -- there is no route to it. The
// moving case has it, in moveGo's mgGateCheck, where it is reachable.
//
// moveStayFar is the same entry for a bank-3 caller, which arrives with eem
// on (the far-jump convention) and must have it closed first.
moveStayFar,                  // no lem: farjda(advPrintMsg:1) below opens
moveStayT,                    //   the window itself, so a bank-3 caller's
    farjda(advPrintMsg:1)     //   eem-on arrival needs nothing closed first
    lem     // farjda no longer turns eem off
moveStay,
    jsp turnCreatures         // f4 74: the dwarves act, and print, first
    lem                       //   (dual-mode: returns with eem on)
    jsp darkDeathRoll         // f4 2000's WZDARK roll, on the unchanged room
    jsp enterRoom             // f4 2000/2001: short text, long every fifth
    jmp turnLoop

askYesNo,
    local rtn, quest
    dac rtn
    dio quest
ayAsk,
    lac quest
    SKIP_NEXT_IF_AC_ZERO           // skip when no question message
    jda pmsg
    jsp readCmd
    SKIP_NEXT_IF_AC_ZERO           // readCmd: AC != 0 = connection error
    jmp ayNo                  // treat a drop as NO -- caller proceeds to its end path
    newline                   // client echo has no line ending (same as turnLoop)
    jsp tokenize
    lac verbTok
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when a word was typed
    jmp ayAgain               // empty line -- reprompt
    lio verbTok
    lac [voc_yes:2]
    jda strCmpEq
    lem                       // strCmpEq returns with eem on
    SKIP_NEXT_IF_AC_ZERO
    jmp ayYes
    lac [voc_y:2]
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_ZERO
    jmp ayYes
    lac [voc_no:2]
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_ZERO
    jmp ayNo
    lac [voc_n:2]
    jda strCmpEq
    lem
    SKIP_NEXT_IF_AC_ZERO
    jmp ayNo
ayAgain,
    lac [msg_PLEASE_ANSWER:1]
    jda pmsg
    jmp ayAsk
ayYes,
    law 1
    jmp ayRtn
ayNo,
    cla
ayRtn,
    eem
    jmp i rtn
rtn, 0
quest, 0
    endloc

// wzGetWord --  cross-bank-safe.
// Returns the RAW first token's address in wzWordAddr, bank-0,
// one-char-per-word, null-terminated in IO or 0 if the
// line was empty or the connection reported an error.
// Overwrites cmdbuf/verbTok/nounTok, same as askYesNo.
// Call via farjsp(wzGetWord) from cross-bank or plain jsp same-bank.
// =======================================================================
wzGetWord,
    local rtn
    dac rtn
    jsp readCmd
    SKIP_NEXT_IF_AC_ZERO           // readCmd: AC != 0 = connection error
    jmp wgwNone                // treat a drop as "no token"
    newline                    // client echo has no line ending (same as askYesNo)
    jsp tokenize
    lac verbTok
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when a word was typed
    jmp wgwNone                  // AC == 0 (no skip): empty line -- no token
wgwGot,                             // AC != 0 (skipped): word typed -- falls through here
    dac wzWordAddr                 // store the token's bank-0 address
    jmp wgwDone
wgwNone,
    dzm wzWordAddr
wgwDone,
    eem
    jmp i rtn
rtn, 0
    endloc
wzWordAddr, 0

// wzReadLine -- a raw whole-line/ reader for MAINT/MOTD's free-text prompts.
//   out: wzLineBuf (null-terminated, one char/word), AC = 0 success /
//        1 = connection error (readCmd's own contract)
//
// EEM IS ON FOR THE WHOLE OF THIS ROUTINE, and wrlStore depends on it.
// Both call sites use farjsp (bank 2), whose macro is "eem; jsp i [a]"
// -- the callee is entered with eem still set -- and nothing here
// or in getach issues lem. That is what lets the buffer live in bank 3
// (TASK-BANK0 B-3, 05-Sep-26): ptr carries a full 16-bit address and
// every indirect through it resolves cross-bank. Do NOT add an lem to
// this routine, and do not call it with a plain jsp from bank 0 -- the
// stores would then land at the same OFFSET in bank 0.
// =======================================================================
wzReadLine,
    local rtn, ptr
    dac rtn
    lac [wzLineBuf:3]          // was "law wzLineBuf" while the buffer was
    dac ptr                       // bank-0-resident; law is 12 bits and
                                     // cannot carry the bank (B-3)
wrlLoop,
    dac i [getach:3]        // getach is bank 3 (Task 1); this routine
    jsp i [getach:3+1]      //   already runs eem-on end to end
    lai
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp wrlLoop          // stray null byte -- ignore, wait for the next one
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp wrlErr             // negative -- getach reported a connection error

    SKIP_NEXT_IF_DIFFERENT [BS
    jmp wrlBksp
    SKIP_NEXT_IF_SAME [DEL
    jmp wrlCk1

wrlBksp,
    lac ptr
    SKIP_NEXT_IF_DIFFERENT [wzLineBuf:3
    jmp wrlLoop             // buffer already empty -- nothing to erase
    sub [1
    dac ptr
    law SP
    lia
    tcb
    law BS
    lia
    tcb
    jmp wrlLoop

wrlCk1,
    SKIP_NEXT_IF_DIFFERENT ['\r'
    jmp wrlTerm
    SKIP_NEXT_IF_DIFFERENT ['\n'
    jmp wrlTerm

    sub ['a']
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp wrlStore
    add ['A']
    lia

wrlStore,
    lac ptr
    SKIP_NEXT_IF_DIFFERENT [wzLineBuf:3+0d99     // last word we're willing to use (one word free for the terminator)
    jmp wrlLoop            // buffer full -- discard this character
    dio i ptr
    idx ptr
    jmp wrlLoop
wrlTerm,
    dzm i ptr
    cla
    jmp i rtn
wrlErr,
    law 1
rtn, jmp 0
ptr, 0
    endloc
// playerDiedAt -- TASK-FR30 N32, 04-Sep-26. Alternate entry for the ONE
// death whose drop room is not the room the player died in. AC = that
// room; everything else enters at playerDied below.
//
// f4 99's drop loop uses "K=OLDLC2", and every path that reaches 99 has
// just set OLDLC2 to the room the port already has in curRoom:
//   * label 84 (dwarf knife) and label 90 (dark pit) both do OLDLC2=LOC;
//   * the two forced-room deaths (LOC 20, the broken neck; LOC 21, the
//     fissure jump) reach 99 via "2000 IF(LOC.EQ.0)GOTO 99", and the
//     forced room's own pass through label 8 has just set OLDLC2 to the
//     room the player stepped off FROM -- LOC 14 and LOC 17/27. This
//     port never moves the player into those two rooms at all, so
//     curRoom is still that same room;
//   * label 30310 (the bear crossing) is the exception: OLDLC2=NEWLOC,
//     the FAR bank, which the port has nothing standing in.
// Entered with eem off (mccBearDeath's jda pmsg leaves it off); the lem
// is belt-and-braces, matching playerDied's own.
playerDiedAt,
    lem
    dac pdDropRoom
    jmp pdCheckClosing
playerDied,
    lem                 // normalize (bank-1 arrivals have eem on)
    lac curRoom
    dac pdDropRoom      // f4 84/90: OLDLC2=LOC -- drop where he died
pdCheckClosing,
    lac closing
    SKIP_NEXT_IF_AC_ZERO            // skip (closing == 0) -- ordinary reincarnation flow below
    jmp pdClosingDeath                 // closing != 0 (not skipped): final death, no offer
pdOrdinary,                              // closing == 0 (skipped): falls through -- ordinary flow
    lac numDie
    add [obitTab
    dac pdTmp
    lio i pdTmp         // IO = the obituary question's record address
    lac numDie
    add [reviveTab
    dac pdRevPtr        // resolve the Y-reply NOW: f4 builds BOTH message
                        //   numbers from NUMDIE inside the YES() call, i.e.
                        //   before the increment below moves it
    jsp askYesNo
    lem
    dac pdYea           // the answer -- idx below loads what it stored, so
                        //   it would otherwise clobber it
// CLAUDE 04-Sep-26 (TASK-FR30 N31): adven.f4 99 reads
//   YEA=YES(81+NUMDIE*2,82+NUMDIE*2,54)
//   NUMDIE=NUMDIE+1
//   IF(NUMDIE.EQ.MAXDIE.OR..NOT.YEA)GOTO 20000
// -- the increment sits BETWEEN the question and the test, so a death is
// tallied on both answers. This port counted it only on YES, so declining
// reincarnation left numDie at its old value and scoreGame's survival term
// (MAXDIE-NUMDIE)*10 paid 30 instead of 20: ten free points for dying and
// giving up. pdClosingDeath below already had its own idx (f4 95).
    idx numDie
    lac pdYea
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when YES
    jmp pdGameOver            // NO: "OK", game over (f4's Z-reply, msg 54)
    lac i pdRevPtr
    jda pmsg                  // the matching Y-reply (82/84/86)
    lac numDie
    SKIP_NEXT_IF_DIFFERENT [3      // skip while lives remain
    jmp pgDone                // third death: 86 was the goodbye (f4 NUMDIE==MAXDIE)
pdRevive,
// TASK-FR23 C26 (03-Sep-26), NARROWED by TASK-FR30 N34 (04-Sep-26):
// adven.f4 label 99's first two statements after the reincarnation is
// agreed are "PLACE(WATER)=0 / PLACE(OIL)=0" and nothing else. They come
// BEFORE the drop loop on purpose -- PLACE 0 is the source's "nowhere",
// so the WATER/OIL pseudo-objects are not among the things the loop puts
// down in the death room.
//
// C26 read that as "the bottle is emptied" and also stored bottleProp=1
// and the empty here-msg. It is not: PROP(BOTTLE) is untouched at 99, and
// PROP is what every visible bottle test in the source reads (LIQ(0) is
// derived from it). A player who died carrying a bottle of water finds a
// bottle of water again. Those two stores are gone; the two objLoc stores
// stay, and they are exactly what keeps resyncLiquidObjLoc's invariant
// true across the death -- the bottle is about to be put down in a room,
// and "not carried" means both liquid slots read NOWHERE.
    law WATER_NOWHERE
    dac OBJ_LOC(OBJ_WATER)
    law OIL_NOWHERE
    dac OBJ_LOC(OBJ_OIL)
    lac OBJ_LOC(OBJ_LAMP)
    SKIP_NEXT_IF_AC_ZERO           // skip when the lamp is carried
    jmp pdDropAll             // not carried: leave it wherever it is
    dzm lampOn                // f4: IF(TOTING(LAMP))PROP(LAMP)=0...
    law R_ROAD
    dac OBJ_LOC(OBJ_LAMP)     // ...and it lands outside the building (LOC 1)
pdDropAll,
    law objLoc
    dac pdPtr
    dzm pdIx
pdDropLoop,
    lac pdIx
    SKIP_NEXT_IF_DIFFERENT [NOBJS
    jmp pdRelocate            // every slot processed
    lac i pdPtr
    SKIP_NEXT_IF_AC_ZERO           // skip when this object is carried
    jmp pdDropNext            // not carried -- leave it
    lac pdDropRoom            // f4 99's "K=OLDLC2" -- see playerDiedAt's header
    dac i pdPtr
pdDropNext,
    idx pdPtr
    idx pdIx
    jmp pdDropLoop
pdRelocate,
    law R_BUILDING            // f4: LOC=3 -- wake up in the well house
    dac curRoom
// TASK-FR26 N4 (S17, 04-Sep-26): f4 99 is "LOC=3 / OLDLOC=LOC / GOTO 2000",
// so a reincarnated player's previous room is the building itself and BACK
// answers msg 91 instead of walking to wherever they died. OLDLC2 is
// deliberately NOT touched here: 99 leaves it alone (it was just used as the
// drop room), and TASK-FR26's own repair note, which said to shift it, is
// wrong -- rule 6, the Fortran decides. Note the destination is 2000, not 2,
// so reincarnation runs no dwarf turn; that falls out of turnCreatures being
// called from the label-2 paths only.
    dac prevRoom
    lio curRoom
    jsp loadRoom
    ROOM_CACHE                // address where loadRoom puts the room data
    jsp enterRoom
    jmp turnLoop
pdGameOver,
    lac [msg_OK:1]
    jmp pmsgD
pdClosingDeath,
    idx numDie
    lac [msg_CLOSING_DEATH:1]
    jmp pmsgD
numDie, 0
pdTmp, 0
pdPtr, 0
pdIx, 0
pdDropRoom, 0        // f4's OLDLC2 AS THE DEATH SEES IT -- the room the
                        // drop loop puts everything carried down in. Set at
                        // whichever of the two entry points was used; never
                        // read anywhere else.
pdRevPtr, 0          // reviveTab slot, resolved before numDie is bumped
pdYea, 0             // askYesNo's answer, held across that bump
obitTab, msg_OBIT1:1
         msg_OBIT2:1
         msg_OBIT3:1
reviveTab, msg_REVIVE1:1
           msg_REVIVE2:1
           msg_REVIVE3:1

// panicOnce --  adven.f4 628-632/1350-1353.
// Shared "first panic" tail for the CLOSNG gates that can trip PANIC
// (surface move in moveGo; UNLOCK/LOCK GRATE default path via
// checkGrateClosing): "IF(.NOT.PANIC) CLOCK2=15; PANIC=.TRUE." -- clock2
// is force-set to 15 only on the FIRST gate trip; every later trip is a
// no-op (panicked stays 1 permanently once set -- there is no un-panic
// path). No argument, no return value.
// =======================================================================
panicOnce,
    local rtn
    dap rtn 
    lac panicked
    SKIP_NEXT_IF_AC_ZERO           // skip (fall through -- first trip) when panicked == 0
    jmp rtn                          // panicked != 0 (not skipped): already panicked -- no-op
poFirst,                               // panicked == 0 (skipped): falls through -- first trip
    law 0d15
    dac clock2
    law 1
    dac panicked
    jmp rtn
rtn, jmp 0
    endloc

// checkGrateClosing -- adven.f4 1350-1353.
// Gates UNLOCK/LOCK's grate path (curRoom is the Grate or Below the
// Grate -- atGrate's own location test, replicated below since atGrate
// itself is bank-1-internal-only; AND no noun, or the noun GRATE) while
// closing: msg 130, panic-once, turn ends HERE -- the bank-1 body
// (doUnlockGrate/doLockGrate) is never entered in that case.
//
// If closing == 0, if the player is not at the grate, or if the noun is
// anything but the grate, returns normally (AC/IO clobbered, same as
// findObj) and the caller proceeds into the ordinary cross-bank
// dispatch. Never returns when it gates the turn. jsp style, bank 0,
// same-bank only. See TASK-FR32 S-8 at cgcCheckGrate below for why the
// noun test is a whitelist rather than the exemption list it was.
checkGrateClosing,
    local rtn
    dap rtn
    lac closing
    SKIP_NEXT_IF_AC_NOT_ZERO      // skip (closing == 0) -- return, nothing to check
    jmp rtn                          // closing == 0 (not skipped): return -- ordinary dispatch
cgcCheckLoc,                            // closing != 0 (skipped): falls through -- location gate
                                            // first (atGrate's own check, replicated here since
                                            // atGrate itself is bank-1-internal-only)
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_GRATE
    jmp cgcClassify               // AC == R_GRATE (not skipped): at the grate -- classify below
cgcCheckBelow,                          // AC != R_GRATE (skipped): falls through -- check the other room
    lac curRoom
    SKIP_NEXT_IF_DIFFERENT [R_BELOW_GRATE
    jmp cgcClassify               // AC == R_BELOW_GRATE (not skipped): at the grate -- classify
cgcNotAtGrate,                          // AC != R_BELOW_GRATE (skipped): falls through -- not at
                                            // the grate at all -- exempt entirely, ordinary dispatch
    jmp rtn
cgcClassify,                            // at the grate -- classify the noun
    lac nounTok
    SKIP_NEXT_IF_AC_NOT_ZERO      // skip (a noun WAS given) -- classify it
    jmp cgcGate                      // no noun (not skipped): grate-default -- gate it
cgcClassifyNoun,                        // a noun was given (skipped): falls through -- classify it
    lio nounTok
    jsp findObj
    lem
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip (AC != 0, a known object) -- is it the grate?
    jmp rtn                           // AC == 0 (not skipped): DWARF or KNIFE, the two
                                          // pseudo-nouns the gate lets through -- f4 leaves
                                          // SPK at ACTSPK(UNLOCK) for those too
// TASK-FR32 S-8 (S19, 05-Sep-26). This used to name the objects that are
// EXEMPT and gate everything else, which is the wrong way round.
// adven.f4 9040 reads
//
//     IF(OBJ.EQ.GRATE.OR.OBJ.EQ.CHAIN)SPK=31
//     IF(SPK.NE.31.OR..NOT.HERE(KEYS))GOTO 2011
//     IF(OBJ.EQ.CHAIN)GOTO 9048
//     IF(.NOT.CLOSNG)GOTO 9043
//
// -- so the closing refusal is reached only once SPK has been narrowed to
// 31, i.e. only for the grate (the chain, the one other word that gets
// there, is taken off to 9048 the line before). Every other noun keeps
// ACTSPK(UNLOCK) = msg 33, "I DON'T KNOW HOW TO LOCK OR UNLOCK SUCH A
// THING.", and no closing test runs at all. `UNLOCK LAMP` at the grate
// while it was closing answered msg 130 AND forced clock2 to 15, which
// spends the panic countdown on a word the source never looks at.
cgcCheckGrate,                           // known object (skipped): only the grate gates
    lac objLocPtr
    SKIP_NEXT_IF_DIFFERENT [OBJ_LOC(OBJ_GRATE)
    jmp cgcGate                          // it's the grate (no skip): gate it
    jmp rtn                              // anything else: ordinary dispatch, msg 33
cgcGate,
    lac OBJ_LOC(OBJ_KEYS)
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when != 0 (not carried -- check the room)
    jmp cgcGateFire                  // == 0 (no skip): carried -- keys here, gate fires
    SKIP_NEXT_IF_SAME curRoom      // skip when the keys lie in this room
    jmp rtn                          // neither carried nor here: ordinary dispatch (no-keys reply)
cgcGateFire,
    lac [msg_CLOSED_EXIT:1]
    jda pmsg
    jsp panicOnce
    jmp turnLoop
rtn, jmp 0
    endloc

// ---------------------------------------------------------------------
// DCS2 channel-0 server control block: ascii mode (no dcfflex), telnet,
// echo, server. Listens on port 2030.
// ---------------------------------------------------------------------
advctl, dcftel dcfecho dcfsrv
        0d2030

// Object table -- parallel arrays, NOBJS entries each (see the #define
// near the top of this file), walked generically by findObj/doTake/
// doDrop/doInventory instead of one-off code per object. Index 0 is the
// keys, index 1 is the lamp; a later stage adding object N+1 just bumps
// NOBJS and appends one row to each array below.
//   objNames   -- address of each object's vocabulary word (reuses the
//                 same voc_* words TAKE/DROP already parse against)
//   objLoc     -- each object's current room number, or 0 = carried;
//                 reset at the start of every game by newGame, not by
//                 the initializers below (see the am1-syntax note on
//                 initializers only applying once, at cold load)
//   objTake    -- 1 if the object can be picked up, 0 if it's scenery
//   objInvMsg  -- address of the short drum message doInventory prints
//                 for this object when it's being carried
//   objHereMsg -- address of the short drum message printObjHere prints
//                 when this object is lying in curRoom (objLoc == curRoom)
//   objTreasure -- 1 if the object counts as a treasure for the troll's
//                 THROW-any-treasure toll.
#include "Includes/adv_objloc.ac"
#include "Includes/adv_objtake.ac"

// objDropSeq -- printObjHere's description-order key, one word per object,
// smallest printed first (TASK-FR31 N41).
//
// adven.f4 keeps a per-room linked list, ATLOC(LOC)/LINK(OBJ): advn2's
// DROP PREFIXES an object onto its room's list (advn2 361-362, "LINK(OBJ)=
// ATLOC(WHERE); ATLOC(WHERE)=OBJECT") and CARRY unlinks it, so the room
// description lists the most recently dropped thing FIRST and everything
// still in its original placement in object order behind it -- f4 392-397
// runs the initial placement loop BACKWARDS precisely to get that starting
// order out of a routine that prefixes. This port has no per-room list; it
// walks the flat objLoc array, so it carries the ordering as a sort key
// instead. newGame seeds slot i with i (the source's initial order) and
// bumpDropSeq hands a dropped object a key one lower than every other, so
// it sorts to the front. The keys are compared, never counted, so their
// absolute values do not matter; they only ever decrease, one per drop,
// which an 18-bit word outlasts by three orders of magnitude more drops
// than a game can contain.
objDropSeq,
    table NOBJS

// Condition table.
// condFlagAddrs is doMove's small, hand-maintained dispatch table,
// indexed by the condition ID stored in a ROOM_CACHE exit entry, word +2 of each exit.
// Index 0 is an unused placeholder, condition ID 0 always means "unconditional"
// and is never looked up/ here.
// Iindex N holds the core address of the flag word condition ID N gates on.
// This table's order MUST stay in sync with Adventure/AdvRoomLoader/advroomloader.c's condTable[],
//(and hence with the COND_* values adv_roomtab.ah emits.
// Adding a new conditional-exit mechanism means adding one entry here AND one matching
// entry to condTable[] in the same order.
//
// This indirection exists because the room compiler runs before
// adventure.am1 is assembled, so it cannot know grateOpen/pastSnake's
// eventual core addresses, those don't exist yet at the time the drum
// room table is built, unlike message addresses (adv_msgtab.ah's
// values, which are stable and already resolved by then.
condFlagAddrs, 0            // index 0 unused -- condition ID 0 is "unconditional", never looked up
               grateOpen     // COND_GRATE_OPEN (0d1)
               pastSnake     // COND_SNAKE (0d2) -- blocked exit: allowed once nonzero.
               OBJ_LOC(OBJ_NUGGET)      // COND_NUGGET_TRAP (0d3) -- the nugget's objLoc entry: 0 if
                               // carried, else a room number.
               0               // index 4 unused -- COND_RAND (0d4, advroomloader.c's
                               // COND_RAND_ID) is special-cased in doMove's dmRand branch
                               // before ever reaching this table; this slot only exists to
                               // keep the flat condFlagAddrs+id arithmetic aligned
               fissureBridge // COND_FISSURE_BRIDGE (0d5). Set by doWave; gates
                               // OVER/ACROSS/EAST-or-WEST/CROSS at both R_FISSURE_EAST and
                               // R_FISSURE_WEST directly (flag set = the real crossing/no
                               // effect, flag unset = blocked with msg_FISSURE_NO_CROSS)
               fissureNoBridge // COND_FISSURE_NO_BRIDGE (0d6). The lockstep
                               // complement of fissureBridge above, kept in sync by doWave.
                               // Gates JUMP's self-loop row (msg_FISSURE_JUMP) at both fissure
                               // rooms -- doMove's condFlagAddrs only ever tests a flag
                               // directly, never inverted, so JUMP/FORWARD (which need the
                               // opposite polarity from OVER/ACROSS/EAST/WEST/CROSS) use this
                               // derived flag instead. FORWARD's own fatal-fall case is NOT
                               // gated through condFlagAddrs at all -- see doMove's
                               // dmFissureDeathCheck/dfdCheckBridge, which reads
                               // fissureNoBridge directly, hardcoded like dmDarkDeath
               trollGone     // COND_TROLL_GONE (0d7). Set by checkTrollPayment
                               // once the troll's toll is paid; gates the chasm's ACROSS/
                               // CROSS/NE-or-SW self-dest rows (flag set = harmless silent
                               // no-op via the self-dest row, flag unset = blocked with
                               // msg_TROLL_REFUSES-style text). The real OVER crossing is NOT
                               // gated through condFlagAddrs at all -- it needs a state change
                               // (trollCrossed) a plain boolean row can't express, so it's
                               // intercepted directly by doMove's movChasmCrossing, mirroring
                               // dfdCheckRoom/dfdCheckBridge's own FORWARD interception
               doorOiled     // COND_DOOR_OILED (0d8). Set by doPour's DOOR
                               // branch specifically on POUR OIL (not water). Gates
                               // R_DOORPASSAGE's NORTH/CAVER exit to R_WATERFALL (flag set =
                               // allowed, flag unset = blocked with msg_DOOR_RUSTY). Unlike
                               // R_WESTPIT's CLIMB (bespoke doMove code, two live
                               // destinations), this gate fits the plain boolean COND/MSG
                               // exit mechanism exactly -- one real destination, one
                               // block-and-stay message on failure
               0               // index 9 unused -- COND_MSG (0d9, advdataloader.h's
                               // COND_MSG_ID), the unconditional message-only row.
                               // Special-cased in doMove's dmMsgCheck before this table
                               // is indexed; the slot only keeps the flat
                               // condFlagAddrs+id arithmetic aligned, exactly as index 4
                               // does for COND_RAND
               0               // index 10 unused -- COND_RANDMSG (0d10), the weighted
                               // message-only row; likewise special-cased, in dmRandMsg

// Game state.
//
// THIS BLOCK IS THE SAVE RECORD. `var` allocates DOWNWARD in declaration
// order, so curRoom (declared first, highest address) and objTakePtr
// (near the bottom) are the two ends of svStateRec/rlStateRec, and
// SAVE_STATE_WORDS is derived from exactly those two symbols. Everything
// declared BETWEEN them is saved and restored; the five declared BELOW
// objTakePtr are not, and that is deliberate -- they are per-connection
// state, not game state.
//
// So: a new var added anywhere above objTakePtr JOINS the save record and
// grows the block by a word. That is the safe default (the alternative is
// losing a player's game silently, which is what a stale hand-counted
// length did to curRoom between S25 and 05-Sep-26). If a new var must NOT
// be saved, declare it below objTakePtr with the other five and say why.
// Either way, a change to this block's membership is a SAVE layout change
// and needs SAVE_MAGIC bumped in AdvDataLoader/advmagic.h.
var curRoom
var lampOn
var ea1On=0                 // this is a secret
var grateLocked
var grateOpen
var verbTok
var nounTok
// TASK-FR27 N8 -- adven.f4's VERB and OBJ, and the pair a reply arms for
// the next command. parseVerb is a bank-0 handler address (f4's verb
// index); parseObj is a token pointer, into pendObjBuf once it has
// survived a command. pgOk promotes keep* into parse* and clears keep*,
// which is where f4's 2012 lives in this port.
//
// These four ARE save-state, by position: they sit above objTakePtr, so
// the record covers them. Their first draft's comment said the opposite
// ("f4 does not persist VERB or OBJ across a SUSPEND either"), which is
// wrong on the mechanism -- f4's SUSPEND is a core-image save (advn2.f4's
// CIAO, "REMINDER TO SAVE NEW CORE IMAGE"), so VERB and OBJ survive it
// like every other word of memory. It is moot in both programs anyway:
// f4 resumes at 8305 with K=NULL, and this port's next pgOk promotes and
// clears. Corrected 05-Sep-26 -- and that belief is why SAVE_STATE_WORDS
// was not grown when these four were added; see its own comment.
var parseVerb
var parseObj
var keepVerb
var keepObj
var curToken                // RETIRED upstream but still needed as a save-state slot
var curDir
var pastSnake
var birdCaught
var dwarfStage
var nuggetFound
var everKilledDwarf
var dwarvesRemaining
var dwarfSeen
// TASK-FR32 S-7 (06-Sep-26).  adven.f4's DSEEN(6) and ODLOC(6) for the
// pirate.  The five DWARVES already have these -- dwarfSeen is a bitmask
// and dwarfPrevLoc a table, both driven by bank 1's dwMoveOne, whose
// escort branch IS 6016's "he sticks with us".  The pirate is DLOC(6) in
// the source and is moved by the same loop, but he is NOT one of this
// port's five: extending the tables to six would put him in every
// dwarvesRemaining count, attack tally and knife roll that loops over
// them, which adven.f4 avoids with 6016's own "IF(I.NE.6)GOTO 6027".  So
// he gets his own two words here, with dwMoveOne's shape rather than its
// storage.
//
// pirateSeen  -- DSEEN(6): he has spotted the player and is following.
// piratePrevLoc -- ODLOC(6): the room he was in on the PREVIOUS turn he
//   was here.  While he follows, DLOC(6) is just curRoom, so no word is
//   needed for it; this one exists for 729's ODLOC(6).NE.DLOC(6) test,
//   which is what makes the rustle fire only on turns the player MOVED.
//   0 before his first sighting, and R_PIRATECHEST after a robbery --
//   never equal to a room the player can be robbed in, so a fresh
//   sighting always reads as "he moved".
//
// Both are above objTakePtr, so they are save state, per this block's own
// rule.  SAVE_MAGIC was bumped 0x7A73 -> 0x7A74 for them.
var pirateSeen
var piratePrevLoc
var lampLimit
var lampWarned
var fissureBridge
var fissureNoBridge
var dragonDead
var trollGone
var trollCrossed
var trollBypassed
var bearFed
var bearDead
var chasmDestroyed
var vaseBroken
var bottleProp
var plantProp
var plantDisplayProp
var doorOiled
var turns
var tally
var tally2
var clock1
var clock2
var closing
var panicked
var closed
var instrHinted
var oysterHinted
var batteryUsed
var repoHiddenBottle
var repoHiddenPlant
var repoHiddenOyster
var repoHiddenLamp
var repoHiddenRod
var repoHiddenSnake
var repoHiddenBird
var repoHiddenCage
var repoHiddenRod2
var repoHiddenPillow
// oysterNagPending was here until TASK-FR15 15a (06-Sep-26). It was the
// port's hand-armed one-shot for adven.f4 857's PROP(OYSTER).LT.0; the
// faithful 860 sweep in turnLoop runs that test itself, once a turn,
// against the flag it is about to clear, so the word had nothing left to
// carry. Removing it SHRANK the save record by one word -- SAVE_MAGIC
// bumped 0x7A74 -> 0x7A75 in AdvDataLoader/advmagic.h for it, per this
// block's own rule above.
var objLocPtr
var objTakePtr
var gaveUp
var demoGame
var bonus
var connOk=1
var knfloc
// TASK-FR15 15a's sweep scratch. BELOW objTakePtr on purpose, per this
// block's rule: they live for the length of one tlRepoSweep walk and are
// meaningless outside it, so saving them would be saving noise.
var rsTabP                  // walks rsRepoTab, two words at a time
var rsFlagP                 // pair word 1: the repoHidden flag's address
var rsObjP                  // pair word 0: the objLoc slot's address

// The currently-active room is fetched into this  when a room is entered.
// This avoids keeping the entire set of room definitions in memory,
// which would be far too expensive.
ROOM_CACHE,
    table ROOMTAB_RECORDSIZE
dwarfLoc,
    table 5
dwarfPrevLoc,
    table 5
cmdbuf,             // Buffer for the user's input.
    table CMDBUF_WORDS  // ...of which the last eight words are pendObjBuf and
                    // are NOT input space -- see CMDBUF_LAST's own comment
                    // at the top of this file

dwarfBitMask, 1
              2
              4
              0d8
              0d16

// TASK-FR15 15a. adven.f4 860's DO 2604 sweep, driven from turnLoop.
// Ten {objLoc slot address, repoHidden flag address} pairs -- the ten
// objects closedTransport's PUT list places with a negative prop, which
// are the only objects in the game that ever have one. Each pair names
// its flag by symbol, so nothing here depends on the order the
// repoHidden* vars happen to occupy in memory. rsRepoTabEnd is the walk's
// terminator: the loop compares its pointer against this label rather
// than counting, so adding or removing a pair needs no other edit.
rsRepoTab,    OBJ_LOC(OBJ_BOTTLE)
              repoHiddenBottle
              OBJ_LOC(OBJ_PLANT)
              repoHiddenPlant
              OBJ_LOC(OBJ_OYSTER)
              repoHiddenOyster
              OBJ_LOC(OBJ_LAMP)
              repoHiddenLamp
              OBJ_LOC(OBJ_ROD)
              repoHiddenRod
              OBJ_LOC(OBJ_SNAKE)
              repoHiddenSnake
              OBJ_LOC(OBJ_BIRD)
              repoHiddenBird
              OBJ_LOC(OBJ_CAGE)
              repoHiddenCage
              OBJ_LOC(OBJ_ROD2)
              repoHiddenRod2
              OBJ_LOC(OBJ_PILLOW)
              repoHiddenPillow
rsRepoTabEnd,

// WIZCOM persistence.
// Struct definition and POOF defaults live in BANK 2.
// These two routines are the bank-0 drum-transfer glue.
wizComLoad,
    local rtn, wclRtn
    dac rtn
    law wcMagicRec
    jda drumRead              // read the marker first -- don't touch WIZCOM state yet
    farlac(wcValid:2)
    SKIP_NEXT_IF_DIFFERENT [WIZCOM_MAGIC]
    jmp wcHaveRec              // branch 1 (equal): a WIZCOM record exists
wcNoRec,                        // branch 2 (different): never saved -- apply POOF defaults
    farjsp(wcApplyPoof:2)
    lem     // now turn eem off, the return leaves it on
    jmp wclRtn
wcHaveRec,
    law wcDataRec
    jda drumRead
    law wcMotdRec              // second transfer: MOTD's 222 words, same track,
    jda drumRead                 // immediately following the core record (bank 1
                                     // dest -- see WC_MOTD_OFFSET's own comment)
wclRtn,
    eem
    jmp i rtn
rtn, 0
    endloc

wcMagicRec,   WIZCOM_TRACK
              WC_MAGIC_OFFSET
              1
              wcValid:2            // read straight into the bank-2 field; no bank-0 scratch needed
wcDataRec,    WIZCOM_TRACK
              WC_DATA_OFFSET
              WC_DATA_WORDS
              wcWkdayLo:2           // bank-2 core address, same pattern as hintedTab:2/seenTab:2
wcMotdRec,    WIZCOM_TRACK
              WC_MOTD_OFFSET
              WC_MOTD_WORDS
              wcMotd:1              // bank-1 dest -- MOTD's own bank-2-capacity-driven
                                       // relocation, see wcMotd's own header comment

wizComSave,
    local rtn
    dac rtn
    law wcSaveDataRec
    jda drumWrite              // write all real WIZCOM fields first
    law wcSaveMotdRec
    jda drumWrite              // MOTD's own 222-word extension, same track (bank 1 source)
    law wcSaveMagicRec
    jda drumWrite              // written last: marks the WIZCOM record complete
    eem
    jmp i rtn
rtn, 0
    endloc

wcSaveDataRec, WIZCOM_TRACK
               WC_DATA_OFFSET
               WC_DATA_WORDS
               wcWkdayLo:2
wcSaveMotdRec, WIZCOM_TRACK
               WC_MOTD_OFFSET
               WC_MOTD_WORDS
               wcMotd:1
wcSaveMagicRec, WIZCOM_TRACK
               WC_MAGIC_OFFSET
               1
               wcValidSrc
wcValidSrc,    WIZCOM_MAGIC       // bank-0 constant source, same shape as svMagicSrc

variables
constants

// Bank 1 holds overflow code that won't fit in bank 0.
// Note that there are significant restrictions to what can be here
// and still be used from bank 0.
bank 1
0/

// advPrintMsg -- print a message stored on the drum.
// Call via farjda(advPrintMsg:1), AC = address of a 2-word record, track and word offset,
// then a packed (padCount<<12)|wordCount value (see advtextloader.c's
// packSixbit/emission code) to match what advtextloader wrote to the drum.
// Since the argument block is always fetched via indirection, this will
// work with bank 0 data since the passed address has its bank part always 0.
// Uses the fixed scratch buffer advMsgTmp, sized ADVSCRATCH_WORDS words.
// Every message's word count MUST stay under this size.
// The drum transfer below uses the message's real word count with no
// bounds check against advMsgTmp's actual size.
// The invocation from bank 0 will have left extended memory enabled, but
// reenable for safety.
//
advPrintMsg, 0
    local rtn, rawCount, msgPad, msgWords, charCnt
    addlocal apmHaveMsg, apmNoBlank
    farenter(rtn)       // leaves eem OFF -- the eem below reopens it

// TASK-FR34 (blkLin), 04-Sep-26. This routine is the port's SPEAK, so the
// blank line the original prints ahead of every message is emitted here,
// once, and not at the sixty-odd call sites.
//
// THE ORDER IS THE SOURCE'S AND MATTERS. advn2.f4:4-26 takes its two
// early returns FIRST -- "IF(N.EQ.0)RETURN" and the '>$<' placeholder
// test -- and only then reaches "IF(BLKLIN)TYPE 2". A blank line emitted
// ahead of the null test would leave a stray blank line behind wherever a
// message is suppressed, which would be a new defect, not a fix.
//
// Only the first of the two tests is needed here. The '>$<' placeholders
// never enter this port's corpus at all -- advdataloader drops them, see
// Audits/FUNCTIONALITY-REPORT.md's "correctly omitted" counts -- so no
// record exists for one to arrive with. The null case IS reachable: an
// object whose objHereMsg is 0 is deliberately silent (see printObjHere's
// pohPrint, and OBJ_MIRROR's comment on the tier-000 convention), and
// until now each caller guarded that itself. Testing it here as well is
// what SPEAK does, and it is what makes the blank line safe regardless of
// which site calls in.
    lac advPrintMsg     // word 0: the record ADDRESS, SPEAK's N (direct,
                        //   same bank, so no eem needed for this one)
    SKIP_NEXT_IF_AC_ZERO
    jmp apmHaveMsg      // AC != 0 (no skip): a real record -- print it
    farrtn(rtn)         // AC == 0 (skip): no message at all, and NO blank line
apmHaveMsg,
    farlac(blkLin:0)    // the flag lives in bank 0; farlac leaves eem off
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp apmNoBlank      // blkLin == 0 (no skip): suppressed, mid-block listing
    newline             // blkLin != 0 (skip): advn2.f4:26's "TYPE 2" blank line
apmNoBlank,
    eem                 // we want it on for now, need to get from bank 0
    lac i advPrintMsg   // word 0 of the record, track and offset ready to use
    ior [drmrd
    lia
    dia                 // issue read enable, this track, this offset
    idx advPrintMsg     // advance the record pointer to word 1, the count
    lac i advPrintMsg   // AC = (padCount<<12)|nwords
    dac rawCount        // stash it -- needed twice more below
    and [07777]         // AC = nwords (low 12 bits)
    lia                 // IO = nwords
    dwc                 // issue word count (nwords), no write
    lio [advMsgTmp:1]   // Need the full address here.
    dcl                 // issue bank 1, into advMsgTmp -- starts the transfer
    DRUM_WAIT_READY         // wait for the transfer to complete
    lem
    // Derive the exact character count txtsix needs: charCount =
    // 3*nwords - padCount. Plain shift/mask/add/sub throughout, not
    // `mul`/`div` -- this codebase deliberately avoids `mul` elsewhere
    // (see the WHY-NO-MUL notes later in this file: it's a Q1.17
    // fixed-point product, not a plain integer one), and `div`'s exact
    // register/pre-shift convention did not reproduce reliably in
    // isolated testing (Adventure/PendingRework/counttest.am1 -- first
    // attempt, since replaced), so this sticks to primitives already
    // proven correct rather than a plausible-looking guess.
    lac rawCount
    and [07777]         // AC = nwords (recomputed; IO was overwritten by
    dac msgWords        // the dcl transfer-address load above)
    add msgWords
    add msgWords        // AC = 3*nwords
    dac charCnt
    lac rawCount
    sar 6s
    sar 6s
    and [3]             // AC = padCount (0-2)
    dac msgPad
    lac charCnt
    sub msgPad          // AC = 3*nwords - padCount = the real character count
    lia                 // IO = character count (txtsix's count argument)
    law advMsgTmp       // AC = source address (txtsix's address argument)
    jda txtsix          // print directly from the packed buffer, no
                        // expansion copy -- see txtsix's own header
    farrtn(rtn)         // necessary for a inter-bank jda return
rtn, 0
rawCount, 0
msgPad, 0
msgWords, 0
charCnt, 0
    endloc

// txtsix -- print a sixbit-packed (3 chars/word) drum message directly,
// one character at a time, decoding (val+32) and substituting '_'
// (sixbit 077 octal / 63 decimal) with a literal newline (10).
//
// Called via jda -- AC holds the source (packed) address, deposited into
// the entry word and walked self-referentially, one word at a time.
// IO holds the EXACT character count to print, not word count.
// The caller must already have subtracted the trailing pad-slot count
// since sixbit 0 is a real character (space) and can't double as a self-terminating
// sentinel the way the ascii-directive format's null byte can.
// Assumes count >= 1, a real drum message never packs to 0 characters.
// Does not preserve AC or IO.
txtsix, 0
    local wordloop, charloop, trySlot1, gotF2, useF3, haveChar
    addlocal isUnderscore, notUnderscore, emit, checkDone, rtn
    addlocal count, f1, f2, f3, slot
    dap rtn
    lai                  // AC = char count (from IO)
    cma
    dac count            // count = -charCount, counts up to 0 via isp below

wordloop,
    lac i txtsix
    sar 6s
    sar 6s
    and [077            // sar sign-extends (preserves/replicates the
    dac f1               // original sign bit) -- the double shift alone
                         // isn't enough. f1 = bits 0-5 (first char)
    lac i txtsix
    sar 6s
    and [077
    dac f2               // f2 = bits 6-11 (second char)
    lac i txtsix
    and [077
    dac f3               // f3 = bits 12-17 (third char)
    idx txtsix           // advance the source pointer to the next word
    dzm slot

charloop,
    lac slot
    sza                  // skip (use f1) if slot == 0
    jmp trySlot1
    lac f1
    jmp haveChar
trySlot1,
    lac slot
    sad [1
    jmp gotF2            // no-skip (slot == 1): use f2
    jmp useF3            // skip (slot != 1, i.e. == 2): use f3
gotF2,
    lac f2
    jmp haveChar
useF3,
    lac f3
haveChar,
    sad [077
    jmp isUnderscore     // no-skip (AC == 077): the '_' sentinel
    jmp notUnderscore    // skip (AC != 077): an ordinary character
isUnderscore,
    law 0d10
    jmp emit
notUnderscore,
    add [0d32
emit,
    lia
    tcb
    isp count
    jmp checkDone         // no-skip (count still negative): keep going
    jmp rtn                // skip (count reached 0): done
checkDone,
    idx slot
    sad [3
    jmp wordloop          // no-skip (slot == 3): word exhausted, fetch next
    jmp charloop          // skip (slot != 3): more chars left in this word

rtn, jmp .
count, 0
f1, 0
f2, 0
f3, 0
slot, 0
    endloc

// Prints the 'if you quit now...' scoring message.
// Note the different return pattern.
// The value to print is in the IO register.
// Called via farjsp macro from bank 1, don't call from this bank!
printScore,
    local rtn, value, sawDigit, tensPlace, doTens, doOnes
    farenter(rtn)   // properly sets up the return
    sil 1s          // div expects this in bits 0-16
    dio value
// CLAUDE 04-Sep-26 (TASK-FR35): adven.f4:1706's FORMAT 8243 leading
// slash. After the dio (and after the sil, which works on IO): `newline`
// is law/lia/tcb and clobbers IO, and the score arrives there.
    newline
    law scoreMsg1
    jda txtasc
    dzm sawDigit
    lio value

    // The maximum score is 350, so only worry about 3 digits.
    // Nothing fancy, just 2 divides.
    // We only need the max score in the divident, so clear AC.
    // The AC will have the quotient, IO the remainder.
    // There won't ever be an overflow, so don't worry about it.
    cla
    div [0d100]
    nop             // No overflow possible.
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tensPlace   // Zero, suppress.
    idx sawDigit    // not zero, remember that and print.
    jda printDigit  // AC has the digit, leaves IO alone.
tensPlace,
    cla
    sil 1s          // as above
    div [0d10       // IO still has the remainder, the 10's and 1's place value.
    nop             // div bug, needs an extra cycle
    SKIP_NEXT_IF_AC_ZERO             // Zero check is more complex.
    jmp doTens      // We have a value.
    dac value       // save for a bit
    lac sawDigit    // A zero, but if we printed the 100's place, have to print here.
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp doOnes      // This is zero and 100's was zero, skip it
    lac value
doTens, jda printDigit
doOnes,
    lai             // always printed, 1's place still in IO
    jda printDigit
    law scoreMsg2   // finish the message
    jda txtasc

    farrtn(rtn)
rtn, 0
value, 0
sawDigit, 0
    endloc

// Print one numeric digit, value in AC, called via jda.
printDigit, 0
    local rtn
    dap rtn
    lac printDigit      // digit that was in ac
    add ['0']
    swp                 // we want to preserve IO
    tcb
    swp
rtn, jmp .
    endloc

// How we print a line of text.
#include <DCS/textascii.ac>

// Prints "THERE ARE n THREATENING LITTLE DWARVES IN THE ROOM WITH YOU."
// (FORMAT 67, the DTOTAL>1 branch). Count in IO.
printDwarfCountMsg,
    local rtn, value
    farenter(rtn)
    dio value
    law dwarfCountMsg1
    jda txtasc
    lio value
    law dwarfCountMsg2
    jda printCountMsg
    farrtn(rtn)
rtn, 0
value, 0
    endloc

dwarfCountMsg1, ascii "THERE ARE "
dwarfCountMsg2, ascii " THREATENING LITTLE DWARVES IN THE ROOM WITH YOU.\n"

// Prints "n msg".
// Example: 10 THREATENING LITTLE...
// The number is in IO, the message address in AC.
// Called via jda.
// Does not preserve AC or IO.
printCountMsg, 0
    local rtn
    farenter(rtn)
    lai
    jda printDigit
    lac printCountMsg
    jda txtasc
    farrtn(rtn)
rtn, 0
    endloc

attackCountMsg, ascii " OF THEM THROW KNIVES AT YOU!\n"

// Prints "n OF THEM GET YOU!" (FORMAT 68, the STICK>1 branch, only
// reachable from the ATTACK>1/K=6 path). Count in IO.
printStickCountMsg,
    local rtn
    farenter(rtn)
    lai
    jda printDigit
    law stickCountMsg
    jda txtasc
    farrtn(rtn)
rtn, 0
    endloc

stickCountMsg, ascii " OF THEM GET YOU!\n"

scoreMsg1, ascii "IF YOU WERE TO QUIT NOW, YOU WOULD SCORE "
scoreMsg2, ascii " OUT OF A POSSIBLE 350.\n"

// pmsgT1 / pmsgD1 -- bank-1 mirrors of bank 0's pmsgT/pmsgD tails:
// print via the same-bank advPrintMsg (no farjda composition needed),
// then leave for the bank-0 continuation. Entered via jmp with AC = the
// message-record address; never return. turnLoop/pgDone both begin with
// lem, so the extend state is normalized on arrival.
pmsgT1,
    jda advPrintMsg
    eem                   // farrtn left it on; explicit for the jump below
    jmp i [turnLoop:0]

pmsgD1,
    jda advPrintMsg
    eem
    jmp i [pgDone:0]

// pmsgDie1 -- bank-1 death tail: print AC's record, then the
// death/reincarnation flow (playerDied normalizes eem on entry).
// pdEnter1 is for sites whose text has already printed.
pmsgDie1,
    jda advPrintMsg
pdEnter1,
    eem
    jmp i [playerDied:0]

// lampTurn -- Runs once per player command, alongside dwarfTurn.
// Ports adven.f4 lines 884/887/888/889 and the 12200/12400/12600 handlers
// (1954-1969) in their original priority order: decrement while lit,
// then at most ONE of {just ran out, already-out-and-back-on-the-surface,
// low-battery warning} fires per turn, exactly like the original's
// GOTO-19999 short-circuit chain.
// If the gave-up ending fires, it jumps straight to pgDone (via pmsgD1).
//
// Called from bank 0 (turnLoop) via the section-13 cross-bank form:
// eem; jsp i [lampTurn:1]. No argument, no return value. Section-13
// callee shape: dac full-capture rtn, jmp i rtn with eem on.
lampTurn,
    local rtn, batLoc
    dac rtn

    lac i [lampOn:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ltCheckAutoReplace     // branch 1 (AC == 0, no skip): lamp is off -- nothing to decrement
                                   // branch 2 (AC != 0, skip): lamp is lit -- count it down
// TASK-FR31 N43: PROP(LAMP) guards adven.f4 884, the decrement, and
// NOTHING else. 885's auto-replace and 887/888/889 are all unconditional,
// so an unlit lamp skips only the countdown and still walks the rest of
// the chain -- which is how a player standing at the vending machine with
// the lamp switched off gets the batteries replaced (msg 188) instead of
// being told to go back for them.
    lac i [lampLimit:0]
    sub [1
    dac i [lampLimit:0]

ltCheckAutoReplace,
// adven.f4 885: IF(LIMIT.LE.30.AND.HERE(BATTER).AND.PROP(BATTER).EQ.0.AND.HERE(LAMP))GOTO 12000.
// Checked BEFORE ltCheckZero/ltCheckNegative/ltCheckWarn below, as an
// unconditional per-turn gate NOT latched by lampWarned.
// Firing this replaces the batteries and skips the rest of the chain entirely for
// this turn.
    lac i [lampLimit:0]
    sub [0d30
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp ltCheckZero                  // AC plus (no skip): lampLimit > 30 -- too early, ordinary chain below
                                          // AC zero/minus (skip): lampLimit <= 30 -- keep checking
    lac i [batteryUsed:0]
    SKIP_NEXT_IF_AC_ZERO                 // skip when AC == 0 (fresh, or doesn't exist yet)
    jmp ltCheckZero                  // AC != 0 (no skip): already used -- nothing to replace with
                                          // AC == 0 (skip): keep checking -- is HERE(BATTER) true?
    lac i [FAR_OBJ_LOC(OBJ_BATTERIES)]
    dac batLoc
    SKIP_NEXT_IF_AC_ZERO                 // skip when AC == 0 (carried -- HERE(BATTER) true)
    jmp ltARCheckBatteryLoose        // AC != 0 (no skip): not carried -- check if loose in curRoom
ltARHereLamp,                       // AC == 0 (skip, fallthrough): carried -- HERE(BATTER) true, check the lamp
    lac i [FAR_OBJ_LOC(OBJ_LAMP)]
    dac batLoc                          // reuse: LAMP's objLoc
    SKIP_NEXT_IF_AC_ZERO                 // skip when AC == 0 (carried -- HERE(LAMP) true)
    jmp ltARCheckLampLoose           // AC != 0 (no skip): not carried -- check if loose in curRoom
ltARReplace,                        // AC == 0 (skip, fallthrough): carried -- HERE(LAMP) true -- do the replace
// adven.f4 12000: CALL RSPEAK(188); PROP(BATTER)=1; IF(TOTING(BATTER))
// CALL DROP(BATTER,LOC); LIMIT=LIMIT+2500; LMWARN=.FALSE.
    lac [msg_LAMP_REPLACED:1]
    jda advPrintMsg
    law 1
    dac i [batteryUsed:0]
    lac [msg_BATTERIES_DISCARDED:1]
    crossBankdac(FAR_OBJ_HEREMSG(OBJ_BATTERIES), EEMOPEN)   // one window over the reads below
    lac i [FAR_OBJ_LOC(OBJ_BATTERIES)]
    SKIP_NEXT_IF_AC_ZERO                     // skip when AC == 0 (carried -- drop it at curRoom)
    jmp ltARLimitBump                    // AC != 0 (no skip): already loose here -- nothing to move
ltARDropHere,                        // AC == 0 (skip, fallthrough): carried -- drop it at curRoom
    lac i [curRoom:0]
    dac i [FAR_OBJ_LOC(OBJ_BATTERIES)]
ltARLimitBump,
    lac i [lampLimit:0]
    add [0d2500
    dac i [lampLimit:0]
    dzm i [lampWarned:0]
    jmp ltDone

ltARCheckBatteryLoose,                  // not carried -- is objLoc[BATTERIES] == curRoom?
    lac i [curRoom:0]
    sub batLoc
    SKIP_NEXT_IF_AC_ZERO                    // skip when AC == 0 (loose here -- HERE(BATTER) true)
    jmp ltCheckZero                      // AC != 0 (no skip): neither carried nor here -- HERE(BATTER) false
    jmp ltARHereLamp                      // AC == 0 (skip): loose here -- HERE(BATTER) true, check the lamp

ltARCheckLampLoose,                     // not carried -- is objLoc[LAMP] == curRoom?
    lac i [curRoom:0]
    sub batLoc
    SKIP_NEXT_IF_AC_ZERO                    // skip when AC == 0 (loose here -- HERE(LAMP) true)
    jmp ltCheckZero                      // AC != 0 (no skip): neither carried nor here -- HERE(LAMP) false
    jmp ltARReplace                       // AC == 0 (skip): loose here -- HERE(LAMP) true -- do the replace

ltCheckZero,
// adven.f4 887: IF(LIMIT.EQ.0)GOTO 12400 -- true exactly once, the turn
// the count first reaches 0.
    lac i [lampLimit:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp ltCheckNegative         // AC != 0 (no skip): not this turn -- keep checking
                                // AC == 0 (skip): just ran out -- handle it below

    sub [1
    dac i [lampLimit:0]         // adven.f4 1962: LIMIT=-1 -- a sentinel, not a decrement.
    dzm i [lampOn:0]
// TASK-FR31 N44: adven.f4 1964 is "IF(HERE(LAMP))CALL RSPEAK(184)", and
// HERE is TOTING .OR. AT -- so a lamp burning out where it lies is heard
// as well as one burning out in the player's hand. The old test was
// carried-only, which silently swallowed the line for a lit lamp left on
// the floor of the room the player is standing in.
    lac i [FAR_OBJ_LOC(OBJ_LAMP)]          // lamp's location: 0 = carried, else a room
    dac batLoc
    SKIP_NEXT_IF_AC_ZERO                      // skip when AC == 0 (carried -- HERE(LAMP) true)
    jmp ltRanOutCheckLoose   // AC != 0 (no skip): not carried -- is it lying here?
ltRanOutHere,                // AC == 0 (skip): carried -- print the message
    lac [msg_LAMP_DEAD:1]
    jda advPrintMsg
    jmp ltDone

ltRanOutCheckLoose,          // not carried -- is objLoc[LAMP] == curRoom?
    lac i [curRoom:0]
    sub batLoc
    SKIP_NEXT_IF_AC_ZERO                      // skip when AC == 0 (loose here -- HERE(LAMP) true)
    jmp ltDone               // AC != 0 (no skip): elsewhere -- HERE(LAMP) false, stay silent
    jmp ltRanOutHere         // AC == 0 (skip): loose here -- print the message

ltCheckNegative,
// adven.f4 888: IF(LIMIT.LT.0.AND.LOC.LE.8)GOTO 12600.
    lac i [lampLimit:0]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp ltCheckWarn              // branch 1 (AC plus/zero, no skip): not out yet -- keep checking
                                 // branch 2 (AC minus, skip): genuinely out -- check location
//  f4's "LOC.LE.8" positional predicate (adven.f4 888) reimplemented
// as the explicit per-room SURFACE flag. curRoom is still the loaded room her,
// ROOM_CACHE is valid, no cross-bank data read needed beyond what's already
// done elsewhere in this file (adventure.am1's doBack: lac i [ROOM_CACHE:0]).
// lampTurn's eem window is already open at this point.
    lac i [ROOM_CACHE:0 + ROOMTAB_FLAGS]
    IS_SURFACE
    SKIP_NEXT_IF_AC_NOT_ZERO     // skip (AC != 0, curRoom is surface) -- forced ending below
    jmp ltCheckWarn              // AC == 0 (not skipped): still in the cave
//  adven.f4 12600, GAVEUP=.TRUE.: the forced
// "gave up in the dark" ending is the THIRD of the three gaveUp sites
// cross-bank write, eem already on.
    law 1
    dac i [gaveUp:0]
    lac [msg_LAMP_GAVEUP:1]
    jmp pmsgD1

ltCheckWarn,
// adven.f4 889/1954-1959 (12200): IF(LIMIT.LE.30)GOTO 12200, latched by
// lampWarned/LMWARN so it only ever prints once.
// Reached again on every later turn too.
// LampLimit stays permanently <=30 once ltRanOut above
// has fired, but lampWarned is already 1 by then.
// lampLimit must cross 30 on the way down before it can ever reach 0 so this is a
// guaranteed no-op from then on, exactly matching the originals's
// LMWARN short-circuit.
    lac i [lampWarned:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp ltDone                    // AC != 0 (no skip): already warned -- nothing to do
                                      // AC == 0 (skip): not yet warned -- check the threshold
    lac i [lampLimit:0]
    sub [0d30
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp ltDone                    // branch 1 (diff plus, no skip): still above 30 -- nothing to do
                                      // branch 2 (diff minus or zero, skip): at or below 30 -- warn
// TASK-FR36 A1: adven.f4 12200 opens with TWO conditions --
// "IF(LMWARN.OR..NOT.HERE(LAMP))GOTO 19999" -- and the port implemented
// only the LMWARN half, so a lit lamp left in another room still drew
// its dim warning. HERE is TOTING .OR. AT (the function definitions at
// the top of adven.f4), the same reading TASK-FR31 N44 turned on at
// ltCheckZero.
// The gate belongs ABOVE the lampWarned store, and that is the whole
// point of the repair. LMWARN is a one-shot, so a warning the original
// suppresses is DEFERRED, not spent: LMWARN stays .FALSE. and the
// player is warned properly on a later turn, once the lamp is back in
// hand. Storing first and testing after would silence this turn and
// still burn the one-shot -- the real defect, which was that the true
// warning never arrived for the rest of the game.
// Order within the statement is free (neither f4 term has a side
// effect), so HERE is tested last: the jsp is then paid only on the one
// turn that would actually warn, not on every turn after it.
// ltCheckNegative above is NOT the same defect. adven.f4 888 is
// "IF(LIMIT.LT.0.AND.LOC.LE.8)GOTO 12600" -- no HERE term at all -- so
// the gave-up ending is right to fire for a lamp left behind, and was
// deliberately left ungated here.
    lio i [FAR_OBJ_LOC(OBJ_LAMP)]     // lamp's objLoc value in IO for ulHereTest
    jsp ulHereTest                    // the file's own HERE(obj) routine, exactly as
                                          // dloLampBody/dloffLampBody call it; AC = 1 when
                                          // carried or in curRoom, else 0
    SKIP_NEXT_IF_AC_NOT_ZERO          // skip when AC != 0 (HERE(LAMP) -- go on and warn)
    jmp ltDone                        // AC == 0: neither carried nor in this room -- silent,
                                          // and lampWarned is left untouched below, which is
                                          // what defers the warning instead of spending it
    law 1
    dac i [lampWarned:0]
//  adven.f4 1955-1958's real 3-way branch.
// SPK=187 default; IF(PLACE(BATTER).EQ.0)SPK=183; IF(PROP
// (BATTER).EQ.1)SPK=189, checked in that order, last true wins.
    lac i [FAR_OBJ_LOC(OBJ_BATTERIES)]
    sub [BATTERIES_NOWHERE
    SKIP_NEXT_IF_AC_NOT_ZERO             // skip when AC != 0 (batteries exist somewhere -- check batteryUsed)
    jmp ltWarnNeverFound              // AC == 0 (no skip): never created -- 183
ltWarnCheckUsed,                     // AC != 0 (skip): batteries exist -- check batteryUsed
    lac i [batteryUsed:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp ltWarnUsed                    // AC != 0 (no skip): already used -- 189
    lac [msg_LAMP_GO_BACK:1]              // AC == 0 (skip, fallthrough): fresh, exists elsewhere -- 187 (default)
    jmp ltWarnPrint
ltWarnNeverFound,
    lac [msg_LAMP_HINT_VENDING:1]      // 183
    jmp ltWarnPrint
ltWarnUsed,
    lac [msg_LAMP_NO_SPARES:1]         // 189
ltWarnPrint,
    jda advPrintMsg

ltDone,
    jmp i rtn           // eem is on (entry state; advPrintMsg keeps it on)
rtn, 0
batLoc, 0
    endloc

// checkCarryLimit -- the Fortran's 7-object carry cap.
// Counts carried objects (objLoc == 0) across the
// object table; 7 or more refuses the take with msg 92. Deliberately
// reproduced source quirk: the check guards only the PRIMARY carry --
// takeBirdCageBundle's secondary carry runs after it, so taking the
// caged bird at exactly 6 carried lands you at 8, exactly as f4's
// HOLDNG check does. Gone-object sentinels (AXE_NOWHERE/BIRD_GONE/
// etc.) are nonzero, so they never count.
//
// The WATER and OIL slots are skipped (TASK-FR28 N16, S21 05-Sep-26).
// They are not objects the player carries: adven.f4 increments HOLDNG in
// exactly one place (advn2.f4:319 CARRY), and a liquid never reaches it
// -- 9010's WATER/OIL branch substitutes OBJ=BOTTLE before 9017's
// HOLDNG test, and even death resets PLACE(WATER)=0, never -1. This
// port instead mirrors the liquid into objLoc[WATER]/objLoc[OIL] so the
// presence gate can find it (resyncLiquidObjLoc: carried exactly when
// the bottle is), which made a full bottle cost TWO of the seven slots
// and refuse the seventh object with msg 92 one take early.
//  No/ arguments. Returns AC=0 (room to carry) or AC=1 with msg 92 printed.
checkCarryLimit,
    local rtn, cclIx, cclPtr, cclCount
    dac rtn
    lac [objLoc:0]
    dac cclPtr
    dzm cclIx
    dzm cclCount
cclScan,
    lac cclIx
    SKIP_NEXT_IF_DIFFERENT [NOBJS
    jmp cclDone               // scanned every object (no skip on equal)
    SKIP_NEXT_IF_DIFFERENT [OBJ_WATER
    jmp cclNext               // the mirrored liquid slots are not HOLDNG (see header)
    SKIP_NEXT_IF_DIFFERENT [OBJ_OIL
    jmp cclNext
    lac i cclPtr
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when != 0 (not carried)
    idx cclCount              // carried -- count it
cclNext,
    idx cclPtr
    idx cclIx
    jmp cclScan
cclDone,
    lac cclCount
    sub [0d7
    SKIP_NEXT_IF_AC_NEGATIVE       // skip when < 0 (fewer than 7 carried)
    jmp cclFull               // >= 7: refuse (f4: IF(HOLDNG.LT.7)GOTO 9016)
    cla
    jmp i rtn                 // AC=0: proceed
cclFull,
    lac [msg_CARRY_LIMIT:1]
    jda advPrintMsg
    law 1
    jmp i rtn                 // AC=1: refused, message printed
rtn, 0
cclIx, 0
cclPtr, 0
cclCount, 0
    endloc

// Eord-echoing parser replies (f4 3000/5015/5199/8000, 9032) ------
// prtTok -- jsp helper: IO = token pointer (a verbTok/nounTok value --
// a bank-0 cmdbuf address, one character per word, null-terminated).
// Clobbers AC/IO.
prtTok,
    local ptkRtn, ptkPtr
    dap ptkRtn
    dio ptkPtr
ptkLoop,
    lac i ptkPtr
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip while there are characters left
    jmp ptkRtn            // 0: token done
    lia
    tcb
    idx ptkPtr
    jmp ptkLoop
ptkRtn, jmp 0
ptkPtr, 0
    endloc

// The echo tails. Entered from bank 0 via `lio <token>; eem;
// jmp i [pXxx:1]` or an in-bank jmp with eem on.
// Frames the token with its fixed prefix/suffix and ends the turn.
// petTok is shared scratch.
petGo,
    dio petTok
    lem
// CLAUDE 04-Sep-26 (TASK-FR35): the leading slash on all five of these
// formats -- adven.f4:919 (3001), 967 (5015), 992 (5199), 1212 (8002,
// the format the 8000 CALL A5TOA1 types with) and 1322 (9032). A slash
// is a record separator, so it means "do a newline, THEN print"; every
// one of the five arrives here, so one emission covers them all. It is
// unconditional -- not blkLin-gated (a FORMAT slash is unconditional in
// the source) and not conditional on the cursor. Placed after dio
// petTok because `newline` clobbers IO as well as AC, and after lem to
// match the file's other two newline sites.
    newline
    lac petPre
    jda txtasc
    eem
    lio petTok
    jsp prtTok
    lem
    lac petSuf
    jda txtasc
    eem
    jmp i [turnLoop:0]
petTok, 0
petPre, 0
petSuf, 0

pUnknownWord,             // f4 3000: SORRY, I DON'T KNOW THE WORD "xxx".
    law puwPre
    dac petPre
    law puwSuf
    dac petSuf
    jmp petGo
puwPre, ascii "SORRY, I DON'T KNOW THE WORD \042"
puwSuf, ascii "\042.\n"

pSeeNo,                   // f4 5199: I SEE NO xxx HERE.
    law psnPre
    dac petPre
    law psnSuf
    dac petSuf
    jmp petGo
psnPre, ascii "I SEE NO "
psnSuf, ascii " HERE.\n"

pWhatDo,                  // f4 5015: WHAT DO YOU WANT TO DO WITH THE xxx?
    law pwdPre
    dac petPre
    law pwdSuf
    dac petSuf
    jmp petGo
pwdPre, ascii "WHAT DO YOU WANT TO DO WITH THE "
pwdSuf, ascii "?\n"

pVerbWhat,                // f4 8000: xxx WHAT?
    law pvwPre
    dac petPre
    law pvwSuf
    dac petSuf
    jmp petGo
pvwPre, 0                 // empty prefix (txtasc prints nothing)
pvwSuf, ascii " WHAT?\n"

pSayOkay,
    law psoPre
    dac petPre
    law psoSuf
    dac petSuf
    jmp petGo
psoPre, ascii "OKAY, \042"
psoSuf, ascii "\042.\n"

// ---- lamp (ON / OFF) -- bank-1 bodies ------------------------------------
// Both verbs act on the lamp directly no noun needed.
// Entered from the bank-0 stubs of the same names via eem'd indirect
// jmp; never returns, every exit is a pmsgT1 tail to turnLoop.
doLampOn,
    lac i [nounTok:0]
    SKIP_NEXT_IF_AC_NOT_ZERO                     // skip when AC != 0 (a noun was given)
    jmp dloLampBody                // AC == 0: no noun -- straight to the lamp
dloCheckNoun,                        // AC != 0 (skip): a noun was given -- is it the panel?
    lio i [nounTok:0]         // token in IO for findObj (S3B)
    jsp i [findObj:0]         // section-13 cross-bank call; returns with eem
                                // on, which this bank-1 caller keeps
    SKIP_NEXT_IF_AC_NOT_ZERO                       // skip when AC != 0 (a known object)
    jmp dloLampBody                // AC == 0: not a known object -- falls through to the lamp
dloCheckPanel,                       // AC != 0 (skip): a known object -- objLocPtr points at its slot
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_EA1PANEL)
    jmp doEa1On                    // AC == objLoc+OBJ_EA1PANEL's slot (no skip): it IS the panel
                                       // else (skip, some OTHER known object): fall through to the lamp
dloLampBody,
    lio i [FAR_OBJ_LOC(OBJ_LAMP)]     // lamp's objLoc value in IO for ulHereTest
    jsp ulHereTest
    SKIP_NEXT_IF_AC_NOT_ZERO              // skip when AC != 0 (lamp is here)
    jmp dloNoLamp             // AC == 0: neither carried nor in the room
dloDeadCheck,                 // lamp is here -- dead battery?
    lac i [lampLimit:0]
    SKIP_NEXT_IF_AC_NEGATIVE              // skip when AC < 0 (dead -- refuse)
    jmp dloHaveLamp           // AC >= 0: juice left -- ordinary flow
    lac [msg_LAMP_DEAD:1]     // dead: msg 184, and do NOT light it
    jmp pmsgT1
// TASK-FR20 C13 (03-Sep-26, owner ruling: the "already" replies were not
// authorised). adven.f4 9070 is four statements after the HERE and dead-
// battery gates -- "PROP(LAMP)=1 / CALL RSPEAK(39)" -- with no test of
// the current state at all. ON with the lamp already lit prints msg 39
// again; there is no msg for "already on" anywhere in adven.dat. The
// dloAlreadyOn branch and its invented text are gone.
dloHaveLamp,                  // lamp is here and has juice -- light it, every time
    law 1
    dac i [lampOn:0]
// TASK-FR31 N38: adven.dat gives object 2 a prop-1 description, so a lit
// lamp lying on the floor reads "THERE IS A LAMP SHINING NEARBY." rather
// than the prop-0 brass-lamp line. The port carries one here-message per
// object, so PROP(LAMP)=1 is modelled by poking objHereMsg[LAMP]; newGame
// resets it, as it does for every other runtime-patched here-message.
    lac [msg_HERE_LAMP_LIT:1]
    crossBankdac(FAR_OBJ_HEREMSG(OBJ_LAMP), EEMOPEN)   // this body keeps one window throughout
    lac [msg_LAMP_ON:1]
    jda advPrintMsg
// TASK-FR28 N22: adven.f4 9070's last two statements are
// "IF(WZDARK)GOTO 2000" / "GOTO 2012". WZDARK is the darkness of the room
// as it stood when the command was READ (turnLoop's tlPrompt sets it), so
// lighting the lamp in a room the player could not see re-runs the whole
// description path -- and DARK(0) is false by then, so 2000 prints the
// room text and its object list instead of the pitch-dark line. The
// dark-death roll in 2000 cannot fire on this path for the same reason.
    lac i [wzdark:0]
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (the room was dark -- re-describe)
    jmp dloTurnDone           // AC == 0: the room was already lit -- f4's GOTO 2012
dloWasDark,                   // AC != 0: f4 9070's IF(WZDARK)GOTO 2000
    jsp i [enterRoom:0]       // dual-mode; returns with eem on
dloTurnDone,
    eem                       // explicit for the cross-bank jump below
    jmp i [turnLoop:0]
// TASK-FR28 N22: no lamp is 9070's "IF(.NOT.HERE(LAMP))GOTO 2011", and
// 2011 speaks SPK, which line 926 set from ACTSPK(VERB). adven.dat
// section 8 gives verbs 7 (ON) and 8 (OFF) a default of 38, "YOU HAVE NO
// SOURCE OF LIGHT."  The "YOU HAVE NO LAMP." this used to print is in no
// section of adven.dat.
dloNoLamp,
    lac [msg_FR8_NO_LIGHT_SOURCE:1]
    jmp pmsgT1

doLampOff,
    lac i [nounTok:0]
    SKIP_NEXT_IF_AC_NOT_ZERO                     // skip when AC != 0 (a noun was given)
    jmp dloffLampBody              // AC == 0: no noun -- straight to the lamp
dloffCheckNoun,                      // AC != 0 (skip): a noun was given -- is it the panel?
    lio i [nounTok:0]         // token in IO for findObj (S3B)
    jsp i [findObj:0]         // section-13 cross-bank call; returns with eem on
    SKIP_NEXT_IF_AC_NOT_ZERO                       // skip when AC != 0 (a known object)
    jmp dloffLampBody              // AC == 0: not a known object -- falls through to the lamp
dloffCheckPanel,                     // AC != 0 (skip): a known object -- objLocPtr points at its slot
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_EA1PANEL)
    jmp doEa1Off                   // AC == objLoc+OBJ_EA1PANEL's slot (no skip): it IS the panel
                                       // else (skip, some OTHER known object): fall through to the lamp
dloffLampBody,
    lio i [FAR_OBJ_LOC(OBJ_LAMP)]
    jsp ulHereTest
    SKIP_NEXT_IF_AC_NOT_ZERO              // skip when AC != 0 (lamp is here)
    jmp dloffNoLamp           // AC == 0: neither carried nor in the room
// TASK-FR20 C13, the OFF half: adven.f4 9080 is "PROP(LAMP)=0 / CALL
// RSPEAK(40)" with no state test either. Same removal as dloHaveLamp.
dloffHaveLamp,                // lamp is here -- put it out, every time
    dzm i [lampOn:0]
    lac [msg_HERE_LAMP:1]     // TASK-FR31 N38, the OFF half: back to object 2's
    crossBankdac(FAR_OBJ_HEREMSG(OBJ_LAMP), EEMOPEN)   // prop-0 brass-lamp line; window stays open
    lac [msg_LAMP_OFF:1]
    jda advPrintMsg
// TASK-FR28 N22: adven.f4 9080's "IF(DARK(0))CALL RSPEAK(16)" -- putting
// the lamp out in an unlit room warns that it is now pitch dark. checkDark
// is the port's DARK(0) and is read AFTER lampOn was cleared above, so it
// sees the room the player is now standing in.
    jsp i [checkDark:0]       // dual-mode, eem-neutral: the window stays open
    SKIP_NEXT_IF_AC_NOT_ZERO  // skip when AC != 0 (dark, no other light)
    jmp dloffTurnDone         // AC == 0: still lit -- nothing more to say
    lac [msg_PITCH_DARK:1]    // AC != 0: msg 16
    jda advPrintMsg
dloffTurnDone,
    eem                       // explicit for the cross-bank jump below
    jmp i [turnLoop:0]
dloffNoLamp,
    lac [msg_FR8_NO_LIGHT_SOURCE:1]   // ACTSPK(8) = 38, as for ON above
    jmp pmsgT1

// ---------------------------------------------------------------------
// Some secret stuff.
doEa1On,
    lio i [FAR_OBJ_LOC(OBJ_EA1PANEL)]
    jsp ulHereTest
    SKIP_NEXT_IF_AC_NOT_ZERO              // skip when AC != 0 (panel is here)
    jmp deoNotHere             // AC == 0: neither carried nor in the room
deoCheckOn,
    lac i [ea1On:0]
    SKIP_NEXT_IF_AC_ZERO                  // skip when AC == 0 (currently off -- turn on)
    jmp deoAlready            // AC != 0: already on
deoTurnOn,                    // AC == 0: currently off -- turn on
    law 1
    dac i [ea1On:0]
    lac [msg_EA1_BLINK:1]
    dac i [pmsgFar:0]              // print-and-continue via pmsgFar
    jsp i [pmsgFar:0+1]
    lac [msg_EA1_TYPING:1]
    dac i [pmsgFar:0]              // print-and-continue via pmsgFar
    jsp i [pmsgFar:0+1]
    lac [msg_GREETING:1]      // replay the start-of-session banner verbatim
    jmp pmsgT1
deoAlready,
    lac [msg_EA1_ALREADY:1]
    jmp pmsgT1
deoNotHere,
    lac [msg_NOT_HERE:1]
    jmp pmsgT1

doEa1Off,
    lio i [FAR_OBJ_LOC(OBJ_EA1PANEL)]
    jsp ulHereTest
    SKIP_NEXT_IF_AC_NOT_ZERO              // skip when AC != 0 (panel is here)
    jmp deoffNotHere           // AC == 0: neither carried nor in the room
deoffCheckOff,
    lac i [ea1On:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp deoffAlready         // branch 1 (AC == 0, no skip): already off
                                // branch 2 (AC != 0, skip): currently on -- turn off, resets the cycle
deoffTurnOff,
    dzm i [ea1On:0]
    lac [msg_EA1_OFF:1]
    jmp pmsgT1
deoffAlready,
    lac [msg_EA1_ALREADY_OFF:1]
    jmp pmsgT1
deoffNotHere,
    lac [msg_NOT_HERE:1]
    jmp pmsgT1

// Everywhere in this section: eem ON, kept on throughout (findObj and
// advPrintMsg both return with eem on).
// atGrate -- true if curRoom is the Grate, or Below the Grate.
// The grate itself is fixed scenery, not a carried object.
// UNLOCK/LOCK/OPEN/CLOSE only make sense from a room the grate is actually in.
// Both the Grate (above) and Below the Grate count, since
// the grate is the same physical object described from either side.
// Returns AC = 1 if curRoom is the Grate or Below the Grate,
// AC = 0 otherwise.
// Called via jsp -- BANK-1 INTERNAL ONLY (its only callers are the four
// grate verbs below, same-bank), so the section-5 dap pattern still
// applies; callers must have eem on for the curRoom fetch.
atGrate,
    local rtn
    dap rtn
    lac i [curRoom:0]
    SKIP_NEXT_IF_DIFFERENT [R_GRATE
    jmp agYes             // branch 1 (equal): at the Grate
                             // branch 2 (different): keep checking
    SKIP_NEXT_IF_SAME [R_BELOW_GRATE   // skip when below the Grate -- also counts
    jmp agNo                 // differs: not at either
agYes,                        // at the Grate, or (falling through) below the Grate
    law 1
    jmp rtn
agNo,
    cla
rtn, jmp 0
    endloc

// printGrateStatus -- after a room description prints, if curRoom is one
// of the grate's rooms, print a dynamic line reflecting the grate's actual
// lock/open state.
// Called cross-bank from enterRoom/doLook (bank 0).
//
// THREE rooms, not one (TASK-FR31 N36). adven.dat section 7 gives the
// GRATE the row "3 8 9" -- two-placed, at the depression (LOC 8) AND in
// the chamber beneath it (LOC 9), with adven.f4 402's CALL DROP(K+100,
// FIXD(K)) putting the fixed copy at 9 -- so the source prints the grate's
// prop text under BOTH descriptions. adven.f4 1923's FOO=PUT(GRATE,116,0)
// then places it at the repository's SW end for the endgame, deliberately
// with a non-negative prop ("LEAVE THE GRATE WITH NORMAL PROPERTY", f4
// 1921), so it prints there too; R_REPOSITORY_SW is reachable only through
// closedTransport, and startClosing has already put the state back to
// locked-and-shut (f4 1879's PROP(GRATE)=0), so no `closed` test is needed
// here -- being in that room IS the test.
printGrateStatus,
    local rtn
    dac rtn
    lac i [curRoom:0]
    SKIP_NEXT_IF_DIFFERENT [R_GRATE      // skip when NOT the Grate room -- try the others
    jmp pgsCheck          // == R_GRATE (no skip): report status
    SKIP_NEXT_IF_DIFFERENT [R_BELOW_GRATE  // skip when NOT the chamber below -- try the last
    jmp pgsCheck          // == R_BELOW_GRATE (no skip): report status
    SKIP_NEXT_IF_SAME [R_REPOSITORY_SW   // skip when at the repository's SW end
    jmp pgsRtn            // any other room -- nothing to say
pgsCheck,                 // one of the grate's three rooms -- report status
    lac i [grateLocked:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp pgsCkOpen               // branch 1 (AC == 0, no skip): unlocked -- check open/closed
    lac [msg_GRATE_STAT_LOCKED:1]   // branch 2 (AC != 0): locked -- falls through
    jmp pgsPrint
pgsCkOpen,
    lac i [grateOpen:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp pgsClosed              // branch 1 (AC == 0, no skip): unlocked and closed
                               // branch 2 (AC != 0): unlocked and open -- falls through
    lac [msg_GRATE_STAT_OPEN:1]
    jmp pgsPrint
pgsClosed,
    lac [msg_GRATE_STAT_CLOSED:1]
pgsPrint,
    jda advPrintMsg
pgsRtn,
    jmp i rtn           // eem is on (entry state; advPrintMsg keeps it on)
rtn, 0
    endloc

// Grate lock/open state (UNLOCK / LOCK / OPEN / CLOSE,
// All four act on the grate directly, no noun required, an optional noun
// is still accepted.
// The verb-chain compare only ever looks at verbTok, never nounTok, exactly like ON/OFF above.
// UNLIKE ON/OFF, though, all four require actually being at the grate.
// Entered from the bank-0 stubs of the same names via eem'd indirect
// jmp; never return, every exit is a pmsgT1 tail to turnLoop.
doUnlock,
    lac i [nounTok:0]
    SKIP_NEXT_IF_AC_NOT_ZERO                     // skip when AC != 0 (a noun was given)
    jmp ulInfer                   // AC == 0: no noun -- infer the object (f4 8040)
ulCheckNoun,                        // AC != 0 (skip): a noun was given -- is it the chain?
    lio i [nounTok:0]         // token in IO for findObj (S3B)
    jsp i [findObj:0]         // section-13 cross-bank call; returns with eem
                                // on, which this bank-1 caller keeps
    SKIP_NEXT_IF_AC_NOT_ZERO                       // skip when AC != 0 (a known object)
    jmp doUnlockGrate               // AC == 0: not a known object -- falls through to the grate
ulCheckChain,                        // AC != 0 (skip): a known object -- objLocPtr points at its slot
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_CHAIN)
    jmp ulChain                    // AC == objLoc+0d17 (no skip): it IS the chain
ulCheckClam,                         // AC != objLoc+0d17 (skip): not the chain -- is it the clam?
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_CLAM)
    jmp ulClam                     // AC == objLoc+0d26 (no skip): it IS the clam
ulCheckOyster,                       // AC != objLoc+0d26 (skip): not the clam -- is it the oyster?
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_OYSTER)
    jmp ulOyster                   // AC == objLoc+0d27 (no skip): it IS the oyster
ulCheckDoor,                         // f4 9040 flavor branches, now reachable
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_DOOR)
    jmp ulDoor                     // it IS the rusty door
ulCheckCage,
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_CAGE)
    jmp ulNoLock                   // cage: "IT HAS NO LOCK." (msg 32)
ulCheckKeys,
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_KEYS)
    jmp ulKeysMsg                  // keys: msg 55
ulCheckGrate,                        // TASK-SCENERY-NOUNS (S15): the grate HAS an objLoc
                                         // slot now. Before it did not, and "UNLOCK GRATE"
                                         // reached doUnlockGrate by findObj MISSING -- the
                                         // same fall-through that made "UNLOCK BANANA" work
                                         // the grate. Both had to change together: TASK-FR7
                                         // 7c closes the fall-through, and this row is what
                                         // keeps the four grate verbs working without it.
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_GRATE)
    jmp doUnlockGrate              // AC == objLoc+0d47 (no skip): it IS the grate
ulCheckGrateWord,                    // any OTHER known object lands here -- the source's
                                         // ACTSPK default (msg 33, f4 section 8 verb 4)
    jmp ulNotLockable

// Intransitive LOCK/UNLOCK object inference (f4 8040): clam/
// oyster if here, the door at its passage, the grate at the grate,
// the chain if HERE(CHAIN); else msg 28. Shared by doLock (lkInfer).
//
// adven.f4 1331-1338:
//
//     8040  SPK=28
//           IF(HERE(CLAM))OBJ=CLAM
//           IF(HERE(OYSTER))OBJ=OYSTER
//           IF(AT(DOOR))OBJ=DOOR
//           IF(AT(GRATE))OBJ=GRATE
//           IF(OBJ.NE.0.AND.HERE(CHAIN))GOTO 8000
//           IF(HERE(CHAIN))OBJ=CHAIN
//           IF(OBJ.EQ.0)GOTO 2011
//
// TASK-FR28 N25, 05-Sep-26. Three divergences, each reproduced live
// before a line of this was written:
//
//   * 1332-1335 are UNCONDITIONAL assignments and the LAST one wins, so
//     the grate beats the door beats the oyster beats the clam. The port
//     tested them in the source's own order and took the FIRST hit,
//     which is the opposite precedence: the oyster carried at the grate
//     answered "YOU DON'T HAVE ANYTHING STRONG ENOUGH TO OPEN THE
//     OYSTER." where the source works the grate. Walking the four in
//     REVERSE order and taking the first hit picks exactly what
//     last-wins picks -- the four conditions are independent and none of
//     them has a side effect -- and it needs no target word for those
//     four, which is what this bank has to spare. daInfer (bank 3) makes
//     the same "last assignment wins" reading of 9120 and keeps a COUNT
//     as well, because 9120 detects two candidates among all seven of
//     its; 8040 detects only the chain-plus-other pair, so the single
//     word below is enough here.
//   * 1336 had no port at all. With one of the four chosen AND the chain
//     here, the source goes to 8000 -- "UNLOCK WHAT?", which keeps VERB
//     and is exactly what verbWhat does. The port answered the oyster in
//     the bear room, chain and all.
//   * 1337 is HERE(CHAIN), not "in the bear room". The port compared
//     curRoom against R_BEARROOM, so a chain CARRIED away from the bear
//     room -- which 9048 makes possible by clearing FIXED(CHAIN) --
//     answered msg 28. ulHereTest is the file's one HERE(obj) and is
//     what ulChain and lkChain already use.
ulInfer,
    law 1
    dac ulVerbIsUnlock
    jmp ulInferGo
lkInfer,
    dzm ulVerbIsUnlock
ulInferGo,                         // 1332-1335 walked in reverse: the first hit
                                       //   here IS the source's last assignment
    jsp atGrate                    // AT(GRATE) -- both of the grate's rooms
    SKIP_NEXT_IF_AC_ZERO           // skip when AC == 0 (not at the grate)
    jmp uigGrateWins               // AC != 0 (no skip): 1335 wins
    lac i [curRoom:0]
    SKIP_NEXT_IF_DIFFERENT [R_DOORPASSAGE
    jmp uigDoorWins                // AC == R_DOORPASSAGE (no skip): 1334 wins
                                       //   (same reply for both verbs, f4 1343-1344)
    lio i [FAR_OBJ_LOC(OBJ_OYSTER)]
    jsp ulHereTest
    SKIP_NEXT_IF_AC_ZERO
    jmp uigOysterWins              // 1333 wins
    lio i [FAR_OBJ_LOC(OBJ_CLAM)]
    jsp ulHereTest
    SKIP_NEXT_IF_AC_ZERO
    jmp uigClamWins                // 1332 wins
// Nothing matched, so 1336's OBJ is still 0 and its ambiguity cannot
// fire; 1337 stands alone and the chain is taken when it is HERE.
    lio i [FAR_OBJ_LOC(OBJ_CHAIN)]
    jsp ulHereTest
    SKIP_NEXT_IF_AC_ZERO
    jmp ulInferChain
    lac [msg_NOTHING_WITH_LOCK:1]  // 1338: OBJ still 0 -- nothing lockable (msg 28)
    jmp pmsgT1
uigGrateWins,
    lac [ulInferGrate:.
    jmp uigChainAmbig
uigDoorWins,
    lac [ulDoor:.
    jmp uigChainAmbig
uigOysterWins,
    lac [ulInferOyster:.
    jmp uigChainAmbig
uigClamWins,
    lac [ulInferClam:.
uigChainAmbig,                     // 1336: IF(OBJ.NE.0.AND.HERE(CHAIN))GOTO 8000
    dac ulInferTarget
    lio i [FAR_OBJ_LOC(OBJ_CHAIN)]
    jsp ulHereTest
    SKIP_NEXT_IF_AC_ZERO           // skip when AC == 0 (no chain -- one candidate)
    jmp i [verbWhat:0]             // AC != 0 (no skip): two candidates -- 8000
    jmp i ulInferTarget            // the ulInferX entry 1332-1335 settled on
ulInferTarget, 0                   // the winner's entry, full address (daInfer idiom)
ulInferClam,
    lac ulVerbIsUnlock
    SKIP_NEXT_IF_AC_ZERO
    jmp ulClam
    jmp lkClamOyster
ulInferOyster,
    lac ulVerbIsUnlock
    SKIP_NEXT_IF_AC_ZERO
    jmp ulOyster
    jmp lkClamOyster
ulInferGrate,
    lac ulVerbIsUnlock
    SKIP_NEXT_IF_AC_ZERO
    jmp doUnlockGrate
    jmp doLockGrate
ulInferChain,
    lac ulVerbIsUnlock
    SKIP_NEXT_IF_AC_ZERO
    jmp ulChain
    jmp lkChain

// ulHereTest -- IO = an object's objLoc value on entry.
// returns AC=1 if "here" (carried, or in curRoom), else 0. This is
// adven.f4:78's HERE(OBJ) = PLACE(OBJ).EQ.LOC.OR.TOTING(OBJ), and it is
// the file's ONLY copy of that test -- anything needing "carried or in
// the room" calls it rather than open-coding a second objLoc compare.
// Dual-mode callee (dac full-capture rtn, jmp i rtn, eem stays ON
// throughout): bank 1 calls it `jsp ulHereTest`, banks 2 and 3 call it
// `jsp i [ulHereTest:1]` (the hint quick tests and READ's intransitive
// count, S21/S-9, 05-Sep-26).
ulHereTest,
    local uhtRtn, uhtVal
    dac uhtRtn                // full 16-bit return address (dual-mode)
    dio uhtVal
    lac uhtVal
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when != 0 (not carried -- check the room)
    jmp uhtYes                // 0: carried
    SKIP_NEXT_IF_SAME i [curRoom:0]
    jmp uhtNo                 // differs: neither carried nor here
uhtYes,
    law 1
    jmp i uhtRtn
uhtNo,
    cla
    jmp i uhtRtn
uhtRtn, 0
uhtVal, 0
ulVerbIsUnlock, 0
    endloc

ulDoor,
    lac i [doorOiled:0]
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when oiled
    jmp ulDoorRusty
    lac [msg_OK:1]                 // oiled: "OK" (f4 1344, msg 54)
    jmp pmsgT1
ulDoorRusty,
    lac [msg_DOOR_RUSTY:1]         // rusty: msg 111 (text already in the pool)
    jmp pmsgT1
ulNoLock,
    lac [msg_NO_LOCK:1]
    jmp pmsgT1
ulKeysMsg,
    lac [msg_CANT_UNLOCK_KEYS:1]
    jmp pmsgT1
ulNotLockable,
    lac [msg_CANT_LOCK_THING:1]
    jmp pmsgT1

doUnlockGrate,
    jsp atGrate
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dulNotHere            // branch 1 (AC == 0, no skip): not at the grate
                                 // branch 2 (AC != 0, skip): at the grate -- falls through
    lio i [FAR_OBJ_LOC(OBJ_KEYS)]
    jsp ulHereTest
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when keys are here (carried or in room)
    jmp dulNoKey
dulHaveKey,
    lac i [grateLocked:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dulAlready            // branch 1 (AC == 0, no skip): already unlocked -- msg 37
                                  // branch 2 (AC != 0): locked -- unlock AND open it
    dzm i [grateLocked:0]
    law 1
    dac i [grateOpen:0]       // lockstep: source-unlocked == open
    lac [msg_GRATE_UNLOCK_OK:1]
    jmp pmsgT1
dulAlready,
    lac [msg_GRATE_UNLOCK_ALREADY:1]
    jmp pmsgT1
dulNoKey,
    lac [msg_GRATE_NO_KEY:1]
    jmp pmsgT1
dulNotHere,
    lio i [nounTok:0]         // f4 5199: echo the noun
    jmp pSeeNo

// ulChain -- derived directly against adven.f4 lines 1376-1382:
//   9048 IF(VERB.EQ.LOCK)GOTO 9049
//        SPK=171
//        IF(PROP(BEAR).EQ.0)SPK=41
//        IF(PROP(CHAIN).EQ.0)SPK=37
//        IF(SPK.NE.171)GOTO 2011
//        PROP(CHAIN)=0 ; FIXED(CHAIN)
//        IF(PROP(BEAR).NE.3)PROP(BEAR)=2 ; FIXED(BEAR)=2-PROP(BEAR)
// No location gate in the source -- UNLOCK CHAIN works from anywhere
// once the bear's been fed at least once, unlike LOCK CHAIN below which
// does require being in R_BEARROOM.
// The bear only becomes movable on a/ FRESH unlock, not on an "already unlocked" attempt,
// and only if it isn't already dead, matches FIXED(BEAR)=2-PROP(BEAR): PROP(BEAR)=2
// (alive) gives FIXED=0 (movable), PROP(BEAR)=3 (dead) gives FIXED=-1,
// stays immovable.
ulChain,
// TASK-FR28 N14 (05-Sep-26): adven.f4 1347-1348 is one test covering BOTH
// nouns -- "IF(OBJ.EQ.GRATE.OR.OBJ.EQ.CHAIN)SPK=31" then "IF(SPK.NE.31.OR.
// .NOT.HERE(KEYS))GOTO 2011" -- and it runs BEFORE 1349's "IF(OBJ.EQ.CHAIN)
// GOTO 9048", so it outranks every chain-specific reply: the ferocious-bear
// 41 below, the already-unlocked 37, and lkChain's wrong-room 173. The port
// had the keys test only on the grate branch (dulHaveKey above), so the
// chain unlocked from anywhere with nothing in hand. Same four instructions
// as doUnlockGrate's, sharing that branch's msg-31 tail.
    lio i [FAR_OBJ_LOC(OBJ_KEYS)]
    jsp ulHereTest
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when the keys are here (carried or in room)
    jmp dulNoKey                   // no keys: msg 31, "YOU HAVE NO KEYS!"
    lac i [bearFed:0]
    SKIP_NEXT_IF_AC_NOT_ZERO                       // skip when AC != 0 (fed at least once)
    jmp ulChainFerocious            // AC == 0: still ferocious -- msg 41
ulChainCheckLocked,                   // AC != 0 (skip): fed -- is the chain already unlocked?
    lac i [FAR_OBJ_TAKE(OBJ_CHAIN)]
    SKIP_NEXT_IF_AC_ZERO                          // skip when AC == 0 (still locked/immovable -- unlock it)
    jmp ulChainAlready               // AC != 0: already unlocked -- msg 37
ulChainDo,                             // AC == 0 (skip): still locked -- unlock it
    law 1
    dac i [FAR_OBJ_TAKE(OBJ_CHAIN)]           // chain becomes takeable
    lac [msg_HERE_CHAIN_LOOSE:1]
    dac i [FAR_OBJ_HEREMSG(OBJ_CHAIN)]
    lac i [bearDead:0]
    SKIP_NEXT_IF_AC_ZERO                            // skip when AC == 0 (bear alive) -- also becomes movable
    jmp ulChainDone                    // AC != 0: bear already dead -- stays immovable, no
                                           // objTake+0d14/objHereMsg+0d14 change
ulChainFreeBear,                         // AC == 0 (skip): bear alive -- becomes movable
    law 1
    dac i [FAR_OBJ_TAKE(OBJ_BEAR)]
    lac [msg_HERE_BEAR_CONTENTED:1]
    dac i [FAR_OBJ_HEREMSG(OBJ_BEAR)]
ulChainDone,
    lac [msg_CHAIN_UNLOCK_OK:1]
    jmp pmsgT1
ulChainAlready,
    lac [msg_CHAIN_ALREADY_UNLOCKED:1]
    jmp pmsgT1
ulChainFerocious,
    lac [msg_UNLOCK_CHAIN_BLOCKED:1]
    jmp pmsgT1

// ulClam / ulOyster -- Derived directly against adven.f4 lines
// 1362-1373 (label 9046). Two straight-line
// mirrors of the same source logic (K=0 for CLAM, K=1 for OYSTER, per the
// source's own K flag) rather than one K-parameterized routine -- no
// shared K state to thread through, matches this project's existing
// plain per-object handler style (ulChain/lkChain aren't parameterized
// either).
//
// Translation-order note: the source computes SPK via three sequential,
// unconditional overwrites (default win -> toting-it override -> no-
// trident override), so when BOTH "carrying the object" and "not
// carrying the trident" are true at once, the no-trident message wins
// (it's checked last and unconditionally overwrites). Both handlers below
// check the trident FIRST and short-circuit on it, which reproduces this
// same final priority with one fewer branch than transliterating the
// source's own SPK-overwrite order literally -- same precedent as
// lkChain's own location-gate-first reordering above.
//
// LOCK CLAM/LOCK OYSTER never reach these handlers at all -- the source's
// "IF(VERB.EQ.LOCK)SPK=61" is the LAST unconditional overwrite in the
// shared routine, so it always wins for LOCK regardless of every other
// state; doLock's own noun check below dispatches both nouns straight to
// a plain "WHAT?" (msg 61), with no state checks needed, rather than
// duplicating that always-true override here.
ulClam,
    lac i [FAR_OBJ_LOC(OBJ_TRIDENT)]         // TOTING(TRIDNT)?
    SKIP_NEXT_IF_AC_ZERO                        // skip when AC == 0 (carrying the trident) -- falls through
    jmp ulClamTooWeak             // AC != 0 (no skip): not carrying the trident -- msg 122
                                      // (wins regardless of the put-down state below, see the
                                      // translation-order note above)
ulClamCheckCarried,                  // AC == 0 (skip): carrying the trident -- is the clam
                                      // itself also being carried?
    lac i [FAR_OBJ_LOC(OBJ_CLAM)]
    SKIP_NEXT_IF_AC_NOT_ZERO                      // skip when AC != 0 (not carrying the clam -- proceed to the win)
    jmp ulClamPutDown             // AC == 0 (no skip): carrying the clam -- msg 120
ulClamWin,                           // AC != 0 (skip): not carrying the clam, and carrying the
                                      // trident -- the one real win (adven.f4 9046's CALL
                                      // DSTROY(CLAM)/DROP(OYSTER,LOC)/DROP(PEARL,105) triple)
    law CLAM_GONE
    dac i [FAR_OBJ_LOC(OBJ_CLAM)]            // CALL DSTROY(CLAM)
    lac i [curRoom:0]
    dac i [FAR_OBJ_LOC(OBJ_OYSTER)]            // CALL DROP(OYSTER,LOC) -- LOC is guaranteed R_SHELLROOM
                                         // here (CLAM is FIXED there), matching ulChain's own
                                         // "LOC is guaranteed R_BEARROOM" precedent above
    law R_CULDESAC
    dac i [FAR_OBJ_LOC(OBJ_PEARL)]            // CALL DROP(PEARL,105) -- LOC 105 = R_CULDESAC
    lac [msg_CLAM_UNLOCK_OK:1]
    jmp pmsgT1
ulClamPutDown,
    lac [msg_CLAM_PUT_DOWN:1]
    jmp pmsgT1
ulClamTooWeak,
    lac [msg_CLAM_TOO_WEAK:1]
    jmp pmsgT1

ulOyster,
    lac i [FAR_OBJ_LOC(OBJ_TRIDENT)]         // TOTING(TRIDNT)?
    SKIP_NEXT_IF_AC_ZERO                        // skip when AC == 0 (carrying the trident) -- falls through
    jmp ulOysterTooWeak           // AC != 0 (no skip): not carrying the trident -- msg 123
ulOysterCheckCarried,                // AC == 0 (skip): carrying the trident -- is the oyster
                                      // itself also being carried?
    lac i [FAR_OBJ_LOC(OBJ_OYSTER)]
    SKIP_NEXT_IF_AC_NOT_ZERO                      // skip when AC != 0 (not carrying the oyster -- proceed)
    jmp ulOysterPutDown            // AC == 0 (no skip): carrying the oyster -- msg 121
ulOysterInert,                       // AC != 0 (skip): not carrying the oyster, and carrying the
                                      // trident -- STILL no real effect, see the header
                                      // correction note above: OYSTER never runs the DSTROY/DROP
                                      // triple, only ever this message
    lac [msg_OYSTER_UNLOCK_INERT:1]
    jmp pmsgT1
ulOysterPutDown,
    lac [msg_OYSTER_PUT_DOWN:1]
    jmp pmsgT1
ulOysterTooWeak,
    lac [msg_OYSTER_TOO_WEAK:1]
    jmp pmsgT1

doLock,
    lac i [nounTok:0]
    SKIP_NEXT_IF_AC_NOT_ZERO                     // skip when AC != 0 (a noun was given)
    jmp lkInfer                   // AC == 0: no noun -- infer the object (f4 8040)
lkCheckNoun,                        // AC != 0 (skip): a noun was given -- is it the chain?
    lio i [nounTok:0]         // token in IO for findObj (S3B)
    jsp i [findObj:0]         // section-13 cross-bank call; eem stays on
    SKIP_NEXT_IF_AC_NOT_ZERO                       // skip when AC != 0 (a known object)
    jmp doLockGrate                 // AC == 0: not a known object -- falls through to the grate
lkCheckChain,                        // AC != 0 (skip): a known object -- objLocPtr points at its slot
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_CHAIN)
    jmp lkChain                    // AC == objLoc+0d17 (no skip): it IS the chain
lkCheckClam,                         // AC != objLoc+0d17 (skip): not the chain -- is it the
                                         // clam?
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_CLAM)
    jmp lkClamOyster               // AC == objLoc+0d26 (no skip): it IS the clam
lkCheckOyster,                       // AC != objLoc+0d26 (skip): not the clam -- is it the
                                         // oyster?
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_OYSTER)
    jmp lkClamOyster               // AC == objLoc+0d27 (no skip): it IS the oyster
lkCheckDoor,
    lac i [objLocPtr:0]                  // is ONE routine for both verbs)
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_DOOR)
    jmp ulDoor
lkCheckCage,
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_CAGE)
    jmp ulNoLock
lkCheckKeys,
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_KEYS)
    jmp ulKeysMsg
lkCheckGrate,                        // TASK-SCENERY-NOUNS (S15) -- see ulCheckGrate for why.
                                         // LOCK and CLOSE reach the grate the same way UNLOCK
                                         // and OPEN do, so both chains needed the row.
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_GRATE)
    jmp doLockGrate                // AC == objLoc+0d47 (no skip): it IS the grate
lkCheckOther,
    jmp ulNotLockable              // any other known object: msg 33

doLockGrate,
    jsp atGrate
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp dlkNotHere            // branch 1 (AC == 0, no skip): not at the grate
                                 // branch 2 (AC != 0, skip): at the grate -- falls through
    lio i [FAR_OBJ_LOC(OBJ_KEYS)]
    jsp ulHereTest
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when keys are here (carried or in room)
    jmp dulNoKey                   // shared no-keys tail (msg 31)
dlkHaveKey,
    lac i [grateLocked:0]
    SKIP_NEXT_IF_AC_ZERO                  // skip when AC == 0 (unlocked -- lock it)
    jmp dlkAlready            // AC != 0: already locked -- msg 34
dlkLock,                      // unlocked/open -- lock AND close it
    law 1
    dac i [grateLocked:0]
    dzm i [grateOpen:0]       // lockstep: source-locked == closed
    lac [msg_GRATE_LOCK_OK:1]
    jmp pmsgT1
dlkAlready,
    lac [msg_GRATE_LOCK_ALREADY:1]
    jmp pmsgT1
dlkNotHere,
    lio i [nounTok:0]
    jmp pSeeNo

// lkChain -- re-derived directly against adven.f4 lines 1383-1389 this
// stage. Location gate checked first: the source's own sequential SPK
// overwrites land on 173 (wrong room) last if both "wrong room" and
// "already locked" are true at once, so wrong-room is checked here
// first to reproduce that same priority. Unconditionally snaps the
// chain's objLoc back to R_BEARROOM on success (matches "IF(TOTING
// (CHAIN))CALL DROP(CHAIN,LOC)" -- LOC is already guaranteed to equal
// R_BEARROOM by the gate above, so this is a no-op if it was already
// sitting there and a real "drop" if it was carried or left elsewhere).
lkChain,
// TASK-FR28 N14 (05-Sep-26): the same 1347-1348 keys test as ulChain's --
// 9040 reaches 9048/9049 through it, so it outranks the wrong-room 173
// below as well as the already-locked 34. See ulChain's own note.
    lio i [FAR_OBJ_LOC(OBJ_KEYS)]
    jsp ulHereTest
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when the keys are here (carried or in room)
    jmp dulNoKey                   // no keys: msg 31, "YOU HAVE NO KEYS!"
    lac i [curRoom:0]
    SKIP_NEXT_IF_DIFFERENT [R_BEARROOM
    jmp lkChainCheckLocked         // AC == R_BEARROOM (no skip): in the right room
lkChainNotHere,                       // AC != R_BEARROOM (skip): wrong room -- msg 173
    lac [msg_LOCK_CHAIN_NOT_HERE:1]
    jmp pmsgT1
lkChainCheckLocked,
    lac i [FAR_OBJ_TAKE(OBJ_CHAIN)]
    SKIP_NEXT_IF_AC_NOT_ZERO                        // skip when AC != 0 (currently takeable -- unlocked, lock it)
    jmp lkChainAlready               // AC == 0: already locked/immovable -- msg 34
lkChainDo,                             // AC != 0 (skip): unlocked -- lock it
    dzm i [FAR_OBJ_TAKE(OBJ_CHAIN)]            // chain becomes immovable again
    lac [msg_HERE_CHAIN_LOCKED_ALONE:1]
    dac i [FAR_OBJ_HEREMSG(OBJ_CHAIN)]
    lac i [curRoom:0]
    dac i [FAR_OBJ_LOC(OBJ_CHAIN)]             // snaps back to R_BEARROOM -- see header comment
    lac [msg_CHAIN_LOCK_OK:1]
    jmp pmsgT1
lkChainAlready,
    lac [msg_CHAIN_ALREADY_LOCKED:1]
    jmp pmsgT1

// lkClamOyster -- adven.f4 9046's "IF(VERB.EQ.LOCK)SPK=61" is the LAST
// unconditional overwrite in the shared LOCK/UNLOCK routine, so LOCK
// CLAM/LOCK OYSTER always print "WHAT?" regardless of every other state
// (carrying the object, carrying the trident, whether OYSTER even exists
// yet) -- see ulClam/ulOyster's header comment above for the full
// correction/citation trail. One shared handler for both nouns, no state
// checks needed.
lkClamOyster,
    lac [msg_WHAT:1]
    jmp pmsgT1

// checkBirdSnake
// Fires when the object about to be discarded/ is the bird and the snake is here
// but not yet killed, matching adven.f4's behavior.
// Caller must have already confirmed the object is carried and left
// objLocPtr pointing at its objLoc slot.
//
// Checked BEFORE doThrow's dwarf-combat branch (not after), the original
// source's OBJ=BIRD handling is independent of dwarf-target selection.
// Adven.f4's ambiguous-target dwarf-selection only runs when OBJ is
// unspecified, so a dwarf coincidentally being present in R_MTKING
//  must not preempt the snake-kill.
//
// Returns AC=1 if it handled the action in full (killed the snake,
// dropped the bird, printed the message),
// caller should jmp turnLoop without doing its own drop/throw behavior.
//
// Returns AC=0 if it did nothing. caller should fall through to its normal behavior.
// No arguments.
// Called cross-bank.
// =======================================================================
checkBirdSnake,
    local rtn, tptr
    dac rtn
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_BIRD)
    jmp cbsIsBird           // AC == objLoc+4 (no skip): this IS the bird
cbsNotHandled,              // AC != objLoc+4 (skip): not the bird -- falls through
    cla
    jmp i rtn
cbsIsBird,
    dzm i [birdCaught:0]
                              // state unconditionally, whether or not the snake is here
                              // (adven.f4 line 1277)
    lac [msg_HERE_BIRD:1]     // PROP(BIRD)=0 selects object 8's tier-000 text again --
    dac i [FAR_OBJ_HEREMSG(OBJ_BIRD)]  // the loose bird singing (TASK-FR31 N39)
    lac i [FAR_OBJ_LOC(OBJ_SNAKE)]
    SKIP_NEXT_IF_SAME i [curRoom:0]      // skip when EQUAL (snake here) -- falls through to cbsKill
    jmp cbsNotHandled      // AC != curRoom (no skip): snake not here, or already gone
// TASK-FR28 N19 (group S23 batch 2, 05-Sep-26). adven.f4 9020, lines
// 1267-1272:
//
//     IF(OBJ.NE.BIRD.OR..NOT.HERE(SNAKE))GOTO 9024
//     CALL RSPEAK(30)
//     IF(CLOSED)GOTO 19000
//     CALL DSTROY(SNAKE)
//     PROP(SNAKE)=1
//
// The CLOSED test sits BETWEEN the message and the kill, and 19000 is
// "CALL RSPEAK(136)" falling straight into 20000, the scoring exit. So
// releasing the bird at the repository's snake in a closed cave prints
// msg 30 and then ENDS THE GAME on msg 136 -- one of the four deliberate
// endgame deaths, alongside 9125's KILL DWARF, 9280's BREAK MIRROR and
// 9290's WAKE DWARF, all three of which this port already reaches
// through pmsgD/pmsgD1. Probed 05-Sep-26 at R_REPOSITORY_NE with
// closed=1: msg 30, the snake destroyed and play carrying on.
//
// The snake is NOT destroyed on this leg and the bird is NOT dropped:
// 19000 is reached before 1270 and before 9021's shared drop tail, so
// the state the score is computed from is the state the player had.
cbsKill,                   // AC == curRoom (skip): snake is here -- kill it
    lac i [closed:0]
    SKIP_NEXT_IF_AC_ZERO   // skip when == 0 (cave still open -- the ordinary kill)
    jmp cbsClosedEnding    // closed != 0: 1269's GOTO 19000
    law SNAKE_GONE
    dac i [FAR_OBJ_LOC(OBJ_SNAKE)]
    law 1
    dac i [pastSnake:0]
    lac i [objLocPtr:0]    // drop the bird here anyway, matching the original's
    dac tptr                 // unconditional DROP -- double indirect: fetch the
    lac i [curRoom:0]        // slot address into a local, then store through it
    dac i tptr
    lio i [objLocPtr:0]      // the same 1278 DROP, so the same head-of-list effect
    jsp i [bumpDropSeq:0]
    lac [msg_SNAKE_KILLED:1]
    jda advPrintMsg
    law 1
    jmp i rtn
cbsClosedEnding,           // 1268-1269: the message first, then GOTO 19000
    lac [msg_SNAKE_KILLED:1]
    jda advPrintMsg        // RSPEAK(30) -- print and continue
    lac [msg_DWARVES_AWAKENED:1]
    jmp pmsgD1             // 19000's RSPEAK(136), then 20000 via pgDone
rtn, 0
tptr, 0
    endloc

// checkBirdDragon -- adven.f4 lines 1287-1292 (label 9025).
// Fires when the object about to be thrown is the bird,
// the dragon is in this room, and the dragon is still alive
// (dragonDead==0). Mirrors checkBirdSnake's own shape and contract
// exactly: caller must have already confirmed the object is carried and
// left objLocPtr pointing at its objLoc slot.
//
// Returns AC=1 if it handled the action in full (killed the bird,
// printed the message) -- caller should jmp turnLoop without doing its
// own drop/throw behavior.
// Returns AC=0 if it did nothing -- caller should fall through to its
// normal behavior.
// No arguments. Called cross-bank via the section-13 form.
// =======================================================================
checkBirdDragon,
    local rtn
    dac rtn
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_BIRD)
    jmp cbrdIsBird           // AC == objLoc+4 (no skip): this IS the bird
cbrdNotHandled,              // AC != objLoc+4 (skip): not the bird -- falls through
    cla
    jmp i rtn
cbrdIsBird,
    jsp i [dragonHere:0]      // AT(DRAGON) -- BOTH of its rooms (TASK-FR6 6c; see
                                 // dragonHere's own header for why it is two)
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp cbrdNotHandled       // AC == 0 (no skip): dragon not here -- unhandled
cbrdCheckAlive,               // AC != 0 (skip): dragon is here
    lac i [dragonDead:0]
    SKIP_NEXT_IF_AC_ZERO                  // skip when AC == 0 (still alive) -- falls through to cbrdKill
    jmp cbrdNotHandled       // AC != 0 (no skip): already dead -- unhandled, ordinary drop
cbrdKill,                     // AC == 0 (skip): still alive -- kill
    law BIRD_GONE
    dac i [FAR_OBJ_LOC(OBJ_BIRD)]
    dzm i [birdCaught:0]    // tidiness -- nothing will read this for the bird again once gone
    lac [msg_BIRD_DRAGON_KILL:1]
    jda advPrintMsg
    law 1
    jmp i rtn
rtn, 0
    endloc

// checkBirdCatch
// Fires when the object about to be TAKEn is the bird and it hasn't been
// caught yet: checks the rod first, then the cage, matching adven.f4's
// catch prerequisite order exactly (9016's TOTING(ROD) check runs before
// 9013's TOTING(CAGE) check). Carrying the rod scares the bird off
// regardless of whether the cage is also in hand (message 26); without the
// rod, the catch proceeds to the pre-existing cage check (message 27).
// Caller must have already confirmed the object is takeable and present
// in curRoom, and left objLocPtr pointing at its objLoc slot -- same
// contract as checkBirdSnake.
//
// Returns AC=1 if it handled the action in full (printed
// msg_BIRD_ROD_SCARE or msg_BIRD_NEEDS_CAGE; no take happens, birdCaught
// stays 0), caller should jmp turnLoop directly.
//
// Returns AC=0 if it did nothing (not the bird, or the bird is already
// caught and sitting loose -- an ordinary take is fine either way).
// caller should fall through to its normal take behavior.
// No arguments. Called cross-bank.
// =======================================================================
checkBirdCatch,
    local rtn
    dac rtn
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_BIRD)
    jmp cbcIsBird            // AC == objLoc+4 (no skip): this IS the bird
cbcNotHandled,                // AC != objLoc+4 (skip): not the bird -- falls through
    cla
    jmp i rtn
cbcIsBird,
    lac i [birdCaught:0]
    SKIP_NEXT_IF_AC_ZERO                       // skip when AC == 0 (not yet caught) -- falls through to check the rod
    jmp cbcNotHandled         // AC != 0 (no skip): already caught -- ordinary take proceeds
cbcCheckRod,                  // AC == 0 (skip): not yet caught -- check the rod first (adven.f4 9016 order)
    lac i [FAR_OBJ_LOC(OBJ_ROD)]
    SKIP_NEXT_IF_AC_ZERO                       // skip when AC == 0 (rod IS carried) -- falls through to the scare
    jmp cbcCheckCage          // AC != 0 (no skip): rod not carried -- proceed to the cage check
cbcRodScared,                 // AC == 0 (skip): rod carried -- bird becomes disturbed, catch fails
    lac [msg_BIRD_ROD_SCARE:1]
    jda advPrintMsg
    law 1
    jmp i rtn
cbcCheckCage,                 // AC != 0: rod not carried -- the cage decides it (unchanged from before)
    lac i [FAR_OBJ_LOC(OBJ_CAGE)]
    SKIP_NEXT_IF_AC_ZERO                       // skip when AC == 0 (cage IS carried) -- falls through to the catch
    jmp cbcNoCage             // AC != 0 (no skip): cage not carried
cbcHaveCage,                  // AC == 0 (skip): cage carried -- the catch succeeds
    law 1
    dac i [birdCaught:0]
    cla
    jmp i rtn
cbcNoCage,
    lac [msg_BIRD_NEEDS_CAGE:1]
    jda advPrintMsg
    law 1
    jmp i rtn
rtn, 0
    endloc

// takeBirdCageBundle
// Called from dtDoTakeGo right after the primary object (whatever TAKE
// just succeeded on) is marked carried. If birdCaught is set and the
// object just taken was the bird or the cage, and the OTHER member of
// the pair is sitting loose in curRoom, also marks it carried --
// matching adven.f4's CARRY(BIRD+CAGE-OBJ,LOC) bundling. No message: the
// source prints only one "taken" line for the pair.
// No arguments; reads objLocPtr, left pointing at the just-taken
// object's objLoc slot by dtDoTakeGo.
// Called cross-bank via the section-13 form.
// =======================================================================
takeBirdCageBundle,
    local rtn
    dac rtn
    lac i [birdCaught:0]
    SKIP_NEXT_IF_AC_NOT_ZERO                     // skip when AC != 0 (birdCaught is set) -- pairing may be active
    jmp tbcbRtn               // AC == 0 (no skip): bird never caught -- no pairing possible
tbcbActive,                    // AC != 0 (skip): birdCaught is set -- identify which object this was
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_BIRD)
    jmp tbcbTookBird           // AC == objLoc+4 (no skip): just took the bird
tbcbCheckCage,                 // AC != objLoc+4 (skip): not the bird -- check the cage
    SKIP_NEXT_IF_SAME [FAR_OBJ_LOC(OBJ_CAGE)
    jmp tbcbRtn                // AC != objLoc+6 (no skip): neither pair member -- nothing to do
tbcbTookCage,                   // AC == objLoc+6 (skip): just took the cage -- bring the bird along
    lac i [FAR_OBJ_LOC(OBJ_BIRD)]
    SKIP_NEXT_IF_SAME i [curRoom:0]           // skip when equal (bird is sitting right here)
    jmp tbcbRtn                 // differs: bird elsewhere or already carried -- nothing to do
    dzm i [FAR_OBJ_LOC(OBJ_BIRD)]
    jmp tbcbRtn
tbcbTookBird,                    // just took the bird -- bring the cage along
    lac i [FAR_OBJ_LOC(OBJ_CAGE)]
    SKIP_NEXT_IF_SAME i [curRoom:0]            // skip when equal (cage is sitting right here)
    jmp tbcbRtn                  // differs: cage elsewhere or already carried -- nothing to do
    dzm i [FAR_OBJ_LOC(OBJ_CAGE)]
tbcbRtn,
    jmp i rtn
rtn, 0
    endloc

// dropCageBundle
// Called from doDrop/doThrow's ordinary-discard sites (ddDoDrop,
// dthNoDwarf), BEFORE the primary drop happens. If the object about to
// be dropped is the cage and birdCaught is set, also drops the bird into
// curRoom -- matching adven.f4's unconditional CALL DROP(BIRD,LOC) side
// effect (adven.f4 line 1276). birdCaught is NOT reset here (only
// an actual bird-drop resets it, via checkBirdSnake's cbsIsBird).
//
// TASK-FR31 N39: 1276 is the CAGE arm and 1277 is the BIRD arm, and only
// 1277 clears PROP(BIRD). A bird set down inside its cage therefore keeps
// PROP(BIRD)=1, whose adven.dat text (object 8, tier 100) is "THERE IS A
// LITTLE BIRD IN THE CAGE." -- not the loose bird's singing line. The port
// carries one here-message per object, so PROP(BIRD) is modelled by poking
// objHereMsg[BIRD], the same treatment the lamp's prop got in N38; the
// restore to msg_HERE_BIRD sits on 1277's own site in cbsIsBird, and
// newGame resets it alongside the other runtime-patched here-messages.
// No arguments; reads objLocPtr, left pointing at the object about to be
// dropped.
// Called cross-bank via the section-13 form.
// =======================================================================
dropCageBundle,
    local rtn
    dac rtn
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_SAME [FAR_OBJ_LOC(OBJ_CAGE)
    jmp dcbRtn                // AC != objLoc+6 (no skip): not the cage -- nothing to do
dcbIsCage,                     // AC == objLoc+6 (skip): dropping the cage
    lac i [birdCaught:0]
    SKIP_NEXT_IF_AC_NOT_ZERO                      // skip when AC != 0 (bird is caught -- it's inside the cage)
    jmp dcbRtn                 // AC == 0 (no skip): bird never caught -- nothing to bring along
dcbDropBird,                    // AC != 0 (skip): bird is caught -- drop it here too
    lac i [curRoom:0]
    dac i [FAR_OBJ_LOC(OBJ_BIRD)]
    lac [msg_HERE_BIRD_IN_CAGE:1]  // PROP(BIRD) stays 1 -- object 8's tier-100 text
    dac i [FAR_OBJ_HEREMSG(OBJ_BIRD)]
    lio [FAR_OBJ_LOC(OBJ_BIRD)]    // 1276's DROP runs BEFORE 1278's, so the cage
    jsp i [bumpDropSeq:0]            // ends up described ahead of the bird it held
dcbRtn,
    jmp i rtn
rtn, 0
    endloc

// resyncLiquidObjLoc
// Re-derives objLoc[WATER]/objLoc[OIL] from bottleProp and the bottle's
// current objLoc value.
// Unconditional -- callers that don't already/ know
// "this is about the bottle" must gate the call themselves.
//
// This, plus syncLiquidIfBottle's gate, are the ONLY places WATER/OIL's
// objLoc is ever written except the static table default and newGame's
// cold-load reset -- there is no per-turn poll. Together they maintain
// the invariant that objLoc[WATER]==0 (or objLoc[OIL]==0) if and only if
// the bottle is BOTH carried AND holds that exact liquid: this is what
// lets doInventory's existing generic objLoc-driven scan print exactly
// one of msg_INV_WATER/msg_INV_OIL "for free" (never both, since
// bottleProp only ever encodes one liquid at a time), and what lets
// doDrop's ddFound treat objLoc[WATER]==0 as sufficient proof of
// "carrying water" without re-deriving it from bottleProp directly (see
// the ddFound swap-to-BOTTLE block in doDrop).
//
// No arguments; reads bottleProp and objLoc[BOTTLE]. BANK-1 INTERNAL ONLY
// (same dap-style convention as liquidHere) -- caller must have eem on.
resyncLiquidObjLoc,
    local rtn, rlolLoc
    dap rtn
    lac i [FAR_OBJ_LOC(OBJ_BOTTLE)]
    dac rlolLoc            // 0 if carried, curRoom's value if sitting in a room
    lac i [bottleProp:0]      // 0 = water, 1 = empty, 2 = oil
    SKIP_NEXT_IF_DIFFERENT [0
    jmp rlolWater              // AC == 0 (no skip): water
    SKIP_NEXT_IF_DIFFERENT [2
    jmp rlolOil                // AC == 2 (no skip): oil
rlolEmpty,                     // AC == 1 (falls through -- must be empty): neither liquid present
    lac [WATER_NOWHERE]
    dac i [FAR_OBJ_LOC(OBJ_WATER)]
    lac [OIL_NOWHERE]
    dac i [FAR_OBJ_LOC(OBJ_OIL)]
    jmp rtn
rlolWater,                     // bottleProp == 0 -- water is "in" the bottle, oil is not
    lac rlolLoc
    SKIP_NEXT_IF_AC_NOT_ZERO                 // skip when AC != 0 (not carried)
    jmp rlolWaterCarried          // AC == 0 (no skip): carried -- water is too
rlolWaterNotCarried,            // AC != 0 (skip): not carried -- water isn't either
    lac [WATER_NOWHERE]
    dac i [FAR_OBJ_LOC(OBJ_WATER)]
    jmp rlolOilNowhere
rlolWaterCarried,
    dzm i [FAR_OBJ_LOC(OBJ_WATER)]
rlolOilNowhere,                // falls through from rlolWaterCarried, or jmp'd from rlolWaterNotCarried
    lac [OIL_NOWHERE]
    dac i [FAR_OBJ_LOC(OBJ_OIL)]
    jmp rtn
rlolOil,                        // bottleProp == 2 -- oil is "in" the bottle, water is not
    lac rlolLoc
    SKIP_NEXT_IF_AC_NOT_ZERO                 // skip when AC != 0 (not carried)
    jmp rlolOilCarried            // AC == 0 (no skip): carried -- oil is too
rlolOilNotCarried,               // AC != 0 (skip): not carried -- oil isn't either
    lac [OIL_NOWHERE]
    dac i [FAR_OBJ_LOC(OBJ_OIL)]
    jmp rlolWaterNowhere
rlolOilCarried,
    dzm i [FAR_OBJ_LOC(OBJ_OIL)]
rlolWaterNowhere,               // falls through from rlolOilCarried, or jmp'd from rlolOilNotCarried
    lac [WATER_NOWHERE]
    dac i [FAR_OBJ_LOC(OBJ_WATER)]
rtn, jmp 0
rlolLoc, 0
    endloc

// syncLiquidIfBottle --  Cross-bank gate for resyncLiquidObjLoc above.
// Fires only when the object whose objLoc slot was just updated (by dtDoTakeGo on a
// successful TAKE, or ddDoDrop on a successful DROP) is the BOTTLE
// itself -- a no-op for every other object. TAKE/DROP resolve their
// target via findObj, which can land on any object, so (unlike doFill/
// doPour, which always mean the bottle) this gate is required here.
//
// No arguments; reads objLocPtr (left by the caller pointing at the
// object's objLoc slot). Called cross-bank via the section-13 form;
// entered with eem ON (the caller's own eem/lem wrap owns closing the
// window, matching takeBirdCageBundle/dropCageBundle's own convention)
// and returns with eem ON.
// =======================================================================
syncLiquidIfBottle,
    local rtn
    dac rtn
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_SAME [FAR_OBJ_LOC(OBJ_BOTTLE)
    jmp slibRtn               // != bottle's slot (no skip): nothing to do
slibIsBottle,                  // == bottle's slot (skip): re-derive both liquids
    jsp resyncLiquidObjLoc       // same-bank call (both bank 1); eem already on
slibRtn,
    eem
    jmp i rtn
rtn, 0
    endloc

// liquidHere -- which liquid, if any, is available to FILL the bottle with at curRoom.
//
// TASK-FR20 C10 (03-Sep-26): this used to carry its own two-room test,
// R_BUILDING for water and R_EASTPIT for oil, which is not LIQLOC. The
// real derivation -- all seven of adven.dat section 9's water rooms plus
// the one oil room -- now lives in bank 0's liquidAtRoom, shared with the
// ENTER WATER / ENTER STREAM branch that exposed the gap. Consequence
// worth stating: the bottle can now be filled at the End of Road, the
// Valley, the Slit, the Small Pit with the stream, the Waterfall Cavern
// and the Reservoir, not only in the well house.
//
// Kept as a wrapper rather than replaced at its six call sites: those are
// all bank-1 `jsp liquidHere` and the far form differs.
// BANK-1 INTERNAL ONLY (dap-style), caller must have eem on.
liquidHere,
    local rtn
    dap rtn
    jsp i [liquidAtRoom:0]    // bank-0 dual-mode; returns AC = 0/1/2, eem on
rtn, jmp 0
    endloc

// printPhonyPlant -- After a room description
// prints, if curRoom is R_TWOPITWEST or R_TWOPITEAST, print the PHONY
// PLANT's own line IF plantDisplayProp is nonzero.
//
// Not modeled as a real objLoc-table object: adven.f4's own placement row
// for PLANT2 ("25 23 67", PLAC=23/FIXD=67) places it at BOTH
// rooms simultaneously via the source's AT()=PLACE.EQ.LOC.OR.FIXED.EQ.LOC
// function -- this project's single-location objLoc model can't express
// that any more than it could for RUG/DRAGON's own two-location
// placement (see the object table's own comment there), and a bespoke
// two-room print hook is the established precedent for exactly this
// shape (printChasmTroll, printGrateStatus). PLANT2's text is
// identical at both rooms and literally says "WEST PIT" even when viewed
// from R_TWOPITEAST -- a real, verbatim sourced quirk (adven.dat lines
// 1226-1228), not a mistake to "fix" here.
//
// plantDisplayProp: 0 = not visible from either room, 1 = "top of a
// 12-ft beanstalk poking out," 2 = "huge beanstalk... up to the hole."
// Kept in sync with plantProp by doPour (plantDisplayProp =
// plantProp/2).
// Called cross-bank from enterRoom/doLook (bank 0) via the section-13
// form -- section-13 callee.
printPhonyPlant,
    local rtn, ppTier
    dac rtn
    lac i [curRoom:0]
    SKIP_NEXT_IF_DIFFERENT [R_TWOPITWEST      // skip when NOT R_TWOPITWEST
    jmp ppGotRoom
    SKIP_NEXT_IF_SAME [R_TWOPITEAST      // skip when equal (R_TWOPITEAST)
    jmp ppRtn                // differs: neither Twopit room -- nothing to say
ppGotRoom,
    lac i [plantDisplayProp:0]
    SKIP_NEXT_IF_AC_NOT_ZERO                  // skip when AC != 0 (visible -- print it)
    jmp ppRtn                  // AC == 0: not visible yet -- nothing to say
ppVisible,
    dac ppTier
    SKIP_NEXT_IF_DIFFERENT [1
    jmp ppTierOne           // AC == 1 (equal): the 12-ft tier
ppTierTwo,                    // AC != 1 (falls through, must be 2): the huge/climbable tier
    lac [msg_HERE_PHONY_PLANT_2:1]
    jmp ppPrint
ppTierOne,
    lac [msg_HERE_PHONY_PLANT_1:1]
ppPrint,
    jda advPrintMsg
ppRtn,
    jmp i rtn           // eem is on (entry state; advPrintMsg keeps it on)
rtn, 0
ppTier, 0
    endloc

// ---- FILL (BOTTLE) ---------------------------
// Derived directly against adven.f4 label 9220 (lines ~1668-1677).
// Entered from the bank-0 stub of the same name; never returns.
doFill,
    lac i [nounTok:0]
    SKIP_NEXT_IF_AC_NOT_ZERO                   // skip when AC != 0 (a noun was given)
    jmp filImplicit             // AC == 0 (no skip): intransitive -- assume the bottle
filHaveNoun,                    // AC != 0 (skip): a noun was given
    lio i [nounTok:0]         // token in IO for findObj (S3B)
    jsp i [findObj:0]         // section-13 cross-bank call; returns with eem
                                // on, which this bank-1 caller keeps
    SKIP_NEXT_IF_AC_NOT_ZERO                   // skip when AC != 0 (a known object)
    jmp unknownVerbT             // AC == 0 (no skip): not a known object at all
filCheckBottle,                 // AC != 0 (skip): a known object -- objLocPtr points at its slot
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_BOTTLE)    // skip when AC != the bottle's slot address
    jmp filCheckLoc              // equal (no skip): it IS the bottle
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_VASE)      // TASK-FR23 C19 -- adven.f4 9220's
    jmp filVase                                        //   own first line, "IF(OBJ.EQ.VASE)GOTO 9222"
filNotBottle,                   // differs from both (skip): some other named object
    lac [msg_CANT_FILL:1]
    jmp pmsgT1
// TASK-FR23 C19 (03-Sep-26). FILL VASE used to answer "YOU CAN'T FILL
// THAT." -- adven.f4 label 9222 is a real, three-way case, and the two
// messages it needs were added to the corpus by S1 and left unwired:
//
//     9222 SPK=29
//          IF(LIQLOC(LOC).EQ.0)SPK=144
//          IF(LIQLOC(LOC).EQ.0.OR..NOT.TOTING(VASE))GOTO 2011
//          CALL RSPEAK(145)
//          PROP(VASE)=2
//          FIXED(VASE)=-1
//          GOTO 9021
//
// Read in order: no liquid here is msg 144 whether or not the vase is
// carried; liquid here but the vase only lying about is msg 29; liquid
// here AND carried shatters it. The mutation (PROP=2, FIXED=-1, and the
// drop into curRoom that 9021 performs) is exactly vaseBreakMutate, which
// BREAK VASE and the accidental-drop path already share -- so the three
// consequences stay in one place and vaseBroken is set for scoring on
// every route that can break it.
//
// Note LIQLOC, not "water": filling the vase at the oil pit shatters it
// too. That is the source's own test.
filVase,
    jsp liquidHere              // bank-1 internal -> liquidAtRoom: 0, 1 (water) or 2 (oil)
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp filVaseNoLiquid          // AC == 0 (no skip): LIQLOC(LOC)==0 -- msg 144
    lac i [FAR_OBJ_LOC(OBJ_VASE)]
    SKIP_NEXT_IF_AC_ZERO         // skip when AC == 0 (carried) -- falls through to the shatter
    jmp filVaseNotCarried        // AC != 0 (no skip): not TOTING(VASE) -- msg 29
filVaseShatter,
    lac [msg_FR8_VASE_SHATTERED:1]
    jda advPrintMsg              // print and CONTINUE -- the mutation still has to run
    eem                          // advPrintMsg leaves eem off (same as pmsgT1's own re-enable)
    jsp i [vaseBreakMutate:0]    // bank-0 dual-mode; objLocPtr still points at the vase
    jmp i [turnLoop:0]
filVaseNoLiquid,
    lac [msg_FR8_FILL_VASE_NOTHING:1]
    jmp pmsgT1
filVaseNotCarried,
    lac [msg_NOT_CARRYING:1]
    jmp pmsgT1
filImplicit,
filCheckLoc,                    // shared by both entry paths: is the bottle carried or in curRoom?
    lac i [FAR_OBJ_LOC(OBJ_BOTTLE)]
    SKIP_NEXT_IF_AC_NOT_ZERO                   // skip when AC != 0 (not carried -- check curRoom next)
    jmp filProceed               // AC == 0 (no skip): carried -- proceed directly
filCheckRoom,                   // AC != 0 (skip): not carried -- falls through here
    lac i [FAR_OBJ_LOC(OBJ_BOTTLE)]
    SKIP_NEXT_IF_DIFFERENT i [curRoom:0]        // skip when AC != curRoom (not in this room either)
    jmp filProceed               // AC == curRoom (no skip): bottle is right here -- proceed
filNotHere,                     // AC != curRoom (skip): bottle isn't carried and isn't in curRoom
    lac i [nounTok:0]
    SKIP_NEXT_IF_AC_NOT_ZERO                   // skip when AC != 0 (a noun was given -- explicit FILL BOTTLE)
    jmp filNothingToCarry        // AC == 0 (no skip): intransitive -- the source's own 104 message
filExplicitNotHere,             // AC != 0 (skip): named explicitly, just not here
    lio i [nounTok:0]         // f4 5199: echo the noun
    jmp pSeeNo
filNothingToCarry,
// TASK-FR20 C11 (03-Sep-26): adven.f4 9220's third line is
// "IF(OBJ.EQ.0.AND..NOT.HERE(BOTTLE))GOTO 8000" -- the bare-verb prompt,
// "FILL WHAT?", not msg 104. Msg 104 ("YOU HAVE NOTHING IN WHICH TO CARRY
// IT.") belongs to label 9010's TAKE WATER / TAKE OIL path, where
// checkWaterOilTake still uses it correctly; it was simply the wrong
// message to reuse here. Same IO-carries-the-token shape as
// filExplicitNotHere's pSeeNo and unknownVerbT's pUnknownWord just above.
    lio i [verbTok:0]
    jmp pVerbWhat
filProceed,                     // bottle confirmed carried or in curRoom
    lac i [bottleProp:0]
    SKIP_NEXT_IF_DIFFERENT [1                   // skip when AC != 1 (not empty -- water or oil already in it)
    jmp filCheckLiquid           // AC == 1 (no skip): empty -- check for liquid here
filAlreadyFull,                 // AC != 1 (skip): already has water or oil
    lac [msg_BOTTLE_ALREADY_FULL:1]
    jmp pmsgT1
filCheckLiquid,
    jsp liquidHere              // bank-1 internal
    SKIP_NEXT_IF_AC_NOT_ZERO                   // skip when AC != 0 (liquid available)
    jmp filNothingHere           // AC == 0 (no skip): no liquid here at all
filHaveLiquid,                  // AC != 0 (skip): AC is 1 (water) or 2 (oil)
    SKIP_NEXT_IF_DIFFERENT [1                   // skip when AC != 1 (it's oil)
    jmp filFillWater             // AC == 1 (no skip): water
filFillOil,                     // AC != 1 (skip): oil
    law 2
    dac i [bottleProp:0]
    jsp resyncLiquidObjLoc
                                // objLoc[OIL] to the new bottleProp
    lac [msg_HERE_BOTTLE_OIL:1]
    dac i [FAR_OBJ_HEREMSG(OBJ_BOTTLE)]
    lac [msg_FILL_OIL:1]
    jmp pmsgT1
filFillWater,
    dzm i [bottleProp:0]     // 0 = full of water
    jsp resyncLiquidObjLoc
    lac [msg_HERE_BOTTLE_WATER:1]
    dac i [FAR_OBJ_HEREMSG(OBJ_BOTTLE)]
    lac [msg_FILL_WATER:1]
    jmp pmsgT1
filNothingHere,
    lac [msg_FILL_NOTHING_HERE:1]
    jmp pmsgT1

// unknownVerbT -- bank-1 tail: leave for bank 0's unknownVerb (doFill's
// unknown-noun path). Entered via jmp with eem on; never returns.
unknownVerbT,
    lio i [nounTok:0]     // it's an unknown NOUN here -- echo it, don't
    jmp pUnknownWord      // re-run bank 0's bare-object analysis on the verb

// checkWaterOilTake -- derived directly against adven.f4 label 9010,
// lines 1228-1258).
// Entered via a ONE-WAY farjmp from doTake's dtFound
// (bank 0) once objLocPtr has matched OBJ_WATER or OBJ_OIL there; IO
// holds the requested liquid code, 0 (water) or 2 (oil), matching
// bottleProp's own encoding. Never returns to the bank-0 call site --
// every path either rejoins doTake's generic pipeline at BOTTLE (case 1,
// dtWaterOilRejoin), falls into doFill's own fill logic same-bank (case
// 2, the source's GOTO 9220 cross-verb reuse.
//
// The source's four cases are straight-line code with an overwriting SPK assignment that collapses,
// for real inputs, to four mutually exclusive branches -- implemented
// directly as such here rather than replicating the overwrite literally:
//   1. HERE(BOTTLE) (carried OR in curRoom) AND bottleProp matches the
//      requested liquid -- OBJ=BOTTLE, ordinary carry proceeds.
//   2. TOTING(BOTTLE) AND bottleProp==1 (empty) -- FILL cross-call.
//   3. TOTING(BOTTLE) AND bottleProp doesn't match (has the OTHER
//      liquid) -- msg_BOTTLE_ALREADY_FULL (message 105).
//   4. Not TOTING(BOTTLE) at all (regardless of location/contents) --
//      msg_FILL_NOTHING_TO_CARRY (message 104).
// No return value; never returns. Called cross-bank via farjmp.
// =======================================================================
checkWaterOilTake,
    local cwtWhich, cwtBottleLoc
    dio cwtWhich            // 0 (water) or 2 (oil), from IO -- see dtTakeWater/dtTakeOil
    lac i [FAR_OBJ_LOC(OBJ_BOTTLE)]
    dac cwtBottleLoc           // 0 (carried), curRoom's value (here), or elsewhere
cwtCheckMatch,                   // case 1 requires bottleProp == cwtWhich AND HERE(bottle)
    lac i [bottleProp:0]
    SKIP_NEXT_IF_SAME cwtWhich           // skip when SAME (bottleProp matches the requested liquid)
    jmp cwtNoMatch              // AC != cwtWhich (no skip): doesn't match -- cases 2/3/4
cwtMatch,                        // AC == cwtWhich (skip): matches -- still need HERE(bottle)
    lac cwtBottleLoc
    SKIP_NEXT_IF_AC_NOT_ZERO                     // skip when AC != 0 (not carried) -- check curRoom next
    jmp cwtCase1                   // AC == 0 (no skip): carried -- definitely here -- case 1
cwtCheckRoom,                     // AC != 0 (skip): not carried -- is it in curRoom?
    lac cwtBottleLoc
    SKIP_NEXT_IF_DIFFERENT i [curRoom:0]         // skip when AC != curRoom (bottle elsewhere)
    jmp cwtCase1                   // AC == curRoom (no skip): bottle is right here -- case 1
cwtNoMatch,                       // falls through here too (matches but not HERE) -- cases 2/3/4
                                      // all key off TOTING(bottle) only, not location, from here on
    lac cwtBottleLoc
    SKIP_NEXT_IF_AC_ZERO                      // skip when AC == 0 (carried) -- case 2 or 3
    jmp cwtCase4                   // AC != 0 (no skip): not carried at all -- case 4
cwtCheckEmpty,                    // AC == 0 (skip): carried -- empty (case 2) or the other liquid (case 3)?
    lac i [bottleProp:0]
    SKIP_NEXT_IF_DIFFERENT [1                     // skip when AC != 1 (not empty)
    jmp cwtCase2                   // AC == 1 (no skip): empty -- FILL cross-call
cwtCase3,                         // AC != 1 (skip): carried, not empty, and (from cwtNoMatch)
                                      // doesn't match -- must be the OTHER liquid
    lac [msg_BOTTLE_ALREADY_FULL:1]
    jmp pmsgT1
cwtCase4,
    lac [msg_FILL_NOTHING_TO_CARRY:1]
    jmp pmsgT1
cwtCase2,                         // carrying an empty bottle -- adven.f4's GOTO 9220: reuse
                                      // doFill's own liquid-check/fill logic directly (same bank)
    jmp filCheckLiquid
cwtCase1,                         // bottle here (carried or in curRoom) and already holds the
                                      // requested liquid -- adven.f4's "OBJ=BOTTLE" substitution:
                                      // swap objLocPtr/objTakePtr to BOTTLE's own slots and
                                      // rejoin doTake's generic pipeline (bank 0) at
                                      // dtWaterOilRejoin/dtCheckLoc, exactly as if BOTTLE had
                                      // been typed directly
    lac [FAR_OBJ_LOC(OBJ_BOTTLE)]
    dac i [objLocPtr:0]
    lac [FAR_OBJ_TAKE(OBJ_BOTTLE)]
    dac i [objTakePtr:0]
    farjmp(dtWaterOilRejoin:3)      // wave 3: doTake (and this rejoin label) live in bank 3 now
cwtWhich, 0
cwtBottleLoc, 0
    endloc

// ---- POUR (BOTTLE), PLANT + DOOR branches -------------------
// Derived directly against adven.f4 label 9130 (lines ~1488-1503,
// PLANT) and label 9132 (lines 1507-1509, DOOR.
// POUR, or POUR BOTTLE, assumes the bottle's current contents (bottleProp).
// POUR WATER/OIL names the liquid directly, recognized via direct
// strCmpEq against voc_water/voc_oil, NOT findObj.
// POUR <anything else, or with the bottle
// empty> prints the source's own default message 78 ("YOU CAN'T POUR
// THAT."). Not actually carrying the named liquid (bottle not carried,
// or bottleProp doesn't match) reuses this project's existing generic
// msg_NOT_CARRYING (doWave's own dwNotCarrying/doDrop's ddNotCarrying
// precedent).
//
// On a valid pour: bottleProp -> empty (1), objHereMsg patched to the
// empty tier. Neither at R_WESTPIT nor R_DOORPASSAGE: prints the
// generic message 77 ("YOUR BOTTLE IS EMPTY AND THE GROUND IS WET.")
// and stops. At R_WESTPIT with oil: message 112
// ("THE PLANT INDIGNANTLY SHAKES THE OIL OFF ITS LEAVES..."), no state
// change. At R_WESTPIT with water: print the plant's own current-state
// growth message (re-derived from advn2.f4's PSPEAK subroutine trace --
// PSPEAK(PLANT,PROP(PLANT)+1) actually walks to position
// PROP(PLANT)+2 in the object's message chain, i.e. the tier-100/300/500
// "reaction" lines, NOT the tier-000/200/400 ambient ones the room-print
// loop shows THEN cycle plantProp = (plantProp+2) mod 6 (0->2->4->0), THEN sync
// plantDisplayProp = plantProp/2 (the new value) and patch PLANT's own
// objHereMsg to match the new ambient tier.
//
// At R_DOORPASSAGE, a much simpler
// one-shot binary state, no growth cycle. Any pour resets doorOiled
// (message 113) and patches DOOR's objHereMsg back to the barred tier;
// oil specifically sets doorOiled=1 (message 114) and patches to the
// passable tier. Water at the door has no useful effect (falls into
// the doorOiled=0/message-113 case) -- deliberate, not a bug.
// Entered from the bank-0 stub of the same name; never returns. The

// strCmpEq preserves IO and returns with eem on.
doPour,
    lac i [nounTok:0]
    SKIP_NEXT_IF_AC_NOT_ZERO                   // skip when AC != 0 (a noun was given)
    jmp pouImplicit             // AC == 0 (no skip): intransitive -- use the bottle's contents
pouHaveNoun,                    // AC != 0 (skip): a noun was given
    lio i [nounTok:0]         // token in IO for all three strCmpEq calls
                                // below -- strCmpEq preserves IO (S3B)
    lac [voc_bottle:2]
    dac i [strCmpEq:0]        // farjda composition: deposit the candidate...
    jsp i [strCmpEq:0+1]      // ...enter at strCmpEq+1; eem already on
    SKIP_NEXT_IF_AC_ZERO                      // skip when AC == 0 (NOT "BOTTLE")
    jmp pouImplicit              // AC != 0 (no skip): it IS "BOTTLE" -- same as intransitive
pouCheckWater,                  // AC == 0 (skip): not "BOTTLE" -- falls through here
    lac [voc_water:2]
    dac i [strCmpEq:0]
    jsp i [strCmpEq:0+1]
    SKIP_NEXT_IF_AC_ZERO                      // skip when AC == 0 (NOT "WATER")
    jmp pouTargetWater           // AC != 0 (no skip): it IS "WATER"
pouCheckOil,                    // AC == 0 (skip): not "WATER" -- falls through here
    lac [voc_oil:2]
    dac i [strCmpEq:0]
    jsp i [strCmpEq:0+1]
    SKIP_NEXT_IF_AC_ZERO                      // skip when AC == 0 (NOT "OIL")
    jmp pouTargetOil             // AC != 0 (no skip): it IS "OIL"
pouCantPour,                    // AC == 0 (skip): none of BOTTLE/WATER/OIL -- falls through here.
                                    // f4 9130 answers ACTSPK(POUR) = msg 78 twice over for a noun
                                    // that is neither liquid ("IF(.NOT.TOTING(OBJ))GOTO 2011" and
                                    // then "SPK=78; IF(OBJ.NE.OIL.AND.OBJ.NE.WATER)GOTO 2011"), so
                                    // this one message covers both. The empty-bottle case is NOT
                                    // here any more -- see pouImplicit below (TASK-FR28 N28).
    lac [msg_CANT_POUR:1]
    jmp pmsgT1
pouImplicit,                    // POUR / POUR BOTTLE -- use bottleProp directly (pouWhich reuses
                                    // bottleProp's own 0=water/2=oil encoding, see below)
    lac i [bottleProp:0]
    SKIP_NEXT_IF_DIFFERENT [1                   // skip when AC != 1 (not empty)
    jmp i [verbWhat:0]           // AC == 1 (no skip): empty. TASK-FR28 N28
                                     // (S19, 05-Sep-26): 9130's first two lines are
                                     // "IF(OBJ.EQ.BOTTLE.OR.OBJ.EQ.0)OBJ=LIQ(0)" then
                                     // "IF(OBJ.EQ.0)GOTO 8000", so an empty bottle
                                     // leaves no object and the source asks
                                     // "POUR WHAT?" -- it does not refuse.
pouImplicitHaveLiquid,           // AC != 1 (skip): AC still holds bottleProp, 0 (water) or 2 (oil)
    dac pouWhich              // reuse bottleProp's value directly as pouWhich -- same encoding
    jmp pouCheckCarrying
pouTargetWater,
    dzm pouWhich               // 0 = water, matching bottleProp's own encoding
    jmp pouCheckCarrying
pouTargetOil,
    law 2
    dac pouWhich
pouCheckCarrying,               // pouWhich is now 0 (water) or 2 (oil) -- must match what's
                                    // actually in the bottle (TOTING(that liquid))
    lac i [bottleProp:0]
    SKIP_NEXT_IF_SAME pouWhich              // skip when SAME (bottleProp already matches the named/implied liquid)
    jmp pouNotCarrying           // AC != pouWhich (no skip): not carrying that liquid at all
pouCheckBottleCarried,           // AC == pouWhich (skip): liquid matches -- still need TOTING(bottle)
    lac i [FAR_OBJ_LOC(OBJ_BOTTLE)]
    SKIP_NEXT_IF_AC_NOT_ZERO                    // skip when AC != 0 (bottle is sitting in a room, not carried)
    jmp pouEmptyBottle           // AC == 0 (no skip): carrying the bottle -- pour it out
pouNotCarrying,                 // AC != 0 (skip): bottle not carried
    lac [msg_NOT_CARRYING:1]
    jmp pmsgT1
pouEmptyBottle,
    law 1
    dac i [bottleProp:0]      // 1 = empty
    jsp resyncLiquidObjLoc
    lac [msg_HERE_BOTTLE_EMPTY:1]
    dac i [FAR_OBJ_HEREMSG(OBJ_BOTTLE)]
    lac i [curRoom:0]
    SKIP_NEXT_IF_DIFFERENT [R_WESTPIT            // skip when AC != R_WESTPIT (not at the plant)
    jmp pouAtPlant                // AC == R_WESTPIT (no skip): at the plant's room
pouCheckDoor,                    // AC != R_WESTPIT (skip): not at the plant
    lac i [curRoom:0]
    SKIP_NEXT_IF_DIFFERENT [R_DOORPASSAGE
    jmp pouAtDoor                 // AC == R_DOORPASSAGE (no skip): at the rusty door
pouElsewhere,                    // AC != R_DOORPASSAGE (skip): neither the plant nor the door
    lac [msg_POUR_EMPTY:1]
    jmp pmsgT1
pouAtPlant,
    lac pouWhich
    SKIP_NEXT_IF_AC_ZERO                       // skip when AC == 0 (water)
    jmp pouOilOnPlant             // AC != 0 (no skip): oil (pouWhich==2) -- rejected, no state change
pouWaterOnPlant,                  // AC == 0 (skip): water -- the real growth mechanic
    lac i [plantProp:0]
    SKIP_NEXT_IF_DIFFERENT [0                    // skip when AC != 0 (not tiny)
    jmp pouGrowth1                // AC == 0 (no skip): tiny -- the tier-100 growth message
pouCheckTwo,                      // AC != 0 (skip): plantProp is 2 or 4
    lac i [plantProp:0]
    SKIP_NEXT_IF_DIFFERENT [2                    // skip when AC != 2
    jmp pouGrowth2                // AC == 2 (no skip): the tier-300 growth message
pouGrowth4,                       // AC != 2 (skip): must be 4 -- the tier-500 over-watered message
    lac [msg_PLANT_OVERWATERED:1]
    jda advPrintMsg
    jmp pouCycle
pouGrowth1,
    lac [msg_PLANT_GROWTH_1:1]
    jda advPrintMsg
    jmp pouCycle
pouGrowth2,
    lac [msg_PLANT_GROWTH_2:1]
    jda advPrintMsg
pouCycle,                         // plantProp = MOD(plantProp+2, 6) -- only ever 0, 2, or 4, so the
                                      // wrap case is simply "did the sum reach 6"
    lac i [plantProp:0]
    add [2
    SKIP_NEXT_IF_DIFFERENT [6                    // skip when AC != 6
    jmp pouWrap                   // AC == 6 (no skip): wraps to 0
pouSetProp,                       // AC != 6 (skip): 2 or 4 -- use the sum as-is
    dac i [plantProp:0]
    jmp pouSyncDisplay
pouWrap,
    dzm i [plantProp:0]
pouSyncDisplay,                   // plantDisplayProp = plantProp/2 -- an exact arithmetic right-shift
                                      // for these non-negative even values, no div needed
    lac i [plantProp:0]
    sar 1s
    dac i [plantDisplayProp:0]
    lac i [plantProp:0]
    SKIP_NEXT_IF_DIFFERENT [0                    // skip when AC != 0 (not tiny)
    jmp pouTierTiny                // AC == 0 (no skip): tiny
pouTierCheck2,                    // AC != 0 (skip): plantProp is 2 or 4
    lac i [plantProp:0]
    SKIP_NEXT_IF_DIFFERENT [2                    // skip when AC != 2
    jmp pouTierBeanstalk           // AC == 2 (no skip): the 12-ft beanstalk tier
pouTierGigantic,                  // AC != 2 (skip): must be 4 -- the gigantic/climbable tier
    lac [msg_HERE_PLANT_GIGANTIC:1]
    jmp pouTierDone
pouTierTiny,
    lac [msg_HERE_PLANT_TINY:1]
    jmp pouTierDone
pouTierBeanstalk,
    lac [msg_HERE_PLANT_BEANSTALK:1]
pouTierDone,
    dac i [FAR_OBJ_HEREMSG(OBJ_PLANT)]
// TASK-FR23 C20 (03-Sep-26): adven.f4 9130's water-on-the-plant leg does
// not end at 2011 like the rest of POUR. It ends
//
//     PROP(PLANT2)=PROP(PLANT)/2
//     K=NULL
//     GOTO 8
//
// -- K=NULL is "stay put", and GOTO 8 walks the ordinary describe path,
// so the room is printed again and the beanstalk the pour just grew is
// visible in the same reply. Without it the player is told the plant
// "SUDDENLY SPRINGS ERECT" and then sees nothing until the next LOOK.
//
// enterRoom is the port's 2000/2001, and calling it (rather than moveGo)
// is deliberate: label 8 sets OLDLC2=OLDLOC for every motion word EXCEPT
// NULL/BACK/LOOK/CAVE, so a NULL "move" leaves prevRoom and oldLc2 alone
// -- the same reasoning doPlugh's own restored-store comment records.
// curRoom has not changed, so ROOM_CACHE is already the right room and no
// loadRoom is needed.
    jsp i [turnCreatures:0]   // label 2 is label 2: the dwarf block runs here
                                 // too, ahead of the room text (TASK-FR25 N1)
    jsp i [enterRoom:0]       // dual-mode; returns with eem on
    jmp i [turnLoop:0]        // end the turn (eem is on; turnLoop lems)
pouOilOnPlant,
    lac [msg_PLANT_OIL_REJECT:1]
    jmp pmsgT1

// ---- POUR  --------------
// derived directly against adven.f4 label 9132 (lines 1507-1509),
// Any pour at R_DOORPASSAGE resets doorOiled=0 by default
// (message 113); oil specifically sets doorOiled=1 (message 114).
// Water has no useful effect here -- it falls into the same doorOiled=0/
// message-113 case as every other liquid -- deliberate, not a bug.
pouAtDoor,
    lac pouWhich
    SKIP_NEXT_IF_AC_ZERO                       // skip when AC == 0 (water)
    jmp pouOilOnDoor              // AC != 0 (no skip): oil -- unrusts the door
pouWaterOnDoor,                   // AC == 0 (skip): water -- no useful effect
    dzm i [doorOiled:0]
    lac [msg_HERE_DOOR_RUSTY:1]
    dac i [FAR_OBJ_HEREMSG(OBJ_DOOR)]
    lac [msg_DOOR_STILL_RUSTY:1]
    jmp pmsgT1
pouOilOnDoor,
    law 1
    dac i [doorOiled:0]
    lac [msg_HERE_DOOR_OILED:1]
    dac i [FAR_OBJ_HEREMSG(OBJ_DOOR)]
    lac [msg_DOOR_OIL_SUCCESS:1]
    jmp pmsgT1
pouWhich, 0

// dtFirstKillOne -- pick one dwarf uniformly (1..5) and kill it with
// independent 50% odds: adven.f4's "DO 6001 I=1,2" loop body (lines
// 668-671), called twice by dwarfTurn's dtFirstHit below.
// No argument, no return value. Called via jsp --
// BANK-1 INTERNAL ONLY (dwarfTurn), eem on throughout.
dtFirstKillOne,
    local rtn, jptr
    dap rtn
    lio [dwarfIndexList:.]
    law 5
    dac i [selectRandom:3]      // farjda composition, direct (eem on)
    jsp i [selectRandom:3+1]    // AC = a uniformly-picked 0-based dwarf index (0..4)
    add [dwarfLoc:0             // + the bank-0 table base (high bits 0)
    dac jptr                    // jptr = &dwarfLoc[the picked index]
    lio [dtKillOneList:.]       // pct=49 -> 50/100, probabilitySelector2's own convention
    jsp i [probabilitySelector2:3]
    SKIP_NEXT_IF_DIFFERENT [-1]
    jmp rtn                     // AC == -1 (no skip): missed the 50% roll -- nothing happens
dtfkHit,                        // AC != -1 (skip): the 50% roll hit
    lac i jptr
    SKIP_NEXT_IF_AC_ZERO        // skip when AC == 0 (this dwarf is already dead)
    jmp dtfkKill                 // AC != 0 (no skip): alive -- kill it
dtfkAlreadyDead,                   // AC == 0 (skip): already dead -- no double-decrement
    jmp rtn
dtfkKill,
    dzm i jptr
    lac i [dwarvesRemaining:0]
    sub [1
    dac i [dwarvesRemaining:0]
rtn, jmp 0
jptr, 0
dwarfIndexList, 0
                1
                2
                3
                4
dtKillOneList, 0d49          // probabilitySelector2 list: id unused (single-outcome test)
               0                // list terminator
    endloc

// dwMoveOne -- moves one dwarf (0-based index 0..4 in IO on entry) one
// turn: escorts the player directly if its dwarfSeen bit is already set
// and the player is still in dwarf territory (source's DSEEN "sticks with
// us" mechanic, adven.f4 line 680/711); otherwise an independent random
// walk over its current room's built EXIT graph, excluding self, the room
// it just came from, any room outside dwarf territory and any
// forced-motion room -- every other exit is a valid destination
// regardless of its COND gate (DWARF-LOGIC-TIER2-PLAN.md section 1's
// COND-transparency finding: ordinary dwarves check only the source's
// M==100 marker, which this project's built EXIT rows never encode), with
// a forced-backtrack fallback if every exit is excluded (adven.f4 line
// 703's own TK(J)=ODLOC(I) fallback).
// The last two exclusions are TASK-FR13 (03-Sep-26): adven.f4 lines
// 695-698 exclude NEWLOC.LT.15 and FORCED(NEWLOC) as well, and without
// them dwarves walked out of R_MISTHALL and R_MAZE_BRINKPIT onto the
// surface -- being knifed to death at the End of Road is not something
// the original can do -- and stood in the three forced rooms an exit
// actually points at (R_FISSURE_DEATH via either bank's JUMP row,
// R_LOWCRAWL_A from R_FISSURE_WEST, R_LOWCRAWL_B from R_MISTHALL_WEST).
// Both are answered by bank 3's isDwarfRoom/isForcedRoom, which take a
// room NUMBER -- checkDwarfRoom cannot be used here because it reads
// ROOM_CACHE, i.e. always curRoom, and DWARF_ROOM_SCRATCH holds the
// dwarf's own room, not the candidate's. Sets the dwarfSeen bit and snaps
// dwarfLoc to curRoom immediately the turn a walking dwarf first becomes
// colocated with the player (adven.f4 lines 708-711). Called only for a
// dwarf already confirmed alive (dwarfLoc[ix] != 0). No return value --
// dwarfLoc/dwarfPrevLoc/dwarfSeen are updated in place. Called via
// jsp -- BANK-1 INTERNAL ONLY (dwarfTurn), eem on throughout.
dwMoveOne,
    local rtn, ix, locPtr, prevPtr, maskPtr, mask
    addlocal candCount, candSlot
    addlocal scanPtr, scanCount, scanIx
    addlocal oldLoc, oldPrev, destVal, destPtr
    dap rtn
    dio ix
    lac [dwarfLoc:0]
    add ix
    dac locPtr
    lac [dwarfPrevLoc:0]
    add ix
    dac prevPtr
    lac [dwarfBitMask:0]
    add ix
    dac maskPtr
    lac i maskPtr
    dac mask

// ---- escort check: is this dwarf's dwarfSeen bit already set?
    lac i [dwarfSeen:0]
    and mask
    SKIP_NEXT_IF_AC_ZERO         // skip when AC == 0 (bit clear -- never escorted, go to walk)
    jmp dmoSeenCheckZone          // AC != 0 (no skip): bit set -- check whether still in the zone
dmoNotSeen,                         // AC == 0 (skip): falls through -- random walk
    jmp dmoWalk
dmoSeenCheckZone,
    jsp i [checkDwarfRoom:0]     // section-13 dual-mode; returns with eem on
    SKIP_NEXT_IF_AC_ZERO
    jmp dmoEscort                  // AC != 0 (no skip): still in the zone -- escort
dmoLeftZone,                         // AC == 0 (skip): player left the zone -- drop escort
    lac mask
    cma
    and i [dwarfSeen:0]
    dac i [dwarfSeen:0]
    jmp dmoWalk
dmoEscort,
    lac i locPtr
    dac i prevPtr
    lac i [curRoom:0]
    dac i locPtr
    jmp rtn

// ---- independent random walk ----
dmoWalk,
    lac i locPtr
    dac oldLoc
    lio oldLoc                      // dwarf's current room number, into IO for loadRoom
    jsp i [loadRoom:0]              // section-13 cross-bank; trailing param below
    DWARF_ROOM_SCRATCH:.
    lac i prevPtr
    dac oldPrev

// build the candidate list: every exit in DWARF_ROOM_SCRATCH except one
// equal to oldLoc (self) or oldPrev (just came from) -- COND is never
// evaluated at all, every other exit is unconditionally a valid dwarf
// destination.
    lac DWARF_ROOM_SCRATCH
    GET_EXIT_COUNT
    dac scanCount
    lac [DWARF_ROOM_SCRATCH:.+EXIT_OFFSET]
    dac scanPtr
    dzm scanIx
    dzm candCount
dmoScan,
    lac scanIx
    SKIP_NEXT_IF_DIFFERENT scanCount
    jmp dmoPick                      // scanIx == scanCount (no skip): scan done
dmoScanCheck,                           // scanIx != scanCount (skip): an entry to check
    // TASK-FR3/FR4: a message-only row is not a destination at all --
    // COND_MSG's room-number field is 0, and COND_RANDMSG's carries a
    // roll threshold that would read as a low room number. Skip both
    // before the field is ever believed. (This is not FR13's
    // confinement filter, which is a separate matter; it is only
    // "don't walk into a row that names no room".)
    //
    // TASK-FR2 step 3: the condition-ID test below is no longer enough on
    // its own. A gated message-only row carries an ordinary condTable ID
    // (1..8) and still names no room, so the room number itself is
    // tested for 0 further down -- that test, not this one, is what
    // "names no room" now means. This one is kept because it is what
    // stops COND_RANDMSG's threshold field from ever being read as a
    // room number in the first place.
    lac i scanPtr
    GET_CONDITION_ID
    sub [COND_MSG
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp dmoScanAdvance                  // condId >= COND_MSG (no skip): not a destination row
                                        // condId <  COND_MSG (skip): may be a real destination
    law EXIT_DEST            // the destination lives in the entry's second word
    add scanPtr
    dac destPtr
    lac i destPtr
    GET_ROOM_NUMBER
    dac destVal
    SKIP_NEXT_IF_AC_NOT_ZERO            // skip when the row does name a room
    jmp dmoScanAdvance                  // room 0 (no skip): a gated message row -- no
                                        //   destination to walk to (TASK-FR2 step 3)
    lac destVal
    SKIP_NEXT_IF_DIFFERENT oldLoc       // skip when destVal != oldLoc (not self)
    jmp dmoScanAdvance                     // destVal == oldLoc (no skip): self -- excluded
dmoNotSelf,                                  // destVal != oldLoc (skip): keep checking
    lac destVal
    SKIP_NEXT_IF_DIFFERENT oldPrev      // skip when destVal != oldPrev (not just-came-from)
    jmp dmoScanAdvance                     // destVal == oldPrev (no skip): excluded
dmoNotBacktrack,                             // destVal != oldPrev (skip): keep checking
    // TASK-FR13, adven.f4 line 696: NEWLOC.LT.15 -- a dwarf never leaves
    // the cave. Expressed as the candidate room's own DWARF flag, not as
    // a room-number boundary; isDwarfRoom's own header says why the
    // port's numbering cannot express the source's compare.
    lio destVal
    jsp i [isDwarfRoom:3]               // section-13 cross-bank; eem stays on,
                                           // IO comes back holding destVal
    SKIP_NEXT_IF_AC_NOT_ZERO            // skip when AC != 0 (dwarf territory -- keep checking)
    jmp dmoScanAdvance                     // AC == 0 (no skip): outside the zone -- excluded
dmoInZone,                                   // AC != 0 (skip): in the zone
    // TASK-FR13, adven.f4 line 696 again: FORCED(NEWLOC) -- a dwarf never
    // stands in a forced-motion room.
    lio destVal
    jsp i [isForcedRoom:3]
    SKIP_NEXT_IF_AC_ZERO                // skip when AC == 0 (not forced -- a real candidate)
    jmp dmoScanAdvance                     // AC != 0 (no skip): forced-motion -- excluded
dmoCandidate,                                // AC == 0 (skip): a real candidate
    lac [dmoCand:.]
    add candCount
    dac candSlot
    lac destVal
    dac i candSlot
    idx candCount
dmoScanAdvance,
    law EXIT_RECORDSIZE
    add scanPtr
    dac scanPtr
    idx scanIx
    jmp dmoScan
dmoPick,
    lac candCount
    SKIP_NEXT_IF_AC_ZERO
    jmp dmoHaveCandidates              // AC != 0 (no skip): at least one candidate
dmoNoCandidates,                         // AC == 0 (skip): dead end -- forced backtrack
    lac oldLoc
    dac i prevPtr                         // dwarfPrevLoc[ix] = oldLoc
    lac oldPrev
    dac i locPtr                           // dwarfLoc[ix] = oldPrev (reverse direction)
    jmp dmoColocationTest
dmoHaveCandidates,
    lio [dmoCand:.]
    lac candCount
    dac i [selectRandom:3]               // farjda composition, direct (eem on)
    jsp i [selectRandom:3+1]             // AC = the chosen destination room number
    dac destVal
    lac oldLoc
    dac i prevPtr                         // dwarfPrevLoc[ix] = oldLoc
    lac destVal
    dac i locPtr                           // dwarfLoc[ix] = chosen destination
dmoColocationTest,
    lac i locPtr
    SKIP_NEXT_IF_SAME i [curRoom:0]       // skip when dwarfLoc[ix] == curRoom
    jmp dmoCheckPrevColoc                    // != curRoom (no skip): also check prevLoc
dmoLocColoc,                                   // == curRoom (skip): colocated via new loc
    jmp dmoSetSeen
dmoCheckPrevColoc,
    lac i prevPtr
    SKIP_NEXT_IF_SAME i [curRoom:0]
    jmp rtn                                    // != curRoom (no skip): not colocated -- done
dmoPrevColoc,                                    // == curRoom (skip): colocated via prevLoc
dmoSetSeen,
    lac i [dwarfSeen:0]
    ior mask
    dac i [dwarfSeen:0]
    lac i [curRoom:0]
    dac i locPtr                                // snap dwarfLoc[ix] = curRoom immediately
    jmp rtn
rtn, jmp 0
ix, 0
locPtr, 0
prevPtr, 0
maskPtr, 0
mask, 0
dmoCand,
                      // self-reference above, which am1 bank-ref syntax
                      // only offers for global location symbols
    table MAXEXITS
candCount, 0
candSlot, 0
scanPtr, 0
scanCount, 0
scanIx, 0
oldLoc, 0
oldPrev, 0
destVal, 0
destPtr, 0
    endloc

// DWARF_ROOM_SCRATCH --  a dedicated
// buffer for a non-escorting dwarf's candidate-room exit-list fetch
// loaded via loadRoom's generalized API keyed off that
// dwarf's own room number, never curRoom.
// Bank-1 resident -- loadRoom
// drum transfer lands here directly.
DWARF_ROOM_SCRATCH,
    table ROOMTAB_RECORDSIZE

// dwarfTurn -- Runs once per player command, at the top of turnLoop, i.e.
// AFTER that command has been fully dispatched (CLAUDE 01-Sep-26: it used to
// run before the dispatch, which put the dwarves one command ahead of the
// player -- see turnLoop's own note). The original runs its dwarf block at
// label 74, right after LOC=NEWLOC, so the dwarves always act in the room the
// player has just arrived in; this placement is the equivalent.
// The dwarf-processing block runs unconditionally every turn, regardless of
// the typed verb. (The source is narrower -- only verbs that GOTO 2, chiefly
// movement, re-enter the dwarf block at all; verbs ending at 2011/2012/2600
// skip it. This port's every-turn model is a deliberate, long-standing
// deviation, unchanged here.)
//
// State machine (dwarfStage, a direct analog of the source's DFLAG):
//   0 = no dwarf activity yet (waiting to reach dwarf territory)
//   1 = activated, hasn't met the first dwarf yet
//   2 = met the first dwarf; next attack (if any) is a guaranteed miss
//   3 = ongoing -- ~9.5% knife-hit chance per attacking dwarf from here on
//
dwarfTurn,
    local rtn, inZone, dwix, dwptr, dwptr2, dwTotal, dwAttack, dwStick
    dac rtn

// adven.f4 line 657's "BYPASS DWARF STUFF" gate, run BEFORE the DFLAG/activation check):
// while curRoom carries/ PIRATE_FORBID, skip activation, movement, and the attack tally
// entirely for this turn, source's comment is explicit this covers
// ordinary dwarves too ("DWARVES CAN'T MEET THE BEAR... WON'T FOLLOW HIM
// INTO DEAD END IN MAZE"), not just the pirate (pirateTurn has its own
// matching gate below). Checked ahead of the ordinary dwarf-territory
// test since source's own GOTO 2000 precedes the DFLAG check entirely.
    jsp i [checkPirateForbidRoom:0]    // section-13 dual-mode; returns with eem on
    SKIP_NEXT_IF_AC_ZERO
    jmp dtDone                          // AC != 0: forbidden zone -- nothing happens this turn

    jsp i [checkDwarfRoom:0]    // section-13 dual-mode; returns with eem on
    dac inZone

// ---- activation: dwarfStage 0 -> 1, first turn spent in dwarf territory
    lac i [dwarfStage:0]
    SKIP_NEXT_IF_AC_ZERO                 // skip when dwarfStage == 0 (check activation)
    jmp dtStage1Check       // dwarfStage != 0: already past activation
dtActivate,                 // dwarfStage == 0: check activation
    lac inZone
    SKIP_NEXT_IF_AC_NOT_ZERO                // skip when inZone != 0 (in dwarf territory -- activate)
    jmp dtDone              // inZone == 0: not yet -- nothing to do this turn
dtDoActivate,                // inZone != 0: in dwarf territory -- activate
    law 1
    dac i [dwarfStage:0]
    jmp dtDone                // activation itself is silent -- no roll the same turn

// ---- first encounter: dwarfStage 1 -> 2, flat 5% per turn in the zone
dtStage1Check,
    lac i [dwarfStage:0]
    SKIP_NEXT_IF_SAME [1                // skip when equal (dwarfStage == 1)
    jmp dtStage2Check         // differs: dwarfStage >= 2, skip ahead
dtStage1,                     // equal: dwarfStage == 1
    lac inZone
    SKIP_NEXT_IF_AC_NOT_ZERO                // skip when inZone != 0 (in the zone -- roll for it)
    jmp dtDone              // inZone == 0: left the zone -- no roll
dtFirstRoll,                 // inZone != 0: in the zone -- roll for it
dtFirstDraw,
    lio [dtFirstList:.]
    jsp i [probabilitySelector2:3]
    SKIP_NEXT_IF_DIFFERENT [-1]
    jmp dtDone              // AC == -1 (no skip): missed the roll -- nothing happens
dtFirstHit,                    // AC != -1 (skip): the 5% hit -- adven.f4 lines 665-677
    law 2
    dac i [dwarfStage:0]
// adven.f4:671's "IF(SAVED.NE.-1)" suppression of both stealth kills is
// deliberately NOT reproduced -- TASK-FR16 16b (S5). SAVED is -1 on every
// normal return from START (advn2.f4:407), so the test fires only when the
// player re-ran the suspended core image and bypassed the latency check.
// This port has no latency check to bypass, so there is nothing to punish
// and a legitimate RESTORE now costs the player nothing, as in the original.
    jsp dtFirstKillOne
    jsp dtFirstKillOne
dtFirstRelocate,
// adven.f4's DO 6002 loop: any surviving dwarf standing exactly where the
// player is right now silently steps aside to R_NUGGET (DALTLC=18)
// instead of being "found" this turn, then every dwarf's prevLoc is
// synced to its (possibly just-relocated) current loc, matching
// ODLOC(I)=DLOC(I) for I=1..5.
    dzm dwix
dtFirstRelocLoop,
    lac dwix
    SKIP_NEXT_IF_DIFFERENT [5
    jmp dtFirstAnnounce             // dwix == 5 (no skip): all 5 synced -- announce
dtFirstRelocCheck,                     // dwix != 5 (skip): an index to process
    lac [dwarfLoc:0]
    add dwix
    dac dwptr
    lac i dwptr
    SKIP_NEXT_IF_SAME i [curRoom:0]         // skip when dwarfLoc[dwix] == curRoom
    jmp dtFirstRelocStore                     // != curRoom (no skip): not coincident -- just sync
dtFirstRelocHit,                                // == curRoom (skip): coincident -- relocate first
    law R_NUGGET
    dac i dwptr
dtFirstRelocStore,
    lac [dwarfPrevLoc:0]
    add dwix
    dac dwptr2
    lac i dwptr                                  // reload (possibly just-relocated) dwarfLoc[dwix]
    dac i dwptr2                                  // dwarfPrevLoc[dwix] = dwarfLoc[dwix]
    idx dwix
    jmp dtFirstRelocLoop
dtFirstAnnounce,
    lac [msg_DWARF_FIRST:1]
    jda advPrintMsg
    lac i [curRoom:0]
    dac i [FAR_OBJ_LOC(OBJ_AXE)]   // the axe appears wherever the player is standing right now
    jmp dtDone

// ---- ongoing: dwarfStage >= 2, real per-dwarf movement + combat tally.
// Runs every turn once active, regardless of inZone -- dwarves keep
// wandering in the background even when the player has left dwarf
// territory (adven.f4's 6010 loop has no such gate; DTOTAL naturally
// lands at 0 whenever no dwarf's position happens to equal curRoom).
dtStage2Check,
    dzm dwTotal
    dzm dwAttack
    dzm dwStick
    dzm dwix
dtMoveLoop,
    lac dwix
    SKIP_NEXT_IF_DIFFERENT [5
    jmp dtTallySetup                // dwix == 5 (no skip): all 5 moved
dtMoveEntry,                           // dwix != 5 (skip): an index to process
    lac [dwarfLoc:0]
    add dwix
    dac dwptr
    lac i dwptr
    SKIP_NEXT_IF_AC_ZERO            // skip when dwarfLoc[dwix] == 0 (dead)
    jmp dtMoveOne                     // != 0 (no skip): alive -- move it
dtMoveDead,                             // == 0 (skip): dead -- nothing to do
    jmp dtMoveAdvance
dtMoveOne,
    lio dwix
    jsp dwMoveOne
dtMoveAdvance,
    idx dwix
    jmp dtMoveLoop

dtTallySetup,
    dzm dwix
dtTallyLoop,
    lac dwix
    SKIP_NEXT_IF_DIFFERENT [5
    jmp dtMessage                    // dwix == 5 (no skip): all 5 tallied
dtTallyEntry,                           // dwix != 5 (skip): an index to check
    lac [dwarfLoc:0]
    add dwix
    dac dwptr
    lac i dwptr
    SKIP_NEXT_IF_SAME i [curRoom:0]        // skip when dwarfLoc[dwix] == curRoom
    jmp dtTallyAdvance                        // != curRoom (no skip): not colocated -- next
dtTallyColocated,                               // == curRoom (skip): colocated this turn
    idx dwTotal
    lac [dwarfPrevLoc:0]
    add dwix
    dac dwptr2
    lac i dwptr2
    SKIP_NEXT_IF_SAME i [curRoom:0]         // skip when dwarfPrevLoc[dwix] == curRoom (was here
                                                 // last turn too -- an attacker, not "just arrived")
    jmp dtTallyAdvance                         // != curRoom (no skip): just arrived -- DTOTAL only
dtTallyAttacker,                                 // == curRoom (skip): attacking
    idx dwAttack
// Hit-chance formula uses the PRE-bump dwarfStage, exactly like the
// source (adven.f4's RAN(1000).LT.95*(DFLAG-2) evaluated once per
// attacker, before the post-loop DFLAG 2->3 bump in the message section
// below) -- dwarfStage==2 makes the threshold always false, a guaranteed
// miss for every attacker on the very first attack turn ever, matching
// dtKnifeRoll's original single-roll precedent extended per-attacker.
    lac i [dwarfStage:0]
    SKIP_NEXT_IF_SAME [2                     // skip when equal (first attack turn -- guaranteed miss)
    jmp dtTallyStickRoll                       // differs (== 3): roll normally
dtTallyGuaranteedMiss,                            // equal (== 2): guaranteed miss, no roll at all
    jmp dtTallyAdvance
// adven.f4:772's "IF(RAN(1000).LT.95*(DFLAG-2).OR.SAVED.NE.-1)" second
// disjunct -- a guaranteed knife hit once any RESTORE has happened -- is
// deliberately NOT reproduced. TASK-FR16 16b (S5); same reasoning as
// dtFirstHit's, above.
dtTallyStickRoll,                                   // dwarfStage == 3: roll for it
// Same 3-in-32 (9.375%) approximation as the original dtKnifeDraw, now
// rolled once per attacking dwarf in this loop instead of once per turn.
    jsp i [rand18:3]
// CLAUDE 01-Sep-26: the 0d prefix is required. This file assembles in
// octal, so a bare [31 is 0d25 -- bits {0,3,4} -- which makes the draw
// land in {0,1,8,9,16,17,24,25} and the {0,1,2} chain below hit 2-in-8
// = 25%, not the intended 3-in-32 = 9.375% (adven.f4's figure is 9.5%).
    and [0d31
    SKIP_NEXT_IF_DIFFERENT [0
    jmp dtTallyStickHit          // branch 1 (equal to 0): a hit
    SKIP_NEXT_IF_DIFFERENT [1
    jmp dtTallyStickHit          // branch 1 (equal to 1): a hit
    SKIP_NEXT_IF_SAME [2                   // skip when equal to 2 -- a hit
    jmp dtTallyAdvance              // differs: none matched -- a miss
dtTallyStickHit,
    idx dwStick
dtTallyAdvance,
    idx dwix
    jmp dtTallyLoop

// Mmessage branching: three independent tiers, DTOTAL/ATTACK/STICK
dtMessage,
    lac dwTotal
    SKIP_NEXT_IF_AC_ZERO
    jmp dtTotalNonzero
dtTotalZero,
    jmp dtCheckAttack                // DTOTAL == 0: no dwarf text at all, straight through
dtTotalNonzero,
    lac dwTotal
    SKIP_NEXT_IF_SAME [1
    jmp dtTotalPlural
dtTotalOne,
    lac [msg_DWARF_PRESENT:1]
    jda advPrintMsg
    jmp dtCheckAttack
dtTotalPlural,
// CLAUDE 04-Sep-26 (TASK-FR35): adven.f4:765's FORMAT 67 leading slash.
// BEFORE the lio, never after it: `newline` is law/lia/tcb, so it
// clobbers IO, and IO is how the count reaches printDwarfCountMsg.
// At the call site rather than inside the routine, to match the two
// sites below -- there the newline CANNOT live in the routine, because
// printCountMsg is shared with a caller that must not emit one.
    newline
    lio dwTotal
    jsp printDwarfCountMsg
dtCheckAttack,
    lac dwAttack
    SKIP_NEXT_IF_AC_ZERO
    jmp dtAttackNonzero
dtAttackZero,
    jmp dtDone                        // ATTACK == 0: no knife text, stop here
dtAttackNonzero,
    lac i [knfloc:0]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE    // skip when AC >= 0 (not yet retired) -- go set it
    jmp dtKnflocDone                 // AC < 0 (no skip): already retired -- leave it
    lac i [curRoom:0]
    dac i [knfloc:0]
dtKnflocDone,
// dwarfStage 2->3 transition, unconditional on ATTACK>0, once per turn,
// AFTER every attacker's STICK roll above already used the pre-bump value
// (source line 770). The SAVED.NE.-1 -> DFLAG=20 escalation on that same
// source line is deliberately not reproduced -- TASK-FR16 16b (S5) removed
// every post-RESTORE penalty, and dwarfStage has no DFLAG=20 equivalent
// to escalate to in any case.
    lac i [dwarfStage:0]
    SKIP_NEXT_IF_SAME [2
    jmp dtAttackBranch
dtBumpStage3,
    law 3
    dac i [dwarfStage:0]
dtAttackBranch,
    lac dwAttack
    SKIP_NEXT_IF_SAME [1
    jmp dtAttackPlural
dtAttackOne,
    lac [msg_DWARF_KNIFE:1]
    jda advPrintMsg
    lac dwStick
    SKIP_NEXT_IF_AC_ZERO
    jmp dtStickHitSingle
dtStickMissSingle,
    lac [msg_DWARF_MISS:1]
    jda advPrintMsg
    jmp dtDone
dtStickHitSingle,
    lac [msg_DWARF_HIT:1]
    jmp pmsgDie1                  // death offers reincarnation
dtAttackPlural,
// CLAUDE 04-Sep-26 (TASK-FR35): adven.f4:775's FORMAT 78 leading slash.
// Before the lio -- see dtTotalPlural above.
    newline
    lio dwAttack
    law attackCountMsg
// CLAUDE 01-Sep-26: jda, not jsp. printCountMsg is a jda-entry routine --
// the caller's AC (the message address) is deposited into its leading
// word and read back by its own lac printCountMsg. A jsp lands on that
// data word instead and never passes the argument, so every multi-dwarf
// ATTACK/STICK line printed the wrong text or none.
    jda printCountMsg     // same-bank now
    lac dwStick
    SKIP_NEXT_IF_AC_ZERO
    jmp dtStickCheckMulti
dtStickNoneHit,
    lac [msg_DWARF_NONE_HIT:1]
    jda advPrintMsg
    jmp dtDone
dtStickCheckMulti,
    lac dwStick
    SKIP_NEXT_IF_SAME [1
    jmp dtStickPlural
dtStickOneHit,
    lac [msg_DWARF_ONE_HIT:1]
    jmp pmsgDie1                // death offers reincarnation
dtStickPlural,
// CLAUDE 04-Sep-26 (TASK-FR35): adven.f4:782's FORMAT 68 leading slash.
// Before the lio -- see dtTotalPlural above. Note this is the LIVE site
// for format 68: printStickCountMsg, which TASK-FR35's site table names,
// has no callers at all.
    newline
    lio dwStick                 // count of dwarves that stuck you
    law stickCountMsg
// CLAUDE 01-Sep-26: jda, not jsp -- see dtAttackPlural above.
    jda printCountMsg
    jmp pdEnter1                // go straight to the death flow

dtDone,
    jmp i rtn
rtn, 0
inZone, 0
dwix, 0
dwptr, 0
dwptr2, 0
dwTotal, 0
dwAttack, 0
dwStick, 0
dtFirstList, 0d4             // probabilitySelector2 list: id unused (single-outcome test)
             0                 // list terminator
    endloc


// checkTrollPayment -- THROW-only (not DROP -- the source's
// toll mechanic is triggered by throwing an object at the troll, matching
// adven.f4's DROP-via-THROW distinction for this puzzle specifically).
// Fires when the object about to be thrown is at either chasm bank
// (R_CHASM_SW/R_CHASM_NE, atFissure's own two-bank-check idiom) and the
// troll hasn't been paid off yet (trollGone==0).
// Caller must have already confirmed the object is carried and left
// objLocPtr pointing at its objLoc slot -- same contract as
// checkBirdSnake.
//
// Two sub-cases once at a chasm bank with the troll present:
//   - the axe: the troll refuses it (msg_TROLL_AXE_BOUNCE) and it just
//     bounces to the ground here -- dropped, same as an ordinary THROW,
//     but the toll is NOT paid.
//   - any object with objTreasure[idx]==1: the troll takes it and steps
//     aside (msg_TROLL_PAID) -- the object is consumed (TROLL_TREASURE_GONE,
//     mirroring AXE_NOWHERE/SNAKE_GONE), trollGone is set, and
//     trollCrossed is cleared so the next OVER is the one free crossing
//     (movChasmCrossing).
//   - anything else (non-treasure, non-axe): unhandled -- falls through to
//     doThrow's ordinary drop-at-the-troll's-feet behavior.
//
// Returns AC=1 if it handled the action in full (printed the message,
// moved/consumed the object), caller should jmp turnLoop without doing
// its own throw behavior.
// Returns AC=0 if it did nothing -- caller should fall through to its
// normal behavior.
// No arguments. Called cross-bank via the section-13 form.
// =======================================================================
checkTrollPayment,
    local rtn, ctpAtChasm, ctpCheckAxe, ctpIsAxe, ctpCheckTreasure, ctpIsTreasure, ctpNotHandled, treasurePtr, tptr
    dac rtn
    lac i [curRoom:0]
    SKIP_NEXT_IF_DIFFERENT [R_CHASM_SW
    jmp ctpAtChasm            // AC == R_CHASM_SW (no skip): at a chasm bank
    SKIP_NEXT_IF_SAME [R_CHASM_NE           // skip when AC == R_CHASM_NE -- also a chasm bank
    jmp ctpNotHandled            // differs from both (no skip): not at either bank -- unhandled
ctpAtChasm,                       // SW bank, or (falling through) NE bank
    lac i [trollGone:0]
    SKIP_NEXT_IF_AC_NOT_ZERO                    // skip if AC != 0 (troll already gone -- nothing to pay)
    jmp ctpCheckAxe             // branch 1 (AC == 0, no skip): troll present -- check what's thrown
    jmp ctpNotHandled           // branch 2 (AC != 0, skip): troll gone -- unhandled, ordinary drop
ctpCheckAxe,
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_AXE)
    jmp ctpIsAxe              // equal (no skip): the axe -- bounces off
ctpCheckTreasure,               // differs (skip): not the axe -- check for a treasure
    lac i [objLocPtr:0]
    sub [objLoc:0             // AC = the object's index into the parallel object-table arrays
                                 // (objLoc:0's tag cancels out of the subtraction)
    add [objTreasure:2         // objTreasure moved to bank 2 (S5 bank-0 relief) -- this add now

    dac treasurePtr
    lac i treasurePtr
    SKIP_NEXT_IF_AC_ZERO                    // skip if AC == 0 (not a treasure) -- unhandled
    jmp ctpIsTreasure          // AC != 0 (no skip): a treasure -- pay the toll
    jmp ctpNotHandled           // AC == 0 (skip): not a treasure -- unhandled, ordinary drop
ctpIsAxe,
    lac [msg_TROLL_AXE_BOUNCE:1]
    jda advPrintMsg
    lac i [objLocPtr:0]    // the axe bounces to the ground here -- an ordinary
    dac tptr                 // drop, no payment (double indirect: fetch the slot
    lac i [curRoom:0]        // address, then store through it)
    dac i tptr
    law 1
    jmp i rtn
ctpIsTreasure,
    lac [msg_TROLL_PAID:1]
    jda advPrintMsg
    lac i [objLocPtr:0]
    dac tptr
    law TROLL_TREASURE_GONE
    dac i tptr             // the treasure is consumed, same convention as AXE_NOWHERE/SNAKE_GONE
    law 1
    dac i [trollGone:0]
    dzm i [trollCrossed:0]    // re-arm for the one free crossing movChasmCrossing grants
    law 1
    jmp i rtn
ctpNotHandled,
    cla
    jmp i rtn
rtn, 0
treasurePtr, 0
tptr, 0
    endloc

// checkBearDrop -- derived directly against adven.f4 lines 1296-1302:
//   9026 IF(OBJ.NE.BEAR.OR..NOT.AT(TROLL))GOTO 9027
//        CALL RSPEAK(163)
//        ... MOVE(TROLL,0)/MOVE(TROLL2,...)/JUGGLE(CHASM) -- the
//        source's own two-location-object machinery for TROLL/TROLL2,
//        not applicable here since we model the troll as a pair
//        of flags, not a real objLoc-table object
//        PROP(TROLL)=2
// Fires for DROP BEAR / THROW BEAR at either chasm bank. Unlike
// checkTrollPayment (THROW-only, since the source's toll is a THROW-
// triggered mechanic), this fires from both doDrop and doThrow -- the
// source's own OBJ.NE.BEAR check is reached from the shared discard path
// both verbs funnel through (9021), not a THROW-specific branch.
// No treasure cost, and -- unlike checkTrollPayment's paid crossing --
// no re-payment is ever required again: trollBypassed is set (not
// trollCrossed), permanently disabling the re-arm cycle. See
// movChasmCrossing's mccGotRoom for the other half of this.
// Caller must have already confirmed the object is carried and left
// objLocPtr pointing at its objLoc slot.
// Returns AC=1 if handled (printed the message, dropped the bear here,
// set trollGone/trollBypassed), caller should jmp turnLoop.
// Returns AC=0 if not handled -- caller falls through to its ordinary
// drop/throw behavior.
// No arguments. Called cross-bank via the section-13 form.
// =======================================================================
checkBearDrop,
    local rtn, cbdIsBear, cbdNotHandled, cbdAtChasm, tptr
    dac rtn
    lac i [objLocPtr:0]
    SKIP_NEXT_IF_DIFFERENT [FAR_OBJ_LOC(OBJ_BEAR)        // the bear's objLoc slot
    jmp cbdIsBear                // equal (no skip): it IS the bear
cbdNotHandled,                     // differs (skip): some other object -- unhandled
    cla
    jmp i rtn
cbdIsBear,
    lac i [curRoom:0]
    SKIP_NEXT_IF_DIFFERENT [R_CHASM_SW
    jmp cbdAtChasm                 // AC == R_CHASM_SW (no skip): at a chasm bank
    SKIP_NEXT_IF_SAME [R_CHASM_NE                // skip when AC == R_CHASM_NE -- also a chasm bank
    jmp cbdNotHandled                 // differs from both (no skip): not at either bank -- unhandled
cbdAtChasm,                              // SW bank, or (falling through) NE bank
// TASK-FR28 N26 (05-Sep-26): adven.f4 9026 is "IF(OBJ.NE.BEAR.OR..NOT.AT
// (TROLL))GOTO 9027" -- there has to be a troll standing there to be
// frightened off. The port tested only the room, so dropping the bear at a
// bank the troll had already left printed msg 163 at nobody AND set
// trollBypassed, which permanently disables mccReArm's re-arm cycle: a
// crossing paid for with a treasure became a free crossing for the rest of
// the game. trollGone == 0 is this port's AT(TROLL) (printChasmTroll reads
// the same flag to choose between the troll and the "nowhere to be seen"
// line), and the two chasm rooms are already established above.
    lac i [trollGone:0]
    SKIP_NEXT_IF_AC_ZERO           // skip when 0 (troll still in business -- bypass applies)
    jmp cbdNotHandled              // troll already gone: f4 9026 -> 9027, an ordinary drop
    lac [msg_BEAR_TROLL_BYPASS:1]
    jda advPrintMsg
    lac i [objLocPtr:0]           // ordinary drop -- the bear lands here, matching
    dac tptr                        // the source's shared discard-path fallback
    lac i [curRoom:0]               // (double indirect through the slot pointer)
    dac i tptr
    law 1
    dac i [trollGone:0]
    dac i [trollBypassed:0]         // permanent -- no re-arm, unlike the paid crossing (Part B)
    law 1
    jmp i rtn
rtn, 0
tptr, 0
    endloc

// advMsgTmp is only used by advPrintMsg
advMsgTmp,
    table ADVSCRATCH_WORDS

// ---------------------------------------------------------------------
// Message table -- generated by Adventure/AdvTextLoader from
// Adventure/Text/stage1_text.txt; do not hand-edit adv_msgtab.ah itself.

// a bank-1 record address works exactly like a bank-0 one. Every bank-0
// reference to a msg_* symbol must use the explicit :1 form: code loads

// objInvMsg/objHereMsg store "msg_X:1". A bare msg_X in bank 0 is an
// assembly error -- that is the safety net, not an inconvenience.
// ---------------------------------------------------------------------
#include "Includes/adv_msgtab.ac"


// ---------------------------------------------------------------------
// Room visited flag table (R4: bank-1 resident).
// 0, room not visited yet,
// 1, visited.
// Read/written by enterRoom under eem, zeroed by newGame's eem-wrapped
// memset, transferred whole by the SAVE/RESTORE drum records (which pass

// ---------------------------------------------------------------------
roomVisited,
    table NROOMS


// ---------------------------------------------------------------------
// wcMotd -- WIZCOM MOTD buffer.
// A port of advn2.f4's MOTD 100-word buffer (667-704).
// Sizing derivation (the source's own "100 words" is itself just a
// a convenient PDP-10 buffer size, not a/ number the player is ever shown):
// the source chains lines as
// (1 next-pointer word + up to 14 text words) records inside 100 total
// A5 words (5 chars/word), so its real per-line cap is 14*5=70 chars
// (msg 23 states this literally: "LIMIT LINES TO 70 CHARS" -- that
// number IS player-visible and MUST stay true), and its total capacity
// is ~100/15 =~ 6.67 line-records.
//
// This build prints a record's text via txtascB2, which self-terminates
// on a 0 PACKED WORD,/ so unlike the source's own explicit-length
// TYPE 20,(MSG(I),I=K+1,MSG(K)-1), a record here needs a GUARANTEED
// zero word somewhere after its real text, or a full 70-char line would
// have txtascB2 read straight past the record into whatever follows.
// packAscii is 2 chars/word, so 70 chars needs 35 text words; a 36th
// "always zero" safety word is added on top so the exactly-70-char case
// still has a terminator to find. Record shape: 1 header word (-1 =
// "message ends here", matching MSG(K).LT.0; else 0-5 = the index of
// the next record to print/continue) + 36 text words (35 usable + 1
// guaranteed-zero) = 37 words/record. Total buffer: 6 line-records *
// 37 = 222 words, matching the source's ~6.67-line practical capacity
// as closely as a whole number of same-shape records allows. (WC_DATA_
// WORDS' own comment carries the final 250-word grand total.)
// wcMotd+0 is this port's MSG(1) (the source's own indexing starts at
// K=1); wcApplyPoof sets it to -1 (POOF: MOTD initially empty, matching
// the source's own DATA MSG/100*-1/).
wcMotd,
    table 0d222              // MUST match WC_MOTD_WORDS (0d222) -- decimal. A bare `table 222`
                             // reserves OCTAL 222 = 146 words, so the drum's 222-word MOTD read
                             // overruns this buffer by 76 words straight into `constants` below,
                             // clobbering the bank-1 literal pool ([1], [3], ...). txtsix's
                             // `sad [1]` then mis-branches and every packed-text print after the
                             // first MOTD read comes out with its middle character replaced.

constants

bank 2
0/

// The hint system (adven.f4 843-848/1806-1846/40000-40900,
// adven.dat sections 9 (COND bits 4-9: room membership) and 11 (turns/
// cost/question-msg/hint-msg per hint)). hintTurn runs once per turn
// from turnLoop -- but at the SAME point in the turn cycle as f4's own
// label-2012 entry into this loop (right after finishing the PREVIOUS
// command, before reading the next one), NOT alongside dwarfTurn/
// lampTurn's per-turn hook, which runs AFTER the next command is
// already parsed. This placement matters: it is what lets nounTok
// (still holding the just-finished command's noun -- the next
// command's tokenize hasn't run yet) stand in for f4's OLDOBJ (f4 2012:
// OLDOBJ=OBJ, captured at this same point) in the bird hint's quick
// test below, with no separate OLDOBJ variable needed. See turnLoop's
// call site for the exact insertion point.
//
// hintCtr/hintedTab are indexed 0-5 for the source's HINT 4-9 (CAVE/
// BIRD/SNAKE/MAZE/DARK/WITT) -- HINT 1-3 are unused/repurposed
// bookkeeping in the source (f4's own comment at DATA section 11) this
// project doesn't carry.
// hintCtr is transient (matches HINTLC; zeroed/ by newGame, not in the SAVE block,
// hint doesn't survive SUSPEND, same tier as prevRoom/briefFlag.
// hintedTab IS in the SAVE block.
// A restored game must not re-offer, and re-charge, a hint already paid for.
#define NHINTS      0d6
#define HINT_CAVE   0
#define HINT_BIRD   1
#define HINT_SNAKE  2
#define HINT_MAZE   3
#define HINT_DARK   4
#define HINT_WITT   5

hintCtr,
    table 0d6
hintedTab,
    table 0d6

// HINTS(HINT,1)/HINTS(HINT,2) (adven.dat section 11) plus a precomputed
// 30*cost lamp bonus (f4 1824: LIMIT=LIMIT+30*HINTS(HINT,2) -- cost is a
// compile-time constant per hint here, so the multiply is done once at
// assembly time instead of needing a runtime mul).
hintThresh,    0d4
               0d5
               0d8
               0d75
               0d25
               0d20
hintLampBonus, 0d60
               0d60
               0d60
               0d120
               0d150
               0d90
hintQMsg,      msg_HINT_CAVE_Q:1
               msg_HINT_BIRD_Q:1
               msg_HINT_SNAKE_Q:1
               msg_HINT_MAZE_Q:1
               msg_HINT_DARK_Q:1
               msg_HINT_WITT_Q:1
// Cost line (f4 FORMAT 40012) as 6 pre-baked static messages, per-hint
// cost value already spelled out (a compile-time constant per hint,
// adven.dat section 11 column 2.
hintCostMsg,   msg_HINT_CAVE_COST:1
               msg_HINT_BIRD_COST:1
               msg_HINT_SNAKE_COST:1
               msg_HINT_MAZE_COST:1
               msg_HINT_DARK_COST:1
               msg_HINT_WITT_COST:1
hintHMsg,      msg_HINT_CAVE:1
               msg_HINT_BIRD:1
               msg_HINT_SNAKE:1
               msg_HINT_MAZE:1
               msg_HINT_DARK:1
               msg_HINT_WITT:1

// Per-hint room-membership lists (adven.dat section 9, COND bits 4-9).
// Single-room hints still get a 1-entry list -- htLoop's scan doesn't
// special-case list length. R_* names are #defines from adv_roomtab.ah,
// usable unqualified in any bank (plain cpp substitution, not a
// location symbol).
hintRoomCave,  R_GRATE
hintRoomBird,  R_BIRD
hintRoomSnake, R_MTKING
hintRoomMaze,  R_MAZE_A42
               R_MAZE_A43
               R_MAZE_A44
               R_MAZE_A45
               R_MAZE_A46
               R_MAZE_A47
               R_MAZE_A48
               R_MAZE_A49
               R_MAZE_A50
               R_MAZE_A51
               R_MAZE_A52
               R_MAZE_A53
               R_MAZE_A54
               R_MAZE_A55
               R_MAZE_A56
               R_MAZE_A80
               R_MAZE_A81
               R_MAZE_A82
               R_MAZE_A86
               R_MAZE_A87
hintRoomDark,  R_ALCOVE
               R_PLOVER
               R_DARKROOM
hintRoomWitt,  R_WITTSEND

hintRoomPtr,   hintRoomCave:.
               hintRoomBird:.
               hintRoomSnake:.
               hintRoomMaze:.
               hintRoomDark:.
               hintRoomWitt:.
hintRoomCnt,   0d1
               0d1
               0d1
               0d20
               0d3
               0d1

// hintTurn -- dual-mode callee (dac full-capture rtn, jmp i
// rtn, eem stays ON throughout, entered from bank 0's turnLoop via
// eem; jsp i [hintTurn:2]). No arguments, no return value.
hintTurn,
    local rtn, ix, ptr, roomPtr, roomCnt, scanIx, member
    dac rtn
    dzm ix
htLoop,
    lac ix
    SKIP_NEXT_IF_DIFFERENT [NHINTS
    jmp htDone                  // ix == NHINTS (no skip): scanned every hint -- done
                                 // ix != NHINTS (skip): keep scanning, falls through
    lac ix
    add [hintedTab:.
    dac ptr
    lac i ptr
    SKIP_NEXT_IF_AC_ZERO
    jmp htNext                  // hinted[ix] != 0 (no skip): already used -- skip it
                                 // hinted[ix] == 0 (skip): falls through -- check membership

// -- room-membership scan: is curRoom in hint ix's room list? --
    lac ix
    add [hintRoomPtr:.
    dac ptr
    lac i ptr
    dac roomPtr                 // roomPtr = this hint's room-list base address
    lac ix
    add [hintRoomCnt:.
    dac ptr
    lac i ptr
    dac roomCnt                 // roomCnt = this hint's room-list length
    dzm member
    dzm scanIx
htScan,
    lac scanIx
    SKIP_NEXT_IF_DIFFERENT roomCnt
    jmp htScanDone               // scanIx == roomCnt (no skip): exhausted -- not a member
                                  // scanIx != roomCnt (skip): keep scanning, falls through
    lac i [curRoom:0]
    SKIP_NEXT_IF_DIFFERENT i roomPtr
    jmp htScanHit                 // AC == *roomPtr (no skip): match -- member
                                   // AC != *roomPtr (skip): not this entry, falls through
    idx roomPtr
    idx scanIx
    jmp htScan
htScanHit,
    law 1
    dac member
htScanDone,

// counter update: member -> counter+1; not member -> counter=0 (f4's
// own unconditional HINTLC(HINT)=-1 THEN +1 on the not-member path
// reduces to the same thing -- see header comment).
    lac ix
    add [hintCtr:.
    dac ptr
    lac member
    SKIP_NEXT_IF_AC_ZERO
    jmp htInZone                 // member != 0 (no skip): in zone -- increment
                                  // member == 0 (skip): not in zone -- falls through, reset to 0
    dzm i ptr
    jmp htCheckThresh
htInZone,
    lac i ptr
    add [1
    dac i ptr
htCheckThresh,
    lac ix
    add [hintThresh:.
    dac roomPtr                  // reuse: scratch pointer
    lac i roomPtr
    dac roomCnt                  // reuse: threshold value
    lac ix
    add [hintCtr:.
    dac ptr
    lac i ptr
    sub roomCnt
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp htFire                    // counter >= threshold (no skip): fire this hint's quick test
    jmp htNext                     // counter < threshold (skip): not yet

// -- dispatch to hint ix's quick-eligibility test (f4 40400-40900) --
htFire,
    lac ix
    SKIP_NEXT_IF_DIFFERENT [HINT_CAVE
    jmp htQCave
    lac ix
    SKIP_NEXT_IF_DIFFERENT [HINT_BIRD
    jmp htQBird
    lac ix
    SKIP_NEXT_IF_DIFFERENT [HINT_SNAKE
    jmp htQSnake
    lac ix
    SKIP_NEXT_IF_DIFFERENT [HINT_MAZE
    jmp htQMaze
    lac ix
    SKIP_NEXT_IF_DIFFERENT [HINT_DARK
    jmp htQDark
    jmp htQWitt                    // only HINT_WITT left

// f4 40400: grate still closed (PROP(GRATE)==0) AND keys not here.
// ".NOT.HERE(KEYS)" is HERE(), not AT(): keys in the player's hands at
// the grate count, and used to not (TASK-FR29 N30b, S21 05-Sep-26).
htQCave,
    lac i [grateOpen:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp htResetAdvance             // grateOpen != 0 (no skip): already open -- fails
    lio i [FAR_OBJ_LOC(OBJ_KEYS)]
    jsp i [ulHereTest:1]           // the file's one HERE(obj) -- carried OR in curRoom
    SKIP_NEXT_IF_AC_ZERO
    jmp htResetAdvance              // AC != 0 (no skip): keys here -- fails
htOfferCave,                         // AC == 0 (skip): keys nowhere near -- test passes
    lio [HINT_CAVE
    jsp hintOffer
    jmp htResetAdvance

// f4 40500: HERE(BIRD) AND TOTING(ROD) AND OLDOBJ.EQ.BIRD.
// The ONLY quick test whose failure path is 40030 rather than 40020:
// the other five zero HINTLC, this one leaves it alone, so a player who
// stands in the bird chamber long enough is offered the hint on the
// first turn all three conditions hold -- not five turns after it.
// Failing here therefore jumps to htNext (advance, counter kept), never
// to htResetAdvance (TASK-FR29 N30c, S21 05-Sep-26).
htQBird,
    lio i [FAR_OBJ_LOC(OBJ_BIRD)]
    jsp i [ulHereTest:1]            // HERE(BIRD): carried counts (N30b's lesson)
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp htNext                      // AC == 0 (no skip): bird not here -- fails, counter KEPT
    lac i [FAR_OBJ_LOC(OBJ_ROD)]
    SKIP_NEXT_IF_AC_ZERO
    jmp htNext                      // AC != 0 (no skip): rod not carried -- fails, counter KEPT
                                     // AC == 0 (skip): rod carried, falls through
    lac i [nounTok:0]
    dac ptr
    lio ptr                          // IO = nounTok's bank-0 pointer value (eem-safe:
                                      // always < 4096, see strCmpEq's own header)
    lac [voc_bird:2]                 // AC = candidate address -- eem already on throughout
    dac i [strCmpEq:0]
    jsp i [strCmpEq:0+1]
    SKIP_NEXT_IF_AC_ZERO
    jmp htOfferBird                   // AC != 0 (no skip): nounTok matched "bird" -- test passes
    jmp htNext                         // AC == 0 (skip): no match -- fails, counter KEPT
htOfferBird,
    lio [HINT_BIRD
    jsp hintOffer
    jmp htResetAdvance

// f4 40600: HERE(SNAKE) AND NOT HERE(BIRD). Both are HERE(), not AT():
// a bird carried into the Hall of the Mountain King is the player's
// answer to the snake and must silence the hint, and used not to
// (TASK-FR29 N30e, S21 05-Sep-26).
htQSnake,
    lio i [FAR_OBJ_LOC(OBJ_SNAKE)]
    jsp i [ulHereTest:1]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp htResetAdvance                // AC == 0 (no skip): snake not here -- fails
    lio i [FAR_OBJ_LOC(OBJ_BIRD)]
    jsp i [ulHereTest:1]
    SKIP_NEXT_IF_AC_ZERO
    jmp htResetAdvance                 // AC != 0 (no skip): bird here too -- fails
htOfferSnake,                           // AC == 0 (skip): no bird -- test passes
    lio [HINT_SNAKE
    jsp hintOffer
    jmp htResetAdvance

// f4 40700: ATLOC(LOC)=ATLOC(OLDLOC)=ATLOC(OLDLC2)=0 (no object in any
// of the 3 most-recently-occupied rooms -- see roomEmpty below for
// ATLOC's real meaning, "no object located here", not a room-text
// flag) AND HOLDNG>1 (carrying more than one item, so dropping a
// marker costs nothing essential).
htQMaze,
    lac i [curRoom:0]
    swp                              // AC -> IO (roomEmpty's parameter)
    jsp roomEmpty
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp htResetAdvance               // AC == 0 (no skip): curRoom occupied -- fails
    lac i [prevRoom:0]
    swp
    jsp roomEmpty
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp htResetAdvance               // prevRoom occupied -- fails
    lac i [oldLc2:0]
    swp
    jsp roomEmpty
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp htResetAdvance               // oldLc2 occupied -- fails
    jsp hintCarryCount
    sub [1
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp htOfferMaze                   // count-1 > 0 (no skip): holding > 1 -- test passes
    jmp htResetAdvance                 // count-1 <= 0 (skip): holding <= 1 -- fails
htOfferMaze,
    lio [HINT_MAZE
    jsp hintOffer
    jmp htResetAdvance

// f4 40800: PROP(EMRALD).NE.-1 AND PROP(PYRAM).EQ.-1 -- the player has
// SEEN the emerald (so the plover room means something to them) but has
// not yet seen the pyramid (so the alcove tunnel is still the puzzle).
// A treasure's PROP is -1 until it is first described (f4 2004 sets it
// to 0 and tallies it off), and this port's stand-in for that state is
// seenTab, which isTreasureSeen reads. The port had no gate at all and
// offered the hint to a player who had never been in the plover room
// (TASK-FR29 N30d, S21 05-Sep-26).
htQDark,
    lio [OBJ_EMERALD
    jsp isTreasureSeen
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp htResetAdvance             // AC == 0 (no skip): emerald never seen -- fails
    lio [OBJ_PLATINUM
    jsp isTreasureSeen
    SKIP_NEXT_IF_AC_ZERO
    jmp htResetAdvance             // AC != 0 (no skip): pyramid already seen -- fails
    lio [HINT_DARK                  // AC == 0 (skip): both halves hold -- test passes
    jsp hintOffer
    jmp htResetAdvance

// f4 40900: GOTO 40010 unconditionally -- no quick test in the source either.
htQWitt,
    lio [HINT_WITT
    jsp hintOffer
    jmp htResetAdvance

htResetAdvance,
    lac ix
    add [hintCtr:.
    dac ptr
    dzm i ptr
htNext,
    idx ix
    jmp htLoop
htDone,
    jmp i rtn
rtn, 0
ix, 0
ptr, 0
roomPtr, 0
roomCnt, 0
scanIx, 0
member, 0
    endloc

// hintOffer -- IO = hint index (0-5) in. The shared askYesNo/cost/
// hint-text/lampLimit flow (f4 40010-40030): "are you trying to...?" ->
// decline ends it; yes -> print the point cost -> "DO YOU WANT THE
// HINT?" -> decline ends it (nothing charged); yes -> print the hint
// text, mark hinted[ix], and if lampLimit was above 30, bump it by the
// precomputed 30*cost bonus (f4 1824). Same-bank jsp/dap/rtn routine
// (only ever called from hintTurn, above) -- askYesNo itself is called
// cross-bank per its own header ("bank-1 callers jsp i [askYesNo:0]
// with eem on"); eem is already on throughout hintTurn's whole call
// chain, so no extra eem here.
hintOffer,
    local rtn, ix, ptr, tmp
    dap rtn
    dio ix
    lac ix
    add [hintQMsg:.
    dac ptr
    lio i ptr
    jsp i [askYesNo:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp hoDeclined                // AC == 0 (no skip): declined "are you trying..." -- msg 54
                                   // AC != 0 (skip): yes, falls through -- show the cost
    lac ix
    add [hintCostMsg:.
    dac ptr
    lac i ptr
    farjda(advPrintMsg:1)
    lio [msg_HINT_OFFER:1
    jsp i [askYesNo:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp hoDeclined                 // AC == 0 (no skip): declined the hint -- msg 54, nothing charged
                                    // AC != 0 (skip): yes -- print the hint, mark hinted, maybe bump the lamp
    lac ix
    add [hintHMsg:.
    dac ptr
    lac i ptr
    farjda(advPrintMsg:1)
    lac ix
    add [hintedTab:.
    dac ptr
    law 1
    dac i ptr
    lac i [lampLimit:0]
    sub [0d30
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp hoBonus                     // lampLimit - 30 > 0 (no skip): apply the bonus
    jmp rtn                          // <= 0 (skip): no bonus -- done
hoBonus,
    lac i [lampLimit:0]
    dac tmp
    lac ix
    add [hintLampBonus:.
    dac ptr
    lac i ptr
    add tmp
    dac i [lampLimit:0]
    jmp rtn
// Either NO answer (TASK-FR29 N30a, S21 05-Sep-26). Both polls are
// YES(X,Y,54) in the source -- advn2.f4:168 YESX prints its Z message
// on the no branch -- so declining a hint says "OK", it does not answer
// with a blank line. One shared tail because the two branches differ
// only in where they leave from.
hoDeclined,
    lac [msg_OK:1]
    farjda(advPrintMsg:1)
rtn, jmp 0
ix, 0
ptr, 0
tmp, 0
    endloc


// roomEmpty -- IO = a room number in. Returns AC=1 if no object's
// objLoc equals that room (f4's ATLOC(room)==0 -- ATLOC is the room's
// first-object-here pointer, NOT a room-text/description flag), AC
// if some object is there. Same objLoc-scan idiom as checkCarryLimit's
// cclScan above, just testing equality against a passed room instead of
// equality against 0 (carried).
roomEmpty,
    local rtn, target, ptr, ix
    dap rtn
    dio target
    lac [objLoc:0
    dac ptr
    dzm ix
reScan,
    lac ix
    SKIP_NEXT_IF_DIFFERENT [NOBJS
    jmp reEmpty                  // ix == NOBJS (no skip): scanned all, none matched -- empty
                                  // ix != NOBJS (skip): keep scanning, falls through
    lac i ptr
    SKIP_NEXT_IF_SAME target
    jmp reNext                    // objLoc[ix] != target (no skip): not this entry -- keep scanning
    cla
    jmp rtn                        // objLoc[ix] == target (skip): falls through -- occupied, AC
reNext,
    idx ptr
    idx ix
    jmp reScan
reEmpty,
    law 1
rtn, jmp 0
target, 0
ptr, 0
ix, 0
    endloc

// hintCarryCount -- no arguments. Returns the number of currently-
// carried objects (objLoc == 0) in AC -- f4's HOLDNG, for htQMaze's
// carry-more-than-one check. Same objLoc-scan idiom as checkCarryLimit,
// but returns the raw count instead of a capped boolean+message -- and
// it skips the mirrored WATER/OIL slots for the same reason
// checkCarryLimit does; see that routine's header (TASK-FR28 N16, S21
// 05-Sep-26). f4 40700 reads the same HOLDNG 9017 does.
hintCarryCount,
    local rtn, ptr, ix, count
    dap rtn
    lac [objLoc:0
    dac ptr
    dzm ix
    dzm count
hccScan,
    lac ix
    SKIP_NEXT_IF_DIFFERENT [NOBJS
    jmp hccDone
    SKIP_NEXT_IF_DIFFERENT [OBJ_WATER
    jmp hccNext               // the mirrored liquid slots are not HOLDNG
    SKIP_NEXT_IF_DIFFERENT [OBJ_OIL
    jmp hccNext
    lac i ptr
    SKIP_NEXT_IF_AC_NOT_ZERO
    idx count
hccNext,
    idx ptr
    idx ix
    jmp hccScan
hccDone,
    lac count
rtn, jmp 0
ptr, 0
ix, 0
count, 0
    endloc

seenTab,
    table NOBJS

// isTreasureSeen --  IO = object index (0-based, into
// objTreasure/seenTab). Returns AC=1 if seenTab[ix] is set (the object
// has already been sighted at least once), AC=0 otherwise. Read-only,
// no side effects -- used by the tally2 sites (mccBearDeath,
// checkBirdDragon) that need to test "never found" without themselves
// marking anything found.
// Dual-mode callee (dac full-capture rtn, jmp i rtn, eem
// stays ON throughout -- entered via eem; jsp i [isTreasureSeen:2]).
isTreasureSeen,
    local rtn, ix, ptr
    dac rtn
    dio ix
    lac ix
    add [seenTab:.
    dac ptr
    lac i ptr
    SKIP_NEXT_IF_AC_ZERO      // skip when AC == 0 (not yet seen)
    jmp itsYes                  // AC != 0 (no skip): already seen
itsNo,                          // AC == 0 (skip): not seen
    cla
    jmp i rtn
itsYes,
    law 1
    jmp i rtn
rtn, 0
ix, 0
ptr, 0
    endloc

// treasureSighted -- adven.f4 806-824, label 2004-2006.
// IO = object index (0-based). If seenTab[ix] is already set, does nothing
// (idempotent, safe to call on every print, not just the first.
// Otherwise, a genuine first sighting, sets seenTab[ix], decrements
// tally, and applies line 824's lamp-zap rule (tally==tally2 &&
// tally!=0 -> lampLimit=MIN(35,lampLimit)). tally/tally2/lampLimit are
// bank-0 resident.
//  No return value.
// Dual-mode callee (dac full-capture rtn, jmp i rtn, eem
// stays ON throughout -- entered via eem; jsp i [treasureSighted:2]).
// =======================================================================
treasureSighted,
    local rtn, ix, ptr, tallyVal
    dac rtn
    dio ix
    lac ix
    add [seenTab:.
    dac ptr
    lac i ptr
    SKIP_NEXT_IF_AC_ZERO       // skip when AC == 0 (not yet seen) -- fall through, mark it
    jmp i rtn                    // AC != 0 (no skip): already seen -- nothing to do
tsMark,                           // AC == 0 (skip): first sighting
    lac i [closed:0]
    SKIP_NEXT_IF_AC_ZERO           // skip (closed == 0) -- ordinary mark/tally below
    jmp i rtn                        // closed != 0 (not skipped): skip mark/tally entirely
    law 1
    dac i ptr
    lac i [tally:0]
    sub [1
    dac i [tally:0]
    dac tallyVal                  // dac doesn't alter AC -- tallyVal now == the new tally too
    lac i [tally2:0]
    SKIP_NEXT_IF_SAME tallyVal    // skip (continue to the zap check) when tally2 == new tally
    jmp i rtn                       // differ (no skip): tally != tally2 -- no zap
tsCheckNonzero,                     // equal (skip): tally == tally2 -- check nonzero
    lac tallyVal
    SKIP_NEXT_IF_AC_NOT_ZERO       // skip when tallyVal != 0
    jmp i rtn                        // tallyVal == 0 (no skip): everything found -- no zap
tsZap,                                // tallyVal != 0 (skip): every remaining treasure is
                                          // provably unfindable -- zap the lamp
    lac i [lampLimit:0]
    sub [0d35
    SKIP_NEXT_IF_AC_NEGATIVE        // skip (leave alone) when AC < 0 (lampLimit < 35)
    jmp tsClamp                        // AC >= 0 (no skip): lampLimit >= 35 -- clamp to 35
    jmp i rtn                            // AC < 0 (skip): falls through -- no clamp needed
tsClamp,
    law 0d35
    dac i [lampLimit:0]
    jmp i rtn
rtn, 0
ix, 0
ptr, 0
tallyVal, 0
    endloc

// =======================================================================
// clockTurn -- adven.f4 880-889.
// Dual-mode callee entered from bank
// 0's turnLoop (eem; jsp i [clockTurn:2]), adjacent to lampTurn in the
// same shared eem window, matching f4's own clock-ticks-before-lamp-
// limit placement. No argument, no return value.
//
// Mirrors f4's flat structure exactly: the CLOCK1==0 check (-> fires
// startClosing) runs UNCONDITIONALLY every turn, regardless of whether
// this turn's tick actually happened (f4 880-881 -- two separate IF
// statements, not one conditional chain); likewise CLOCK1<0 -> CLOCK2--
// -> CLOCK2==0 (-> closedTransport)
// also runs unconditionally once clock1 has gone negative.
// =======================================================================
clockTurn,
    local rtn, ctIx, ctPtr
    dac rtn

ctClock1Tick,
// ---- clock1 tick: tally==0 && deep && curRoom != R_Y2 ----
    lac i [tally:0]
    SKIP_NEXT_IF_AC_ZERO            // skip (tally == 0) -- keep checking below
    jmp ctCheckClock1                 // tally != 0 (not skipped): not eligible -- skip the tick
ctDeepCheck,                            // tally == 0 (skipped): falls through -- check the zone
    jsp i [checkDwarfRoom:0]        // section-13 dual-mode; returns with eem on
    SKIP_NEXT_IF_AC_NOT_ZERO         // skip (AC != 0, deep zone) -- keep checking below
    jmp ctCheckClock1                  // AC == 0 (not skipped): not deep -- skip the tick
ctY2Check,                                // AC != 0 (skipped): falls through -- exclude Y2
    lac i [curRoom:0]
    SKIP_NEXT_IF_DIFFERENT [R_Y2      // skip (curRoom != R_Y2) -- tick below
    jmp ctCheckClock1                    // curRoom == R_Y2 (not skipped): excluded -- skip the tick
ctTick1,                                    // curRoom != R_Y2 (skipped): falls through -- tick clock1
    lac i [clock1:0]
    sub [1
    dac i [clock1:0]

// ---- f4 881: IF(CLOCK1.EQ.0)GOTO 10000 -- unconditional check ----
ctCheckClock1,
    lac i [clock1:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ctStartClosing

// ---- f4 882-883: IF(CLOCK1.LT.0)CLOCK2=CLOCK2-1; IF(CLOCK2.EQ.0)GOTO 11000 ----
ctCheckClock1Neg,
    lac i [clock1:0]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i rtn                           // clock1 >= 0 (not skipped): not closing yet -- done
ctTick2,                                   // clock1 < 0 (skipped): falls through -- tick clock2
    lac i [clock2:0]
    sub [1
    dac i [clock2:0]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp closedTransport
    jmp i rtn
ctStartClosing,
    jsp startClosing
    jmp i rtn
closedTransport,
// adven.f4 label 11000, lines 1911-1938).
// clock2 reaching exactly 0 -- transport to the repository.
//
// 1. Place the NE-side (R_REPOSITORY_NE / adven.dat 115) objects
//    unconditionally (f4 PROP(x)=PUT(x,115,y)) -- BOTTLE, PLANT,
//    OYSTER, LAMP, ROD. "Sleeping dwarves" is pure room-text flavor,
//    not a build object (see doWake's own comment). MIRROR is NOT
//    relocated here -- see its own note below.
    law R_REPOSITORY_NE
    dac i [FAR_OBJ_LOC(OBJ_BOTTLE)]
    dac i [FAR_OBJ_LOC(OBJ_PLANT)]
    dac i [FAR_OBJ_LOC(OBJ_OYSTER)]
    dac i [FAR_OBJ_LOC(OBJ_LAMP)]
    dac i [FAR_OBJ_LOC(OBJ_ROD)]
// 2. Place the SW-side (R_REPOSITORY_SW / adven.dat 116) objects
//    unconditionally -- SNAKE, BIRD, CAGE, ROD2, PILLOW. GRATE has no
//    object-table row in this build (see OBJ_ROD2's own comment on the
//    project's established "state-flag, not an object" convention for
//    fixed scenery) -- the room's own LONG text already describes it.
    law R_REPOSITORY_SW
    dac i [FAR_OBJ_LOC(OBJ_SNAKE)]
    dac i [FAR_OBJ_LOC(OBJ_BIRD)]
    dac i [FAR_OBJ_LOC(OBJ_CAGE)]
    dac i [FAR_OBJ_LOC(OBJ_ROD2)]
    dac i [FAR_OBJ_LOC(OBJ_PILLOW)]
// MIRROR (adven.f4 "PROP(MIRROR)=PUT(MIRROR,115,0); FIXED(MIRROR)=116"):
// deliberately NOT relocated. This build's existing OBJ_MIRROR  is
// the SAME source object (adven.dat vocab 1023 MIRRO, object 23 -- the
// giant two-sided mirror spanning Mirror Canyon (room 109) and the
// repository, confirmed via adven.dat's own room-109 LONG text: "THE
// MIRROR IS OBVIOUSLY PROVIDED FOR THE USE OF THE DWARVES"), currently
// fixed at R_MIRRORCANYON with objHereMsg=0 (silent -- its room's own
// LONG text covers it, matching adven.dat's ">$<" tier-000 convention).
// Relocating it is unnecessary for two independent reasons, both
// disclosed: (a) BREAK MIRROR's gate (doBreak's dbrMirror) checks
// `closed` only, exactly like f4's own "OBJ.NE.MIRROR.OR..NOT.CLOSED" --
// no location check at all, so it works from either repository room
// regardless of OBJ_MIRROR's own objLoc value; (b) once closed, every
// surface-move gate already confines the
// player to the repository, so R_MIRRORCANYON becomes permanently
// unreachable and no LOOK there could ever expose the stale placement.
//
    law 1
    dac i [repoHiddenBottle:0]
    dac i [repoHiddenPlant:0]
    dac i [repoHiddenOyster:0]
    dac i [repoHiddenLamp:0]
    dac i [repoHiddenRod:0]
    dac i [repoHiddenSnake:0]
    dac i [repoHiddenBird:0]
    dac i [repoHiddenCage:0]
    dac i [repoHiddenRod2:0]
    dac i [repoHiddenPillow:0]
//
// 2b. TASK-FR15 15b (03-Sep-26): the PVAL in each of the source's PUTs is
//    not decoration. PUT(OBJ,LOC,PVAL) returns -1-PVAL, so PVAL is the
//    value the prop takes once the DO 2604 sweep un-negates it, and three
//    of them are a deliberate state RESET rather than a default:
//
//      PROP(BOTTLE)=PUT(BOTTLE,115,1)   -- 1 = EMPTY
//      PROP(PLANT) =PUT(PLANT,115,0)    -- 0 = the tiny, unwatered plant
//      PROP(LAMP)  =PUT(LAMP,115,0)     -- 0 = off
//
//    adven.f4's own comment says why the first two matter: "THERE MUST BE
//    NO WATER OR OIL, SINCE THERE ARE BEANSTALKS WHICH WE DON'T WANT TO BE
//    ABLE TO WATER, SINCE THE CODE CAN'T HANDLE IT." Without these the
//    repository bottle arrives holding whatever the player's bottle held
//    and the repository plant arrives at whatever growth stage the real
//    beanstalk had reached, so POUR WATER in the repository runs doPour's
//    ordinary beanstalk cycle -- exactly the case the source went out of
//    its way to make unreachable.
//
//    plantDisplayProp is doPour's own plantProp/2 shadow and must be
//    zeroed in lockstep or printPhonyPlant keeps drawing the old tier.
//    The remaining objects on the PUT list have no port-side prop
//    variable at all, so these four stores are the whole of it.
//    The here-texts these props select are patched alongside them,
//    the same pairing doPour's pouEmptyBottle/pouTierCheck and newGame's
//    own reset block both make -- a prop without its objHereMsg leaves
//    the repository pile describing the pre-closing state in words while
//    the state itself has been reset.
//
//    The SW list carries a fourth here-text for the same reason
//    (TASK-FR31 N39): PROP(BIRD)=PUT(BIRD,116,1) puts the repository bird
//    on object 8's tier-100 text, "THERE IS A LITTLE BIRD IN THE CAGE.",
//    which is what the SW room's own "A ROW OF SMALL WICKER CAGES, EACH OF
//    WHICH CONTAINS A LITTLE SULKING BIRD" is describing. Only the text is
//    set here; birdCaught is left alone, since it gates dropCageBundle's
//    teleport rather than any description.
//
//    objLoc[WATER]/objLoc[OIL] need no resync: the invariant is that they
//    are 0 only while the bottle is BOTH carried and holding that liquid,
//    and the PUT list above has just placed the bottle at
//    R_REPOSITORY_NE, so a carried liquid's slot is 0 here and step 3's
//    destroy loop writes exactly the 0d250 NOWHERE value into it.
    law 1
    dac i [bottleProp:0]           // 1 = empty
    lac [msg_HERE_BOTTLE_EMPTY:1]
    dac i [FAR_OBJ_HEREMSG(OBJ_BOTTLE)]
    dzm i [plantProp:0]
    dzm i [plantDisplayProp:0]
    lac [msg_HERE_PLANT_TINY:1]
    dac i [FAR_OBJ_HEREMSG(OBJ_PLANT)]
    dzm i [lampOn:0]
    lac [msg_HERE_LAMP:1]          // PROP(LAMP)=0 selects object 2's tier-000 text;
    dac i [FAR_OBJ_HEREMSG(OBJ_LAMP)]  // without this the repository lamp still describes
                                       // itself as shining once taken and set down again
    lac [msg_HERE_BIRD_IN_CAGE:1]  // PROP(BIRD)=1 from PUT(BIRD,116,1)
    dac i [FAR_OBJ_HEREMSG(OBJ_BIRD)]
//
// 3. Destroy everything still carried (f4 "DO 11010 I=1,100
//    IF(TOTING(I))CALL DSTROY(I)") -- runs AFTER the explicit PUT list
//    above, so any of the objects just placed are already excluded
//    (their objLoc is no longer 0/carried) exactly as in the source.
//    Reuses this project's established "gone from the world entirely"
//    0d250 sentinel generically (same value AXE_NOWHERE/SNAKE_GONE/
//    ROD2_NOWHERE/etc. all already use) rather than a per-object
//    sentinel, since ANY still-carried object at this point (keys,
//    axe, food, treasures not yet placed above, ...) is meant to
//    simply vanish. Same loop shape as playerDied's own pdDropLoop.
    dzm ctIx
ctDestroyLoop,
    lac ctIx
    SKIP_NEXT_IF_DIFFERENT [NOBJS
    jmp ctDestroyDone              // every slot processed
    lac ctIx
    add [objLoc:0
    dac ctPtr
    lac i ctPtr
    SKIP_NEXT_IF_AC_ZERO           // skip when this object is carried
    jmp ctDestroyNext              // not carried -- leave it
    law 0d250                       // carried -- remove it from the world entirely
    dac i ctPtr
ctDestroyNext,
    idx ctIx
    jmp ctDestroyLoop
ctDestroyDone,
// 4. Msg 132, closed=1, land the player at R_REPOSITORY_NE via the same
//    loadRoom/enterRoom/turnLoop revival pattern playerDied's pdRelocate
//    (bank 0) uses.
    lac [msg_CLOSED_TRANSPORT:1]
    farjda(advPrintMsg:1)
    law 1
    dac i [closed:0]
    law R_REPOSITORY_NE
    dac i [curRoom:0]
    lio i [curRoom:0]               // IO for loadRoom (just-set value, matching
                                        // pdRelocate's own lac/dac/lio curRoom idiom)
    jsp i [loadRoom:0]
    ROOM_CACHE:0                    // address where loadRoom puts the room data
    jsp i [enterRoom:0]
    jmp i [turnLoop:0]
rtn, 0
ctIx, 0
ctPtr, 0
    endloc

// startClosing -- adven.f4 label 10000, lines 1879-1897.
// Fires exactly once, from clockTurn above, when clock1 reaches 0.
// Same-bank callee, entered via jsp from clockTurn,.
// eem is already/ on throughout explicitly restored
// after the msg 129 print that turns it off.
//
// Build mutation list.
// Every touched var is bank-0 resident unless noted.
//   grateLocked=1, grateOpen=0         -- f4 PROP(GRATE)=0 (locked+shut)
//   fissureBridge=0, fissureNoBridge=1 -- f4 PROP(FISSUR)=0 (bridge gone)
//   dwarfStage=0, dwarfSeen=0,
//   dwarvesRemaining=0, dwarfLoc[0..4]
//                                       -- f4's DSEEN(I)=.FALSE., DLOC(I)
//                                          for i=1..6 (dwarves + pirate;
//                                          pirateTurn's own retirement
//                                          gate checks `closing` directly
//                                          instead -- see its own comment,
//                                          so no separate pirate mutation
//                                          is needed here)
//   trollGone=1                        -- f4 MOVE(TROLL,0)+MOVE(TROLL2,..)
//                                          (the existing "troll2" gone-
//                                          flavor text, msg_HERE_TROLL_
//                                          GONE, is already verbatim
//                                          adven.dat object 34 "PHONY
//                                          TROLL"/"THE TROLL IS NOWHERE TO
//                                          BE SEEN." -- no new text/code
//                                          needed, printChasmTroll already
//                                          selects it on trollGone!=0 at
//                                          both chasm banks)
//   OBJ_LOC(OBJ_BEAR)=BEAR_GONE, UNLESS bearDead != 0
//                                       -- f4 IF(PROP(BEAR).NE.3)DSTROY(BEAR)
//   OBJ_TAKE(OBJ_CHAIN)=1,
//   OBJ_HEREMSG(OBJ_CHAIN)=msg_HERE_CHAIN_LOOSE
//                                       -- f4 PROP(CHAIN)=0, FIXED(CHAIN)
//   OBJ_TAKE(OBJ_AXE)=1                -- f4 PROP(AXE)=0, FIXED(AXE)
//   msg 129 printed
//   clock1=-1, closing=1               -- f4 CLOCK1=-1, CLOSNG=.TRUE.
// f4 1888's JUGGLE(CHASM) is a redescription-order shuffle hack (a CARRY
// plus a DROP, which moves an object to the head of its room's list) with
// no build counterpart: the chasm's line is printed by printChasmTroll, a
// bespoke hook that runs after printObjHere's ordered walk and is not part
// of it, so there is no position for a JUGGLE to change. (Since TASK-FR31
// N41 the walk itself IS ordered, by objDropSeq, and bumpDropSeq is the
// port's DROP-prefixes-the-list primitive -- but only for objects the walk
// actually lists.)
// =======================================================================
startClosing,
    local rtn
    dap rtn

// ---- grate: locked and shut ----
    law 1
    dac i [grateLocked:0]
    dzm i [grateOpen:0]

// ---- fissure bridge: gone ----
    dzm i [fissureBridge:0]
    law 1
    dac i [fissureNoBridge:0]

// ---- dwarves + pirate: wiped ----
    dzm i [dwarfSeen:0]
    dzm i [dwarvesRemaining:0]
    dzm i [dwarfLoc:0]
    dzm i [dwarfLoc:0+1]
    dzm i [dwarfLoc:0+2]
    dzm i [dwarfLoc:0+3]
    dzm i [dwarfLoc:0+4]

// ---- troll: gone (troll2 flavor already wired via trollGone) ----
    law 1
    dac i [trollGone:0]

// ---- bear: destroyed unless already dead ----
    lac i [bearDead:0]
    SKIP_NEXT_IF_AC_ZERO           // skip (bearDead == 0) -- destroy it below
    jmp scChainReset                 // bearDead != 0 (not skipped): already dead -- leave it
scBearDestroy,                         // bearDead == 0 (skipped): falls through -- destroy it
    law BEAR_GONE
    dac i [FAR_OBJ_LOC(OBJ_BEAR)]

// ---- chain: unlocked/loose (f4's PROP(CHAIN)=0, FIXED(CHAIN)=0) ----
scChainReset,
    law 1
    dac i [FAR_OBJ_TAKE(OBJ_CHAIN)]
    lac [msg_HERE_CHAIN_LOOSE:1]
    dac i [FAR_OBJ_HEREMSG(OBJ_CHAIN)]

// ---- axe: freed (f4's PROP(AXE)=0, FIXED(AXE)=0) ----
    law 1
    dac i [FAR_OBJ_TAKE(OBJ_AXE)]
// TASK-FR32 S-6 (05-Sep-26): f4 1891's PROP(AXE)=0, the other half of the
// pair. doThrow's dthAxeBear sets BOTH FIXED(AXE)=-1 (objTake 0) and
// PROP(AXE)=1 (the beside-the-bear here-text); the port reset only the
// first, so a cave that closed after a thrown axe listed "THERE IS A
// LITTLE AXE LYING BESIDE THE BEAR." in a room whose bear the four lines
// above had just destroyed. dfFeedIt in bank 3 resets the same pair for
// the same reason (TASK-FR21 C15).
    lac [msg_HERE_AXE:1]
    dac i [FAR_OBJ_HEREMSG(OBJ_AXE)]

// ---- msg 129, then the two final scalars ----
    lac [msg_CAVE_CLOSING_SOON:1]
    farjda(advPrintMsg:1)
    law i 1                   // AC = -1
    dac i [clock1:0]
    law 1
    dac i [closing:0]
    jmp rtn
rtn, jmp 0
    endloc

// =======================================================================
// Adven.f4 1983-2047 + researched 350 point score components.
// scoreGame -- dual-mode callee (dac full-capture rtn, jmp i
// rtn, eem stays ON throughout -- entered via eem; jsp i [scoreGame:2]).
// IO = mode on entry: 0 = preview (f4's SCORNG -- excludes the "+4 not
// quitting" term, no report printed; caller prints the existing short
// "IF YOU WERE TO QUIT NOW..." message itself via printScore, bank 1),
// 1 = normal/exit (full score, "+4" applied unless gaveUp is set, and
// THIS routine also prints the full exit report.
//
// MXSCOR is not computed at runtime -- f4's own table sums to a fixed
// 350, already hardcoded in scoreMsg2's "OUT OF A POSSIBLE 350." text
// (bank 1); no max-score arithmetic is built here.
// =======================================================================
scoreGame,
    local rtn, mode, score, tIx, tPtr, dep, sgVal
    dac rtn
    dio mode
    dzm score

// ---- treasures (adven.f4 2003-2009): seenTab[ix]!=0 -> +2; ALSO
// deposited undamaged (objLoc[ix]==R_BUILDING, and for the vase
// specifically !vaseBroken -- the only breakable treasure this build
// has) -> +(K-2) more. ----------------------------------------------
    dzm tIx
sgTreasureScan,
    lac tIx
    SKIP_NEXT_IF_DIFFERENT [NOBJS
    jmp sgTreasureDone               // scanned every object
    lac tIx
    add [objTreasure:2         // objTreasure moved to bank 2 (S5 bank-0 relief) -- same-bank as
                                  // scoreGame itself now, but the explicit tag is kept (S4 precedent)
    dac tPtr
    lac i tPtr
    SKIP_NEXT_IF_AC_NOT_ZERO         // skip when AC != 0 (a treasure)
    jmp sgTreasureNext                // AC == 0: not a treasure -- next index
    dac sgVal                          // sgVal = K (objTreasure[tIx])
    lac tIx
    add [seenTab:.
    dac tPtr
    lac i tPtr
    SKIP_NEXT_IF_AC_ZERO             // skip when AC == 0 (never sighted)
    jmp sgTreasureSeen
// CLAUDE 04-Sep-26 (TASK-FR30 N35): sgTreasureNext, not sgTreasureDeposit.
// adven.f4 2007-2008 gates BOTH treasure terms on the sighting:
//   IF(PROP(I).GE.0)SCORE=SCORE+2
//   IF(PLACE(I).EQ.3.AND.PROP(I).EQ.0)SCORE=SCORE+K-2
// and a treasure that has never been described still has PROP -1, which
// fails the second test as well as the first. Falling into the deposit
// block from here paid the whole K-2 for a treasure the player had never
// laid eyes on -- +10 for one such object sitting in the building.
    jmp sgTreasureNext
sgTreasureSeen,
    lac score
    add [0d2
    dac score
sgTreasureDeposit,
    lac tIx
    add [objLoc:0
    dac tPtr
    lac i tPtr
    SKIP_NEXT_IF_SAME [R_BUILDING    // skip "jmp sgTreasureNext" when objLoc[tIx]==R_BUILDING
    jmp sgTreasureNext                 // not in the Building -- no deposit bonus
    lac tIx
    SKIP_NEXT_IF_DIFFERENT [OBJ_VASE  // skip "jmp sgTreasureVaseCheck" when tIx != OBJ_VASE
    jmp sgTreasureVaseCheck             // tIx == OBJ_VASE -- must also check vaseBroken
    jmp sgTreasureDepositOk              // not the vase -- deposit bonus applies unconditionally
sgTreasureVaseCheck,
    lac i [vaseBroken:0]
    SKIP_NEXT_IF_AC_ZERO             // skip when AC == 0 (vase not broken)
    jmp sgTreasureNext                 // broken -- no deposit bonus
sgTreasureDepositOk,
    lac sgVal
    sub [0d2
    dac dep
    lac score
    add dep
    dac score
sgTreasureNext,
    idx tIx
    jmp sgTreasureScan
sgTreasureDone,

// ---- deep (dwarfStage != 0) -> +25 (adven.f4 2030) --------------------
    lac i [dwarfStage:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp sgDeepYes
    jmp sgSurvival
sgDeepYes,
    lac score
    add [0d25
    dac score

// ---- survival: (3-numDie)*10 -- MAXDIE is fixed 3,
// obitTab/reviveTab have exactly 3 entries, so a 4-entry lookup table
// (numDie 0..3) avoids needing a runtime multiply.
sgSurvival,
    lac i [numDie:0]
    add [sgSurvivalTab:.
    dac tPtr
    lac i tPtr
    add score
    dac score

// ---- not quitting: +4 -- suppressed in preview mode (matches f4's
// SCORNG test) and whenever gaveUp is set (adven.f4 2020). --------------
    lac mode
    SKIP_NEXT_IF_AC_ZERO             // skip when mode == 0 (preview -- never add "+4")
    jmp sgCheckGaveUp
    jmp sgClosing
sgCheckGaveUp,
    lac i [gaveUp:0]
    SKIP_NEXT_IF_AC_ZERO             // skip when gaveUp == 0
    jmp sgClosing                      // gaveUp != 0 -- no "+4"
    lac score
    add [0d4
    dac score

// ---- closing (closing != 0) -> +25 (adven.f4 2032) ---------------------
sgClosing,
    lac i [closing:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp sgClosingYes
    jmp sgClosedBonus
sgClosingYes,
    lac score
    add [0d25
    dac score

// ---- closed-bonus: while closed != 0, keyed on bonus (adven.f4
// 2034-2040 exactly: bonus==0 -> +10, 135 -> +25, 134 -> +30, 133 -> +45
sgClosedBonus,
    lac i [closed:0]
    SKIP_NEXT_IF_AC_ZERO
    jmp sgClosedCheck
    jmp sgMagazine
sgClosedCheck,
    lac i [bonus:0]
    SKIP_NEXT_IF_AC_NOT_ZERO         // skip when bonus != 0 -- check the 135/134/133 ladder
    jmp sgBonus0                       // bonus == 0
    SKIP_NEXT_IF_DIFFERENT [0d135
    jmp sgBonus135
    SKIP_NEXT_IF_DIFFERENT [0d134
    jmp sgBonus134
    SKIP_NEXT_IF_DIFFERENT [0d133
    jmp sgBonus133
    jmp sgMagazine                     // none matched (shouldn't happen) -- no bonus term
sgBonus0,
    lac score
    add [0d10
    dac score
    jmp sgMagazine
sgBonus135,
    lac score
    add [0d25
    dac score
    jmp sgMagazine
sgBonus134,
    lac score
    add [0d30
    dac score
    jmp sgMagazine
sgBonus133,
    lac score
    add [0d45
    dac score

// magazine at Witt's End -> +1 (adven.f4 2042; OBJ_MAGAZINE and R_WITTSEND both already exist.
sgMagazine,
    lac i [FAR_OBJ_LOC(OBJ_MAGAZINE)]
    SKIP_NEXT_IF_SAME [R_WITTSEND    // skip "jmp sgRound" when AT Witt's End
    jmp sgRound                        // not at Witt's End -- no +1
    lac score
    add [1
    dac score

// ---- round-off: +2 (adven.f4 2046) -------------------------------------
sgRound,
    lac score
    add [0d2
    dac score

// hints: subtract per-hint cost for every hintedTab[i] != 0.
// Costs/ are hintLampBonus[i]/30.
// Precomputed as a static table (sgHintCostTab) rather than a runtime
// divide.
    dzm tIx
sgHintScan,
    lac tIx
    SKIP_NEXT_IF_DIFFERENT [NHINTS
    jmp sgHintDone
    lac tIx
    add [hintedTab:.
    dac tPtr
    lac i tPtr
    SKIP_NEXT_IF_AC_ZERO             // skip when AC == 0 (not hinted)
    jmp sgHintCharge
    jmp sgHintNext
sgHintCharge,
    lac tIx
    add [sgHintCostTab:.
    dac tPtr
    lac i tPtr
    dac dep
    lac score
    sub dep
    dac score
sgHintNext,
    idx tIx
    jmp sgHintScan
sgHintDone,

    lac i [instrHinted:0]
    SKIP_NEXT_IF_AC_NOT_ZERO         // skip when the instructions were taken -- charge 5
    jmp sgInstrDone                    // == 0 (no skip): no charge
    lac score
    sub [0d5
    dac score
sgInstrDone,

    lac i [oysterHinted:0]
    SKIP_NEXT_IF_AC_NOT_ZERO         // skip when the oyster clue was read -- charge 10
    jmp sgOysterDone                   // == 0 (no skip): no charge
    lac score
    sub [0d10
    dac score
sgOysterDone,

// ---- preview mode returns here with no report printed ------------------
    lac mode
    SKIP_NEXT_IF_AC_NOT_ZERO         // skip when mode != 0 (normal -- print the report)
    jmp sgReturn                       // mode == 0: preview -- just return
    lio score
    jsp sgPrintReport
    eem 
sgReturn,
    lac score
    jmp i rtn
rtn, 0
mode, 0
score, 0
tIx, 0
tPtr, 0
dep, 0
sgVal, 0
    endloc

sgSurvivalTab, 0d30
               0d20
               0d10
               0d0

sgHintCostTab, 0d2
               0d2
               0d2
               0d4
               0d5
               0d3

// ---- the 9-tier class table (adven.dat section 10, verbatim) ----------
sgClassThresh, 0d35
               0d100
               0d130
               0d200
               0d250
               0d300
               0d330
               0d349
               0d9999
sgClassMsg,    msg_SCORE_RANK_AMATEUR:1
               msg_SCORE_RANK_NOVICE:1
               msg_SCORE_RANK_EXPERIENCED:1
               msg_SCORE_RANK_SEASONED:1
               msg_SCORE_RANK_JUNIOR_MASTER:1
               msg_SCORE_RANK_MASTER_C:1
               msg_SCORE_RANK_MASTER_B:1
               msg_SCORE_RANK_MASTER_A:1
               msg_SCORE_RANK_GRANDMASTER:1

// sgPrintReport -- Same-bank jsp/dap/rtn routine, only ever called
// from scoreGame's normal/exit mode above.
// IO = the already-computed score on entry. Prints, in order,
// per adven.f4 TYPE 20100 / the class-table
// loop / 20212 / 20222:
// "YOU SCORED n OUT OF A POSSIBLE 350, USING t TURNS.",
// the first class-table tier whose threshold >= score, then
// either the next-rating line (threshold+1-score more points, singular/
// plural) or -- only for the top (9999) tier -- the "NEAT TRICK"
// congratulations line instead.
//
// turns is widened to 4 digits here (sgPrint4Digit), comfortable
// headroom for any realistic turn count without
// the extra complexity of a 5th digit stage; score and the next-rating
// delta both stay within sgPrint3Digit's existing 3-digit range (score
// tops out around 350, and the delta is always smaller than that).
// =======================================================================
sgPrintReport,
    local rtn, scoreVal, classIx, classTPtr, classMPtr, deltaVal, turnsVal
    dap rtn
    dio scoreVal

    lac i [turns:0]           // eem ON (inherited from scoreGame) -- bank-0 far fetch
// CLAUDE 01-Sep-26: dac, not dio. lac leaves the fetched value in AC and does
// not touch IO, and IO still holds the score deposited by the dio scoreVal
// above -- so "USING t TURNS." printed the SCORE again, not the turn count.
// Invisible until now for a second reason: nothing incremented turns at all
// (see turnLoop's tlSkipMagicCheck), so this line had no correct value to
// print either way.
    dac turnsVal
    lem                        // OFF from here through the "...USING t TURNS." line --
                                  // txtascB2/sgPrint3Digit/sgPrint4Digit all need eem off
// CLAUDE 04-Sep-26 (TASK-FR35): adven.f4:2061's FORMAT 20100 opens
// "///" -- THREE record separators, so three newlines before the text,
// not one. Safe here: scoreVal and turnsVal are already stashed, and
// `newline` only clobbers AC and IO.
    newline
    newline
    newline
    law sgMsgScored
    jda txtascB2
    lio scoreVal
    jsp sgPrint3Digit

    law sgMsgOutOf
    jda txtascB2

    lio turnsVal
    jsp sgPrint4Digit

    law sgMsgTurns
    jda txtascB2

// ---- class table scan (needs eem ON -- classTPtr/classMPtr hold
// :. -tagged far addresses) ----------------------------------------------
    eem
    lac [sgClassThresh:.]
    dac classTPtr
    lac [sgClassMsg:.]
    dac classMPtr
    dzm classIx
sgClassScan,
    lac i classTPtr
    sub scoreVal
    SKIP_NEXT_IF_AC_NEGATIVE          // skip "jmp sgClassFound" when threshold < score
    jmp sgClassFound                    // threshold >= score -- this is the tier
    idx classTPtr
    idx classMPtr
    idx classIx
    lac classIx
    SKIP_NEXT_IF_DIFFERENT [0d9       // defensive only -- the 9999 top tier always matches above
    jmp sgClassFound
    jmp sgClassScan
sgClassFound,
    lac i classMPtr
    farjda(advPrintMsg:1)              // self-manages eem (on during, off after)
    lem     // farjda no longer turns eem off

// ---- next-rating line, unless the top (index 8) tier was reached ------
    lac classIx
    SKIP_NEXT_IF_SAME [0d8            // skip "jmp sgNextRating" when classIx == 8 (top tier)
    jmp sgNextRating                    // not the top tier -- ordinary next-rating line
    lac [msg_SCORE_NEAT_TRICK:1]
    farjda(advPrintMsg:1)
    lem     // farjda no longer turns eem off
    jmp sgReportDone
sgNextRating,
    eem                                  // classTPtr deref needs eem back on (the
                                         //   lem above turned it off)
    lac i classTPtr
    lem                                   // back off for the txtascB2/sgPrint3Digit calls below
    add [1
    sub scoreVal
    dac deltaVal
    law sgMsgNeedPre
    jda txtascB2
    lio deltaVal
    jsp sgPrint3Digit
    lac deltaVal
    SKIP_NEXT_IF_SAME [1              // skip "jmp sgPointPlural" when deltaVal == 1
    jmp sgPointPlural                   // deltaVal != 1 -- plural
    law sgMsgPointSing
    jda txtascB2
    jmp sgReportDone
sgPointPlural,
    law sgMsgPointPlural
    jda txtascB2
sgReportDone,
    jmp rtn
rtn, jmp 0
scoreVal, 0
classIx, 0
classTPtr, 0
classMPtr, 0
deltaVal, 0
turnsVal, 0
    endloc

sgMsgScored,      ascii "YOU SCORED "
sgMsgOutOf,       ascii " OUT OF A POSSIBLE 350, USING "
sgMsgTurns,       ascii " TURNS.\n"
sgMsgNeedPre,     ascii "\nTO ACHIEVE THE NEXT HIGHER RATING, YOU NEED "
sgMsgPointSing,   ascii " MORE POINT.\n"
sgMsgPointPlural, ascii " MORE POINTS.\n"

// sgPrint3Digit / sgPrint4Digit / sgPrintDigit -- bank-2 counterparts
// of printScore/printDigit (bank 1).
// turns. called via jsp (same-bank).
sgPrint3Digit,
    local rtn, value, sawDigit
    dap rtn
    sil 1s
    dio value
    dzm sawDigit
    lio value
    cla
    div [0d100
    nop
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sgP3Tens
    idx sawDigit
    jda sgPrintDigit
sgP3Tens,
    cla
    sil 1s
    div [0d10
    nop
    SKIP_NEXT_IF_AC_ZERO
    jmp sgP3DoTens
    dac value
    lac sawDigit
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sgP3DoOnes
    lac value
sgP3DoTens, jda sgPrintDigit
sgP3DoOnes,
    lai
    jda sgPrintDigit
    jmp rtn
rtn, jmp 0
value, 0
sawDigit, 0
    endloc

sgPrint4Digit,
    local rtn, value, sawDigit
    dap rtn
    sil 1s
    dio value
    dzm sawDigit
    lio value
    cla
    div [0d1000
    nop
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sgP4Hundreds
    idx sawDigit
    jda sgPrintDigit
sgP4Hundreds,
    cla
    sil 1s
    div [0d100
    nop
    SKIP_NEXT_IF_AC_ZERO
    jmp sgP4HunNonzero
    dac value
    lac sawDigit
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sgP4Tens
    lac value
sgP4HunNonzero,
    idx sawDigit
    jda sgPrintDigit
sgP4Tens,
    cla
    sil 1s
    div [0d10
    nop
    SKIP_NEXT_IF_AC_ZERO
    jmp sgP4DoTens
    dac value
    lac sawDigit
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sgP4DoOnes
    lac value
sgP4DoTens, jda sgPrintDigit
sgP4DoOnes,
    lai
    jda sgPrintDigit
    jmp rtn
rtn, jmp 0
value, 0
sawDigit, 0
    endloc

sgPrintDigit, 0
    local rtn
    dap rtn
    lac sgPrintDigit
    add ['0']
    swp
    tcb
    swp
rtn, jmp .
    endloc

// Call via jda txtascB2, AC = address of an ascii block (0-terminated).
txtascB2,  0
    dac txtascB2rtn
txtascB2Top,
    lac i txtascB2
    sar 4s
    sar 5s
    sza i
    jmp i txtascB2rtn
    lia
    tcb
    law 377
    and i txtascB2
    sza i
    jmp i txtascB2rtn
    lia
    tcb
    idx txtascB2
    jmp txtascB2Top
txtascB2rtn,  0

// ---------------------------------------------------------------------
// Vocabulary -- packed ascii, strCmpEq unpacks a string itself.
// NOTE that the original game only checked up to the first 5 characters of a name,
// ignoring any trailing characters.
// StrCmpEq is roughly equivalent to C's strncmp(), also limiting the check to 5 characters.
// Any words here longer than 5 are wasting space.
// However, the null terminator is still required, making it easier to deal with short words.
// All entries here are upper case; readCmd folds lower-case input to upper
// case on the way in, so commands may be typed in either case.
