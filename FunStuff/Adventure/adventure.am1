var bearFed
var bearDead
var chasmDestroyed
var vaseBroken
var bottleProp
var plantProp
var plantDisplayProp
var doorOiled
var turns
var tally
var tally2
var clock1
var clock2
var closing
var panicked
var closed
var instrHinted
var oysterHinted
var batteryUsed
var repoHiddenBottle
var repoHiddenPlant
