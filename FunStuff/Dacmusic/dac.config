# The D/A converters' settings, to add to the emulator's pidp1.config.
# The player's menu is drawn on the Type 340 and worked with the light pen,
# so the light pen is on. The converters open their own audio device; the
# emulator's own audio setting does not apply to them.

lightpen=on

# The converters' output level, a number: 1.0 plays as the tapes were made.
dacgain=1.0

# The room after the converters' mixer. dacroom=voices lets the voices
# choose at each start: Busch Hall when a note playing asks for it (the
# Flentrop's stops do), a generic hall otherwise. dacroom=busch or
# dacroom=hall holds one room; without the setting there is no room. With a
# room the whole sound is 6 dB down in the hall and 3 dB in Busch Hall, so
# loud tapes do not clip.
dacroom=voices

# The onset: daconset=MS starts each organ note up to MS milliseconds late,
# as a tracker organ's pallets and pipes do, each converter from its own
# fixed sequence; off without it or at 0.
daconset=8
