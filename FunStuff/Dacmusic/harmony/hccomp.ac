// Under 1968 DAC a copy under a held dynamic has its first bar stored
// again (cor); then the rest is copied.
cod,
    lac pdy
    trze(co7)
    jsp cor
    lac n1
    tgrel(cbh, co7)
    jmp psr

// cor -- the copy's first bar, cbh, stored again after the part's notes
// so far, with the dynamic held (pdy) after its tempo words and in place
// of the bar's dynamic, if it has one there; then its bar line, its entry,
// and lmb after it. cbh is left the next bar to copy, pdy let go. Called
// via jsp; AC and IO are clobbered.
cor,
    local cr1, cr2, cr3, cr4, cr9, cox
    dap cox
    lac nl
    add [1]
    dac t3                  // the bar's entry
    law i 1
    add cbh
    jda bget
    dac t4                  // the copied bar's next word
cr1,
    lac t4
    jda nget
    dac t1
    and [700000]
    sas [700000]
    jmp cr2
    lac t1                  // a tempo word, kept before the dynamic
    jda cn
    idx t4
    jmp cr1
cr2,
    lac pdy
    jda cn
    dzm pdy
    lac t1
    sad [600000]
    jmp cr9
    and [700000]
    sas [600000]
    jmp cr4
    idx t4                  // the bar's dynamic, replaced
cr3,
    lac t4
    jda nget
    dac t1
    sad [600000]
    jmp cr9
cr4,
    lac t1
    jda cn
    idx t4
    jmp cr3
cr9,
    lac [600000]
    jda cn
    jda sbc
    dac bix
    lac t3
    jda bput
    lac nl
    add [1]
    dac lmb
    idx cbh
cox, jmp .
    endlocal

// Bars cbh to n1 copied (cbh from 1), each an entry more; from srp too,
// for a 1968 repeat.
co7,
    law i 1
    add cbh
    dac cbh
co8,
    lac cbh
    jda bget
    dac t4
    jda sbc
    dac bix
    lac t4
    jda bput
    idx cbh
    tles(n1, co8)
    jmp psr

// Scan 1 and 2's words (hc1d lines 1484-1570). Each is set before it is
// read in a part, but rb and the measure buffer, which harmony.am1 sets
// at each READ TAPE.
ldl, 0                      // preceding character numeric? 1 yes, 0 no (s1, s2)
ucd, 0                      // number of numeric fields read (s1)
num, 0                      // value of the numeric field (s1)
n1, 0                       // first number (s1)
n2, 0                       // last number of 1 or 2 (s1)
psi, 0                      // character count (s1)
chi, 0                      // non-numeric character count (s1)
fc, 0                       // fraction status (s1, s2)
fu, 0                       // fraction used (s1, s2)
g, 0                        // count of g's (s1)
r, 0                        // count of r's (s1)
cm, 0                       // count of commas (s1)
rt, 0                       // right indicator, 0 number, 1 g, 2 comma (s1)
lt, 0                       // left indicator, 0 number, 1 r, 2 comma (s1)
tim, 0                      // running time (s1)
trm, 0                      // terminator (s1)
ao, 0                       // arguments outstanding (ps)
bc, 0                       // bar count (te)
tbc, 0                      // bar count within part (sbc)
tc, 0                       // terminator count within measure (s1)
chr, 0                      // character read (s1, s2, pc)
dig, 0                      // digit read (s1)
ss, 0                       // running status of the s l e h q mode (s2)
sv, 0                       // value of ss for this note (s2)
sr, 0                       // staff relocation count (s2)
st, 0                       // clef offset, 0 = subbass (s2)
tri, 0                      // triplet, 0 no, 100000 yes (s2)
aci, 0                      // accidental 0 none, 1 sharp or flat, -1 natural (s2); spacing (key)
acc, 0                      // accidental count (s2, key)
et, 0                       // embellishment temporary (s2)
ete, 0                      // embellishment (s2)
nf, 0                       // note forming (cn)
ton, 0                      // position in the staff, in mt (s2, key)
tne, 0                      // semitone; position in a key's table (s2, key)
tnd, 0                      // the position below, for an embellishment (s2)
tnf, 0                      // the position above (s2)
nl, 0                       // last note word's index (s2)
nft, 0                      // note's time (s2)
nfp, 0                      // nft kept from the grace notes' robbery (s2)
ex, 0                       // time for the sustained note (s2)
cut, 0                      // time not available to the trill loop (s2)
mm, 0                       // 3 x units used in the measure so far (s2)
tu, 0                       // 3 x units used by this note (s2)
units1, 0                   // units (ps)
units3, 0                   // 6 x units, a bar's count (ps)
mbh, 0                      // the measure's start in the buffer (rch)
lmb, 0                      // the last measure's first note index (te)
tht, 0                      // the pseudo-op being tried (pc)
zet, 0                      // its character being compared (pc)
ucl, 0                      // the word's end reached (pc)
psw, 0                      // where an argument goes (ps)
sid, 0                      // si of the note before (s2)
nld, 0                      // nl of the note before (s2)
ccc, 0                      // triplet of the last note not a comma (s2)
nls, 0                      // nl kept for grace notes (s2)
rob, 0                      // time the grace notes want (s2)
gi, 0                       // grace note (s2)
gis, 0                      // gi kept (s2)
