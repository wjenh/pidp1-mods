    pn1; pn2; pn3; pn4; pn5; pn6
    pn7; pn8; pn9; pna; pnb; pnc
    pnd; pne; pnf; png; pnh
    pnap; pnst; pnpp; pnp; pnmp; pnmf
    pnf6; pnff; pnop; pncl; pntr

pn1, 22; 0                          // s
pn2, 43; 0                          // l
pn3, 65; 0                          // e
pn4, 65; 45; 64; 0                  // end
pn5, 62; 61; 22; 22; 0              // bass
pn6, 23; 51; 65; 62; 43; 65; 0      // treble
pn7, 23; 65; 45; 46; 51; 0          // tenor
pn8, 61; 43; 23; 46; 0              // alto
pn9, 24; 45; 71; 23; 22; 0          // units
pna, 42; 65; 30; 0                  // key
pnb, 51; 65; 22; 23; 0              // rest
pnc, 63; 46; 47; 30; 0              // copy
pnd, 24; 47; 0                      // up
pne, 64; 46; 26; 45; 0              // down
pnf, 70; 0                          // h
png, 50; 0                          // q
pnh, 23; 65; 44; 47; 46; 0          // tempo
// The 1968 language's pseudo-ops. append and stop end the part; the
// dynamics are skipped, or under 1968 DAC held for the next note (pdyn);
// open and close are skipped; trill's argument sets the trill value
// (trw).
pnap, 61; 47; 47; 65; 45; 64; 0     // append
pnst, 22; 23; 46; 47; 0             // stop
pnpp, 47; 47; 0                     // pp
pnp, 47; 0                          // p
pnmp, 44; 47; 0                     // mp
pnmf, 44; 66; 0                     // mf
pnf6, 66; 0                         // f
pnff, 66; 66; 0                     // ff
pnop, 46; 47; 65; 45; 0             // open
pncl, 63; 43; 46; 22; 65; 0         // close
pntr, 23; 51; 71; 43; 43; 0         // trill

ps,
    jmp i psw

pv1,
    lac [200000]            // s
    dac ss
    jmp psr
pv2,
    lac [400000]            // l
    dac ss
    jmp psr
pv3,
    dzm ss                  // e
    jmp psr
pvf,
    lac [40000]             // h
    dac ss
    jmp psr
pvg,
    lac [20000]             // q
    dac ss
    jmp psr

pv5,
    law 12                  // bass
    dac st
    jmp psr
pv6,
    law 26                  // treble
    dac st
    jmp psr
pv7,
    law 16                  // tenor
    dac st
    jmp psr
pv8,
    law 20                  // alto
    dac st
    jmp psr

pv9,
    law 1                   // units
    dac ao
    law p9a
    dac psw
    jmp te
p9a,
    lac n1
    dac units1
    ral 1s
    add n1
    ral 1s
    dac units3
    law i 1
    dac irl

psr,
    dzm ao
    jmp te

// end makes the part's last bar entry, 600000, and hands the part on to
// the store (harmony.am1's pend, where hc1d punched it and halted).
pv4,
    jda sbc
    dac bix
    lac [600000]
    jda bput
    jmp pend

// In the 1968 language stop ends the part and the tape.
pstop,
    law 1
    dac stp
    jmp pv4

// In the 1968 language, a word skipped and counted, as if it were not
// there.
pskip,
    idx pskp
    lac rcsv
    dac rcf68
    jmp te

// In the 1968 language, trill. Its argument is read at s18 (trw);
// neither word counts as a word after rest or copy.
ptrl,
    law 1
    dac skn
    lac rcsv
    dac rcf68
    jmp te

// In the 1968 language, a dynamic, skipped (pskip). Under 1968 DAC it is
// held, as if not there, for the next note stored (dyi). pdy is its
// word, 600000 plus 1 pp to 6 ff, which is tht less 19.
pdyn,
    lac lng
    sas [2]
    jmp pskip
    lac tht
    add [600000-0d19]
    dac pdy
    lac rcsv
    dac rcf68
    jmp te

// trw -- trill's argument, from scan 1's counts. A note's length of a
// 32nd or longer with nothing else (one number, a power of two to 32, no
// letter) sets the part's trill value, 64 over it (trs). Any other, a
// shorter one, a triplet or a dotted one, is skipped, and trill with it;
// both words are counted in pskp, and the part keeps its trill value.
// Called via jsp; AC and IO are clobbered.
trw,
    local tw1, tw2, tw9, twx
    dap twx
    lac ucd
    sas [1]
    jmp tw9
    lac chi
    sza
    jmp tw9
    lac n1
    trze(tw9)
    tgrec([40], tw9)
    lac n1
    sub [1]
    and n1
    sza
    jmp tw9                 // not a power of two
    lac n1
    dac t1
    law 100
    dac t2
tw1,
    lac t1
    sad [1]
    jmp tw2
    sar 1s
    dac t1
    lac t2
    sar 1s
    dac t2
    jmp tw1
tw2,
    lac t2
    jda trs
    jmp twx
tw9,
    idx pskp
    idx pskp
twx, jmp .
    endlocal

// trs -- set the part's trill value, AC in 64ths (2, a 32nd, at the
// part's start). Sets trv, the time of each of m's, n's and w's notes;
// trv2, a pair; trk, the bits a time a whole number of pairs has clear;
// and their least times in ebl (m and w a pair, n two). Called via jda,
// since a jsp would leave its return address in AC, not the value; AC
// and IO are clobbered.
trs, 0
    local tsx
    dap tsx
    lac trs
    dac trv
    add trv
    dac trv2
    dac ebl+1
    dac ebl+4
    sub [1]
    dac trk
    lac trv2
    add trv2
    dac ebl+2
tsx, jmp .
    endlocal

// dyi -- under 1968 DAC, store a held dynamic (pdy) before the note's
// first word, after any tempo word before it, and let it go. Called via
// jsp; AC and IO are clobbered.
dyi,
    local dyx
    dap dyx
    lac pdy
    trze(dyx)
    jda cn
    dzm pdy
dyx, jmp .
    endlocal

pvh,
    law 1                   // tempo
    dac ao
    law pha
    dac psw
    jmp te
// In the 1968 language tempo N is a quarter note a minute, a half note
// below 60, and is made hc1d's K / N, rounded (K, a quarter note at
// tempo 1, is 12174).
pha,
    lac lng
    sza i
    jmp pha1
    lac n1
    trze(pha1)
    dac t2                  // the beats a minute, in quarter notes
    tgrel([0d60], pha2)
    lac t2
    ral 1s
    dac t2
pha2,
    lac t2
    ral 1s
    dac t3
    lac [0d24348]           // (2K + N) / 2N, K / N rounded half up
    add t2
    dac t4
    lio t4
    cla
    scl 1s
    div t3
    jmp pha1                // overflow, which cannot happen; the number as written
    jmp pha3
pha1,
    lac n1
pha3,
    add [700000]
    jda cn
    jmp psr

key,
pva,
    jda rch                 // key
    trze(pva)
    trel([55], pum)
    trel([57], pus)
    trel([54], puf)
    jda rrc
    jmp s1

pum,
    law s1
    dac pfu
pun,
    law nt
    dac cpa
    law kt
    dac cpb
    jsp cp44
pue,
    law kt
    dac cpa
    law mt
    dac cpb
    jsp cp44
    jmp i pfu

pus,
    dac kys
    law put
    dac pfu
    jmp puh
puf,
    dac kys
    law pug
    dac pfu
puh,
    law pun
    dac psw
    law 1
    dac ao
    lac lng
    trnz(ky68)
    jmp s1

// In the 1968 language the key's symbol repeated k times is k sharps or
// flats; anything else in the word after them is passed over.
ky68,
    law 1
    dac n1
ky1,
    jda rch
    trze(ky3)
    trel([21], ky3)
    trnl(kys, ky2)
    idx n1
    jmp ky1
ky2,
    jda rch
    trze(ky3)
    trnl([21], ky2)
ky3,
    dac chr
    dac trm
    idx tc
    jmp pun

put,
    law 1
    dac acc
    law 4
    dac aci
    law 3
    dac tne
    jmp puw
pug,
    law i 1
    dac acc
    law 3
    dac aci
    law 6
    dac tne

puw,
    test0(n1, pw2)
    lac tne
    dac ton

pw1,
    lac ton
    add [nt]
    dap pw1a
pw1a, lac .
    add acc
    dac t4
    lac ton
    add [kt]
    dap pw1b
    lac t4
pw1b, dac .
    law 7
    add ton
    dac ton
    tles([44], pw1)
    law i 1
    add n1
    dac n1
    lac tne
    add aci
    dac tne
    tles([7], puw)
    law i 7
    add tne
    dac tne
    jmp puw

pw2,
    law psr
    dac pfu
    jmp pue

// cp44 -- copy a key table's 36 words, cpa to cpb. Called via jsp; AC
// and IO are clobbered.
cp44,
    dap cpx
    law i 44
    dac cpn
cpl,
    lac i cpa
    dac i cpb
    idx cpa
    idx cpb
    isp cpn
    jmp cpl
cpx, jmp .

cpa, 0
cpb, 0
cpn, 0

pvb,
    law 1                   // rest
    dac ao
    test0(mm, pb2)
    error(M_ILR)
    jmp i1a

pb2,
    law pb1
    dac psw
    jmp te
pb1,
    lac lng                 // the slash after it ends no bar (1968)
    dac rcf68
    test0(n1, psr)
    testp(irl, pb3)
    lac units1
    add [100]
    ral 1s
    dac t1
    jda snl
    dac irl
    dac nix
    lac t1
    jda nput
    jda snl
    dac nix
    lac [600000]
    jda nput
    lac nl
    add [1]
    dac lmb

pb3,
    jda sbc
    dac bix
    lac irl
    jda bput
    law i 1
    add n1
    dac n1
    trnz(pb3)
    jmp psr

pvd,
    law 1                   // up
    dac ao
    law pd1
    dac psw
    jmp te
pd1,
    lac n1
    dac tll
    jmp psr

pve,
    law 1                   // down
    dac ao
    law pe1
    dac psw
    jmp te
pe1,
    lac n1
    trze(pe2)
