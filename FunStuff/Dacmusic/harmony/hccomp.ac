// The compiler. Samson's hc1d (tapes/music/hc1d.mac) ported to am1,
// with the 1968 language beside it (Docs/UsingHarmony.md describes
// both). The labels are hc1d.mac's, so a reader finds each piece there;
// those that start with a digit there are spelled with a letter first
// (2s3 is s2s3, 3i is tri, 1u and 3u are units1 and units3). Where
// hc1d.mac and hc1d.rim differ, this follows the .rim.
//
// These parts are not hc1d's. The part's notes are in the store and its
// bar entries in BARS (harmony.am1's nput, nget, bput, bget), counted
// from 0 up, where hc1d grew them toward each other in its 4K. end hands
// the part to harmony.am1's pend instead of punching it. A fatal message
// goes on to hfat instead of halting. Each place the 1968 language
// differs is marked "1968" and tests lng. 1968 DAC (lng 2) is the 1968
// language with the dynamics stored, marked "1968 DAC". trill sets a
// part's trill value in both (trw).
//
// Included by harmony.am1 in bank 0, with hcmacros.ah. Uses its reader
// (rp, rawc), typing (typ, tyw, wtx), store (nput, nget, bput, bget,
// nbase) and part bookkeeping (pend, hfat, perr, pskp, inp, lng, npv,
// oct68, stp).
//
// Everything here runs in bank 0 with the extend-mode window open, as
// the whole program does. hc1d's routines keep its calls, jda with a
// dap-form return, and its register use; each header says how it is
// called and what it returns.

// The part's start (hc1d's pf, pg, xp). The title is read whole, then
// typed. Entered via jmp from harmony.am1's cap, with ft at fb.

// In hc1d the title runs to its first slash, every character kept.
pg,
    jda rp
    dac chr
    sza
    dac inp                 // a part has begun, so the end of the tape cuts it short
    lac chr
    dac i ft
    testnl(chr, [21], pg1)
xp,
    law ptit
    dac pfu
    law fb
    dac emp
    law i 1
    dac tc
    jmp erf                 // types the title, then harmony.am1's ptit keeps it, then pfr
pg1,
    idx ft
    trnl([fl], pg)
hap,
    jmp rrz

// In the 1968 language the title is the part's first line, after the
// blank characters before it; a slash takes the place of its line end,
// so it is typed as hc1d types a title.
pg68,
    jda rp
    trze(pg68)
    dac inp
pg6a,
    dac chr
    lac rawc
    sad [77]
    jmp pg6e
    lac chr
    dac i ft
    idx ft
    trnl([fl], pg6b)
    jmp rrz
pg6b,
    jda rp
    jmp pg6a
pg6e,
    law 21
    dac i ft
    jmp xp

// pfr -- a part's state at its start (hc1d lines 431-449), then the
// key's tables made natural (pum) and on to scan 1.
pfr,
    dzm units1
    dzm units3
    lac lng                 // units 32 until a units is given (1968)
    sza i
    jmp pfr1
    law 40
    dac units1
    law 300
    dac units3
pfr1,
    law i 1
    dac irl
    dzm tll
    dzm ft
    law 1
    dac fi
    dac sid
    dzm rob
    dzm gi
    dzm gis
    dzm ao
    dzm tc
    dzm mm
    dzm ss
    dzm skn
    dzm rcf68
    dzm pdy
    law 2                   // a trill of 32nds until trill says otherwise
    jda trs
    law 1
    dac rb
    dac tbc
    law i 1
    dac tim
    law 26
    dac st
    jmp pum

// cr -- type a carriage return. Called via jda; AC and IO are clobbered.
cr, 0
    dap crx
    typ([77])
crx, jmp .

// sbc -- count a bar entry more (hc1d lines 456-463) in bc and tbc, and
// check the room (s3x if the part would not fit). Returns AC the entry's
// index, bc. Called via jda; IO is preserved.
sbc, 0
    dap sbx
    idx tbc
    idx bc
    tgrel([BARMAX], s3x)
    jsp room
    lac bc
sbx, jmp .

// snl -- count a note word more in nl and check the room. Returns AC nl.
// Called via jda; IO is preserved.
snl, 0
    dap swx
    idx nl
    jsp room
    lac nl
swx, jmp .

// rcw -- returns AC fi, the place in the buffer of the next character.
// Called via jda; IO is preserved.
rcw, 0
    dap rwx
    lac fi
rwx, jmp .

// rrc -- back to the start of the current word, so it can be scanned
// again (hc1d lines 477-480). Called via jda; AC is left fl2, IO is
// preserved.
rrc, 0
    dap rrx
    lac fl2
    dac fi
    dac fl1
rrx, jmp .

// rch -- the next character of the measure buffer (hc1d lines 483-555),
// refilling it from the tape when it is used up. The fill drops
// comments and is ended by a slash after fw characters, by end and a
// space, and in the 1968 language by append or stop and a space too
// (bga, bgt). A fill that reaches fl characters is fatal (rrz).
// Called via jda. Returns AC the character; IO is clobbered.
rch, 0
    dap rcx
    lac ft
    tgrel(fi, rcf)
    law fb
    dac mbh
    dac fi
    dac ft
    dac fl1
    dac fl2
    law 1
    dac bgs
    dac bga
    dac bgt
rcy,
    jda rp
    dac ch
    trnl([74], rcc)
    jda rp                  // a comment's first character
    sas [56]
    jmp rcv
    lac lng                 // upper-case vertical bar comments to line end (1968)
    sza i
    jmp rcw0
rcb,
    jda rp
    lac rawc
    trnl([77], rcb)
    dzm ch                  // the line end, kept as a space
    jmp rcc
rcw0,
    law 56
    jmp rcv
rcu,
    jda rp
rcv,
    trnl([72], rcu)
    jmp rcy

rcc,
    lac ch
    trze(rc1)
    trel([21], rc1)
    cla
    jmp rc2
rc1,
    law 1
rc2,
    dac pp
    lac ch
    dac i ft
    idx ft
    tles([fw], rcs)
    lac ft
    tles([fl], rce)
    jmp rrz
rce,
    lac ch
    trel([21], rfc)
rcs,
    lac lng
    sza i
    jmp rcs1
    // In the 1968 language append and stop end the fill as end does.
    law bga
    dac mtp
    law wapp
    dac mtw
    jsp mtc
    law bgt
    dac mtp
    law wstp
    dac mtw
    jsp mtc
rcs1,
    lac bgs
    add [rdt]
    dap rcd
    lac ch
rcd, jmp i .

rdt, rd0; rd1; rd2; rd3; rd4

rd0,
    trze(rda)
    trnl([21], rdp)
rda,
    law 1
    dac bgs
    jmp rcy
rd1,
    trnl([65], rdp)
    law 2
    dac bgs
    jmp rcy
rd2,
    trnl([45], rdp)
    law 3
    dac bgs
    jmp rcy
rd3,
    trnl([64], rdp)
    law 4
    dac bgs
    jmp rcy
rd4,
    trze(rfc)
    trel([1], rfc)
rdp,
    lac pp
    dac bgs
    jmp rcy

rfc,
    law i 1
    add ft
    dac ft
rcf,
    lac fi
    dap rcg
rcg, lac .
    dac ch
    idx fi
    lac ch
    trze(rf1)
    trel([21], rf1)
    lac fl1
    dac fl2
    jmp rff
rf1,
    lac fi
    dac fl1
rff,
    lac ch
rcx, jmp .

// mtc -- one step of the match of a 1968 fill-ending word. The word is
// in mtw (its codes, then 100), its state in the word mtp points to (0
// within another word, 1 at a word's start, k+1 with k codes matched).
// The whole word and then a space end the fill (to rfc, not returning);
// a space or slash starts a word, as pp says.
// Called via jsp, with ch the character. AC and IO are clobbered.
mtc,
    dap mtx
    lac i mtp
    trze(mtn)
    add mtw
    sub [1]
    dac mtq
    lac i mtq
    sad [100]
    jmp mtc2
    trnl(ch, mtn)
    lac i mtp
    add [1]
    dac i mtp
    jmp mtx
mtc2,
    lac ch
    trze(rfc)
mtn,
    lac pp
    dac i mtp
mtx, jmp .

mtp, 0                      // the state's word
mtw, 0                      // the word's codes
mtq, 0
wapp, 61; 47; 47; 65; 45; 64; 100     // append
wstp, 22; 23; 46; 47; 100             // stop

// er, er1 -- type an error (hc1d lines 558-625). Types the banner at the
// part's first, the measure (unless already typed for the last error at
// this word), a tab and the three letters, red for er1. erf types the
// title the same way, from xp. Called via jda, AC the letters. AC and
// IO are clobbered.
er, 0
    dap erx
    lac er
    dac arg
    law 1
    dac uin
    jmp erc
er1, 0
    dap ery
    lac er1
    dac arg
    law i 1
    dac uin
erc,
    law ec3
    dac pfu
    idx perr
ert,
    lac mjp
    tgrec([-2], erq)
    jda red
    lac [ban:1]
    jda wtx
erq,
    jda blk
    testnl(mjp, bc, erk)
    testel(tjp, tc, ec)
erk,
    lac mbh
    dac emp
erf,
    dzm blc
    law 1
    dac etc
    lac emp
err,
    dap erg
erg, lac .
    dac chy
    trze(et1)
    trel([21], ec0)
    typ(chy)
    jmp etr

// hc1d.rim, not .mac, sets etc to 0.
et1,
    cla
    dac etc
    sub tc
    trze(et2)
    trnl([1], et4)
    jda blk
    jmp et4
et2,
    jda red
et4,
    lac blc
    tles([100], ets)
    jda cr
    dzm blc
    jmp eti
ets,
    typ([0])
etr,
    idx blc
eti,
    idx emp
    jmp err

ec0,
    jda blk
    typ([21])
    jda cr
ec,
    jmp i pfu
ec3,
    typ([36])
    testp(uin, ec1)
    jda red
ec1,
    lac arg
    jda tw3
    jda blk
ec2,
    jda cr
    lac bc
    dac mjp
    lac tc
    dac tjp
    testp(uin, erx)
ery, jmp .
erx, jmp .

// red, blk -- the ribbon red or black, typed only when it changes (rb is
// +1 black, -1 red). Called via jda; AC and IO are clobbered.
red, 0
    dap rex
    testm(rb, rex)
    typ([35])
    law i 1
    dac rb
rex, jmp .

blk, 0
    dap blx
    testp(rb, blx)
    typ([34])
    law 1
    dac rb
blx, jmp .

// The errors that drop the word (hc1d lines 644-652).
s1y,
s1z,
    error(M_TMF)
    jmp te
s1x,
    error(M_TFF)
    jmp te
s1w,
    error(M_UNC)
    jmp te
s1v,
    error(M_ERT)
    jmp te

// The two fatal messages (hc1d lines 654-663). The part is given up and
// a new one begun where the reader stands (harmony.am1's hfat).
s3x,
    jda cr
    lac [movf:1]
    jda wtx
eha,
    jda cr
    jmp hfat
rrz,
    jda cr
    lac [mmes:1]
    jda wtx
    jmp eha

// No such pseudo-op. The rest of the word is skipped (hc1d lines
// 665-672).
pcz,
    error(M_NPS)
    test0(chr, te)
pz2,
    jda rch
    dac chr
    trze(pz3)
    trnl([21], pz2)
pz3,
    lac chr
    dac trm
    jmp te

// Scan 1 (hc1d lines 677-827). A word's numbers and letters are counted,
// and what it is is decided at its terminator (s18).
s1,
    dzm ldl
    dzm ucd
    dzm num
    dzm psi
    dzm chi
    dzm g
    dzm r
    dzm cm
    law 40
    dac fc
    law 100
    dac fu
s10,
    jda rch
    dac chr
    trze(s11)
    tgrec([20], s11)
s12,
    idx psi
    test1(ldl, s13)
    law 1
    dac ldl
s13,
    testnl(chr, [20], s14)
    cla
s14,
    dac dig
    lac num
    ral 1s                  // num * 10
    dac t1
    ral 2s
    add t1
    add dig
    dac num
    jmp s10

s11,
    test0(ldl, s15)
    dzm ldl
    test0(ucd, s17)
    tgrec([1], s16)
    lac num
    dac n2
    jmp s16
s17,
    lac num
    dac n1
    dac n2
    dzm num
s16,
    idx ucd

s15,
    test0(chr, s18)
    trel([21], s18)
    idx chi
    idx psi
    lac chr
    trel([73], s19)
    trel([27], s1a)
    trel([51], s1b)
    trel([67], s1c)
    trel([33], s1d)
    jmp s10

s19,
    lac fc
    dac fu
s1a,
    lac fc
    sar 1s
    dac fc
    jmp s10

s1b,
    idx r
    jmp s10
s1c,
    idx g
    jmp s10
s1d,
    idx cm
    jmp s10

s18,
    idx tc
    lac chr
    dac trm
    test0(psi, te)
    // In the 1968 language the word after trill is its argument (trw).
    lac skn
    sza i
    jmp s18a
    dzm skn
    jsp trw
    jmp te
s18a,
    // In the 1968 language a word ends what a slash after rest or copy
    // would not count; pskip puts it back for the words that are skipped.
    lac rcf68
    dac rcsv
    dzm rcf68
    lac ucd
    add cm
    trze(pc)
    test1(chi, s1e)
    test1(ao, ps)
    testel(n1, tbc, te)
    // In the 1968 language a bar number ahead of the count repeats the
    // bars before it.
    lac lng
    sza i
    jmp sbbl
    lac mm
    trnz(sbbl)
    lac tbc
    tgrel(n1, sbbl)
    lac tbc
    ral 1s
    sub n1
    dac cbh                 // the first bar repeated, the count less the jump
    sma sza                 // skip unless it is a bar
    jmp srp
sbbl,
    complaint(M_BBL)
    jmp te
srp,
    law i 1
    add tbc
    dac n1                  // the last, the bar before the count
    jmp co7

s1e,
    dzm ao
    lac r
    tles([2], s1f)
    complaint(M_TMR)
    law 1
    dac r
s1f,
    lac g
    tles([2], s1g)
    complaint(M_TMG)
    law 1
    dac g
s1g,
    lac cm
    tles([2], s1h)
    complaint(M_TMC)
    law 1
    dac cm

s1h,
    lac cm
    add r
    add ucd
    tgrec([2], s1y)
    test1(cm, s1s)
    lac r
    add g
    add ucd
    sub [2]
    trmi(s1x)
    trnz(s1t)
    test0(g, s1t)
    law 1
    dac rt
    jmp sli

s1s,
    law 2
    dac rt
    jmp sli

s1t,
    dzm rt
sli,
    test1(r, s1k)
    test1(ucd, s1j)
    law 2
    jmp s1l
s1j,
    cla
    jmp s1l
// A rest after a note in the measure that had no articulation letter
// makes that note legato (hc1d's 2006 amendment; nld is the note
// before).
s1k,
    test1(sid, sk1)
    lac nld
    jda nget
    and [117777]
    add [400000]
    dac t1
    lac nld
    dac nix
    lac t1
    jda nput
sk1,
    law 1
s1l,
    dac lt
    test0(rt, s1n)
    tgrec([1], s1m)
    law 2
    dac tim
    jmp s1o

s1m,
    testm(tim, s1w)
    jmp s1o

s1n,
    law 100
    dac tim
    law 1
    dac t2
    lac n2
    dac t1
    trze(s1v)
    tgrec([100], s1v)

s1q,
    lac t1
    sar 1s
    dac t1
    trze(s1p)
    lac tim
    sar 1s
    dac tim
    lac fu
    sar 1s
    dac fu
    lac t2
    ral 1s
    dac t2
    jmp s1q

s1p,
    testnl(n2, t2, s1v)
    test1(fu, s1o)
    complaint(M_DTU)

s1o,
    lac tim
    sar 1s
    dac fc
    jmp s2

// Scan 2 (hc1d lines 832-1144). The word's letters are read again, then
// the note words it makes are stored.
s2,
    dzm fu
    dzm sr
    dzm tri
    dzm si
    dzm aci
    dzm acc
    dzm et
    dzm ete
    jda rrc

s20,
    jda rch
    dac chr
    trze(s21)
    tgrec([20], s21)
    jmp s20
// The letter's place in s2z picks its action in s2y; a letter not there
// is passed over.
s21,
    law s2z
    dap s2k1
s2k1, lac .
    trel(chr, s2k2)
    idx s2k1
    trnl([lac s2z+NS2Z], s2k1)
    jmp s20
s2k2,
    lac s2k1
    sub [lac s2z]
    add [s2y]
    dap s2k3
s2k3, jmp i .

s2b,
    lac [200000]
    dac sv
    jmp s2a
s2c,
    lac [400000]
    dac sv
    jmp s2a
s2sr,
    lac [20000]
    dac sv
    jmp s2a
s2ss,
    lac [40000]
    dac sv
    jmp s2a
s2d,
    dzm sv
// hc1d.rim, not .mac, sets si to 1, so the last articulation letter
// wins and tms is never typed.
s2a,
    law 1
    dac si
    jmp s20
s2e,
    law 14
    add sr
    dac sr
    jmp s20
s2f,
    law i 14
    add sr
    dac sr
    jmp s20
s2g,
    lac [100000]
    dac tri
    jmp s20
s2h,
    testm(aci, s24)
    idx acc
    jmp s25
s2i,
    testm(aci, s24)
    law i 1
    add acc
    dac acc
s25,
    law 1
    dac aci
    jmp s20
s24,
    complaint(M_NOR)
    jmp s20
s2j,
    testel(aci, [1], s26)

s27,
    law i 1
    dac aci
    jmp s20
s26,
    complaint(M_NOR)
    dzm acc
    jmp s27

s2k,
    law 1
    jmp s28
s2l,
    law 2
    jmp s28
s2m,
    law 3
    jmp s28
s2n,
    law 4
    jmp s28
s2o,
    law 5
    jmp s28
s38,
    law 6
s28,
    dac et
    test0(ete, s29)
    complaint(M_TME)
s29,
    lac et
    dac ete
    jmp s20

s2p,
    lac fu
    add fc
    dac fu
s2q,
    lac fc
    sar 1s
    dac fc
    jmp s20

s2r,
    test0(si, s51)
    trel([1], s52)
    complaint(M_TMS)

s51,
    lac ss
    dac sv
s52,
    test1(cm, s69)
    lac tri
    dac ccc

s2s3,
    lac tim
    add fu
    dac nft
    dac nfp
    test1(g, s2s1)
    dzm gi
    test0(rob, s2s)
    lac nft
    sub rob
    dac nft
    tles([2], s2s2)
s22s,
    dzm rob
    jmp s2s

s2s2,
    lac nft
    tgrel(rob, s22s)
    lac nls
    dac nl
    dzm rob
    complaint(M_ITG)
    jmp s2s3

s2s1,
    lac rob
    add tim
    dac rob
    law 1
    dac gi
    jmp s2s

s69,
    lac nfp
    dac nft
    test1(tri, s2t)
    lac ccc
    dac tri

s2t,
    test0(fu, s2s4)
    complaint(M_TIC)

s2s4,
    test1(g, s2s1)
    dzm gi

s2s,
    test0(lt, s2u)
    tgrec([1], sv2)
    lac aci
    add ete
    trze(s2w)
    complaint(M_AIR)
s2w,
    law 200
    dac tne
    jmp s70

// The pitch is the position, staff shift, clef, and in the 1968 language
// an octave down (oct68), its positions being an octave above hc1d's.
s2u,
    lac n1
    add sr
    add st
    add oct68
    dac ton
    trmi(s40)
    tles([44], s2v)
s40,
    complaint(M_UAT)
    jmp s2w

sv2,
    testel(tne, [200], s70)
s2v,
    test0(aci, s31)
    lac ton
    add [nt]
    dap s2v1
s2v1, lac .
    add acc
    dac t1
    tles([2], s41)
    lac t1
    tles([77], s42)
s41,
    complaint(M_AOR)
    jmp s2w
s42,
    lac ton
    add [mt]
    dap s42a
    lac t1
s42a, dac .

s31,
    lac ton
    add [mt]
    dap s31a
s31a, lac .
    add tll
    dac tne
    tles([2], s40)
    lac tne
    tgrec([76], s40)
    lac tne
    ral 7s
    dac tne
s30,
    test0(ete, s70)
    test0(tri, s71)
s72,
    complaint(M_ETR)
    jmp s70

s71,
    lac ete
    add [ebl-1]
    dap s71a
s71a, lac .
    sub nft
    trze(s99)
    cma
s99,
    dac ex
    trpl(s73)

s79,
    complaint(M_EIT)
    jmp s70

s73,
    lac ton
    add [1]
    add [mt]
    dap s73a
s73a, lac .
    add tll
    dac tnf
    tles([2], s39)
    lac tnf
    tgrec([76], s39)
    lac tnf
    ral 7s
    dac tnf
    lac ton
    sub [1]
    add [mt]
    dap s73b
s73b, lac .
    add tll
    dac tnd
    tles([2], s39)
