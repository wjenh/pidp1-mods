Draw a lot of characters, 80 lines of 145 characters, 11,600 of them.
// The theoretical max is 85 lines of 146 characters.
// This puts a lot of stress on both the 340 and whatever display is being used,
// sending over 170K pixel updates per screen cycle.

#include <TYPE340/type340defs.ah>

#define YORIGIN 0d1014
#define XORIGIN 0d0
#define DYORIGIN 0d100
#define DXORIGIN 0d0
#define SIZE 1
#define BRIGHTNESS 2

#define clrnum dzm ones; dzm tens; dzm hundreds; dzm thousands

100/
strt,
    clrnum
loop,
    lio [prog
    dla
    dss
    jmp .-1
    jsp updatedigits
    jsp updnum
    jmp loop

updnum,             // jsp call
    local rtn
    dap rtn
    cli
    lac tens
    add [060
    rcr 6s
    lac hundreds
    add [060
    rcr 6s
    lac thousands
    add [060
    rcr 6s
    dio topdigits
    lac ones
    add [060
    ral 9s
    ral 3s
    ior [3700
    dac lastdigit
rtn, jmp .
    endloc

updatedigits,        // increment ones, ripple overflow up, jsp call
    local rtn
    dap rtn

    idx ones
    sas [0d10
    jmp rtn

    dzm ones
    idx tens
    sas [0d10
    jmp rtn

    dzm tens
    idx hundreds
    sas [0d10
    jmp rtn

    dzm hundreds
    idx thousands
    sad [0d10
    dzm thousands

rtn, jmp .
    endloc

ones, 0
tens, 0
hundreds, 0
thousands, 0

    prog, charsets(1) scale(0) intensity(BRIGHTNESS) next(point)
    y(YORIGIN) next(point)
    x(XORIGIN) next(character)

