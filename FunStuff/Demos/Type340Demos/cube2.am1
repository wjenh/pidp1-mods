Lightpen-draggable wireframe cube on the Type 340 display, vertices computed live

// This is a rework of cube.am1, but instead of autonomous tumbling using precomputed vectors,
// this one computes the matrix transforms on the fly.
// That changes the design in three ways from what a fixed-rate tumble would need:
//
// The display uses the Type 340 and needs no CPU attention between lightpen hits.
//
// Rotation matrix entries and small drag-angles are stored as PDP-1 fixed-point fractions,
// the same as the mul instruction expects.
// For two such fractions a, b the word left in AC after mul is round(a*b*2^17).
// Exact 1.0 can't be represented inthis format, so the matrix identity uses 0377777, 2^17-1 parts, ~0.9999924,
// on the diagonal.
// The error is far below display resolution and is a completely standard fudge for this kind of
// fixed-point code.
//
// The cube's vertex coordinates, though, are small RASTER INTEGERS (+-H, H=60), not fractions.
// To multiply one by a matrix entry we first turn it into the fraction coordinate/128, a left
// shift of 10, since 2^17/128 = 2^10.
// 128 is chosen because it comfortably covers the +-127 per-component range the Type 340's vector
// deltax/deltay fields allow anyway.
// After mul, the running dot-product sum represents actual_value/128 as a plain integer, the value  scaled by 1024.
// Shifting that right by 10 recovers the real raster coordinate.
//
// INCREMENTAL ROTATION
// ---------------------
// Each lightpen hit yields a small screen-space drag delta (dx,dy), clamped to +-MAXSTEP so a
// stray reference from a previous, now-released drag can't snap-move the cube.
// That delta is treated directly as a pair of small rotation angles  using the standard
// first-order small-angle approximation: for tiny angles, Rx(p)*Ry(y) =~ I plus a skew term, so
// the matrix update is just a few multiply-accumulates per row rather than a full 3x3*3x3 product.
// This is the classic "incremental rotation" trick used in much retro 3D code.
// The known cost is that repeated fixed-point rounding slowly drifts the matrix away from being
// perfectly orthonormal over a very long dragging session.
// For a hand-driven demo this is a well-understood, acceptable simplification and a periodic
// re-orthonormalization pass would be the fix if drift ever becomes visible in practice.
//
// There's no hand-derived initial tilt matrix used.
// Instead init below seeds a non-degenerate starting pose by running two synthetic drag increments
// through the exact same update path a real drag uses before the display is ever started.
// The seed exercises the identical rotation code path.
//
// EDGE LIST
// ---------
// Each of the 12 real cube edges gets its own absolute point-move to its start vertex followed
// by one relative visible vector to its end vertex in the Type 340 instruction list,.
// 12 edges x 4 words; parameter, y, x, vector.
// This is then patched in place during the move cycle.
//
// Finally, this was written by Claude/Sonnet5 with debugging and comment cleanup by wje.
//
// wje/Claude 8-Jul-2026 - initial version

#include <TYPE340/type340defs.ah>
#include <TYPE340/trackingTarget.ah>
#include <LIGHTPEN/lightpen.ah>

#define H 0d60
#define SCALE 0
#define INTENSITY 6
#define MAXSTEP 0d32

// Lightpe aperture to use.
#define APERTURE APERTURE250

// CUBE BOUNDS
#define CENTERX 0d250
#define EXTENTX (CENTERX + 0d200)       // This provides a margin to avoid target collisions
#define CENTERY 0d512

// Where the drag target is placed,its bounding box size, its scale, and its arm length.
// The location and bounding box are computed from the location of the cube and the size of the target.
#define TARGETBOXSIZE (0d1000 - (EXTENTX + 0d20))
#define TARGETX (EXTENTX + (TARGETBOXSIZE / 2))
#define TARGETY CENTERY
                                       
// Bounds the target can be dragged to, this is set to avoid edge or cube collisions.
// TARGETXMIN is set well clear of the cube's worst-case possible extent, not just its normal one.
// This is to account for drift.
// The absolute pathological bound on any row's projected extent is H*(|a|+|b|+|c|) <= 3*H = 180,
// i.e. center+180/
// TARGETXMAX prevents any right-edge collision.
// The y extents are similarly bounded.

/*
#define TARGETXMIN (TARGETX - (TARGETBOXSIZE/2) + (TARGETARM * 2*TARGETSCALE))
#define TARGETXMAX (TARGETX + (TARGETBOXSIZE/2) - (TARGETARM * 2^TARGETSCALE))
#define TARGETYMIN (TARGETY - (TARGETBOXSIZE/2) + (TARGETARM * 2^TARGETSCALE))
#define TARGETYMAX (TARGETY + (TARGETBOXSIZE/2) - (TARGETARM * 2^TARGETSCALE))
*/
#define TARGETXMIN (TARGETX - (TARGETBOXSIZE/2) + (TARGETSPAN / 2))
#define TARGETXMAX (TARGETX + (TARGETBOXSIZE/2) - (TARGETSPAN / 2))
#define TARGETYMIN (TARGETY - (TARGETBOXSIZE/2) + (TARGETSPAN / 2))
#define TARGETYMAX (TARGETY + (TARGETBOXSIZE/2) - (TARGETSPAN / 2))

// CLAMPTHRESH uses the same Q1.17 fraction convention as the matrix entries, 0200000 = 0.5.
// Any old matrix entry with |value| below this can cross zero via an ordinary small update.
// only entries already near the +-1 boundary can wrap, so this is a safe wide-margin)cutoff.
#define CLAMPTHRESH 0200000

// The number of edges and verticies for a cube.
#define NUMV 0d8
#define NUME 0d12

// Where the prompt goes.
#define MSGX 0d100
#define MSGY 0d100

// state vars
var havelast
var prevx, prevy, curhitx, curhity, lpword
var dx, dy

// current orientation matrix (Q1.17 fractions), started ~identity
var m00, m01, m02, m10, m11, m12, m20, m21, m22

// snapshot of the matrix taken at the start of each update
var o00, o01, o02, o10, o11, o12, o20, o21, o22

var dyaw, dpit

// clampfrac scratch
var clold

// transformverts / dot3 shared scratch
var vidx, mptr, pvx, pvy, pvz, rowA, rowB, rowC, acc, tmp, sxptr, syptr

// buildedges scratch
var eidx, eptr, fromv, tov, tptr, fx, fy, tx, ty, ddx, ddy
var xfield, yfield, vecword, ywordv, xwordv, ebase, wptr

100/
init,
    // Reset some vars, Claude didn't uderstand vars are not initialzed on each run,
    // only when the program is first loaded into memory.
    // Since PDP-1 core memory is non-volatile, values are not reset across runs.
    dzm havelast
    dzm m01
    dzm m02
    dzm m10
    dzm m12
    dzm m20
    dzm m21
    lac [0377777    // the identity diagonal value
    dac m00
    dac m11
    dac m22

    lio [APERTURE]
    dpy-i LIGHTPEN

    // Seed a non-degenerate starting orientation by running two synthetic drag
    // increments through the real update path.
    law 0d10
    dac dx
    law 0d7
    dac dy
    jsp updatematrix
    lac [0-0d6]
    dac dx
    law 0d9
    dac dy
    jsp updatematrix

    jsp transformverts
    jsp buildedges

    // One-time kick-off, prog now runs in its own loop, no more pdp-1 interaction
    // other than updating the rotation on a lightpen target hit and resuming the 340.
    lio [prog]
    dla

    // Just wait for a lightpen hit, then process and resume.
poll,
    dsp
    jmp poll
    drc
    dio lpword
    lac lpword
    and [0777]
    dac curhity
    lac lpword
    sar 9s
    and [0777]
    dac curhitx

    // Reposition the target icon to the raw hit position and resume the display right
    // away, before the (slower) cube matrix/vertex/edge recompute following
    // That keeps the target's own tracking responsive even if the cube's redrawn edges lag a pass behind.
    lac curhity
    sal 1s
    jda clamptargety
    ior [y(0) next(point)]
    dac tgty
    lac curhitx
    sal 1s
    jda clamptargetx
    //ior [show x(0)  next(increment)]
    ior [show x(0) next(parameter)]     // having it go into param mode lets us change it in the target code
    dac tgtx
    drs

    lac havelast
    sza i
    jmp firsthit

    // We have a previous reference, turn the (clamped) drag delta into a
    // matrix update, then recompute every screen vertex and edge from it.
    lac curhitx
    sub prevx
    jda clampstep
    dac dx
    lac curhity
    sub prevy
    jda clampstep
    dac dy
    lac curhitx
    dac prevx
    lac curhity
    dac prevy

    jsp updatematrix
    jsp transformverts
    jsp buildedges
    jmp poll

firsthit,
    law 1
    dac havelast
    lac curhitx
    dac prevx
    lac curhity
    dac prevy
    jmp poll

// clampstep
// AC in: raw signed delta.
// AC out: delta clamped to +-MAXSTEP.
// Called via jda.
clampstep, 0        // will have the passed AC value
    dap csrtn
    lac clampstep
    spa
    jmp csneg
    lac clampstep
    sub [MAXSTEP]
    spa
    jmp csdone
    lac [MAXSTEP]
    jmp csrtn
csdone,
    lac clampstep
    jmp csrtn
csneg,
    lac clampstep
    add [MAXSTEP]
    sma
    jmp csdone2
    lac [0-MAXSTEP]
    jmp csrtn
csdone2,
    lac clampstep
csrtn, jmp .

// clamptargetx
// AC in: full-resolution absolute x coordinate.
// AC out: same, clamped to [TARGETXMIN,TARGETXMAX]
// Called via jda.
clamptargetx, 0
    dap ctxrtn
    lac clamptargetx
    sub [TARGETXMAX]
    spa                 // AC = v-TARGETXMAX; skip (v>=TARGETXMAX) means clamp to max
    jmp ctxlo
    lac [TARGETXMAX]
    jmp ctxrtn
ctxlo,
    lac clamptargetx
    sub [TARGETXMIN]
    sma                 // AC = v-TARGETXMIN; skip (v<TARGETXMIN) means clamp to min
    jmp ctxok
    lac [TARGETXMIN]
    jmp ctxrtn
ctxok,
    lac clamptargetx
ctxrtn, jmp .

// clamptargety
// AC in: full-resolution absolute y coordinate.
// AC out: same, clamped to [TARGETYMIN,TARGETYMAX]
// Called via jda.
clamptargety, 0
    dap ctyrtn
    lac clamptargety
    sub [TARGETYMAX]
    spa                 // AC = v-TARGETYMAX; skip (v>=TARGETYMAX) means clamp to max
    jmp ctylo
    lac [TARGETYMAX]
    jmp ctyrtn
ctylo,
    lac clamptargety
    sub [TARGETYMIN]
    sma                 // AC = v-TARGETYMIN; skip (v<TARGETYMIN) means clamp to min
    jmp ctyok
    lac [TARGETYMIN]
    jmp ctyrtn
ctyok,
    lac clamptargety
ctyrtn, jmp .

// dot3
// Computes one output row of matrix*vertex.
// in: pvx,pvy,pvz, prescaled model coords, and
//     rowA,rowB,rowC, the 3 matrix entries of the row to use
// out: AC = descaled dot product.
// Called via jsp
dot3,
    dap d3rtn
    lac pvx
    mul rowA
    dac acc
    lac pvy
    mul rowB
    add acc
    dac acc
    lac pvz
    mul rowC
    add acc
    dac acc
    lac acc
    sar 5s
    sar 5s
    jmp d3rtn
d3rtn, jmp .

// packdx
// AC in: signed delta x in raster units.
// AC out: packed deltax(0-6) field, with 0200 set if delta was negative.
// Called via jda.
packdx, 0
    dap pdxrtn
    lac packdx
    spa
    jmp pdxneg
    and [0177]
    jmp pdxrtn
pdxneg,
    cma
    and [0177]
    ior [0200]
pdxrtn, jmp .

// packdy
// AC in: signed delta y in raster units.
// AC out: packed deltay field shifted into bits 8-14, with 0100000 set if delta was negative.
// Called via jda.
packdy, 0
    dap pdyrtn
    lac packdy
    spa
    jmp pdyneg
    and [0177]
    sal 8s
    jmp pdyrtn
pdyneg,
    cma
    and [0177]
    sal 8s
    ior [0100000]
pdyrtn, jmp .

// clampfrac -- saturating-add guard for one rotation-matrix entry.
//
// in: AC = newly computed value, post-add, possibly wrapped.
// out: AC = the new value unchanged, unless clold's magnitude was >= CLAMPTHRESH and the
//      sign flipped, in which case AC is saturated to +-0377777 (clold's sign) instead.
// Called via jda.
clampfrac, 0
    dap cfrtn
    lac clampfrac           // stash the possibly-wrapped new value

    lac clold
    xor clampfrac
    and [0400000]
    sza
    jmp cfcheck         // sign bits differ -- go check whether this is real overflow
    lac clampfrac
    jmp cfrtn           // same sign as before -- definitely not a wrap, pass through

cfcheck,
    lac clold           // get |clold| into AC
    spa
    jmp cfcomp          // clold negative -- complement to get its magnitude
    jmp cfmag           // clold positive -- AC already holds the magnitude
cfcomp,
    cma
cfmag,
    sub [CLAMPTHRESH]
    spa
    jmp cfok            // |clold| < threshold -- an ordinary zero-crossing, not overflow

    lac clold           // |clold| >= threshold and the sign flipped -- real wraparound;
    spa                 // saturate to clold's own sign at the max representable magnitude
    jmp cfclampneg
    lac [0377777]
    jmp cfrtn
cfclampneg,
    lac [0-0377777]
    jmp cfrtn

cfok,
    lac clampfrac
cfrtn, jmp .

// updatematrix
// Reads dx,dy which are already clamped raster-pixel deltas, derives
// small yaw/pitch angles, and applies the first-order skew-rotation update
// M_new = Delta(dyaw,dpit) * M_old.
// Each new entry is passed through clampfrac before being stored, so a near-+-1 entry saturates instead of
// wrapping when a rotation step would otherwise push it past the representable range.
// Called via jsp.
updatematrix,
    dap umrtn

    // The shifts determine the scaling of rotation for lp moves, more shifts, more moves, until it breaks.
    lac dx
    sal 9s
    dac dyaw

    lac dy
    sal 9s
    dac dpit

    // snapshot the current matrix
    lac m00
    dac o00
    lac m01
    dac o01
    lac m02
    dac o02
    lac m10
    dac o10
    lac m11
    dac o11
    lac m12
    dac o12
    lac m20
    dac o20
    lac m21
    dac o21
    lac m22
    dac o22

    // row0_new[j] = o0j + dyaw*o2j
    lac o00
    dac acc
    dac clold
    lac dyaw
    mul o20
    add acc
    jda clampfrac
    dac m00

    lac o01
    dac acc
    dac clold
    lac dyaw
    mul o21
    add acc
    jda clampfrac
    dac m01

    lac o02
    dac acc
    dac clold
    lac dyaw
    mul o22
    add acc
    jda clampfrac
    dac m02

    // row1_new[j] = o1j - dpit*o2j
    lac dpit
    cma
    dac umndpit

    lac o10
    dac acc
    dac clold
    lac umndpit
    mul o20
    add acc
    jda clampfrac
    dac m10

    lac o11
    dac acc
    dac clold
    lac umndpit
    mul o21
    add acc
    jda clampfrac
    dac m11

    lac o12
    dac acc
    dac clold
    lac umndpit
    mul o22
    add acc
    jda clampfrac
    dac m12

    // row2_new[j] = o2j - dyaw*o0j + dpit*o1j
    lac dyaw
    cma
    dac umndyaw

    lac o20
    dac acc
    dac clold
    lac umndyaw
    mul o00
    add acc
    dac acc
    lac dpit
    mul o10
    add acc
    jda clampfrac
    dac m20

    lac o21
    dac acc
    dac clold
    lac umndyaw
    mul o01
    add acc
    dac acc
    lac dpit
    mul o11
    add acc
    jda clampfrac
    dac m21

    lac o22
    dac acc
    dac clold
    lac umndyaw
    mul o02
    add acc
    dac acc
    lac dpit
    mul o12
    add acc
    jda clampfrac
    dac m22

    jmp umrtn
umrtn, jmp .
umndpit, 0
umndyaw, 0

// transformverts
// Recomputes sxtab[0..7], sytab[0..7], the screen x,y for
// every cube vertex, from the current matrix.
// Orthographic projection, z is dropped.
// Called via jsp.
transformverts,
    dap tvrtn
    dzm vidx
tvloop,
    // mptr = model + 3*vidx
    lac vidx
    add vidx
    add vidx
    add [model]
    dac mptr

    lac i mptr
    sal 5s
    sal 5s
    dac pvx
    idx mptr
    lac i mptr
    sal 5s
    sal 5s
    dac pvy
    idx mptr
    lac i mptr
    sal 5s
    sal 5s
    dac pvz

    // screen x = row0 . vertex + CENTERX
    lac m00
    dac rowA
    lac m01
    dac rowB
    lac m02
    dac rowC
    jsp dot3
    add [CENTERX]
    dac tmp
    lac vidx
    add [sxtab]
    dac sxptr
    lac tmp
    dac i sxptr

    // screen y = row1 . vertex + CENTERY
    lac m10
    dac rowA
    lac m11
    dac rowB
    lac m12
    dac rowC
    jsp dot3
    add [CENTERY]
    dac tmp
    lac vidx
    add [sytab]
    dac syptr
    lac tmp
    dac i syptr

    idx vidx
    lac vidx
    sub [NUMV]
    sza
    jmp tvloop
    jmp tvrtn
tvrtn, jmp .

// buildedges
// Recomputes and patches the 4-word-per-edge block for all
// 12 edges in prog, below, from the current sxtab/sytab.
// Called via jsp.
buildedges,
    dap bertn
    dzm eidx
beloop,
    // eptr = edges + 2*eidx ; fromv,tov = edges[2*eidx], edges[2*eidx+1]
    lac eidx
    sal 1s
    add [edges]
    dac eptr
    lac i eptr
    dac fromv
    idx eptr
    lac i eptr
    dac tov

    lac fromv
    add [sxtab]
    dac tptr
    lac i tptr
    dac fx
    lac fromv
    add [sytab]
    dac tptr
    lac i tptr
    dac fy

    lac tov
    add [sxtab]
    dac tptr
    lac i tptr
    dac tx
    lac tov
    add [sytab]
    dac tptr
    lac i tptr
    dac ty

    lac tx
    sub fx
    dac ddx
    lac ty
    sub fy
    dac ddy

    lac ddx
    jda packdx
    dac xfield
    lac ddy
    jda packdy
    dac yfield

    lac xfield
    ior yfield
    ior [0600000]
    dac vecword

    lac fy
    and [01777]
    ior [0220000]
    dac ywordv

    lac fx
    and [01777]
    ior [0100000]
    dac xwordv

    // ebase = prog + 4*eidx ; write y/x/vector words at ebase+1, +2, +3
    lac eidx
    sal 2s
    add [prog]
    dac ebase

    idx ebase	// now ebase+1, also in AC
    dac wptr
    lac ywordv
    dac i wptr

    idx ebase	// next word, ebase+2
    dac wptr
    lac xwordv
    dac i wptr

    idx ebase	// next word, ebase+3
    dac wptr
    lac vecword
    dac i wptr

    idx eidx	// increment, will also be in AC
    sub [NUME]
    sza
    jmp beloop
bertn, jmp .

// model
// 8 cube vertices, x,y,z each, +-H per axis.
// v0..v3 walk the bottom face (z=-H) in cyclic order so each consecutive pair is a
// real edge: (-H,-H), (H,-H), (H,H), (-H,H).
// v4..v7 are the same (x,y) cycle directly above at z=+H, so vN+4 sits above vN for the "verticals" edges below.
// NOTE: this is NOT plain n&1/n&2/n&4 binary bit-labeling -- straight binary
// counting order would make 1-2 and 5-6 face diagonals rather than edges.
// This is a Gray-code-style traversal instead.
model,
    0-H     // v0 x
    0-H     // v0 y
    0-H     // v0 z
    H       // v1 x
    0-H     // v1 y
    0-H     // v1 z
    H       // v2 x
    H       // v2 y
    0-H     // v2 z
    0-H     // v3 x
    H       // v3 y
    0-H     // v3 z
    0-H     // v4 x
    0-H     // v4 y
    H       // v4 z
    H       // v5 x
    0-H     // v5 y
    H       // v5 z
    H       // v6 x
    H       // v6 y
    H       // v6 z
    0-H     // v7 x
    H       // v7 y
    H       // v7 z

// edges, 12 real cube edges, from,to vertex index pairs.
edges,
    0d0             // bottom face: 0-1
    0d1
    0d1             // 1-2
    0d2
    0d2             // 2-3
    0d3
    0d3             // 3-0
    0d0
    0d4             // top face: 4-5
    0d5
    0d5             // 5-6
    0d6
    0d6             // 6-7
    0d7
    0d7             // 7-4
    0d4
    0d0             // verticals: 0-4
    0d4
    0d1             // 1-5
    0d5
    0d2             // 2-6
    0d6
    0d3             // 3-7
    0d7

// screen-space (x,y) for each of the 8 transformed vertices, filled in every update
sxtab,
   table NUMV, 0
sytab,
   table NUMV, 0

// The Type 340 display list: 12 edges x 4 words.
// Word 0 of each edge is the static parameter word.
// Words/ 1-3 (y, x, vector) are placeholders overwritten by buildedges.
prog,
    scale(SCALE) intensity(INTENSITY) next(point)
    0
    0
    0
    scale(SCALE) intensity(INTENSITY) next(point)
    0
    0
    0
    scale(SCALE) intensity(INTENSITY) next(point)
    0
    0
    0
    scale(SCALE) intensity(INTENSITY) next(point)
    0
    0
    0
    scale(SCALE) intensity(INTENSITY) next(point)
    0
    0
    0
    scale(SCALE) intensity(INTENSITY) next(point)
    0
    0
    0
    scale(SCALE) intensity(INTENSITY) next(point)
    0
    0
    0
    scale(SCALE) intensity(INTENSITY) next(point)
    0
    0
    0
    scale(SCALE) intensity(INTENSITY) next(point)
    0
    0
    0
    scale(SCALE) intensity(INTENSITY) next(point)
    0
    0
    0
    scale(SCALE) intensity(INTENSITY) next(point)
    0
    0
    0
    scale(SCALE) intensity(INTENSITY) next(point)
    0
    0
    0

// Separate lightpen drag target drawn every pass.
target,
   scale(TARGETSCALE) intensity(TARGETINTENSITY) lpon next(point)
// The origin point, tgtx,tgty is modified by the pdp-1 code.
// These are placeholders.
tgty, y(TARGETY) next(point)
tgtx, show x(TARGETX) next(parameter)

#include <TYPE340/trackingTarget.ac>

    next(point) charsets(2) scale(1) intensity(5) lpoff
    y(MSGY) next(point)
    x(MSGX) next(character)
    type340 "Drag the target with the lightpen."
    next(subroutine)
    jump prog next(parameter)

    halt   // Just for safety, should never be reached.

variables
constants

start init
