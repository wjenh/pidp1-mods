    down deltay(0d95) right deltax(0d31) visible
    up deltay(0d51) left deltax(0d51) visible
    down deltay(0d54) left deltax(0d104) visible
    up deltay(0d95) left deltax(0d31) visible
    down deltay(0d51) right deltax(0d51) visible
    down deltay(0d95) right deltax(0d31) visible
    up deltay(0d54) right deltax(0d104) visible
    down deltay(0d54) left deltax(0d104) visible
    up deltay(0d51) left deltax(0d51) visible end
    y(0d566) next(point)                      // frame 4: y (start point, vertex V1)
    x(0d572) show next(vector)                       // frame 4: x (start point, vertex V1)
    up deltay(0d47) left deltax(0d66) visible
