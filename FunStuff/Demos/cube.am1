Rotating wireframe cube on the Type 340 display
#include <TYPE340/type340defs.ah>

// Rotating wireframe cube demo.
//
// The cube (edge length 2H=120 raster units) tumbles about TWO of its own
// axes at once -- 3 yaw revolutions (about its vertical/Y axis) for every
// 2 roll revolutions (about its own depth/Z axis), over a 128-frame cycle.
// The rates are deliberately decoupled (a 3:2 ratio, not 1:1) so the
// combined motion reads as a genuine two-axis tumble rather than a single
// off-kilter wobble -- a 1:1 ratio would look like simple single-axis
// spin around some other fixed axis. On top of both animated axes there
// is a third, FIXED 28-degree tilt about X applied last, purely for
// viewing: without it the top/bottom faces are viewed edge-on and
// degenerate to straight lines regardless of the animated spin (an
// earlier version of this program did exactly that). All three rotations
// are ordinary 3D rotation matrices, so they compose into a single net
// rotation every frame; this preserves every edge's exact 3D length, and
// orthographic projection can only shrink a length, never grow it -- so
// the same "every subcommand is a real cube edge" argument below still
// guarantees the 127-unit vector limit is never at risk, regardless of
// how the two animated axes combine.
//
// All of the trigonometry (fixed tilt, yaw, and roll) is precomputed
// off-line in Python -- there is no sin/cos or multiply anywhere in this
// assembly. The file contains a table of 128 complete frames, each one 17
// words -- a y(), an x(), and 15 vector subcommands. The 15-word edge
// sequence was found by exhaustively searching the cube's edge graph for
// a walk that covers all 12 edges using only real edges (never a face or
// space diagonal) with exactly 3 necessary retraces (a cube's vertices
// are all odd-degree, so a single connected walk needs at least 3
// repeats). There are no invisible pen-lifts; every subcommand is a real
// edge, so every one is drawn visible (a retrace just draws over an
// existing line a second time).
//
// Each pass through the host loop:
//   1. computes this frame's base address in frametable (frameidx*17),
//   2. copies its 17 words on top of the live display list (the same
//      self-modifying-display-list technique as FunStuff/Demos/newLines.am1,
//      just generalized from one patched word to seventeen),
//   3. starts the display with dla and waits for it to reach its own halt,
//   4. advances frameidx (wrapping 0-127) and loops.
//
// Now the amazing part, this was written entirely by Claude/sonnet5, including all the comments above.

#define SCALE 1     // scale factor globally applied
#define INTENSITY 6 // intensity globally applied

#define COPYWORD(N,DEST) lac curbase; add [N]; dac ptr; lac i ptr; dac DEST

var curbase, ptr, frameidx=0, delaycnt

100/
top,
    lac frameidx
    sal 4s              // AC = frameidx*16
    add frameidx         // AC = frameidx*16 + frameidx = frameidx*17
    add [frametable]      // AC = address of this frame's 17-word block
    dac curbase

    COPYWORD(0d0, progy)
    COPYWORD(0d1, progx)
    COPYWORD(0d2, veca)
    COPYWORD(0d3, vecb)
    COPYWORD(0d4, vecc)
    COPYWORD(0d5, vecd)
    COPYWORD(0d6, vece)
    COPYWORD(0d7, vecf)
    COPYWORD(0d8, vecg)
    COPYWORD(0d9, vech)
    COPYWORD(0d10, veci)
    COPYWORD(0d11, vecj)
    COPYWORD(0d12, veck)
    COPYWORD(0d13, vecl)
    COPYWORD(0d14, vecm)
    COPYWORD(0d15, vecn)
    COPYWORD(0d16, veco)

    lio [prog
    dla
waitstop,
    dss
    jmp waitstop

    // tune this constant to taste -- more negative = slower rotation
    lac [0-0d3000]
    dac delaycnt
delayloop,
    isp delaycnt
    jmp delayloop

    lac frameidx
    add [1]
    and [0177]           // wrap 0-127 (128-frame table)
    dac frameidx
    jmp top

variables
constants

// Begins in parameter mode (scale/intensity, then point, then vector).
// The placeholder values below are overwritten by the host before the
// first dla ever runs; they only need to be well-formed.
prog,
    scale(SCALE) intensity(INTENSITY) next(point)
progy, y(0d537) next(point)
progx, x(0d572) show next(vector)
veca, right deltax(0d1) deltay(0d0) visible
vecb, right deltax(0d1) deltay(0d0) visible
vecc, right deltax(0d1) deltay(0d0) visible
vecd, right deltax(0d1) deltay(0d0) visible
vece, right deltax(0d1) deltay(0d0) visible
vecf, right deltax(0d1) deltay(0d0) visible
vecg, right deltax(0d1) deltay(0d0) visible
vech, right deltax(0d1) deltay(0d0) visible
veci, right deltax(0d1) deltay(0d0) visible
vecj, right deltax(0d1) deltay(0d0) visible
veck, right deltax(0d1) deltay(0d0) visible
vecl, right deltax(0d1) deltay(0d0) visible
vecm, right deltax(0d1) deltay(0d0) visible
vecn, right deltax(0d1) deltay(0d0) visible
veco, right deltax(0d1) deltay(0d0) visible end
    halt
    halt

frametable,
    y(0d537) next(point)                      // frame 0: y (start point, vertex V1)
    x(0d572) show next(vector)                       // frame 0: x (start point, vertex V1)
    up deltay(0d56) right deltax(0d0) visible
    down deltay(0d106) right deltax(0d0) visible
    up deltay(0d106) right deltax(0d0) visible
    up deltay(0d0) left deltax(0d120) visible
    down deltay(0d56) right deltax(0d0) visible
    up deltay(0d0) right deltax(0d120) visible
    down deltay(0d106) right deltax(0d0) visible
    up deltay(0d56) right deltax(0d0) visible
    up deltay(0d0) left deltax(0d120) visible
    up deltay(0d106) right deltax(0d0) visible
    down deltay(0d56) right deltax(0d0) visible
    down deltay(0d106) right deltax(0d0) visible
    up deltay(0d0) right deltax(0d120) visible
    up deltay(0d0) left deltax(0d120) visible
    up deltay(0d56) right deltax(0d0) visible end
    y(0d546) next(point)                      // frame 1: y (start point, vertex V1)
    x(0d574) show next(vector)                       // frame 1: x (start point, vertex V1)
    up deltay(0d55) left deltax(0d18) visible
    down deltay(0d104) right deltax(0d12) visible
    up deltay(0d104) left deltax(0d12) visible
    down deltay(0d18) left deltax(0d118) visible
    down deltay(0d56) right deltax(0d18) visible
    up deltay(0d19) right deltax(0d118) visible
    down deltay(0d105) right deltax(0d12) visible
    up deltay(0d56) left deltax(0d18) visible
    down deltay(0d19) left deltax(0d118) visible
    up deltay(0d105) left deltax(0d12) visible
    down deltay(0d56) right deltax(0d18) visible
    down deltay(0d104) right deltax(0d12) visible
    up deltay(0d18) right deltax(0d118) visible
    down deltay(0d18) left deltax(0d118) visible
    up deltay(0d55) left deltax(0d18) visible end
    y(0d554) next(point)                      // frame 2: y (start point, vertex V1)
    x(0d575) show next(vector)                       // frame 2: x (start point, vertex V1)
    up deltay(0d54) left deltax(0d35) visible
    down deltay(0d101) right deltax(0d22) visible
    up deltay(0d101) left deltax(0d22) visible
    down deltay(0d37) left deltax(0d113) visible
    down deltay(0d54) right deltax(0d35) visible
    up deltay(0d37) right deltax(0d113) visible
    down deltay(0d101) right deltax(0d22) visible
    up deltay(0d54) left deltax(0d35) visible
    down deltay(0d37) left deltax(0d113) visible
    up deltay(0d101) left deltax(0d22) visible
    down deltay(0d54) right deltax(0d35) visible
    down deltay(0d101) right deltax(0d22) visible
    up deltay(0d37) right deltax(0d113) visible
    down deltay(0d37) left deltax(0d113) visible
    up deltay(0d54) left deltax(0d35) visible end
    y(0d561) next(point)                      // frame 3: y (start point, vertex V1)
    x(0d574) show next(vector)                       // frame 3: x (start point, vertex V1)
    up deltay(0d51) left deltax(0d51) visible
    down deltay(0d95) right deltax(0d31) visible
    up deltay(0d95) left deltax(0d31) visible
    down deltay(0d54) left deltax(0d104) visible
