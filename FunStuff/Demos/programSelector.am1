Demo of light pen, sym gen, drum, clock
// Did I forget anything? Oh, right, DCS.

// We load into and run in this bank
#define BNKNO 2

#include <SYMGEN/type33iots.ah>
#include <LIGHTPEN/lightpen.ah>
#include <DRUM/type23drumdefs.ah>
#include <CLOCK/clockdefs.ah>
#include <memory.ah>

#define LABELY 0d450
#define LABELX -0d450
#define TEXTSIZE 2
#define BRIGHTNESS 0

#define LSTX LABELX
#define LSTY (LABELY -(4 * CHARSIZEY(TEXTSIZE)))
#define MSGY LABELY
#define MSGX LABELX
#define HIBRIGHTNESS 3
#define DIGITSIZE 3

// We count down from this
#define COUNTDOWN 5

// only the first 10
#define MAXDIRS 0d15

// location in buffer of the valid entry marker
#define DIRMARKER 25
// location in buffer of the start address
#define STARTADDR 22
// location in buffer of the has-a-label marker
#define HASLABEL 23

bank BNKNO

var linePtr, txtPtr, addrPtr
var ptr, dirY, dirCtr, ctr
var destBank, startAddr
var numEntries     // will be one more than the number we have

100/
strt,
    jsp type340halt     // just in case a type 340 program is running in bank 0
    law lines
    dac linePtr
    law txtBuf
    dac txtPtr
    law startAddrs
    dzm numEntries
    lem                 // on from loader, not now
    jsp loadEntries

    law APERTURE300
    lia
    dpy-i LIGHTPEN
    law TEXTSIZE AUTOSPACE
    lia
    glf

loop,
    lio [LABELY << 0d8
    lac [LABELX << 0d8
    sdb BRIGHTNESS << 6
    law header1
    jda drawasctext

    lio [(LABELY - CHARSIZEY(TEXTSIZE) - CHARSIZEY(TEXTSIZE)/2) << 0d8]
    lac [LABELX << 0d8
    sdb BRIGHTNESS << 6
    law header2
    jda drawasctext

    // Now list the files we have
    lac [LSTY
    dac dirY
    dzm dirCtr
dirs,
    lio dirY
    ril 8s
    lac [LSTX
    ral 8s
    sdb BRIGHTNESS << 6
    clf 3
    lac dirCtr
    sad numEntries
    jmp loop        // all done
    add [lines
    dac ptr
    lac i ptr
    jda drawasctext
    szf 3
    jsp gotOne
    idx dirCtr
    lac dirY
    sub [CHARSIZEY(TEXTSIZE) + SPACINGSIZE(TEXTSIZE)]
    dac dirY
    jmp dirs

// A selection was made.
// Wrap up and go.
// dirCtr will have the selection
gotOne,
    lio [MSGY << 0d8
    lac [MSGX << 0d8
    sdb BRIGHTNESS << 6
    law i COUNTDOWN
    dac ctr
    law lines
    add dirCtr
    dac linePtr
    lac i linePtr
    dac txtPtr          // now points to the text of the selection
// start the countdown timer, 1 second interval
     law 0d1000         // delay in milliseconds
     cct                // go, cks bit 13, cctcks, will be set when done

waitLoop,
    cks
    rir 5s
    spi i
    jmp w2
    idx ctr
    sza i
    jmp go
    law 0d1000          // keep going, 1 sec delay
    cct

w2,                     // we're waiting, update the display
    law TEXTSIZE AUTOSPACE
    lia
    glf

    law MSGY
    dac dirY           // reuse dirY
    lia
    ril 8s
    lac [MSGX << 0d8
    sdb BRIGHTNESS << 6
    law msg1
    jda drawasctext
    gsp
    lac txtPtr
    jda drawasctext

    jsp nextLine
    law msg2
    jda drawasctext
    
    jsp nextLine
    law msg3
    jda drawasctext
    law BNKNO
    jda drawdigit

    jsp nextLine
    law msg3b
    jda drawasctext
    
    jsp nextLine
    law msg4
    jda drawasctext

    // draw the countdown
    law DIGITSIZE
    lia
    glf
    cli
    cla
    sdb HIBRIGHTNESS << 6
    lac ctr
    cma
    jda drawdigit
    jmp waitLoop

go, cla
    cct         // clear timer
    law startAddrs  // get the starting address, might be 16 bits
    add dirCtr
    dac ctr
    lio i ctr
    lai
    and [170000     // the bank number, still in bits 2-5
    dac destBank
    lai
    and [7777       // and the now 12 bit address
    dac startAddr
    lio dirCtr
    jsp loadPgm
    jmp run

// Load the list of programs on the drum
// Loop thru all tracks getting the control block, 7751-7777
loadEntries,
    local trk, rtn
     dap rtn
     dzm trk
ld2, lac trk
     sal 6s
     sal 6s
     ior [drmrd 7751] // directory area on the drum track
     lia
     dia
     law 26         // read o26 words
     lia
     dwc
     lio [dirBuf:BNKNO      // into our buffer
     dcl
     DRUM_WAIT_READY

     lac dirBuf + DIRMARKER // 707070 is a marker that the track is initialized
     sas [707070
     jmp next               // no, skip this entry
     lac dirBuf + HASLABEL  // if 1, has a label
     sza i
     jmp next               // no label
     lac txtPtr             // save the name into current slot
     dac dst
     add [0d17              // ready for next slot
     dac txtPtr
     law 0d17               // 17 words, 34 chars
     jda memcpy
     dirBuf
dst, 0
     lio dst             // is the ptr into the text buffer
     law lines
     add numEntries
     dac dst
     dio i dst
     law startAddrs      // and save the start addr
     add numEntries
     dac dst
     lio dirBuf + STARTADDR
     dio i dst
     idx numEntries
     sas [MAXDIRS
     jmp next
     jmp rtn         // and done

next, idx trk        // next drum track
     sas [TRACKS     // the number of tracks on the drum, from drum include
     jmp ld2
rtn,jmp .
trk,0
    endloc

// AC has the track to load.
// The address could be an extended address if it's an am1 program,
// so we have to use destBank also.
// Load the program's bank mem from drum, the entire track.
// jsp, track in IO
loadPgm,
     local rtn
     dap rtn
     lai
     sal 6s
     sal 6s
     ior [drmrd
     lia
     dia
     cli            // a word count of 0 means 4096 words
     dwc
     lio destBank
     dcl        // bank x, address 0
     DRUM_WAIT_READY
rtn, jmp .
    endloc

// DestBank now has pgm loaded, start it up.
// Put a little program bit in bank 0
// The jmp at 0002 is to get the sbs out of sbs mode, possibly eem mode, and get to the real start location.
// When a program is started, a jmp will be made to 1:0.
// It will be in eem mode because of the farjmp to 1:0.
// It will jump to either 7751 if the program is in bank 0  or 7752 if the program is in another bank.
// 0001:0 jmp i 2
// 0002:0 7775 or 7776
// 7775:0 lem
// 7776:0 jmp i 7777
// 7777:0 startAddr
run,
    eem
    law 1
    dac addrPtr
    lac [jmp i 2
    dac i addrPtr
    idx addrPtr

    // 7775 if we want eem off, else 7776
    law 7775
    lio destBank
    szi
    law 7776
    dac i addrPtr

    // Now turn off or leave on eem and jump to the actual starting address
    law 7775
    dac addrPtr
    lac [lem
    dac i addrPtr
    idx addrPtr
    lac [jmp i 7777
    dac i addrPtr
    idx addrPtr
    lac startAddr
    ior destBank
    dac i addrPtr
    farjmp(1)

// Advance draw point to start of next line
// Called via jsp.
nextLine,
    local rtn
    dap rtn
    lac dirY
    sub [CHARSIZEY(TEXTSIZE) * 2]
    dac dirY
    lia
    ril 8s
    lac [LABELX << 0d8
    sdb BRIGHTNESS << 6
rtn, jmp .
    endloc

// Put included code here
#include "memcpy.ac"
#include <SYMGEN/drawasctext.ac>
#include <SYMGEN/drawdigits.ac>

// Pointer table for lines
lines,
    table MAXDIRS

// table for start addresses
startAddrs,
    table MAXDIRS, 0

// table for dir names
// up to 33 ascii chars, 2 per word
txtBuf,
    table MAXDIRS * (0d34 / 2)

// Scratch storage used for reading dir entries into
dirBuf,
    table 30

header1,
    ascii "Fun with the light pen"
header2,
    ascii "Make your selection:"
msg1,
    ascii "You selected "
msg2,
    ascii "You can come back here when ready,"
msg3,
    ascii "Turn on extend, set extension to "
msg3b,
    ascii "Set address 100, start"
msg4,
    ascii "Starting in:"


#include <SYMGEN/drawasctext.ac>
#include <SYMGEN/drawdigits.ac>
#include <TYPE340/type340halt.ac>

constants
start strt:BNKNO
