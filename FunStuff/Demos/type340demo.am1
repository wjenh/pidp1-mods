Demo of the Type 340 display showing off the features.
#include <TYPE340/type340defs.ah>

/*
 * This draws triangles, lines of varying intensity, a sine wave, some text, a horizontal line, and a little
 * box with a dot in it.
 * Run this with the Type 30 p7sim display, not the web panel if you want to see more coolness...
 * click on any line, text, etc. and see what happens.
 * Click on the little box and slowly drag the lightpen, er, mouse around.
 *
 */
// This is for the triangles
#define SIDE 0d120

var lpcoords, lphit

100/
top, lio [prog
    dla
check, dsp
    jmp nohit
    // get the lp hit coordinates, flag seen
    drc
    dio lpcoords
    idx lphit
    drs
nohit, dss
    jmp check

    // see if we need to update the target
    lac lphit
    sza i
    jmp top
    lac lpcoords
    // The coordinates are missing the lsb
    and [0777
    sal 1s
    ior [next(point) y(0)
    dac ty
    lac lpcoords
    sar 8s
    and [01777
    ior [show x(0) next(increment)
    dac tx
    dzm lphit
    jmp top

variables

// Begins in PARAM next
prog,
    scale(0) intensity(3) lpon next(slave)
    slave1(enabled|lpenabled) next(point)
    y(0d500) next(point)
    x(0d252) show next(subroutine)
    save triangle next(vector)
    next(point)
    y(0d500) next(point)
    x(0d452) show next(subroutine)
    save triangle next(vector)
    next(point)
    y(0d500) next(point)
    x(0d652) show next(subroutine)
    save triangle next(vector)

    scale(1) next(point)
    next(point)
    y(0d450) next(point)
    x(0d0) show next(vcontinue)
    visible right deltax(0d120)

    scale(1) intensity(4) next(point)
    y(0d950) next(point)
    x(0d10) show next(subroutine)
    jump hello next(character)

next1,
    scale(2) intensity(6) next(point)
    y(0d850) next(point)
    x(0d10) show next(subroutine)
    jump pdp1 next(character)

next2,
    next(subroutine)
    jump intensity next(parameter)

next3,
    scale(1) intensity(5) next(point)
    y(0d225) next(point)
    x(0d350) show next(subroutine)
    save sine next(increment)

next4,
    next(subroutine)
    save target next(parameter)

done,
    halt

triangle,
    visible up deltay(SIDE) right deltax(SIDE/2)
    visible down deltay(SIDE) right deltax(SIDE/2)
    visible deltay(0) left deltax(SIDE)
    end

hello,
    100514
    141740
    271722
    140441
    370000
    next(subroutine)
    jump next1 next(parameter)

pdp1,
    362004
    206135
    370000
    next(subroutine)
    jump next2 next(parameter)

intensity,
    scale(0) intensity(0) next(point)
    y(0d812) next(point)
    x(0d812) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(1) next(point)
    y(0d824) next(point)
    x(0d812) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(2) next(point)
    y(0d834) next(point)
    x(0d812) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(3) next(point)
    y(0d844) next(point)
    x(0d812) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(4) next(point)
    y(0d854) next(point)
    x(0d812) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(5) next(point)
    y(0d864) next(point)
    x(0d812) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(6) next(point)
    y(0d874) next(point)
    x(0d812) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(7) next(point)
    y(0d884) next(point)
    x(0d812) show next(vector)
    visible up deltay(0) right deltax(0d120) end
    next(subroutine)
    jump next3 next(parameter)

sine,
    visible set1(incright)  set2(incup)  set3(incup)  set4(incright) 
    visible set1(incup)  set2(incup)  set3(incright)  set4(incup) 
    visible set1(incup)  set2(incright)  set3(incup)  set4(incup) 
    visible set1(incup)  set2(incright)  set3(incup)  set4(incup) 
    visible set1(incright)  set2(incup)  set3(incup)  set4(incright) 
    visible set1(incup)  set2(incup)  set3(incup)  set4(incright) 
    visible set1(incup)  set2(incup)  set3(incright)  set4(incup) 
    visible set1(incup)  set2(incright)  set3(incup)  set4(incup) 
    visible set1(incright)  set2(incup)  set3(incup)  set4(incright) 
    visible set1(incup)  set2(incup)  set3(incright)  set4(incup) 
    visible set1(incup)  set2(incright)  set3(incup)  set4(incup) 
    visible set1(incright)  set2(incup)  set3(incup)  set4(incright) 
    visible set1(incup)  set2(incup)  set3(incright)  set4(incup) 
    visible set1(incup)  set2(incright)  set3(incup)  set4(incup) 
    visible set1(incright)  set2(incup)  set3(incright)  set4(incup) 
    visible set1(incup)  set2(incright)  set3(incup)  set4(incright) 
    visible set1(incup)  set2(incup)  set3(incright)  set4(incup) 
    visible set1(incright)  set2(incup)  set3(incright)  set4(incup) 
    visible set1(incup)  set2(incright)  set3(incup)  set4(incright) 
    visible set1(incup)  set2(incright)  set3(incup)  set4(incright) 
    visible set1(incup)  set2(incright)  set3(incright)  set4(incup) 
    visible set1(incright)  set2(incup)  set3(incright)  set4(incright) 
    visible set1(incright)  set2(incup)  set3(incright)  set4(incright) 
    visible set1(incright)  set2(incright)  set3(incright)  set4(incright) 
    visible set1(incright)  set2(incright)  set3(incright)  set4(incdown) 
    visible set1(incright)  set2(incdown)  set3(incright)  set4(incright) 
    visible set1(incdown)  set2(incright)  set3(incdown)  set4(incright) 
    visible set1(incdown)  set2(incright)  set3(incdown)  set4(incright) 
    visible set1(incdown)  set2(incdown)  set3(incright)  set4(incdown) 
    visible set1(incright)  set2(incdown)  set3(incright)  set4(incdown) 
    visible set1(incdown)  set2(incright)  set3(incdown)  set4(incright) 
    visible set1(incdown)  set2(incdown)  set3(incright)  set4(incdown) 
    visible set1(incright)  set2(incdown)  set3(incdown)  set4(incright) 
    visible set1(incdown)  set2(incdown)  set3(incright)  set4(incdown) 
    visible set1(incdown)  set2(incright)  set3(incdown)  set4(incdown) 
    visible set1(incright)  set2(incdown)  set3(incdown)  set4(incright) 
    visible set1(incdown)  set2(incdown)  set3(incright)  set4(incdown) 
    visible set1(incdown)  set2(incright)  set3(incdown)  set4(incdown) 
