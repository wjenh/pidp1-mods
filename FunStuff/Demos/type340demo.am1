    visible set1(incup)  set2(incup)  set3(incright) 
    end

// draw a square lp target
target,
    scale(3) next(point)
ty, y(0d768) next(point)
tx, show x(0d512) next(increment)
    visible set1(incleft|incup) set2(incright) set3(incright) set4(incdown)
    visible set1(incdown) set2(incleft) set3(incleft) set4(incup)
    end

start top
