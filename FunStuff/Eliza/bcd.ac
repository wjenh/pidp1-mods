// bcd.ac -- characters, from ASCII to 7094 BCD and back, and the packing of a
// word of BCD characters into list cells.
//
// Needs eliza.ah, AIDS/skipmacros.ah and lists.ac. Every routine is called
// via jsp with extend mode on, and returns with it on. Include the file where
// it is not executed, since its tables and data words follow its code.

local bcdInX, bcdOutX, bcdP, pwRtn, pwList, pwP, pwLeft, pwAdded, pwFirst, \
    pwC, pwCell, pwFail, ptX, ptK, ptW, ptC, ptNext, ptBlank, ptPut

// toBcd -- convert the ASCII character in IO (its low 7 bits) to its BCD
// code. Lower case folds to upper; ? and ! read as a period, : and ; as a
// comma, and anything else BCD lacks as a blank.
// AC is the result, IO is preserved.
// Called via jsp.
toBcd, dap bcdInX
    lai
    and [0177]
    add [bcdIn:.]
    dac bcdP
    lac i bcdP
bcdInX, jmp .

// toAscii -- convert the BCD code in IO (its low 6 bits) to its ASCII
// character; a code BCD leaves undefined is a blank.
// AC is the result, IO is preserved.
// Called via jsp.
toAscii, dap bcdOutX
    lai
    and [077]
    add [bcdOut:.]
    dac bcdP
    lac i bcdP
bcdOutX, jmp .

// packWord -- add a word to the bottom of list IO as cells, six BCD
// characters a cell, the last blank-filled, every cell but the last flagged
// continued. A word of no characters is one blank cell.
// IO is the list. pwSrc holds the full address of the first character, one
// BCD code a word, and pwLen the number of characters.
// Skips with the word's first cell in AC. Does not skip when the cells run
// out, with the cells it added taken off again.
// AC is the result, IO is not preserved. datHi, datLo and datFlg are
// changed; pwSrc and pwLen are preserved.
// Called via jsp.
packWord, dac pwRtn
    dio pwList
    lac pwSrc
    dac pwP
    lac pwLen
    dac pwLeft
    dzm pwAdded
    dzm pwFirst
pwCell, jsp pwThree
    dac datHi
    jsp pwThree
    dac datLo
    lac pwLeft
    SKIP_NEXT_IF_AC_ZERO
    lac [FCONT]             // characters remain, so the word goes on
    dac datFlg
    lio pwList
    jsp NEWBOT
    jmp pwFail
    dac pwC
    lac pwFirst
    SKIP_NEXT_IF_AC_NOT_ZERO
    lac pwC
    dac pwFirst
    idx pwAdded
    lac pwLeft
    SKIP_NEXT_IF_AC_ZERO
    jmp pwCell
    idx pwRtn
    lac pwFirst
    jmp i pwRtn
pwFail, lac pwAdded
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i pwRtn
    sub [1]
    dac pwAdded
    lio pwList
    jsp POPBOT
    nop                     // never empty here, so both returns go on
    jmp pwFail

// pwThree -- return the word's next three characters, the first in the high
// bits, with a blank for each past the word's end; pwP and pwLeft step past
// them.
// AC is the result, IO is not preserved.
// Called via jsp.
pwThree, dap ptX
    law i 3
    dac ptK
    dzm ptW
ptNext, lac pwLeft
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ptBlank
    sub [1]
    dac pwLeft
    lac i pwP
    and [077]
    dac ptC
    idx pwP
    jmp ptPut
ptBlank, law BCDBLANK
    dac ptC
ptPut, lac ptW
    ral 6s                  // not sal, which loses the top bit of a code of 040 up
    ior ptC
    dac ptW
    isp ptK
    jmp ptNext
    lac ptW
ptX, jmp .

bcdP, 0
pwRtn, 0
pwList, 0
pwP, 0
pwLeft, 0
pwAdded, 0
pwFirst, 0
pwC, 0
ptK, 0
ptW, 0
ptC, 0
endloc

pwSrc, 0
pwLen, 0

