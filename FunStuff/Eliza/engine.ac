// ymatch -- YMATCH (S009880) as Hay's match, the input's nIn words against
// the pattern's nPat elements. The pattern is cut into segments, each starting at
// a 0; a 0 starting a segment other than the last takes the fewest words that
// let the segment match, the last segment ends at the input's end, and there
// is no further backtracking. A number n takes n words; a word or a sublist,
// one. Each element's part, its first word and its count, goes into partS
// and partN.
// Skips on a match.
// Does not preserve AC or IO; datHi and datLo are changed.
// Called via jsp.
local ymRtn, ymW, ymP, ymP0, ymFix, ymRoom, ymWild, ymWl, ymWend, ymQ, \
    ymX, ymT, ymT2, ymOk2, ymSeg, ymScan, ymN, ymOne, ymStep, ymScanned, ymWildMid, \
    ymNotWild, ymTry, ymEl, ymLit, ymPart, ymElNext, ymOk, ymNext, ymEnd, \
    ymFail
ymatch, dac ymRtn
    dzm ymW
    dzm ymP
ymSeg, lac ymP
    SKIP_NEXT_IF_DIFFERENT nPat
    jmp ymEnd
    dac ymP0
    dzm ymFix
ymScan, lac ymP             // the segment, to the next 0 or the end
    SKIP_NEXT_IF_DIFFERENT nPat
    jmp ymScanned
    lio ymP
    jsp elemAt
    lac eaK
    SKIP_NEXT_IF_SAME [KNUM]
    jmp ymOne
    lac eaV
    SKIP_NEXT_IF_AC_ZERO
    jmp ymN
    lac ymP
    SKIP_NEXT_IF_DIFFERENT ymP0
    jmp ymStep              // the 0 this segment starts at
    jmp ymScanned
ymN, SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp ymOne
    add ymFix
    dac ymFix
    jmp ymStep
ymOne, idx ymFix
ymStep, idx ymP
    jmp ymScan
ymScanned, lac nIn
    sub ymW
    sub ymFix
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp ymFail
    dac ymRoom              // the words a starting 0 may take
    dzm ymWild
    dzm ymWl
    dzm ymWend
    lio ymP0
    jsp elemAt
    lac eaK
    SKIP_NEXT_IF_SAME [KNUM]
    jmp ymTry
    lac eaV
    SKIP_NEXT_IF_AC_ZERO
    jmp ymTry
    law 1
    dac ymWild
    lac ymRoom
    dac ymWend
    lac ymP
    SKIP_NEXT_IF_SAME nPat
    jmp ymTry               // not the last segment, so fewest words first
    lac ymRoom
    dac ymWl                // the last, to the input's end
ymTry, lac ymP0
    add ymWild
    dac ymQ
    lac ymW
    add ymWl
    dac ymX
ymEl, lac ymQ
    SKIP_NEXT_IF_DIFFERENT ymP
    jmp ymOk
    lio ymQ
    jsp elemAt
    lac eaK
    SKIP_NEXT_IF_SAME [KNUM]
    jmp ymLit
    lac eaV
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp ymNext              // a negative number matches nothing
    jmp ymPart
ymLit, lio ymX
    jsp elMatch
    jmp ymNext
    law 1
ymPart, dac ymT             // element ymQ takes ymT words from ymX
    lac ymQ
    add [partS:1]
    dac ymT2
    lac ymX
    dac i ymT2
    lac ymQ
    add [partN:1]
    dac ymT2
    lac ymT
    dac i ymT2
    lac ymX
    add ymT
    dac ymX
ymElNext, idx ymQ
    jmp ymEl
ymOk, lac ymWild
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ymOk2
    lac ymP0
    add [partS:1]
    dac ymT2
    lac ymW
    dac i ymT2
    lac ymP0
    add [partN:1]
    dac ymT2
    lac ymWl
    dac i ymT2
ymOk2, lac ymX
    dac ymW
    jmp ymSeg
ymNext, lac ymWl
    SKIP_NEXT_IF_DIFFERENT ymWend
    jmp ymFail
    idx ymWl
    jmp ymTry
ymEnd, lac ymW
    SKIP_NEXT_IF_SAME nIn
    jmp ymFail
    idx ymRtn
ymFail, jmp i ymRtn

ymRtn, 0
ymW, 0
ymP, 0
ymP0, 0
ymFix, 0
ymRoom, 0
ymWild, 0
ymWl, 0
ymWend, 0
ymQ, 0
ymX, 0
ymT, 0
ymT2, 0
endloc

