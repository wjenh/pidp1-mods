asOut, 0                    // the list being assembled

// tryEs -- try decomposition list IO. Its pattern is matched against the
// input and, on a match, its next reassembly rule is chosen by the counter,
// the parts left in partS and partN for ASSMBL. The counter is the listing's
// (L001510-001720), a number cell put after the pattern the first time it
// matches, holding the rule last used; the rules come in turn, then from the
// first again. Out of cells, it goes to noCells.
// Does not skip when the pattern does not match. Skips with the reassembly
// rule's list in AC, or 0 when there is no rule.
// AC is the result, IO is not preserved; datHi, datLo and datFlg are changed.
// Called via jsp.
local teRtn, teEs, tePc, teCc, teC, teUse, teR, teNew, teFind, teWalk, \
    teWrap, teGot, teFail
tryEs, dac teRtn
    dio teEs
    jsp itemNext
    jmp i teRtn
    dio tePc
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i teRtn
    lio ixLo
    jsp patLoad
    jmp i teRtn
    jsp ymatch
    jmp i teRtn
    idx teRtn               // matched
    lio tePc
    jsp itemNext
    jmp teNew
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_ZERO
    jmp teNew
    lac ixHi
    SKIP_NEXT_IF_AC_ZERO
    jmp teNew
    lac ixCell
    dac teCc
    lac ixLo
    dac teC
    jmp teFind
teNew, dzm datHi
    dzm datLo
    dzm datFlg
    lio tePc
    jsp NEWTOP
    jmp noCells
    dac teCc
    dzm teC
teFind, dzm teUse           // the rule after the one last used
    lac teCc
    dac teR
teWalk, lio teR
    jsp itemNext
    jmp teWrap
    dio teR
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp teWalk
    lac teUse
    SKIP_NEXT_IF_DIFFERENT teC
    jmp teGot
    idx teUse
    jmp teWalk
teWrap, lac teC
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp teFail              // no rule at all
    dzm teC                 // past the last, so the first again
    jmp teFind
teGot, lac ixLo
    dac teR
    dzm datHi
    lac teUse
    add [1]
    dac datLo
    dzm datFlg
    lio teCc
    jsp SUBST
    lac teR
    jmp i teRtn
teFail, cla
    jmp i teRtn

teRtn, 0
teEs, 0
tePc, 0
teCc, 0
teC, 0
teUse, 0
teR, 0
