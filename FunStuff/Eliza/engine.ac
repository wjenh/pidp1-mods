    jmp tpGo
txtAll, dac tpRtn
    law TPALL
    jmp tpGo
txtRun, dac tpRtn
    law TPRUN
    jmp tpGo
txtOne, dac tpRtn
    law TPONE
tpGo, dac tpMode
    dio tpR
    dzm tpCol
    dzm tpDep
    dzm tpCnt
tpLoop, lio tpR
    jsp itemNext
    jmp tpClose
    dio tpNx
    lac tpDep               // inside a sublist every item prints
    SKIP_NEXT_IF_AC_ZERO
    jmp tpTake
    lac tpMode              // at the top, where txtRun and txtOne stop
    and [TPONEBIT]
    SKIP_NEXT_IF_AC_ZERO
    jmp tpOneChk
    lac tpMode
    and [TPRUNBIT]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tpCount
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_ZERO
    jmp tpEnd               // the reader stays before the sublist
tpCount, idx tpCnt
tpTake, lac tpNx
    dac tpR
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tpAtom
    lac tpMode
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tpLoop              // a reply prints no sublist
    lac tpDep
    SKIP_NEXT_IF_DIFFERENT [DEPTHMAX]
    jmp tpLoop              // deeper than rdList reads, so not printed
    add [tpStk:1]
    dac tpT
    lac tpR
    dac i tpT
    idx tpDep
    lac ixLo
    dac tpR
    law BCDLPAR
    jmp tpTok
tpOneChk, lac tpCnt
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tpCount
    jmp tpEnd
tpClose, lac tpDep          // at a list's end the enclosing list goes on
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tpEnd
    sub [1]
    dac tpDep
    add [tpStk:1]
    dac tpT
    lac i tpT
    dac tpR
    law BCDRPAR
tpTok, dac i [tpBuf:1]      // ( or ), a word of one character
    law 1
    dac tpLen
    jmp tpWord
tpAtom, lac ixHi
    SKIP_NEXT_IF_AC_ZERO
    jmp tpUnpk
    lac tpMode
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tpLoop              // a reply prints no number
tpUnpk, lio ixCell
    jsp unpack
tpWord, lac tpLen
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tpLoop
    lac [ROOM]
    sub tpLen
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp tpLong
    lac tpCol
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tpChars
    add tpLen
    add [1]
    dac tpT
    lac [ROOM]
    sub tpT
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp tpBlank
    jsp newline             // it does not fit after a blank
    dzm tpCol
    jmp tpChars
tpBlank, lio [040]
    jsp putc
    idx tpCol
    jmp tpChars
tpLong, lac tpCol
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tpChars
    jsp newline
    dzm tpCol
tpChars, dzm tpI
tpCh, lac tpI
    SKIP_NEXT_IF_DIFFERENT tpLen
    jmp tpLoop
    lac tpCol
    SKIP_NEXT_IF_SAME [ROOM]
    jmp tpPut
    jsp newline             // a long word goes on on the next line
    dzm tpCol
tpPut, lac tpI
    add [tpBuf:1]
    dac tpT
    lio i tpT
    jsp toAscii
    lia
    jsp putc
    idx tpCol
    idx tpI
    jmp tpCh
tpEnd, jsp newline
    lio tpR
    jmp i tpRtn

tpRtn, 0
tpR, 0
tpNx, 0
tpCol, 0
tpI, 0
tpT, 0
tpMode, 0                   // 0 for a reply, else TPALL, TPRUN or TPONE
tpDep, 0                    // sublists open, their readers in tpStk
tpCnt, 0                    // top-level items printed
endloc

// unpack -- put the characters of the word whose first cell is IO into
// tpBuf, one BCD code a word, blanks left out, and their number into tpLen.
// Does not preserve AC or IO; datHi and datLo are changed.
// Called via jsp.
local upX, upC, upF, upCell, u3X, u3W, u3K, u3C, u3T, u3L, u3N, up3
unpack, dap upX
    dio upC
    dzm tpLen
upCell, lio upC
    jsp rdCell
    and [FCONT]
    dac upF
    lac datHi
    dac u3W
    jsp up3
    lac datLo
    dac u3W
    jsp up3
    lac upF
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp upX
    lio upC
    jsp cellPtrs
    lac i cp1
    dac upC
    jmp upCell
upX, jmp .

// up3 -- add the three characters of u3W, the first in its high bits, to
// tpBuf, blanks left out.
// Does not preserve AC or IO.
// Called via jsp, from unpack only.
up3, dap u3X
    law i 3
    dac u3K
u3L, lac u3W
    ral 6s
    dac u3W
    and [077]
    SKIP_NEXT_IF_DIFFERENT [BCDBLANK]
    jmp u3N
    dac u3C
    lac tpLen
    add [tpBuf:1]
    dac u3T
    lac u3C
    dac i u3T
    idx tpLen
u3N, isp u3K
    jmp u3L
u3X, jmp .

upC, 0
upF, 0
u3W, 0
u3K, 0
u3C, 0
u3T, 0
endloc

tpLen, 0                    // the characters in tpBuf

// The conversation's state, set by the program when a script is read.
inList, 0                   // INPUT
myList, 0                   // the memory queue, each cell a reply, a sublist
limit, 0                    // LIMIT, 1 to 4
