// engine.ac -- the ELIZA 1965 engine, TREAD, the keyword scan and choice, the
// memory, the matching routine, YMATCH, ASSMBL and TXTPRT, as the 1965
// listing (L000470-002270) and SLIP-1965.mad run them, with the 1966 paper's
// keystack, NEWKEY, PRE and (= KW) as a reassembly rule as Hay reconstructs
// them.
//
// Needs eliza.ah, AIDS/skipmacros.ah, lists.ac, bcd.ac, hash.ac, script.ac
// (keyTab, memKwHi, memKwLo, myTran, chClass) and dcsio.ac, and noCells, where
// a routine goes when the cells run out. The conversation ends there, so
// nothing here returns without a cell. Every routine is called via jsp with
// extend mode on, from bank 0. Include the file where it is not executed,
// since each routine's data words follow its code. The arrays are in bank 1.
//
// INPUT (inList) holds the input's words as cells, a word's every cell but its
// last flagged continued; a DLIST cell (eliza.ah, DLMARK) may follow a word.

// itemNext -- step reader IO to the next item of the list it is in, a word,
// its cells passed over, a number or a sublist.
// Skips with IO the reader at the item's last cell, ixCell its first cell,
// ixFl that cell's flags (FSUB for a sublist, its header in ixLo), and ixHi
// and ixLo its datum (ixHi 0 for a number, in ixLo). Does not skip at the
// list's end.
// IO is the result, AC is not preserved; datHi and datLo are changed.
// Called via jsp.
local inxRtn, inxF, inxLoop, inxDone
itemNext, dac inxRtn
    jsp SEQLR
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp i inxRtn            // back at the header
    dac ixFl
    dac inxF
    dio ixCell
    lac datHi
    dac ixHi
    lac datLo
    dac ixLo
inxLoop, lac inxF
    and [FCONT]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp inxDone
    jsp SEQLR
    dac inxF
    jmp inxLoop
inxDone, idx inxRtn
    jmp i inxRtn

inxRtn, 0
inxF, 0
endloc

ixCell, 0
ixFl, 0
ixHi, 0
ixLo, 0

// cmpWords -- compare the word whose first cell is IO with the word whose
// first cell is cwB, cell by cell, datum and continued flag.
// Skips when they are the same word.
// Does not preserve AC or IO; cwB, datHi and datLo are changed.
// Called via jsp.
local cwRtn, cwA, cwF, cwHi, cwLo, cwLoop, cwSame
cmpWords, dac cwRtn
    dio cwA
cwLoop, lio cwB
    jsp rdCell
    and [FCONT]
    dac cwF
    lac datHi
    dac cwHi
    lac datLo
    dac cwLo
    lio cwA
    jsp rdCell
    and [FCONT]
    SKIP_NEXT_IF_SAME cwF
    jmp i cwRtn
    lac datHi
    SKIP_NEXT_IF_SAME cwHi
    jmp i cwRtn
    lac datLo
    SKIP_NEXT_IF_SAME cwLo
    jmp i cwRtn
    lac cwF
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp cwSame
    lio cwA
    jsp cellPtrs
    lac i cp1
    dac cwA
    lio cwB
    jsp cellPtrs
    lac i cp1
    dac cwB
    jmp cwLoop
cwSame, idx cwRtn
    jmp i cwRtn

cwRtn, 0
cwA, 0
cwF, 0
cwHi, 0
cwLo, 0
endloc

cwB, 0

// findRule -- the listing's keyword lookup (L000790-000850). It finds the
// first rule in bucket HASH(frHi frLo, 5) whose first cell is frHi, frLo.
// With frWord not 0, it finds the first whose keyword is the whole word at
// frWord, as Hay's lookup does; every exit clears frWord.
// Returns the rule's list in AC, 0 for none.
// AC is the result, IO is not preserved; datHi, datLo and cwB are changed.
// Called via jsp.
local frRtn, frT, frR, frRule, frLoop, frFound, frNone
findRule, dac frRtn
    lac frHi
    dac datHi
    lac frLo
    dac datLo
    lio [5]
    jsp HASH
    add [keyTab]
    dac frT
    lac i frT
    dac frR
frLoop, lio frR
    jsp SEQLR
    dio frR
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp frNone
    lac datLo               // a bucket's cells are its rules' sublists
    dac frRule
    lio frRule
    jsp TOP
    jmp frLoop
    and [FSUB]
    SKIP_NEXT_IF_AC_ZERO
    jmp frLoop
    lac datHi
    SKIP_NEXT_IF_SAME frHi
    jmp frLoop
    lac datLo
    SKIP_NEXT_IF_SAME frLo
    jmp frLoop
    lac frWord
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp frFound
    lio frRule              // for the whole word, the keyword is compared too
    jsp itemNext
    jmp frLoop
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_ZERO
    jmp frLoop
    lac ixCell
    dac cwB
    lio frWord
    jsp cmpWords
    jmp frLoop
frFound, dzm frWord
    lac frRule
    jmp i frRtn
frNone, dzm frWord
    cla
    jmp i frRtn

frRtn, 0
frT, 0
frR, 0
frRule, 0
endloc

frHi, 0
frLo, 0
frWord, 0                   // a word's first cell, for a whole-word lookup
wholeKw, 0                  // not 0 when the scan looks keywords up by the whole word

// copyWord -- put a copy of the word whose first cell is IO at the bottom of
// list asOut. Out of cells, it goes to noCells.
// Does not preserve AC or IO; datHi, datLo and datFlg are changed.
// Called via jsp.
local cpwX, cpwC, cpwF, cpwLoop
copyWord, dap cpwX
    dio cpwC
cpwLoop, lio cpwC
    jsp rdCell
    and [FCONT]
    dac datFlg
    dac cpwF
    lio asOut
    jsp NEWBOT
    jmp noCells
    lac cpwF
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp cpwX
    lio cpwC
    jsp cellPtrs
    lac i cp1
    dac cpwC
    jmp cpwLoop
cpwX, jmp .

cpwC, 0
cpwF, 0
endloc

// tread -- TREAD (S001083 on), here reading the line in lnBuf into INPUT,
// which is emptied first. Letters, apostrophes and digits make up words; a
// blank, ( and ) end one; = + - $ * / . and , are each a word by itself.
// Does not preserve AC or IO; datHi, datLo and datFlg are changed.
// Called via jsp.
local trRtn, trP, trEnd, trC, trT, trLoop, trDone, trAdd, trOne, trEndW, \
    tfX, trFlush
tread, dac trRtn
    lio inList
    jsp MTLIST
    dzm twLen
    lac [lnBuf:1]
    dac trP
    add lnLen
    dac trEnd
trLoop, lac trP
    SKIP_NEXT_IF_DIFFERENT trEnd
    jmp trDone
    lio i trP
    idx trP
    jsp toBcd
    dac trC
    add [chClass]
    dac trT
    lac i trT
    SKIP_NEXT_IF_DIFFERENT [C_LETTER]
    jmp trAdd
    SKIP_NEXT_IF_DIFFERENT [C_APOS]
    jmp trAdd
    SKIP_NEXT_IF_DIFFERENT [C_DIGIT]
    jmp trAdd
    SKIP_NEXT_IF_DIFFERENT [C_BLANK]
    jmp trEndW
    SKIP_NEXT_IF_DIFFERENT [C_LPAR]
    jmp trEndW
    SKIP_NEXT_IF_DIFFERENT [C_RPAR]
    jmp trEndW
trOne, jsp trFlush          // a word by itself
    lac trC
    dac i [twBuf:1]
    law 1
    dac twLen
trEndW, jsp trFlush
    jmp trLoop
trAdd, lac twLen
    add [twBuf:1]
    dac trT
    lac trC
    dac i trT
    idx twLen
    jmp trLoop
trDone, jsp trFlush
    jmp i trRtn

// trFlush -- put the word going, if any, at the bottom of INPUT.
// Does not preserve AC or IO.
// Called via jsp, from tread only.
trFlush, dap tfX
    lac twLen
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp tfX
    lac [twBuf:1]
    dac pwSrc
    lac twLen
    dac pwLen
    dzm twLen
    lio inList
    jsp packWord
    jmp noCells
tfX, jmp .

trRtn, 0
trP, 0
trEnd, 0
trC, 0
trT, 0
endloc

twLen, 0                    // the characters of the word going, in twBuf

// substWord -- TESTS' substitution. The input word whose first cell is wCell
// is replaced by a copy of the word whose first cell is sbSrc; wCell and
// wLast are left at the copy's first and last cells. Out of cells, it goes to
// noCells.
// Does not preserve AC or IO; sbSrc, datHi, datLo and datFlg are changed.
// Called via jsp.
local sbX, sbP, sbQ, sbF, sbDrop, sbAdd, sbDone
substWord, dap sbX
    lio wCell
    jsp LNKL
    dac sbP                 // the cell before the word
sbDrop, lio sbP
    jsp POPTOP              // the cell after sbP
    nop                     // never empty here, so both returns go on
    and [FCONT]
    SKIP_NEXT_IF_AC_ZERO
    jmp sbDrop
    lac sbP
    dac sbQ
sbAdd, lio sbSrc
    jsp rdCell
    and [FCONT]
    dac datFlg
    dac sbF
    lio sbQ
    jsp NEWTOP
    jmp noCells
    dac sbQ
    lac sbF
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp sbDone
    lio sbSrc
    jsp cellPtrs
    lac i cp1
    dac sbSrc
    jmp sbAdd
sbDone, lio sbP
    jsp cellPtrs
    lac i cp1
    dac wCell
    lac sbQ
    dac wLast
sbX, jmp .

sbP, 0
sbQ, 0
sbF, 0
endloc

sbSrc, 0

// respond -- print the reply to the input in INPUT, which is not empty. It
// runs the scan (L000600-001100), then the memory, the matching routine and
// the built-in messages (L001120-002270), with the 1966 keystack as Hay's
// eliza::response has it. Each keyword with something after its keyword,
// substitution and rank goes on the keystack, to the top when its rank beats
// the best so far, else to the bottom, so the top is the keyword 1965 chose.
// Then the top is popped, a memory formed if it is the memory keyword, and
// its decompositions tried in order. (NEWKEY) pops the next, NONE when there
// is none; (= KW), as a decomposition or a reassembly, puts KW's rule on top;
// (PRE (r) (= KW)) makes the input r assembled, then puts KW's rule on top.
// Does not preserve AC or IO; datHi, datLo and datFlg are changed.
// Called via jsp.
local rpRtn, scR, cand, rrd, rr2, rr3, prednc, scPos, scRk, wHi, wLo, sdC, \
    mlRule, mlR, mlEs, rpOut, rpT, rpRa, rpNew, scLoop, scNotDelim, scNext, \
    scDl, scChoose, scPush, scFront, scDelim, scLeft, scRight, scEnd, rpPop, \
    mlLoop, mlTry, rpLink, rpNewkey, rpPre, rpPreBad, rpSay, rpNone, \
    rpNoneRule, rpBuiltin
respond, dac rpRtn
    law KSMID
    dac ksLo
    dac ksHi
    dzm prednc
    dzm links
    lac inList
    dac scR
scLoop, lio scR
    jsp SEQLR
    dio scR
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp scEnd
    lac datHi
    SKIP_NEXT_IF_DIFFERENT [DLMARK]
    jmp scLoop
    lac scR
    dac wCell
    lac datHi
    dac wHi                 // the word's first cell
    lac datLo
    dac wLo
    SKIP_NEXT_IF_SAME [BLANKLO]
    jmp scNotDelim
    lac datHi
    SKIP_NEXT_IF_DIFFERENT [PERIODHI]
    jmp scDelim
    SKIP_NEXT_IF_DIFFERENT [COMMAHI]
    jmp scDelim
    SKIP_NEXT_IF_DIFFERENT [BUTHI]
    jmp scDelim
scNotDelim, lac wHi
    dac frHi
    lac wLo
    dac frLo
    lac wholeKw
    SKIP_NEXT_IF_AC_ZERO
    lac wCell
    dac frWord
    jsp findRule
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp scNext
    dac cand
    lio cand                // in TESTS, the rule's keyword must be the word
    jsp itemNext
    jmp scNext
    dio rrd
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_ZERO
    jmp scNext
    lac ixCell
    dac cwB
    lio wCell
    jsp cmpWords
    jmp scNext
    lio wCell
    jsp wordLast
    dac wLast
    lio rrd                 // = and a word, which replaces the input's
    jsp itemNext
    jmp scDl
    dio rr2
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_ZERO
    jmp scDl
    lac ixHi
    SKIP_NEXT_IF_SAME [EQHI]
    jmp scDl
    lac ixLo
    SKIP_NEXT_IF_SAME [BLANKLO]
    jmp scDl
    lio rr2
    jsp itemNext
    jmp scDl
    dio rr3
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_ZERO
    jmp scDl
    lac ixHi
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp scDl                // a number
    lac rr3
    dac rrd
    lac ixCell
    dac sbSrc
    jsp substWord
scDl, lio cand              // the rule's DLIST goes into INPUT after the word
    jsp LSTNAM
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp scChoose
    dac datLo
    lac [DLMARK]
    dac datHi
    dzm datFlg
    lio wLast
    jsp NEWTOP
    jmp noCells
scChoose, lac wLast
    dac scR
    lio rrd
    jsp itemNext
    jmp scLoop              // a keyword with nothing after it
    dio rr2
    dzm scRk
    lac rrd
    dac scPos
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_ZERO
    jmp scPush              // a decomposition, so no rank
    lac ixHi
    SKIP_NEXT_IF_AC_ZERO
    jmp scPush              // a word, so no rank
    lac ixLo                // a rank, which something must follow
    dac scRk
    lac rr2
    dac scPos
    lio rr2
    jsp itemNext
    jmp scLoop
scPush, lac scRk
    sub prednc
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp scFront
    lac ksHi                // to the bottom
    add [ksRule:1]
    dac rpT
    lac cand
    dac i rpT
    lac ksHi
    add [ksPos:1]
    dac rpT
    lac scPos
    dac i rpT
    idx ksHi
    jmp scLoop
scFront, lac scRk           // to the top, the best so far
    dac prednc
    lac cand
    dac ksNewR
    lac scPos
    dac ksNewP
    jsp ksFront
    jmp scLoop
scNext, lio wCell
    jsp wordLast
    dac scR
    jmp scLoop

scDelim, lac ksLo
    SKIP_NEXT_IF_SAME ksHi
    jmp scRight
scLeft, lio inList          // no keyword yet, so INPUT up to the delimiter goes
    jsp SEQLR
    dio sdC
    lio inList
    jsp POPTOP
    nop
    lac sdC
    SKIP_NEXT_IF_SAME wCell
    jmp scLeft
    lac inList
    dac scR
    jmp scLoop
scRight, lio inList         // a keyword, so INPUT from the delimiter on goes
    jsp LNKL
    dac sdC
    lio inList
    jsp POPBOT
    nop
    lac sdC
    SKIP_NEXT_IF_SAME wCell
    jmp scRight

scEnd, jsp buildWords
    lac ksLo
    SKIP_NEXT_IF_DIFFERENT ksHi
    jmp rpNone

rpPop, lac ksLo             // the top keyword
    SKIP_NEXT_IF_DIFFERENT ksHi
    jmp rpBuiltin           // not reached, since every pop ends in a reply or a push
    add [ksRule:1]
    dac rpT
    lac i rpT
    dac mlRule
    lac ksLo
    add [ksPos:1]
    dac rpT
    lac i rpT
    dac mlR
    idx ksLo
    lio mlRule              // the memory keyword makes a memory of the input as it is
    jsp TOP
    jmp mlLoop
    and [FSUB]
    SKIP_NEXT_IF_AC_ZERO
    jmp mlLoop
    lac datHi
    SKIP_NEXT_IF_SAME memKwHi
    jmp mlLoop
    lac datLo
    SKIP_NEXT_IF_SAME memKwLo
    jmp mlLoop
    jsp remember
mlLoop, lio mlR             // the keyword's decompositions in order
    jsp itemNext
    jmp rpBuiltin
    dio mlR
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp mlLoop
    lac ixLo
    dac mlEs
    lio mlEs                // (= KW) puts KW's rule on top
    jsp TOP
    jmp mlTry
    and [FSUB]
    SKIP_NEXT_IF_AC_ZERO
    jmp mlTry
    lac datHi
    SKIP_NEXT_IF_SAME [EQHI]
    jmp mlTry
    lac datLo
    SKIP_NEXT_IF_SAME [BLANKLO]
    jmp mlTry
    lio mlEs
    jsp itemNext
    jmp rpBuiltin
    jsp itemNext
    jmp rpBuiltin
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_ZERO
    jmp rpBuiltin
    lac ixHi
    dac frHi
    lac ixLo
    dac frLo
rpLink, jsp pushKw
    jmp rpBuiltin
    jmp rpPop
mlTry, lio mlEs
    jsp tryEs
    jmp mlLoop
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rpBuiltin           // a pattern with no reassembly
    dac rpRa
    lio rpRa
    jsp raKind
    SKIP_NEXT_IF_DIFFERENT [RANEWKEY]
    jmp rpNewkey
    SKIP_NEXT_IF_DIFFERENT [RALINK]
    jmp rpLink
    SKIP_NEXT_IF_DIFFERENT [RAPRE]
    jmp rpPre
    lio rpRa                // a reply
    jsp assmbl
    jmp rpBuiltin
rpSay, dac rpOut
    lio rpOut
    jsp txtprt
    lio rpOut
    jsp IRALST
    jmp i rpRtn

rpNewkey, lac ksLo          // (NEWKEY) takes the next keyword, NONE if none is left
    SKIP_NEXT_IF_DIFFERENT ksHi
    jmp rpNoneRule
    jmp rpPop

rpPre, lio raPre            // (PRE (r) (= KW)) makes the input r assembled
    jsp assmblDl
    jmp rpBuiltin
    dac rpNew
    jsp pushKw
    jmp rpPreBad
    lio inList
    jsp IRALST
    lac rpNew
    dac inList
    jsp buildWords
    jmp rpPop
rpPreBad, lio rpNew
    jsp IRALST
    jmp rpBuiltin

rpNone, lac limit           // no keyword, so a memory at LIMIT 4, else NONE
    SKIP_NEXT_IF_SAME [4]
    jmp rpNoneRule
    lio myList
    jsp POPTOP
    jmp rpNoneRule
    lac datLo
    jmp rpSay
rpNoneRule, lio keyTab+NBUCKETS
    jsp TOP
    jmp rpBuiltin
    and [FSUB]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rpBuiltin
    lio datLo
    jsp BOT                 // NONE's last decomposition
    jmp rpBuiltin
    and [FSUB]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rpBuiltin
    lio datLo
    jsp tryEs
    jmp rpBuiltin
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rpBuiltin
    lia
    jsp assmbl
    jmp rpBuiltin
    jmp rpSay

rpBuiltin, lac limit        // the built-in messages, by LIMIT
    add [nmTab-1]
    dac rpT
    lio i rpT
    jsp putAsc
    jsp newline
    jmp i rpRtn

rpRtn, 0
scR, 0
cand, 0
rrd, 0
rr2, 0
rr3, 0
prednc, 0
scPos, 0
scRk, 0
wHi, 0
wLo, 0
sdC, 0
mlRule, 0
mlR, 0
mlEs, 0
rpOut, 0
rpT, 0
rpRa, 0
rpNew, 0
endloc

// The keystack's state for the reply going; the entries are ksRule and ksPos.
ksLo, 0                     // the top entry
ksHi, 0                     // one past the bottom; ksLo = ksHi when empty
ksNewR, 0                   // ksFront's entry, the rule
ksNewP, 0                   // and the reader
links, 0                    // links followed in this reply
raPre, 0                    // a PRE's r, set by raKind

// ksFront -- put the entry ksNewR, ksNewP on top of the keystack.
// AC is not preserved, IO is preserved.
// Called via jsp.
local kfX, kfT
ksFront, dap kfX
    lac ksLo
    sub [1]
    dac ksLo
    add [ksRule:1]
    dac kfT
    lac ksNewR
    dac i kfT
    lac ksLo
    add [ksPos:1]
    dac kfT
    lac ksNewP
    dac i kfT
kfX, jmp .

kfT, 0
endloc

// pushKw -- put the rule of the keyword whose first cell is frHi, frLo
// (findRule) on top of the keystack, its decompositions read from its header.
// A reply follows at most LINKMAX links, so a script whose links loop cannot
// hang.
// Skips; does not skip when the rule is not found or the links are spent.
// Does not preserve AC or IO; datHi and datLo are changed.
// Called via jsp.
local pkRtn
pushKw, dac pkRtn
    idx links
    sub [LINKMAX+1]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i pkRtn
    jsp findRule
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i pkRtn
    dac ksNewR
    dac ksNewP
    jsp ksFront
    idx pkRtn
    jmp i pkRtn

pkRtn, 0
endloc

// raKind -- tell what reassembly rule IO (its list) is, by Hay's shapes,
// (NEWKEY), (= KW), (PRE (r) (= KW)), else a reply. NEWKEY, = and PRE are
// compared whole, one cell each.
// Returns RAREPLY, RANEWKEY, RALINK or RAPRE in AC. For RALINK and RAPRE,
// frHi and frLo are KW's first cell, and for RAPRE raPre is r's list.
// AC is the result, IO is not preserved; datHi and datLo are changed.
// Called via jsp.
local rkRtn, rkR, rkK, rkL, rkNew, rkEq, rkKw, rkPreEq, rkGot, rkGot0, rkReply
raKind, dac rkRtn
    jsp itemNext
    jmp rkReply             // an empty rule
    dio rkR
    lac ixFl
    and [FSUB+FCONT]
    SKIP_NEXT_IF_AC_ZERO
    jmp rkReply             // a sublist or a long word first
    lac ixHi
    SKIP_NEXT_IF_DIFFERENT [NEWKEYHI]
    jmp rkNew
    SKIP_NEXT_IF_DIFFERENT [EQHI]
    jmp rkEq
    SKIP_NEXT_IF_SAME [PREHI]
    jmp rkReply
    lac ixLo                // PRE, a list, a list, nothing more
    SKIP_NEXT_IF_SAME [BLANKLO]
    jmp rkReply
    lio rkR
    jsp itemNext
    jmp rkReply
    dio rkR
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rkReply
    lac ixLo
    dac raPre
    lio rkR
    jsp itemNext
    jmp rkReply
    dio rkR
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rkReply
    lac ixLo
    dac rkL
    lio rkR
    jsp itemNext
    jmp rkPreEq
    jmp rkReply
rkPreEq, lio rkL            // the last list, = and KW
    jsp itemNext
    jmp rkReply
    dio rkR
    lac ixFl
    and [FSUB+FCONT]
    SKIP_NEXT_IF_AC_ZERO
    jmp rkReply
    lac ixHi
    SKIP_NEXT_IF_SAME [EQHI]
    jmp rkReply
    lac ixLo
    SKIP_NEXT_IF_SAME [BLANKLO]
    jmp rkReply
    law RAPRE
    dac rkK
    jmp rkKw
rkNew, lac ixLo             // NEWKEY, nothing more
    SKIP_NEXT_IF_SAME [NEWKEYLO]
    jmp rkReply
