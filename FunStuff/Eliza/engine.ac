assmbl, dac asRtn
    cla
asGo, dac asKeep
    dio asR
    jsp LIST
    jmp noCells
    dac asOut
asLoop, lio asR
    jsp itemNext
    jmp asDone
    dio asR
    lac ixFl
    and [FSUB]
    SKIP_NEXT_IF_AC_ZERO
    jmp asLoop
    lac ixHi
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp asNum
    lio ixCell
    jsp copyWord
    jmp asLoop
asNum, lac ixLo
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp asPart
    jmp asBad
asPart, lac nPat
    sub ixLo
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp asBad
    lac ixLo
    sub [1]
    dac asQ                 // part n is element n-1's
    add [partN:1]
    dac asT
    lac i asT
    dac asN
    lac asQ
    add [partS:1]
    dac asT
    lac i asT
    dac asI
asCopy, lac asN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp asLoop
    lac asI
    add [wFirst:1]
    dac asT
    lio i asT
    jsp copyWord
    lac asKeep
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp asNext
    lac asI
    add [wDl:1]
    dac asT
    lac i asT
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp asNext
    dac datLo
    lac [DLMARK]
    dac datHi
    dzm datFlg
    lio asOut
    jsp NEWBOT
    jmp noCells
asNext, idx asI
    lac asN
    sub [1]
    dac asN
    jmp asCopy
asBad, lio asOut
    jsp IRALST
    jmp i asRtn
asDone, idx asRtn
    lac asOut
    jmp i asRtn

asRtn, 0
asR, 0
asN, 0
asI, 0
asQ, 0
asT, 0
asKeep, 0
