// ttytab.ac -- the typewriter's character tables, for ttyio.ac, from
// Tools/UtilLibs/flexoConversion.c, the emulator's ASCII and FIO-DEC
// (concise) conversion. Include it in bank 1, where it is not executed.

// ttyOut holds, for each ASCII character 040 to 0137, its concise code with
// TTLOWER or TTUPPER for the case it needs, neither for a code with no case,
// and TTNONE for a character the typewriter lacks.
ttyOut,
    0000                    // blank no case
    0205                    // ! upper
    0201                    // " upper
    0204                    // # upper
    0400                    // $ none
    0400                    // % none
    0206                    // & upper
    0202                    // ' upper
    0157                    // ( lower
    0155                    // ) lower
    0273                    // * upper
    0254                    // + upper
    0133                    // , lower
    0154                    // - lower
    0173                    // . lower
    0121                    // / lower
    0120                    // 0 lower
    0101                    // 1 lower
    0102                    // 2 lower
    0103                    // 3 lower
    0104                    // 4 lower
    0105                    // 5 lower
    0106                    // 6 lower
    0107                    // 7 lower
    0110                    // 8 lower
    0111                    // 9 lower
    0400                    // : none
    0400                    // ; none
    0207                    // < upper
    0233                    // = upper
    0210                    // > upper
    0221                    // ? upper
    0140                    // @ lower
    0261                    // A upper
    0262                    // B upper
    0263                    // C upper
    0264                    // D upper
    0265                    // E upper
    0266                    // F upper
    0267                    // G upper
    0270                    // H upper
    0271                    // I upper
    0241                    // J upper
    0242                    // K upper
    0243                    // L upper
    0244                    // M upper
    0245                    // N upper
    0246                    // O upper
    0247                    // P upper
    0250                    // Q upper
    0251                    // R upper
    0222                    // S upper
    0223                    // T upper
    0224                    // U upper
    0225                    // V upper
    0226                    // W upper
    0227                    // X upper
    0230                    // Y upper
    0231                    // Z upper
    0257                    // [ upper
    0220                    // \ upper
    0255                    // ] upper
    0211                    // ^ upper
    0240                    // _ upper

// ttyIn holds, by concise code with 0100 added in upper case, the ASCII
