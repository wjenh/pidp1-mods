    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp .+2
    jmp zsX
    cma
    dac n
loop,
    cli
    jsp pdig
    isp n
    jmp loop
    jmp zsX
n, 0
    endloc
zsX, jmp .
zsN, 0

// Types R's ouN digits from dg through pdig, the highest first.
// AC and IO are clobbered.
// Called via jsp.
rDigs, dap rdX
    local loop, p, n
    lac ouN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp rdX
    cma
    dac n
    lac ouN
    add [dg:.]
    dac p
loop,
    lac p
    sub [1]
    dac p
    lio i p
    jsp pdig
    isp n
    jmp loop
    jmp rdX
p, 0
n, 0
    endloc
rdX, jmp .
