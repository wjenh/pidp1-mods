// fpconv.ac -- PDP-1 FOCAL's decimal conversion: a number read from its
// digits (fpIn), and a number typed under the format %x.yy (fpOut).
//
// Both are exact.
// A literal's value is rounded once to 35 bits, half away from zero, and a
// typed value once to its last digit, half away from zero.
// The arithmetic is on multiword integers (bn, 17-bit limbs, low limb first)
// in place of a table of powers of ten.
// A literal is its digits' integer D times 5^E and 2^E; a typed value is
// M 2^(e-35) times 10^p, the 5^p and 2^p apart.
//
// Characters are ASCII, upper case.
// Goes in bank 1 with fparith.ac, whose words (FA, the hooks, lmTab, mkShl
// and mkShr) it uses, and whose calling rules it keeps.
// Every entry is entered and left with the extend window open.
//
// FOCAL-1C (FOCAL_1C defined) leaves out the two fast paths, fpIn's two-limb
// digits with inFast and fpOut's q2F.
// Every number then goes through bn, with the same result.

// The multiword integer: bnN limbs, the top one nonzero, or none for zero.
bnN, 0
bnL,
    table BN_MAX
bnB, 0                  // bnTo35's bit count
bmM, 0                  // bnMulS's multiplier
baV, 0                  // bnAddS's addend
bdD, 0                  // bnDivS's divisor
bsS, 0                  // bnShl's and bnShr's count
bpP, 0                  // bnPow5's and bnDiv5's power

// 5^0 to 5^7; 5^7 = 78125 is the largest power below 2^17.
// bnPow5 and bnDiv5 take 5^0 to 5^6 from it, q2F all eight.
p5Tab, 1
    5
    0d25
    0d125
    0d625
    0d3125
    0d15625
    0d78125

// bn = M, FA's magnitude.
// AC is clobbered; IO is preserved.
// Called via jsp.
bnLdM, dap blX
    lac fa0
    dac bnL
    lac fa1
    dac bnL+1
    lac fa2
    dac bnL+2
    law 3
    dac bnN
blX, jmp .

// bn = bn times bmM, below 2^17.
// AC and IO are clobbered.
// Called via jsp.
bnMulS, dap bmX
    local loop, nc, done, p, n, c, hi, lo
    lac bnN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp bmX
    cma
    dac n
    dzm c
    lac [bnL:.]
    dac p
loop,
    // limb times bmM plus the carry in, below 2^34.
    // lo is the new limb, hi the carry.
    lac i p
    mul bmM
    dac hi
    dio lo
    lac lo
    rar 1s
    and [0377777]
    add c
    dac lo
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp nc
    and [0377777]
    dac lo
    idx hi
nc,
    lac lo
    dac i p
    lac hi
    dac c
    idx p
    isp n
    jmp loop
    lac c
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp bmX
    dac i p                 // a new top limb
    idx bnN
    jmp bmX
p, 0
n, 0
c, 0
hi, 0
lo, 0
    endloc
bmX, jmp .

// bn = bn plus baV, below 2^17.
// AC and IO are clobbered.
// Called via jsp.
bnAddS, dap baX
    local loop, nc, nx, top, p, n, c
    lac baV
    dac c
    lac [bnL:.]
    dac p
    lac bnN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp top
    cma
    dac n
loop,
    lac c
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp baX                 // nothing more to carry
    add i p
    dzm c
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp nc
    and [0377777]
    dac i p
    law 1
    dac c
    jmp nx
nc,
    dac i p
nx,
    idx p
    isp n
    jmp loop
top,
    lac c
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp baX
    dac i p                 // a new top limb
    idx bnN
    jmp baX
p, 0
n, 0
c, 0
    endloc
baX, jmp .

// bn = bn divided by bdD, 1 to 2^17 - 1; AC = the remainder.
// IO is clobbered.
// Called via jsp.
bnDivS, dap bdX
    local loop, done, p, n, r
    dzm r
    lac bnN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp done
    cma
    dac n
    lac bnN
    add [bnL:.]
    sub [1]
    dac p
loop,
    // (r 2^17 + limb) / bdD, the remainder carried down to the next limb
    lac r
    lio i p
    ril 1s
    div bdD
    hlt                     // overflow cannot happen, r < bdD
    dac i p
    dio r
    lac p
    sub [1]
    dac p
    isp n
    jmp loop
    // the quotient is at most one limb shorter
    lac bnN
    add [bnL:.]
    sub [1]
    dac p
    lac i p
    SKIP_NEXT_IF_AC_ZERO
    jmp done
    lac bnN
    sub [1]
    dac bnN
done,
    lac r
    jmp bdX
p, 0
n, 0
r, 0
    endloc
bdX, jmp .

// bsQ = bsS div 17, bsR = bsS mod 17.
// AC and IO are clobbered.
// Called via jsp.
bsQR, dap bqX
    cla
    lio bsS
    ril 1s
    div [0d17]
    hlt                     // overflow cannot happen, bsS is below 2^17
    dac bsQ
    dio bsR
bqX, jmp .
bsQ, 0
bsR, 0

// bn = bn times 2^bsS.
// AC and IO are clobbered.
// Called via jsp.
bnShl, dap bhX
    local mv, zl, bits, bl, b0, s, d, n
    lac bnN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp bhX
    jsp bsQR
    lac bsQ
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp bits
    // whole limbs up, the top first, then zeros below them
    lac bnN
    add [bnL:.]
    sub [1]
    dac s
    add bsQ
    dac d
    lac bnN
    cma
    dac n
mv,
    lac i s
    dac i d
    lac s
    sub [1]
    dac s
    lac d
    sub [1]
    dac d
    isp n
    jmp mv
    lac [bnL:.]
    dac d
    lac bsQ
    cma
    dac n
zl,
    dzm i d
    idx d
    isp n
    jmp zl
    lac bnN
    add bsQ
    dac bnN
bits,
    lac bsR
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp bhX
    dac mkC
    jsp mkShl
    // the new top limb, the top bsR bits of the old one.
    // AC is 0, IO the old top.
    lac bnN
    add [bnL:.]
    dac d
    sub [1]
    dac s
    cla
    lio i s
    ril 1s
    xct mkA
    xct mkB
    dac i d
    // each limb from the pair it straddles, the top first; scl keeps AC's
    // sign, 0, and drops the bits that would move into it
    lac bnN
    sub [1]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp b0
    cma
    dac n
bl,
    lac s
    dac d
    sub [1]
    dac s
    lac i d
    lio i s
    ril 1s
    xct mkA
    xct mkB
    dac i d
    isp n
    jmp bl
b0,
    lac [bnL:.]
    dac d
    lac i d
    cli
    xct mkA
    xct mkB
    dac i d
    // the top limb counts if it is not zero
    lac bnN
    add [bnL:.]
    dac d
    lac i d
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp bhX
    idx bnN
    jmp bhX
s, 0
d, 0
n, 0
    endloc
bhX, jmp .

// bn = bn divided by 2^bsS, rounded down.
// AC and IO are clobbered.
// Called via jsp.
bnShr, dap brX
    local mv, keep, bits, bl, top, zero, s, d, n, t
    lac bnN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp brX
    jsp bsQR
    lac bsQ
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp bits
    // whole limbs down, the bottom first; all of them is zero
    lac bnN
    sub bsQ
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp keep
    jmp zero
keep,
    dac bnN
    cma
    dac n
    lac [bnL:.]
    dac d
    add bsQ
    dac s
mv,
    lac i s
    dac i d
    idx s
    idx d
    isp n
    jmp mv
bits,
    lac bsR
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp brX
    dac mkC
    jsp mkShr
    // each limb from the pair it straddles, the bottom first.
    // AC the upper, IO the lower in its top 17 bits; IO's top 17 bits are
    // then the new lower.
    lac [bnL:.]
    dac d
    lac bnN
    sub [1]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp top
    cma
    dac n
bl,
    lac d
    add [1]
    dac s
    lac i s
    lio i d
    ril 1s
    xct mkA
    xct mkB
    dio t
    lac t
    rar 1s
    and [0377777]
    dac i d
    lac s
    dac d
    isp n
    jmp bl
top,
    lac i d
    xct mkA
    xct mkB
    dac i d
    SKIP_NEXT_IF_AC_ZERO
    jmp brX
    lac bnN
    sub [1]
    dac bnN
    jmp brX
zero,
    dzm bnN
    jmp brX
s, 0
d, 0
n, 0
t, 0
    endloc
brX, jmp .

// bn = bn times 5^bpP.
// AC and IO are clobbered.
// Called via jsp.
bnPow5, dap bpX
    local loop, last, t
loop,
    lac bpP
    sub [7]
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp last
    dac bpP
    lac [0d78125]
    dac bmM
    jsp bnMulS
    jmp loop
last,
    lac bpP
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp bpX
    add [p5Tab:.]
    dac t
    lac i t
    dac bmM
    jsp bnMulS
    jmp bpX
t, 0
    endloc
bpX, jmp .

// bn = bn divided by 5^bpP, rounded down.
// AC and IO are clobbered.
// Called via jsp.
bnDiv5, dap b5X
    local loop, last, t
loop,
    lac bpP
    sub [7]
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp last
    dac bpP
    lac [0d78125]
    dac bdD
    jsp bnDivS
    jmp loop
last,
    lac bpP
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp b5X
    add [p5Tab:.]
    dac t
    lac i t
    dac bdD
    jsp bnDivS
    jmp b5X
t, 0
    endloc
b5X, jmp .

// AC = bn's bit count, 0 for zero.
// IO is clobbered.
// Called via jsp.
bnBits, dap bbX
    local loop, done, t, c
    lac bnN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp bbX
    // 17 per limb below the top one, then the top one's bits
    sub [1]
    mul [0d17]
    dio t
    lac t
    rar 1s
    and [0377777]
    dac c
    lac bnN
    add [bnL:.]
    sub [1]
    dac t
    lac i t
loop,
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp done
    sar 1s
    dac t
    idx c
    lac t
    jmp loop
done,
    lac c
    jmp bbX
t, 0
c, 0
    endloc
bbX, jmp .

// FA's magnitude = bn, not zero, rounded once to 35 bits, half away from zero,
// and bnB = bn's bit count, one more when the rounding carries to 2^35.
// bn is then FA 2^(bnB-35).
// faS and faE stand; bn is clobbered.
// AC and IO are clobbered.
// Called via jsp.
// bnRnd is its second half, the fixed steps that round into FA a bn of
// exactly 36 bits in bnL to bnL+2, its bit count already in bnB.
// Called via jsp, with bnTo35's contract.
bnTo35, dap btX
    local shr, up, t, hb
    jsp bnBits
    dac bnB
    // bn to exactly 36 bits, the 35 kept and the round bit
    sub [0d36]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp up
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp shr
    cma
    dac bsS
    jsp bnShl
    jmp up
shr,
    dac bsS
    jsp bnShr
    jmp up
bnRnd, dap btX
up,
    // bnL+2 is 2 or 3, so fa2 is 1; fa1 is its low bit, then bnL+1's top 16
    // bits; fa0 bnL+1's low bit, then bnL's top 16; bnL's low bit rounds
    law 1
    dac fa2
    lac bnL+2
    rar 1s
    and [0400000]
    rar 1s
    dac hb                  // bnL+2's low bit as 2^16
    lac bnL+1
    rar 1s
    dac t                   // its low bit in bit 0, the rest one place down
    and [0177777]
    ior hb
    dac fa1
    lac t
    and [0400000]
    rar 1s
    dac hb                  // bnL+1's low bit as 2^16
    lac bnL
    rar 1s
    dac t                   // the round bit in bit 0
    and [0177777]
    ior hb
    dac fa0
    lac t
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp btX
    // up one, carrying through fa1 to 2^35, which is 2^34 one place up
    lac fa0
    add [1]
    dac fa0
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp btX
    dzm fa0
    lac fa1
    add [1]
    dac fa1
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp btX
    dzm fa1
    idx bnB
    jmp btX
t, 0
hb, 0
    endloc
btX, jmp .

// AC = the value of the character in IO as a digit, letters as digits (A = 1
// to Z = 26, E excepted), or -1 if it is not one.
// IO is preserved.
// Called via jsp, which takes AC for the return.
dgVal, dap dvX
    local no, dig, c
    dio c
    lac c
    sub [060]
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp no                  // below 0
    sub [012]
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp dig                 // 0 to 9
    lac c
    sad [0105]
    jmp no                  // E
    sub [0101]
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp no                  // below A
    sub [0d26]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp no                  // past Z
    lac c
    sub [0100]
    jmp dvX
dig,
    lac c
    sub [060]
    jmp dvX
no,
    law i 1
    jmp dvX
c, 0
    endloc
dvX, jmp .

// FA = the number whose first character is in AC, a digit, a letter or a
// point, read on through fpGetc; AC = the character that ended it.
// IO is clobbered.
// Called via farjda(fpIn:1).
// Errors: ?07.22 for a second point or E, or a point or E in the E part;
// ?23.36 above the range.
// The digits' integer D stops growing at BN_DMAX limbs, a digit dropped before
// the point then counting as a power of ten; the E part stops at BN_XCAP.
// D is first kept in two limbs, inH and inL, while inTw is 1; a digit that
// finds inH at 13107 or more moves it to bn for the rest.
// A D still in two limbs, with -7 <= E <= 7, is converted by inFast; any
// other goes to bn and the multiword conversion.
// Both give the same number.
fpIn, 0
    local mant, dmax, grow, fdig, fnc, fmv, notd, point, next, expo, eminus
    addlocal eplus, edig, eok, enotd, eneg, epos, conv, cexact, fconv, fslow
    addlocal neg, big, zero, range, twoE, t, c
    dac inRtn
    dzm bnN
    dzm inFr
    dzm inFd
    dzm inDr
#ifndef FOCAL_1C
    dzm inH
    dzm inL
    law 1
    dac inTw
#endif
    lac fpIn
mant,
    dac c
    lio c
    jsp dgVal
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp notd
    dac baV
#ifndef FOCAL_1C
    lac inTw
    SKIP_NEXT_IF_AC_ZERO
    jmp fdig
#endif
dmax,
    lac bnN
    sub [BN_DMAX]
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp grow
    lac inFr
    SKIP_NEXT_IF_AC_ZERO
    jmp next                // a dropped fraction digit counts for nothing
    idx inDr
    jmp next
grow,
    law 0d10
    dac bmM
    jsp bnMulS
    jsp bnAddS
    lac inFr
    SKIP_NEXT_IF_AC_ZERO
    idx inFd
    jmp next
#ifndef FOCAL_1C
fdig,
    // D 10 + v in two limbs.
    // inL 10 + v is inL and a carry t of at most 10, and inH 10 + t stays
    // below 2^17 while inH is below 13107.
    lac inH
    sub [0d13107]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp fmv
    lac inL
    mul [0d10]
    dac t
    rir 1s                  // IO bit 17, the product's sign (F15D, mul), is
                            // 0 and rotates to the top, leaving the low limb
    dio inL
    lac inL
    add baV
    dac inL
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp fnc
    and [0377777]
    dac inL
    idx t
fnc,
    lac inH                 // inH 10 + t as (4 inH + inH) 2 + t
    ral 2s
    add inH
    ral 1s
    add t
    dac inH
    lac inFr
    SKIP_NEXT_IF_AC_ZERO
    idx inFd
    jmp next
fmv,
    jsp inMv
    jmp dmax
#endif
notd,
    lac c
    sad [056]
    jmp point
    sad [0105]
    jmp expo
    lac inDr
    sub inFd
    dac inX
    jmp conv
point,
    lac inFr
    SKIP_NEXT_IF_AC_ZERO
    jmp twoE
    law 1
    dac inFr
next,
    jsp i fpGetc
    jmp mant
expo,
    // E, an optional sign, then digits, which saturate at BN_XCAP
    dzm inX
    dzm inSg
    jsp i fpGetc
    sad [053]
    jmp eplus
    sad [055]
    jmp eminus
    jmp edig
eminus,
    law 1
    dac inSg
eplus,
    jsp i fpGetc
edig,
    dac c
    lio c
    jsp dgVal
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp enotd
    dac t
    lac inX                 // inX 10 + t as (4 inX + inX) 2 + t
    ral 2s
    add inX
    ral 1s
    add t
    dac inX
    sub [BN_XCAP]
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp eok
    lac [BN_XCAP]
    dac inX
eok,
    jsp i fpGetc
    jmp edig
enotd,
    lac c
    sad [056]
    jmp twoE
    sad [0105]
    jmp twoE
    // the power of ten is the E part, plus the dropped digits, less the
    // fraction's
    lac inSg
    SKIP_NEXT_IF_AC_ZERO
    jmp eneg
    lac inDr
    add inX
    jmp epos
eneg,
    lac inDr
    sub inX
epos,
    sub inFd
    dac inX
conv,
    dzm faS
#ifndef FOCAL_1C
    lac inTw
    SKIP_NEXT_IF_AC_ZERO
    jmp fconv
#endif
cexact,
    lac bnN
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zero
    lac inX
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp neg
    // D 10^E, E >= 0, as D 5^E 2^E; from 10^617 up it is past 2^2047
    sub [0d617]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp big
    lac inX
    dac bpP
    jsp bnPow5
    jsp bnTo35
    lac bnB
    add inX
    jmp range
neg,
    // D 10^-q as D 2^t / 5^q, then 2^(-t-q); t brings the quotient to at
    // least 37 bits, enough to round.
    // From 10^-720 down it is below 2^-2049.
    cma
    dac inQ
    sub [0d720]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zero
    cla
    lio inQ
    ril 1s
    div [3]
    hlt                     // overflow cannot happen
    dac t                   // t = 39 + 2q + floor(q/3) - D's bits, at least 0
    lac inQ
    ral 1s
    add t
    add [0d39]
    dac t
    jsp bnBits
    cma
    add t
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    cla
    dac t
    dac bsS
    jsp bnShl
    lac inQ
    dac bpP
    jsp bnDiv5
    jsp bnTo35
    lac bnB
    sub t
    sub inQ
range,
    dac faE
    sub [FP_EMAX]
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp big
    lac faE
    add [FP_EMIN]
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    jmp zero
    lac c
    jmp i inRtn
zero,
    jsp faZero
    lac c
    jmp i inRtn
big,
    lac [ERR_LITBIG]
    jmp i fpErr
twoE,
    lac [ERR_TWOE]
    jmp i fpErr
#ifndef FOCAL_1C
fconv,
    // D in two limbs: zero, or the fast conversion for -7 <= E <= 7, or bn
    lac inH
    ior inL
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zero
    lac inX
    SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
    cma
    dac inQ
    sub [0d8]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp fslow
    jsp inFast
    jmp range
fslow,
    jsp inMv
    jmp cexact
#endif
t, 0
c, 0
    endloc
inRtn, 0
inFr, 0                 // 1 once the point is read
inFd, 0                 // digits read after the point
inDr, 0                 // digits dropped before it
inX, 0                  // the E part, then the power of ten
inSg, 0                 // 1 for a minus after E
inQ, 0                  // |E|, from fconv to inFast; q, for E = -q
#ifndef FOCAL_1C
inTw, 0                 // 1 while D is in inH and inL, not in bn
inH, 0                  // D's high limb, then D' 's
inL, 0                  // D's low limb, then D' 's

// bn = D, from inH and inL, and inTw = 0, so D leaves its two limbs.
// AC is clobbered; IO is preserved.
// Called via jsp.
inMv, dap imX
    dzm inTw
    dzm bnN
    lac inL
    dac bnL
    SKIP_NEXT_IF_AC_ZERO
    idx bnN
    lac inH
    dac bnL+1
    SKIP_NEXT_IF_AC_NOT_ZERO
