// One step of the long division.
// AC = floor(t / v), t3..t0 over dv2..dv0, and t = its remainder.
// t3 is at most dv2 on entry.
// IO is clobbered.
// Called via jsp.
dvStep, dap dsX
    local qh, c, h, l, max, est, back, done
    // the estimate from the top two limbs over dv2, at most 2^17 - 1
    lac t3
    sub dv2
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp max
    lac t3
    lio t2
    ril 1s                  // AC:IO = (t3 2^17 + t2) << 1, as div wants
    div dv2
    jmp max                 // no skip means overflow, which t3 < dv2 rules out
    jmp est
max,
    lac [0377777]
est,
    dac qh
    // t = t - qh v, a limb at a time, the product's carry in c, the borrow in
    // sbI
    dzm c
    dzm sbI
    MULP(qh, dv0, h, l)
    lac l
    dac ps
    dzm pc
    lio c
    jsp acc
    lac h
    add pc
    dac c
    lac t0
    dac sbA
    lac ps
    dac sbB
    jsp sbL
    dac t0
    MULP(qh, dv1, h, l)
    lac l
    dac ps
    dzm pc
    lio c
    jsp acc
    lac h
    add pc
    dac c
    lac t1
    dac sbA
    lac ps
    dac sbB
    jsp sbL
    dac t1
    MULP(qh, dv2, h, l)
    lac l
    dac ps
    dzm pc
    lio c
    jsp acc
    lac h
    add pc
    dac c
    lac t2
    dac sbA
    lac ps
    dac sbB
    jsp sbL
    dac t2
    // the top limb, negative by a little when the estimate was too large
    lac t3
    sub c
    sub sbI
    dac t3
back,
    lac t3
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp done
    lac qh
    sub [1]
    dac qh
    dzm adI
    lac t0
    dac adA
    lac dv0
    dac adB
    jsp adL
    dac t0
    lac t1
    dac adA
    lac dv1
    dac adB
    jsp adL
    dac t1
    lac t2
    dac adA
    lac dv2
    dac adB
    jsp adL
    dac t2
    lac t3
    add adI
    dac t3
    jmp back
done,
    lac qh
    jmp dsX
qh, 0
c, 0
h, 0
l, 0
    endloc
dsX, jmp .

// AC = -1, 0 or 1 as FA is less than, equal to or greater than FB.
// FA and FB stand; IO is clobbered.
// Called via farjsp.
fpCmp, dac cmRtn
    local az, bysign, mag, gt, neg, done
    lac fa2
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp az
    lac fb2
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp bysign              // FB is 0, so FA's sign decides
    lac faS
    sub fbS
    SKIP_NEXT_IF_AC_ZERO
    jmp bysign              // the signs differ, so FA's decides
    lac faE
    sub fbE
    SKIP_NEXT_IF_AC_ZERO
    jmp mag
    lac fa1
    sub fb1
    SKIP_NEXT_IF_AC_ZERO
    jmp mag
    lac fa0
    sub fb0
    SKIP_NEXT_IF_AC_ZERO
    jmp mag
    jmp i cmRtn             // equal, AC is 0
az,
    // FA is 0, so the result is 0 or the opposite of FB's sign
    lac fb2
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i cmRtn
    lac fbS
    SKIP_NEXT_IF_AC_ZERO
    jmp gt
    law i 1
    jmp i cmRtn
bysign,
    lac faS
    SKIP_NEXT_IF_AC_ZERO
    jmp neg
    law 1
    jmp i cmRtn
mag,
    // AC is |FA| - |FB| in its first differing word; its sign decides,
    // reversed when FA is negative
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp gt
    lac faS
    SKIP_NEXT_IF_AC_ZERO
    jmp done
    law i 1
    jmp i cmRtn
gt,
    lac faS
    SKIP_NEXT_IF_AC_ZERO
    jmp neg
done,
    law 1
    jmp i cmRtn
neg,
    law i 1
    jmp i cmRtn
    endloc
cmRtn, 0

// FA = FA truncated toward zero, FITR's rounding.
// AC and IO are clobbered.
// Called via farjsp.
fpFitr, dac ftRtn
    local whole, low, k, p
    lac fa2
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i ftRtn
    lac faE
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp whole
    jsp faZero              // below 1 in size, so 0
    jmp i ftRtn
