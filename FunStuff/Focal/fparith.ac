// AC = FA truncated toward zero as a subscript, -2048 to 2047; else ?06.55.
// FA stands; IO is clobbered.
// Called via farjsp.
fpSubs, dac suRtn
    local one, bad, neg, t
    lac fa2
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp i suRtn             // AC 0
    lac faE
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp one
    cla                     // below 1 in size, so 0
    jmp i suRtn
one,
    sub [0d12]
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp bad                 // 4096 or more in size
