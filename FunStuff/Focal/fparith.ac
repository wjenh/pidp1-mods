    sub [0d35]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp i ftRtn             // 2^34 or more, an integer already
    // clear the k = 35 - e low bits, 1 to 34
    cma
    dac k
    sub [0d17]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp low
    lac k
    add [lmTab:.]
    dac p
    lac i p
    cma
    and fa0
    dac fa0
    jmp i ftRtn
low,
    dzm fa0
    add [lmTab:.]
    dac p
    lac i p
    cma
    and fa1
    dac fa1
    jmp i ftRtn
k, 0
p, 0
    endloc
