    lac faE
    cma
    add [0d19]
    dac mkC
    jsp mkShr
    law 1
    lio fa1
    ril 1s
    xct mkA
    xct mkB
    dio t
    lac faS
    SKIP_NEXT_IF_AC_ZERO
    jmp neg
    lac t
    sub [0d2047]
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp bad
    lac t
    jmp i suRtn
neg,
    lac t
    sub [0d2048]
    SKIP_NEXT_IF_AC_ZERO_OR_NEGATIVE
    jmp bad
    lac t
    cma
    jmp i suRtn
bad,
    lac [ERR_SUBSC]
    jmp i fpErr
t, 0
    endloc
