// lifelib.ac -- Life's pattern library, included by life.am1 in bank 3. PATTERN opens its
// screen, a page of names with a preview of the lit one and six keys along the bottom. PLACE
// puts a pattern in the pen's hand, or replaces the field with a whole one. A held pattern
// follows the pen across the lattice as a dim ghost, and the pen's lift drops it there. UNDO's
// copy of the field is kept here too.
//
// The code and its words are in bank 3, beside the patterns. The screen and the ghost are
// display words in bank 1, which the frame reaches by jump. Bank 0 calls the entries below by
// jsp i to their full address, with the return in AC, and each returns by jmp i. This code
// calls bank 0's routines through far, since they return by dap into bank 0, and reaches bank
// 0's words by their full addresses. Extend mode is on throughout.
//
// While the screen is open, scrGo holds its list's address and the break routine starts every
// frame there, so the field, the bar and the lattice are not shown. A row lights on any hit. A
// key acts only on a press's first hit, so a pen slid onto one does nothing.

#define KEYY        0d40                // the keys' baseline
#define KEYTHR      0d64                // a hit below this y is on the keys
#define SROWY1      0d940               // the first row's baseline; a row's hits are 12 below it to 24 above
#define NAMEX2      0d256               // a hit at or right of this x is on the second column
#define PREVX       0d496               // a hit at or right of this x is on the preview
#define PVX         0d760               // a pattern's center in the preview
#define PVY         0d560
#define PVFX        0d512               // a whole field's row 0, column 0 in the preview, pitch 4
#define PVFY        0d900
#define PVTX        0d528               // the preview's text
#define INFOY       0d100
#define PVWORDS     (0d1+0d2*PVCAP+0d2)
#define GHWORDS     (0d4+0d2*GHCAP+0d2)
// The library's size.
#define LIBN        0d29                // entries
#define LIBPAGES    0d2                 // pages of up to 16

// A call to bank 0's routine R, through far. AC is R's answer, IO as R leaves it.
#define FAR(R) lac [R:0]; dac i [farTo:0]; jsp i [far:0]

// A display word to the next place of the buffer being written.
#define PEMIT dac i pq; idx pq

// Clears the field, then places pattern patSel at the size's top left, clipped to the size. A
// pattern is a list of cells, row * 128 + column, ended by PATEND, or RAWMARK and a whole
// field's image. Every row's flag is then the OR of its words.
// Called via jsp i, the return in AC; returns by jmp i. AC and IO are clobbered.
libLoad, dac llR
        FAR(clrField)
        lac i [patSel:0]
        and [3]
        add [patTab:3]
        dac pp3
        lac i pp3
        dac pp3
        lac i pp3
        SKIP_NEXT_IF_DIFFERENT [RAWMARK]
        jmp llRaw
llCell, lac i pp3
        SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
        jmp llClip
        dac lw
        and [0177]
        add i [sC0:0]
        dac i [ccol:0]
        lac lw
        sar 7s
        and [0177]
        add i [sR0:0]
        dac i [crow:0]
        FAR(setCell)
        idx pp3
        jmp llCell
llRaw,  idx pp3
        lac [field:4]
        dac pq
        law i FIELDWORDS
        dac lcnt
llR1,   lac i pp3
        dac i pq
        idx pp3
        idx pq
        isp lcnt
        jmp llR1
llClip, FAR(clipField)
        jmp i llR

// Opens the screen on the page last shown, no row lit; the caller has stopped the run and
// closed any list. Called via jsp i, the return in AC; returns by jmp i. AC and IO are clobbered.
libOpen, dac loR
        jsp lUnlit
        lac [jump tail:0 next(parameter)]
        dac i [scrPv:1]
        jsp lPage
        lac [scrList:1]
        dac i [scrGo:0]
        FAR(setLook)
        jmp i loR

// Takes a hit at (hx, hy) while the screen is open. A key acts on a fresh press. A row lights
// and shows its preview. Called via jsp i, the return in AC; returns by jmp i. AC and IO are
// clobbered.
libHit, dac lhR
        lac i [hy:0]
        sub [KEYTHR]
        SKIP_NEXT_IF_AC_NOT_NEGATIVE
        jmp lhKey
        lac i [hx:0]
        sub [PREVX]
        SKIP_NEXT_IF_AC_NEGATIVE
        jmp i lhR                       // on the preview
// The row, in bands of ROWPITCH down from the first row's, eight a column.
        lac i [hy:0]
        sub [SROWY1-0d12]
        dac lt3
        sub [ROWPITCH]
        SKIP_NEXT_IF_AC_NEGATIVE
        jmp i lhR                       // above the first row
        dzm lk
lh1,    lac lt3
        SKIP_NEXT_IF_AC_NEGATIVE
        jmp lh2
        add [ROWPITCH]
        dac lt3
        idx lk
        jmp lh1
lh2,    lac lk
        sub [0d8]
        SKIP_NEXT_IF_AC_NEGATIVE
        jmp i lhR                       // below the last row
        lac i [hx:0]
        sub [NAMEX2]
        SKIP_NEXT_IF_AC_NOT_NEGATIVE
        jmp lh3
        lac lk
        add [0d8]
        dac lk
lh3,    lac lPg
        sal 4s
        add lk
        dac lk                          // the entry
        sub [LIBN]
        SKIP_NEXT_IF_AC_NEGATIVE
        jmp i lhR                       // past the last entry
        lac lk
        add [1]
        SKIP_NEXT_IF_DIFFERENT lLit
        jmp i lhR                       // lit already
        jsp lLight
        jmp i lhR
lhKey,  lac i [fresh:0]
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp i lhR
        lac i [hx:0]
        add [0d16]                      // a label's left reach belongs to it
        sar 7s
        dac lk
        sub [6]
        SKIP_NEXT_IF_AC_NEGATIVE
        jmp i lhR
        lac lk
        add [keyT]
        dap lhK1
lhK1,   lac .
        dap lhK2
lhK2,   jsp .
        jmp i lhR

// The keys, each called via jsp. AC and IO are clobbered.
// PREV and NEXT turn to the page before or after, round the pages, with no row lit.
kPrev,  dap kpx
        lac lPg
        SKIP_NEXT_IF_AC_NOT_ZERO
        law LIBPAGES
        sub [1]
        dac lPg
        jmp kn1
kNext,  dap kpx
        idx lPg
        sub [LIBPAGES]
        SKIP_NEXT_IF_AC_NEGATIVE
        dzm lPg
kn1,    jsp lUnlit
        lac [jump tail:0 next(parameter)]
        dac i [scrPv:1]
        jsp lPage
kpx,    jmp .

// TURN turns the lit pattern a quarter turn clockwise, and FLIP swaps its left for right.
// A cell's place is (nr ? - : +)(sw ? c : r), (nc ? - : +)(sw ? r : c), so a turn, (r, c) to
// (c, -r) after the rest, swaps the two and takes nr from nc and nc from the opposite of nr.
// Neither acts on a whole field.
kTurn,  dap ktx
        jsp lIsPat
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp ktx
        lac oSw
        xor [1]
        dac oSw
        lac oNr
        lio oNc
        xor [1]
        dac oNc
        dio oNr
        jsp lPreview
ktx,    jmp .

kFlip,  dap kfx
        jsp lIsPat
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp kfx
        lac oNc
        xor [1]
        dac oNc
        jsp lPreview
kfx,    jmp .

// PLACE puts a lit pattern into the pen's hand, or a lit whole field in place of the field
// with the counter at 0. Either closes the screen.
kPlace, dap kcx
        lac lLit
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp kcx
        jsp lIsPat
        SKIP_NEXT_IF_AC_ZERO
        jmp kc1
        jsp lSnap
        lac lLit
        add [libData-1]
        dap kc2
kc2,    lac .
        dac i [patSel:0]
        jsp libLoad
        FAR(zeroGen)
        law 1
        dac i [dirty:0]
        jmp kc3
kc1,    lac lLit
        dac i [stampP:0]
        dzm plDown
        dzm ghOn
kc3,    jsp lClose
kcx,    jmp .

// CANCEL closes the screen and changes nothing.
kCancel, dap kxx
        jsp lClose
kxx,    jmp .

// Closes the screen. The frame goes back to the field, and the lattice waits for a fresh press,
// so the pen still on the key does not draw. Called via jsp. AC and IO are clobbered.
lClose, dap lcx
        jsp lUnlit
        dzm i [scrGo:0]
        law 1
        dac i [needFresh:0]
        FAR(setLook)
lcx,    jmp .

// AC = 1 when the lit entry is a pattern, 0 when it is a whole field or none is lit.
// Called via jsp. AC is the answer, IO is preserved.
lIsPat, dap lix
        lac lLit
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp lix
        add [libKind-1]
        dap li1
li1,    lac .
        xor [1]
lix,    jmp .

// Shows page lPg's names. Called via jsp. AC is clobbered, IO is preserved.
lPage,  dap lpgx
        lac lPg
        add [pgTab]
        dap lpg1
lpg1,   lac .
        ior [jump next(parameter)]
        dac i [scrPg:1]
lpgx,   jmp .

// Lights entry lk's row, putting out the one lit before, and shows its preview.
// Called via jsp. AC and IO are clobbered.
lLight, dap llgx
        jsp lUnlit
        lac lk
        add [1]
        dac lLit
        lac lk
        add [libRow]
        dap llg1
llg1,   lac .
        dac pq
        lac [intensity(LITI) next(point)]
        dac i pq
        jsp lPreview
llgx,   jmp .

// Puts out the lit row, if any, and its preview. Called via jsp. AC is clobbered, IO is preserved.
lUnlit, dap lux
        lac lLit
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp lux
        add [libRow-1]
        dap lu1
lu1,    lac .
        dac pq
        lac [intensity(LBLI) next(point)]
        dac i pq
        dzm lLit
        lac [jump tail:0 next(parameter)]
        dac i [scrPv:1]
lux,    jmp .

// Writes the lit entry's preview into the buffer not shown, then shows it. A pattern is drawn
// at pitch 8 about its center, turned as the keys left it, and a whole field at pitch 4 from its
// top left. The entry's text follows. A frame ends first, after the last switch, so that the
// display is not still in the buffer written. Called via jsp. AC and IO are clobbered.
lPreview, dap lpvx
        lac lLit
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp lpvx
        lac i [frames:0]
        sub pvFr
        SKIP_NEXT_IF_AC_ZERO
        jmp lpv0
        FAR(waitFrame)
lpv0,   lac [pvB:1]
        lio pvShown
        SKIP_NEXT_IF_IO_IS_ZERO
        lac [pvA:1]
        dac pvBuf
        dac pq
        lac [intensity(CELLI) lpoff next(point)]
        PEMIT
        law i PVCAP
        dac lcnt
        lac lLit
        add [libData-1]
        dap lpv1
lpv1,   lac .
        dac pp3
        jsp lIsPat
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp lpvF
// Each of a pattern's cells turned, then placed at pitch 8 about the preview's center.
lpv2,   lac i pp3
        SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
        jmp lpvE
        dac lw
        jsp lXform
        lac tR
        sal 3s
        dac t8
        law PVY+0d512
        sub t8
        ior [y(0) next(point)]
        PEMIT
        lac tC
        sal 3s
        add [PVX-0d512]
        ior [show next(point)]
        PEMIT
        idx pp3
        isp lcnt
        jmp lpv2
        jmp lpvE
// A whole field's cells, row * 128 + column as the loader reads them, at pitch 4.
lpvF,   lac pp3
        add [patTab]
        dap lpv3
lpv3,   lac .
        dac pp3
        lac i pp3
        SKIP_NEXT_IF_DIFFERENT [RAWMARK]
        jmp lpvE                        // an image, not shown
lpv4,   lac i pp3
        SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
        jmp lpvE
        dac lw
        sar 7s
        and [0177]
        sal 2s
        dac t8
        law PVFY
        sub t8
        ior [y(0) next(point)]
        PEMIT
        lac lw
        and [0177]
        sal 2s
        add [PVFX]
        ior [show next(point)]
        PEMIT
        idx pp3
        isp lcnt
        jmp lpv4
lpvE,   lac [y(0) next(subroutine)]
        PEMIT
        lac lLit
        add [libInfo-1]
        dap lpv5
lpv5,   lac .
        ior [jump next(parameter)]
        PEMIT
        lac pvBuf
        ior [jump next(parameter)]
        dac i [scrPv:1]
        lac pvShown
        xor [1]
        dac pvShown
        lac i [frames:0]
        dac pvFr
lpvx,   jmp .

// lw's cell, (row + 64) * 128 + column + 64, turned as oSw, oNr and oNc say, into tR and tC,
// each still with its 64 added. Called via jsp. AC and IO are clobbered.
lXform, dap lxx
        lac lw
        and [0177]
        dac tC
        lac lw
        sar 7s
        and [0177]
        dac tR
        lac oSw
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp lx1
        lac tR
        lio tC
        dac tC
        dio tR
lx1,    lac oNr
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp lx2
        law 0d128
        sub tR
        dac tR
lx2,    lac oNc
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp lxx
        law 0d128
        sub tC
        dac tC
lxx,    jmp .

// Cell (tR, tC) about the held pattern's place (gR, gC) into bank 0's crow and ccol.
// Called via jsp. AC is clobbered, IO is preserved.
lAt,    dap lax
        lac tR
        add gR
        sub [0d64]
        dac i [crow:0]
        lac tC
        add gC
        sub [0d64]
        dac i [ccol:0]
lax,    jmp .

// The held pattern's cell list into pp3. Called via jsp. AC is clobbered, IO is preserved.
lHeld,  dap lhdx
        lac i [stampP:0]
        add [libData-1]
        dap lhd1
lhd1,   lac .
        dac pp3
lhdx,   jmp .

// Moves the ghost to a lattice hit inside the size while a pattern is held, unless it is there
// already. The hit's cell is in crow and ccol. Called via jsp i, the return in AC; returns by
// jmp i. AC and IO are clobbered.
libMove, dac lmR
        law 1
        dac plDown
        lac ghOn
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp lm1
        lac i [crow:0]
        SKIP_NEXT_IF_DIFFERENT gR
        jmp lm2
        jmp lm1
lm2,    lac i [ccol:0]
        SKIP_NEXT_IF_DIFFERENT gC
        jmp i lmR                       // a pen held still
lm1,    lac i [crow:0]
        dac gR
        lac i [ccol:0]
        dac gC
        jsp lGhost
        jmp i lmR

// Writes the ghost, the held pattern at (gR, gC) clipped to the size, into the buffer not
// shown, then shows it, a frame ending first as for the preview. It is drawn in scale 3 vectors,
// as the paint lists are. The first cell is a point one pitch left of it and a visible step onto
// it. Each later cell is an invisible hop from the last to one pitch left of it and a visible
// step onto it, but a cell just right of the last adds a step to the last's vector instead.
// Called via jsp. AC and IO are clobbered.
lGhost, dap lgx
        lac i [frames:0]
        sub ghFr
        SKIP_NEXT_IF_AC_ZERO
        jmp lg0
        FAR(waitFrame)
lg0,    lac [ghB:1]
        lio ghShown
        SKIP_NEXT_IF_IO_IS_ZERO
        lac [ghA:1]
        dac ghBuf
        dac pq
        lac [scale(3) intensity(GHI) lpoff]
        PEMIT
        law 1
        dac lFst
        law i GHCAP
        dac lcnt
        jsp lHeld
lg1,    lac i pp3
        SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
        jmp lg2
        dac lw
        jsp lXform
        jsp lAt
        FAR(inSize)
        SKIP_NEXT_IF_AC_ZERO
        jmp lg3                         // outside the size
        lac lFst
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp lg4
        dzm lFst                        // the first, a point one pitch left of it
        lac [next(point)]
        PEMIT
        lac i [crow:0]
        sal 3s
        dac t8
        law FTOPY
        sub t8
        ior [y(0) next(point)]
        PEMIT
        lac i [ccol:0]
        sal 3s
        ior [next(vector)]
        PEMIT
        jmp lg6
lg4,    lac i [ccol:0]                  // a later one, the hop's steps right and down
        sub gLC
        sub [1]
        dac hX
        lac i [crow:0]
        sub gLR
        dac hY
        ior hX
        SKIP_NEXT_IF_AC_ZERO
        jmp lg7
        lac pq                          // just right of the last, one more step
        sub [1]
        dac t8
        idx i t8
        jmp lg5
lg7,    lac hX
        SKIP_NEXT_IF_AC_NEGATIVE
        jmp lg8
        cma
        ior [left]
lg8,    dac t8
        lac hY
        SKIP_NEXT_IF_AC_NEGATIVE
        jmp lg9
        cma                             // a row above
        sal 4s
        sal 4s
        jmp lg10
lg9,    sal 4s
        sal 4s
        ior [down]
lg10,   ior t8
        PEMIT
lg6,    lac [right deltax(1) visible]
        PEMIT
        isp lcnt
        jmp lg5
        jmp lg2                         // the cap
lg5,    lac i [crow:0]
        dac gLR
        lac i [ccol:0]
        dac gLC
lg3,    idx pp3
        jmp lg1
lg2,    lac lFst
        SKIP_NEXT_IF_AC_ZERO
        jmp lg11                        // no cell, so still in parameter mode
        lac pq
        sub [1]
        dac t8
        lac i t8
        ior [end]
        dac i t8
lg11,   lac [next(subroutine)]
        PEMIT
        lac [jump tail:0 next(parameter)]
        PEMIT
        lac ghBuf
        ior [jump next(parameter)]
        dac i [ghJmp:1]
        lac ghShown
        xor [1]
        dac ghShown
        lac i [frames:0]
        dac ghFr
        law 1
        dac ghOn
lgx,    jmp .

// Drops the held pattern when the pen lifts, run each pass of the main loop while one is held.
// Once a press has moved the ghost and PRESSGAP ms pass with no hit, the pen has lifted, and the
// pattern is ORed into the field at the ghost's place, clipped to the size. Called via jsp i,
// the return in AC; returns by jmp i. AC and IO are clobbered.
libTidy, dac ltR
        lac plDown
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp i ltR
        rck
        dio lt3
        lac lt3
        sub i [lastMs:0]
        MSWRAP
        sub [PRESSGAP]
        SKIP_NEXT_IF_AC_NOT_NEGATIVE
        jmp i ltR
        dzm plDown
        jsp lSnap
        jsp lHeld
ld1,    lac i pp3
        SKIP_NEXT_IF_AC_POSITIVE_OR_ZERO
        jmp ld2
        dac lw
        jsp lXform
        jsp lAt
        FAR(setCell)
        idx pp3
        jmp ld1
ld2,    law 1
        dac i [dirty:0]
        jmp i ltR

// Ends place mode, if on, putting out the ghost and dropping nothing. Called via jsp i, the
// return in AC; returns by jmp i. AC is clobbered, IO is preserved.
libEnd, dac leR
        dzm i [stampP:0]
        dzm plDown
        dzm ghOn
        lac [jump tail:0 next(parameter)]
        dac i [ghJmp:1]
        jmp i leR

// Puts the pen's and the menu's state back as a load leaves it, for a start at go after a run.
// An open list is closed, the library's screen and a held pattern put away, the first page
// shown with no turn, both paint lists and the ring of hits emptied, UNDO's copy dropped, and
// the menu's words listOn to lastC zeroed (lifemenu.ac), so the pen paints and the aperture is
// set again. The size, edge, speed and whole field chosen are kept, as a debugger sets them.
// Breaks must be off and the display halted. Called via jsp i, the return in AC; returns by
// jmp i. AC and IO are clobbered.
startOver, dac soR
        FAR(closeList)
        lac i [scrGo:0]
        SKIP_NEXT_IF_AC_ZERO
        jsp lClose
        jsp libEnd
        dzm lPg
        dzm oSw
        dzm oNr
        dzm oNc
        lac i [ovCH:0]                  // each paint list's head its empty jump
        dac pq
        lac i [ovCE:0]
        dac i pq
        dzm i [ovCN:0]
        lac i [ovPH:0]
        dac pq
        lac i [ovPE:0]
        dac i pq
        dzm i [ovPN:0]
        dzm i [undoOk:0]
        dzm i [hitDrop:0]
        dzm i [wIdx:0]
        dzm i [rIdx:0]
        lac [ring:0]
        dac i [wPtr:0]
        dac i [rPtr:0]
        lac [listOn:0]
        dac pq
        lac [-(lastC:0-listOn:0+1)]
        dac lcnt
so1,    dzm i pq
        idx pq
        isp lcnt
        jmp so1
        jmp i soR

// Takes UNDO's copy of the field, its row flags, the generation and the counter's digits,
// before an edit. Called via jsp i, the return in AC; returns by jmp i. lSnap is the same
// routine called via jsp. AC is clobbered, IO is preserved.
libSnap, dac lsR
        jsp lSnap
        jmp i lsR

lSnap,  dap lsx
        lac [field:4]
        dac pp3
        lac [fldU:4]
        dac pq
        law i FIELDSPAN
        dac lcnt
ls1,    lac i pp3
        dac i pq
        idx pp3
        idx pq
        isp lcnt
        jmp ls1
        lac [dig:0]
        dac pp3
        lac [uDig:3]
        dac pq
        law i 7
        dac lcnt
ls2,    lac i pp3
        dac i pq
        idx pp3
        idx pq
        isp lcnt
        jmp ls2
        lac i [gen:0]
        dac uGen
        law 1
        dac i [undoOk:0]
lsx,    jmp .

// UNDO swaps the field, its flags, the generation and the counter with the copy, so a second
// UNDO puts back the first's. It does nothing with no copy. Called via jsp i, the return in AC;
// returns by jmp i. AC and IO are clobbered.
libUndo, dac luR
        lac i [undoOk:0]
        SKIP_NEXT_IF_AC_NOT_ZERO
        jmp i luR
        lac [field:4]
        dac pp3
        lac [fldU:4]
        dac pq
        law i FIELDSPAN
        dac lcnt
lu2,    lac i pp3
        lio i pq
        dac i pq
        dio i pp3
        idx pp3
        idx pq
        isp lcnt
        jmp lu2
        lac [dig:0]
        dac pp3
        lac [uDig:3]
        dac pq
        law i 7
        dac lcnt
lu3,    lac i pp3
        lio i pq
        dac i pq
        dio i pp3
        idx pp3
        idx pq
        isp lcnt
        jmp lu3
        lac i [gen:0]
        lio uGen
        dac uGen
        dio i [gen:0]
        law 1
        dac i [dirty:0]
        jmp i luR

// The keys' actions, by key from the left.
