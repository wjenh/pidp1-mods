// The display words, in bank 1.
bank 1

// WAIT at the screen's center, a list that loops on itself while a tape moves (waitOn). Its 8
// invisible vectors keep it from refreshing, and stealing cycles, faster than it need.
waitL,  scale(2) intensity(CELLI) lpoff next(point)
        y(0d500) next(point)
        x(0d456) next(character)
        type340 "\UWAIT"
        scale(0) lpoff next(vector)
        right deltax(0d127)
        left deltax(0d127)
        right deltax(0d127)
        left deltax(0d127)
        right deltax(0d127)
        left deltax(0d127)
        right deltax(0d127)
        left deltax(0d127) end
        lpoff next(subroutine)
        jump waitL:1 next(parameter)

// TAPE's list, beside its bar item.
lsTape,
rT1,    ITEM(ROWY1, 0d672)
        type340 "\UPUNCH"
rT2,    ITEM(ROWY1-ROWPITCH, 0d672)
        type340 "\UREAD"
        next(subroutine)
        jump boxJmp:1 next(subroutine)

// The status words, by status (stTab), and FULL and blanks for the counter: 4 words each, an
// upper shift, 10 characters and the end code in the last word, so that a frame never reads a
// word after one as text.
stPun,  type340 "\UPUNCHED   "
stRd,   type340 "\UREAD      "
stSav,  type340 "\USAVED     "
stLd,   type340 "\ULOADED    "
stDel,  type340 "\UDELETED   "
stBad,  type340 "\UBAD TAPE  "
stNo,   type340 "\UNO TAPE   "
stNL,   type340 "\UNOT LIFE  "
stLk,   type340 "\ULOCKED    "
stFl,   type340 "\UTAPE FULL "
txFull, type340 "\UFULL      "
txBlank, type340 "\U\U\U\U\U\U\U\U\U\U\U"

// The library screen's second row of keys, under the first, by the screen's mode (lifelib.ac's
// libMode): the built-in pages', the tape's, the paper record's. Each goes on to the page.
k2Built, ITEM(KEYY2, 0)
        type340 "\UMICROTAPE"
        next(subroutine)
        jump scrPg:1 next(subroutine)
k2Tape, ITEM(KEYY2, 0)
        type340 "\UBUILTIN"
        ITEM(KEYY2, 0d128)
k2Drv,  type340 "\UD1"                 // its first word the drive's, from tpTape
        ITEM(KEYY2, 0d256)
        type340 "\USAVE"
        ITEM(KEYY2, 0d384)
        type340 "\UDELETE"
        ITEM(KEYY2, 0d512)
        type340 "\UFIELD"
        next(subroutine)
        jump scrPg:1 next(subroutine)
k2Paper, ITEM(KEYY2, 0d512)
        type340 "\UFIELD"
        next(subroutine)
        jump scrPg:1 next(subroutine)

// A tape's page, written by tpgFill: its title, then 16 rows, two columns of 8, each its item's
// 3 words and its name's run of NAMEWDS, then on to the preview. Set 2 is enabled for the
// names' lower case.
tpgBuf, charsets(2) intensity(LBLI) next(point)
        y(BARY) next(point)
        x(0d160) next(character)
tpgT,
        table 7
        ITEM(SROWY1, 0d32)
        table NAMEWDS
        ITEM(SROWY1-0d36, 0d32)
        table NAMEWDS
        ITEM(SROWY1-0d72, 0d32)
        table NAMEWDS
        ITEM(SROWY1-0d108, 0d32)
        table NAMEWDS
        ITEM(SROWY1-0d144, 0d32)
        table NAMEWDS
        ITEM(SROWY1-0d180, 0d32)
        table NAMEWDS
        ITEM(SROWY1-0d216, 0d32)
        table NAMEWDS
        ITEM(SROWY1-0d252, 0d32)
        table NAMEWDS
        ITEM(SROWY1, 0d272)
        table NAMEWDS
        ITEM(SROWY1-0d36, 0d272)
        table NAMEWDS
        ITEM(SROWY1-0d72, 0d272)
        table NAMEWDS
        ITEM(SROWY1-0d108, 0d272)
        table NAMEWDS
        ITEM(SROWY1-0d144, 0d272)
        table NAMEWDS
        ITEM(SROWY1-0d180, 0d272)
        table NAMEWDS
        ITEM(SROWY1-0d216, 0d272)
        table NAMEWDS
        ITEM(SROWY1-0d252, 0d272)
        table NAMEWDS
        next(subroutine)
        jump scrPv:1 next(subroutine)

// The paper record's page, its one row the record read.
ppgBuf, charsets(2) intensity(LBLI) next(point)
        y(BARY) next(point)
        x(0d160) next(character)
        type340 "\UPAPER TAPE"
ppgRow, ITEM(SROWY1, 0d32)
ppgNm,
        table NAMEWDS
        next(subroutine)
        jump scrPv:1 next(subroutine)

// The record's preview text, written by recSetup: width X height, the size, the edge and the
// generation.
recInfo, ITEM(INFOY, PVTX)
recTxt,
        table 0d12
        next(subroutine)
        jump tail:0 next(parameter)

// A record's packed words, read from or written to a slot's 4 blocks; block 0's sink.
recBuf,
        table (SLOTBLKS*0400)

// The directory of the drive's tape, its 3 blocks, in bank 3.
bank 3
dirBuf,
        table DIRWDS

bank 6
