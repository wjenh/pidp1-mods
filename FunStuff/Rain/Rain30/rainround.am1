Rain Round -- four-voice round on the program flags, rain on the Type 30

// A four-voice round played by toggling program flags 1-4 (the emulator's
// four audio channels), while a rippling water surface, rained on by one
// droplet per note, is drawn on the Type 30 display. No interrupts and no
// delay loops: one loop whose every pass (a "tick") is exactly 60 memory
// cycles, 300 us. Each tick runs the four voices, then one job of exactly
// 19 cycles; 103 jobs make a frame of 30.9 ms. FunTask/DESIGN.md has the
// architecture and the timing budget; tools/cyclecheck.py proves the
// counts from the listing.
//
// Needs: bank 0 only, basic PDP-1 instructions only (no PDP-1D ops), the
// Type 30 display. song.ah is generated by tools/gensong.py.
// Build with -DMEASURE for the timing build: it enables the BBN clock and
// logs its millisecond count once per frame into mbuf (07000-07377), in a
// slot that is padding in the normal build.
//
// 22-Sep-2026 Claude: written.

// Water surface: 32 nodes across the screen, ends fixed. Heights are held
// as display words (screen units << 8), so a node is plotted as it stands.
#define NODES 0d32
#define BASEY (-0d100*0d256)
#define XN(n) ((-0d496+0d32*(n))*0d256)
#define XM(n) ((-0d480+0d32*(n))*0d256)

// Droplets: one spout per voice above a fixed column; gravity is in
// display units per frame per frame.
#define SPOUTY (0d300*0d256)
#define GRAV (0d20*0d256)
#define KICK (0d32*0d256)
#define COL1 0d5
#define COL2 0d12
#define COL3 0d19
#define COL4 0d26

#define MBUF 07000

#include "songdefs.ah"

#define PAD1 nop
#define PAD2 nop; nop
#define PAD3 nop; nop; nop
#define PAD4 PAD2; PAD2
#define PAD9 PAD4; PAD4; nop
#define PAD10 PAD9; nop
#define PAD11 PAD9; PAD2
#define PAD12 PAD9; PAD3
#define PAD13 PAD9; PAD4
#define PAD14 PAD13; nop

// One voice: advance its phase, and let the flag follow the phase's sign.
// Exactly one of clf/stf runs, so the voice costs 9 cycles either way.
#define VOICE(n) \
    lac ph##n; add in##n; dac ph##n; \
    sma; clf n; \
    spa; stf n

// Every job below is 19 cycles on every path, then jsp tick (the next
// job is the word after the jsp). The cycle counts in the comments are
// checked by tools/cyclecheck.py, not trusted.

// LOOP: once the frame counter is at the loop point, point each voice at
// its loop note. On the first pass through that frame the pointers are
// already there, so the reset is always safe.
#define LOOPJOB \
    lac fc; sas [LSTART]; jmp lpno; \
    law lp1; dac pd1; law lp2; dac pd2; law lp3; dac pd3; law lp4; dac pd4; \
    jmp lpjn; \
lpno, PAD12; \
lpjn, PAD2; \
    jsp tick

// SEQ k: when this frame is the end of voice k's note, step to the next
// (increment, end frame) pair. A non-zero increment also asks DROPA for
// a droplet.
#define SEQ(k) \
    lac fc; sas i pd##k; jmp sqno##k; \
    idx pd##k; lac i pd##k; dac in##k; dac sp##k; idx pd##k; \
    jmp sqjn##k; \
sqno##k, PAD11; \
sqjn##k, PAD2; \
    jsp tick

// DROPA k: launch a droplet from the spout, or let gravity move it.
// A resting droplet has zero gravity, so it waits at the spout.
#define DROPA(k) \
    lac sp##k; sza; jmp dasp##k; \
    lac dv##k; sub dg##k; dac dv##k; add dy##k; dac dy##k; \
    PAD2; jmp dajn##k; \
dasp##k, dzm sp##k; lac [SPOUTY]; dac dy##k; dzm dv##k; lac [GRAV]; dac dg##k; \
dajn##k, PAD3; \
    jsp tick

// DROPB k: a droplet below its node's surface has hit. It kicks that
// node's velocity down by a fixed KICK and goes back to rest at its spout.
// The kick is fixed, not taken from the penetration: a rising surface
// meets a droplet deeper, so a penetration kick feeds the waves back into
// themselves and the surface runs away. The miss path's padding is out
// of line (DROPBPAD, after the last job), since the hit path needs the
// fall-through.
#define DROPB(k) \
    lac dy##k; sub wy+COL##k; sma; jmp dbno##k; \
dbht##k, lac wv+COL##k; sub [KICK]; dac wv+COL##k; \
    lac [SPOUTY]; dac dy##k; dzm dv##k; dzm dg##k; \
dbjn##k, jsp tick
#define DROPBPAD(k) \
dbno##k, PAD12; jmp dbjn##k

// WAVEV i: v += (Laplacian - (y - level))/4: the string's tension plus
// the gravity that pulls water back to its level, summed as
// ((left - y) + (right - y) - y + level)/4, in an order that keeps every
// partial sum near a single height, far from overflow.
#define WAVEV(n) \
    lac wy+n-1; sub wy+n; add wy+n+1; sub wy+n; sub wy+n; add [BASEY]; sar 2s; \
    add wv+n; dac wv+n; \
    PAD2; \
    jsp tick

// DAMP i: v -= v/32 for nodes i and i+1.
#define DAMP(n) \
    lac wv+n; sar 5s; cma; add wv+n; dac wv+n; \
    lac wv+n+1; sar 5s; cma; add wv+n+1; dac wv+n+1; \
    PAD3; \
    jsp tick

// WAVEY i: y += v for nodes i, i+1, i+2. All velocities are done before
// any position moves.
#define WAVEY(n) \
    lac wy+n; add wv+n; dac wy+n; \
    lac wy+n+1; add wv+n+1; dac wy+n+1; \
    lac wy+n+2; add wv+n+2; dac wy+n+2; \
    PAD1; \
    jsp tick

// PN i: plot node i, then the midpoint between it and node i+1, 14
// cycles (70 us) later. dpy-i: no wait, the display finishes on its own.
#define PN(n) \
    lio wy+n; lac [XN(n)]; dpy-i 300; \
    lac wy+n+1; sub wy+n; sar 1s; add wy+n; dac tmp; lio tmp; \
    lac [XM(n)]; dpy-i 300; \
    jsp tick

// P2: plot two single points 14 cycles apart.
#define P2(ya, xa, yb, xb) \
    lio ya; lac [xa]; dpy-i 300; \
    PAD9; \
    lio yb; lac [xb]; dpy-i 300; \
    jsp tick

100/
// Start: every word the loop reads is set here, since core outlives a
// restart. AC and IO are not meaningful on entry.
begin,
    clf 7
    dzm ph1; dzm ph2; dzm ph3; dzm ph4
    dzm in1; dzm in2; dzm in3; dzm in4
    dzm sp1; dzm sp2; dzm sp3; dzm sp4
    dzm dv1; dzm dv2; dzm dv3; dzm dv4
    dzm dg1; dzm dg2; dzm dg3; dzm dg4
    lac [SPOUTY]
    dac dy1; dac dy2; dac dy3; dac dy4
    dzm fc
    law sng1; dac pd1
    law sng2; dac pd2
    law sng3; dac pd3
    law sng4; dac pd4

// Flat water at rest.
    law wy; dac yp
    law wv; dac vp
    law i NODES; dac cnt
ilp,
    lac [BASEY]; dac i yp
    dzm i vp
    idx yp
    idx vp
    isp cnt
    jmp ilp

#ifdef MEASURE
    law MBUF; dac mp
    lac [02000]         // cls: enable the clock, no interrupts
    iot 2032
#endif
    law first
    jmp tick

// The tick: 40 cycles of voices and dispatch, then the job.
// Entry: AC = address of the job to run (low 12 bits used).
tick,
    dap job
#ifdef CONTROL_SLOW
    nop                 // test build only: a 61-cycle tick measure.py must reject
#endif
    VOICE(1)
    VOICE(2)
    VOICE(3)
    VOICE(4)
    jmp i job
job, 0

// The frame's 103 jobs, in execution order.
first,
    LOOPJOB
    SEQ(1)
    SEQ(2)
    SEQ(3)
    SEQ(4)
    DROPA(1)
    DROPA(2)
    DROPA(3)
    DROPA(4)
    DROPB(1)
    DROPB(2)
    DROPB(3)
    DROPB(4)
    WAVEV(0d1)
    WAVEV(0d2)
    WAVEV(0d3)
    WAVEV(0d4)
    WAVEV(0d5)
    WAVEV(0d6)
    WAVEV(0d7)
    WAVEV(0d8)
    WAVEV(0d9)
    WAVEV(0d10)
    WAVEV(0d11)
    WAVEV(0d12)
    WAVEV(0d13)
    WAVEV(0d14)
    WAVEV(0d15)
    WAVEV(0d16)
    WAVEV(0d17)
    WAVEV(0d18)
    WAVEV(0d19)
    WAVEV(0d20)
    WAVEV(0d21)
    WAVEV(0d22)
    WAVEV(0d23)
    WAVEV(0d24)
    WAVEV(0d25)
    WAVEV(0d26)
    WAVEV(0d27)
    WAVEV(0d28)
    WAVEV(0d29)
    WAVEV(0d30)
    DAMP(0d1)
    DAMP(0d3)
    DAMP(0d5)
    DAMP(0d7)
    DAMP(0d9)
    DAMP(0d11)
    DAMP(0d13)
    DAMP(0d15)
    DAMP(0d17)
    DAMP(0d19)
    DAMP(0d21)
    DAMP(0d23)
    DAMP(0d25)
    DAMP(0d27)
    DAMP(0d29)
    WAVEY(0d1)
    WAVEY(0d4)
    WAVEY(0d7)
    WAVEY(0d10)
    WAVEY(0d13)
    WAVEY(0d16)
    WAVEY(0d19)
    WAVEY(0d22)
    WAVEY(0d25)
    WAVEY(0d28)
    PN(0d0)
    PN(0d1)
    PN(0d2)
    PN(0d3)
    PN(0d4)
    PN(0d5)
    PN(0d6)
    PN(0d7)
    PN(0d8)
    PN(0d9)
    PN(0d10)
    PN(0d11)
    PN(0d12)
    PN(0d13)
    PN(0d14)
    PN(0d15)
    PN(0d16)
    PN(0d17)
    PN(0d18)
    PN(0d19)
    PN(0d20)
    PN(0d21)
    PN(0d22)
    PN(0d23)
    PN(0d24)
    PN(0d25)
    PN(0d26)
    PN(0d27)
    PN(0d28)
    PN(0d29)
    PN(0d30)
    P2(wy+0d31, XN(0d31), dy1, XN(COL1))
    P2(dy2, XN(COL2), dy3, XN(COL3))

// The last droplet; the 14 spare cycles log the BBN clock in the
// MEASURE build (mbuf is a 256-word ring aligned on 0400).
    lio dy4; lac [XN(COL4)]; dpy-i 300
#ifdef MEASURE
    iot 32              // rck: IO = milliseconds, 0-59999
    dio i mp
    idx mp
    and [0377]
    ior [MBUF]
    dac mp
    PAD2
#else
    PAD14
#endif
    jsp tick

// FRAME: count the frame; at the loop end, back to the loop start.
    idx fc
    sas [LEND]
    jmp frno
    law LSTART
    dac fc
    jmp frjn
frno, PAD3
frjn, PAD10
    law first
    jmp tick

// DROPB's miss paths; never reached except by their jmps.
    DROPBPAD(1)
    DROPBPAD(2)
    DROPBPAD(3)
    DROPBPAD(4)

// Loop state. ph/in: voice phase and increment. pd: voice's pointer to
// the end-frame word of its current note. sp: droplet requested.
// dy/dv/dg: droplet height, velocity, gravity. fc: frame counter.
ph1, 0
ph2, 0
ph3, 0
ph4, 0
in1, 0
in2, 0
in3, 0
in4, 0
pd1, 0
pd2, 0
pd3, 0
pd4, 0
sp1, 0
sp2, 0
sp3, 0
sp4, 0
dy1, 0
dy2, 0
dy3, 0
dy4, 0
dv1, 0
dv2, 0
dv3, 0
dv4, 0
dg1, 0
dg2, 0
dg3, 0
dg4, 0
fc, 0
tmp, 0
mp, 0
yp, 0
vp, 0
cnt, 0

// Surface heights and velocities, one word per node.
wy,
    table NODES
wv,
    table NODES

#include "song.ah"

constants

start begin
