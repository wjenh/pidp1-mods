// Water blocks: VEC writes each word. A block past the last node ends
// with a static zero-length end word, so every block is the same length.
wb0,
    visible up right deltax(0d26) end
wb1,
    visible up right deltax(0d26) end
wb2,
    visible up right deltax(0d26) end
wb3,
    visible up right deltax(0d26) end
wb4,
    visible up right deltax(0d26) end
wb5,
    visible up right deltax(0d26) end
wb6,
    visible up right deltax(0d26) end
wb7,
    visible up right deltax(0d26) end
wb8,
    visible up right deltax(0d26) end
wb9,
    visible up right deltax(0d26) end
wb10,
    visible up right deltax(0d26) end
wb11,
    visible up right deltax(0d26) end
wb12,
    visible up right deltax(0d26) end
wb13,
    visible up right deltax(0d26) end
wb14,
    visible up right deltax(0d26) end
wb15,
    visible up right deltax(0d26) end
wb16,
    visible up right deltax(0d26) end
wb17,
    visible up right deltax(0d26) end
wb18,
    visible up right deltax(0d26) end
cb0,
    visible up deltay(0d2) right deltax(0d0)
    visible up deltay(0d4) right deltax(0d0)
    visible up deltay(0d3) right deltax(0d3)
    visible up deltay(0d0) right deltax(0d4)
    visible down deltay(0d1) right deltax(0d1)
    visible up deltay(0d3) right deltax(0d4)
    visible up deltay(0d0) right deltax(0d4) end
cb1,
    visible down deltay(0d3) right deltax(0d4)
    visible up deltay(0d1) right deltax(0d1)
    visible up deltay(0d0) right deltax(0d4)
    visible down deltay(0d3) right deltax(0d3)
    visible down deltay(0d4) right deltax(0d0)
    visible down deltay(0d2) right deltax(0d0) end
cb2,
    visible up deltay(0d0) left deltax(0d28) end
drop,
    visible down deltay(0d6) left deltax(0d3)
    visible down deltay(0d4) left deltax(0d1)
    visible down deltay(0d3) right deltax(0d4)
    visible up deltay(0d3) right deltax(0d4)
    visible up deltay(0d4) left deltax(0d1)
    visible up deltay(0d6) left deltax(0d3) end
ringv,
    up deltay(0d0) right deltax(0d6)
    visible up deltay(0d3) left deltax(0d3)
    visible up deltay(0d0) left deltax(0d6)
    visible down deltay(0d3) left deltax(0d3)
    visible down deltay(0d3) right deltax(0d3)
    visible up deltay(0d0) right deltax(0d6)
    visible up deltay(0d3) right deltax(0d3) end
ringi,
    up deltay(0d0) right deltax(0d6)
    up deltay(0d3) left deltax(0d3)
    up deltay(0d0) left deltax(0d6)
    down deltay(0d3) left deltax(0d3)
    down deltay(0d3) right deltax(0d3)
    up deltay(0d0) right deltax(0d6)
    up deltay(0d3) right deltax(0d3) end

// Padding ramp: pad_to_k calls into it for a list's padding fetches.
ramp,
    0
    0
    0
    0
    0
    end

// Ring table: (parameter word, subroutine word) per frame of a splash.
// The scale grows 0-3 as the intensity fades; the tail entry, where a
// finished ring rests, draws the invisible copy.
RTAB,
    scale(0) intensity(7) next(point)
    save ringv next(vector)
    scale(0) intensity(7) next(point)
    save ringv next(vector)
    scale(0) intensity(7) next(point)
    save ringv next(vector)
    scale(1) intensity(6) next(point)
    save ringv next(vector)
    scale(1) intensity(6) next(point)
    save ringv next(vector)
    scale(1) intensity(6) next(point)
    save ringv next(vector)
    scale(1) intensity(5) next(point)
    save ringv next(vector)
    scale(2) intensity(5) next(point)
    save ringv next(vector)
