Rain Round 340 -- four-voice round on the program flags, rain on the Type 340

// The Rain Round round and water, drawn by the Type 340 instead of the
// Type 30. One loop whose every pass (a "tick") is exactly 73 memory
// cycles of program: the tick runs the four voices, starts one short 340
// display list, then runs one job of exactly 16 cycles, which names the
// display list for the next tick. The 340 draws that list on its own
// while the CPU works, and its 12 fetches take 12 cycles from the CPU, so
// the tick is 85 cycles, 425 us, and the song is tuned for that. The jobs
// of one frame are generated into frame340.ah. FunTask/Rain340/DESIGN.md
// has the architecture and the timing budget; tools/cyclecheck340.py
// proves the counts from the listing, for the CPU and for the 340.
//
// Needs: bank 0 only, basic PDP-1 instructions only, the Type 340 (every
// list halts, so either t340cachesize works). Sense switches 1-6 tune
// the song ("Operator tuning" below); all off plays it as written.
// frame340.ah, lists340.ah, init340.ah, defs340.ah and song340.ah are
// generated by tools/gen340.py.
// Build with -DMEASURE for the timing build: the FRAME job's spare cycles
// enable and read the BBN clock, keeping the last millisecond count in ms
// and a frame count that never wraps in ftot.
//
// 22-Sep-2026 Claude: written.
// 24-Sep-2026 Claude: 73-cycle tick, voices before the dla.

#include <TYPE340/type340defs.ah>
#include "defs340.ah"

#define PAD1 nop
#define PAD2 nop; nop
#define PAD3 PAD2; nop
#define PAD4 PAD2; PAD2
#define PAD7 PAD4; PAD3
#define PAD8 PAD4; PAD4
#define PAD9 PAD8; nop
#define PAD10 PAD8; PAD2
#define PAD11 PAD8; PAD3

// One voice: advance its phase, and let the flag follow the phase's sign.
// Exactly one of clf/stf runs, so the voice costs 9 cycles either way.
// SEQ points va's address at the note's entry in the tuned table, so the
// voice follows the operator's tuning even within a held note.
#define VOICE(n) \
    lac ph##n; va##n, add nt; dac ph##n; \
    sma; clf n; \
    spa; stf n

// The same voice as a pulse on a quarter of the cycle: the flag is set
// only while the phase's top two bits are both 1 (the ral puts bit 1 in
// the sign, the and keeps it only where bit 0 is set too). A square
// wave has odd harmonics only, the clarinet's hollow sound; the quarter
// pulse has every harmonic but each fourth, a brighter, nasal tone. 12
// cycles either way; gen340.py --bass=pulse uses it for voice 3 and
// takes the 3 extra cycles from TICKPAD.
#define PULSE(n) \
    lac ph##n; va##n, add nt; dac ph##n; \
    ral 1s; and ph##n; \
    sma; clf n; \
    spa; stf n

// Every job is 16 cycles of work on every path, then NEXT: IO gets the
// display list the next tick's dla starts, and jsp returns to the tick
// (the next job is the word after the jsp). The counts in the comments
// are checked by tools/cyclecheck340.py, not trusted.
#define NEXT(s) lio [s]; jsp tick

// LOOP: once the frame counter is at the loop point, point each voice at
// its loop note. The miss path's padding is out of line (lpno).
#define LOOPJOB(s) \
    lac fc; sas [LSTART]; jmp lpno; \
    law lp1; dac pd1; law lp2; dac pd2; law lp3; dac pd3; law lp4; dac pd4; \
lpjn, NEXT(s)

// SEQ k: when this frame is the end of voice k's note, step to the next
// (tuned-table address, end frame) pair.
#define SEQ(k, s) \
    lac fc; sas i pd##k; jmp sqno##k; \
    idx pd##k; lac i pd##k; dap va##k; idx pd##k; PAD1; jmp sqjn##k; \
sqno##k, PAD10; \
sqjn##k, NEXT(s)

// Operator tuning. Sense switches 1-5 are an amount a, switch 1 the
// highest bit, and switch 6 lowers instead of raising: each note sounds
// at base x (1 +- a/128), up to 24%. The operator sets them by ear, as
// the emulator's speed or the machine's calls for. The five TUNE jobs
// retune one entry of the note table per frame, cycling through all
// 040, so a change settles within 040 frames. t = sum of a_j x base x
// 2^(j-7) is done by Horner's rule on base/8, most significant switch
// last; TADD adds bq when switch n is on and a zero word when off, 4
// cycles either way, and TSIGN negates on switch 6 in 3 either way. A
// rest's base 0 stays +0 through the cma, since adding +0 to -0 gives
// +0.
#define TADD(n) szs n; add bq; szs i n; add [0]
#define TSIGN szs i 60; nop; szs 60; cma

// The work of each TUNE job, apart, so begin can tune the whole table.
#define TUNEPW idx ti; and [037]; dac ti; add [nb]; dac tb; add [040]; dac tt
#define TUNEAW lac i tb; sar 3s; dac bq; cla; TADD(50); sar 1s; dac ta
#define TUNEBW lac ta; TADD(40); sar 1s; TADD(30); sar 1s; dac ta
#define TUNECW lac ta; TADD(20); sar 1s; TADD(10); TSIGN; dac ta
#define TUNEDW lac ta; add i tb; dac i tt

#define TUNEP(s) TUNEPW; PAD2; NEXT(s)
#define TUNEA(s) TUNEAW; PAD2; NEXT(s)
#define TUNEB(s) TUNEBW; PAD2; NEXT(s)
#define TUNEC(s) TUNECW; NEXT(s)
#define TUNED(s) TUNEDW; PAD8; NEXT(s)

// SPAWN k: voice k has moved to another note or rest (its add word
// changed; the song separates repeated notes with rests). A note
// (non-zero increment) asks DROPA for a droplet; a rest asks for
// nothing. The add word's address field is the table entry, which the
// indirect load reads.
#define SPAWN(k, s) \
    lac va##k; sas oin##k; jmp spch##k; PAD11; jmp spjn##k; \
spch##k, dac oin##k; lac i oin##k; dac sp##k; PAD4; \
spjn##k, NEXT(s)

// CLOUD k: cloud k glows while voice k sounds and dims when it rests, so
// the clouds light up as the voices enter and pulse with every note.
#define CLOUD(k, s) \
    lac i va##k; sza; jmp clon##k; lac [CLDIM]; jmp clst##k; \
clon##k, lac [CLBRIGHT]; \
clst##k, dac cp##k##0; dac cp##k##1; dac cp##k##2; PAD3; \
    NEXT(s)

// DROPA k: launch a droplet from the cloud, or let gravity move it. A
// resting droplet has zero gravity, so it waits at the cloud.
#define DROPA(k, s) \
    lac sp##k; sza; jmp dasp##k; \
    lac dv##k; sub dg##k; dac dv##k; add dy##k; dac dy##k; PAD2; jmp dajn##k; \
dasp##k, dzm sp##k; lac [SPOUT]; dac dy##k; dzm dv##k; lac [GRAV]; dac dg##k; \
dajn##k, NEXT(s)

// DROPB k: a droplet below its node's surface has hit. It kicks that
// node's velocity down by a fixed KICK and starts its splash ring. A kick
// taken from the penetration would feed the waves back into themselves
// (Rain Round's lesson). The miss path's padding is out of line (dbno).
#define DROPB(k, c, s) \
    lac dy##k; sub wy+c; sma; jmp dbno##k; \
dbht##k, lac wv+c; sub [KICK]; dac wv+c; law RTAB; dac rp##k; PAD2; \
dbjn##k, NEXT(s)

// DROPC k: a droplet whose ring has just started (the ring pointer is
// at the table's head) goes back to rest at its cloud.
#define DROPC(k, s) \
    lac rp##k; sas [RTAB]; jmp dcno##k; \
    lac [SPOUT]; dac dy##k; dzm dv##k; dzm dg##k; PAD3; jmp dcjn##k; \
dcno##k, PAD11; \
dcjn##k, NEXT(s)

// DROPD k: the same hit also kicks node c's neighbors, by half. A
// [1/2, 1, 1/2] kick gives nothing to the highest wave mode, where
// neighboring nodes swing opposite ways; that mode makes the steepest
// segments, and a steep segment takes the 340 longest to draw. The miss
// path's padding is out of line (ddno); the hit path falls through.
#define DROPD(k, c, s) \
    lac rp##k; sas [RTAB]; jmp ddno##k; \
    lac wv+c-1; sub [HALFKICK]; dac wv+c-1; lac wv+c+1; sub [HALFKICK]; dac wv+c+1; \
ddjn##k, NEXT(s)

// RINGA k: the ring's next (parameter, subroutine) words, from the ring
// table: its scale grows and its intensity fades frame by frame.
#define RINGA(k, s) \
    lac i rp##k; dac rpar##k; idx rp##k; lac i rp##k; dac rsav##k; idx rp##k; \
    PAD2; NEXT(s)

// RINGB k: a ring that has used the table's tail entry is held there,
// where it draws an invisible copy of the same length.
#define RINGB(k, s) \
    lac rp##k; sas [RTAIL+2]; jmp rbno##k; law RTAIL; dac rp##k; PAD8; jmp rbjn##k; \
rbno##k, PAD11; \
rbjn##k, NEXT(s)

// DROPY: two droplets' y anchor words. A height relative to the level,
// in raster units x 128, shifted down 7 is the raster offset from LEVEL.
#define DROPY(k1, k2, s) \
    lac dy##k1; sar 7s; add [y(LEVEL) next(point)]; dac dly##k1; \
    lac dy##k2; sar 7s; add [y(LEVEL) next(point)]; dac dly##k2; \
    PAD2; NEXT(s)

// RINGY: two rings' y anchor words, from the water at their columns.
#define RINGY(k1, c1, k2, c2, s) \
    lac wy+c1; sar 7s; add [y(LEVEL) next(point)]; dac ry##k1; \
    lac wy+c2; sar 7s; add [y(LEVEL) next(point)]; dac ry##k2; \
    PAD2; NEXT(s)

// WAVEV i: v += (Laplacian - y)/4, the string's tension plus the pull
// back to the level (heights are relative to it, so the pull is -y).
#define WAVEV(n, s) \
    lac wy+n-1; add wy+n+1; sub wy+n; sub wy+n; sub wy+n; sar 2s; \
    add wv+n; dac wv+n; \
    PAD1; NEXT(s)

// DY i: v -= v/32, then y += v. All velocities are done before any
// position moves.
#define DY(n, s) \
    lac wv+n; sar 5s; cma; add wv+n; dac wv+n; add wy+n; dac wy+n; \
    PAD4; NEXT(s)

// VEC i: the vector word for the water from node i to node i+1, at
// scale 1. Heights are raster x 128, so |dy| x 128 is already the delta
// field (2 raster units per step) in bits 8-14. It is rounded, and the
// direction comes from the sign. vp/vn carry the rest of the word.
#define VEC(n, m, w, vp, vn, s) \
    lac wy+n+1; sub wy+n; spa; jmp vng##m; \
    add [0200]; and [077400]; ior [vp]; PAD1; jmp vjn##m; \
vng##m, cma; add [0200]; and [077400]; ior [vn]; \
vjn##m, dac w; PAD1; \
    NEXT(s)

// WANCH j: the y anchor words of water display list j for all three
// layers, from list j's first node n: the surface, and depth lines 70 and 140
// raster units below it.
#define WANCH(j, n, s) \
    lac wy+n; sar 7s; add [y(LEVEL) next(point)]; \
    dac wa0##j; sub [0d70]; dac wa1##j; sub [0d70]; dac wa2##j; \
    PAD1; NEXT(s)

100/
// Start: every word the loop reads, and every display word the loop
// patches, is set here, since core outlives a restart. AC and IO are not
// meaningful on entry.
begin,
    clf 7
    dzm ph1; dzm ph2; dzm ph3; dzm ph4
    law nt; dap va1; dap va2; dap va3; dap va4
    dzm oin1; dzm oin2; dzm oin3; dzm oin4
    dzm sp1; dzm sp2; dzm sp3; dzm sp4
    dzm dv1; dzm dv2; dzm dv3; dzm dv4
    dzm dg1; dzm dg2; dzm dg3; dzm dg4
    lac [SPOUT]
    dac dy1; dac dy2; dac dy3; dac dy4
    law RTAIL
    dac rp1; dac rp2; dac rp3; dac rp4
    dzm fc
    dzm ftot
    law sng1; dac pd1
    law sng2; dac pd2
    law sng3; dac pd3
    law sng4; dac pd4

// Tune the whole table to the switches as they are now, so a song
// started with them set is in tune from its first note.
    dzm ti
    law i 040; dac cnt
tlp,
    TUNEPW; TUNEAW; TUNEBW; TUNECW; TUNEDW
    isp cnt
    jmp tlp

// Still water.
    law wy; dac yp
    law wv; dac vp
    law i NODES; dac cnt
ilp,
    dzm i yp
    dzm i vp
    idx yp
    idx vp
    isp cnt
    jmp ilp

#include "init340.ah"

#ifdef MEASURE
    lac [02000]         // cls: enable the BBN clock, no interrupts
    iot 2032
#endif
    lio [FIRSTLIST]
    law first
    jmp tick

// The tick: padding, voices, display start and dispatch (41 cycles and
// the padding), then the job. The voices come last before the dla, as
// long after the previous one as the loop allows: the 340 fetches its
// list in the first part of the tick, and a fetch's stolen cycle landing
// between a tick's start and a voice's flag operation would move that
// edge. TICKPAD (13 nops by default, 10 with the pulse bass) sets the
// tick's length, 85 cycles with the steals; gen340.py says why.
// Entry: AC = address of the job to run (low 12 bits used); IO = the
// display list to start, which the voices leave alone.
tick,
    dap job
    TICKPAD
#ifdef CONTROL_SLOW
    nop                 // test build only: a 74-cycle tick the checks must reject
#endif
    VOICE(1)
    VOICE(2)
#ifdef BASSPULSE
    PULSE(3)
#else
    VOICE(3)
#endif
    VOICE(4)
    dla
    jmp i job
job, 0

// The frame's jobs, in execution order, each naming the display list
// of the tick after it.
first,
#include "frame340.ah"

// Out-of-line padding for the jobs whose fall-through arm is the busy one.
// Never reached except by their jmps.
lpno, PAD10; jmp lpjn
dbno1, PAD9; jmp dbjn1
dbno2, PAD9; jmp dbjn2
dbno3, PAD9; jmp dbjn3
dbno4, PAD9; jmp dbjn4
ddno1, PAD10; jmp ddjn1
ddno2, PAD10; jmp ddjn2
ddno3, PAD10; jmp ddjn3
ddno4, PAD10; jmp ddjn4

// Loop state. ph: voice phase. oin: the voice's add word SPAWN saw
// last. pd: the voice's pointer to the end-frame word of its current
// note. sp: droplet requested. dy/dv/dg: droplet height (raster x 128,
// from the level), velocity, gravity. rp: ring table pointer. fc: frame
// counter, which loops with the song; ftot: frames, never reset but by
// begin (the MEASURE build's count). ti: the note table index the TUNE
// jobs are on; tb/tt: its base and tuned entries; bq: base/8; ta: the
// correction so far.
ph1, 0
ph2, 0
ph3, 0
ph4, 0
oin1, 0
oin2, 0
oin3, 0
oin4, 0
pd1, 0
pd2, 0
pd3, 0
pd4, 0
sp1, 0
sp2, 0
sp3, 0
sp4, 0
dy1, 0
dy2, 0
dy3, 0
dy4, 0
dv1, 0
dv2, 0
dv3, 0
dv4, 0
dg1, 0
dg2, 0
dg3, 0
dg4, 0
rp1, 0
rp2, 0
rp3, 0
rp4, 0
fc, 0
ftot, 0
ms, 0
yp, 0
vp, 0
cnt, 0
ti, 0
tb, 0
tt, 0
bq, 0
ta, 0

// Water heights and velocities, raster units x 128 from the level. Nodes
// 0 and NODES-1 are the fixed ends and are never written after start.
wy,
    table NODES
wv,
    table NODES

constants

// Display lists and the ring table, then the song.
#include "lists340.ah"
#include "song340.ah"

start begin
