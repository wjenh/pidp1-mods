File /home/wje/PDP-1/pidp1-mods/Am1Includes/farmemcpy.ac
   3: // Copy from one mem bank to another.
   4: // Call using jda.
   5: // AC has the count of words to copy.
   6: // The word following the call has the address to copy from
   7: // The next word has the address to copy to
   8: // Both can have extended addresses.
   9: // If extended mode is on, it will be turned off on return.
  10: 011000 000000 farmemcpy, 0
  11: 011001 000000 local
  12: // AC is in farmemcpy, return PC in AC
  13: 011001 720074 lem
  14: 011002 261027 dap %cpydn
  15: 011003 231027 lio i %cpydn
  16: 011004 321030 dio %ads
  17: 011005 441027 idx %cpydn
  18: 011006 231027 lio i %cpydn
  19: 011007 321031 dio %adt
  20: 011010 441027 idx %cpydn
  21: 011011 201000 lac farmemcpy
  22: 011012 761000 cma
  23: 011013 724074 eem
  24: 011014 400150 %cl, add [1]
  25: 011015 760060 lsw
  26: 011016 211030 lac i %ads
  27: 011017 251031 dac i %adt
  28: 011020 441030 idx %ads
  29: 011021 441031 idx %adt
  30: 011022 760060 lsw
  31: 011023 640100 sza
  32: 011024 601014 jmp %cl
  33: 011025 720074 lem
  34: 011026 611027 jmp i %cpydn
  35: 011027 000000 %cpydn, 0
  36: 011030 000000 %ads, 0
  37: 011031 000000 %adt, 0
  38: 011032 000000 endloc
File rotate.am1
  30: // The channel 0 interrupt setup.
  31: // We execute a bit of code that will get
  32: // overwritten but reloaded on pgm switch.
  33: // This never gets executed, it's for ease of copying to bank 0.
  34: 011032        0/
  35: 010000 720074 lem
  36: 010001 607757 jmp go
  37: 010002 000000 0
  38: 010003 607751 jmp isr
  40: // We start at 100
  41: 010004        100/
  42: 010100 720074 lem
  43: 010101 720054 lsm
  44: 010102 760400 hlt
  45: 010103 762200 lat      // the test switches say which 6 progs to run
  46: 010104 240146 dac pgm
  47: 010105 760400 hlt
  48: 010106 762200 lat
  49: 010107 240147 dac pgm2
  51: // Control transfers here on every timeout, we will already be in extended mode.
  52: // Get the drum pgm to load, 6 sets of 6 bits, high bit in each ignored, and rotate them.
  53: 010110        resume,
  54: 010110 200146 lac pgm
  55: 010111 760020 lia
  56: 010112 200147 lac pgm2
  57: 010113 673077 rcr 6s
  58: 010114 240147 dac pgm2
  59: 010115 760040 lai
  60: 010116 240146 dac pgm
  61: // mask to get pgm track to load
  62: 010117 020152 and [37]
  63: 010120 665077 sal 6s
  64: 010121 665077 sal 6s
  66: // load bank 0 mem from drum
  67: 010122 040153 ior [400000]
  68: 010123 760020 lia
  69: 010124 720061 iot 61
  70: 010125 764000 cli
  71: 010126 720062 iot 62
  72: 010127 720063 iot 63
  74: // Yes, that's all it took to read a full memory image and load it into bank 0.
  75: // Bank 0 now has pgm loaded, update with our glue code.
  76: 010130 700004 law 4
  77: 010131 171000 jda farmemcpy
  78: 010132 010000 10000
  79: 010133 000000 0
  80: 010134 700012 law end-isr
  81: 010135 171000 jda farmemcpy
  82: 010136 017751 isr:1
  83: 010137 007751 isr
  85: // turn on ints, extended mem, and transfer back to bank 0, adr 0
  86: 010140 720055 esm
  87: // enable the clock
  88: 010141 703000 law 2000 1000      // 1 min interrupt enabled, clock enabled
  89: 010142 722032 iot 2032
  90: 010143 724074 eem
  91: 010144 724074 eem;
  91: 010145 610151 jmp i [0]
  93: // put this out now so we don't step on high mem
  94: 010146 000000 pgm, 0
  95: 010147 000000 pgm2, 0
  96: 010150        constants
  96: 010150 000001 
  96: 010151 000000 
  96: 010152 000037 
  96: 010153 400000 

  98: // The bank 0 transfer-back code.
  99: // It resides in the usual loader area starting at 7751.
 100: // Again, it's here to make it easy to copy.
 101: // The clock interrupt comes here, isr, 7751.
 102: // We have to jump thru hoops jumping to rti
 103: // because you can't enable extended mem while in
 104: // the interrupt and have it stick.
 105: 010154        7751/
 106: 017751 707754 isr, law rti
 107: 017752 240001 dac 1
 108: 017753 610001 jmp i 1
 110: // the interrupt return jumps here, jump back to the control code
 111: 017754 724074 rti, eem
 112: 017755 724074 eem;
 112: 017756 617762 jmp i [resume:1]
 114: // We jump here when control is transferred from bank 1,
 115: // if no start addr, go on to next pgm.
 116: 017757 207773 go, lac 7773
 117: 017760 640100 sza
 118: 017761 617773 jmp i 7773      // transfer to the loaded program
 119: 017762        constants
 119: 017762 010110 

 120: 017763        end,
start 10100
