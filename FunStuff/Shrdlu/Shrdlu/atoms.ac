cNil, ascii "NIL"
cIs, ascii "#IS"
cManip, ascii "#MANIP"
cShape, ascii "#SHAPE"
cColor, ascii "#COLOR"
cSupport, ascii "#SUPPORT"
cCleartop, ascii "#CLEARTOP"
cContain, ascii "#CONTAIN"
cCall, ascii "#CALL"
cStart, ascii "#START"
cAt, ascii "#AT"
cGrasping, ascii "#GRASPING"
cNoclear, ascii "#NOCLEAR"
cBlock, ascii "#BLOCK"
cPyramid, ascii "#PYRAMID"
cBox, ascii "#BOX"
cTable, ascii "#TABLE"
cRect, ascii "#RECTANGULAR"
cPointed, ascii "#POINTED"
cRound, ascii "#ROUND"
cRed, ascii "#RED"
cGreen, ascii "#GREEN"
cBlue, ascii "#BLUE"
cWhite, ascii "#WHITE"
cBlack, ascii "#BLACK"
cRobot, ascii "#ROBOT"
cPerson, ascii "#PERSON"
cHand, ascii "#HAND"
cShrdlu, ascii "SHRDLU"
cYou, ascii "YOU"
cCommand, ascii "COMMAND"
cPuton, ascii "#PUTON"
cPutin, ascii "#PUTIN"
cPickup, ascii "#PICKUP"
cGrasp, ascii "#GRASP"
