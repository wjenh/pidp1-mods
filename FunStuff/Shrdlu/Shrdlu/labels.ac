// The idle labels are two letters beside each visible colored object (RD, GR,
// BL) while the program waits at READY for the first character of a line,
// and gone from that character until the next READY. The group is the
// sixth of each display buffer's table (dlist.ac); here are the gate's two
// routines, called from the reader's poll, and the overlay lbl that builds
// the list.
// The root's part is in bank 1, which has the room, and reads the reader's
// words by full address. The overlay is in bank 012, eem on. Needs
// shrdlu.ah, <TYPE340/type340alt.ah>, dlist.ac (lbOff, lbBuf, lbSt, lbR,
// grpTab), cache.ac (the piece cache), world.ac (objTab, wHeld) and the
// overlay manager before it.
// NOLBHIDE, defined, builds without the labels' removal at the first
// character.

// The first character of a line turns the labels off. Each is a word
// store, so the break routine finds either table's entry whole.
// AC is clobbered and IO is preserved (the poll holds a character in it).
// Called via jsp from any bank.
bank 1
lbHide, dac lbR
#ifdef NOLBHIDE
    jmp i lbR               // the labels stay on once they are on
#endif
    lac lbSt
    sza i
    jmp i lbR
    dzm lbSt
    lac [lbOff:1]
    dac i [(grpTab:0)+GLABEL]
    dac i [(grpTab:0)+GHAND+GLABEL]
    jmp i lbR

// Called when the reader's poll found nothing more to read. If the program
// is waiting for the first character of a line (no command ready, nothing
// of a sentence or a command line begun, the cursor at a line's start) and
// the labels are not on, builds them and turns them on.
// AC and IO are clobbered. Called via jsp from any bank.
lbIdle, dac lbR
    lac lbSt
    sza
    jmp i lbR
    lac i [tReady:0]
    ior i [rSLen:013]
    ior i [rWLen:013]
    ior i [rMode:013]
    sza
    jmp i lbR
    lac i [rBol:013]
    sza i
    jmp i lbR
    %%ovcall lbl, lbMain
    law 1
    dac lbSt
    lac [lbBuf:1]
    dac i [(grpTab:0)+GLABEL]
    dac i [(grpTab:0)+GHAND+GLABEL]
    jmp i lbR
constants

bank 012
%%overlay lbl, cmdWin

    export lbMain

// A label's letters in the 340's character set 1 (A is 01), two to a word
// followed by the end character as the word's third.
#define LBCH(a, b) (((a) << 0d12) | ((b) << 6) | 037)

// Writes the labels' group into lbBuf. For each colored object that has a
// visible piece in the piece cache, it writes a parameter word (the
// letters' scale and intensity), a point at the middle of its longest
// visible piece, up and right of it by LBDX and LBDY and kept inside the
// raster, and the letters. Then it writes a halt. At most NOBJ labels of
// four words, and the halt. LBWORDS is sized for the eight labels the
// colored objects make. The pieces are the last rebuild's (cache.ac). An
// object whose pieces did not fit the cache (count -1), or which none of
// the scene shows, gets none. The held object, which the cache does not
// hold, is labeled from the hand's point (lmHeld).
// AC and IO are clobbered. Entered via %%ovcall, with the return in AC.
lbMain, dac lmRtn
    lac [lbBuf:1]
    dac lmP
    dzm lmO
    // The object's record in the table, and its color.
lmObj, lac lmO
    sal 2s
    dac lmT
    sal 1s
    add lmT
    add [objTab:2]
    add [RCOLOR]
    dac lmT
    lac i lmT
    dac lmC
    sub [CWHITE]
    sma
    jmp lmNext              // the box, the table, the walls
    lac lmO
    sad i [wHeld:0]
    jmp lmHeld
    // The cache's record of its slot holds the pieces kept, -1 if not good.
    lac lmO
    sal 4s
    add [pcRecs:2]
    add [0d10]
    dac lmT
    lac i lmT
    spa
    jmp lmNext
    sza i
    jmp lmNext
    cma
    dac lmN
    lac lmO
    sal 7s
    add [pcSlots:3]
    dac lmS
    dzm lmBest
    // The longest piece (the sum of its two extents) and its middle.
lmPc, lac i lmS
    dac lmX0
    idx lmS
    lac i lmS
    dac lmY0
    idx lmS
    lac i lmS
    dac lmX1
    idx lmS
    lac i lmS
    dac lmY1
    idx lmS
    lac lmX1
    sub lmX0
    spa
    cma
    dac lmL
    lac lmY1
    sub lmY0
    spa
    cma
    add lmL
    dac lmL
    sub lmBest
    spa
    jmp lmPn
    sza i
    jmp lmPn
    lac lmL
    dac lmBest
    lac lmX0
    add lmX1
    sar 1s
    dac lmMx
    lac lmY0
    add lmY1
    sar 1s
    dac lmMy
lmPn, isp lmN
    jmp lmPc
    lac lmBest
    sza i
    jmp lmNext
    // The point, offset and kept inside the raster.
lmPt, lac lmMx
    add [LBDX]
    dac lmMx
    sub [LBMAXX]
    spa
    jmp lmXok
    lac [LBMAXX]
    dac lmMx
lmXok, lac lmMy
    add [LBDY]
    dac lmMy
    sub [LBMAXY]
    spa
    jmp lmYok
    lac [LBMAXY]
    dac lmMy
lmYok, lac [scale(LBSCALE) | intensity(LBINT) | next(point)]
    dac i lmP
    idx lmP
    lac lmMy
    ior [0200000 | next(point)]
    dac i lmP
    idx lmP
    lac lmMx
    ior [next(character)]
    dac i lmP
    idx lmP
    lac lmC
    add [lmLet:.]           // a full address, since lac i below reads through it
    dac lmT
    lac i lmT
    dac i lmP
    idx lmP
lmNext, idx lmO
    lac lmO
    sub [NOBJ]
    sma
    jmp lmEnd
    jmp lmObj
lmEnd, lac [halt | interrupt]
    dac i lmP
    jmp i lmRtn
    // The held object has no pieces in the cache. Its group is drawn whole
    // from one point, the hand's place on the screen plus the offset
    // heldBuild left (hbOffX, hbOffY), which is a vertex of the object.
    // The label goes from there, and not below the raster's edge.
lmHeld, lac i [hsx:0]
    add i [hbOffX:0]
    spa
    cla
    dac lmMx
    lac i [hsy:0]
    add i [hbOffY:0]
    spa
    cla
    dac lmMy
    jmp lmPt

// RD, GR, BL, by the color's number. A is 01, B 02, D 04, G 07, L 014, R 022.
lmLet, LBCH(022, 04)
    LBCH(07, 022)
    LBCH(02, 014)

lmRtn, 0                    // the full address lbMain returns to
lmP, 0                      // the list's next word
lmO, 0                      // the object
lmT, 0
lmC, 0                      // its color
lmN, 0                      // its pieces left, negative
lmS, 0                      // the next piece
lmBest, 0                   // the longest piece's extents
lmL, 0
lmX0, 0
lmY0, 0
lmX1, 0
lmY1, 0
lmMx, 0
lmMy, 0
%%endoverlay
