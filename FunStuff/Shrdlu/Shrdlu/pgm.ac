// The machine's hot half. It holds the loop, the operations, the calls
// and returns, the cells, and the natives a sentence calls most. It runs
// the semantics, the answers and the grammar as bytecode
// (semantics.ac, which is generated).
// Micro-Planner is the engine in planner.ac.
// The cold half, pgsys.ac in bank 012, has
// the sentence's start and end, the cache's misses, the drum, the
// collector, the property lists of atoms, the printing, the engine's
// hooks and the other natives, each reached with a far call.
// A function's block runs where the cache holds it. gBlk gives its
// address, with BMADE once its quoted lists are made this sentence. A
// call that finds no address or no BMADE goes to psEnter. A frame is PFW
// words on the calls: the return, the bindings' top, the caller's block,
// and 0, or for a catch frame (CATCH) the value stack's top with PFCATCH.
// A variable is a word of vTab. Binding one pushes the variable and its
// old value on the bindings.
// A native's arguments stay on the value stack until its value is made,
// so the collector, which any CONS may run, finds them. Each native ends
// by dropping them and pushing its value (pgR1 and the like).
// A stop (an abandoned sentence, NO ROOM, a fault) jumps to pgStop from
// wherever it is found, in either half.
// Bank 6 above the engine's heap, eem on throughout, so every indirect
// reference is a full address. Needs shrdlu.ah, semantics.ac and
// pgsys.ac.

// The value stack. pgSp is its next free word.
#define PGPUSH dac i pgSp; idx pgSp
#define PGPOP law i 1; add pgSp; dac pgSp; lac i pgSp
#define PGDROP law i 1; add pgSp; dac pgSp
#define PGTOP law i 1; add pgSp; dac pgT; lac i pgT
// A native's argument i of k, the first 1, to AC.
#define ARG(nk, ni) law i (nk-ni+1); add pgSp; dac pgT; lac i pgT
// The value stack's room above a function's use, for the natives.
#define PVSPARE 020

// The sentence's top level, from pgSent (pgsys.ac), which has set the
// stacks, the variables and the cache's state. Its frame returns
// nowhere.
pgRun, dzm pgIp
    law 07777
    dac pgFn
    law fnTOP
    jmp pgCallF

// The ends of a sentence, the top level's return and a stop.
// pgStop takes the status (pgSent's) in AC.
pgDone, cla
pgStop, dac pgStat
    lac [PBSTK]
    jda pgUnbTo
    XJSP(psEnd, 012)
    lac pgStat
    jmp i pgRtn
pgErr, law 1
    jmp pgStop
pgRoom, law 2
    jmp pgStop
pgFlt, lac pgIp
    dac pgFltA
    law 4
    jmp pgStop

// The machine's loop. It fetches an operation's word, puts its operand in pgA,
// and enters its routine through pgOps, which has an entry for any six
// bits, so nothing here checks them. A routine enters with AC the entry's
// address and IO the operand, and reads neither. Each ends by jumping back
// here, to pgPushL with a value to push, or to pgGo with pgJ the next word.
pgLoop, lio i pgIp
    idx pgIp
    cla
    rcl 6s                  // AC the operation, IO the operand shifted up
    add [pgOps:.]
    dac pgT
    rir 6s                  // IO the operand, its top six bits clear
    dio pgA
    jmp i pgT
pgPushT, lac [KSYM]         // T
    jmp pgPushL
pgPushN, cla                // NIL
pgPushL, PGPUSH
    jmp pgLoop

// A native's end. Drops its k arguments and pushes its value, from
// AC (pgRk), T (pgTk) or NIL (pgNk).
pgR1, dac pgV
    law i 1
    jmp pgRn
pgR2, dac pgV
    law i 2
    jmp pgRn
pgR3, dac pgV
    law i 3
pgRn, add pgSp
    dac pgSp
    lac pgV
    jmp pgPushL
pgT1, lac [KSYM]
    jmp pgR1
pgT2, lac [KSYM]
    jmp pgR2
pgT3, lac [KSYM]
    jmp pgR3
pgN1, cla
    jmp pgR1
pgN2, cla
    jmp pgR2
pgN3, cla
    jmp pgR3

// A one-argument native's end, in place. The value, in AC (pgIV), T
// (pgIT) or NIL (pgIN), is written over the argument's slot, which pgT still
// holds since ARG(1, 1) and no helper the native calls touches it. The
// stack pointer stays, where pgR1 moves it down and back up.
pgIN, cla
pgIV, dac i pgT
    jmp pgLoop
pgIT, lac [KSYM]
    jmp pgIV

// A call of function AC. The stacks are checked for room and the frame
// pushed, then it goes on to the function's code, through psEnter if the block
// is not in the cache or its quoted lists are not made.
pgCallF, dac pgJ
    lac pgSp
    sub [PVSTK+PVLEN-MAXDEPTH-PVSPARE]
    sma
    jmp pgRoom
    lac pgCp
    sub [PCSTK+PCLEN-PFW]
    sma
    jmp pgRoom
    lac pgIp
    dac i pgCp
    idx pgCp
    lac pgBp
    dac i pgCp
    idx pgCp
    lac pgFn
    dac i pgCp
    idx pgCp
    dzm i pgCp
    idx pgCp
pgEnter, lac pgJ
    dac pgFn
    ral 2s
    add [gBlk:5+BADDR]
    dac pgT
    lac i pgT
    sma                     // skip if BMADE, the quoted lists are made
    jmp pgMiss
    and [0177777]
    sza i
    jmp pgMiss
    add [BLKHDR]
    dac pgIp
    jmp pgLoop
pgMiss, XJSP(psEnter, 012)
    jmp pgLoop
pgGo, lac pgJ
    dac pgIp
    jmp pgLoop

// Puts the jump's target in pgJ. It is the jump's word's address plus the
// operand, a 12-bit two's-complement number. There is no long jump. The
// compiler refuses a function that needs one.
// Takes no arguments.
// AC is clobbered and IO is preserved.
// Called via jsp.
pgTgt,
    local rtn
    dap rtn
    law i 1
    add pgIp
    add pgA
    dac pgJ
    lac pgA
    and [04000]
    sza i
    jmp rtn
    lac pgJ
    sub [010000]
    dac pgJ
rtn, jmp 0
    endloc

// Binds variable pgA to AC. The variable and its old value are pushed on the
// bindings, then the new value is set.
pgBind, dac pgV
    lac pgBp
    sub [PBSTK+PBLEN-2]
    sma
    jmp pgRoom
    lac pgA
    dac i pgBp
    idx pgBp
    lac pgA
    add [vTab:3]
    dac pgT
    lac i pgT
    dac i pgBp
    idx pgBp
    lac pgV
    dac i pgT
    jmp pgLoop

// Unbinds down to a mark. Each variable bound since gets its old value.
// Takes the bindings' top to return to in AC. Returns no value.
// AC and IO are clobbered.
// Called via jda.
pgUnbTo,
    local loop, rtn, p, q
    0                       // jda puts the argument here
    dap rtn
loop, lac pgBp
    sad pgUnbTo
    jmp rtn
    law i 2
    add pgBp
    dac pgBp
    dac p
    lac i p
    add [vTab:3]
    dac q
    idx p
    lac i p
    dac i q
    jmp loop
rtn, jmp 0
p, 0
q, 0
    endloc

// The operations, each as the compiler's OPS table defines it.
doNil, cla
    jmp pgPushL
doT, jmp pgPushT
doSym, lac pgA
    ior [KSYM]
    jmp pgPushL
    // A quoted list on the drum is made before its function runs.
doConst, lac pgA
    add [gConst:013]
    dac pgT
    lac i pgT
    sza i
    jmp pgFlt
    jmp pgPushL
    // A variable never set is a Lisp error.
doVar, lac pgA
    add [vTab:3]
    dac pgT
    lac i pgT
    sas [KUNB]
    jmp pgPushL
    jmp pgErr
    // VAR and PRIM CAR, VAR and PRIM CDR, each as one operation.
doVarcar, lac pgA
    add [vTab:3]
    dac pgT
    lac i pgT
    sad [KUNB]
    jmp pgErr
    jda pgCar
    jmp pgPushL
doVarcdr, lac pgA
    add [vTab:3]
    dac pgT
    lac i pgT
    sad [KUNB]
    jmp pgErr
    jda pgCdr
    jmp pgPushL
doSetv, PGTOP
    lia
    lac pgA
    add [vTab:3]
    dac pgT
    dio i pgT
    jmp pgLoop
doSetvp, PGPOP
    lia
    lac pgA
    add [vTab:3]
    dac pgT
    dio i pgT
    jmp pgLoop
doDrop, PGDROP
    jmp pgLoop
doDropn, lac pgSp
    sub pgA
    dac pgSp
    jmp pgLoop
doDup, PGTOP
    jmp pgPushL
doSlide, PGPOP
    dac pgV
    lac pgSp
    sub pgA
    dac pgSp
    lac pgV
    jmp pgPushL
doJmp, jsp pgTgt
    jmp pgGo
doJf, jsp pgTgt
    PGPOP
    sza i
    jmp pgGo
    jmp pgLoop
doJt, jsp pgTgt
    PGPOP
    sza
    jmp pgGo
    jmp pgLoop
doJfk, jsp pgTgt
    PGTOP
    sza i
    jmp pgGo
    PGDROP
    jmp pgLoop
doJtk, jsp pgTgt
    PGTOP
    sza
    jmp pgGo
    PGDROP
    jmp pgLoop
doCall, lac pgA
    jmp pgCallF
    // EVAL of the top, its leaves done here as the evaluator does them.
    // NIL and T are themselves, a symbol whose variable is bound its
    // value. Anything else, or a symbol with no variable bound, is the
    // native evaluator's (eval.ac).
doEvs,
    local call
    PGTOP
    sza i
    jmp pgLoop
    dac pgV
    and [KMASK]
    sas [KSYM]
    jmp call
    lac pgV
    sad [KSYM]
    jmp pgLoop
    jda pgVarOf
    spa
    jmp call
    add [vTab:3]
    dac pgV
    lac i pgV
    sad [KUNB]
    jmp call
    dac i pgT
    jmp pgLoop
call, jmp i [evlEnter:015]
    endloc
    // The frames popped to the call frame, catch frames a RETURN or GO
    // left with it; its bindings undone. The top level's frame, whose
    // return is 0, ends the sentence.
doRet,
    local loop
loop, law i PFW
    add pgCp
    dac pgCp
    add [PFSP]
    dac pgT
    lac i pgT
    spa                     // skip unless a catch frame
    jmp loop
    lac pgCp
    dac pgT
    lac i pgT
    dac pgJ
    idx pgT
    lac i pgT
    jda pgUnbTo
    lac pgCp
    add [PFFN]
    dac pgT
    lac i pgT
    dac pgFn
    lac pgJ
    sza i
    jmp pgDone
    jmp pgGo
    endloc
doArg, PGPOP
    jmp pgBind
doBindn, cla
    jmp pgBind
doUnbind, lac pgA
    ral 1s
    dac pgT
    lac pgBp
    sub pgT
    jda pgUnbTo
    jmp pgLoop
    // The operand is not checked. The compiler refuses a build with
    // a PRIM that numbers no native.
doPrim,
pgPrimA, lac pgA
    add [pgNats:.]
    dac pgT
    jmp i pgT
doListn, lac pgA
    jda pgStkL
    dac pgV
    lac pgSp
    sub pgA
    dac pgSp
    lac pgV
    jmp pgPushL
doCunit,
    local loop
    PGPOP
    dac pgV
    and [KMASK]
    sas [KSYM]
    jmp pgFlt
    lac pgV
    and [07777]
    dac pgV
    lac [gUnits:3]
    dac pgT
loop, lac i pgT
    sza i
    jmp pgFlt
    sad pgV
    jmp .+5
    lac pgT
    add [2]
    dac pgT
    jmp loop
    idx pgT
    lac i pgT
    jmp pgCallF
    endloc
    // NIL evaluates to NIL; a special word's code is called.
doEval, PGPOP
    sza i
    jmp pgPushL
    dac pgV
    and [KMASK]
    sas [KCODE]
    jmp pgFlt
    lac pgV
    and [07777]
    add [gSpecCode:013]
    dac pgT
    lac i pgT
    jmp pgCallF
doNote, idx pgNotes
    jmp pgLoop
doAbort, law 1
    jmp pgStop
doQuit, law 3
    jmp pgStop
doSay, XJSP(psSay, 013)
    jmp pgLoop
doCount, idx pgCalls
    sub [PBOUND+1]
    sma
    jmp doAbort
    jmp pgLoop
doCq, lac i [vTab:3+vFE]
    lia
    lac pgA
    ior [KSYM]
    jda pgMemq
    jmp pgPushL
doNq, lac i [vTab:3+vN]
    jda pgCar
    lio [KSYM+sFEATURES]
    jda pgGet
    lia
    lac pgA
    ior [KSYM]
    jda pgMemq
    jmp pgPushL
doMemqs, PGPOP
    lia
    lac pgA
    ior [KSYM]
    jda pgMemq
    jmp pgPushL
    // The node stays on the stack while its features are got.
doIsq, PGTOP
    jda pgCar
    lio [KSYM+sFEATURES]
    jda pgGet
    lia
    lac pgA
    ior [KSYM]
    jda pgMemq
    jmp pgR1
doEqs, lac pgA
    ior [KSYM]
    dac pgV
    PGPOP
    sas pgV
    jmp pgPushN
    jmp pgPushT
    // GETS, GET of the top and the operand's symbol, is GETRS without the CAR.
doGets, PGTOP
    jmp getsCommon
doGetrs, PGTOP
    jda pgCar
getsCommon, dac pgV
    lac pgA
    ior [KSYM]
    lia
    lac pgV
    jda pgGet
    jmp pgR1
    // The value stays on the stack while pgPut may allocate, then goes.
    // SETR pushes nothing, and a site that wants the value DUPs it first.
doSetrs, PGPOP
    jda pgCar
    dac pgPx
    PGTOP
    dac pgPv
    lac pgA
    ior [KSYM]
    dac pgPi
    jsp pgPut
    jmp doDrop
doFq, lac i [vTab:3+vFE]
    lia
    lac pgA
    ior [KSYM]
    jda pgMemq
    sza
    jmp pgLoop
    lio i [vTab:3+vFE]
    lac pgA
    ior [KSYM]
    jda pgCons
    dac i [vTab:3+vFE]
    jmp pgLoop
doFqset, lac i [vTab:3+vC]
    jda pgCar
    dac pgPx
    lac i [vTab:3+vFE]
    dac pgPv
    lac [KSYM+sFEATURES]
    dac pgPi
    jsp pgPut
    jmp pgLoop
doParsek, lac pgA
    add [gConst:013]
    dac pgT
    lac i pgT
    PGPUSH
    law fnPARSE
    jmp pgCallF
doMsg, lac pgA
    add [gConst:013]
    dac pgT
    lac i pgT
    lio i [vTab:3+vME]
    jda pgCons
    dac i [vTab:3+vME]
    jmp pgLoop

    // FUNCALL n calls the value under the n arguments.
doFunc, lac pgA
    dac pgK
    jmp pgFcall
    // APPLY pushes the list's items, then goes as FUNCALL.
doApply,
    local loop, done, l
    PGPOP
    dac l
    dzm pgK
loop, lac l
    and [KMASK]
    sas [KCONS]
    jmp done
    lac pgSp
    sub [PVSTK+PVLEN-PVSPARE]
    sma
    jmp pgRoom
    lac l
    ior [PCELLS]
    dac pgT
    lac i pgT
    PGPUSH
    idx pgT
    lac i pgT
    dac l
    idx pgK
    jmp loop
done, jmp pgFcall
l, 0
    endloc
    // CATCH pushes a catch frame, its return the target.
doCatch, jsp pgTgt
    lac pgCp
    sub [PCSTK+PCLEN-PFW]
    sma
    jmp pgRoom
    lac pgJ
    dac i pgCp
    idx pgCp
    lac pgBp
    dac i pgCp
    idx pgCp
    lac pgFn
    dac i pgCp
    idx pgCp
    lac pgSp
    ior [PFCATCH]
    dac i pgCp
    idx pgCp
    jmp pgLoop
doUncat, law i PFW
    add pgCp
    dac pgCp
    add [PFSP]
    dac pgT
    lac i pgT
    sma                     // skip if it is the catch frame
    jmp pgFlt
    jmp pgLoop
    // THROW (ERR) goes out to the newest catch frame and pushes NIL there.
    // None but the top level's is an error.
doThrow,
    local loop, found
    PGDROP
loop, law i PFW
    add pgCp
    dac pgCp
    add [PFSP]
    dac pgT
    lac i pgT
    spa                     // skip unless the catch frame
    jmp found
    lac pgCp
    dac pgT
    lac i pgT
    sza i
    jmp pgErr               // the top level's: no ERRSET
    jmp loop
found, and [0177777]
    dac pgSp
    lac pgCp
    dac pgT
    lac i pgT
    dac pgJ
    idx pgT
    lac i pgT
    jda pgUnbTo
    lac pgCp
    add [PFFN]
    dac pgT
    lac i pgT
    dac pgFn
    cla
    PGPUSH
    jmp pgGo
    endloc

// FUNCALL's body. The value pgK words under the top names, by gFnOf, a
// function or a native. The value's word is closed up, or for a LEXPR
// made the list of the arguments.
pgFcall,
    local lex, fexpr, nat, call, shift, sloop, sdone, srtn, k, d
    lac pgK
    cma
    add pgSp
    sub [1]
    dac pgT
    lac i pgT
    dac pgV
    and [KMASK]
    sas [KSYM]
    jmp pgErr
    lac pgV
    and [07777]
    jda pgFnOf
    spa
    jmp pgErr               // no function
    dac d
    and [060000]
    sad [FNLEXPR]
    jmp lex
    sad [FNFEXPR]
    jmp fexpr
    sad [FNNAT]
    jmp nat
    // An EXPR takes as many arguments as parameters.
    lac d
    and [FNPARS]
    rar 9s
    sas pgK
    jmp pgErr
call, jsp shift
    lac d
    and [0777]
    jmp pgCallF
fexpr, lac pgK
    sas [1]
    jmp pgErr
    jmp call
nat, lac d
    and [FNPARS]
    rar 9s
    sas pgK
    jmp pgErr
    jsp shift
    lac d
    and [0777]
    dac pgA
    jmp pgPrimA
    // A LEXPR takes the arguments' list in the function's word.
lex, lac pgK
    jda pgStkL
    dac pgV
    lac pgSp
    sub pgK
    dac pgSp
    PGDROP
    lac pgV
    PGPUSH
    lac d
    and [0777]
    jmp pgCallF
    // Moves the arguments down a word, over the function's at pgT.
shift, dap srtn
    lac pgT
    dac k
sloop, lac k
    add [1]
    sad pgSp
    jmp sdone
    dac pgV
    lac i pgV
    dac i k
    idx k
    jmp sloop
sdone, PGDROP
srtn, jmp 0
k, 0
d, 0
    endloc

// A symbol's variable and function by direct index. The compiler numbers the
// symbols so that those naming a variable are the first ones past T, the
// lexicon's features among them, and those naming a function the ones from
// FNLO on. gVarSym and gFnOf are indexed by them.
// pgVarOf takes the symbol (KSYM and its number) in AC. Returns the variable's
// number, or -1 if none, in AC.
// AC is the result and IO is preserved.
// Called via jda.
pgVarOf,
    local none, rtn
    0                       // jda puts the argument here
    dap rtn
    lac pgVarOf
    sub [KSYM+1]
    spa
    jmp none                // not a symbol, or T
    dac pgVarOf             // its index
    sub [NVART]
    sma
    jmp none                // past the variables' symbols
    lac pgVarOf
    add [gVarSym:3]
    dac pgVarOf
    lac i pgVarOf
    jmp rtn
none, law i 1
rtn, jmp 0
    endloc

// pgFnOf takes the symbol's number in AC. Returns gFnOf's word, or -1 if none,
// in AC. A number below FNLO is a feature's or none, and pgFFeat (tables.ac)
// looks at the few features that name a function.
// AC is the result and IO is preserved.
// Called via jda.
pgFnOf,
    local feat, none, rtn
    0                       // jda puts the argument here
    dap rtn
    lac pgFnOf
    sub [FNLO]
    spa
    jmp feat
    sub [NFNT]
    sma
    jmp none                // past the functions' symbols
    lac pgFnOf
    sub [FNLO]
    add [gFnOf:3]
    dac pgFnOf
    lac i pgFnOf
    jmp rtn
feat, jsp i [pgFFeat:3]
    jmp rtn
none, law i 1
rtn, jmp 0
    endloc

// Makes the list of the n values on top of the stack, the first pushed first,
// from its end. The values stay on the stack while it is made.
// Takes n in AC. Returns the list in AC.
// AC is the result and IO is clobbered.
// Called via jda.
pgStkL,
    local loop, rtn, p, l
    0                       // jda puts the argument here
    dap rtn
    dzm l
    lac pgSp
    dac p
loop, lac pgStkL
    sza i
    jmp rtn-1
    law i 1
    add pgStkL
    dac pgStkL
    law i 1
    add p
    dac p
    lac i p
    lio l
    jda pgCons
    dac l
    jmp loop
    lac l
rtn, jmp 0
p, 0
l, 0
    endloc

// The natives, each as the compiler's NATIVES table defines it. Those in
// pgNats as ntCold are pgsys.ac's.
ntCold, XJSP(psNat, 012)
    lai
    jmp pgPushL
ntCar, ARG(1, 1)
    jda pgCar
    jmp pgIV
ntCdr, ARG(1, 1)
    jda pgCdr
    jmp pgIV
ntCons, ARG(2, 2)
    lia
    ARG(2, 1)
    jda pgCons
    jmp pgR2
ntEq, ARG(2, 2)
    dac pgV
    ARG(2, 1)
    sas pgV
    jmp pgN2
    jmp pgT2
ntEqual, ARG(2, 2)
    lia
    ARG(2, 1)
    jda pgEqual
    sza i
    jmp pgN2
    jmp pgT2
ntNot, ARG(1, 1)
    sza
    jmp pgIN
    jmp pgIT
ntAtom, ARG(1, 1)
    and [KMASK]
    sas [KCONS]
    jmp pgIT
    jmp pgIN
ntListp, ARG(1, 1)
    sza i
    jmp pgIT
    and [KMASK]
    sas [KCONS]
    jmp pgIN
    jmp pgIT
ntMemq, ARG(2, 2)
    lia
    ARG(2, 1)
    jda pgMemq
    jmp pgR2
ntMember,
    local loop, yes, l, x
    ARG(2, 2)
    dac l
    ARG(2, 1)
    dac x
loop, lac l
    and [KMASK]
    sas [KCONS]
    jmp pgN2
    lac l
    ior [PCELLS]
    dac pgT
    lio i pgT
    lac x
    jda pgEqual
    sza
    jmp yes
    lac l
    jda pgCdr
    dac l
    jmp loop
yes, lac l
    jmp pgR2
l, 0
x, 0
    endloc
    // A copy of the first's cells, then the second.
ntAppend,
    local loop, fin, l
    jsp pgLbNew
    ARG(2, 1)
    dac l
loop, lac l
    and [KMASK]
    sas [KCONS]
    jmp fin
    lac l
    ior [PCELLS]
    dac pgT
    lac i pgT
    jda pgLbAdd
    lac l
    jda pgCdr
    dac l
    jmp loop
fin, ARG(2, 2)
    jda pgLbEnd
