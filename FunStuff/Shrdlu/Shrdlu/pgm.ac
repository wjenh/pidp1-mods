// CAR and CDR. Of a list they are its first and its rest, of NIL, NIL. CAR of an
// engine's record is its fact (psCar), of another atom HEADER. CDR of a
// symbol or a word is its property list (psCdr), of another atom a Lisp
// error. A freed cell read is a fault.
// pgCar takes the value in AC. Returns the result in AC.
// AC is the result and IO is preserved.
// Called via jda.
pgCar,
    local atom, hdr, rtn, p
    0                       // jda puts the argument here
    dap rtn
    lac pgCar
    and [KMASK]
    sas [KCONS]
    jmp atom
    lac pgCar
    ior [PCELLS]
    dac p
    lac i p
    sad [FREEW]
    jmp pgFlt
    jmp rtn
atom, sza
    jmp hdr
    lac pgCar
    sza i
    jmp rtn                 // NIL
    // A record's fact is made.
    dio pgCio
    lac pgCar
    dac pgGx
    jsp psCar
    lai
    lio pgCio
    jmp rtn
hdr, lac [HEADER]
rtn, jmp 0
p, 0
    endloc

// CDR, described with pgCar above.
// Takes the value in AC. Returns the result in AC.
// AC is the result and IO is preserved.
// Called via jda.
pgCdr,
    local atom, plist, rtn, p
    0                       // jda puts the argument here
    dap rtn
    lac pgCdr
    and [KMASK]
    sas [KCONS]
    jmp atom
    lac pgCdr
    ior [PCELLS]
    dac p
    lac i p
    sad [FREEW]
    jmp pgFlt
    idx p
    lac i p
    jmp rtn
atom, lac pgCdr
    sza i
    jmp rtn
    and [KMASK]
    sad [KSYM]
    jmp plist
    sas [KWORD]
    jmp pgErr
plist, dio pgCio
    lac pgCdr
    dac pgGx
    XJSP(psCdr, 012)
    lai
    lio pgCio
rtn, jmp 0
p, 0
    endloc

// Finds the last cell of a list, the first whose CDR is no list.
// Takes the list in AC. Returns the cell in AC.
// AC is the result and IO is preserved.
// Called via jda.
pgLast,
    local loop, rtn, p
    0                       // jda puts the argument here
    dap rtn
loop, lac pgLast
    and [KMASK]
    sas [KCONS]
    jmp rtn-1
    lac pgLast
    ior [PCELLS]
    add [1]
    dac p
    lac i p
    and [KMASK]
    sas [KCONS]
    jmp rtn-1
    lac i p
    dac pgLast
    jmp loop
    lac pgLast
rtn, jmp 0
p, 0
    endloc

// CONS, from the free list. An empty list has the collector run, the
// two values held where it finds them. If it is still empty, the drop runs
// (drop.ac's psShort), which is NO ROOM when it lets nothing go.
// Takes the CAR in AC and the CDR in IO. Returns the new cell in AC.
// AC is the result and IO is clobbered.
// Called via jda.
pgCons,
    local short, some, rtn, p
    0                       // jda puts the argument here
    dap rtn
    lac pgCons
    dac pgConsA
    dio pgConsD
#ifdef GCEVERY
    XJSP(psGcK, 011)        // GCEVERY's collection (drop.ac)
#endif
    lac pgFree
    sza
    jmp some
    jsp psGC1
short, lac pgFree
    sza
    jmp some
    XJSP(psShort, 011)
    jmp short
some, dac p
    idx p
    lac i p
    dac pgFree
    law i 1
    add p
    dac p
    lac pgConsA
    dac i p
    idx p
    lac pgConsD
    dac i p
    law i 1
    add pgNFree
    dac pgNFree
    law i 1
    add p
    and [077777]
    ior [KCONS]
    dzm pgConsA
    dzm pgConsD
rtn, jmp 0
p, 0
    endloc

// Makes sure n cells can be made with no collection between. The
// collector runs now if fewer are free. If there are still too few, the drop
// runs, as for CONS.
// Takes n in AC. Returns no value.
// AC and IO are clobbered.
// Called via jda.
pgRsv,
    local short, rtn
    0                       // jda puts the argument here
    dap rtn
#ifdef GCEVERY
    lac pgRsv
    dac i [psHold:011]      // no test collection while they are taken
#endif
    lac pgNFree
    sub pgRsv
    sma
    jmp rtn
    jsp psGC1
short, lac pgNFree
    sub pgRsv
    sma
    jmp rtn
    XJSP(psShort, 011)
    jmp short
rtn, jmp 0
    endloc

// The list builder. pgLbNew empties it, pgLbAdd puts a value at its end,
// pgLbEnd ends it with a tail and gives the list. One list is built at a
// time. pgLbH is its first cell, which the collector marks. pgLbT is the
// address of its last cell's CDR, 0 while it is empty. The last cell's
// CDR is NIL until the end, so the list can be searched as it grows.
// pgLbNew takes no arguments and returns no value.
// AC and IO are clobbered.
// Called via jsp.
pgLbNew,
    local rtn
    dap rtn
    dzm pgLbH
    dzm pgLbT
rtn, jmp 0
    endloc

// pgLbAdd takes the value in AC and returns no value.
// AC and IO are clobbered.
// Called via jda.
pgLbAdd,
    local first, rtn, c
    0                       // jda puts the argument here
    dap rtn
    cli
    lac pgLbAdd
    jda pgCons
    dac c
    lac pgLbT
    sza i
    jmp first
    lac c
    dac i pgLbT
    jmp .+3
first, lac c
    dac pgLbH
    lac c
    ior [PCELLS]
    add [1]
    dac pgLbT
rtn, jmp 0
c, 0
    endloc

// pgLbEnd takes the tail in AC. Returns the list in AC.
// AC is the result and IO is preserved.
// Called via jda.
pgLbEnd,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    lac pgLbT
    sza i
    jmp rtn-1
    lac pgLbEnd
    dac i pgLbT
    lac pgLbH
    dzm pgLbH
    jmp rtn
    lac pgLbEnd
rtn, jmp 0
    endloc

// MEMQ. Takes the value in AC and the list in IO. Returns the tail that
// starts with the value, or NIL, in AC.
// AC is the result and IO is clobbered.
// Called via jda.
pgMemq,
    local loop, no, yes, rtn, l, p
    0                       // jda puts the argument here
    dap rtn
    dio l
loop, lac l
    and [KMASK]
    sas [KCONS]
    jmp no
    lac l
    ior [PCELLS]
    dac p
    lac i p
    sad pgMemq
    jmp yes
    idx p
    lac i p
    dac l
    jmp loop
no, cla
    jmp rtn
yes, lac l
rtn, jmp 0
l, 0
p, 0
    endloc

// EQUAL, without recursion. The CDRs still to compare wait on the value
// stack above its top. Takes one value in AC and the other in IO.
// Returns 1 in AC if they are EQUAL, else 0.
// AC is the result and IO is clobbered.
// Called via jda.
pgEqual,
    local loop, pop, yes, no, rtn, a, b, base, p
    0                       // jda puts the argument here
    dap rtn
    lac pgEqual
    dac a
    dio b
    lac pgSp
    dac base
loop, lac a
    sad b
    jmp pop
    and [KMASK]
    sas [KCONS]
    jmp no
    lac b
    and [KMASK]
    sas [KCONS]
    jmp no
    lac pgSp
    sub [PVSTK+PVLEN-2]
    sma
    jmp pgRoom
    lac a
    ior [PCELLS]
    dac p
    idx p
    lac i p
    PGPUSH
    lac b
    ior [PCELLS]
    dac p
    idx p
    lac i p
    PGPUSH
    lac a
    ior [PCELLS]
    dac p
    lac i p
    dac a
    lac b
    ior [PCELLS]
    dac p
    lac i p
    dac b
    jmp loop
pop, lac pgSp
    sad base
    jmp yes
    PGPOP
    dac b
    PGPOP
    dac a
    jmp loop
yes, law 1
    jmp rtn
no, lac base
    dac pgSp
    cla
rtn, jmp 0
a, 0
b, 0
base, 0
p, 0
    endloc

// Gives a number's value, signed. Anything else is a Lisp error.
// Takes the value in AC. Returns the number in AC.
// AC is the result and IO is preserved.
// Called via jda.
pgNum,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    lac pgNum
    and [KMASK]
    sas [KINT]
    jmp pgErr
    lac pgNum
    and [077777]
    sub [040000]
    spa
    jmp .+3
    sub [040000]            // negative, less 0100000 in all
    jmp rtn
    add [040000]
rtn, jmp 0
    endloc

// Makes a number a value, 15 bits two's complement. One outside -040000 to
// 037777 is a fault.
// Takes the number in AC. Returns the value in AC.
// AC is the result and IO is preserved.
// Called via jda.
pgMkint,
    local neg, rtn
    0                       // jda puts the argument here
    dap rtn
    lac pgMkint
    sad [0777777]
    cla
    spa
    jmp neg
    sub [040000]
    sma
    jmp pgFlt
    add [040000+KINT]
    jmp rtn
neg, add [040000]
    spa
    jmp pgFlt
    add [040000+KINT]
rtn, jmp 0
    endloc

// Finds a node's register. It is the field, 0 to 5, or PREGS for the list of
// the others. Takes the register, a symbol, in AC. Returns the field in AC.
// AC is the result and IO is preserved.
// Called via jda.
pgField,
    local loop, found, rtn, p, k
    0                       // jda puts the argument here
    dap rtn
    lac [pgFlds:.]
    dac p
    dzm k
loop, lac i p
    sad pgField
    jmp found
    idx p
    idx k
    sas [PREGS]
    jmp loop
found, lac k
rtn, jmp 0
p, 0
k, 0
    endloc

// The fields' registers, in their order in a node.
pgFlds, KSYM+sFEATURES
    KSYM+sFIRSTWORD
    KSYM+sWORDAFTER
    KSYM+sDAUGHTERS
    KSYM+sSEMANTICS
    KSYM+sPARENT

// Finds a property in a property list, which runs indicator, value, indicator
// ... Takes the list in AC and the indicator in pgPlInd. Returns the full
// address of the value's cell in AC, 0 if it is not there.
// AC is the result and IO is preserved.
// Called via jda.
pgPlAt,
    local loop, found, rtn, p
    0                       // jda puts the argument here
    dap rtn
loop, lac pgPlAt
    and [KMASK]
    sas [KCONS]
    jmp rtn-1
    lac pgPlAt
    ior [PCELLS]
    dac p
    lac i p
    sad pgPlInd
    jmp found
    idx p                   // past the value's cell
    lac i p
    ior [PCELLS]
    add [1]
    dac p
    lac i p
    dac pgPlAt
    jmp loop
found, idx p
    lac i p
    ior [PCELLS]
    jmp rtn
    cla
rtn, jmp 0
p, 0
    endloc

// GET. Of a node it is the field or other register, of a record its WHO, of a
// list the property after its CAR. Of anything else it is psGet's, a FEATURES
// first from the feature cache when its list is made (psHot, hotget.ac).
// Takes the value in AC and the indicator, a symbol, in IO. Returns the
// property in AC.
// AC is the result and IO is clobbered.
// Called via jda.
pgGet,
    local node, regs, look, rec, list, cold, rtn, gi, p, k
    0                       // jda puts the argument here
    dap rtn
    dio gi
    lac pgGet
    and [KMASK]
    sad [KNODE]
    jmp node
    sad [KCONS]
    jmp list
    sza
    jmp cold
    lac pgGet
    sza
    jmp rec
cold, lac pgGet
    dac pgGx
    lac gi
    dac pgGi
    sad [KSYM+sFEATURES]
    XJSP(psHot, 5)          // a made list returns past the next word
    XJSP(psGet, 012)
    lai
    jmp rtn
node, lac gi
    jda pgField
    dac k
    lac pgGet
    ior [PCELLS]
    add k
    dac p
    lac k
    sad [PREGS]
    jmp regs
    lac i p
    jmp rtn
regs, lac i p
    jmp look
list, lac pgGet
    jda pgCdr
look, dac p
    lac gi
    dac pgPlInd
    lac p
    jda pgPlAt
    sza i
    jmp rtn
    dac p
    lac i p
    jmp rtn
rec, lac gi
    sas [KSYM+sWHO]
    jmp pgFlt
    lac pgGet
    add [DWHO]
    dac p
    lac i p
rtn, jmp 0
gi, 0
p, 0
k, 0
    endloc

// PUTPROP. On a node it sets a field, or sets a register in the list or puts
// it first in it. On anything else it is psPut's.
// Takes the node in pgPx, the value in pgPv and the register in pgPi.
// Returns the value in AC.
// AC is the result and IO is clobbered.
// Called via jsp.
pgPut,
    local node, regs, new, done, rtn, k, p
    dap rtn
    lac pgPx
    and [KMASK]
    sad [KNODE]
    jmp node
    XJSP(psPut, 012)
    jmp done
node, lac pgPi
    jda pgField
    dac k
    lac pgPx
    ior [PCELLS]
    add k
    dac p
    lac k
    sad [PREGS]
    jmp regs
    lac pgPv
    dac i p
    jmp done
regs, lac pgPi
    dac pgPlInd
    lac i p
    jda pgPlAt
    sza i
    jmp new
    dac k
    lac pgPv
    dac i k
    jmp done
new, lio i p
    lac pgPv
    jda pgCons
    lia
    lac pgPi
    jda pgCons
    lia
    lac pgPx
    ior [PCELLS]
    add [PREGS]
    dac p
    dio i p
done, lac pgPv
rtn, jmp 0
k, 0
p, 0
    endloc

// The far entries, for pgsys.ac. Each takes its arguments in fA and fB
// and gives its result in IO, or in fA where it says so, and returns to
// the full address jsp left in AC. AC is clobbered. IO is clobbered
// where it gives nothing.
// Called via jsp from bank 012.
// fCons is CONS of fA and fB.
fCons, dac fCr
    lac fA
    lio fB
    jda pgCons
    lia
    jmp i fCr
// fLbNew, fLbAdd and fLbEnd are the list builder. fLbAdd adds fA, fLbEnd ends
// the list with the tail fA.
fLbNew, dac fLr
    jsp pgLbNew
    jmp i fLr
fLbAdd, dac fLr
    lac fA
    jda pgLbAdd
    jmp i fLr
fLbEnd, dac fLr
    lac fA
    jda pgLbEnd
    lia
    jmp i fLr
// fRsv makes room for fA cells with no collection between.
fRsv, dac fRr
    lac fA
    jda pgRsv
    jmp i fRr
// fGet is GET of fA, indicator fB.
fGet, dac fGr
    lac fA
    lio fB
    jda pgGet
    lia
    jmp i fGr
// fPut is PUTPROP of pgPx, pgPv, pgPi.
fPut, dac fPr
    jsp pgPut
    lia
    jmp i fPr
// fFnOf gives gFnOf's word for symbol number fA, -1 if none. fVarOf gives
// gVarSym's for symbol fA, the same.
fFnOf, dac fFr
    lac fA
    jda pgFnOf
    lia
    jmp i fFr
fVarOf, dac fFr
    lac fA
    jda pgVarOf
    lia
    jmp i fFr
// fEqual gives 1 if fA and fB are EQUAL, else 0.
fEqual, dac fEr
    lac fA
    lio fB
    jda pgEqual
    lia
    jmp i fEr
// fNum, fMkint and fCar work on fA and put the result back in fA. IO is preserved.
fNum, dac fNr
    lac fA
    jda pgNum
    dac fA
    jmp i fNr
fMkint, dac fNr
    lac fA
    jda pgMkint
    dac fA
    jmp i fNr
fCar, dac fNr
    lac fA
    jda pgCar
    dac fA
    jmp i fNr
// fPlAt gives the value cell's full address of indicator pgPlInd in the
// property list fA, 0 if it is not there.
fPlAt, dac fPlr
    lac fA
    jda pgPlAt
    lia
    jmp i fPlr
// fStkL gives the list of the fA values on top of the value stack.
fStkL, dac fSr
    lac fA
    jda pgStkL
    lia
    jmp i fSr

// The machine's state, which pgsys.ac reaches by full address.
fA, 0                       // the far entries' arguments
fB, 0
fCr, 0                      // and the full addresses they return to
fLr, 0
fRr, 0
fGr, 0
fPr, 0
fFr, 0
fEr, 0
fNr, 0
fPlr, 0
fSr, 0
pgRtn, 0                    // the full address pgSent returns to
pgIp, 0                     // the next code word
pgA, 0                      // the operation's operand
pgJ, 0                      // a jump's target, or a call's block
pgFn, 0                     // the running function's block
pgT, 0                      // a pointer for the moment
pgV, 0                      // a value for the moment
pgK, 0                      // a count for the moment
pgSp, 0                     // the value stack's next free word
pgCp, 0                     // the calls' next free word
pgBp, 0                     // the bindings' next free word
pgFree, 0                   // the free cells, a list through their CDRs
pgNFree, 0                  // and their number
pgConsA, 0                  // CONS's two values, while it may collect
pgConsD, 0
pgLbH, 0                    // the list builder's list (these three in a row, so collect.ac marks them as one range)
pgLbT, 0                    // and its last CDR's address, 0 when empty
pgPlInd, 0                  // pgPlAt's indicator
pgPx, 0                     // PUTPROP's atom
pgPv, 0                     // its value
pgPi, 0                     // its indicator
pgGx, 0                     // psGet's, psCar's and psCdr's atom
pgGi, 0                     // psGet's indicator
pgCio, 0                    // IO kept across psCar and psCdr
pgCalls, 0                  // the sentence's calls of PARSE
pgPst, 0                    // its calls of PARSE-STATISTICS
pgNotes, 0                  // the breaks it proceeded from (ERT, BUG)
pgStat, 0                   // how it ended, as pgSent returns it
pgFltA, 0                   // a fault's code word's next
