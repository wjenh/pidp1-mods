// THVAL (plnr.182:2113) of the form eArgX with the bindings eArgA.
// The bindings are the engine's (a link, KINT), a list of (name value)
// cells, each made a binding and its value written back at the return, or
// none.
// It runs as a level.
// A catch frame is made, under which a THROW is THERT LISPERROR.
// The registers are saved on the stack and cleared, and THVALUE and
// THALIST are bound.
// Then the run loop (eRun) runs and the return (eTvX) cuts the stack back
// to where the level began.
// Returns the value in AC. AC is the result and IO is clobbered.
// Called via jsp.
eThval, jda eIn
    local sloop, zloop, cells, bind, tok
    lac i [pgCp:6]
    sub [PCSTK+PCLEN-PFW]
    sma
    jmp i [pgRoom:6]
    lac [KINT+ETVERR]
    jda ePsh
    lac i [pgCp:6]
    dac eP
    lac [evlRsw:015]
    dac i eP
    idx eP
    lac i [pgBp:6]
    dac i eP
    idx eP
    law 07777
    dac i eP
    idx eP
    lac evlS
    ior [PFCATCH]
    dac i eP
    idx eP
    dac i [pgCp:6]
    // The registers are saved and cleared, with the heap bindings' count
    // after them.
    lac eTop
    dac eT
    lac [eRegs:015]
    dac eQ
    law i NREG
    dac eK
sloop, lac i eQ
    jda ePushW
    idx eQ
    isp eK
    jmp sloop
    cla
    jda ePushW
    lac [eRegs:015]
    dac eQ
    law i NREG
    dac eK
zloop, dzm i eQ
    idx eQ
    isp eK
    jmp zloop
    lac eT
    dac eBase
    lac eArgX
    dac eExp
    idx eLev
    lio [KSYM+sTHNOVAL]
    law vTHVALUE
    jda eMBind
    lac eArgA
    and [KMASK]
    sad [KINT]
    jmp tok
    cla
    lia
    law vTHALIST
    jda eMBind
    lac eArgA
    and [KMASK]
    sas [KCONS]
    jmp eRun
    // A list's cells are pushed in order, then bound from the last, so that
    // the first is THALIST's first.
    // Each cell is kept before its binding, for the return.
    lac evlS
    dac eT
    lac eArgA
cells, dac eL
    and [KMASK]
    sas [KCONS]
    jmp bind
    EROOM(1)
    lac eL
    jda evlCar
    jda ePsh
    lac eL
    jda evlCdr
    jmp cells
bind, lac evlS
    sad eT
    jmp eRun
    jsp ePop
    dac eU
    and [KMASK]
    sas [KCONS]
    jmp bind
    lac eU
    jda evlCdr
    dac eNm
    and [KMASK]
    sas [KCONS]
    jmp bind
    lac eU
    jda ePushW
    lac eNm
    jda evlCar
    lia
    lac eU
    jda evlCar
    jda eBind
    lac eBase
    add [NREG]
    ERDA
    add [1]
    dac i eP
    jmp bind
tok, lio eArgA
    law vTHALIST
    jda eMBind
    endloc

// THVAL's run loop, with the level's registers as its state.
// THEXP is evaluated, and its value is THVALUE.
// Then, unless another expression is set, the top frame's success or
// failure routine is run by its kind (eSfK, eSfS, eSfF), its value
// THVALUE, until THTREE is empty, or a THFAIL's message reaches the frame
// it fails back to and its expression is evaluated.
eRun,
    local go1, br, mfail, fail, go2, kloop, kfound
    lac eExp
    dac eE
    dzm eExp
    lio eE
    jsp eEv
    dac i EVALUE
go1, lac eMsgOn
    sza
    jmp mfail
    lac eExp
    sza
    jmp eRun
    lac i EVALUE
    sza i
    jmp fail
    lac eBranch
    sza
    jmp br
    lac eTree
    dac eBranch
    lac i EALIST
    dac eAbranch
br, lac eTree
    sza i
    jmp eTvV
    lac [eSfS:011]
    jmp go2
mfail, lac eMsgF
    sas eTree
    jmp fail
    lac eMsgV
    dac eExp
    dzm eMsgOn
    dzm eMsgF
    dzm eMsgV
    jmp eRun
