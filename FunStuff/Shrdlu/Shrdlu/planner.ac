    dac eQ
    law i NREG
    dac eK
rloop, lac i eP2
    dac i eQ
    idx eP2
    idx eQ
    isp eK
    jmp rloop
    lac eT
    dac eTop
    law i 1
    add eLev
    dac eLev
    lac i [pgCp:6]
    sub [PFW]
    dac i [pgCp:6]
    add [PFBIND]
    dac eP
    lac i eP
    jda eUnbTo
    jsp ePop
    dac eV
    law i 1
    add evlS
    dac evlS
    lac eV
    jmp eOut
    endloc

