// Micro-Planner as the machine's engine.
// It does what plnr.182's THVAL and its forms do, with the Planner's state
// on a stack of words (ESTK, ELEN words, shrdlu.ah) instead of the heap.
// The stack holds the tree's frames, the bindings, the branch records, the
// trail and each level's saved registers.
// A frame is its kind's symbol, its parent's link, then its words.
// A link is KINT plus an offset into the stack.
// A binding is the name, the value word and the next binding's link.
// A value word that is another's is KREF plus that word's offset.
// A trail record ends with its kind, so that it can be undone from the
// top.
// The Lisp reaches it through the natives ETHVAL, EEVLIS and ETHV1, and
// the evaluator through eForm and eExpr, for a form whose head names no
// function.
// The engine's routines that can run Lisp are recursive.
// Each is entered via jsp, its first word jda eIn, which pushes its return
// on the value stack, and it ends at eOut with its value in AC.
// A word one of them needs after a call of another is pushed there too,
// where the collector sees it, since their words are clobbered by such a
// call.
// They evaluate through the evaluator (eEv) and call compiled code and
// natives through its stub (eFun1, ePrim1), each value handed back by an
// ETENG frame.
// While the engine runs, the value stack's top is evlS.
// ESYNC writes it to pgSp before a far call that may make a cell or push.
// This is the core.
// The forms a sentence seldom runs and the tables of the forms and the
// frames' kinds are the cold half, plcold.ac in bank 011, reached through
// the tables' full addresses and reaching the core through its far entries
// (eInF and the like).
// Bank 015 after eval.ac, eem on. Needs shrdlu.ah, semantics.ac's
// defines, pgm.ac's far entries, eval.ac, and hooks.ac's hkAtomF and
// hkDbF.

// A frame's words after its kind and parent are THGOAL's, THPROG's
// (THAND's and THCOND's the first two), and THFIND's.
#define FGPAT 2
#define FGRECS 3
#define FGCNT 4
#define FGCUR 5
#define FGFILT 6
#define FGCURS 7
#define FGLEN 0d8
#define FPPOS 2
#define FPRECS 3
#define FPTAGS 4
#define FFMIN 2
#define FFMAX 3
#define FFFLAG 4
#define FFCNT 5
#define FFVALS 6
#define FFPAT 7
#define KREF 0740000
#define CNT0 037777                 // THGOAL4's count of tries
#define NFEXPR 0d20                 // eFxS's FEXPRs, before its EXPRs
#define EROOMN 0d10                 // the words a routine may push unchecked
#define NREG 0d10                   // the registers a level saves (eRegs)
// The stack's word at the offset in AC, to AC (ERDA), or IO written there
// (EWRA); eP its full address after.
#define ERDA jda eRd
#define EWRA jda eWr
#define ESYNC lac evlS; dac i [pgSp:6]
#define EUND [KSYM+sTHUNASSIGNED]
#define EALIST [vTab:3+vTHALIST]
#define EVALUE [vTab:3+vTHVALUE]

// The natives.

// ETHVAL is THVAL of the value stack's two top words, the form and the
// alist, which stay there while it runs, with its value in their place.
// Like EVAL, it runs under a calls frame (eNIn), so that the caller's
// block is kept and slid.
// It ends at evlBase, which puts the value in place of the top word.
ntEthval, jsp eNIn
    law i 2
    jda eSk
    dac eArgX
    idx eP
    lac i eP
    dac eArgA
    jsp eThval
    dac evlV
    law i 1
    add evlS
    dac evlS
    jmp evlBase

// EEVLIS evaluates each member of the value stack's top word by the
// evaluator in turn, and the list is its value, as ETHVAL.
ntEevlis, jsp eNIn
    law i 1
    add evlS
    dac eP
    lio i eP
    jsp eEvlis
    dac evlV
    jmp evlBase

// ETHV1 is THV1 (plnr.182:2074) of the CAR of the value stack's top word,
// for THV and THNV called by the Lisp.
// It gives the variable's value in the bindings THALIST names, the
// engine's (a link) or a list's.
// THUNBOUND or THUNASSIGNED is a Lisp error.
// It ends at pgR1.
ntEthv1,
    local loop, next, got, tok, chk
    lac i [pgSp:6]
    sub [1]
    dac eP
    lac i eP
    jda evlCar
    dac eNm
    lac i EALIST
    dac eL
    and [KMASK]
    sad [KINT]
    jmp tok
loop, lac eL
    and [KMASK]
    sas [KCONS]
    jmp i [pgErr:6]
    lac eL
    jda evlCar
    dac eU
    and [KMASK]
    sas [KCONS]
    jmp next
    lac eU
    jda evlCar
    sad eNm
    jmp got
next, lac eL
    jda evlCdr
    dac eL
    jmp loop
got, lac eU
    jda evlCdr
    jda evlCar
    jmp chk
tok, lac eNm
    lio eL
    jda eFind
    spa
    jmp i [pgErr:6]
    jda eVal
chk, sad EUND
    jmp i [pgErr:6]
    jmp i [pgR1:6]
    endloc

// A native's entry to the engine or the evaluator.
// A calls frame is pushed with the caller's return, bindings' mark and
// block, pgFn is then 07777 (no block), and evlS is the value stack's top.
// AC is clobbered and IO is preserved. Called via jsp.
eNIn,
    local rtn
    dap rtn
    lac i [pgCp:6]
    sub [PCSTK+PCLEN-PFW]
    sma
    jmp i [pgRoom:6]
    lac i [pgCp:6]
    dac eP
    lac i [pgIp:6]
    dac i eP
    idx eP
    lac i [pgBp:6]
    dac i eP
    idx eP
    lac i [pgFn:6]
    dac i eP
    idx eP
    dzm i eP
    idx eP
    dac i [pgCp:6]
    law 07777
    dac i [pgFn:6]
    lac i [pgSp:6]
    dac evlS
rtn, jmp 0
    endloc

// Resets at the sentence's start (pgsys.ac's psClear).
// The stack is emptied and the registers and THNOT's lists are cleared.
// AC is clobbered and IO is preserved. Called via jsp from bank 012.
eReset,
    local loop
    dac eRr
    dzm eTop
    lac [eRegs:015]
    dac eQ
    law i NROOT
    dac eK
loop, dzm i eQ
    idx eQ
    isp eK
    jmp loop
    jmp i eRr
    endloc

// The calls.

// A routine's entry, its first word jda eIn.
// Its return, jsp's AC, is pushed on the value stack with KINT, for eOut.
// NO ROOM unless EROOMN words more can be pushed.
// AC is clobbered and IO is preserved. Called via jda.
eIn,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    EROOM(EROOMN)
    lac eIn
    ior [KINT]
    jda ePsh
rtn, jmp 0
    endloc

// A routine's return.
// Takes the value in AC and goes to the return eIn pushed.
// AC is the value and IO is preserved.
eOut, dac eRv
    jsp ePop
    and [0177777]
    dac eRp
    lac eRv
    jmp i eRp

// Evaluates the form in IO by the evaluator.
// Its value comes back in AC through the ETENG frame (evlEngR).
// AC and IO are clobbered. Called via jsp.
eEv, ior [KINT]
    jda ePsh
    lac [KINT+ETENG]
    jda ePsh
    dio evlX
    jmp evlEval

// ETENG's routine (evlTab) hands the value back to the routine whose
// return is under it.
// ETVERR's routine handles a THROW caught by a level's catch frame
// (eThval), THERT LISPERROR - THVAL, which stops the sentence.
evlEngR, lac evlV
    jmp eOut
evlVerr, jmp i [pgErr:6]

// FUNCALL of the function eFn (eFun1), or the native whose operation word
// is eNat (ePrim1), of the one argument in IO, through the stub.
// Its value comes back in AC through the ETENG frame.
// AC and IO are clobbered. Called via jsp.
eFun1, ior [KINT]
    jda ePsh
    lac [KINT+ETENG]
    jda ePsh
    lac eFn
    jda ePsh
    lac [opFUNCALL*010000+1]
    jmp eCall1
ePrim1, ior [KINT]
    jda ePsh
    lac [KINT+ETENG]
    jda ePsh
    lac eNat
eCall1, dac eOp
    dio i evlS
    idx evlS
    lac eOp
    jmp evlCall

// A form whose head names no function (evlForm).
// One of the engine's (eFxS) is an FEXPR's routine called with the
// arguments as they are and its value handed on, or an EXPR's, its marker
// (KINT plus its number) pushed for eExpr and its arguments evaluated by
// evlArgs.
// Any other is UNDEFINED FUNCTION, and one of the engine's outside THVAL
// is a Lisp error.
eForm,
    local loop, got, expr
    lac [eFxS:011]
    dac eP
loop, lac i eP
    sza i
    jmp i [pgErr:6]
    sad evlF
    jmp got
    idx eP
    jmp loop
got, lac eLev
    sza i
    jmp i [pgErr:6]
    lac eP
    sub [eFxS:011]
    dac eK
    sub [NFEXPR]
    sma
    jmp expr
    lac eK
    add [eFxR:011]
    dac eP
    lac i eP
    dac eJv
    lio evlL
    jsp i eJv
    jmp evlRet
expr, lac eK
    ior [KINT]
    jda ePsh
    dzm evlN
    jmp evlArgs
    endloc

// An engine EXPR's call (evlApply).
// evlP is its marker's address, with its evlN arguments' values above,
// where they stay while it runs.
// Then all are dropped and its value handed on.
// A wrong number of arguments is a Lisp error.
eExpr,
    local rplac, ret
    lac evlP
    dac eXp
    lac i evlP
    and [07777]
    sub [NFEXPR]
    sza
    jmp rplac
    lac evlN
    sas [3]
    jmp i [pgErr:6]
    XJSP(thPutprop, 011)
    jmp ret
rplac, dac eK
    lac evlN
    sas [2]
    jmp i [pgErr:6]
    XJSP(thRplac, 011)
ret, dac evlV
    lac eXp
    dac evlS
    lac evlV
    jmp evlRet
    endloc

// The stack.

// The engine's stack's word at an offset is read (eRd) or written (eWr).
// Takes the offset in AC, and the word in IO for eWr.
// eRd returns the word in AC, and both leave eP its full address.
// AC is the result and IO is preserved. Called via jda.
eRd,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    lac eRd
    add [ESTK]
    dac eP
    lac i eP
rtn, jmp 0
    endloc
eWr,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    lac eWr
    add [ESTK]
    dac eP
    dio i eP
rtn, jmp 0
    endloc

// The value stack.
// A word is pushed (ePsh), the top word popped (ePop), or the word an
// offset under the top read (eSk), with eP its address.
// ePsh takes the word in AC, and eSk takes minus the offset in AC, so -1
// is the top word.
// ePop and eSk return the word in AC.
// AC is the result and IO is preserved. Called via jda (ePsh, eSk) or jsp
// (ePop).
ePsh,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    lac ePsh
    dac i evlS
    idx evlS
rtn, jmp 0
    endloc
ePop,
    local rtn
    dap rtn
    law i 1
    add evlS
    dac evlS
    lac i evlS
rtn, jmp 0
    endloc
eSk,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    lac eSk
    add evlS
    dac eP
    lac i eP
rtn, jmp 0
    endloc

// A word pushed on the engine's stack, with NO ROOM past its end.
// Takes the word in AC. AC is clobbered and IO is preserved.
// Called via jda.
ePushW,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    lac eTop
    sub [ELEN]
    sma
    jmp i [pgRoom:6]
    lac eTop
    add [ESTK]
    dac eP
    lac ePushW
    dac i eP
    idx eTop
rtn, jmp 0
    endloc

// A frame of the kind in AC is pushed, its parent THTREE, and THTREE is
// set to it.
// The caller pushes its words after.
// Takes the kind's symbol in AC. Returns the frame's offset in AC.
// AC is the result and IO is preserved. Called via jda.
eFrame,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    lac eTop
    dac eFo
    lac eFrame
    jda ePushW
    lac eTree
    jda ePushW
    lac eFo
    ior [KINT]
    dac eTree
    lac eFo
rtn, jmp 0
    endloc

// THPOPT pops THTREE's top frame, and THTREE becomes its parent.
// Returns the frame's offset in AC. AC is the result and IO is preserved.
// Called via jsp.
ePopt,
    local rtn
    dap rtn
    lac eTree
    and [07777]
    dac eFo
    add [ESTK+1]
    dac eP
    lac i eP
    dac eTree
    lac eFo
rtn, jmp 0
    endloc

// THTAGT, THMESSAGET, THMUNGT and THORT pop the frame, and THVALUE is the
// value.
// Returns the value in AC. AC is the result and IO is preserved.
// Called via jsp.
ePopV,
    local rtn
    dap rtn
    jsp ePopt
    lac i EVALUE
rtn, jmp 0
    endloc

// THTAGF, and a failure that pops its frame, pop the frame and cut the
// stack to it.
// Returns NIL in AC. AC is the result and IO is preserved.
// Called via jsp.
ePopCut,
    local rtn
    dap rtn
    jsp ePopt
    dac eTop
    cla
rtn, jmp 0
    endloc

// The binding of a name in the bindings a link starts.
// Takes the name in AC and the link in IO, or 0.
// Returns the binding's offset in AC, or minus zero if there is none.
// AC is the result and IO is clobbered. Called via jda.
eFind,
    local loop, none, got, rtn
    0                       // jda puts the argument here
    dap rtn
    dio eT2
loop, lac eT2
    sza i
    jmp none
    and [07777]
    dac eT3
    ERDA
    sad eFind
    jmp got
    lac eT3
    add [2]
    ERDA
    dac eT2
    jmp loop
none, lac [0777777]
    jmp rtn
got, lac eT3
rtn, jmp 0
    endloc

// A binding's value word, or the one its KREF words lead to.
// Takes the binding's offset in AC. Returns the word's offset (eSlot) or
// the value (eVal) in AC.
// AC is the result and IO is preserved. Called via jda.
eSlot,
    local loop, done, rtn
    0                       // jda puts the argument here
    dap rtn
    lac eSlot
    add [1]
loop, dac eT3
    ERDA
    dac eT4
    and [0770000]
    sas [KREF]
    jmp done
    lac eT4
    and [07777]
    jmp loop
done, lac eT3
rtn, jmp 0
    endloc
eVal,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    lac eVal
    jda eSlot
    ERDA
rtn, jmp 0
    endloc

// THGAL (plnr.182:874) finds the binding of a (THV name) form's name.
// A name not bound is a Lisp error.
// Takes the form in AC and the bindings' link in IO. Returns the binding's
// offset in AC.
// AC is the result and IO is clobbered. Called via jda.
eGal,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    dio eT7
    lac eGal
    jda evlCdr
    jda evlCar
    lio eT7
    jda eFind
    spa
    jmp i [pgErr:6]
rtn, jmp 0
    endloc

// A binding made in THALIST, holding the name, the value and THALIST's
// link, and THALIST becomes the new one's.
// Takes the name in AC and the value in IO. Returns its offset in AC.
// AC is the result and IO is clobbered. Called via jda.
eBind,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    dio eT6
    lac eTop
    dac eT5
    lac eBind
    jda ePushW
    lac eT6
    jda ePushW
    lac i EALIST
    jda ePushW
    lac eT5
    ior [KINT]
    dac i EALIST
    lac eT5
rtn, jmp 0
    endloc

// A variable of the machine bound, as pgBind binds.
// The variable and its old value go on the bindings, then the new value is
// set.
// Takes the variable's number in AC and the value in IO. AC is clobbered
// and IO is preserved. Called via jda.
eMBind,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    lac i [pgBp:6]
    sub [PBSTK+PBLEN-2]
    sma
    jmp i [pgRoom:6]
    lac i [pgBp:6]
    dac eP
    lac eMBind
    dac i eP
    idx eP
    lac eMBind
    add [vTab:3]
    dac eQ2
    lac i eQ2
    dac i eP
    idx eP
    dac i [pgBp:6]
    dio i eQ2
rtn, jmp 0
    endloc

// The machine's bindings are undone to a mark, each variable's old value
// put back, as pgUnbTo does.
// Takes the mark in AC. AC and IO are clobbered. Called via jda.
eUnbTo,
    local loop, rtn
    0                       // jda puts the argument here
    dap rtn
loop, lac i [pgBp:6]
    sad eUnbTo
    jmp rtn
    sub [2]
    dac i [pgBp:6]
    dac eP
    lac i eP
    add [vTab:3]
    dac eQ2
    idx eP
    lac i eP
    dac i eQ2
    jmp loop
rtn, jmp 0
    endloc

// The trail.

// Begins a trail.
// A THMUNG frame's three words are reserved at the top, and its records
// are pushed above them as the bindings and the rest are changed.
// Returns the frame's offset in AC. AC is the result and IO is preserved.
// Called via jsp.
eTrB,
    local rtn
    dap rtn
    lac eTop
    dac eTb
    lac [KSYM+sTHMUNG]
    jda ePushW
    cla
    jda ePushW
    cla
    jda ePushW
    lac eTb
rtn, jmp 0
    endloc

// Ends a trail.
// If none was recorded, its words are given back (eTrE).
// Otherwise, or always (eTrA), the THMUNG frame is made of them, its
// records' words counted, and THTREE is set to it.
// Takes the frame's offset in AC. AC and IO are clobbered.
// Called via jda.
eTrE,
    local mk, rtn
    0                       // jda puts the argument here
    dap rtn
    lac eTop
    sub eTrE
    sub [3]
    sza
    jmp mk
    lac eTrE
    dac eTop
    jmp rtn
mk, lac eTrE
    jda eTrA
rtn, jmp 0
    endloc
eTrA,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    lac eTop
    sub eTrA
    sub [3]
    ior [KINT]
    lia
    lac eTrA
    add [2]
    EWRA
    lio eTree
    lac eTrA
    add [1]
    EWRA
    lac eTrA
    ior [KINT]
    dac eTree
rtn, jmp 0
    endloc

// A trail's records are undone, the newest first, and the stack cut to its
// frame.
// The old value goes back for a value word, a cell's CAR or CDR, a
// variable's value (SETQ), a derived event's fact (THASSERT), or a
// property (PUTPROP).
// Takes the frame's offset in AC, its records ending at the top.
// AC and IO are clobbered. Called via jda.
eTrU,
    local loop, sv, ca, cd, cw, sq, as, done, rtn
    0                       // jda puts the argument here
    dap rtn
    lac eTop
    dac eTp
loop, lac eTp
    sub eTrU
    sub [3]
    sza i
    jmp done
    law i 1
    add eTp
    ERDA
    sad [KSYM+sTHV]
    jmp sv
    sad [KSYM+sTHURPLACA]
    jmp ca
    sad [KSYM+sTHURPLACD]
    jmp cd
    sad [KSYM+sSETQ]
    jmp sq
    sad [KSYM+sTHASSERT]
    jmp as
    // PUTPROP's record holds the atom, the indicator and the old value.
    lac eTp
    sub [4]
    dac eTp
    ERDA
    dac i [pgPx:6]
    lac eTp
    add [1]
    ERDA
    dac i [pgPi:6]
    lac eTp
    add [2]
    ERDA
    dac i [pgPv:6]
    ESYNC
    XJSP(fPut, 6)
    jmp loop
sv, jsp eTr3
    and [07777]
    dac eTq
    lac eTp
    add [1]
    ERDA
    lia
    lac eTq
    EWRA
    jmp loop
ca, jsp eTr3
    ior [PCELLS]
    jmp cw
cd, jsp eTr3
    ior [PCELLS]
    add [1]
cw, dac eTq
    lac eTp
    add [1]
    ERDA
    dac i eTq
    jmp loop
sq, jsp eTr3
    dac i [fA:6]
    XJSP(fVarOf, 6)
    lai
    spa
    jmp i [pgFlt:6]
    add [vTab:3]
    dac eTq
    lac eTp
    add [1]
    ERDA
    dac i eTq
    jmp loop
as, lac eTp
    sub [2]
    dac eTp
    ERDA
    XJDA(evUnasF, 3)
    jmp loop
done, lac eTrU
    dac eTop
rtn, jmp 0
    endloc

// A three-word record's start. eTp goes three less, to its first word.
// Returns the word in AC. AC is the result and IO is preserved.
// Called via jsp.
eTr3,
    local rtn
    dap rtn
    lac eTp
    sub [3]
    dac eTp
    ERDA
rtn, jmp 0
    endloc

// A binding's value is set, the old one on the trail as (THV link old).
// Takes the binding's offset in AC and the value in IO. AC and IO are
// clobbered. Called via jda.
eAsg,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    dio eT6
    lac eAsg
    jda eSlot
    dac eT5
    ior [KINT]
    jda ePushW
    lac eT5
    ERDA
    jda ePushW
    lac [KSYM+sTHV]
    jda ePushW
    lio eT6
    lac eT5
    EWRA
rtn, jmp 0
    endloc

// THMATCH2's (THRPLACDS YPAIR (CDR XPAIR)) makes y's value word a
// reference to x's, the old word on the trail.
// It does nothing if they are one.
// Takes y's binding in AC and x's in IO. AC and IO are clobbered.
// Called via jda.
eAlias,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    dio eT6
    lac eAlias
    add [1]
    dac eT5
    ior [KINT]
    jda ePushW
    lac eT5
    ERDA
    jda ePushW
    lac [KSYM+sTHV]
    jda ePushW
    lac eT6
    jda eSlot
    dac eT6
    lac eAlias
    jda eSlot
    sad eT6
    jmp rtn
    lac eT6
    ior [KREF]
    lia
    lac eT5
    EWRA
rtn, jmp 0
    endloc

// THMUNGF undoes the frame's records, pops the frame and cuts the stack
// to it.
