    add [FGCUR]
    EWRA
    lac eX
    jda evlCdr
    jda evlCar
    lia
    lac eF
    add [FGFILT]
    EWRA
    jsp eHead
    lia
    lac eF
    add [FGCURS]
    EWRA
    jmp loop
