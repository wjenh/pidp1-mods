    dac i p
    idx q
    idx p
    lac k
    sub [1]
    dac k
    sza
    jmp sloop
    lac dwNext
    dac p
    add size
    dac dwNext
    lac p
    jmp rtn
full, cla
rtn, jmp 0
p, 0
q, 0
k, 0
w, 0
size, 0
    endloc

