// The reader handles the terminal, the words as they are typed, and the
// lexicon behind them (lexicon.ac). It polls the terminal, keeping term.ac's
// channel and its output routines for the commands.
// A line typed with a / first is a command. It is collected into tLine
// without its /, and handed to the commands' dispatch by tReady, but for
// /WORD, which is this file's.
// Anything else is a sentence, read as the original's ETAOIN reads it
// (morpho.13). It is read a character at a time, folded to upper case,
// each word looked up as its delimiter is typed, so that an unknown word
// stops the sentence at once.
// The reader's amendments to the original are that ' joins the word as the
// apostrophe, and that "word" is one word, learned if unknown and kept in
// the sentence, as a noun and a name. Digits make numbers, as the
// original means and fails to do.
// A word the morphology derives, a learned word and a word given features
// by /WORD are kept for the dialogue in the derived words' arena (bank 017,
// DWBASE to DWLIM), which is searched before the dictionary.
// A sentence read whole is parsed and its tree printed (parse.ac).
// Bank 013, eem on throughout, so every indirect reference is a full
// address. It is entered from bank 0 by rdInit and rdPoll, which return to
// the full address in AC. It has output routines here, since term.ac's
// output routines return into bank 0.
// Needs shrdlu.ah, lexicon.ac (in bank 2, before it),
// <DCS/dcs2defs.ah>, and term.ac's tConn, tReady, tLen, tLine and sBanner.

// Sets the reader to its start state. Called from the start (shrdlu.am1).
// Clears the derived words and the sentence, sets the parser's variables
// as they start (pgm.ac), and sets the overlay manager's error hook
// (parse.ac's ovFail).
// Takes the return address in AC. AC and IO are clobbered.
// Called via jsp from bank 0.
rdInit,
    local loop, rtn
    dac rtn
    lac [dwHash:013]
    dac rdT
    law LXBUCK
    dac rdK
loop, dzm i rdT
    idx rdT
    lac rdK
    sub [1]
    dac rdK
    sza
    jmp loop
    lac [DWBASE]
    dac dwNext
    dzm rMode
    law 1
    dac rBol
    jsp rdClear
#ifndef NOOVHOOK
    lac [ovFail:013]        // an overlay's error answered, not halted
    dac ovErrHook
#endif
    XJSP(pgInit, 012)
    jmp i rtn
rtn, 0
    endloc

// Polls the terminal from the main loop. Takes what the user has typed, a
// character at a time, until a command line is ready for the main loop
// (tReady) or nothing more has come. On a new connection it makes channel 0
// current and sends the banner. On a dropped one it rebinds. Never waits.
// Takes the return address in AC. AC and IO are clobbered.
// Called via jsp from bank 0.
rdPoll,
    local loop, closed, out, rtn, st
    dac rtn
    lac i [tReady:0]
    sza
    jmp out
    lac i [tConn:0]
    sza
    jmp loop
    cli
    rcs
    lai
    and [dsfcon]
    sza i
    jmp out
    // A client is on. Server mode needs roc before any output.
    cli
    roc
    law 1
    dac i [tConn:0]
    dzm rMode
    jsp rdClear
    lac [sBanner:2]
    jda wrs
    jsp wrnl
    jsp wrStar
    jmp out
loop, cli
    rcs
    lai
    dac st
    and [dsfcls]
    sza
    jmp closed
    lac st
    and [dsfrdy]
    sza i
    jmp out
    rch rchclr
    spi
    jmp out                 // negative, so no character after all
    lai
    and [0177]
    jda rdEcho
    jda rdChar
    lac i [tReady:0]
    sza i
    jmp loop
    jmp out
closed, lio [scbbnd]
    scb
    dzm i [tConn:0]
out, jmp i rtn
rtn, 0
st, 0
    endloc

// Forgets the sentence so far, leaving no words, no word begun, no
// punctuation and no quote open. The derived words stay.
// AC and IO are clobbered. Called via jsp.
rdClear,
    local rtn
    dap rtn
    dzm rSLen
    dzm rWLen
    dzm rPunct
    dzm rNew
    dzm rQuote
    dzm rFull
rtn, jmp 0
    endloc

// Shows a character read, as typed. DCS2 echoes nothing (term.ac), and a
// terminal may move back for an echoed rubout or not, so only rdChar's
// erasing may touch the screen for one. Control characters show nothing.
// A line's end is rdChar's wrBol.
// Takes the character in AC and returns it unchanged in AC. IO is
// clobbered. Called via jda.
rdEcho,
    local rtn, done
    0                       // jda puts the argument here
    dap rtn
    lac rdEcho
    sub [040]
    spa
    jmp done
    lac rdEcho
    sad [0177]
    jmp done
    jda wrc
done, lac rdEcho
rtn, jmp 0
    endloc

// Takes one character as it is read. Lower case is folded to upper. rBol is
// kept as whether the cursor is at a line's start. A CR or LF read away
// from a line's start is followed by our LF.
// Takes the character in AC. AC and IO are clobbered. Called via jda.
rdChar,
    local rtn, nofold, nolf, sent, scret, sdel, serase, sedw, skill, \
        sslash, sapos, squote, sq2, spunct, sp2, seq, cmd, ccr, ceol, \
        cerase, cempty, chand, wait, wcr, wgo
    0                       // jda puts the argument here
    dap rtn
    lac rdChar
    sub ['a']
    spa
    jmp nofold
    lac rdChar
    sub ['z'+1]
    sma
    jmp nofold
    lac rdChar
    sub [040]
    dac rdChar
nofold, lac rdChar
    sas [012]
    jmp nolf
    jsp wrBol               // a CR LF read as one
nolf, lac rMode
    sad [1]
    jmp cmd
    sad [2]
    jmp wait

    // A sentence.
sent, lac rdChar
    sad [015]
    jmp scret
    sad [012]
    jmp sdel
    sad [010]
    jmp serase
    sad [0177]
    jmp serase
    sad [025]
    jmp skill
    sub [040]
    spa
    jmp rtn                 // other control characters are dropped
    dzm rBol
    lac rdChar
    sad ['/']
    jmp sslash
    sad [047]
    jmp sapos
    sad [042]
    jmp squote
    sad [' ']
    jmp sdel
    sad ['.']
    jmp spunct
    sad ['?']
    jmp spunct
    sad ['!']
    jmp spunct
    sad [':']
    jmp spunct
    sad [';']
    jmp spunct
    jda rdCode
    sza i
    jmp seq
    jda rdAdd
    jmp rtn
    // = is a letter only as a word's first, which makes it a name.
seq, lac rdChar
    sas ['=']
    jmp rtn
    lac rWLen
    sza
    jmp rtn
    law CH_EQ
    jda rdAdd
    jmp rtn
scret, jsp wrBol
sdel, jsp rdEndW
    jmp rtn
    // Rubout and backspace erase, within a word, the last character, which
    // the screen loses too. At a word's start they erase the word before,
    // and the sentence so far is shown again on a new line.
serase, lac rWLen
    sza i
    jmp sedw
    sub [1]
    dac rWLen
    jsp wrErase
    jmp rtn
sedw, lac rSLen
    sza i
    jmp rtn
    sub [1]
    dac rSLen
    jsp wrnl
    jsp rdShow
    jmp rtn
    // Ctrl-U erases the whole sentence and starts a new line.
skill, jsp rdClear
    jsp wrBol
    jmp rtn
    // A / opens a command only as a line's first character; elsewhere
    // it is dropped, as any character the original does not know.
sslash, lac rSLen
    ior rWLen
    ior rQuote
    sza
    jmp rtn
    law 1
    dac rMode
    dzm rCLen
    jmp rtn
sapos, law CH_APOS
    jda rdAdd
    jmp rtn
    // The first " opens a new word, the second ends it.
squote, lac rQuote
    sza
    jmp sq2
    law 1
    dac rQuote
    dac rNew
    jmp rtn
sq2, dzm rQuote
    jsp rdEndW
    jmp rtn
spunct, lac rdChar
    dac rPunct
    lac rWLen
    sza i
    jmp sp2
    jsp rdEndW
    jmp rtn
sp2, jsp rdPunc
    jmp rtn

    // A command line goes into tLine. An empty one is dropped.
cmd, lac rdChar
    sad [015]
    jmp ccr
    sad [012]
    jmp ceol
    sad [010]
    jmp cerase
    sad [0177]
    jmp cerase
    sub [040]
    spa
    jmp rtn
    dzm rBol
    lac rCLen
    sub [LINEMAX]
    sma
    jmp rtn                 // a full line keeps what it has
    lac rCLen
    add [tLine:2]
    dac rdT
    lac rdChar
    dac i rdT
    idx rCLen
    jmp rtn
cerase, lac rCLen
    sza i
    jmp rtn
    sub [1]
    dac rCLen
    jsp wrErase
    jmp rtn
ccr, jsp wrBol
ceol, dzm rMode
    lac rCLen
    sza i
    jmp rtn
    add [tLine:2]
    dac rdT
    dzm i rdT
    lac rCLen
    dac i [tLen:0]
    law 1
    dac rBol
    jsp rdIsWord
    jmp chand
    jsp cmdWord
    jmp rtn
chand, law 1
    dac i [tReady:0]
    jmp rtn

    // After an unknown word, everything to the Return is dropped. Then
    // the sentence so far is shown, to be continued.
wait, lac rdChar
    sad [015]
    jmp wcr
    sad [012]
    jmp wgo
    sub [040]
    sma
    dzm rBol
    jmp rtn
wcr, jsp wrBol
wgo, dzm rMode
    jsp rdShow
rtn, jmp 0
    endloc

// Adds a character to the word being typed. Past WORDMAX it is dropped.
// Takes the character's code in AC. AC and IO are clobbered. Called via jda.
rdAdd,
    local rtn
    0                       // jda puts the argument here
    dap rtn
    lac rWLen
    sub [WORDMAX]
    sma
    jmp rtn
    lac rWLen
    add [rW:013]
    dac rdT
    lac rdAdd
    dac i rdT
    idx rWLen
rtn, jmp 0
    endloc

// Handles a word's delimiter. The word is looked up (rdAnal) and put in
// the sentence, or the sentence is stopped at it if it is unknown. Then any
// punctuation that ended it is handled.
// AC and IO are clobbered. Called via jsp.
rdEndW,
    local rtn, ok, one, full, punc
    dap rtn
    lac rWLen
    sza i
    jmp punc
    dac aN
    jsp rdAnal
    sad [1]
    jmp ok
    sad [2]
    jmp full
    sad [3]
    jmp punc-1
    // Unknown. The original's two lines are printed, then nothing more is
    // read but the Return that continues the sentence. The punctuation is lost.
    jsp rdSorry
    dzm rWLen
    dzm rPunct
    dzm rQuote
    law 2
    dac rMode
    jmp rtn
ok, lac rOut1
    jda rdPut
    lac rOutN
    sad [1]
    jmp one
    lac rOut2
    jda rdPut
one, jmp punc-1
full, law 1
    dac rFull
    dzm rWLen
punc, lac rPunct
    sza
    jsp rdPunc
rtn, jmp 0
    endloc

// Puts a word in the sentence. A sentence past SENTMAX words is marked
// full, and gets NO ROOM at its end.
// Takes the word's entry in AC. AC and IO are clobbered. Called via jda.
rdPut,
    local rtn, full
    0                       // jda puts the argument here
    dap rtn
    lac rSLen
    sub [SENTMAX]
    sma
    jmp full
    lac rSLen
    add [rSent:013]
    dac rdT
    lac rdPut
    dac i rdT
    idx rSLen
    jmp rtn
full, law 1
    dac rFull
rtn, jmp 0
    endloc

// Handles the punctuation in rPunct. . ? or ! ends the sentence, and : and
// ; go into it as words (the original's PUNC).
// AC and IO are clobbered. Called via jsp.
rdPunc,
    local rtn, fin, col
    dap rtn
    lac rPunct
    dzm rPunct
    sad ['.']
    jmp fin
    sad ['?']
    jmp fin
    sad ['!']
    jmp fin
    sad [':']
    jmp col
    lac [lxSemi:2]
    jda rdPut
    jmp rtn
col, lac [lxColon:2]
    jda rdPut
    jmp rtn
fin, dac rFin
    jsp rdSent
    jsp rdClear
rtn, jmp 0
    endloc

// Reports a sentence read whole. Its words and its punctuation go on a
// line after WORDS:, then what the parser made of it (parse.ac), or NO
// ROOM. Then *. A sentence with no words gets only the *. The line is wrapped as the
// replies are (print.ac's psFit), by psCol, which wrc does not keep.
// AC and IO are clobbered. Called via jsp.
rdSent,
    local rtn, loop, star, p, k, w
    dap rtn
    jsp wrBol
    lac rFull
    sza i
    jmp .+5
    lac [sNoRoom:013]
    jda wrs
    jsp wrnl
    jmp star
    lac rSLen
    sza i
    jmp star
    dac k
    lac [sWords:4]
    jda wrs
    law 6                   // the length of WORDS:
    dac psCol
    lac [rSent:013]
    dac p
loop, lac i p
    dac w
    dzm wrLen
    idx wrDry
    lac w
    jda wrSpell
    dzm wrDry
    lac wrLen
    jda psFit
    lac w
    jda wrSpell
    lac psCol
    add wrLen
    dac psCol
    idx p
    lac k
    sub [1]
    dac k
    sza
    jmp loop
    law 1
    jda psFit
    lac rFin
    jda wrc
    jsp wrnl
    dzm psCol
    jsp psParse
star, jsp wrStar
rtn, jmp 0
p, 0
k, 0
w, 0
    endloc

// The sentence so far, each word followed by a space, for the user to go
// on from (the original's DO).
// AC and IO are clobbered. Called via jsp.
rdShow,
    local rtn, loop, p, k
    dap rtn
    lac rSLen
    sza i
    jmp rtn
    dac k
    lac [rSent:013]
    dac p
loop, lac i p
    jda wrSpell
    jsp wrsp
    idx p
    lac k
    sub [1]
    dac k
    sza
    jmp loop
rtn, jmp 0
p, 0
k, 0
    endloc

// Prints an unknown word's two lines, the first as the transcript has it,
// the second as the code does, Return standing for its line feed.
//     SORRY, I DON'T KNOW THE WORD "STEEPLE".
//     PLEASE TYPE RETURN AND CONTINUE THE SENTENCE.
// The word is the first aN characters of rW.
// AC and IO are clobbered. Called via jsp.
rdSorry,
    local rtn
    dap rtn
    jsp wrBol
    lac [sSorry:5]
    jda wrs
    law 042
    jda wrc
    lac aN
    dac wcLen
    lac [rW:013]
    jda wrCodes
    law 042
    jda wrc
    law '.'
    jda wrc
    jsp wrnl
    lac [sPlease:1]
    jda wrs
    jsp wrnl
rtn, jmp 0
    endloc

// rdAnal from any bank (evlisp.ac). AC and IO as rdAnal's. Called via jsp.
rdAnalF, dac rdAr
    jsp rdAnal
    jmp i rdAr
rdAr, 0

// The original's ETAOIN from its WORD on (morpho.13:111-285), for the
// first aN characters of rW. The result is the word found, or derived by
// the morphology, or learned if a quote opened it (rNew), or unknown. A
// word derived or learned is kept (rdNew). The words it gives the sentence
// are rOut1 and, for a contraction of IS (THAT'S), rOut2. rOutN says which.
// Where the original's ROOT is left from the word before, the possessive
// of a word found as it is, the root here is that word, whose meaning
// the possessive has.
// Returns AC 0 if unknown, 1 if found, 2 if there is no room for it, 3 if
// nothing is left of it (a lone 'S). IO is clobbered. Called via jsp.
rdAnal,
    local rtn, word, num, notone, nodig, eq, eqnext, eqdone, cut, notnt, \
        nots1, noap, noly, noing, noed, noen, noer, noest, ly, lylook, \
        fix, f2, f3, f3b, f3c, f3d, adde, sib, s2, s3, s4, s5, try, \
        tless, tmod, no, wrd, notn, notp, plain, poss, empty, noroom, k, p
    dap rtn
    dzm rOutN
    dzm rPossN
    dzm rRoot
word, lac aN
    sza i
    jmp empty
    // A word of digits is a number (NUM, and NS for 1).
    dac k
    lac [rW:013]
    dac p
num, lac i p
    sub [CH_0]
    spa
    jmp nodig
    sub [0d10]
    sma
    jmp nodig
    idx p
    lac k
    sub [1]
    dac k
    sza
    jmp num
    jsp rdLookW
    sza
    jmp wrd
    jsp mZero
    law fNUM
    jda mSet
    jsp rdOne
    jmp notone
    law fNS
    jda mSet
notone, dzm rNewRoot
    lac [rW:013]
    jda rdNewW
    jmp wrd
nodig, jsp rdLookW
    sza
    jmp wrd
    // A word starting = is a name, a possessive one if it has an '.
    lac rW
    sas [CH_EQ]
    jmp cut
    jsp mZero
    law fPROPN
    jda mSet
    law fNS
    jda mSet
    lac aN
    dac k
    lac [rW:013]
    dac p
eq, lac i p
    sas [CH_APOS]
    jmp eqnext
    law fPOSS
    jda mSet
    jmp eqdone
eqnext, idx p
    lac k
    sub [1]
    dac k
    sza
    jmp eq
eqdone, dzm rNewRoot
    lac [rW:013]
    jda rdNewW
    jmp wrd

    // The endings (CUT), on the word's last three characters.
cut, jsp rdLast3
    lac aC1
    sas [CH_T]
    jmp notnt
    lac aC2
    sas [CH_APOS]
    jmp notnt
    lac aC3
    sas [CH_N]
    jmp notnt
    law 3
    jda rdStem
    law CH_STAR
    dac aEnd
    jmp try
notnt, lac aC1
    sas [CH_S]
    jmp nots1
    lac aC2
    sas [CH_APOS]
    jmp nots1
    jsp rdPossW
    lac aN
    sub [2]
    dac aN
    jmp word
nots1, lac aC1
    sas [CH_APOS]
    jmp noap
    jsp rdPossW
    lac aN
    sub [1]
    dac aN
    jmp word
noap, lac aC1
    sas [CH_Y]
    jmp noly
    lac aC2
    sas [CH_L]
    jmp noly
    law 2
    jda rdStem
    jmp ly
noly, lac aC1
    sas [CH_G]
    jmp noing
    lac aC2
    sas [CH_N]
    jmp noing
    lac aC3
    sas [CH_I]
    jmp noing
    law 3
    jda rdStem
    law CH_G
    dac aEnd
    jmp fix
noing, lac aC1
    sas [CH_D]
    jmp noed
    lac aC2
    sas [CH_E]
    jmp noed
    law 2
    jda rdStem
    law CH_D
    dac aEnd
    jmp fix
noed, lac aC1
    sas [CH_N]
    jmp noen
    lac aC2
    sas [CH_E]
    jmp noen
    law 2
    jda rdStem
    law CH_N
    dac aEnd
    jmp fix
noen, lac aC1
    sas [CH_R]
    jmp noer
    lac aC2
    sas [CH_E]
    jmp noer
    law 2
    jda rdStem
    law CH_R
    dac aEnd
    jmp fix
noer, lac aC1
    sas [CH_T]
    jmp noest
    lac aC2
    sas [CH_S]
    jmp noest
    lac aC3
    sas [CH_E]
    jmp noest
    law 3
    jda rdStem
    law CH_T
    dac aEnd
    jmp fix
noest, lac aC1
    sas [CH_S]
    jmp no
    law 1
    jda rdStem
    law CH_S
    dac aEnd
    jmp sib

    // -LY makes an adverb of an adjective, the silent E put back first.
ly, jsp rdStem3
    lac aL
    jda rdCls
    and [1]
    sza i
    jmp lylook
    lac aL
    sad [CH_E]
    jmp lylook
    lac aX
    jda rdCls
    and [2]
    sza
    jsp rdAddE
lylook, lac rRLen
    sza i
    jmp no
    lac [rR:013]
    dac pkSrc
    lac rRLen
    dac pkLen
    jsp rdLook
    sza i
    jmp no
    dac rNewRoot
    jsp mZero
    lac rNewRoot
    jda mOrEnt
    law fADJ
    jda mTest
    jmp no
    jsp mZero
    law fADV
    jda mSet
    law fVBAD
    jda mSet
    lac rNewRoot
    dac rRoot
    lac [rW:013]
    jda rdNewW
    jmp wrd

    // -ING, -ED, -EN, -ER, -EST. The stem's spelling is mended by the
    // original's three repairs in its order.
fix, jsp rdStem3
    // Undoubling, for a consonant not a liquid, twice (STOPPED).
    lac aL
    jda rdCls
    and [6]
    sas [2]
    jmp f2
    lac aL
    sas aX
    jmp f2
    lac rRLen
    sub [1]
    dac rRLen
    jmp try
    // I to Y (TIDIED).
f2, lac aL
    sas [CH_I]
    jmp f3
    lac rRLen
    add [rR:013]
    sub [1]
    dac rdT
    law CH_Y
    dac i rdT
    jmp try
    // The silent E (BAKED, TALLER from TALL does not get one).
    // A consonant after a vowel not E after a consonant,
f3, lac aL
    jda rdCls
    and [2]
    sza i
    jmp f3b
    lac aX
    jda rdCls
    and [1]
    sza i
    jmp f3b
    lac aX
    sad [CH_E]
    jmp f3b
    lac aY
    jda rdCls
    and [2]
    sza
    jmp adde
    // or a liquid after a consonant not a liquid,
f3b, lac aL
    jda rdCls
    and [4]
    sza i
    jmp f3c
    lac aX
    jda rdCls
    and [6]
    sad [2]
    jmp adde
    // or TH,
f3c, lac aL
    sas [CH_H]
    jmp f3d
    lac aX
    sad [CH_T]
    jmp adde
    // or one of C G S J V Z after a liquid, or after two vowels.
f3d, lac aL
    jda rdCls
    and [010]
    sza i
    jmp try
    lac aX
    jda rdCls
    and [4]
    sza
    jmp adde
    lac aX
    jda rdCls
    and [1]
    sza i
    jmp try
    lac aY
    jda rdCls
    and [1]
    sza i
    jmp try
adde, jsp rdAddE
    jmp try

    // -S. The stem's spelling is mended (SIB).
sib, jsp rdStem3
    lac aL
    sas [CH_E]
    jmp try
    lac aX
    sas [CH_I]
    jmp s2
    lac rRLen               // FLIES, the IE to Y
    sub [2]
    dac rRLen
    add [rR:013]
    dac rdT
    law CH_Y
    dac i rdT
    idx rRLen
    jmp try
s2, sas [CH_X]
    jmp s3
    lac rRLen               // BOXES
    sub [1]
    dac rRLen
    jmp try
s3, sas [CH_H]
    jmp s4
    lac aY
    sad [CH_T]
    jmp try
    lac rRLen               // PUSHES, not CLOTHES
    sub [1]
    dac rRLen
    jmp try
s4, sad [CH_S]
    jmp s5
    sas [CH_Z]
    jmp try
s5, sas aY
    jmp try
    lac rRLen               // as the original does, GLASSES to GLAS
    sub [2]
    dac rRLen

    // TRY. The stem is looked up in the lexicon, or an irregular form's
    // root, with the ending's MOD applied to its features. Otherwise one E
    // less is tried again.
try, lac rRLen
    sza i
    jmp no
    lac [rR:013]
    dac pkSrc
    lac rRLen
    dac pkLen
    jsp rdLook
    sza i
    jmp tless
    dac rNewRoot
    jsp mZero
    lac rNewRoot
    jda mOrEnt
    lac rNewRoot
    add [1]
    dac rdT
    lac i rdT
    and [2]
    sza i
    jmp tmod
    lac rNewRoot            // an irregular form's root
    add [2]
    dac rdT
    lac i rdT
    dac rNewRoot
    jmp tmod
tless, lac rRLen            // not found, so one E less, if it ends in E
    add [rR:013]
    sub [1]
    dac rdT
    lac i rdT
    sas [CH_E]
    jmp no
    lac rRLen
    sub [1]
    dac rRLen
    jmp try
tmod, lac aEnd
    jda rdMod
    lac rNewRoot
    dac rRoot
    lac [rW:013]
    jda rdNewW
    jmp wrd
no, lac rNew
    sza i
    jmp rtn                 // unknown, so AC is 0
    // An unknown quoted word is learned as a noun and a name, its own
    // root, then put into the sentence.
    dzm rNew
    jsp mZero
    law fNOUN
    jda mSet
    law fPROPN
    jda mSet
    law fNS
    jda mSet
    dzm rNewRoot
    lac [rW:013]
    jda rdNewW
    sza i
    jmp noroom
    dac rdT
    add [2]
    dac p
    lac rdT
    dac i p

    // WRD. A possessive is made of a noun or a name. Anything else with
    // 'S is the word and IS.
wrd, sza i
    jmp noroom
    dac aE
    lac rPossN
    sza i
    jmp plain
    jsp mZero
    lac aE
    jda mOrEnt
    law fNOUN
    jda mTest
    jmp notn
    jmp poss
notn, law fPROPN
    jda mTest
    jmp notp
    jmp poss
notp, lac aE
    dac rOut1
    lac [lxBeS:2]
    dac rOut2
    law 2
    dac rOutN
    law 1
    jmp rtn
poss, law fPOSS
    jda mMeet
    law fPOSS
    jda mSet
    // The root, whose meaning the possessive has (morpho.13:248), is the
    // word's root if this word was derived, else the word. A kept derived
    // word found again (BLOCKS) has no root bit, so its possessive has no
    // meaning.
    lac rRoot
    sza i
    lac aE
    dac rNewRoot
    lac rPossN
    dac aN
    lac [rPw:013]
    jda rdNewW
    sza i
    jmp noroom
    dac aE
plain, lac aE
    dac rOut1
    law 1
    dac rOutN
    jmp rtn
empty, law 3
    jmp rtn
noroom, law 2
rtn, jmp 0
k, 0
p, 0
    endloc

// Skips if the number in the first aN characters of rW is 1, that is, the
