    dap rtn
    dzm h
    lac [rPk:013]
    dac p
    lac rPkN
    dac k
loop, lac i p
    xor h
    dac h
    idx p
    lac k
    sub [1]
    dac k
    sza
    jmp loop
    lac h
    rar 6s
    xor h
    dac t
    lac h
    rar 9s
    rar 3s
    xor t
    and [077]
rtn, jmp 0
p, 0
k, 0
h, 0
t, 0
    endloc

