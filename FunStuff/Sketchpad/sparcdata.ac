cyK, 0
cyPC, 0
cyNA, 0
cyJ, 0
cyP, 0
cyQ, 0
mwA, 0
mwB, 0
mwN, 0
mwD, 0

// The master directory: each master's length in words, 0 while its slot is empty, then its box
// relative to its origin; NMASTER of each.
mLen,
