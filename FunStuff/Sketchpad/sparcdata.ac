// sparcdata.ac -- bank 2's storage: the arc being drawn, Copy's counts, the arc table and a
// drag's arcs, and the sine table. The instance table is in bank 10 (sketchpad.am1).
//
// Bank 2, after spdefine.ac.
// Part of sketchpad.am1, included where it stands.

// The arc being drawn, or written. Center, and the start's offset from it, in 32nds. arcX32
// and arcY32 are the center in 32nds plus a half, so a vertex rounds to a unit with one shift.
// arcR32 is the radius in 32nds. arcDir: 1 counterclockwise, -1 clockwise, 0 not yet chosen.
// arcK: whole steps swept. arcAllOn: nonzero when every vertex of the full circle is on the
// canvas.
// arcCX to arcQY stay together, AKEEPN words, for arcLock's save of them (spedit.ac's arcKeep).
arcCX, 0
arcCY, 0
arcU, 0
arcV, 0
arcX32, 0
arcY32, 0
arcR32, 0
arcDir, 0
arcK, 0
arcAllOn, 0
// arcSinCos's results, 17-bit fractions.
arcS, 0
arcC, 0
// arcVertex's results: the offset in 32nds, and the vertex rounded to a unit.
arcUk, 0
arcVk, 0
arcX, 0
arcY, 0
// The pen's direction from the center as a vector of length 65536, and its distance in 32nds.
arcPX, 0
arcPY, 0
arcPH, 0
// The arc's end; arcCross's dot product; the band's part-step word, 0 for none.
arcEX, 0
arcEY, 0
arcDot, 0
arcPart, 0
// arcEntry's copies of the main bank's pseudo pen location and target center; the point arcNorm
// measures.
mPenX, 0
mPenY, 0
mHitX, 0
mHitY, 0
arcQX, 0
arcQY, 0
// The table routines' scratch: arcRenum's renumbering; the two points arcDelete holds, which
// follow a point moved into a removed one's place, as the arc's points still to check do; the
// merge's two points; ptPut's position; and a drag's point and where it goes.
rnFrom, 0
rnTo, 0
heldK, 0
heldJ, 0
delS, 0
delE, 0
mgP, 0
mgQ, 0
ppX, 0
ppY, 0
dgP, 0
dgX, 0
dgY, 0
// The band's words for penISR (arcPut): while arcPosting is set, arcPostN of them, at the full
// addresses in arcPostA.
arcPosting, 0
arcPostN, 0
arcPostA,
    table APOSTS, 0
arcPostW,
    table APOSTS, 0
// Set by a change of view (arcView): the band's vectors are to be written again at its next
// pass, by the view module's vaBand, whatever the scale.
arcRebase, 0
// Define's work: the slot, the main bank's lineCount, the pass (0 the box's, 1 the words'), the
// box, the origin, where the beam is, the words written, their drawing time in half
