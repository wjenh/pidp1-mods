mMinX,
    table NMASTER, 0
mMaxX,
    table NMASTER, 0
mMinY,
    table NMASTER, 0
mMaxY,
    table NMASTER, 0

// Copy's part of the directory, CBOXOFF words after the figure's box: the copy box, the
// figure's box widened to take in every point, relative to the origin; then how many points,
// lines and arcs Copy's store holds for each master.
cMinX,
    table NMASTER, 0
cMaxX,
    table NMASTER, 0
cMinY,
    table NMASTER, 0
cMaxY,
    table NMASTER, 0
cpNP,
    table NMASTER, 0
cpNL,
    table NMASTER, 0
cpNA,
