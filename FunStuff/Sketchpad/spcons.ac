    sal 1s              // k * CW, 6
    add [cEntries:011]
    dac dlT
    lac i dlT
    sad [CTF]           // skip unless a fix
    jmp dlFix
    idx dlT
    lac [NOPOINT]       // its A gone, so cPurge drops it
    dac i dlT
    jsp cPurge
    law 1
    dac cTopo
    jmp dlDone
dlFix,
    idx dlT
    lac i dlT
    jda cUnfix
dlDone,
    jsp cMarks
    cla
rtn, jmp .
dlT, 0
    endloc

// Misc's Del cons. Every entry is dropped, fixes, attachers, designations and the numbers' D, Y
// and O among them, but the truss's beams, loads and rollers (CTBEAM to CTROLL), the points left
// where they are. The sets are built again from what is left, which clears every fix's flag,
// and the marks written.
// The solver is neither woken nor put to sleep, since the ties it may be settling are no
// entries; while it is awake its sweep starts again from the first entry (cWake), the table
// having closed up under it.
// Exit: AC = 0. IO is clobbered. Called via jsp.
cDelAll,
    local rtn, daLoop, daDrop, daNext, daDone, daP, daT
    dap rtn
    lac [cEntries:011]
    dac daP
daLoop,
    lac daP
    sad cEnd            // skip while entries remain
    jmp daDone
    lac i daP
    sub [CTBEAM]
    spa                 // skip unless below CTBEAM
    jmp daDrop
    sub [CTROLL-CTBEAM+1]
    spa                 // skip if past CTROLL: a designation, or a number's type
    jmp daNext
daDrop,
    lac daP
    add [1]
    dac daT
    lac [NOPOINT]       // its A gone, so cPurge drops it
    dac i daT
daNext,
    lac daP
    add [CW]
    dac daP
    jmp daLoop
daDone,
    jsp cPurge
    jsp cBuild
    lac cRun
    sza                 // skip unless the solver is awake
    jsp cWake
    jsp cMarks
    cla
rtn, jmp .
daP, 0
daT, 0
    endloc

// Misc's Unfix. Every fix, attacher and designation is dropped, the points left where they are;
// instances' tie points are no entries and stay. The sets are built again from what is left,
// which clears every fix's flag, and the marks written. The solver is woken while entries or
// ties remain, since a point freed may let the figure settle where a fix made it give up.
// Exit: AC = 0. IO is clobbered. Called via jsp.
cUnfixAll,
    local rtn, uaLoop, uaDrop, uaNext, uaDone, uaP, uaT
    dap rtn
    lac [cEntries:011]
    dac uaP
uaLoop,
    lac uaP
    sad cEnd            // skip while entries remain
    jmp uaDone
    lac i uaP
    sad [CTF]           // skip unless a fix
    jmp uaDrop
    sad [CTDES]         // skip unless a designation
    jmp uaDrop
    sas [CTATT]         // skip if an attacher
    jmp uaNext
uaDrop,
    lac uaP
    add [1]
    dac uaT
    lac [NOPOINT]       // its A gone, so cPurge drops it
    dac i uaT
uaNext,
    lac uaP
    add [CW]
    dac uaP
    jmp uaLoop
uaDone,
    jsp cPurge
    jsp cBuild
    lac i [cCount:011]
    ior cInN
    sza                 // skip unless entries or ties remain
    jsp cWake
    jsp cMarks
    cla
rtn, jmp .
uaP, 0
uaT, 0
    endloc

// Fix's lift on point p, unfixed if it is fixed (cUnfix); else fixed, an F entry, every point's
// place kept first (cSnap) as for an H; refused on a roller or with the table full.
// Fixing moves nothing, so the solver is not woken. Either way the marks are written again.
// Entry: AC = p. Exit: AC = 0 fixed, 1 unfixed, 2 refused. IO is clobbered. Called via jda.
cFix, 0
    local rtn, fxOff, fxFull
    dap rtn
    lac [CTF]
    dac cfT
    lac cFix
    dac cfA
    lac [CUNUSED]
    dac cfB
    jsp cUnused
    lac cEnd
    dac cfLim
    jsp cFind
    sza                 // skip unless it is fixed
    jmp fxOff
    lac [CTROLL]
    dac cfT
    jsp cFind
    sza                 // skip unless it is a roller
    jmp fxFull
    lac [CTF]
    dac cfT
    lac i [cCount:011]
    sad [NCON]          // skip unless the table is full
    jmp fxFull
    jsp cSnap
    jsp cAppend
    lac cFix
    lio [FFIX]
    jda cFlagOr
    jsp cMarks
    jmp rtn
fxOff,
    lac cFix
    jda cUnfix
    jsp cMarks
    law 1
    jmp rtn
fxFull,
    law 2
rtn, jmp .
    endloc

// Tie's lift on point p, an attacher's entry (CTATT) on it dropped
// if it has one; else one made, its parameter one past the latest designation's, CUNUSED's sign
// bit set, so that Define takes the attachers in the order designated (instMap), every point's
// place kept first (cSnap) as for an F; refused at NATT attachers or with the table full. Nothing
// moves, so the solver is not woken. Either way the marks are written again.
// Designate's lift (cDes) is the same with a designation's entry (CTDES), up to NATT of them;
// the k-th in the table is designation k, the parameter's order kept as well.
// Entry: AC = p. Exit: AC = 0 made, 1 dropped, 2 refused. IO is clobbered. Called via jda.
cDes, 0
    local rtn, atTy, atLoop, atNext, atGo, atOff, atFull, atP, atT, atN, atM, atY
    dap rtn
    lac cDes
    dac cAtt
    lac [CTDES]
    jmp atTy
cAtt, 0
    dap rtn
    lac [CTATT]
atTy,
    dac atY
    dac cfT
    lac cAtt
    dac cfA
    lac [CUNUSED]
    dac cfB
    jsp cUnused
    lac cEnd
    dac cfLim
    jsp cFind
    sza                 // skip unless it is an attacher, or designated
    jmp atOff
    dzm atN
    lac [CUNUSED]
    dac atM
    lac [cEntries:011]
    dac atP
atLoop,
    lac atP
    sad cEnd            // skip while entries remain
    jmp atGo
    lac i atP
    sas atY             // skip if an attacher, or a designation
    jmp atNext
    idx atN
    lac atP
    add [5]
    dac atT
    lac i atT
    sub atM
    spa                 // skip unless designated before the latest so far
    jmp atNext
    lac i atT
    dac atM
atNext,
    lac atP
    add [CW]
    dac atP
    jmp atLoop
atGo,
    lac atN
    sad [NATT]          // skip unless every attacher is designated
    jmp atFull
    lac i [cCount:011]
    sad [NCON]          // skip unless the table is full
    jmp atFull
    lac atM
    add [1]
    dac cfPar
    jsp cSnap
    jsp cAppend
    jsp cMarks
    cla
    jmp rtn
atOff,
    add [1]
    dac atT
    lac [NOPOINT]       // its A gone, so cPurge drops it
    dac i atT
    jsp cPurge
    law 1
    dac cTopo
    jsp cMarks
    law 1
    jmp rtn
atFull,
    law 2
rtn, jmp .
atP, 0
atT, 0
atN, 0
atM, 0
atY, 0
    endloc

// Copy's drop, before its parts are added. The designated points, in the order
// designated, written to bank 3's desPt for the arc module's copyMerge, the rest of its NATT
// words NOPOINT; then the designations dropped, the table purged and the marks written (cMarks),
// before cCopy keeps the table's count for Undo (cSnap), so that Undo of the drop does not bring
// them back.
// Exit: AC = 0. IO is clobbered. Called via jsp.
cDesTake,
    local rtn, dtLoop, dtNext, dtFill, dtMk, dtP, dtK
    dap rtn
    lac [desPt:3]
    dac dtK
    lac [cEntries:011]
    dac dtP
dtLoop,
    lac dtP
    sad cEnd            // skip while entries remain
    jmp dtFill
    lac i dtP
    sas [CTDES]         // skip if a designation
    jmp dtNext
    idx dtP
    lac i dtP
    dac i dtK
    idx dtK
    lac [NOPOINT]       // its A gone, so cPurge drops it
    dac i dtP
    lac dtP
    sub [1]
    dac dtP
dtNext,
    lac dtP
    add [CW]
    dac dtP
    jmp dtLoop
dtFill,
    lac dtK
    sad [desPt:3 + NATT]    // skip while words remain
    jmp dtMk
    lac [NOPOINT]
    dac i dtK
    idx dtK
    jmp dtFill
dtMk,
    jsp cPurge
    law 1
    dac cTopo
    jsp cMarks
    cla
rtn, jmp .
dtP, 0
dtK, 0
    endloc

// Roller's lift on point p, its roller entry (CTROLL) dropped if it has one; else
// one made, every point's place kept first (cSnap) as for an F; refused on a fixed point or with
// the table full. Only the truss's analysis reads it, so the solver is not woken. Either way the
// marks are written again.
// Entry: AC = p. Exit: AC = 0 made, 1 dropped, 2 refused. IO is clobbered. Called via jda.
cRoll, 0
    local rtn, roOff, roNo, roT
    dap rtn
    lac [CTROLL]
    dac cfT
    lac cRoll
    dac cfA
    lac [CUNUSED]
    dac cfB
    jsp cUnused
    lac cEnd
    dac cfLim
    jsp cFind
    sza                 // skip unless it is a roller
    jmp roOff
    lac [CTF]
    dac cfT
    jsp cFind
    sza                 // skip unless it is fixed
    jmp roNo
    lac [CTROLL]
    dac cfT
    lac i [cCount:011]
    sad [NCON]          // skip unless the table is full
    jmp roNo
    jsp cSnap
    lac cfA             // level, its axis's line its point twice
    dac cfB
    dac cfC
    jsp cAppend
    jsp cMarks
    cla
    jmp rtn
roOff,
    add [1]
    dac roT
    lac [NOPOINT]       // its A gone, so cPurge drops it
    dac i roT
    jsp cPurge
    law 1
    dac cTopo
    jsp cMarks
    law 1
    jmp rtn
roNo,
    law 2
rtn, jmp .
roT, 0
    endloc

// Axis's lifts on point p. The first, the main bank's consPick 0, asks whether p is a roller.
// The second gives p's roller line consL2 as its axis, the line's two points kept in its entry's
// B and C words, the smaller first, so that the axis turns as the line does; the truss's
// analysis (taRlD) and the O's ticks (cRlDir) take its
// direction from their places. Only the analysis reads it, so the solver is not woken; the marks
// are written again.
// Entry: AC = p. Exit: AC = 0 a roller, or its axis set; 1 no roller. IO is clobbered. Called
// via jda.
cAxis, 0
    local rtn, axNo, axE, axT
    dap rtn
    lac [CTROLL]
    dac cfT
    lac cAxis
    dac cfA
    jsp cUnused
    lac cEnd
    dac cfLim
    jsp cFind
    sza i               // skip if p is a roller
    jmp axNo
    dac axE
    lac i [consPick:4]
    sza i               // skip if the second lift
    jmp rtn             // AC is 0
    lac i [consL2:4]
    jda cEnds
    lac axE
    add [2]
    dac axT
    lac ceF
    dac i axT
    idx axT
    lac ceT
    dac i axT
    lac axE
    add [2]
    jda cSort2
    jsp cMarks
    jmp rtn             // AC is 0
axNo,
    law 1
rtn, jmp .
axE, 0
axT, 0
    endloc

// Stiff's lift on line l, whether it is a member, a Beam drawn either way
// round; if so, its parameter word, the stiffness, whose address is kept (cStE) for the keyboard's
// answer (cStSet). The keyboard is open in between, and nothing changes the table meanwhile.
// Entry: AC = l. Exit: AC = the Beam's parameter word, which is negative, or 0 for no member. IO
// is clobbered. Called via jda.
cStiff, 0
    local rtn, sfHas
    dap rtn
    lac cStiff
    jda cEnds
    jsp cUnused
    lac [CTBEAM]
    dac cfT
    lac cEnd
    dac cfLim
    lac ceF
    dac cfA
    lac ceT
    dac cfB
    jsp cFind
    sza                 // skip unless a member drawn from its start
    jmp sfHas
    lac ceT
    dac cfA
    lac ceF
    dac cfB
    jsp cFind
    sza i               // skip if a member drawn from its end
    jmp rtn             // AC is 0
sfHas,
    add [5]
    dac cStE
    lac i cStE
rtn, jmp .
    endloc

// The keyboard's answer for Stiff's member (cStiff), its parameter word set. The truss's
// analysis finds the change in its snapshot; nothing else reads the word.
// Entry: AC = the parameter word. Exit: AC = 0. IO is preserved. Called via jda.
cStSet, 0
    dap ssRtn
    lac cStSet
    dac i cStE
    cla
ssRtn, jmp .
cStE, 0

// Write the marks in bank 0 (fixList), through the marks module in bank 13 (spmarks.ac,
// mkMarks). A table changed since the sets were built is
// purged and built first, so that every entry names points that exist.
// Exit: AC = 0. IO is clobbered. Called via jsp.
cMarks,
    local rtn, cmGo
    dap rtn
    lac cTopo
    sza i               // skip if the table changed since the build
    jmp cmGo
    jsp cPurge
    jsp cBuild
cmGo,
    jsp i [mkMarks:015]
rtn, jmp .
    endloc

// Delete's lock with Show on, the mark nearest the target's center, found by the marks module
// (spmarks.ac, mkNear), stale marks written first.
// Exit: AC = the entry, NOPOINT if none or Show is off; cNearX, cNearY its mark's place. IO is
// clobbered. Called via jsp.
cNear,
    local rtn
    dap rtn
    lac cTopo
    ior cMkDirty
    sza                 // skip unless the marks are stale
    jsp cMarks
    jsp i [mkNear:015]
rtn, jmp .
    endloc

// Unfix point p, every F entry on it dropped, its flag cleared.
// Entry: AC = p. AC and IO are clobbered. Called via jda.
cUnfix, 0
    local rtn, ufLoop, ufDone, ufT
    dap rtn
    lac [CTF]
    dac cfT
    lac cUnfix
    dac cfA
    lac [CUNUSED]
    dac cfB
    jsp cUnused
ufLoop,
    lac cEnd
    dac cfLim
    jsp cFind
    sza i               // skip if an F entry holds it
    jmp ufDone
    add [1]
    dac ufT
    lac [NOPOINT]
    dac i ufT
    jmp ufLoop
ufDone,
    jsp cPurge
    lac cUnfix
    add [cFlag:011]
    dac ufT
    lac i ufT
    and [FFIXOFF]
    dac i ufT
    law 1
    dac cTopo
rtn, jmp .
ufT, 0
    endloc

// A drag's move of point p, unfixed if it was fixed (in the thesis, moving an object with the
// light pen unfixes it), a reload asked for (cRld), and the main loop's pass asked for while
// there are entries, so that the solver takes up the move (cReload). The reload takes up every
// solver point, since moving an arc by its center moves its rim points too. Where p now is is
// kept (cDropX, cDropY), to find the point dropped again after a merge (cRefind).
// Entry: AC = p. Exit: AC = 0. IO is clobbered. Called via jda.
cDrag, 0
    local rtn, dgGo, dgWake, dgT, dgAt
    dap rtn
    lac [cDropX:010]
dgGo,
    dac dgAt
    law 1
    dac cRld
    lac cDrag
    add [pointX:3]
    dac dgT
    lac i dgT
    dac i dgAt
    idx dgAt
    lac cDrag
    add [pointY:3]
    dac dgT
    lac i dgT
    dac i dgAt
    lac cDrag
    add [cFlag:011]
    dac dgT
    lac i dgT
    and [FFIX]
    sza i               // skip if fixed
    jmp dgWake
    lac cDrag
    jda cUnfix
dgWake,
    lac i [cCount:011]
    ior cInN
    sza                 // skip unless there are entries or ties
    dac i [conWake:4]
    cla
rtn, jmp .
dgT, 0
dgAt, 0

// cDrag for the second point held, a line's to end while the line is dragged whole. It is held
// as cHeld2, as the pen holds the first (cTick), and where it now is kept in cDrop2X, cDrop2Y
// for cRefind.
// Entry: AC = p. Exit: AC = 0. IO is clobbered. Called via jda.
cDrag2, 0
    dap rtn
    lac cDrag2
    dac cHeld2
    dac cDrag
    lac [cDrop2X:010]
    jmp dgGo
    endloc

// Keep every point's place, and every instance's origin's, in bank 9's uSX and uSY, and the
// entries' count, for Undo of the entry about to be added; and every scalar's value, in bank 3's
// uScV.
// AC and IO are clobbered. Called via jsp.
cSnap,
    local rtn, snLoop, snIn, snOrg, snSc, snI, snT, snU
    dap rtn
    lac i [cCount:011]
    dac uSC
    lac i [pointCount:4]
    dac uSN
    dzm snI
snLoop,
    lac snI
    sad uSN             // skip while points remain
    jmp snOrg
snIn,
    add [pointX:3]
    dac snT
    lac snI
    add [uSX:011]
    dac snU
    lac i snT
    dac i snU
    lac snI
    add [pointY:3]
    dac snT
    lac snI
    add [uSY:011]
    dac snU
    lac i snT
    dac i snU
    idx snI
    sas [NVAR]          // skip once every origin is kept
    jmp snLoop
    dzm snI             // and every scalar's value
snSc,
    lac snI
    add [scVal:3]
    dac snT
    lac snI
    add [uScV:3]
    dac snU
    lac i snT
    dac i snU
    idx snI
    sas [NSCAL]         // skip once every scalar is kept
    jmp snSc
    jmp rtn
snOrg,
    lac [MAXPTS]
    dac snI
    jmp snIn
rtn, jmp .
snI, 0
snT, 0
snU, 0
    endloc

// Undo of an entry. The last pass's marks cleared (cUnmark) and the points the sweeps touched
// but have not written dropped from cPub (the build the changed topology asks for takes every
// point up from the table, and clears their marks), then every point not where cSnap found it
// goes back, marked (FMOV) and listed at cPub's front for the arc module's conArcs and the main
// bank's conRedraw, its place before kept, so that cRevert puts it there if an arc refuses; the
// table is cut back to its count then, every scalar's value put back, the topology
// has changed, and the solver wakes.
// Exit: AC = 0. IO is clobbered. Called via jsp.
cUndo,
    local rtn, udGo, udLoop, udIn, udBack, udNext, udOrg, udCut, udI, udN, udTX, udTY, udUX, \
        udUY, udT, udSc
    dap rtn
    jsp cUnmark
    dzm cPubN
    lac uSN
    dac udN
    lac i [pointCount:4]
    sub udN
    sma                 // skip if fewer points now
    jmp udGo
    lac i [pointCount:4]
    dac udN
udGo,
    dzm udI
udLoop,
    lac udI
    sad udN             // skip while points remain
    jmp udOrg
udIn,
    add [pointX:3]
    dac udTX
    lac udI
    add [pointY:3]
    dac udTY
    lac udI
    add [uSX:011]
    dac udUX
    lac udI
    add [uSY:011]
    dac udUY
    lac i udUX
    sas i udTX          // skip if x is as kept
    jmp udBack
    lac i udUY
    sas i udTY          // skip if y is as kept
    jmp udBack
    jmp udNext
udBack,
    lac udI
    add [oX:011]
    dac udT
    lac i udTX
    dac i udT
    lac udI
    add [oY:011]
    dac udT
    lac i udTY
    dac i udT
    lac i udUX
    dac i udTX
    lac i udUY
    dac i udTY
    lac udI
    add [cFlag:011]
    dac udT
    lac i udT
    ior [FMOV]
    dac i udT
    lac cMovN
    add [cPub:011]
    dac udT
    lac udI
    dac i udT
    idx cMovN
udNext,
    idx udI
    sas [NVAR]          // skip once every origin is looked at
    jmp udLoop
    jmp udCut
udOrg,
    lac [MAXPTS]
    dac udI
    jmp udIn
udCut,
    lac cMovN
    dac cPubN
    lac uSC
    dac i [cCount:011]
    jsp cEndSet
    dzm udI             // every scalar's value put back
udSc,
    lac udI
    add [uScV:3]
    dac udUX
    lac udI
    add [scVal:3]
    dac udT
    lac i udUX
    dac i udT
    idx udI
    sas [NSCAL]         // skip once every scalar is put back
    jmp udSc
    law 1
    dac cTopo
    dac cScChg
    jsp cWake
    cla
rtn, jmp .
udI, 0
udN, 0
udTX, 0
udTY, 0
udUX, 0
udUY, 0
udT, 0
    endloc

// The module's words.
cRun, 0                 // nonzero while the solver is awake
cHeld, 0                // the point the solver holds: the one dragged, or dropped while the
                        // figure settles (NOPOINT when none)
cPen, 0                 // the point the pen holds, as dragIdx was at the last pass, or the
                        // origin of the instance carried, MAXPTS plus dragInst
cNext, 0                // the sweep's next item: an entry, then an arc of cArcs, then a tie
                        // of cTies
cSweeps, 0              // sweeps since the solver woke
cMax, 0                 // the largest move of the sweep so far, in 32nds
cT0, 0                  // the clock when this pass's sweeping began
cW0, 0                  // the clock at the last wake, for the give-up
cGaveUp, 0              // the give-ups since the last wake, the first counted (cGiveUps)
cPubAt, 0               // the clock at the last write (cPublish)
cGuess, 0               // a guess at the next length cHyp finds, 0 for none
cE, 0                   // the entry the projections work on
cInN, 0                 // points in cIn
cRld, 0                 // nonzero when a drag asks for the next pass's reload
cPubN, 0                // points in cPub
cMovN, 0                // of which the first cMovN carry FMOV marks
cArcN, 0                // arcs in cArcs
cTieN, 0                // ties in cTies
cMkTy, CTF              // the type whose marks show with Show off: CTF, CTATT in Tie mode or
                        // CTROLL in Roller mode (the modes module's afMode sets it)
cLnSeen, 0              // the lines' count at the last build
cArcSeen, 0             // and the arcs'
cCen, 0                 // cArcIn's arc: its center, start and end
cArcS, 0
cArcE, 0
crS, 0                  // cRim's two rim points, about cCen
crE, 0
crG, 0                  // and the full address of their radius' guess word
cU, 0                   // cAlong's ray, its length and its point
cV, 0
cR, 0
cP, 0
clT, 0                  // cClamp1's word and bounds
clLo, 0
clHi, 0
slA, 0                  // cLine's line, cSetLen's length, cTurn's line too
slB, 0
slT, 0
cFA, 0                  // whether each end may move, and either
cFB, 0
cLnF, 0
cTX, 0                  // cTurn's direction, its length
cTY, 0
cTL, 0
cDX, 0                  // cNudge's move
cDY, 0
cxA, 0                  // cProjX's point and line
cxB, 0
cxC, 0
ceF, 0                  // cEnds' line's start and end
ceT, 0
cfT, 0                  // an entry's words, in order, as cMove copies them: for cFind, cBad,
cfA, 0                  // cAppend and cPurge
cfB, 0
cfC, 0
cfD, 0
cfPar, 0
cfLim, 0                // cFind's limit
cfN, 0                  // the points cfT names (cBad)
