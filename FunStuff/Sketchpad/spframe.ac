// The status word, at the labels' size with the light pen off, from (STATX, STATY) under the
// bar's right, jumping back to statEnd. Its four text words are written at run time, by the tape
// module during a transfer, while the display shows WAIT. Every text is nine characters, padded
// with spaces, so its end is always in the fourth word. A frame that reads the words while they
// are written draws parts of two texts, never past the end. The ninth character ends by 886.
// Under it is the picture's name after SAVED or LOADED, blank otherwise, a name's run, msgName,
// written by the tape module with the text.
msgWord, STATPARAM
    y(STATY) next(point)
    x(STATX) next(character)
msgText, type340 "         "
    STATPARAM
    y(NAMEY) next(point)
    x(NAMEX) next(character)
msgName,
    table NAMEW - 1, KBPAD
    KBBLANK
    lpoff next(subroutine)
    jump statEnd next(parameter)

// The arc slots, MAXARCS groups of an arc slot and its target call, then the arc list's
// end; and the arc band. The line list's end in bank 1 jumps to the arc list, whose unused
// slots and end jump back to drawEnd. All written at run time, by the main bank and bank 2.
arcList,
    table MAXARCS * ARCGROUP + 2, 0
arcBand,
    table ARCWORDS + 2, 0

// The master store, master k's words from masters + k * MWORDS, written by Define. An instance's
// gate calls one with save, so the store is in bank 0.
masters,
    table NMASTER * MWORDS, 0

// The screen during a transfer, a self-contained block started by the tape module and cut off by
// tapeCall's dla of the frame. It draws WAIT, then eight invisible vectors out and back, then
// round again, with no halt, since the CPU polls the tape with the break system off and cannot
// restart it. Each word fetched steals a CPU cycle; the vectors, 127 steps at 1.5 us for one
// fetch each, make the loop about 15 fetches in 1.8 ms, about 4% of the tape loop's cycles.
waitList, WAITPARAM
    y(WAITY) next(point)
    x(WAITX) next(character)
    type340 "WAIT"
    scale(0) lpoff next(vector)
    deltax(0d127) deltay(0) right
    deltax(0d127) deltay(0) left
    deltax(0d127) deltay(0) right
    deltax(0d127) deltay(0) left
    deltax(0d127) deltay(0) right
    deltax(0d127) deltay(0) left
    deltax(0d127) deltay(0) right
    deltax(0d127) deltay(0) left end
    lpoff next(subroutine)
    jump waitList next(parameter)
