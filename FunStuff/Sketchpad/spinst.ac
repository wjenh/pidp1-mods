// spinst.ac -- the instance module. Its entry, then the instances, with their slots, adding,
// placing, moving and removing one, its box, lock, scale and light; their tie points and the
// carry of a fastened group; the number keyboard's callers, Change's Dwell and Seq and the
// truss's Stiff; Copy's room and parts; the stubs of the overlay defdism, then defdism itself:
// Define's map and its room in the master store, its parts kept in Copy's store, with its
// constraints, a refusal's word, and a dismember and its Undo; then the words they share.
//
// Bank 7, from its first word. Entered only at instEntry, from the main
// bank's instCall and the view module's vwEntry (IEVIEW), but for mFlat, mDrawOf, mrLoadX,
// poolRoom and rwRun, which bank 11 calls directly, by jsp i [X:7]; runs with the extend window
// open
// throughout, so every indirect address is a 16-bit one, and the main bank's variables are
// reached as OP i [X:4]. Each instance's origin, scale, tie list and iHid are in bank 3, its
// master (iMaster) and the count in bank 10, the master directory in bank 2, its slot in bank 0,
// the masters in the store's two regions, banks 0 and 1.
// Calls nothing outside bank 7 but the text module's entries for the instance module (bank 10),
// the variants (banks 2 and 9), the view module's vwBox and subBring (bank 12), each by jsp i
// [X:n]. The arc module reads Define's
// crosses and the tie points an instance's removal leaves (attN to tgList) through their 16-bit
// addresses. Define's map, room, parts and refusal word, the dismember and its Undo are the drum
// overlay defdism, in bank 6's window W, entered through stubs here under their entries' names;
// it keeps every word it shares with the module here, and reaches them as OP i [X:7].
// Part of sketchpad.am1, included where it stands.

// The module's entry, from the main bank's instCall (and the view module's vwEntry, for IEVIEW,
// which takes no argument). Run entry n with the argument in AC, and return across the banks
// with AC as the routine leaves it. Each table word is the routine's call, a jsp or a jda, so
// each keeps its calling form and returns here inside bank 7.
// Entry: IO = n; AC = the return address, which carries the main bank; instCall (bank 4) = the
// argument. Exit: AC as the entry leaves it, the window open. IO is clobbered. Called via
// jsp i [instEntry:7].
// Every entry but the lock, the light and the cycles' step, which the main loop runs on every
// pass, may change the instances, so the texts' list is written again (the text module's
// txDirty); the step asks for it itself when it takes one (instCycle).
instEntry,
    dac ieRtn
    dio iePtr
    lac iePtr
    sad [IELOCK]        // skip unless the lock
    jmp ieGo
    sad [IESHINE]       // skip unless the light
    jmp ieGo
    sad [IECYSTEP]      // skip unless the cycles' step
    jmp ieGo
    law 1
    dac i [txDirty:012]
ieGo,
    lac iePtr
    add [ieTable:7]
    dac iePtr
    lac i [instCall:4]
    xct i iePtr
    jmp i ieRtn
ieRtn, 0
iePtr, 0

// Entry n -> its call.
ieTable,
    jsp instInit        // IEINIT
    jsp instClear       // IECLEAR
    jda instParam       // IEPARAM
    jda instXY          // IEXY
    jda instGate        // IEGATE
    jda instRemove      // IEREMOVE
    jda instShine       // IESHINE
    jsp instMove        // IEMOVE
    jsp instLock        // IELOCK
    jsp instSize        // IESIZE
    jsp instPlace       // IEPLACE
    jsp instAdd         // IEADD
    jsp instMap         // IEMAP
    jsp instDef         // IEDEF
    jsp copyBring       // IECROOM
    jsp copyParts       // IECPARTS
    jda instPick        // IEPICK
    jsp instBack        // IEBACK
    jsp instSync        // IESYNC
    jsp instSzBack      // IESZBACK
    jsp instReslot      // IERESLOT
    jsp instChange      // IECHANGE
    jsp instCycle       // IECYSTEP
    jda instKbOpen      // IEKBOPEN
    jda instKbDone      // IEKBDONE
    jsp instDism        // IEDISM
    jsp instUndism      // IEUNDISM
    jda instStOpen      // IESTOPEN
    jda instStDone      // IESTDONE
    jsp instNest        // IENEST
    jda instNestAt      // IENESTI
    jsp instViewAll     // IEVIEW
    jda instDefNo       // IEDEFNO
    jsp instStore       // IESTORE
    jsp instWords       // IEWORDS
    jsp instWStore      // IEWSTORE

// A scale's shift, 0 to 3 places left, for xct, giving a master's offset at an instance's scale.
// After them the word ieShOf gives for a multiplier code c, for xct from this bank only.
ieShTab,
    nop
    sal 1s
    sal 2s
    sal 3s
ieShC,
    jda ieOff

// What to xct i for scale word w, in iScale's form: ieShTab's entry for its k, or with a code c,
// ieShC, its k's entry and c kept in ieK and ieC for ieOff. A caller is done with them before
// another ieShOf can run.
// Entry: AC = w. Exit: AC = the full address. IO is preserved. Called via jda, or from another
// bank by dac i [ieShOf:7] and jsp i [ieShOf:7+1].
ieShOf, 0
    local rtn, soNone, rtnW
    dac rtnW
    lac ieShOf
    and [IKMASK]
    add [ieShTab:7]
    dac ieK
    lac ieShOf
    sar 2s
    dac ieC
    sza i               // skip if a code c
    jmp soNone
    lac [ieShC:7]
    jmp rtn
soNone,
    lac ieK
rtn, jmp i rtnW
rtnW, 0
    endloc

// AC at a code c's size: x times c / 2^15, rounded to the nearest, a tie away from zero, so that
// -x lands on minus what x lands on, then << k, since a variant's words are drawn at the 340's
// 2^k and a place on the screen can only be a multiple of it. mul's pair holds the product
// doubled, and three places more leave AC the product / 2^14, the rounding bit lowest; a
// complemented pair rounds by the same word the other way. A small negative rounded to nothing
// comes out +0.
// Entry: AC = x; ieK, ieC. Exit: AC = the value. IO is preserved. Run by xct from ieShC.
ieOff, 0
    local rtn, ioIO
    dap rtn
    dio ioIO
    lac ieOff
    mul ieC
    scl 3s
    spa                 // skip unless negative
    sub [2]
    add [1]
    sar 1s
    sad [0777777]       // skip unless -0
    cla
    xct i ieK
    lio ioIO
rtn, jmp .
ioIO, 0
    endloc

// AC at scale word w, for a bank that cannot xct ieShC.
// Entry: ieSize = x; IO = w. Exit: AC = the value. IO is preserved. Called via jda, or from another
// bank by dac i [ieSize:7] and jsp i [ieSize:7+1].
ieSize, 0
    local isRtnW, isS
    dac isRtnW
    dio isS
    lac isS
    jda ieShOf
    dac isS
    lac ieSize
    xct i isS
    jmp i isRtnW
isRtnW, 0
isS, 0
    endloc

// AC's magnitude, as the main bank's absVal, copied so the module calls nothing outside bank 7.
// Entry: AC. Exit: AC = its magnitude. IO is preserved. Called via jda, from this bank and from
// defdism.
ieAbs, 0
    dac iaRtnW
    lac ieAbs
    sma                 // skip if negative
    jmp iaRtn
    cma
iaRtn, jmp i iaRtnW
iaRtnW, 0

// Empty the instance list and every master slot. The list is emptied as Clear empties it
// (instClear), every master's length made 0 and its constraints none; no copy's attachers are
// listed (cpMrg) nor points designated for them (desPt, after it); every master's dwell is
// CYCLEMS and there is no sequence.
// Exit: AC = 0. IO is clobbered. Called via jsp.
instInit,
    local rtn, inMast, inCon, inMrg, inDw, inI, inN
    dap rtn
    jsp instClear
    lac [cyDw:7]
    dac inI
    law i NMASTER
    dac inN
inDw,
    lac [CYCLEMS]
    dac i inI
    idx inI
    isp inN             // skip once every dwell is set
    jmp inDw
    dzm cySqN
    lac [mLen:5]
    dac inI
inMast,
    dzm i inI
    idx inI
    sas [mLen:5+NMASTER] // skip once every length is 0
    jmp inMast
    lac [cpNCon:011]
    dac inI
    law i NMASTER
    dac inN
inCon,
    dzm i inI
    idx inI
    isp inN             // skip once every master's count is 0
    jmp inCon
    lac [cpMrg:3]
    dac inI
    law i 2 * NATT
    dac inN
inMrg,
    lac [NOPOINT]
    dac i inI
    idx inI
    isp inN             // skip once every word is NOPOINT
    jmp inMrg
    cla
rtn, jmp .
inI, 0
inN, 0
    endloc

// Empty the instance list. Each slot is written unused, its gate first, so none is lit and none
// cycles; the masters stay. The caller spreads the target calls again (respread).
// Exit: AC = 0. IO is clobbered. Called via jsp.
instClear,
    local rtn, icLoop, icI
    dap rtn
    dzm i [instCount:012]
    dzm i [cycN:4]
    lac [NOPOINT]
    dac litInst
    dzm icI
icLoop,
    lac icI
    jda instUnused
    idx icI
    sas [MAXINST]       // skip once every slot is written
    jmp icLoop
    cla
rtn, jmp .
icI, 0
    endloc

// The instance list emptied as instClear empties it, but every tie list kept. It runs after a
// load, whose tie lists the tape module has written, so that the main bank's tapeRebuild can
// write the slots again from the tables.
// Exit: AC = 0. IO is clobbered. Called via jsp.
instReslot,
    local rtn
    dap rtn
    law 1
    dac iuKeep
    jsp instClear
    dzm iuKeep
    cla
rtn, jmp .
iuKeep, 0               // set while instReslot keeps the tie lists
    endloc

// Write instance slot i unused. The gate goes first, jumping to instEnd, so the display calls no
// master from it from here on; then the parameter and point words, and the call stepping over.
// Its tie list is emptied, NOPOINT throughout, unless instReslot keeps it (iuKeep); its cycle
// flag is cleared either way.
// Entry: AC = i. AC and IO are clobbered. Called via jda.
instUnused, 0
    local rtn, iuTie, iuSlot, iuP, iuG
    dap rtn
    lac iuKeep
    sza                 // skip unless the tie lists are kept
    jmp iuSlot
    lac instUnused
    add [iTie:3]
    dac iuP
    law i NATT
    dac iuG
iuTie,
    lac [NOPOINT]
    dac i iuP
    lac iuP
    add [MAXINST]
    dac iuP
    isp iuG             // skip once every attacher's word is written
    jmp iuTie
iuSlot,
    lac instUnused
    add [iCyc:3]
    dac iuP
    dzm i iuP
    lac instUnused
    jda instSlot
    dac iuP
    add [INSTGATE]
    dac iuG
    lac [jump instEnd:0 next(parameter)]
    dac i iuG
    lac [scale(0) intensity(INSTINTENSITY) lpoff next(point)]
    dac i iuP
    idx iuP
    lac [y(0) next(point)]
    dac i iuP
    idx iuP
    lac [x(0) next(subroutine)]
    dac i iuP
    lac iuP
    add [INSTCALL-3]
    dac iuP
    lac [next(subroutine)]
    dac i iuP
    idx iuP
    add [1]
    ior [jump next(parameter)]
    dac i iuP
rtn, jmp .
iuP, 0
iuG, 0
    endloc

// Full address of instance slot i, in bank 0.
// Entry: AC = i. Exit: AC = the address. IO is preserved. Called via jda, from this bank and from
// defdism.
instSlot, 0
    dac isRtnW
    lac instSlot
    sal 1s
    add instSlot
    sal 1s              // i * 6, INSTWORDS
    add [instList:0]
isRtn, jmp i isRtnW
isRtnW, 0

// For Inst, add an instance of master masterArg at x1, the last in the instance list, its origin at
// the pseudo pen location held where its figure would leave the screen, and write its slot,
// which is unused, with the parameter and point words, then the gate, calling the master. The
// call words stay as writeCalls left them, and the caller's respread makes the slot a site. A
// tie point is added for each of the master's attachers, at its place (instTies), and listed in
// the instance's tie list; refused, as a full list is, when the point table cannot take them. A
// copy being placed (Copy's rows, the last item) has none. Refused too when its texts' copies
// would pass the texts' budget (the text module's txFits), and last when the master store has no
// room for the master's words (poolBring).
// Exit: AC = 0 added, 1 with the list full, no room for the tie points or the words, or past the
// budget. IO is clobbered. Called via jsp.
instAdd,
    local rtn, adGo, adPts, adTie, adFull, adP, adN, adT
    dap rtn
    lac i [instCount:012]
    sad [MAXINST]       // skip unless the list is full
    jmp adFull
    lac i [masterArg:4]
    dac i [txArg:012]
    lac [NOPOINT]
    dac i [txArg2:012]
    jsp i [txFits:012]
    sza                 // skip if its texts fit the budget
    jmp adFull
    dzm adN
    lac i [lastItem:4]
    sad [ICOPY]         // skip unless Copy's row, whose copy has no tie points
    jmp adGo
    lac i [masterArg:4]
    add [cpNAtt:5]
    dac adP
    lac i adP
    dac adN
    add i [pointCount:4]
    sub [MAXPTS+1]
    sma                 // skip if the tie points fit
    jmp adFull
adGo,
    lac i [masterArg:4]
    jda poolBring
    sza                 // skip if the master's words are in the store
    jmp adFull
    lac i [instCount:012]
    add [iMaster:012]
    dac adP
    lac i [masterArg:4]
    dac i adP
    lac i [instCount:012]
    add [iScale:3]
    dac adP
    dzm i adP
    lac i [instCount:012]
    jda instAt

    // The tie points, the list's words after them NOPOINT as the slot was left.
    lac i [instCount:012]
    add [iTie:3]
    dac adT
    lac adN
    sza i               // skip if the master has attachers
    jmp adTie
    cma
    dac adN
    law 1
    dac i [cTopo:010]   // the solver's ties change
adPts,
    lac i [pointCount:4]
    dac i adT
    idx i [pointCount:4]
    lac adT
    add [MAXINST]
    dac adT
    isp adN             // skip once every attacher has its point
    jmp adPts
    lac i [instCount:012]
    jda instTies
adTie,
    lac i [instCount:012]
    jda instParam
    lac i [instCount:012]
    jda instXY
    lac i [instCount:012]
    jda instGate
    idx i [instCount:012]
    cla
    jmp rtn
adFull,
    law 1
rtn, jmp .
adP, 0
adN, 0
adT, 0
    endloc

// Instance i's tie points put at their places. Attacher a's is at the origin plus its master
// point's offset at the instance's scale, iX + (cpAX[k, a] << iScale), likewise in y.
// Entry: AC = i. Exit: AC = how many it placed. IO is clobbered. Called via jda.
instTies, 0
    local rtn, itLoop, itNext, itA, itT, itP, itQ, itS, itK, itN, itC, itV, itOX, itOY
    dap rtn
    dzm itC
    lac instTies
    add [iX:3]
    dac itOX
    lac instTies
    add [iY:3]
    dac itOY
    lac instTies
    add [iScale:3]
    dac itT
    lac i itT
    jda ieShOf
    dac itS
    lac instTies
    add [iMaster:012]
    dac itT
    lac i itT
    dac itK
    sal 1s
    add itK
    sal 1s              // k * NATT, 6
    add [cpAX:5]
    dac itA
    lac instTies
    add [iTie:3]
    dac itT
    law i NATT
    dac itN
itLoop,
    lac i itT
    sad [NOPOINT]       // skip if attacher a has a tie point
    jmp itNext
    dac itP
    idx itC
    lac i itA           // the attacher's offset in x
    xct i itS
    add i itOX
    dac itV
    lac itP
    add [pointX:3]
    dac itQ
    lac itV
    dac i itQ
    lac itA
    add [NMASTER * NATT]
    dac itQ
    lac i itQ           // and in y, cpAY
    xct i itS
    add i itOY
    dac itV
    lac itP
    add [pointY:3]
    dac itQ
    lac itV
    dac i itQ
itNext,
    idx itA
    lac itT
    add [MAXINST]
    dac itT
    isp itN             // skip once every attacher is looked at
    jmp itLoop
    lac itC
rtn, jmp .
itA, 0
itT, 0
itP, 0
itQ, 0
itS, 0
itK, 0
itN, 0
itC, 0
itV, 0
itOX, 0
itOY, 0
    endloc

// Place mode. Move the last instance's origin to the pseudo pen location, held where its
// figure would leave the screen; only its point words are written, and its tie points follow
// it (instTies), nothing being on them yet.
// Exit: AC = 0. IO is clobbered. Called via jsp.
instPlace,
    local rtn, ipI
    dap rtn
    lac i [instCount:012]
    sza i               // skip if there is an instance
    jmp rtn
    sub [1]
    dac ipI
    jda instAt
    lac ipI
    jda instXY
    lac ipI
    jda instTies
    cla
rtn, jmp .
ipI, 0
    endloc

// Move's pick-up of an instance, carried by its tie point p, or at its origin, dragInst, when p
// is NOPOINT. The instances fastened to it through a tie point they share, and those fastened to
// them, are its group (gMem), carried with it
// rigidly; the points carried are the group's tie points and the start and end of each arc
// centered on one, marked in ptMark; the lines on them go into the main bank's dragLines, up
// to MAXDRAG, dragFull set beyond, as arcPick lists a dragged point's. A tie point's handle, the
// origin less the point, is kept (hdX, hdY), so the point stays under the pen; at the origin
// it is 0.
// Entry: AC = p or NOPOINT; dragInst when p is NOPOINT. Exit: AC = dragInst, set from p's
// instance; NOPOINT when p ties none, and nothing is picked up. IO is clobbered. Called via
// jda.
instPick, 0
    local rtn, pkFind, pkOwn, pkOrg, pkClr, pkGClr, pkWalk, pkInst, pkNextI, pkWalkEnd, \
        pkArcs, pkArcNx, pkLines, pkLnLp, pkMine, pkOver, pkLnNx, pkDone, pkT, pkU, pkI, \
        pkChg, pkN, pkFull
    dap rtn
    lac instPick
    sad [NOPOINT]       // skip if picked up by a tie point
    jmp pkOrg
    lac [iTie:3]
    dac pkT
pkFind,
    lac i pkT
    sad instPick        // skip unless it is p
    jmp pkOwn
    idx pkT
    sas [iTie:3+NATT*MAXINST] // skip once every tie is looked at
    jmp pkFind
    lac [NOPOINT]
    jmp rtn
pkOwn,
    lac pkT
    sub [iTie:3]
    lia                 // the instance, the remainder of the tie's place / MAXINST
    cla
    scl 1s
    div [MAXINST]
    cla                 // no skip is overflow, which a place in iTie cannot give
    lai
    dac i [dragInst:4]
    add [iX:3]
    dac pkT
    lac instPick
    add [pointX:3]
    dac pkU
    lac i pkT
    sub i pkU
    dac hdX
    lac i [dragInst:4]
    add [iY:3]
    dac pkT
    lac instPick
    add [pointY:3]
    dac pkU
    lac i pkT
    sub i pkU
    dac hdY
    jmp pkClr
pkOrg,
    dzm hdX
    dzm hdY

    // The group is the dragged instance, then any instance with a tie point marked, over again
    // until a pass adds none, each joining marking its tie points (grJoin).
pkClr,
    jsp markClear
    lac [gMem:012]
    dac pkT
    law i MAXINST
    dac pkN
pkGClr,
    dzm i pkT
    idx pkT
    isp pkN             // skip once every member's flag is clear
    jmp pkGClr
    lac i [dragInst:4]
    jda grJoin
pkWalk,
    dzm pkChg
    dzm pkI
pkInst,
    lac pkI
    sad i [instCount:012] // skip while instances remain
    jmp pkWalkEnd
    add [gMem:012]
    dac pkT
    lac i pkT
    sza                 // skip unless a member already
    jmp pkNextI
    lac pkI
    jda grTied
    sza i               // skip if one of its tie points is carried
    jmp pkNextI
    lac pkI
    jda grJoin
    law 1
    dac pkChg
pkNextI,
    idx pkI
    jmp pkInst
pkWalkEnd,
    lac pkChg
    sza                 // skip once a pass adds none
    jmp pkWalk

    // An arc's start and end, when its center is carried.
    dzm pkI
pkArcs,
    lac pkI
    sad i [arcCount:2]  // skip while arcs remain
    jmp pkLines
    add [arcTC:2]
    jda ptMarkOf
    sza i               // skip if its center is carried
    jmp pkArcNx
    lac pkI
    add [arcTS:2]
    dac pkT
    lac i pkT
    jda markOn
    lac pkI
    add [arcTE:2]
    dac pkT
    lac i pkT
    jda markOn
pkArcNx,
    idx pkI
    jmp pkArcs

    // The lines on them.
pkLines,
    dzm pkN
    dzm pkFull
    dzm pkI
pkLnLp,
    lac pkI
    sad i [lineCount:4] // skip while lines remain
    jmp pkDone
    add [lineFrom:3]
    jda ptMarkOf
    sza                 // skip unless the line starts at a point carried
    jmp pkMine
    lac pkI
    add [lineTo:3]
    jda ptMarkOf
    sza i               // skip if the line ends at a point carried
    jmp pkLnNx
pkMine,
    lac pkN
    sad [MAXDRAG]       // skip unless dragLines is full
    jmp pkOver
    add [dragLines:3]
    dac pkT
    lac pkI
    dac i pkT
    idx pkN
    jmp pkLnNx
pkOver,
    law 1
    dac pkFull
pkLnNx,
    idx pkI
    jmp pkLnLp
pkDone,
    lac pkN
    dac i [dragN:4]
    lac pkFull
    dac i [dragFull:4]
    lac i [dragInst:4]
rtn, jmp .
pkT, 0
pkU, 0
pkI, 0
pkChg, 0
pkN, 0
pkFull, 0
    endloc

// Every point's mark in ptMark cleared.
// AC is clobbered, IO preserved. Called via jsp, from this bank and from defdism.
markClear,
    local rtn, mcLoop, mcP, rtnW
    dac rtnW
    lac [ptMark:3]
    dac mcP
mcLoop,
    dzm i mcP
    idx mcP
    sas [ptMark:3+MAXPTS] // skip once every mark is clear
    jmp mcLoop
rtn, jmp i rtnW
rtnW, 0
mcP, 0
    endloc

// Point p marked in ptMark.
// Entry: AC = p. AC is clobbered, IO preserved. Called via jda, from this bank and from defdism.
markOn, 0
    dac moRtnW
    lac markOn
    add [ptMark:3]
    dac markOn
    law 1
    dac i markOn
moRtn, jmp i moRtnW
moRtnW, 0

// The mark of the point whose index is the word at full address a.
// Entry: AC = a. Exit: AC = the mark, 0 for none. IO is preserved. Called via jda.
ptMarkOf, 0
    dap pfRtn
    lac i ptMarkOf
    add [ptMark:3]
    dac ptMarkOf
    lac i ptMarkOf
pfRtn, jmp .

// Instance i joins the group, its flag in gMem set and its tie points marked.
// Entry: AC = i. AC and IO are clobbered. Called via jda.
grJoin, 0
    local rtn, gjLoop, gjT, gjN
    dap rtn
    lac grJoin
    add [gMem:012]
    dac gjT
    law 1
    dac i gjT
    lac grJoin
    add [iTie:3]
    dac gjT
    law i NATT
    dac gjN
gjLoop,
    lac i gjT
    sas [NOPOINT]       // skip if attacher a has no tie point
    jda markOn
    lac gjT
    add [MAXINST]
    dac gjT
    isp gjN             // skip once every attacher is looked at
    jmp gjLoop
rtn, jmp .
gjT, 0
gjN, 0
    endloc

// Whether a tie point of instance i is marked.
// Entry: AC = i. Exit: AC = 1 if one is, 0 if none. IO is clobbered. Called via jda.
grTied, 0
    local rtn, gtLoop, gtNext, gtYes, gtT, gtN
    dap rtn
    lac grTied
    add [iTie:3]
    dac gtT
    law i NATT
    dac gtN
gtLoop,
    lac i gtT
    sad [NOPOINT]       // skip if attacher a has a tie point
    jmp gtNext
    lac gtT
    jda ptMarkOf
    sza                 // skip unless it is marked
    jmp gtYes
gtNext,
    lac gtT
    add [MAXINST]
    dac gtT
    isp gtN             // skip once every attacher is looked at
    jmp gtLoop
    cla
    jmp rtn
gtYes,
    law 1
rtn, jmp .
gtT, 0
gtN, 0
    endloc

// Move's drag of the group instPick made. The step brings the dragged instance's tie point to
// the pseudo pen location, or its origin there (the handle, hdX and hdY), held on each axis so
// that every member's figure stays on the screen and every point carried on it; then each
// member's origin and slot, and each point carried, is moved by it. The step is kept (cvDX,
// cvDY) for instBack. The caller rewrites the lines and arcs carried.
// Exit: AC = 0 moved, 1 if the step held is nothing. IO is clobbered. Called via jsp.
instMove,
    local rtn, mvMem, mvMemNx, mvPts, mvPt, mvPtNx, mvGo, mvStep, mvI, mvT
    dap rtn
    lac i [dragInst:4]
    add [iX:3]
    dac mvT
    lac i [penX:4]
    add hdX
    sub i mvT
    dac cvDX
    lac i [dragInst:4]
    add [iY:3]
    dac mvT
    lac i [penY:4]
    add hdY
    sub i mvT
    dac cvDY

    // Each member's figure's box on the screen, and each point carried, held inside it.
    dzm mvI
mvMem,
    lac mvI
    sad i [instCount:012] // skip while instances remain
    jmp mvPts
    add [gMem:012]
    dac mvT
    lac i mvT
    sza i               // skip if a member
    jmp mvMemNx
    lac mvI
    jda instBox
    lac ibX0
    dac mhLo
    lac ibX1
    dac mhHi
    lac ibY0
    dac myLo
    lac ibY1
    dac myHi
    jsp mvHold
mvMemNx,
    idx mvI
    jmp mvMem
mvPts,
    dzm mvI
mvPt,
    lac mvI
    sad i [pointCount:4] // skip while points remain
    jmp mvGo
    add [ptMark:3]
    dac mvT
    lac i mvT
    sza i               // skip if carried
    jmp mvPtNx
    lac mvI
    add [pointX:3]
    dac mvT
    lac i mvT
    dac mhLo
    dac mhHi
    lac mvI
    add [pointY:3]
    dac mvT
    lac i mvT
    dac myLo
    dac myHi
    jsp mvHold
mvPtNx,
    idx mvI
    jmp mvPt
mvGo,
    lac cvDX
    ior cvDY
    sza                 // skip unless there is a step
    jmp mvStep
    law 1
    jmp rtn
mvStep,
    jsp cvApply
    cla
rtn, jmp .
mvI, 0
mvT, 0
    endloc

// The step (cvDX, cvDY) held so that x from mhLo to mhHi, and y from myLo to myHi, both moved by
// it, stay on the screen, 0 to 1023. Each was there before the step, so a step held to them all
// is held to each.
// Entry: mhLo, mhHi, myLo, myHi. AC and IO are clobbered. Called via jsp.
mvHold,
    local rtn
    dap rtn
    lac cvDX
    jda mhAxis
    dac cvDX
    lac myLo
    dac mhLo
    lac myHi
    dac mhHi
    lac cvDY
    jda mhAxis
    dac cvDY
rtn, jmp .
    endloc

// A step d held so that mhLo + d is at least 0 and mhHi + d at most 1023.
// Entry: AC = d; mhLo, mhHi. Exit: AC = d held. IO is preserved. Called via jda.
mhAxis, 0
    local rtn, maHi, maOk
    dap rtn
    lac mhLo
    add mhAxis
    sma                 // skip if below 0
    jmp maHi
    cla
    sub mhLo
    jmp rtn
maHi,
    lac [0d1023]
    sub mhHi
    sub mhAxis
    sma                 // skip if past 1023
    jmp maOk
    lac [0d1023]
    sub mhHi
    jmp rtn
maOk,
    lac mhAxis
rtn, jmp .
    endloc

// Move the group by the step (cvDX, cvDY), each member's origin and its slot's point words, and
// each point carried (ptMark).
// AC and IO are clobbered. Called via jsp.
cvApply,
    local rtn, cvMem, cvMemNx, cvPts, cvPt, cvPtNx, cvI, cvT
    dap rtn
    dzm cvI
cvMem,
    lac cvI
    sad i [instCount:012] // skip while instances remain
    jmp cvPts
    add [gMem:012]
    dac cvT
    lac i cvT
    sza i               // skip if a member
    jmp cvMemNx
    lac cvI
    add [iX:3]
    dac cvT
    lac i cvT
    add cvDX
    dac i cvT
    lac cvI
    add [iY:3]
    dac cvT
    lac i cvT
    add cvDY
    dac i cvT
    lac cvI
    jda instXY
cvMemNx,
    idx cvI
    jmp cvMem
cvPts,
    dzm cvI
cvPt,
    lac cvI
    sad i [pointCount:4] // skip while points remain
    jmp rtn
    add [ptMark:3]
    dac cvT
    lac i cvT
    sza i               // skip if carried
    jmp cvPtNx
    lac cvI
    add [pointX:3]
    dac cvT
    lac i cvT
    add cvDX
    dac i cvT
    lac cvI
    add [pointY:3]
    dac cvT
    lac i cvT
    add cvDY
    dac i cvT
cvPtNx,
    idx cvI
    jmp cvPt
rtn, jmp .
cvI, 0
cvT, 0
    endloc

// The last step taken back, when an arc carried could not follow it (the main bank's instDrag).
// Exit: AC = 0. IO is clobbered. Called via jsp.
instBack,
    local rtn
    dap rtn
    cla                 // negated so, not by cma, which makes -0 of a step of 0
    sub cvDX
    dac cvDX
    cla
    sub cvDY
    dac cvDY
    jsp cvApply
    cla
rtn, jmp .
    endloc

// After the solver's publish or its revert (the main bank's conShow), each instance whose origin
// is the solver's (FIN) has its slot's point words written from its origin.
// Exit: AC = 0. IO is clobbered. Called via jsp.
instSync,
    local rtn, syLoop, syNext, syDone, syI, syT
    dap rtn
    dzm syI
syLoop,
    lac syI
    sad i [instCount:012] // skip while instances remain
    jmp syDone
    add [MAXPTS]
    add [cFlag:011]
    dac syT
    lac i syT
    and [FIN]
    sza i               // skip if the solver's
    jmp syNext
    lac syI
    jda instXY
syNext,
    idx syI
    jmp syLoop
syDone,
    cla
rtn, jmp .
syI, 0
syT, 0
    endloc

// Instance i's origin at the pseudo pen location (penX, penY), held on each axis where its
// figure, its master's box at its scale, would leave the screen (instClamp). The copy being
// placed (copyInst) is held instead where its parts' box, its figure's and its points', arc
// centers included, would leave the canvas, where the target can reach and every point lies,
// so its parts are points like any other once it is taken apart; and a copy whose master has
// attachers is carried by its last designated, at the pseudo pen location rather than its
// origin (iaCarry).
// Entry: AC = i. Exit: its iX and iY. AC and IO are clobbered. Called via jda.
instAt, 0
    local rtn, iaX, iaY, iaP, iaM, iaV
    dap rtn
    lac instAt
    add [iMaster:012]
    dac iaP
    lac i iaP
    dac iaM
    lac instAt
    add [iScale:3]
    dac iaP
    lac i iaP
    dac icS
    dzm icMin
    lac [0d1023]
    dac icMax
    dzm iaOX
    dzm iaOY
    lac instAt
    sas i [copyInst:4]        // skip if it is the copy being placed
    jmp iaX
    lac iaM
    jda iaCarry
    lac iaM
    add [CBOXOFF]
    dac iaM
    lac [TRKXMIN]
    dac icMin
    lac [TRKXMAX]
    dac icMax
iaX,
    lac iaM
    add [mMinX:5]
    dac iaP
    lac i iaP
    dac icLo
    lac iaM
    add [mMaxX:5]
    dac iaP
    lac i iaP
    dac icHi
    lac i [penX:4]
    sub iaOX
    jda instClamp
    dac iaV
    lac instAt
    add [iX:3]
    dac iaP
    lac iaV
    dac i iaP
    lac instAt
    sas i [copyInst:4]        // skip if it is the copy being placed
    jmp iaY
    lac [TRKYMIN]
    dac icMin
    lac [TRKYMAX]
    dac icMax
iaY,
    lac iaM
    add [mMinY:5]
    dac iaP
    lac i iaP
    dac icLo
    lac iaM
    add [mMaxY:5]
    dac iaP
    lac i iaP
    dac icHi
    lac i [penY:4]
    sub iaOY
    jda instClamp
    dac iaV
    lac instAt
    add [iY:3]
    dac iaP
    lac iaV
    dac i iaP
rtn, jmp .
iaP, 0
iaM, 0
iaV, 0
    endloc

// A copy of master k carried by its last designated attacher, if it has any. That attacher's
// master point goes in the main bank's copyAtt, and its offset from the origin in iaOX, iaOY (a
// copy is at x1); otherwise copyAtt is NOPOINT and the offsets are left 0.
// Entry: AC = k. AC and IO are clobbered. Called via jda.
iaCarry, 0
    local rtn, icrP, icrJ
    dap rtn
    lac [NOPOINT]
    dac i [copyAtt:4]
    lac iaCarry
    add [cpNAtt:5]
    dac icrP
    lac i icrP
    sza i               // skip if the master has attachers
    jmp rtn
    sub [1]
    dac icrJ
    lac iaCarry
    sal 1s
    add iaCarry
    sal 1s              // k * NATT, 6
    add icrJ
    dac icrJ            // its word in the attachers' tables
    add [cpAtt:5]
    dac icrP
    lac i icrP
    dac i [copyAtt:4]
    lac icrJ
    add [cpAX:5]
    dac icrP
    lac i icrP
    dac iaOX
    lac icrJ
    add [cpAY:5]
    dac icrP
    lac i icrP
    dac iaOY
rtn, jmp .
icrP, 0
icrJ, 0
    endloc

// A coordinate of an instance's origin, held where its figure would leave the screen. It is at
// least min - lo and at most max - hi, lo and hi its master's box on the axis relative to the
// origin at its scale word s, min and max the screen's edges, or the canvas's for a copy.
// Entry: AC = the coordinate; icLo, icHi, icS, icMin, icMax. Exit: AC = it held; icLo and icHi
// shifted. IO is preserved. Called via jda.
instClamp, 0
    local rtn, icHigh, icOk, icN, icA
    dap rtn
    lac icS
    jda ieShOf
    dac icN
    lac icLo
    xct i icN
    dac icLo
    lac icHi
    xct i icN
    dac icHi
    lac icMin
    sub icLo
    dac icA             // the lowest origin
    lac instClamp
    sub icA
    sma                 // skip if below it
    jmp icHigh
    lac icA
    jmp rtn
icHigh,
    lac icMax
    sub icHi
    dac icA             // the highest origin
    sub instClamp
    sma                 // skip if the coordinate is above it
    jmp icOk
    lac icA
    jmp rtn
icOk,
    lac instClamp
rtn, jmp .
icN, 0
icA, 0
    endloc

// Write instance i's origin into its slot's point words (ixWord) at x1; magnified, the whole
// slot through the view (instView).
// Entry: AC = i. AC and IO are clobbered. Called via jda, from this bank and from defdism.
instXY, 0
    local rtn, ixX1, rtnW
    dac rtnW
    lac i [vwS:014]
    sza i               // skip unless at x1
    jmp ixX1
    lac instXY
    jda instView
    jmp rtn
ixX1,
    lac instXY
    jda ixWord
rtn, jmp i rtnW
rtnW, 0
    endloc

// Write instance i's parameter word (ipWord) at x1; magnified, the whole slot through the view
// (instView).
// Entry: AC = i. AC and IO are clobbered. Called via jda, from this bank and from defdism.
instParam, 0
    local rtn, ipX1, rtnW
    dac rtnW
    lac i [vwS:014]
    sza i               // skip unless at x1
    jmp ipX1
    lac instParam
    jda instView
    jmp rtn
ipX1,
    lac instParam
    jda ipWord
rtn, jmp i rtnW
rtnW, 0
    endloc

// Write instance i's gate (igWord) at x1; magnified, the whole slot through the view
// (instView).
// Entry: AC = i. AC and IO are clobbered. Called via jda, from this bank and from defdism.
instGate, 0
    local rtn, igX1, rtnW
    dac rtnW
    lac i [vwS:014]
    sza i               // skip unless at x1
    jmp igX1
    lac instGate
    jda instView
    jmp rtn
igX1,
    lac instGate
    jda igWord
rtn, jmp i rtnW
rtnW, 0
    endloc

// Instance i's origin into its slot's point words, y then x. Each is a whole word, and the
// origin is held on each axis separately, so a frame drawn between the two writes still keeps
// the figure on the screen.
// Entry: AC = i. AC and IO are clobbered. Called via jda.
ixWord, 0
    local rtn, ixA, ixP
    dap rtn
    lac ixWord
    jda instSlot
    add [1]
    dac ixA
    lac ixWord
    add [iY:3]
    dac ixP
    lac i ixP
    ior [y(0) next(point)]
    dac i ixA
    idx ixA
    lac ixWord
    add [iX:3]
    dac ixP
    lac i ixP
    ior [x(0) next(subroutine)]
    dac i ixA
rtn, jmp .
ixA, 0
ixP, 0
    endloc

// Instance i's parameter word, its scale plus ipAdd, at LITINTENSITY while it is the one lit,
// at INSTINTENSITY otherwise.
// Entry: AC = i. AC and IO are clobbered. Called via jda.
ipWord, 0
    local rtn, ipDim, ipHave, ipA, ipW
    dap rtn
    lac ipWord
    add [iScale:3]
    dac ipA
    lac i ipA
    and [IKMASK]
    add ipAdd
    sal 4s
    dac ipW
    lac ipWord
    sas litInst         // skip if it is the one lit
    jmp ipDim
    lac [scale(0) intensity(LITINTENSITY) lpoff next(point)]
    jmp ipHave
ipDim,
    lac [scale(0) intensity(INSTINTENSITY) lpoff next(point)]
ipHave,
    ior ipW
    dac ipW
    lac ipWord
    jda instSlot
    dac ipA
    lac ipW
    dac i ipA
rtn, jmp .
ipA, 0
ipW, 0
    endloc

// Instance i's gate, calling its master or, with a c, its variant with save, at its place in the
// store; stepping over its call with no variant to be had, the store full at a load.
// Entry: AC = i. AC and IO are clobbered. Called via jda.
igWord, 0
    local rtn, igShow, igA
    dap rtn
    lac igWord
    jda instSlot
    add [INSTGATE]
    dac igA
    lac igWord
    dac i [vaOf:011]
    jsp i [vaOf:011+1]
    sas [MNOPOOL]       // skip with no words to call
    jmp igShow
    lac igA
    add [1]
    ior [jump next(parameter)]
    dac i igA
    jmp rtn
igShow,
    jda msAddr
    ior [save next(vector)]
    dac i igA
rtn, jmp .
igA, 0
    endloc

// Instance i's gate stepping over its call, so that no frame draws its figure while its words
// change.
// Entry: AC = i. AC and IO are clobbered. Called via jda.
igShut, 0
    local rtn, isG
    dap rtn
    lac igShut
    jda instSlot
    add [INSTGATE]
    dac isG
    add [1]
    ior [jump next(parameter)]
    dac i isG
rtn, jmp .
isG, 0
    endloc

// The master store's word at offset o, as a full address: masters + o in region 0, below
// MPOOL0, and mpool1 + o - MPOOL0 in region 1 (sketchpad.ah, the masters' comment).
// Entry: AC = o. Exit: AC = the address. IO is preserved. Called via jda, from this bank and
// from defdism.
msAddr, 0
    dac maRtnW
    lac msAddr
    sub [MPOOL0]
    spa                 // skip if in region 1
    jmp maR0
    add [mpool1:1]
    jmp i maRtnW
maR0,
    add [masters:0 + MPOOL0]
    jmp i maRtnW
maRtnW, 0

// Master k's words brought into the master store, unless they are there already or it has none
// (sketchpad.ah, the masters' comment): its record made resident (mrLoad) and its mLen words
// copied from the record's mrWords to the free run that fits them best, the shortest that holds
// them, so that a long master later finds a long run (pbFit). No master in the store moves,
// since the display may be drawing any of them. With no run to hold them, the masters nothing
// calls leave the store (pbDrop), their words left where they lie, and the runs are found again.
// Entry: AC = k. Exit: AC = 0, or 1 when the store has no room for the words. IO is clobbered.
// Called via jda.
poolBring, 0
    local rtn, pbPut, pbCopy, pbOk, pbFull, pbK, pbO, pbP, pbA, pbB, pbC
    dap rtn
    lac poolBring
    dac pbK
    add [mStart:5]
    dac pbP
    lac i pbP
    sas [MNOPOOL]       // skip unless in the store
    jmp pbOk
    lac pbK
    add [mLen:5]
    dac pbA
    lac i pbA
    sza i               // skip if the master has words
    jmp pbOk
    dac pbN
    jsp pbFit
    sma                 // skip unless a run holds them
    jmp pbPut
    jsp pbDrop
    jsp pbFit
    spa                 // skip if a run holds them
    jmp pbFull
pbPut,
    dac pbO
    lac pbK
    jda mrLoad
    lac pbO
    jda msAddr
    dac pbB
    lac [mrWords:5]
    dac pbA
    lac pbN
    cma
    dac pbC
pbCopy,
    lac i pbA
    dac i pbB
    idx pbA
    idx pbB
    isp pbC             // skip once every word is copied
    jmp pbCopy
    lac pbO
    dac i pbP
pbOk,
    cla
    jmp rtn
pbFull,
    law 1
rtn, jmp .

// Master k's words put back at its place in the store (mStart), copied from its record as
// poolBring copies them, for the propagation's refusal (rwRun's RQPUT), which has put back
// every master's place.
// Entry: AC = k. Exit: AC = 0. IO is clobbered. Called via jda.
poolAt, 0
    dap rtn
    lac poolAt
    dac pbK
    add [mLen:5]
    dac pbA
    lac i pbA
    dac pbN
    lac pbK
    add [mStart:5]
    dac pbP
    lac i pbP
    jmp pbPut
pbK, 0
pbO, 0
pbP, 0
pbA, 0
pbB, 0
pbC, 0
    endloc

// The free run of the master store that holds pbN words best, the shortest that does. A run
// starts at a region's first offset or at the end of a master or a variant in the store (pbIn,
// entries from NMASTER on the variants), and reaches the next one's offset in its region or the
// region's end.
// Exit: AC = the run's first offset, or -1 with none. IO is clobbered. Called via jsp.
pbFit,
    local rtn, pfTry, pfBase, pfR1, pfEnd, pfNext, pfJ, pfInner, pfNoJ, pfLen, pfI, pfC, pfE, \
        pfS, pfBest, pfBL, pfJn
    dap rtn
    law i 1
    dac pfBest
    lac [0377777]
    dac pfBL
    dzm pfI
pfTry,
    lac pfI
    sub [NMASTER + NVARIANT]
    sma                 // skip if a master's or a variant's end
    jmp pfBase
    lac pfI
    jda pbIn
    sad [MNOPOOL]       // skip if in the store
    jmp pfNext
    dac pfC
    lac pfI
    jda pbLen
    add pfC
    jmp pfEnd
pfBase,
    sza i               // skip unless region 0's first offset
    jmp pfEnd
    lac [MPOOL0]
pfEnd,
    dac pfC
    sub [MPOOL0]
    sma                 // skip if in region 0
    jmp pfR1
    lac [MPOOL0]
    jmp pfJ
pfR1,
    lac [MPOOL0 + MPOOL1]
pfJ,
    dac pfE
    dzm pfJn
pfInner,
    lac pfJn
    jda pbIn
    sad [MNOPOOL]       // skip if in the store
    jmp pfNoJ
    dac pfS
    sub pfC
    spa                 // skip unless before the run's start
    jmp pfNoJ
    lac pfS
    sub pfE
    sma                 // skip if before the run's end so far
    jmp pfNoJ
    lac pfS
    dac pfE
pfNoJ,
    idx pfJn
    sas [NMASTER + NVARIANT] // skip once every master and variant is looked at
    jmp pfInner
    lac pfE
    sub pfC
    dac pfLen
    sub pbN
    spa                 // skip if the run holds the words
    jmp pfNext
    lac pfLen
    sub pfBL
    sma                 // skip if shorter than the best so far
    jmp pfNext
    lac pfLen
    dac pfBL
    lac pfC
    dac pfBest
pfNext,
    idx pfI
    sas [NMASTER + NVARIANT + 2] // skip once every start is tried
    jmp pfTry
    lac pfBest
rtn, jmp .
pfLen, 0
pfI, 0
pfC, 0
pfE, 0
pfS, 0
pfBest, 0
pfBL, 0
pfJn, 0
    endloc

// The variants no instance has (vaSweep) and the masters in the master store that nothing calls
// taken out of it (mStart MNOPOOL). A master is called while an instance's master at no code c,
// a variant being made from the record; while an instance cycles or pbSeq brings a sequence
// (every master), and while Undo would put back the instance a dismember took apart, its master;
// and it stays while subBring brings the masters beside it (pbKeep).
// AC and IO are clobbered. Called via jsp.
pbDrop,
    local rtn, pdLoop, pdInst, pdIns, pdOther, pdOut, pdNext, pdJ, pdI, pdP
    dap rtn
    jsp i [vaSweep:011]
    dzm pdJ
pdLoop,
    lac pdJ
    jda pbIn
    sad [MNOPOOL]       // skip if in the store
    jmp pdNext
    lac pdJ
    jda masterBit
    and pbKeep
    sza                 // skip unless subBring keeps it
    jmp pdNext
    lac i [cycN:4]
    ior pbAll
    sza                 // skip unless every master is called
    jmp pdNext
    lac i [undoKind:4]
    sas [UDISM]         // skip if Undo would put back a dismember's instance
    jmp pdInst
    lac dismMaster
    sad pdJ             // skip unless its master
    jmp pdNext
pdInst,
    dzm pdI
pdIns,
    lac pdI
    sad i [instCount:012] // skip while instances remain
    jmp pdOut
    add [iMaster:012]
    dac pdP
    lac i pdP
    sas pdJ             // skip if the instance's master
    jmp pdOther
    lac pdI
    add [iScale:3]
    dac pdP
    lac i pdP
    sub [IKMASK + 1]
    spa                 // skip if it has a code c
    jmp pdNext
pdOther,
    idx pdI
    jmp pdIns
pdOut,
    lac pdJ
    add [mStart:5]
    dac pdP
    lac [MNOPOOL]
    dac i pdP
pdNext,
    idx pdJ
    sas [NMASTER]       // skip once every master is looked at
    jmp pdLoop
rtn, jmp .
pdJ, 0
pdI, 0
pdP, 0
    endloc

// Entry j's offset in the master store, master j's or, from NMASTER on, variant j - NMASTER's, or
// MNOPOOL when it has no words or is not there.
// Entry: AC = j. Exit: AC = the offset or MNOPOOL. IO is preserved. Called via jda.
pbIn, 0
    dap piRtn
    lac pbIn
    sub [NMASTER]
    spa                 // skip if a variant
    jmp piMast
    dac i [vaIn:011]
    jsp i [vaIn:011+1]
    lac i [vaInO:011]
    jmp piRtn
piMast,
    lac pbIn
    add [mLen:5]
    dac piP
    lac i piP
    sza i               // skip if the master has words
    jmp piNo
    lac pbIn
    add [mStart:5]
    dac piP
    lac i piP
    jmp piRtn
piNo,
    lac [MNOPOOL]
piRtn, jmp .
piP, 0

// Entry j's length, as pbIn's entries.
// Entry: AC = j. Exit: AC = its words. IO is preserved. Called via jda.
pbLen, 0
    dap lnRtn
    lac pbLen
    sub [NMASTER]
    spa                 // skip if a variant
    jmp lnMast
    dac i [vaIn:011]
    jsp i [vaIn:011+1]
    lac i [vaInL:011]
    jmp lnRtn
lnMast,
    lac pbLen
    add [mLen:5]
    dac piP
    lac i piP
lnRtn, jmp .

// Master k's words at scale word w in the master store: a c's variant, built from its record
// (vaBring), or the master itself (poolBring).
// Entry: AC = k; IO = w. Exit: AC = 0, or 1 when the store has no room. IO is clobbered. Called via
// jda, or from another bank by dac i [poolFor:7] and jsp i [poolFor:7+1].
poolFor, 0
    local rtn, pwCode, pwW, rtnW
    dac rtnW
    dio pwW
    lac pwW
    sar 2s
    sza                 // skip unless a code c
    jmp pwCode
    lac poolFor
    jda poolBring
    jmp rtn
pwCode,
    dac i [vaCode:011]
    lac poolFor
    dac i [vaK:011]
    jsp i [vaBring:011]
rtn, jmp i rtnW
rtnW, 0
pwW, 0
    endloc

// The masters of a sequence brought into the master store (poolBring), every master called
// meanwhile (pbAll) so that none brought is taken out for the next; with no sequence, every
// master defined.
// Entry: AC = the entries, 0 for none; pbSqA = the first entry's address. Exit: AC = 0, or 1
// when the store has no room for them all. IO is clobbered. Called via jda.
pbSeq, 0
    local rtn, psLoop, psAll, psAllL, psOk, psEnd, psN, psK
    dap rtn
    law 1
    dac pbAll
    lac pbSeq
    sza i               // skip if a sequence
    jmp psAll
    cma
    dac psN
psLoop,
    lac i pbSqA
    jda poolBring
    sza                 // skip if brought
    jmp psEnd
    idx pbSqA
    isp psN             // skip once every entry is brought
    jmp psLoop
    jmp psOk
psAll,
    dzm psK
psAllL,
    lac psK
    jda poolBring
    sza                 // skip if brought
    jmp psEnd
    idx psK
    sas [NMASTER]       // skip once every master is brought
    jmp psAllL
psOk,
    cla
psEnd,
    dzm pbAll
rtn, jmp .
psN, 0
psK, 0
    endloc

// Room in the master store for pbN words, as poolBring finds it, the masters nothing calls
// leaving the store if need be (pbDrop), for a load of a master others hold (the library's
// libEntry), which copies the entry's words there itself.
// Entry: pbN. Exit: AC = the run's first offset, or -1 with none. IO is clobbered. Called via
// jsp i [poolRoom:7].
poolRoom,
    dac prRtnW
    jsp pbFit
    sma                 // skip unless a run holds them
    jmp i prRtnW
    jsp pbDrop
    jsp pbFit
    jmp i prRtnW
prRtnW, 0

// poolBring's word count; pbSeq's entry address, and its flag that every master is called.
pbN, 0
pbSqA, 0
pbAll, 0

// The masters subBring (bank 12) is bringing, a bit each as in mUses, which pbDrop keeps; 0
// otherwise.
pbKeep, 0

// Instance i's slot through the magnified view. It is shown when its figure, its master's box at
// its scale, lies wholly on the screen and its scale plus the view's is x8 or less (the view
// module's vwBox); hidden otherwise, and marked so in iHid, which the lock and the texts' list
// read. Shown, it gets the parameter word at its scale plus the view's, the origin's words
// through the view, then the gate calling the master. Hidden, it gets the gate first, a jump to
// the word after it in place of the master's save, so the master is not called, then the
// parameter word at its scale and the origin's words masked to the screen, harmless in point
// mode. A move or the solver changes the origin
// at one scale, Size the scale at one origin, and the callers that change both close the gate
// first (instRemove, a dismember's Undo, instViewAll), so no frame draws the figure off the
// screen.
// Entry: AC = i. AC and IO are clobbered. Called via jda.
instView, 0
    local rtn, ivShow, ivXY, ivP, ivA, ivH
    dap rtn
    lac instView
    jda instBox         // its box on the page and its scale
    lac ibX0
    dac i [vbX0:014]
    lac ibX1
    dac i [vbX1:014]
    lac ibY0
    dac i [vbY0:014]
    lac ibY1
    dac i [vbY1:014]
    lac ibS
    dac i [vbS:014]
    lac instView
    add [iX:3]
    dac ivP
    lac i ivP
    dac i [vbOX:014]
    lac instView
    add [iY:3]
    dac ivP
    lac i ivP
    dac i [vbOY:014]
    jsp i [vwBox:014]
    dac ivH
    lac instView
    add [iHid:3]
    dac ivP
    lac ivH
    dac i ivP
    lac instView
    jda instSlot
    dac ivA
    lac ivH
    sza i               // skip if hidden
    jmp ivShow
    lac ivA
    add [INSTGATE]
    dac ivP
    add [1]
    ior [jump next(parameter)]
    dac i ivP
    lac instView
    jda ipWord          // its scale, which the field holds
    jmp ivXY
ivShow,
    lac i [vwS:014]
    dac ipAdd
    lac instView
    jda ipWord
    dzm ipAdd
ivXY,
    idx ivA
    lac i [vbOY:014]
    ior [y(0) next(point)]
    dac i ivA
    idx ivA
    lac i [vbOX:014]
    ior [x(0) next(subroutine)]
    dac i ivA
    lac ivH
    sza                 // skip if shown
    jmp rtn
    lac instView
    jda igWord
rtn, jmp .
ivP, 0
ivA, 0
ivH, 0
    endloc

// Every instance through a new view, for the view module's vwEntry (IEVIEW). Each slot's gate is
// closed first, since a new scale in its parameter word with its old origin
// could carry the figure off the screen, then its words written again, at x1 or through the
// view. instEntry asks for the texts' list again (txDirty), their places moving with the view.
// AC and IO are clobbered. Called via jsp.
instViewAll,
    local rtn, avLoop, avI, avG
    dap rtn
    dzm avI
avLoop,
    lac avI
    sad i [instCount:012] // skip while instances remain
    jmp rtn
    jda instSlot
    add [INSTGATE]
    dac avG
    add [1]
    ior [jump next(parameter)]
    dac i avG
    lac avI
    jda instParam
    lac avI
    jda instXY
    lac avI
    jda instGate
    idx avI
    jmp avLoop
rtn, jmp .
avI, 0
avG, 0
    endloc

// Light instance i, dimming the one lit before; NOPOINT dims it and lights none. Only their
// parameter words are written. TXINST, a text, is the text module's to light (txShine), and dims
// the instance lit.
// Entry: AC = i. AC and IO are clobbered. Called via jda.
instShine, 0
    local rtn, shOld
    dap rtn
    lac instShine
    dac i [txArg:012]
    jsp i [txShine:012]
    dac instShine
    sad litInst         // skip unless it is lit already
    jmp rtn
    lac litInst
    dac shOld
    lac instShine
    dac litInst
    lac shOld
    sas [NOPOINT]       // skip if none was lit
    jda instParam
    lac litInst
    sas [NOPOINT]       // skip if none is to be lit
    jda instParam
rtn, jmp .
shOld, 0
    endloc

// The instance whose figure's box, at its scale, holds the target's center (hitX, hitY), the
// nearest origin winning between them on the larger axis distance; Horv and the constraint mode
// pass over instances, the constraint mode for a number's type taking digits alone. It wins
// over the point, line or arc locked already only when its origin, by that distance, is nearer
// than lockD, that one's distance as placeLock weighs them. So an instance's middle takes it,
// and what is drawn beside its box's edge wins there. The winner is lit and any other dimmed
// (instShine). An instance the view hides (iHid) is passed over.
// A text is weighed against the instance by the text module's txLock, by its box's
// center as an instance by its origin, and wins as TXINST; Text and Number modes pass over
// instances, and a text Move carries always wins. The text module keeps which text (txPen).
// Entry: lockD. Exit: AC = penInst = the instance, TXINST for a text, NOPOINT when none; with
// one, penIdx and lockLine NOPOINT, and penX, penY, lockX and lockY the target's center. IO is
// clobbered. Called via jsp.
instLock,
    local rtn, ilLoop, ilCmp, ilNext, ilDone, ilAgainst, ilCarry, ilWin, ilLose, ilSet, ilI, \
        ilBest, ilBO, ilO, ilT, ilP, ilCons, ilIn
    dap rtn
    lac [NOPOINT]
    dac ilBest
    lac [0377777]
    dac ilBO
    lac i [mode:4]
    sad [MHORV]         // skip unless Horv mode
    jmp ilSet
    sad [MCONS]         // skip unless the constraint mode
    jmp ilCons
    sad [MTEXT]         // skip unless Text mode, which locks onto texts only
    jmp ilDone
    sad [MNUMBER]       // skip unless Number mode, which locks onto digits only
    jmp ilDone
    dzm ilI
ilLoop,
    lac ilI
    sad i [instCount:012] // skip while instances remain
    jmp ilDone
    lac i [vwS:014]
    sza i               // skip unless at x1, where none is hidden
    jmp ilIn
    lac ilI
    add [iHid:3]
    dac ilP
    lac i ilP
    sza                 // skip unless hidden by the view, passed over
    jmp ilNext

    // Inside the box on both axes.
ilIn,
    lac ilI
    jda instBox
    lac i [hitX:4]
    sub ibX0
    spa                 // skip unless left of the box
    jmp ilNext
    lac ibX1
    sub i [hitX:4]
    spa                 // skip unless right of the box
    jmp ilNext
    lac i [hitY:4]
    sub ibY0
    spa                 // skip unless below the box
    jmp ilNext
    lac ibY1
    sub i [hitY:4]
    spa                 // skip unless above the box
    jmp ilNext

    // The origin's distance, the larger axis's, nearer than the best so far.
    lac ilI
    add [iX:3]
    dac ilP
    lac i [hitX:4]
    sub i ilP
    jda ieAbs
    dac ilO
    lac ilI
    add [iY:3]
    dac ilP
    lac i [hitY:4]
    sub i ilP
    jda ieAbs
    dac ilT
    sub ilO
    spa                 // skip unless the y distance is the smaller
    jmp ilCmp
    lac ilT
    dac ilO
ilCmp,
    lac ilO
    sub ilBO
    sma                 // skip if nearer than the best so far
    jmp ilNext
    lac ilO
    dac ilBO
    lac ilI
    dac ilBest
ilNext,
    idx ilI
    jmp ilLoop

    // Against the texts, then what is locked already.
ilDone,
    lac ilBO
    dac i [txLockD:012]
    jsp i [txLock:012]
    sad [TXCARRY]       // skip unless Move carries a text
    jmp ilCarry
    sas [TXINST]        // skip if a text is nearer than the instance
    jmp ilAgainst
    dac ilBest
    lac i [txLockD:012]
    dac ilBO
ilAgainst,
    lac ilBest
    sad [NOPOINT]       // skip if an instance or a text holds the target's center
    jmp ilSet
    lac ilBO
    sub i [lockD:4]
    sma                 // skip if its origin is nearer than what is locked
    jmp ilLose
ilWin,
    lac [NOPOINT]
    dac i [penIdx:4]
    dac i [lockLine:4]
    lac i [hitX:4]
    dac i [penX:4]
    dac i [lockX:4]
    lac i [hitY:4]
    dac i [penY:4]
    dac i [lockY:4]
    jmp ilSet
ilCarry,
    lac [TXINST]
    dac ilBest
    jmp ilWin

    // The constraint mode locks onto lines as Horv does, but for a number's type onto digits
    // alone, as Number mode does (consLock calls only then).
ilCons,
    lac i [consType:4]
    and [CTNUM]
    sza i               // skip if a number's type
    jmp ilSet
    jmp ilDone
ilLose,
    lac [NOPOINT]
    dac ilBest
ilSet,
    lac ilBest
    dac i [penInst:4]
    jda instShine
    lac ilBest
rtn, jmp .
ilI, 0
ilBest, 0
ilBO, 0
ilO, 0
ilT, 0
ilP, 0
    endloc

// Instance i's figure's box on the screen, its master's box about the origin, at the
// instance's scale, from its origin. No code c is told from the word in line, since instLock runs
// this for every instance on every pass.
// Entry: AC = i. Exit: ibX0, ibX1, ibY0, ibY1, ibS its k. AC and IO are clobbered. Called via jda.
instBox, 0
    local rtn, ibP, ibM, ibO, ibCode, ibHave
    dap rtn
    lac instBox
    add [iScale:3]
    dac ibP
    lac i ibP
    dac ibS
    sub [IKMASK + 1]
    sma                 // skip if no code c
    jmp ibCode
    lac ibS
    add [ieShTab:7]
    dac ibSh
ibHave,
    lac instBox
    add [iMaster:012]
    dac ibP
    lac i ibP
    dac ibM
    lac instBox
    add [iX:3]
    dac ibP
    lac i ibP
    dac ibO
    lac ibM
    add [mMinX:5]
    jda ibVal
    add ibO
    dac ibX0
    lac ibM
    add [mMaxX:5]
    jda ibVal
    add ibO
    dac ibX1
    lac instBox
    add [iY:3]
    dac ibP
    lac i ibP
    dac ibO
    lac ibM
    add [mMinY:5]
    jda ibVal
    add ibO
    dac ibY0
    lac ibM
    add [mMaxY:5]
    jda ibVal
    add ibO
    dac ibY1
rtn, jmp .
ibCode,
    lac ibS
    jda ieShOf
    dac ibSh
    lac ibS
    and [IKMASK]
    dac ibS
    jmp ibHave
ibP, 0
ibM, 0
ibO, 0
    endloc

// A word of the master directory at the scale ibS, by the word for it to xct, whose full address
// is ibSh (ieShTab's entry, or ieShOf's answer).
// Entry: AC = its full address; ibSh. Exit: AC = the value. IO is preserved. Called via jda, from
// this bank and from defdism.
ibVal, 0
    dac ivRtnW
    lac i ibVal
    xct i ibSh
ivRtn, jmp i ivRtnW
ivRtnW, 0

// For Size, set the instance the pseudo pen location locks onto, penInst, to the scale sizeArg,
// refused where its figure would then leave the screen about its origin, since the edge
// violation would end the frame there, and with a code c on either word where the store cannot
// hold the words its new size draws, which are brought first, while the old stay called. Only its
// parameter word is written, or with such a c its gate too, shut meanwhile; and its tie points go
// to their places at the new scale (instTies); with any, they are marked in ptMark for the main
// bank's arcCarry of the arcs on them, which may yet take the change back (instSzBack), the
// whole drawing list is rewritten, for the lines on them, and the solver takes up the change,
// the instances fastened to it following.
// A text, penInst TXINST, is the text module's to size (txSize), set or refused.
// Exit: AC = 0 set, 1 refused, 2 with no instance locked, 3 set with its tie points moved. IO is
// clobbered. Called via jsp.
instSize,
    local rtn, szPlain, szTies, szOut, szNone, szText, szI, szP, szOld
    dap rtn
    lac i [penInst:4]
    sad [NOPOINT]       // skip if an instance locks
    jmp szNone
    sad [TXINST]        // skip unless a text
    jmp szText
    dac szI
    add [iScale:3]
    dac szP
    lac i szP
    dac szOld
    lac i [sizeArg:4]
    dac i szP
    lac szI
    jda instBox
    lac ibX0
    spa                 // skip unless off the left edge
    jmp szOut
    lac ibY0
    spa                 // skip unless off the bottom
    jmp szOut
    lac [0d1023]
    sub ibX1
    spa                 // skip unless off the right edge
    jmp szOut
    lac [0d1023]
    sub ibY1
    spa                 // skip unless off the top
    jmp szOut
    lac szOld
    ior i szP
    sub [IKMASK + 1]
    spa                 // skip if a code c on either word
    jmp szPlain
    lac i szP
    dac szC
    lac szOld
    dac i szP           // pbDrop sees it at the old size while the new is brought
    lac szI
    add [iMaster:012]
    dac szM
    lio szC
    lac i szM
    jda poolFor
    sza                 // skip if the new words are in the store
    jmp szOut
    lac szC
    dac i szP
    lac szI
    jda igShut
    lac szI
    jda instParam
    lac szI
    jda instGate
    jmp szTies
szPlain,
    lac szI
    jda instParam
szTies,
    lio szOld
    lac szI
    jda szMark
    lac szI
    jda instTies
    sza i               // skip if it has tie points
    jmp rtn
    lac szI
    dac sbI
    lac szOld
    dac sbOld
    dzm sbChg
    jsp markClear
    lac szI
    jda grJoin          // its tie points marked; gMem is set afresh at every pick
    law 1
    dac i [dirty:4]
    dac i [cTopo:010]
    dac i [conWake:4]
    law 3
    jmp rtn
szOut,
    lac szOld
    dac i szP
    law 1
    jmp rtn
szNone,
    law 2
    jmp rtn
szText,
    jsp i [txSize:012]
rtn, jmp .
szI, 0
szP, 0
szOld, 0
szC, 0
szM, 0
    endloc

// Size or a change taken back, when an arc on a tie point it moved could not follow (the main
// bank's sizeLost and changeLost). After a Size, the instance's scale before it is put back (sbI,
// sbOld, which instSize keeps), and its tie points at their places at that scale; after a change
// that moved tie points (sbChg), its master before (instTo, which keeps them), the origin and the
// tie points going back with it. Nothing of the arcs was written.
// Exit: AC = 1, refused. IO is clobbered. Called via jsp.
instSzBack,
    local rtn, sbTo, sbP
    dap rtn
    lac sbChg
    sza                 // skip unless a change moved the tie points
    jmp sbTo
    lac sbI
    jda igShut
    lac sbI
    add [iScale:3]
    dac sbP
    lac sbOld
    dac i sbP
    lac sbI
    jda instParam
    lac sbI
    jda instTies
    lac sbI
    jda instGate
    law 1
    jmp rtn
sbTo,
    lac sbOld
    dac toK
    law 1
    dac toMv
    lac sbI
    jda instTo
    law 1
rtn, jmp .
sbP, 0
    endloc

// The instance Size or a change last set with tie points moved, and its scale or master before,
// for instSzBack; sbChg is set for a change.
sbI, 0
sbOld, 0
sbChg, 0

// Change mode's lift (the main bank's changeLost). The instance the pseudo pen location locks
// onto, penInst, is given master sizeArg (instTo), its tie points moved if the master's
// attachers lie elsewhere; or, for the Cycle row (sizeArg CYCLEROW), started cycling, or a
// cycling one stopped where it stands. The first to start sets the steps' clock and the cycle's
// position from its master (cyFrom), so its first step comes its master's dwell later. A change
// or a start that would pass the texts' budget is refused (the text module's txFits, a cycle
// costed at its largest master), and so is one the master store has no room for: the master's
// words, or a start's sequence's masters' (poolBring, pbSeq).
// Exit: AC = 0 done, 1 refused, 2 with no instance locked, 3 done with its tie points moved. IO
// is clobbered. Called via jsp.
instChange,
    local rtn, chCyc, chOne, chStop, chRef, chNone, chI, chP
    dap rtn
    lac i [penInst:4]
    sad [NOPOINT]       // skip if an instance locks
    jmp chNone
    dac chI
    dac i [txArg2:012]
    lac i [sizeArg:4]
    sad [CYCLEARG]      // skip unless the Cycle row
    jmp chCyc
    dac i [txArg:012]
    jsp i [txFits:012]
    sza                 // skip if its texts fit the budget
    jmp rtn
    lac chI
    add [iScale:3]
    dac chP
    lio i chP
    lac i [sizeArg:4]
    jda poolFor
    sza                 // skip if the master's words at its size are in the store
    jmp rtn
    lac i [sizeArg:4]
    dac toK
    law 1
    dac toMv
    lac chI
    jda instTo
    dac chP
    lio [NOPOINT]
    lac chI
    jda szMark
    lac chP
    jmp rtn
chCyc,
    lac chI
    add [iCyc:3]
    dac chP
    lac i chP
    sza                 // skip unless it cycles
    jmp chStop
    lac chI
    add [iScale:3]
    dac chP
    lac i chP
    sub [IKMASK + 1]
    sma                 // skip unless a code c, which stays on the powers of two to cycle
    jmp chRef
    lac chI
    add [iCyc:3]
    dac chP
    lac [NMASTER]
    dac i [txArg:012]
    jsp i [txFits:012]
    sza                 // skip if its texts fit the budget
    jmp rtn
    lac [cySq:7]
    dac pbSqA
    lac cySqN
    jda pbSeq
    sza                 // skip if the sequence's masters are in the store
    jmp rtn
    law 1
    dac i chP
    lac i [cycN:4]
    sza                 // skip if none cycles yet
    jmp chOne
    lac i [now:4]
    dac cycAt
    lac chI
    jda cyFrom
chOne,
    idx i [cycN:4]
    cla
    jmp rtn
chStop,
    dzm i chP
    lac i [cycN:4]
    sub [1]
    dac i [cycN:4]
    cla
    jmp rtn
chRef,
    law 1
    jmp rtn
chNone,
    law 2
rtn, jmp .
chI, 0
chP, 0
    endloc

// An instance's size or master changed, for the constraints on size (szRun): it is the source, and
// its word before what a refusal puts back.
// Entry: AC = i, IO = the word before, NOPOINT for none. AC is clobbered, IO preserved. Called via
// jda.
szMark, 0
    local rtn
    dap rtn
    lac szMark
    add [1]
    dac i [szDirty:3]
    dio i [szPrev:3]
rtn, jmp .
    endloc

// The cycle's position as instance i starts it, none cycling before. It is the first entry of the
// sequence that is i's master, or, with none, the last entry, so that the first step takes the
// first; with no sequence, the master itself. The step lasts the master's dwell.
// Entry: AC = i. AC and IO are clobbered. Called via jda, from this bank and from defdism.
cyFrom, 0
    local rtn, cfLoop, cfK, cfP, rtnW
    dac rtnW
    lac cyFrom
    add [iMaster:012]
    dac cfP
    lac i cfP
    dac cfK
    dac cyPos
    add [cyDw:7]
    dac cfP
    lac i cfP
    dac cyDur
    lac cySqN
    sza i               // skip if a sequence is typed
    jmp rtn
    dzm cyPos
cfLoop,
    lac cyPos
    add [cySq:7]
    dac cfP
    lac i cfP
    sad cfK             // skip unless the master's entry
    jmp rtn
    idx cyPos
    sas cySqN           // skip once every entry is looked at
    jmp cfLoop
    law i 1
    add cySqN
    dac cyPos
rtn, jmp i rtnW
rtnW, 0
cfK, 0
cfP, 0
    endloc

// The cycles' step, from the main loop while an instance cycles. Once the step's dwell (cyDur)
// has passed on the clock, the position moves to the next entry of the sequence, or the next
// master with none, that some cycling instance can take, and each cycling instance takes that
// master (instTo) or stays as it is; the step lasts that master's dwell. So every cycling instance
// steps together. A step never moves a tie point; a master whose attachers lie elsewhere is
// refused. It goes on while an instance is carried, a carried one's
// handle following its origin (instTo). The texts' list is written again only at a step
// (txDirty), not on every pass that waits for one.
// Exit: AC is clobbered. IO is clobbered. Called via jsp.
instCycle,
    local rtn, cyDue, cyAdv, cyAt, cyImp, cyGot, cyLoop, cyNext, cyEnd, cyLen, cyI, cyP, cyK, \
        cyD, cyN, cyTk
    dap rtn
    lac i [now:4]
    sub cycAt
    sma                 // skip if the clock wrapped since the last step
    jmp cyDue
    add [CLOCKWRAP]
cyDue,
    sub cyDur
    spa                 // skip once the step's dwell has passed
    jmp rtn
    law 1
    dac i [txDirty:012]
    lac i [now:4]
    dac cycAt
    dzm toMv
    lac cySqN
    sza i               // skip if a sequence is typed
    law NMASTER
    dac cyN             // the entries
    cma
    dac cyD
cyAdv,
    idx cyPos
    sub cyN
    spa                 // skip once past the last entry
    jmp cyAt
    dzm cyPos
cyAt,
    lac cySqN
    sza i               // skip if a sequence is typed
    jmp cyImp
    lac cyPos
    add [cySq:7]
    dac cyP
    lac i cyP
    jmp cyGot
cyImp,
    lac cyPos
cyGot,
    dac cyK
    dzm cyTk
    dzm cyI
cyLoop,
    lac cyI
    sad i [instCount:012] // skip while instances remain
    jmp cyEnd
    add [iCyc:3]
    dac cyP
    lac i cyP
    sza i               // skip if it cycles
    jmp cyNext
    lac cyK
    dac toK
    lac cyI
    jda instTo
    sza                 // skip if it takes the master
    jmp cyNext
    law 1
    dac cyTk
cyNext,
    idx cyI
    jmp cyLoop
cyEnd,
    lac cyTk
    sza                 // skip if none took it
    jmp cyLen
    isp cyD             // skip once every entry is tried
    jmp cyAdv
cyLen,
    lac cyK
    add [cyDw:7]
    dac cyP
    lac i cyP
    dac cyDur
rtn, jmp .
cyI, 0
cyP, 0
cyK, 0
cyD, 0
cyN, 0
cyTk, 0
    endloc

// Instance i given master toK (Change, a cycle's step). Refused when master toK is empty, when
// its attachers differ from the instance's master's in number, or in place unless toMv allows it
// (attMatch), or when its figure would leave the screen at the instance's scale about the new
// origin. With attachers the origin moves by the old master's first attacher less the new's, at
// the instance's scale, so the new first attacher falls on the first tie point. Where every
// attacher matches, no tie point moves; the solver takes the origin up (cRld), and Undo's
// snapshot of it moves the same way, so that an Undo of a constraint after it puts the instance
// back with its ties. Where they lie elsewhere (toMv, Change > Mk alone), the other tie points go
// to the new attachers' places (instTies) and are marked in ptMark for the main bank's arcCarry,
// which may yet take the change back (instSzBack, from sbI, sbOld and sbChg), the whole drawing
// list is rewritten, and the solver settles the figure, as after a Size. With none the box's
// center stays. The slot is written as instRemove writes one. Its gate steps over the call while
// the origin's words change, then calls the new master; with no move, the gate alone. A carried
// instance's handle moves with its origin, so its attachers stay under the pen. The instance's
// current master changes nothing.
// Entry: AC = i; toK, toMv. Exit: AC = 0 given, 1 refused, 3 given with its tie points moved. IO
// is clobbered. Called via jda.
instTo, 0
    local rtn, toOut, toNo, toMove, toFit, toSlot, toTies, toDone, toP, toOld, toDX, toDY, \
        toOX, toOY, toS, toG, toAt
    dap rtn
    lac instTo
    add [iMaster:012]
    dac toP
    lac i toP
    dac toOld
    sad toK             // skip unless toK is its master
    jmp toDone
    lac toK
    add [mLen:5]
    dac toG
    lac i toG
    sza i               // skip unless master toK is empty
    jmp toNo
    lac toOld
    jda attMatch
    dac toAt
    sza i               // skip unless the attachers match
    jmp toMove
    sad [1]             // skip unless they differ in number
    jmp toNo
    lac toMv
    sza i               // skip if the tie points may move
    jmp toNo

    // The move, amX and amY at x1, at the instance's scale; then the new master tried at the new
    // origin, the old put back if its figure would leave the screen.
toMove,
    lac instTo
    add [iScale:3]
    dac toG
    lac i toG
    jda ieShOf
    dac toS
    lac amX
    xct i toS
    dac toDX
    lac amY
    xct i toS
    dac toDY
    lac instTo
    add [iX:3]
    dac toOX
    lac instTo
    add [iY:3]
    dac toOY
    lac toK
    dac i toP
    lac i toOX
    add toDX
    dac i toOX
    lac i toOY
    add toDY
    dac i toOY
    lac instTo
    jda instBox
    lac ibX0
    spa                 // skip unless off the left edge
    jmp toOut
    lac ibY0
    spa                 // skip unless off the bottom
    jmp toOut
    lac [0d1023]
    sub ibX1
    spa                 // skip unless off the right edge
    jmp toOut
    lac [0d1023]
    sub ibY1
    sma                 // skip if off the top
    jmp toFit
toOut,
    lac toOld
    dac i toP
    lac i toOX
    sub toDX
    dac i toOX
    lac i toOY
    sub toDY
    dac i toOY
toNo,
    law 1
    jmp rtn
toFit,
    lac toDX
    ior toDY
    sza                 // skip unless the origin moves
    jmp toSlot
    lac instTo
    jda instGate
    jmp toTies
toSlot,
    lac instTo
    jda instSlot
    add [INSTGATE]
    dac toG
    add [1]
    ior [jump next(parameter)]
    dac i toG
    lac instTo
    jda instXY
    lac instTo
    jda instGate
    lac instTo
    add [MAXPTS]
    add [uSX:011]
    dac toG
    lac i toG
    add toDX
    dac i toG
    lac toG
    add [NVAR]          // uSY, after uSX
    dac toG
    lac i toG
    add toDY
    dac i toG
    law 1
    dac i [cRld:010]
    dac i [conWake:4]
    lac instTo
    sas i [dragInst:4]  // skip if it is carried
    jmp toTies
    lac hdX
    add toDX
    dac hdX
    lac hdY
    add toDY
    dac hdY
toTies,
    lac toAt
    sza i               // skip if the attachers lie elsewhere
    jmp toDone
    lac instTo
    jda instTies
    lac instTo
    dac sbI
    lac toOld
    dac sbOld
    law 1
    dac sbChg
    jsp markClear
    lac instTo
    jda grJoin          // its tie points marked
    law 1
    dac i [dirty:4]
    dac i [cTopo:010]
    dac i [conWake:4]
    law 3
    jmp rtn
toDone,
    cla
rtn, jmp .
toP, 0
toOld, 0
toDX, 0
toDY, 0
toOX, 0
toOY, 0
toS, 0
toG, 0
toAt, 0
    endloc

// Whether master toK's attachers match master k's. They match with as many, each at the same
// place relative to the first, so that a change from k to toK leaves every tie point where it
// is; or as many, at other places, so that it moves them. With any, amX and amY are k's first
// less toK's, at x1, the instance's origin's move.
// Entry: AC = k; toK. Exit: AC = 0 matching, 1 not as many (or some against none), 2 as many
// elsewhere; amX, amY. IO is clobbered. Called via jda.
attMatch, 0
    local rtn, amLoop, amYes, amNo, amOff, amN, amA, amWX, amWY, amT
    dap rtn
    dzm amX
    dzm amY
    lac attMatch
    add [cpNAtt:5]
    dac amT
    lac i amT
    dac amN
    lac toK
    add [cpNAtt:5]
    dac amT
    lac i amT
    sas amN             // skip if as many
    jmp amNo
    sza i               // skip if any
    jmp rtn
    cli
    lac attMatch
    jda attAt
    lac atX
    dac amWX
    lac atY
    dac amWY
    cli
    lac toK
    jda attAt
    lac amWX
    sub atX
    dac amX
    lac amWY
    sub atY
    dac amY
    law 1
    dac amA
amLoop,
    lac amA
    sad amN             // skip while attachers remain
    jmp amYes
    lio amA
    lac attMatch
    jda attAt
    lac atX
    sub amX
    dac amWX            // where toK's must be
    lac atY
    sub amY
    dac amWY
    lio amA
    lac toK
    jda attAt
    lac atX
    sas amWX            // skip if x matches
    jmp amOff
    lac atY
    sas amWY            // skip if y matches
    jmp amOff
    idx amA
    jmp amLoop
amYes,
    cla
    jmp rtn
amOff,
    law 2
    jmp rtn
amNo,
    law 1
rtn, jmp .
amN, 0
amA, 0
amWX, 0
amWY, 0
amT, 0
    endloc

// Master k's attacher a, its master point's offset from the master's origin, at x1, in atX and
// atY, from the root's cpAX and cpAY.
// Entry: AC = k, IO = a. Exit: atX, atY. AC is clobbered, IO preserved. Called via jda.
attAt, 0
    local rtn, atP, atJ
    dap rtn
    dio atP
    lac attAt
    sal 1s
    add attAt
    sal 1s              // k * NATT, 6
    add atP
    dac atJ
    add [cpAX:5]
    dac atP
    lac i atP
    dac atX
    lac atJ
    add [cpAY:5]
    dac atP
    lac i atP
    dac atY
rtn, jmp .
atP, 0
atJ, 0
    endloc

// Picture's Define, Inst and Copy rows and Change's Master, Dwell and Seq rows (the main bank's
// actKb), and Library's Save and Load rows (the library's libStep, splib.ac). Seq's row gives
// the number keyboard's block, its buffer the sequence typed (cySeqOut); every other row the
// masters' picker's block for the row, its lines written for the row (mpkLines). A picker's
// resume is the row's action, or for Dwell, Define and Name the main bank's ckDone, where a
// master picked gives the number keyboard for its dwell, or the text keyboard for its name
// (instKbDone), or for Library's rows the main bank's tapeResume. cyKbS says which closes at
// ckDone: 0 Dwell's keyboard, 1 Seq's, 2 Dwell's picker, 3 Define's picker, 5 Name's picker,
// 6 Name's keyboard.
// Entry: AC = the row's item. Exit: AC = the block's 16-bit address. IO is clobbered. Called via
// jda.
instKbOpen, 0
    local rtn, xoPick, xoDw, xoIn, xoCp, xoCh, xoLs, xoLl, xoNm
    dap rtn
    lac instKbOpen
    sas [ISEQ]          // skip if Seq's row
    jmp xoPick
    law 1
    dac cyKbS
    jsp cySeqOut
    lac [cySqBlk:6]
    jmp rtn
xoPick,
    law 2
    dac cyKbS
    lac instKbOpen
    jda mpkLines
    lac instKbOpen
    sad [IINST]         // skip unless Inst's row
    jmp xoIn
    sad [ICOPY]         // skip unless Copy's row
    jmp xoCp
    sad [ICHANGE]       // skip unless Change's Master row
    jmp xoCh
    sad [IDWELL]        // skip unless Dwell's row
    jmp xoDw
    sad [ILBSAVE]       // skip unless Library's Save row
    jmp xoLs
    sad [ILBLOAD]       // skip unless Library's Load row
    jmp xoLl
    sad [INAME]         // skip unless Name's row
    jmp xoNm
    law 3               // Define's row
    dac cyKbS
    lac [mpkDfBlk:013]
    jmp rtn
xoNm,
    law 5               // Name's picker, Define's block, which resumes at ckDone too
    dac cyKbS
    lac [mpkDfBlk:013]
    jmp rtn
xoLs,
    lac [mpkLsBlk:013]
    jmp rtn
xoLl,
    lac [mpkLlBlk:013]
    jmp rtn
xoDw,
    lac [mpkDwBlk:013]
    jmp rtn
xoIn,
    lac [mpkInBlk:013]
    jmp rtn
xoCp,
    lac [mpkCpBlk:013]
    jmp rtn
xoCh,
    lac [mpkChBlk:013]
rtn, jmp .
    endloc

// The masters' picker closed, on the resume of the row that opened it, the main bank's
// actDefine, actInst, actCopy or actChange: with a master picked (the keyboard's kbPick), it
// becomes the main bank's masterArg and the action goes on at the word after the next; on
// Cancel, it returns to the next word, where the action returns. It returns across banks.
// Entry: IO = 1 for a pick, 0 for Cancel. Exit: AC = the master picked. Called via
// jsp i [pkTake:7], from the main bank.
pkTake,
    dac pkRtnW
    lai
    sza i               // skip if a master was picked
    jmp i pkRtnW
    idx pkRtnW
    lac i [kbPick:6]
    dac i [masterArg:4]
    jmp i pkRtnW
pkRtnW, 0

// The masters' picker's lines (bank 5, mpkL) written for the row, item: each line lit
// (KBKEY), or dim with the pen off (KBDIM), so that a tap on it does nothing, for a master the
// row cannot take: for Library's Load row one the drawing calls (mCalled), defined or not, since
// the entry replaces it; for the others one not defined, unless the row is Define's; and each
// line's name's run "empty" while its master is not defined. A defined master's run is its
// name, which every writer of a master writes with it (Define's instDef, the library's lbLoad,
// the tape's tpLdEnd), so it is left as it is.
// Entry: AC = the row's item. AC and IO are clobbered. Called via jda.
mpkLines, 0
    local rtn, mlLoop, mlLib, mlDim, mlPut, mlCopy, mlNext, mlK, mlL, mlP, mlT, mlW, mlN
    dap rtn
    dzm mlK
    lac [mpkL:5]
    dac mlL
mlLoop,
    lac [KBKEY]
    dac mlW
    dzm mlT             // no run to write
    lac mlK
    add [mLen:5]
    dac mlP
    lac i mlP
    sza                 // skip unless the master is defined
    jmp mlLib
    lac [mpkEmpty:7]
    dac mlT
    lac mpkLines
    sad [IDEFINE]       // skip unless Define's row, which takes it
    jmp mlPut
    sas [ILBLOAD]       // skip if Library's Load row, which takes it unless called
    jmp mlDim
mlLib,
    lac mpkLines
    sas [ILBLOAD]       // skip if Library's Load row
    jmp mlPut
    lac mlK
    dac i [mCalled:5]
    jsp i [mCalled:5+1]
    sza i               // skip if the drawing calls the master
    jmp mlPut
    jmp mlDim
mlDim,
    lac [KBDIM]
    dac mlW
mlPut,
    lac mlW
    dac i mlL
    lac mlT
    sza i               // skip if the line's run is to be written
    jmp mlNext
    lac mlL
    add [MPKTAG]
    dac mlP
    law i NAMEW
    dac mlN
mlCopy,
    lac i mlT
    dac i mlP
    idx mlT
    idx mlP
    isp mlN             // skip once the run's words are written
    jmp mlCopy
mlNext,
    lac mlL
    add [MPKWORDS]
    dac mlL
    idx mlK
    sas [NMASTER]       // skip once every line is written
    jmp mlLoop
rtn, jmp .
mlK, 0
mlL, 0
mlP, 0
mlT, 0
mlW, 0
mlN, 0
    endloc

// Master m's bit in mUses, M1's bit 17.
// Entry: AC = m. Exit: AC = the bit. IO is preserved. Called via jda, from this bank and from
// defdism.
masterBit, 0
    dac mbRtnW
    lac masterBit
    sza i               // skip unless M1
    jmp mbOne
    cma
    dac mbC
    law 1
    dac mbB
mbLp,
    lac mbB             // the bit kept apart: isp leaves the count in AC
    ral 1s
    dac mbB
    isp mbC             // skip once shifted m places
    jmp mbLp
    lac mbB
    jmp i mbRtnW
mbOne,
    law 1
    jmp i mbRtnW
mbRtnW, 0
mbC, 0
mbB, 0

// Master k's nesting words for a master read with none, from a flat library entry (lbLoad): no
// sub-instances and none called (mNSub, mUses 0), every word its own (mOwnLen = mLen), and the
// count before its attachers' crosses (mDrawLen) worked out from its attachers in the root
// (mDrawOf).
// Entry: AC = k. AC is clobbered, IO preserved. Called via jda, from the library.
mFlat, 0
    local mfT, mfN, rtnW
    dac rtnW
    lac mFlat
    add [mNSub:5]
    dac mfT
    dzm i mfT
    lac mFlat
    add [mUses:5]
    dac mfT
    dzm i mfT
    lac mFlat
    add [mLen:5]
    dac mfT
    lac i mfT
    dac mfN
    lac mFlat
    add [mOwnLen:5]
    dac mfT
    lac mfN
    dac i mfT
    lac mFlat
    add [cpNAtt:5]
    dac mfT
    lac i mfT
    dac mfNA
    lac mFlat
    sal 1s
    add mFlat
    sal 1s              // k * NATT, 6
    add [cpAX:5]
    dac mfPX
    add [NMASTER * NATT] // cpAY's word, NMASTER * NATT on
    dac mfPY
    lac mfN
    jda mDrawOf
    dac mfN
    lac mFlat
    add [mDrawLen:5]
    dac mfT
    lac mfN
    dac i mfT
    jmp i rtnW
rtnW, 0
mfT, 0
mfN, 0
    endloc

// The count before a master's attachers' crosses, of its words, as defWalk made the crosses
// (instMap's visits): each a move to MARKARM left of its attacher, a line to MARKARM right, a
// move to MARKARM below and a line to MARKARM above, the last three a word each, 2 * MARKARM
// being within MSTEP; and before each cross after the first, the move from the end of the one
// before, defMove's fewest vectors of at most MSTEP. The first cross's move, from wherever the
// lines left the beam, stays counted among the drawing's words, a beam-off run at their end,
// which the composer drops. For mFlat, from the root's attachers, and for the library's
// libEntry, from an entry's.
// Entry: AC = the words; mfNA the attachers; mfPX and mfPY the 16-bit addresses of the first's
// offset from the origin, at x1, x and y, in cpAtt's order, the next's a word on. Exit: AC = the
// count. IO is preserved; mfPX and mfPY are moved on. Called via jda, and from bank 11.
mDrawOf, 0
    local mfAtt, mfK, mfKeep, mfEnd, mfC, mfN, mfX, mfY, mfU, mfV, mfF, mfM, mfT, rtnW
    dac rtnW
    lac mDrawOf
    dac mfN
    lac mfNA
    sza i               // skip if it has attachers
    jmp mfEnd
    cma
    dac mfC
    dzm mfF             // nonzero after the first cross
mfAtt,
    lac mfN
    sub [3]
    dac mfN
    lac i mfPX
    dac mfU             // the attacher's place
    lac i mfPY
    dac mfV
    lac mfF
    sza i               // skip unless the first cross
    jmp mfKeep

    // The move from the cross before, (mfX, mfY + MARKARM), to (mfU - MARKARM, mfV): M, the
    // larger magnitude, and a word for each MSTEP of it or part.
    lac mfU
    sub mfX
    sub [MARKARM]
    jda ieAbs
    dac mfM
    lac mfV
    sub mfY
    sub [MARKARM]
    jda ieAbs
    dac mfT
    sub mfM
    spa                 // skip if |dy| is the larger or equal
    jmp mfK
    lac mfT
    dac mfM
mfK,
    lac mfM
    sub [1]
    spa                 // skip while some of the move is left
    jmp mfKeep
    sub [MSTEP-1]
    dac mfM
    lac mfN
    sub [1]
    dac mfN
    jmp mfK
mfKeep,
    law 1
    dac mfF
    lac mfU
    dac mfX
    lac mfV
    dac mfY
    idx mfPX
    idx mfPY
    isp mfC             // skip once every attacher's cross is counted
    jmp mfAtt
mfEnd,
    lac mfN
    jmp i rtnW
rtnW, 0
mfC, 0
mfN, 0                  // the words, less the crosses' as they are counted
mfX, 0                  // the attacher before's place
mfY, 0
mfU, 0
mfV, 0
mfF, 0
mfM, 0
mfT, 0
    endloc

