// AC and IO are clobbered. Called via jsp.
cbEnd,
    local rtn, ceLoop
    dap rtn
ceLoop,
    law KCEND
    jda cbEmit
    lac cbN
    sza                 // skip once the word is written
    jmp ceLoop
rtn, jmp .
    endloc

