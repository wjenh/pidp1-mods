    dac xdV
    lac cyKbM
    add [cyDw:7]
    dac xdP
    lac xdV
    dac i xdP
    jmp xdNo
xdKb,
    dzm cyKbS
    lac i [kbPick:6]
    jda cyDwKb
    jmp rtn
xdDf,
    dzm cyKbS
    lac i [kbPick:6]
    jda dfNmOpen
    jmp rtn
xdNm,
