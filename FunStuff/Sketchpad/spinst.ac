// Exit: AC = the code. IO is preserved. Called via jsp.
cbGet,
    local rtn, cgWord, cgNext
    dap rtn
cgWord,
    lac cbN
    sza                 // skip if the word is used up
    jmp cgNext
    lac i cbP
    dac cbW
    idx cbP
    law 3
    dac cbN
cgNext,
    law i 1
    add cbN
    dac cbN
    lac cbW
    ral 6s
    dac cbW
    and [077]
    sad [KCUP]          // skip unless an upper shift
    jmp cgWord
    sad [KCLOW]         // skip unless a lower shift
    jmp cgWord
