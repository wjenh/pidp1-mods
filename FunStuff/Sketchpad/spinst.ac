    lac cbW
    ral 6s
    ior cbEmit
    dac cbW
    idx cbN
    sas [3]             // skip once the word holds three codes
    jmp cbeRtn
    lac cbW
    dac i cbP
    idx cbP
    dzm cbW
    dzm cbN
cbeRtn, jmp .

