    jda cbEmit
    dzm cyFrac
pnClose,
    jsp cbEnd
rtn, jmp .
pnV, 0
pnD, 0
pnT, 0
pnL, 0
    endloc
cyTens,
    0d1000
    0d100
    0d10
    1

// The keyboard's buffer, cyBuf, read or written a code at a time, three to a word as the
// keyboard keeps its text (spkbd.ac). cbStart starts at its first word, then cbGet, which passes
// over the shifts a digit never needs, or cbEmit and at the end cbEnd. The module keeps a copy
// of these, since it calls nothing outside bank 7.
// AC is clobbered, IO preserved. Called via jsp.
cbStart,
    dap cbsRtn
    lac [cyBuf:7]
    dac cbP
    dzm cbW
    dzm cbN
cbsRtn, jmp .

