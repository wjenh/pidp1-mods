    jmp dqPt

    // The lines, their ends mapped.
dqLines,
    dzm dqJ
    dzm dqI
dqLn,
    lac dqI
    sad i [lineCount:4] // skip while lines remain
    jmp dqArcs
    add [lineFrom:3]
    jda dqMap
    lac dqJ
    add dqI
    add [cpFrom:5]
    dac dqT
    lac dqV
    dac i dqT
    lac dqI
    add [lineTo:3]
    jda dqMap
    lac dqJ
    add dqI
    add [cpTo:5]
    dac dqT
    lac dqV
    dac i dqT
    idx dqI
    jmp dqLn

    // Each arc's words in arcTC to arcTK, which lie MAXARCS apart, to cpC to cpK, which lie
    // CPARCS apart, the first three, the center, start and end, mapped.
dqArcs,
    lac [arcTC:2]
    dac dqA
    lac [cpC:5]
    dac dqB
    law i CPATAB
    dac dqU
dqTab,
    dzm dqI
dqArc,
    lac dqI
    sad i [arcCount:2]  // skip while arcs remain
    jmp dqTabNx
    add dqA
    dac dqT
    lac dqU
    add [CPATAB-3]
    sma                 // skip if the table holds point indices
    jmp dqArcW0
    lac dqT
    jda dqMap
    jmp dqArcW
dqArcW0,
    lac i dqT
    dac dqV
dqArcW,
    lac dqI
    add dqB
    dac dqT
    lac dqV
    dac i dqT
    idx dqI
    jmp dqArc
dqTabNx,
    lac dqA
    add [MAXARCS]
    dac dqA
    lac dqB
    add [CPARCS]
    dac dqB
    isp dqU             // skip once every table is kept
    jmp dqTab

    // The counts, the copy box, the attachers.
    lac dqK
    add [cpNP:5]
    dac dqT
    lac i [mpN:7]
    dac i dqT
    lac dqK
    add [cpNL:5]
    dac dqT
    lac i [lineCount:4]
    dac i dqT
    lac dqK
    add [cpNA:5]
    dac dqT
    lac i [arcCount:2]
    dac i dqT
    lac dqK
    add [cMinX:5]
    dac dqT
    lac dqX0
    sub i [dfCX:2]
    dac i dqT
    lac dqK
    add [cMaxX:5]
    dac dqT
    lac dqX1
    sub i [dfCX:2]
    dac i dqT
    lac dqK
    add [cMinY:5]
    dac dqT
    lac dqY0
    sub i [dfCY:2]
    dac i dqT
    lac dqK
    add [cMaxY:5]
    dac dqT
    lac dqY1
    sub i [dfCY:2]
    dac i dqT
    lac dqK
    add [cpNAtt:5]
    dac dqT
    lac i [attN:7]
    dac i dqT
    lac dqK
    sal 1s
    add dqK
    sal 1s              // k * NATT, 6
    add [cpAtt:5]
    dac dqT
    lac [attJ:7]
    dac dqU
    lac i [attN:7]
    add [1]
    cma
    dac dqI             // -(attN + 1), so the first isp leaves -attN
dqAtt,
    isp dqI             // skip once every attacher is kept
    jmp dqAttW
    jmp dqSub0
dqAttW,
    lac i dqU
    dac i dqT
    add [cpX:5]         // its point's offset, kept in the root beside it
    dac dqA
    lac dqT
    add [NMASTER * NATT]
    dac dqB
    lac i dqA
    dac i dqB           // cpAX
    lac dqA
    add [CPPTS]
    dac dqA
    lac dqB
    add [NMASTER * NATT]
    dac dqB
    lac i dqA
    dac i dqB           // cpAY
    idx dqU
    idx dqT
    jmp dqAtt

    // The sub-instances, from Define's blocks (instMap): each one's master, its origin from the
    // master's origin, its scale and its ties, already master indices; their count in mNSub, and
    // their masters' bits in mUses.
dqSub0,
    lac dqK
    add [mNSub:5]
    dac dqT
    lac i [sbN:2]
    dac i dqT
    lac dqK
    add [mUses:5]
    dac dqT
    dzm i dqT
    lac i [sbN:2]
    sza i               // skip if there are sub-instances
    jmp dqMark
    cma
    dac dqI
    lac [sbBlk:2]
    dac dqA
    lac [cpSub:5]
    dac dqB
dqSb,
    lac i dqA           // DBM
    dac i dqB           // SBM
    dac i [masterBit:7]
    jsp i [masterBit:7+1]
    dac dqU
    lac dqK
    add [mUses:5]
    dac dqT
    lac i dqT
    ior dqU
    dac i dqT
    idx dqA
    idx dqB
    lac i dqA           // DBX
    sub i [dfCX:2]
    dac i dqB           // SBX
    idx dqA
    idx dqB
    lac i dqA           // DBY
    sub i [dfCY:2]
    dac i dqB           // SBY
    idx dqA
    idx dqB
    lac i dqA           // DBS
    dac i dqB           // SBS
    jsp dqDer
    lac dqA
    add [DBT-DBS]
    dac dqA
    idx dqB
    law i NATT
    dac dqJ
dqSbT,
    lac i dqA           // a tie, from DBT
    dac i dqB           // to SBT
    idx dqA
    idx dqB
    isp dqJ             // skip once every tie is kept
    jmp dqSbT
    isp dqI             // skip once every sub-instance is kept
    jmp dqSb
    jmp dqMark

    // The constraints, while ptMark still holds the map. Then the canvas. The tie points are
    // marked, closed up in order, each one's new index plus 1 in its mark; then the tie lists
    // renamed.
dqMark,
    law 1
    dac i [mcKeep:7]
    jsp mcScan
    jsp i [markClear:7]
    lac [iTie:3]
    dac dqT
dqMk,
    lac i dqT
    sad [NOPOINT]       // skip if a tie point
    jmp dqMkNx
    dac i [markOn:7]
    jsp i [markOn:7+1]
dqMkNx,
    idx dqT
    sas [iTie:3+NATT*MAXINST] // skip once every tie is looked at
    jmp dqMk
    dzm dqJ
    dzm dqI
dqKeep,
    lac dqI
    sad i [pointCount:4] // skip while points remain
    jmp dqRen0
    add [ptMark:3]
    dac dqU
    lac i dqU
    sza i               // skip if a tie point
    jmp dqKpNx
    lac dqI
    add [pointX:3]
    dac dqT
    lac dqJ
    add [pointX:3]
    dac dqV
    lac i dqT
    dac i dqV
    lac dqI
    add [pointY:3]
    dac dqT
    lac dqJ
    add [pointY:3]
    dac dqV
    lac i dqT
    dac i dqV
    idx dqJ
    dac i dqU
dqKpNx,
    idx dqI
    jmp dqKeep
dqRen0,
    lac [iTie:3]
    dac dqT
dqRen,
    lac i dqT
    sad [NOPOINT]       // skip if a tie point
    jmp dqRnNx
    add [ptMark:3]
    dac dqU
    lac i dqU
    sub [1]
    dac i dqT
dqRnNx,
    idx dqT
    sas [iTie:3+NATT*MAXINST] // skip once every tie is renamed
    jmp dqRen
    law 1
    dac i [cTopo:010]
    lac dqJ
rtn, jmp i rtnW
rtnW, 0
dqI, 0
dqJ, 0
dqT, 0
dqU, 0
dqA, 0
dqX0, 0
dqX1, 0
dqY0, 0
dqY1, 0
    endloc

// The sub-instance whose SBS word is at dqB, in master dqK's record (cpSub), resident: its
// master's texts derived (dqTxt), and master dqK's box widened to take in the sub-instance's, its
// master's box at its scale from its offset, as the instance's box was on the canvas. For
// instDefOv, and for the propagation's commit (spdefword.ac, rwRedo).
// Entry: dqK, dqB. AC and IO are clobbered; dqB is kept. Called via jsp.
dqDer,
    local dqDr, dqWid, dqWx, dqWy, dqWv, dqWmin, dqWset, dqWr, dqTxt, dqTl, dqTs, dqTsp, \
        dqTn, dqTr, dqTc, dqTcr, dqP, dqM, dqDX, dqDY, dqH, dqV2, dqS, dqE, dqT2, dqD, dqQ
    dap dqDr
    lac dqB
    sub [SBS]
    dac dqP
    lac i dqP           // SBM
    dac dqM
    idx dqP
    lac i dqP           // SBX
    dac dqDX
    idx dqP
    lac i dqP           // SBY
    dac dqDY
    idx dqP
    lac i dqP           // SBS
    dac dqH
    and [IKMASK]
    dac dqS
    jsp dqTxt
    lac [mMinX:5]
    jda dqWid
    lac [mMinY:5]
    jda dqWid
    lac [mMaxX:5]
    jda dqWid
    lac [mMaxY:5]
    jda dqWid
dqDr, jmp .

    // One side of master k's box, in the table at 16-bit address t (mMinX, mMinY, mMaxX or
    // mMaxY), widened to the sub-instance's: its master dqM's side at the scale (dqH) plus its
    // offset (dqDX for x, dqDY for y). A Min table is widened down, a Max one up.
    // Entry: AC = t. AC and IO are clobbered. Called via jda.
dqWid, 0
    dap dqWr
    lac dqWid
    add dqM
    dac dqP
    lac i dqP
    lio dqH
    dac i [ieSize:7]
    jsp i [ieSize:7+1]
    dac dqV2
    lac dqWid
    sad [mMinX:5]       // skip unless mMinX
    jmp dqWx
    sas [mMaxX:5]       // skip if mMaxX
    jmp dqWy
dqWx,
    lac dqV2
    add dqDX
    jmp dqWv
dqWy,
    lac dqV2
    add dqDY
dqWv,
    dac dqV2
    lac dqWid
    add dqK
    dac dqP
    lac dqWid
    sad [mMinX:5]       // skip unless mMinX
    jmp dqWmin
    sad [mMinY:5]       // skip unless mMinY
    jmp dqWmin
    lac dqV2
    sub i dqP
    spa                 // skip if at or past the side
    jmp dqWr
    jmp dqWset
dqWmin,
    lac i dqP
    sub dqV2
    spa                 // skip if at or past the side
    jmp dqWr
dqWset,
    lac dqV2
    dac i dqP
dqWr, jmp .

    // The sub-instance's master's texts derived: each copied in as master k's, at its offset at
    // the scale (dqH) plus the sub-instance's offset, at its scale plus the sub-instance's, at
    // most x8, as the instance showed it; plain, since Define refuses digits there (DEFDIGIT).
    // Its cost, its characters and TXOWN, goes to master k's (txMCost), as the text module's
    // txDefine counts one; txDefine has written the canvas's, and txDefRoom has checked for
    // room (txDrMore). The texts before the copies are dqM's. AC and IO are clobbered. Called
    // via jsp.
dqTxt,
    dap dqTr
    lac i [mtN:012]
    dac dqE
    dzm dqT2
dqTl,
    lac dqT2
    sad dqE             // skip while the texts before the copies remain
    jmp dqTr
    add [mtM:013]
    dac dqP
    lac i dqP
    sas dqM             // skip if the sub-instance's master's
    jmp dqTn
    lac i [mtN:012]
    dac dqD
    add [mtM:013]
    dac dqP
    lac dqK
    dac i dqP           // mtM
    lac [mtDX:013]
    jda dqTc
    lio dqH
    dac i [ieSize:7]
    jsp i [ieSize:7+1]
    add dqDX
    dac i dqQ           // mtDX
    lac [mtDY:013]
    jda dqTc
    lio dqH
    dac i [ieSize:7]
    jsp i [ieSize:7+1]
    add dqDY
    dac i dqQ           // mtDY
    lac [mtSc:013]
    jda dqTc
    add dqS
    sub [4]
    spa                 // skip if past x8
    jmp dqTs
    law 3
    jmp dqTsp
dqTs,
    add [4]
dqTsp,
    dac i dqQ           // mtSc
    lac [mtCh:013]
    jda dqTc
    dac i dqQ           // mtCh
    add [TXOWN]
    dac dqV2
    lac dqK
    add [txMCost:012]
    dac dqP
    lac i dqP
    add dqV2
    dac i dqP
    lac [mtW:013]
    jda dqTc
    dac i dqQ           // mtW
    lac dqD
    add [mtAn:013]
    dac dqP
    lac [NOPOINT]
    dac i dqP           // mtAn, plain

    // The run, its mtW words, in the masters' pool after the others (the text module's mtDup).
    lio dqT2
    jsp i [mtDup:012]
    idx i [mtN:012]
dqTn,
    idx dqT2
    jmp dqTl
dqTr, jmp .

    // Text dqT2's word in the masters' table at 16-bit address t, for its copy dqD: the
    // copy's word's address in dqQ.
    // Entry: AC = t. Exit: AC = the word. IO is preserved. Called via jda.
dqTc, 0
    dap dqTcr
    lac dqTc
    add dqD
    dac dqQ
    lac dqTc
    add dqT2
    dac dqP
    lac i dqP
dqTcr, jmp .
dqP, 0
dqM, 0                  // a sub-instance's master
dqDX, 0                 // its offset from the origin
dqDY, 0
dqH, 0                  // its scale's shift
dqV2, 0
dqS, 0                  // its scale
dqE, 0                  // the masters' texts before the copies
dqT2, 0                 // a text, and its copy
dqD, 0
dqQ, 0
    endloc

// dqDer's master and its sub-instance's SBS word, which instDefOv and rwRedo set.
dqK, 0
dqB, 0

// A point index mapped to the master's, the word at full address a, a point, through ptMark.
// Entry: AC = a. Exit: dqV = its master index. AC is clobbered, IO preserved. Called via jda.
dqMap, 0
    dap dmRtn
    lac i dqMap
    add [ptMark:3]
    dac dqMap
    lac i dqMap
    sub [1]
    dac dqV
dmRtn, jmp .
dqV, 0

// The constraints among the master's points. Every entry but a fix, an attacher or a
// designation whose points are all master points (ptMark's map, instMap) is counted; with
// mcKeep set each is kept too, in master masterArg's record's cpCon (bank 5, the record instDef's
// stub made resident), its points mapped to master indices, and the count in cpNCon (bank 9).
// A point NOPOINT, left by a removal
// for the next purge to drop, is no master point. instDef keeps them only once instMap has
// counted at most NCPCON. A fix holds a point where it is on the screen, so a copy elsewhere
// takes none; a designation marks the canvas for the next copy, so a master keeps none, nor a
// constraint on size, which names instances.
// Entry: mcKeep. Exit: AC = the count. IO is clobbered. Called via jsp.
mcScan,
    local rtn, msLoop, msPt, msKeep, msMap, msCnt, msNext, msDone, msOut, msE, msP, msT, msK, \
        msN, msD
    dap rtn
    dzm msN
    lac [cpCon:5]
    dac msD
    lac [cEntries:011]
    dac msE
msLoop,
    lac msE
    sad i [cEnd:010]    // skip while entries remain
    jmp msDone
    lac i msE
    sad [CTATT]         // skip unless an attacher
    jmp msNext
    sad [CTF]           // skip unless a fix
    jmp msNext
    sad [CTDES]         // skip unless a designation
    jmp msNext
    sub [CTSAME]
    sma                 // skip unless a size's, which names instances
    jmp msNext
    lac i msE
    and [CTMASK]
    add [cNPts:011]
    dac msT
    lac i msT
    cma
    dac msK
    lac msE
    dac msP
msPt,
    idx msP
    lac i msP
    sad [NOPOINT]       // skip unless the point is gone
    jmp msNext
    add [ptMark:3]
    dac msT
    lac i msT
    sza i               // skip if a master point
    jmp msNext
    isp msK             // skip once every point is a master point
    jmp msPt
    lac i [mcKeep:7]
    sza i               // skip if it is to be kept
    jmp msCnt

    // Its words, then its points mapped.
    lac msE
    dac msP
    lac msD
    dac msT
    law i CW
    dac msK
msKeep,
    lac i msP
    dac i msT
    idx msP
    idx msT
    isp msK             // skip once every word is kept
    jmp msKeep
    lac i msE
    and [CTMASK]
    add [cNPts:011]
    dac msP
    lac i msP
    cma
    dac msK
    lac msD
    dac msP
msMap,
    idx msP
    lac i msP
    add [ptMark:3]
    dac msT
    lac i msT
    sub [1]
    dac i msP
    isp msK             // skip once every point is mapped
    jmp msMap
    lac msD
    add [CW]
    dac msD
msCnt,
    idx msN
msNext,
    lac msE
    add [CW]
    dac msE
    jmp msLoop
msDone,
    lac i [mcKeep:7]
    sza i               // skip if they were kept
    jmp msOut
    lac i [masterArg:4]
    add [cpNCon:011]
    dac msT
    lac msN
    dac i msT
msOut,
    lac msN
rtn, jmp .
msE, 0
msP, 0
msT, 0
msK, 0
msN, 0
msD, 0
    endloc

// Dismember. The instance the pseudo pen location locks onto, penInst, is taken apart as Copy's
// drop takes a copy apart, but at its origin and scale. Its master and origin go into Copy's
// words (copyArg, copyX, copyY), and its scale word into dismShift, for copyParts and cCopy;
// dismOn is set, for copyMerge. Its master's sub-instances become instances on the canvas, one
// level taken apart (copySubsOv). Refused, nothing changed, with no instance locked, with the
// tables short of room (copyRoom), with a sub-instance's scale composed with the instance's
// outside x1/4 to x8 (DMSCALE), with a part off the canvas (the copy box, cMinX to cMaxY, at the
// scale about the origin, beyond TRKXMIN to TRKXMAX or TRKYMIN to TRKYMAX, where the target cannot
// reach), or with an arc whose radius at the scale passes ARCRMAX (its center's and start's offsets
// in the store, compared squared, dismSquare). Its slot, master, origin, scale,
// cycle flag and tie list are kept for Undo (instUndism) and for copyMerge (dismTie). The main
// bank's dismLost then runs Copy's drop, which removes the instance.
// Exit: AC = 0, COPYROOM, 2 with no instance locked, DMSCALE with a scale out of range, DMOFF with
// a part off the canvas, DMARC with an arc too large. IO is clobbered. Called by the manager, from
// its stub (instDism).
instDismOv,
    local rtn, idNone, rtnW
    dac rtnW
    lac i [penInst:4]
    sad [NOPOINT]       // skip if an instance locks
    jmp idNone
    jda dismAt
    jmp rtn
idNone,
    law 2
rtn, jmp i rtnW
rtnW, 0
    endloc

// The dismember of instance i, as instDism describes it. Copy's words are set and the instance
// kept for Undo, or it is refused, its words set but nothing else changed. Define's instNest and
// instNestAt call it for every instance.
// Entry: AC = i. Exit: AC = 0, COPYROOM, DMSCALE, DMOFF or DMARC. IO is clobbered. Called via
// jda.
dismAt, 0
    local rtn, dmSc, dmBox, dmScl, dmArc, dmTies, dmTieLp, dmOff, dmBig, dmP, dmQ, dmT, dmU, \
        dmN, dmA
    dap rtn
    lac dismAt
    dac i [dismInst:7]
    add [iMaster:012]
    dac dmP
    lac i dmP
    dac i [dismMaster:7]
    dac i [copyArg:4]
    lac i [dismInst:7]
    add [iX:3]
    dac dmP
    lac i dmP
    dac i [dismX:7]
    dac i [copyX:4]
    lac i [dismInst:7]
    add [iY:3]
    dac dmP
    lac i dmP
    dac i [dismY:7]
    dac i [copyY:4]
    lac i [dismInst:7]
    add [iCyc:3]
    dac dmP
    lac i dmP
    dac i [dismCyc:7]
    lac i [instCount:012]
    sub [1]
    dac i [dismLast:7]
    lac i [dismInst:7]  // its texts' copies are replaced, not added
    dac i [crInst:7]
    jsp i [copyRoom:7]
    sza                 // skip if the parts fit
    jmp rtn
    lac i [dismInst:7]
    add [iScale:3]
    dac dmP
    lac i dmP
    dac i [dismScale:7]
    dac i [dismShift:7]
    dac i [ieShOf:7]
    jsp i [ieShOf:7+1]
    dac i [ibSh:7]

    // Each sub-instance's scale composed with the instance's, x1/4 to x8, from the master's
    // record (made resident by the stub that reached here).
    lac i [dismMaster:7]
    add [mNSub:5]
    dac dmP
    lac i dmP
    sza i               // skip if the master holds sub-instances
    jmp dmBox
    cma
    dac dmN
    lac [cpSub:5]
    add [SBS]
    dac dmA
dmSc,
    lio i [dismScale:7]
    lac i dmA
    dac i [ieComp:2]
    jsp i [ieComp:2+1]
    spa                 // skip if in range
    jmp dmScl
    lac dmA
    add [SUBW]
    dac dmA
    isp dmN             // skip once every sub-instance is looked at
    jmp dmSc

    // The copy box at the scale about the origin, on the canvas.
dmBox,
    lac i [dismMaster:7]
    add [cMinX:5]
    dac i [ibVal:7]
    jsp i [ibVal:7+1]
    add i [dismX:7]
    sub [TRKXMIN]
    spa                 // skip unless left of the canvas
    jmp dmOff
    lac i [dismMaster:7]
    add [cMaxX:5]
    dac i [ibVal:7]
    jsp i [ibVal:7+1]
    add i [dismX:7]
    sub [TRKXMAX+1]
    sma                 // skip unless right of it
    jmp dmOff
    lac i [dismMaster:7]
    add [cMinY:5]
    dac i [ibVal:7]
    jsp i [ibVal:7+1]
    add i [dismY:7]
    sub [TRKYMIN]
    spa                 // skip unless below it
    jmp dmOff
    lac i [dismMaster:7]
    add [cMaxY:5]
    dac i [ibVal:7]
    jsp i [ibVal:7+1]
    add i [dismY:7]
    sub [TRKYMAX+1]
    sma                 // skip unless above it
    jmp dmOff

    // Each arc's radius at the scale, from its center's and start's offsets in the store, the
    // master's record (made resident by the stub that reached here).
    lac i [dismMaster:7]
    add [cpNA:5]
    dac dmP
    lac i dmP
    sza i               // skip if the master has arcs
    jmp dmTies
    cma
    dac dmN
    lac [cpC:5]
    dac dmA             // the arc's center's word; its start's is CPARCS on
dmArc,
    lac dmA
    add [CPARCS]
    dac dmP
    lac i dmP
    dac dmQ             // the start's word
    lac i dmA
    dac dmP             // the center's
    add [cpX:5]
    dac dmT
    lac i dmT
    dac dmU
    lac dmQ
    add [cpX:5]
    dac dmT
    lac i dmT
    sub dmU
    jda dismSquare
    dac dmU
    lac dmP
    add [cpY:5]
    dac dmT
    lac i dmT
    dac dmT
    lac dmQ
    add [cpY:5]
    dac dmQ
    lac i dmQ
    sub dmT
    jda dismSquare
    add dmU
    sub [ARCRSQ+1]
    sma                 // skip if the radius is within ARCRMAX
    jmp dmBig
    idx dmA
    isp dmN             // skip once every arc is looked at
    jmp dmArc

    // Its tie list, kept.
dmTies,
    lac i [dismInst:7]
    add [iTie:3]
    dac dmP
    lac [dismTie:7]
    dac dmQ
    law i NATT
    dac dmN
dmTieLp,
    lac i dmP
    dac i dmQ
    lac dmP
    add [MAXINST]
    dac dmP
    idx dmQ
    isp dmN             // skip once every attacher's word is kept
    jmp dmTieLp
    law 1
    dac i [dismOn:7]
    cla
    jmp rtn
dmScl,
    law DMSCALE
    jmp rtn
dmOff,
    law DMOFF
    jmp rtn
dmBig,
    law DMARC
rtn, jmp .
dmP, 0
dmQ, 0
dmT, 0
dmU, 0
dmN, 0
dmA, 0
    endloc

// An arc's offset on one axis at the dismember's scale word (dismShift), squared and divided by 32;
// over ARCRMAX on its own, ARCRSQ + 1, which no radius in range reaches.
// Entry: AC = the offset in the store. Exit: AC = the value. IO is clobbered. Called via jda.
dismSquare, 0
    local rtn, sqBig, sqV
    dap rtn
    lac dismSquare
    dac i [ieAbs:7]
    jsp i [ieAbs:7+1]
    lio i [dismShift:7]
    dac i [ieSize:7]
    jsp i [ieSize:7+1]
    dac sqV
    sub [ARCRMAX+1]
    sma                 // skip if within ARCRMAX
    jmp sqBig
    lac sqV
    mul sqV
    scr 6s              // the product's alignment and 5 places more; IO = the square / 32
    dio sqV
    lac sqV
    jmp rtn
sqBig,
    lac [ARCRSQ+1]
rtn, jmp .
sqV, 0
    endloc

// The instances a copy's drop or a dismember adds for the sub-instances of master copyArg, whose
// record copyParts has made resident, after its parts, one level taken apart: one each, appended
// to the instance list. Its master is the sub-instance's; its origin (copyX, copyY) plus the
// sub-instance's offset at the dismember's scale word (dismShift, 0 for Copy's drop); its scale
// that word composed with the sub-instance's (ieComp), which dismAt has kept in range;
// not cycling; and its ties the placed points for the sub-instance's tie points, past copyBase,
// before the attachers' merges rename them as every tie (conRenM). The caller has checked the
// list's room (copyRoom) and brought their words into the master store (subBring); its respread
// spreads the new slots.
// Exit: AC = 0. IO is clobbered. Called by the manager, from its stub (copySubs).
copySubsOv,
    local rtn, csSub, csTie, rtnW, csN, csA, csI, csP, csT, csL
    dac rtnW
    law 1
    dac i [cTopo:010]   // the solver's ties change
    lac i [copyArg:4]
    add [mNSub:5]
    dac csP
    lac i csP
    cma
    dac csN
    lac [cpSub:5]
    dac csA             // the sub-instance's first word, SBM
csSub,
    lac i [instCount:012]
    dac csI
    add [iMaster:012]
    dac csP
    lac i csA
    dac i csP
    lac csA
    add [SBX]
    dac csT
    lio i [dismShift:7]
    lac i csT
    dac i [ieSize:7]
    jsp i [ieSize:7+1]
    add i [copyX:4]
    dac csL
    lac csI
    add [iX:3]
    dac csP
    lac csL
    dac i csP
    lac csA
    add [SBY]
    dac csT
    lio i [dismShift:7]
    lac i csT
    dac i [ieSize:7]
    jsp i [ieSize:7+1]
    add i [copyY:4]
    dac csL
    lac csI
    add [iY:3]
    dac csP
    lac csL
    dac i csP
    lac csA
    add [SBS]
    dac csT
    lio i [dismShift:7]
    lac i csT
    dac i [ieComp:2]
    jsp i [ieComp:2+1]
    dac csL
    lac csI
    add [iScale:3]
    dac csP
    lac csL
    dac i csP
    lac csI
    add [iCyc:3]
    dac csP
    dzm i csP

    // Its ties, NOPOINT kept for none.
    lac csA
    add [SBT]
    dac csT
    lac csI
    add [iTie:3]
    dac csP
    law i NATT
    dac csL
csTie,
    lac i csT
    sas [NOPOINT]       // skip if no tie point
    add i [copyBase:4]
    dac i csP
    idx csT
    lac csP
    add [MAXINST]
    dac csP
    isp csL             // skip once every tie is written
    jmp csTie
    lac csI
    dac i [instParam:7]
    jsp i [instParam:7+1]
    lac csI
    dac i [instXY:7]
    jsp i [instXY:7+1]
    lac csI
    dac i [instGate:7]
    jsp i [instGate:7+1]
    idx i [instCount:012]
    lac csA
    add [SUBW]
    dac csA
    isp csN             // skip once every sub-instance has its instance
    jmp csSub
    cla
rtn, jmp i rtnW
rtnW, 0
csN, 0
csA, 0
csI, 0
csP, 0
csT, 0
csL, 0
    endloc

// Define's checks before it takes apart the instances of the master being defined, k
// (masterArg), and keeps every other as a sub-instance, nothing but Copy's words and the kept
// instance changed if one refuses, which Define's cleared Undo no longer reads. It refuses for an
// instance cycling (DEFCYCLE; instMap's check, made first here). For the instances kept, then,
// among them an instance for each of k's sub-instances for each instance of k taken apart: an
// instance whose master calls k at any depth (DEFLOOP, by mUses: nsR, every master that does, a
// bit each); more than NSUB (DEFNSUB); an instance whose master holds digits among the masters'
// texts (DEFDIGIT, over mUses[k] for the added ones). For the instances of k: the tables short
// of room for their points, lines, arcs and constraints at once, or the instance list for the
// instances added (DEFNROOM: copyRoom's sums, an attacher's point counted though its merge takes
// it back), and the canvas for their texts (the text module's txNestRoom); one with a
// sub-instance's scale composed with its own out of range, a part off the canvas or an arc too
// large at its scale (dismAt's checks: DEFNSCALE, DEFNOFF, DEFNARC). With no instances, nothing is
// checked. The last, dismAt's, the stub makes for each instance of k in turn after this answers
// 0, through instNestChkOv, since each reads its instance's master's record, which only the
// root loads.
// Exit: AC = 0, or why not. IO is clobbered. Called by the manager, from its stub (instNest).
instNestOv,
    local rtn, nsSum0, nsSum, nsSmNx, nsFit, nsNo, nsI, nsT, nsM, nsP, nsL, nsA, nsC, rtnW, \
        nsKeep, nsRch, nsRj, nsRjNx, nsKp0, nsKp, nsKpO, nsKpNx, nsKpEnd, nsLp1, nsSub1, \
        nsDig1, nsDig, nsDgLp, nsDgNx, nsDgOut, nsDgR, nsR, nsJ, nsK, nsN, nsLp, nsDg, nsSf, \
        nsX, nsDgK, nsDgV, nsDgP, nsS, nsUs, nsUsNx
    dac rtnW
    lac i [cycN:4]
    sza i               // skip if an instance cycles
    jmp nsKeep
    law DEFCYCLE
    jmp rtn

    // nsR, the masters that call k at any depth: k's bit, then each master that uses one in
    // it, until a pass over every master adds none, at most NMASTER passes.
nsKeep,
    lac i [masterArg:4]
    dac i [masterBit:7]
    jsp i [masterBit:7+1]
    dac nsR
    law i NMASTER
    dac nsK
nsRch,
    lac nsR
    dac nsX
    dzm nsJ
nsRj,
    lac nsJ
    add [mUses:5]
    dac nsT
    lac i nsT
    and nsR
    sza i               // skip if master j uses one that calls k
    jmp nsRjNx
    lac nsJ
    dac i [masterBit:7]
    jsp i [masterBit:7+1]
    ior nsR
    dac nsR
nsRjNx,
    idx nsJ
    sas [NMASTER]       // skip once every master is looked at
    jmp nsRj
    lac nsR
    sad nsX             // skip if the pass added one
    jmp nsKp0
    isp nsK             // skip after NMASTER passes
    jmp nsRch

    // The instances: each of k's adds an instance for each of k's sub-instances, kept with the
    // rest and counted in the list's room (nsS); every other is counted and flags DEFLOOP and
    // DEFDIGIT.
nsKp0,
    dzm nsN
    dzm nsS
    dzm nsLp
    dzm nsDg
    dzm nsSf
    dzm nsI
nsKp,
    lac nsI
    sad i [instCount:012] // skip while instances remain
    jmp nsKpEnd
    add [iMaster:012]
    dac nsT
    lac i nsT
    dac nsM
    sas i [masterArg:4] // skip if an instance of k
    jmp nsKpO
    lac i [masterArg:4]
    add [mNSub:5]
    dac nsT
    lac i nsT
    dac nsSf            // the same for every instance of k
    add nsN
    dac nsN
    lac nsSf
    add nsS
    dac nsS
    jmp nsKpNx
nsKpO,
    idx nsN
    lac nsM
    dac i [masterBit:7]
    jsp i [masterBit:7+1]
    and nsR
    ior nsLp
    dac nsLp
    lac nsM
    jda nsDig
    ior nsDg
    dac nsDg
nsKpNx,
    idx nsI
    jmp nsKp
    // The masters of k's sub-instances, which those added instances call, flag DEFDIGIT as a
    // kept instance's do, since one may have gained digits since k was defined. None can call k,
    // k calling them.
nsKpEnd,
    lac nsSf
    sza i               // skip if k has sub-instances and an instance of k is here
    jmp nsLp1
    lac i [masterArg:4]
    add [mUses:5]
    dac nsT
    lac i nsT
    dac nsX
    dzm nsJ
nsUs,
    lac nsJ
    dac i [masterBit:7]
    jsp i [masterBit:7+1]
    and nsX
    sza i               // skip if k holds master j
    jmp nsUsNx
    lac nsJ
    jda nsDig
    ior nsDg
    dac nsDg
nsUsNx,
    idx nsJ
    sas [NMASTER]       // skip once every master is looked at
    jmp nsUs
nsLp1,
    lac nsLp
    sza i               // skip if a kept instance calls k
    jmp nsSub1
    law DEFLOOP
    jmp rtn
nsSub1,
    lac nsN
    sub [NSUB+1]
    spa                 // skip if more than NSUB kept
    jmp nsDig1
    law DEFNSUB
    jmp rtn
nsDig1,
    lac nsDg
    sza i               // skip if a kept instance's master holds digits
    jmp nsSum0
    law DEFDIGIT
    jmp rtn
nsSum0,
    lac i [pointCount:4]
    dac nsP
    lac i [lineCount:4]
    dac nsL
    lac i [arcCount:2]
    dac nsA
    lac i [cCount:011]
    dac nsC
    dzm nsI
nsSum,
    lac nsI
    sad i [instCount:012] // skip while instances remain
    jmp nsFit
    add [iMaster:012]
    dac nsT
    lac i nsT
    sas i [masterArg:4] // skip if an instance of k
    jmp nsSmNx
    dac nsM
    add [cpNP:5]
    dac nsT
    lac i nsT
    add nsP
    dac nsP
    lac nsM
    add [cpNL:5]
    dac nsT
    lac i nsT
    add nsL
    dac nsL
    lac nsM
    add [cpNA:5]
    dac nsT
    lac i nsT
    add nsA
    dac nsA
    lac nsM
    add [cpNCon:011]
    dac nsT
    lac i nsT
    add nsC
    dac nsC
nsSmNx,
    idx nsI
    jmp nsSum
nsFit,
    lac nsP
    sub [MAXPTS+1]
    sma                 // skip if the points fit
    jmp nsNo
    lac nsL
    sub [MAXLINES+1]
    sma                 // skip if the lines fit
    jmp nsNo
    lac nsA
    sub [MAXARCS+1]
    sma                 // skip if the arcs fit
    jmp nsNo
    lac nsC
    sub [NCON+1]
    sma                 // skip if the constraints fit
    jmp nsNo
    lac nsS
    add i [instCount:012]
    sub [MAXINST+1]
    sma                 // skip if the sub-instances' instances fit beside every instance now
    jmp nsNo
    // The texts' room before dismAt, whose COPYROOM for an instance's texts instNestChkOv would
    // misname; AC = 0 when they fit.
    jsp i [txNestRoom:012]  // the canvas's room for every instance's texts at once
    jmp rtn
nsNo,
    law DEFNROOM
rtn, jmp i rtnW

    // Master m's sets of digits among the masters' texts (the text module's mtDigs, whose return
    // stays in bank 10). Entry: AC = m. Exit: AC = the count. IO is preserved. Called via jda.
nsDig, 0
    dap nsDgR
    dzm nsDgK
    dzm nsDgV
nsDgLp,
    lac nsDgK
    sad i [mtN:012]     // skip while the masters' texts remain
    jmp nsDgOut
    add [mtM:013]
    dac nsDgP
    lac i nsDgP
    sas nsDig           // skip if the master's
    jmp nsDgNx
    lac nsDgK
    add [mtAn:013]
    dac nsDgP
    lac i nsDgP
    sas [NOPOINT]       // skip unless digits
    idx nsDgV
nsDgNx,
    idx nsDgK
    jmp nsDgLp
nsDgOut,
    lac nsDgV
nsDgR, jmp .
rtnW, 0
nsI, 0
nsT, 0
nsM, 0
nsP, 0
nsL, 0
nsA, 0
nsC, 0
nsR, 0                  // the masters that call k, a bit each
nsJ, 0
nsK, 0
nsN, 0                  // the instances kept
nsS, 0                  // the instances added for k's sub-instances
nsLp, 0                 // nonzero if one calls k
nsDg, 0                 // nonzero if one's master holds digits
nsSf, 0                 // nonzero if k has sub-instances and an instance of k is here
nsX, 0
nsDgK, 0
nsDgV, 0
nsDgP, 0
    endloc

// Define's check of instance j, which the stub instNest makes for each instance in turn once
// instNestOv has answered 0, the instance's master's record resident: dismAt's checks, a
// sub-instance's scale composed with the instance's out of range, a part off the canvas or an arc
// too large at its scale, its answer named as Define's refusal (DEFNSCALE, DEFNOFF, DEFNARC;
// COPYROOM, which instNestOv's sums and txNestRoom have ruled out, would be DEFCONS).
// Entry: IO = j. Exit: AC = 0, or why not. IO is clobbered. Called by the manager, from its
// stub (instNest).
instNestChkOv,
    local rtn, ncScl, rtnW, ncJ
    dac rtnW
    dio ncJ
    lac ncJ
    jda dismAt
    sad [DMSCALE]       // skip unless a composed scale out of range
    jmp ncScl
    sza                 // skip if the instance can be taken apart
    add [DEFNOFF-DMOFF]
    jmp rtn
ncScl,
    law DEFNSCALE
rtn, jmp i rtnW
rtnW, 0
ncJ, 0
    endloc

// Define's instance i, of the master being defined (masterArg), taken apart. Copy's words are
// set as a dismember sets them (dismAt), which instNest has checked; for every instance of that
// master after the first, dismNest is set, so that cCopy keeps the places once, before them all,
// for a refusal's Undo to put back.
// Entry: instNestAt, the stub's argument word, = i. Exit: AC = 0. IO is clobbered. Called by the
// manager, from its stub (instNestAt).
instNestAtOv,
    local rtn, naLp, naSet, rtnW, naJ, naT
    dac rtnW
    lac i [instNestAt:7]
    jda dismAt
    dzm naJ
naLp,
    lac naJ
    sad i [instNestAt:7] // skip while instances before i remain
    jmp rtn
    add [iMaster:012]
    dac naT
    lac i naT
    sad i [masterArg:4] // skip unless one taken apart before i
    jmp naSet
    idx naJ
    jmp naLp
naSet,
    law 1
    dac i [dismNest:7]
rtn, cla
    jmp i rtnW
rtnW, 0
naJ, 0
naT, 0
    endloc

// Undo of a dismember (the main bank's undoParts, after its removals). The instance instDism
// kept is put back as it was, in its slot (dismInst), and the instance instRemove moved there
// back in the last slot (dismLast), each slot written as instRemove and instAdd write one, so
// that each instance has the slot whose origin Undo's snapshot (cSnap, taken before the removal)
// keeps for it; whatever a cycle's step has added since to the moved one's kept origin (instTo)
// goes back with it. A dismember that added instances (its master's sub-instances) moved the
// last of them there instead, and undoParts has removed the others: that one is written over,
// out of the cycling, its slot's kept origin the instance's again, and the last slot, never
// moved, keeps its own. Its tie points return to it, none made, and it cycles again if it
// cycled, which sets cycN and, with no other cycling, the steps' clock and the cycle's position,
// as the Cycle row starts one (instChange). Its ties join the solver's (cTopo). The caller
// spreads the target calls again (the arc module's arcUndo).
// Exit: AC = 0. IO is clobbered. Called by the manager, from its stub (instUndism).
instUndismOv,
    local rtn, udCopy, udAdded, udGate, udSlot, udTie, udOne, udDone, udP, udQ, udN, rtnW
    dac rtnW
    law 1
    dac i [cTopo:010]
    lac i [instCount:012]
    sas i [dismLast:7]  // skip if it added no instances
    jmp udAdded
    lac i [dismLast:7]
    sad i [dismInst:7]  // skip unless it was the last
    jmp udSlot

    // The moved instance back in the last slot, its master, origin, cycle flag, scale and tie
    // list, as instRemove moved them; then its slot, unused until now, written.
    lac i [dismInst:7]
    add [iMaster:012]
    dac udP
    lac i [dismLast:7]
    add [iMaster:012]
    dac udQ
    lac i udP
    dac i udQ
    lac i [dismInst:7]
    add [iX:3]
    dac udP
    lac i [dismLast:7]
    add [iX:3]
    dac udQ
    lac i udP
    dac i udQ
    lac i [dismInst:7]
    add [iY:3]
    dac udP
    lac i [dismLast:7]
    add [iY:3]
    dac udQ
    lac i udP
    dac i udQ
    lac i [dismInst:7]
    add [iCyc:3]
    dac udP
    lac i [dismLast:7]
    add [iCyc:3]
    dac udQ
    law i NATT+2
    dac udN
udCopy,
    lac i udP
    dac i udQ
    lac udP
    add [MAXINST]
    dac udP
    lac udQ
    add [MAXINST]
    dac udQ
    isp udN             // skip once the scale and the tie list are copied
    jmp udCopy
    lac i [dismLast:7]
    dac i [instParam:7]
    jsp i [instParam:7+1]
    lac i [dismLast:7]
    dac i [instXY:7]
    jsp i [instXY:7+1]
    lac i [dismLast:7]
    dac i [instGate:7]
    jsp i [instGate:7+1]

    // Its kept origin's steps since (bank 9's uSX and uSY), moved with it.
    lac i [dismInst:7]
    add [MAXPTS]
    add [uSX:011]
    dac udP
    lac i [dismLast:7]
    add [MAXPTS]
    add [uSX:011]
    dac udQ
    lac i udP
    sub i [dismX:7]
    add i udQ
    dac i udQ
    lac i [dismX:7]
    dac i udP
    lac udP
    add [NVAR]          // uSY, after uSX
    dac udP
    lac udQ
    add [NVAR]
    dac udQ
    lac i udP
    sub i [dismY:7]
    add i udQ
    dac i udQ
    lac i [dismY:7]
    dac i udP
    jmp udGate

    // The last instance added, in the slot: one fewer cycling if it cycles, and the slot's kept
    // origin the instance's, as the snapshot took it.
udAdded,
    lac i [dismInst:7]
    add [iCyc:3]
    dac udP
    lac i [cycN:4]
    sub i udP
    dac i [cycN:4]
    lac i [dismInst:7]
    add [MAXPTS]
    add [uSX:011]
    dac udP
    lac i [dismX:7]
    dac i udP
    lac udP
    add [NVAR]          // uSY, after uSX
    dac udP
    lac i [dismY:7]
    dac i udP

    // Its slot's gate steps over the call while the slot's words change.
udGate,
    lac i [dismInst:7]
    dac i [instSlot:7]
    jsp i [instSlot:7+1]
    add [INSTGATE]
    dac udP
    add [1]
    ior [jump next(parameter)]
    dac i udP

    // The instance taken apart, in its slot.
udSlot,
    lac i [dismInst:7]
    add [iMaster:012]
    dac udP
    lac i [dismMaster:7]
    dac i udP
    lac i [dismInst:7]
    add [iX:3]
    dac udP
    lac i [dismX:7]
    dac i udP
    lac i [dismInst:7]
    add [iY:3]
    dac udP
    lac i [dismY:7]
    dac i udP
    lac i [dismInst:7]
    add [iScale:3]
    dac udP
    lac i [dismScale:7]
    dac i udP
    lac i [dismInst:7]
    add [iCyc:3]
    dac udP
    lac i [dismCyc:7]
    dac i udP
    lac i [dismInst:7]
    add [iTie:3]
    dac udP
    lac [dismTie:7]
    dac udQ
    law i NATT
    dac udN
udTie,
    lac i udQ
    dac i udP
    lac udP
    add [MAXINST]
    dac udP
    idx udQ
    isp udN             // skip once every attacher's word is written
    jmp udTie
    lac i [dismInst:7]
    dac i [instParam:7]
    jsp i [instParam:7+1]
    lac i [dismInst:7]
    dac i [instXY:7]
    jsp i [instXY:7+1]
    lac i [dismInst:7]
    dac i [instGate:7]
    jsp i [instGate:7+1]
    lac i [dismLast:7]
    add [1]
    dac i [instCount:012]

    // Cycling again, as the Cycle row starts it.
    lac i [dismCyc:7]
    sza i               // skip if it cycled
    jmp udDone
    lac i [cycN:4]
    sza                 // skip if none cycles
    jmp udOne
    lac i [now:4]
    dac i [cycAt:7]
    lac i [dismInst:7]
    dac i [cyFrom:7]
    jsp i [cyFrom:7+1]
udOne,
    idx i [cycN:4]
udDone,
    cla
rtn, jmp i rtnW
rtnW, 0
udP, 0
udQ, 0
udN, 0
    endloc

// Show why Define refused (the main bank's actDefine, at dfBack): answer n's word of dnTab under
// the bar until a menu hit or a pick-up hides it (the main bank's msgHide), the name line blank,
// as the text module's txSay shows its own (sptext.ac).
// A copy of txSay's writer, so that the overlay calls nothing outside bank 7. A refusal for a
// master holding the one defined (DEFPBIG to DEFPDIGIT) names that master (rewriteOv's rwWho)
// by its number, M1 to M16, in the word's first three characters.
// Entry: instDefNo (bank 7) = the answer, DEFEMPTY to DEFPDIGIT. Exit: AC = 0. IO is clobbered.
// Called via jsp from instDefNo.
instDefNoOv,
    local rtn, rtnW, dnLp, dnPd, dnTen, dnHave, dnName, dnP, dnQ, dnN
    dac rtnW
    lac i [instDefNo:7]
    add [dnTab:5-1]
    dac dnP
    lac i dnP
    dac dnP             // the word's first of four
    lac [msgText:0]
    dac dnQ
    law i 4
    dac dnN
dnLp,
    lac i dnP
    dac i dnQ
    idx dnP
    idx dnQ
    isp dnN             // skip once the four words are written
    jmp dnLp
    lac i [instDefNo:7]
    sub [DEFPBIG]
    spa                 // skip if a holder's refusal
    jmp dnName
    lac i [rwWho:2]
    sub [0d9]
    sma                 // skip if M1 to M9
    jmp dnTen
    add [0d9]
    add i [dnM1:5]
    jmp dnHave
dnTen,
    add i [dnM10:5]
dnHave,
    dac i [msgText:0]
dnName,
    // A blank name run of pads with the end code in the last word only, as txSay's: an end code
    // earlier returns the 340 to parameter mode there, and a pad's bits as a parameter word are a
    // halt, ending every frame at the status word while it shows.
    lac [msgName:0]
    dac dnQ
    law i NAMEW - 1
    dac dnN
dnPd,
    lac [KBPAD]
    dac i dnQ
    idx dnQ
    isp dnN             // skip once the pads are written
    jmp dnPd
    lac [KBBLANK]
    dac i dnQ
    lac [jump msgWord:0 next(parameter)]
    dac i [statGate:0]
    // lastMenuMs from the clock read here, not from now, the pass's start: Define of a large
    // drawing runs seconds past it, so the pen still on the name keyboard's OK would read as a
    // fresh press and hide the word (onMenuHit). now goes forward with it, so that elapsed
    // never meets a lastMenuMs after now. lastTick goes with now, as after a tape transfer: the
    // frames that ended during Define are counted only at the next pass, so onClock, later in
    // this one, would read all of Define as WATCHDOGMS with no frame and restart the display
    // mid-frame.
    rck
    dio i [now:4]
    dio i [lastTick:4]
    dio i [lastMenuMs:4]
    law 1
    dac i [msgOn:4]
    cla
rtn, jmp i rtnW
rtnW, 0
dnP, 0
dnQ, 0
dnN, 0
    endloc

// Master dfK's record for its words (IESTORE), once defineMasterOv has counted them, dfN, and the
// instances are gone, so that no instance's gate calls a master. The stub has made the record
// resident (mrLoad). Its old words are dropped (its length 0), and every master leaves the
// master store (mStart MNOPOOL), none being called now; poolBring brings each back when an
// instance first calls it. The words' full address, the record's mrWords, goes into dfAt, where
// defineStoreOv writes them.
// Exit: AC = 0. IO is clobbered. Called by the manager, from its stub (instStore).
instStoreOv,
    local rtn, stOut, stJ, stP, rtnW
    dac rtnW
    lac i [dfK:2]
    add [mLen:5]
    dac stP
    dzm i stP
    lac [mStart:5]
    dac stP
    law i NMASTER
    dac stJ
stOut,
    lac [MNOPOOL]
    dac i stP
    idx stP
    isp stJ             // skip once every master is out
    jmp stOut
    lac [mrWords:5]
    dac i [dfAt:2]
    cla
rtn, jmp i rtnW
rtnW, 0
stJ, 0
stP, 0
    endloc

// Define's words, its count and its store (IEWORDS, IEWSTORE).
#include "spdefword.ac"

%%endoverlay

// Move wmN words from the 16-bit address wmA on to wmB on, each shifted by wmX (an ieShTab
// word, for xct) and wmD added. wmN may be 0.
// Entry: wmA, wmB, wmN, wmX, wmD. Exit: wmA and wmB past the words. AC and IO are clobbered.
// Called via jsp.
moveW,
    local rtn, wmLoop
    dap rtn
    lac wmN
    sza i               // skip if there are words
    jmp rtn
    cma
    dac wmN
wmLoop,
    lac i wmA
    xct wmX
    add wmD
    dac i wmB
    idx wmA
    idx wmB
    isp wmN             // skip once every word is moved
    jmp wmLoop
rtn, jmp .
    endloc

