    dac sdC
    sub [0d10]
    sma                 // skip if a digit
    jmp sdBad
    lac sdF
    sza                 // skip unless a digit follows the point already
    jmp sdBad
    lac sdP
    dac sdF             // a digit after the point is the last
    lac sdV
    sal 2s
    add sdV
    sal 1s              // ten times
    add sdC
    dac sdV
    idx sdN
    jmp sdLoop
sdDot,
    lac sdP
    sza                 // skip unless a second point
    jmp sdBad
    idx sdP
    jmp sdLoop
sdEnd,
    lac sdN
    sza i               // skip if a digit was typed
    jmp sdBad
    lac sdF
    sza                 // skip if no digit follows the point (whole units, made tenths)
    jmp sdT
    lac sdV
    sal 2s
    add sdV
    sal 1s
    dac sdV
sdT,
    lac sdV
    sza i               // skip unless 0
    jmp sdBad
    sub [STIFFMAX+1]
    sma                 // skip if STIFFMAX or less
    jmp sdBad
    lac sdV
    sad [STIFFONE]      // skip unless 1.0, kept as CUNUSED alone
