    sad [5]             // skip unless Name's picker
    jmp xdNm
    sad [3]             // skip unless Define's picker
    jmp xdDf
    sad [2]             // skip unless Dwell's picker
    jmp xdKb
    sza                 // skip unless Seq's keyboard
