    jda instSlot
    add [INSTGATE]
    dac irG
    add [1]
    ior [jump next(parameter)]
    dac i irG

    // The last's master into i's, in bank 2; then its origin, iX and iY; then its cycle flag,
    // scale and tie list, iCyc, iScale and iTie, NATT + 2 tables MAXINST apart.
    lac irLast
    add [iMaster:012]
    dac irP
    lac instRemove
    add [iMaster:012]
    dac irQ
    lac i irP
    dac i irQ
    lac irLast
    add [iX:3]
    dac irP
    lac instRemove
    add [iX:3]
    dac irQ
    lac i irP
    dac i irQ
    lac irLast
    add [iY:3]
    dac irP
    lac instRemove
    add [iY:3]
    dac irQ
    lac i irP
    dac i irQ
    lac irLast
    add [iCyc:3]
    dac irP
    lac instRemove
    add [iCyc:3]
    dac irQ
    law i NATT+2
    dac irN
irCopy,
    lac i irP
    dac i irQ
    lac irP
    add [MAXINST]
    dac irP
    lac irQ
    add [MAXINST]
    dac irQ
    isp irN             // skip once the scale and the tie list are copied
    jmp irCopy
    lac instRemove
    jda instParam
    lac instRemove
    jda instXY
    lac instRemove
    jda instGate
irDrop,
    lac irLast
    jda instUnused
    lac irLast
    dac i [instCount:012]
    jmp rtn
irText,
    dzm tgN
    jsp i [txDelete:012]
rtn, jmp .
irLast, 0
irP, 0
irQ, 0
irN, 0
irG, 0
    endloc

// Copy's room and parts, in this bank to spare the main bank's room. They read the main bank's
// copyArg, copyX, copyY and counts, and write copyBase and the counts, through 16-bit addresses.
// Whether the tables can take every part of master copyArg, its points, lines and arcs, and the
// constraint table its constraints; Copy is refused whole otherwise. The drop that follows is
// Copy's, at x1 (dismOn and dismShift), unless instDism sets them after.
// The canvas must take the master's texts too, and the budget its characters (the text module's
// txCopyRoom and txFits), less those of the instance a dismember takes apart (crInst), whose
// copies they replace; and the instance list an instance for each of its sub-instances (mNSub)
// beside every instance now, the one taken apart or carried still among them.
// Exit: AC = 0 if they fit, COPYROOM if not. IO is clobbered. Called via jsp, from this bank and
// from defdism.
copyRoom,
    local rtn, crNo, crP, crR, rtnW
    dac rtnW
    lac crInst
    dac crR
    lac [NOPOINT]
    dac crInst
    dzm dismOn
    dzm dismNest
    dzm dismShift
    lac i [copyArg:4]
    add [cpNP:5]
    dac crP
    lac i crP
    add i [pointCount:4]
    sub [MAXPTS+1]
    sma                 // skip if the points fit
    jmp crNo
    lac i [copyArg:4]
    add [cpNL:5]
    dac crP
    lac i crP
    add i [lineCount:4]
    sub [MAXLINES+1]
    sma                 // skip if the lines fit
    jmp crNo
    lac i [copyArg:4]
    add [cpNA:5]
    dac crP
    lac i crP
    add i [arcCount:2]
    sub [MAXARCS+1]
    sma                 // skip if the arcs fit
    jmp crNo
    lac i [copyArg:4]
    add [cpNCon:011]
    dac crP
    lac i crP
    add i [cCount:011]
    sub [NCON+1]
    sma                 // skip if the constraints fit
    jmp crNo
    lac i [copyArg:4]
    add [mNSub:5]
    dac crP
    lac i crP
    add i [instCount:012]
    sub [MAXINST+1]
    sma                 // skip if the sub-instances' instances fit
    jmp crNo
    jsp i [txCopyRoom:012]
    sza                 // skip if the texts fit
    jmp crNo
    lac i [copyArg:4]
    dac i [txArg:012]
    lac crR
    dac i [txArg2:012]
    jsp i [txFits:012]
    sza                 // skip if their characters fit
    jmp crNo
    jmp rtn
crNo,
    law COPYROOM
rtn, jmp i rtnW
rtnW, 0
crP, 0
crR, 0
    endloc

// Copy's room (copyRoom), at its pick and at its drop; then the words of its master's
// sub-instances brought into the master store (subBring), since its drop adds an instance of
// each, COPYROOM when the store has no room for them.
// Exit: AC as copyRoom's. IO is clobbered. Called via jsp, from ieTable (IECROOM).
copyBring,
    dap cbRtn
    jsp copyRoom
    sza                 // skip if the parts fit
    jmp cbRtn
    lac [NOPOINT]
    dac i [subBring:014]
    jsp i [subBring:014+1]
    sza i               // skip unless the store has no room
    jmp cbRtn
    law COPYROOM
cbRtn, jmp .

// Copy's drop, its points and lines. Master copyArg's points are added at (copyX, copyY), each
// offset at a dismember's scale word (dismShift), and its lines on them, their point indices moved
// past the points the table held (copyBase, which the arc module's copyArcs reads too). The main
// loop writes the new lines' slots, past the list's old end, as for a commit. The master's
// attachers' new points are listed in cpMrg, in designation order, for the arc module's
// copyMerge. The master's texts are dropped too (the text module's txParts), and an instance
// added for each of its sub-instances last (copySubs).
// The caller has checked for room. The master's record is made resident first, and stays so
// for the arcs (copyArcs) and the constraints (cCopy) that follow in takeParts.
// AC and IO are clobbered. Called via jsp.
copyParts,
    local rtn, cpaMrg, cpaNo, cpaNx, cpaN, cpaL, cpaP, cpaA, cpaM
    dap rtn
    lac i [copyArg:4]
    jda mrLoad
    jsp i [txParts:012]
    lac i [copyArg:4]
    add [cpNAtt:5]
    dac cpaP
    lac i cpaP
    dac cpaN
    lac i [copyArg:4]
    sal 1s
    add i [copyArg:4]
    sal 1s              // k * NATT, 6
    add [cpAtt:5]
    dac cpaA
    lac [cpMrg:3]
    dac cpaM
    law i NATT
    dac cpaL
cpaMrg,
    lac cpaN
    sza i               // skip while the master's attachers remain
    jmp cpaNo
    sub [1]
    dac cpaN
    lac i cpaA
    add i [pointCount:4] // copyBase, set below
    jmp cpaNx
cpaNo,
    lac [NOPOINT]
cpaNx,
    dac i cpaM
    idx cpaA
    idx cpaM
    isp cpaL            // skip once every word is written
    jmp cpaMrg
    lac i [copyArg:4]
    add [cpNP:5]
    dac cpaP
    lac i cpaP
    dac cpaN
    lac i [copyArg:4]
    add [cpNL:5]
    dac cpaP
    lac i cpaP
    dac cpaL
    lac i [pointCount:4]
    dac i [copyBase:4]
    lac dismShift
    jda ieShOf
    dac cpaP
    lac i cpaP
    dac wmX
    lac [cpX:5]
    dac wmA
    lac i [pointCount:4]
    add [pointX:3]
    dac wmB
    lac cpaN
    dac wmN
    lac i [copyX:4]
    dac wmD
    jsp moveW
    lac [cpY:5]
    dac wmA
    lac i [pointCount:4]
    add [pointY:3]
    dac wmB
    lac cpaN
    dac wmN
    lac i [copyY:4]
    dac wmD
    jsp moveW
    lac i [pointCount:4]
    add cpaN
    dac i [pointCount:4]
    lac ieShTab         // the lines' point indices, unshifted
    dac wmX
    lac [cpFrom:5]
    dac wmA
    lac i [lineCount:4]
    add [lineFrom:3]
    dac wmB
    lac cpaL
    dac wmN
    lac i [copyBase:4]
    dac wmD
    jsp moveW
    lac [cpTo:5]
    dac wmA
    lac i [lineCount:4]
    add [lineTo:3]
    dac wmB
    lac cpaL
    dac wmN
    lac i [copyBase:4]
    dac wmD
    jsp moveW
    lac i [lineCount:4]
    add cpaL
    dac i [lineCount:4]
    lac i [copyArg:4]
    add [mNSub:5]
    dac cpaP
    lac i cpaP
    sza                 // skip unless the master holds sub-instances
    jsp copySubs
rtn, jmp .
cpaN, 0
cpaL, 0
cpaP, 0
cpaA, 0
cpaM, 0
    endloc

// Define's and Dismember's eleven entries, root stubs under the entries' names calling the
// overlay's (instMapOv to defineStoreOv) through the drum overlay manager, which reads defdism into
// W first if W holds another. ieTable calls them as it called the entries. AC
// comes back from the entry; instNestAt's and instDefNo's arguments stay in their words, where
// their entries read them. The overlay calls this bank's markClear, markOn, ieAbs, instSlot,
// instXY, instParam, instGate, ibVal, cyFrom, copyRoom, msAddr and masterBit, each of which
// returns across banks: a jsp by jsp i [X:7], a jda by dac i [X:7] and jsp i [X:7+1].
// An overlay cannot load a master's record, so the stubs whose entries read one load it first
// (mrLoad): instDef and instStore master dfK's, which instDefOv and defineStoreOv write, instDef
// then writing the name typed at Define to its picker's line; instDism and instNestAt the
// instance's master's, which dismAt reads, instDism first bringing the words of its
// sub-instances into the master store (subBring), COPYROOM when it has no room for them; and
// copySubs, from copyParts, finds copyArg's record resident. instNest checks each instance of
// the master being defined (masterArg) itself, after instNestOv's sums: the words of its
// sub-instances brought into the store (subBring, again for each instance, which brings none
// twice), DEFNROOM when it has no room for them, since Define's dismember adds an instance of
// each, the variants held from one sweep on (vaHold), so that one instance's bring keeps the
// last's; then its master's record loaded before instNestChkOv's dismAt. Nothing calls poolBring
// or vaFind from there to copySubs, so what was brought stays. instNestAt answers 1, nothing
// done, for an instance of another master, which Define keeps. instUndism brings the instance's
// words into the store (poolFor), which never refuses here: pbDrop keeps its master, and vaSweep
// its variant, while Undo would put the instance back.
// Entry and exit as the overlay's entries. Called via jsp, instNestAt and instDefNo via jda, from
// ieTable.
instMap,
    dac dsStubR
    %%ovcall defdism, instMapOv
    jmp i dsStubR
instDef,
    dac dsStubR
    lac i [dfK:2]
    jda mrLoad
    %%ovcall defdism, instDefOv
    dac dsAC
    lac i [dfK:2]       // the master defined takes the name typed at Define (dfNmOpen)
    jda mpkLine
    add [MPKTAG]
    dac nmTo
    lac [dfName:7]
    dac nmFrom
    jsp nmMove
    lac i [dfK:2]       // the masters holding it recomposed (the propagation's commit)
    dac i [rwK:2]
    law RWCOM
    dac i [rwOp:2]
    jsp rwRun
    lac dsAC
    jmp i dsStubR
instDism,
    dac dsStubR
    lac i [penInst:4]
    sad [NOPOINT]       // skip if an instance locks
    jmp dsDism
    dac i [subBring:014]
    jsp i [subBring:014+1]
    sza                 // skip if the store holds its sub-instances' words
    jmp dsRoom
    lac i [penInst:4]
    add [iMaster:012]
    dac dsT
    lac i dsT
    jda mrLoad
dsDism,
    %%ovcall defdism, instDismOv
    jmp i dsStubR
dsRoom,
    law COPYROOM
    jmp i dsStubR
copySubs,
    dac dsStubR
    %%ovcall defdism, copySubsOv
    jmp i dsStubR
instNest,
    dac dsStubR
    %%ovcall defdism, instNestOv
    sza                 // skip unless refused
    jmp i dsStubR
    jsp i [vaSweep:011]
    law 1
    dac i [vaHold:011]
    dzm dsJ
dsChk,
    lac dsJ
    sad i [instCount:012] // skip while instances remain
    jmp dsOk
    add [iMaster:012]
    dac dsT
    lac i dsT
    sas i [masterArg:4] // skip if an instance of the master being defined
    jmp dsChNx
    lac dsJ
    dac i [subBring:014]
    jsp i [subBring:014+1]
    sza                 // skip if the store holds its sub-instances' words
    jmp dsNoRm
    lac i [masterArg:4]
    jda mrLoad
    lio dsJ
    %%ovcall defdism, instNestChkOv
    sza                 // skip if the instance can be taken apart
    jmp dsUnh
dsChNx,
    idx dsJ
    jmp dsChk
dsNoRm,
    law DEFNROOM
    jmp dsUnh
dsOk,
    cla
dsUnh,
    dzm i [vaHold:011]
    jmp i dsStubR
instNestAt, 0
    dac dsStubR
    lac instNestAt
    add [iMaster:012]
    dac dsT
    lac i dsT
    sas i [masterArg:4] // skip if an instance of the master being defined
    jmp dsKept
    jda mrLoad
    %%ovcall defdism, instNestAtOv
    jmp i dsStubR
dsKept,
    law 1
    jmp i dsStubR
instUndism,
    dac dsStubR
    lio dismScale
    lac dismMaster
    jda poolFor
    %%ovcall defdism, instUndismOv
    jmp i dsStubR
instDefNo, 0
    dac dsStubR
    %%ovcall defdism, instDefNoOv
    jmp i dsStubR
instStore,
    dac dsStubR
    lac i [dfK:2]
    jda mrLoad
    %%ovcall defdism, instStoreOv
    jmp i dsStubR
instWords,
    dac dsStubR
    %%ovcall defdism, defineMasterOv
    sza                 // skip if the words pass
    jmp i dsStubR
    lac i [dfK:2]       // then the masters holding it (the propagation's trial)
    dac i [rwK:2]
    law RWDEF
    dac i [rwOp:2]
    jsp rwRun
    jmp i dsStubR
instWStore,
    dac dsStubR
    %%ovcall defdism, defineStoreOv
    jmp i dsStubR
dsStubR, 0
dsJ, 0
dsT, 0
dsAC, 0                 // instDef's answer, kept while the name is written

// The propagation (defdism's rewriteOv) run to its end, the requests it makes served, which an
// overlay cannot make: a master's record made resident (RQLOAD, mrLoad), a master brought into
// the store (RQBRING, poolBring, its answer into rwRes), a master's words put back at its place
// (RQPUT, poolAt), the instance list emptied with its tie lists kept (RQCLEAR, instReslot). The
// variants are held throughout (vaHold): Define's blocks read them after the trial, and a refused
// trial gives their instances back.
// Entry: rwOp (RWDEF, RWLIB or RWCOM), rwK. Exit: AC = 0, or the refusal (rwWho its master). IO
// is clobbered. Called via jsp, from this bank, or via jsp i.
rwRun,
    dac rrRtnW
    dzm i [rwSt:2]
    law 1
    dac i [vaHold:011]
rrLoop,
    %%ovcall defdism, rewriteOv
    sas [RQLOAD]        // skip if a record is asked for
    jmp rrBr
    lac i [rwArg:2]
    jda mrLoad
    jmp rrLoop
rrBr,
    sas [RQBRING]       // skip if a master is to be brought
    jmp rrPut
    lac i [rwArg:2]
    jda poolBring
    dac i [rwRes:2]
    jmp rrLoop
rrPut,
    sas [RQPUT]         // skip if a master's words go back
    jmp rrClr
    lac i [rwArg:2]
    jda poolAt
    jmp rrLoop
rrClr,
    sas [RQCLEAR]       // skip if the instances are to be emptied
    jmp rrEnd
    jsp instReslot
    jmp rrLoop
rrEnd,
    dzm i [vaHold:011]
    lio [SZNOSRC]       // a master changed: its instances' overall sizes may have; AC is the answer
    dio i [szDirty:3]
    jmp i rrRtnW
rrRtnW, 0

// Master k's record made resident in the window MW (bank 5): the overlay manager reads it from
// its track only if MW holds another master's, which it writes back to that one's track first
// (a persistent overlay). Its tables are then at cpX to mrWords (sketchpad.am1), master k's. The
// one load of a record; the root makes it, before any reader, since an overlay cannot.
// Entry: AC = k, 0 to NMASTER-1. AC is clobbered, IO preserved. Called via jda.
mrLoad, 0
    local rtn, mrGo, mrDone, mrTab, mrL0, mrL1, mrL2, mrL3, mrL4, mrL5, mrL6, mrL7, mrL8, \
        mrL9, mrL10, mrL11, mrL12, mrL13, mrL14, mrL15
    dap rtn
    lac mrLoad
    add [mrTab]
    dap mrGo
mrGo, jmp .
mrDone,
rtn, jmp .
mrTab,
    jmp mrL0
    jmp mrL1
    jmp mrL2
    jmp mrL3
    jmp mrL4
    jmp mrL5
    jmp mrL6
    jmp mrL7
    jmp mrL8
    jmp mrL9
    jmp mrL10
    jmp mrL11
    jmp mrL12
    jmp mrL13
    jmp mrL14
    jmp mrL15
mrL0,
    %%ovload mrec0, mrc0
    jmp mrDone
mrL1,
    %%ovload mrec1, mrc1
    jmp mrDone
mrL2,
    %%ovload mrec2, mrc2
    jmp mrDone
mrL3,
    %%ovload mrec3, mrc3
    jmp mrDone
mrL4,
    %%ovload mrec4, mrc4
    jmp mrDone
mrL5,
    %%ovload mrec5, mrc5
    jmp mrDone
mrL6,
    %%ovload mrec6, mrc6
    jmp mrDone
mrL7,
    %%ovload mrec7, mrc7
    jmp mrDone
mrL8,
    %%ovload mrec8, mrc8
    jmp mrDone
mrL9,
    %%ovload mrec9, mrc9
    jmp mrDone
mrL10,
    %%ovload mrec10, mrc10
    jmp mrDone
mrL11,
    %%ovload mrec11, mrc11
    jmp mrDone
mrL12,
    %%ovload mrec12, mrc12
    jmp mrDone
mrL13,
    %%ovload mrec13, mrc13
    jmp mrDone
mrL14,
    %%ovload mrec14, mrc14
    jmp mrDone
mrL15,
    %%ovload mrec15, mrc15
    jmp mrDone
    endloc

// mrLoad for the tape module's root stub tapeEntry in bank 11 (sptape.ac) and the library's,
// libEntry (splib.ac), returning across banks.
// Entry: IO = k. AC and IO are clobbered. Called via jsp i [mrLoadX:7].
mrLoadX,
    dac mxRtnW
    lai
    jda mrLoad
    jmp i mxRtnW
mxRtnW, 0

// The overlay defdism, in W: Define's map, its words (spdefword.ac), its room in the master store
// and its parts kept in Copy's store, with its constraints; Define's refusal word; a dismember,
// Define's taking apart
// of the instances on the canvas, and Undo of a dismember. It runs in bank 6, reaching this
// bank's words as OP i [X:7]; every word it keeps between calls is this bank's or bank 2's, so
// a load from the drum loses nothing.
%%overlay defdism, W
    export instMapOv, instDefOv, instDismOv, instNestOv, instNestAtOv, instUndismOv
    export instDefNoOv, instStoreOv, instNestChkOv, defineMasterOv, defineStoreOv, copySubsOv
    export rewriteOv

// Define's map, before defineMasterOv (spdefword.ac). Each point a line or an arc is on, a set
// of digits is anchored at, or an instance of another master is tied at, is one of the
// master's, its index among them plus 1 in ptMark, mpN of them, and every other point 0. Each
// such instance, which the master keeps as a sub-instance (the master's own were taken apart),
// fills a block in sbBlk, sbN of them, before the instances are emptied (instClear). The
// attachers among the master's
// points, taken in the order of their designation (the CTATT entries' parameters), go into attJ,
// their master indices, attN of them, and each one's cross into avX, avY and avV, four of
// defWalk's visits. They are a beam-off move to MARKARM left of it, a line to MARKARM right, a
// beam-off move to MARKARM below, a line to MARKARM above. Then the constraints among the
// master's points are counted (mcScan); Define is refused with more than NCPCON. Last, the order
// defWalk takes the lines in (dkChain).
// Refused first, nothing mapped, while an instance cycles, or with the masters' texts' table
// short of room for the canvas's (the text module's txDefRoom).
// Refused too, by DEFNROOM, for an instance with a code c whose variant a load left unbuilt.
// Exit: AC = 0, or DEFCONS with too many constraints, or DEFCYCLE, DEFNROOM or DEFTEXT.
// IO is clobbered. Called by the manager, from its stub (instMap).
instMapOv,
    local rtn, mpLn, mpArc0, mpArc, mpAn0, mpAn, mpAnNx, mpNum, mpNm, mpNmNx, mpAtt, mpPick, \
        mpScan, mpScNx, mpGot, mpTie0, mpTie, mpTieA, mpTieB, mpTieNx, mpSub0, mpSub, mpSbT, \
        mpTx, mpTxT, mpTxNx, mpTxEnd, \
        mpSbN, mpSbNx, mpDone, mpFew, mpCyc, mpSbA, mpNoV, mpI, mpT, mpU, mpE, mpEnd, mpLast, \
        mpBest, mpBP, \
        mpX, mpY, mpK, mpM, mpP, rtnW
    dac rtnW
    lac i [cycN:4]
    sza                 // skip unless an instance cycles
    jmp mpCyc

    // The derived texts, a copy of the texts of each instance's master for every instance of
    // another master, counted for txDefRoom.
    dzm i [txDrMore:012]
    dzm mpI
mpTx,
    lac mpI
    sad i [instCount:012] // skip while instances remain
    jmp mpTxEnd
    add [iMaster:012]
    dac mpT
    lac i mpT
    sad i [masterArg:4] // skip unless taken apart
    jmp mpTxNx
    dac mpM
    dzm mpK
mpTxT,
    lac mpK
    sad i [mtN:012]     // skip while the masters' texts remain
    jmp mpTxNx
    add [mtM:013]
    dac mpT
    lac i mpT
    sad mpM             // skip unless its master's
    idx i [txDrMore:012]
    idx mpK
    jmp mpTxT
mpTxNx,
    idx mpI
    jmp mpTx
mpTxEnd,
    jsp i [txDefRoom:012]
    sza                 // skip if the texts fit
    jmp rtn
    jsp i [markClear:7]
    dzm mpI
mpLn,
    lac mpI
    sad i [lineCount:4] // skip while lines remain
    jmp mpArc0
    add [lineFrom:3]
    dac mpT
    lac i mpT
    dac i [markOn:7]
    jsp i [markOn:7+1]
    lac mpI
    add [lineTo:3]
    dac mpT
    lac i mpT
    dac i [markOn:7]
    jsp i [markOn:7+1]
    idx mpI
    jmp mpLn
mpArc0,
    dzm mpI
mpArc,
    lac mpI
    sad i [arcCount:2]  // skip while arcs remain
    jmp mpAn0
    add [arcTC:2]
    dac mpT
    lac i mpT
    dac i [markOn:7]
    jsp i [markOn:7+1]
    lac mpI
    add [arcTS:2]
    dac mpT
    lac i mpT
    dac i [markOn:7]
    jsp i [markOn:7+1]
    lac mpI
    add [arcTE:2]
    dac mpT
    lac i mpT
    dac i [markOn:7]
    jsp i [markOn:7+1]
    idx mpI
    jmp mpArc

    // Each set of digits' anchor, on no line or arc, is a master point too, so that Define keeps
    // it with the digits, and their D's, Y's and O's with it.
mpAn0,
    dzm mpI
mpAn,
    lac mpI
    sad i [txN:012]     // skip while the canvas's texts remain
    jmp mpTie0
    add [txAn:3]
    dac mpT
    lac i mpT
    sad [NOPOINT]       // skip if digits
    jmp mpAnNx
    dac i [markOn:7]
    jsp i [markOn:7+1]
mpAnNx,
    idx mpI
    jmp mpAn

    // Each kept instance's tie points are master points too, so that its block's ties name them.
    // An instance of the master being defined, taken apart, is passed over.
mpTie0,
    dzm mpI
mpTie,
    lac mpI
    sad i [instCount:012] // skip while instances remain
    jmp mpNum
    add [iMaster:012]
    dac mpT
    lac i mpT
    sad i [masterArg:4] // skip unless taken apart
    jmp mpTieNx
    lac mpI
    add [iTie:3]
    dac mpT
    law i NATT
    dac mpK
mpTieA,
    lac i mpT
    sad [NOPOINT]       // skip if a tie point
    jmp mpTieB
    dac i [markOn:7]
    jsp i [markOn:7+1]
mpTieB,
    lac mpT
    add [MAXINST]
    dac mpT
    isp mpK             // skip once every tie is looked at
    jmp mpTieA
mpTieNx,
    idx mpI
    jmp mpTie

    // Each mark made the point's master index plus 1.
mpNum,
    dzm i [mpN:7]
    lac [ptMark:3]
    dac mpT
    add i [pointCount:4]
    dac mpEnd
mpNm,
    lac mpT
    sad mpEnd           // skip while points remain
    jmp mpSub0
    lac i mpT
    sza i               // skip if a master point
    jmp mpNmNx
    idx i [mpN:7]
    dac i mpT
mpNmNx,
    idx mpT
    jmp mpNm

    // Each kept instance's block for the composer and instDef (sbBlk, DBW words): its master,
    // origin and scale word, the words it calls in the store up to its crosses, its master's or
    // its variant's, which defWalk doubles by k, there while an instance calls them, and its ties
    // as master indices. instNest has refused more than NSUB.
mpSub0,
    dzm i [sbN:2]
    dzm mpI
    lac [sbBlk:2]
    dac mpP
mpSub,
    lac mpI
    sad i [instCount:012] // skip while instances remain
    jmp mpAtt
    add [iMaster:012]
    dac mpT
    lac i mpT
    sad i [masterArg:4] // skip unless taken apart
    jmp mpSbNx
    dac mpM
    dac i mpP           // DBM
    idx mpP
    idx i [sbN:2]
    lac mpI
    add [iX:3]
    dac mpT
    lac i mpT
    dac i mpP           // DBX
    idx mpP
    lac mpI
    add [iY:3]
    dac mpT
    lac i mpT
    dac i mpP           // DBY
    idx mpP
    lac mpI
    add [iScale:3]
    dac mpT
    lac i mpT
    dac i mpP           // DBS
    sar 2s
    dac mpK
    idx mpP
    lac mpI
    dac i [vaOf:011]
    jsp i [vaOf:011+1]
    sas [MNOPOOL]       // skip with no words to read
    jmp mpSbA
    lac mpK
    sza                 // skip unless a code c, whose words Define needs
    jmp mpNoV
    lac [MNOPOOL]
mpSbA,
    dac i [msAddr:7]
    jsp i [msAddr:7+1]
    dac i mpP           // DBA
    idx mpP
    lac mpM
    add [mDrawLen:5]
    dac mpT
    lac i mpT
    dac i mpP           // DBL
    idx mpP
    lac mpI
    add [iTie:3]
    dac mpT
    law i NATT
    dac mpK
mpSbT,
    lac i mpT
    sad [NOPOINT]       // skip if a tie point
    jmp mpSbN
    add [ptMark:3]
    dac mpU
    lac i mpU
    sub [1]
mpSbN,
    dac i mpP           // the ties, from DBT
    idx mpP
    lac mpT
    add [MAXINST]
    dac mpT
    isp mpK             // skip once every tie is kept
    jmp mpSbT
mpSbNx,
    idx mpI
    jmp mpSub

    // The attachers, each the master point designated next after the last taken.
mpAtt,
    dzm i [attN:7]
    dzm i [avN:7]
    lac [CUNUSED]       // before every designation's order
    dac mpLast
mpPick,
    lac i [attN:7]
    sad [NATT]          // skip while there is room for one more
    jmp mpDone
    lac [0777777]       // -0, after every designation's order
    dac mpBest
    lac [NOPOINT]
    dac mpBP
    lac [cEntries:011]
    dac mpE
mpScan,
    lac mpE
    sad i [cEnd:010]    // skip while entries remain
    jmp mpGot
    lac i mpE
    sas [CTATT]         // skip if an attacher
    jmp mpScNx
    lac mpE
    add [5]
    dac mpT
    lac i mpT
    sub mpLast
    sub [1]
    spa                 // skip if designated after the last taken
    jmp mpScNx
    lac mpBest
    sub i mpT
    sub [1]
    spa                 // skip if designated before the best so far
    jmp mpScNx
    lac mpE
    add [1]
    dac mpU
    lac i mpU
    add [ptMark:3]
    dac mpU
    lac i mpU
    sza i               // skip if a master point
    jmp mpScNx
    lac i mpT
    dac mpBest
    lac mpE
    add [1]
    dac mpU
    lac i mpU
    dac mpBP
mpScNx,
    lac mpE
    add [CW]
    dac mpE
    jmp mpScan
mpGot,
    lac mpBP
    sad [NOPOINT]       // skip if one was found
    jmp mpDone
    lac mpBest
    dac mpLast
    lac mpBP
    add [ptMark:3]
    dac mpT
    lac i mpT
    sub [1]
    dac mpU
    lac i [attN:7]
    add [attJ:7]
    dac mpT
    lac mpU
    dac i mpT
    idx i [attN:7]
    lac mpBP
    add [pointX:3]
    dac mpT
    lac i mpT
    dac mpX
    lac mpBP
    add [pointY:3]
    dac mpT
    lac i mpT
    dac mpY
    dzm i [mpV:7]
    lac mpX
    sub [MARKARM]
    lio mpY
    jda mpVisit
    lac [visible]
    dac i [mpV:7]
    lac mpX
    add [MARKARM]
    lio mpY
    jda mpVisit
    dzm i [mpV:7]
    lac mpY
    sub [MARKARM]
    lia
    lac mpX
    jda mpVisit
    lac [visible]
    dac i [mpV:7]
    lac mpY
    add [MARKARM]
    lia
    lac mpX
    jda mpVisit
    jmp mpPick
mpDone,
    dzm i [mcKeep:7]
    jsp mcScan
    sub [NCPCON+1]
    spa                 // skip if more than NCPCON
    jmp mpFew
    law DEFCONS
    jmp rtn
mpCyc,
    law DEFCYCLE
    jmp rtn
mpNoV,
    law DEFNROOM
    jmp rtn
mpFew,
    jsp dkChain
    cla
rtn, jmp i rtnW
rtnW, 0
mpI, 0
mpT, 0
mpU, 0
mpE, 0
mpEnd, 0
mpLast, 0
mpBest, 0
mpBP, 0
mpX, 0
mpY, 0
mpK, 0
mpM, 0
mpP, 0
    endloc

// One of defWalk's visits for a cross, x, y and mpV, its beam, appended to avX, avY and avV.
// Entry: AC = x, IO = y; mpV. AC is clobbered, IO preserved. Called via jda.
mpVisit, 0
    local rtn, mvT
    dap rtn
    lac i [avN:7]
    add [avX:7]
    dac mvT
    lac mpVisit
    dac i mvT
    lac i [avN:7]
    add [avY:7]
    dac mvT
    dio i mvT
    lac i [avN:7]
    add [avV:7]
    dac mvT
    lac i [mpV:7]
    dac i mvT
    idx i [avN:7]
rtn, jmp .
mvT, 0
    endloc

// The order defWalk takes the lines in, so that Define joins them where it can: dfOrd's first
// lineCount entries, each a line index, 0400000 set for a line drawn from its to end. Taken
// greedily, the beam starting at the center of the box of the lines' ends: the next line is the
// first one left, in dfOrd's order, with an end at the beam's point, the from end tried first;
// else the first with an end nearest the beam, by the larger of its distances on the two axes,
// the from end tried first again. A line taken leaves the beam at its far end, but one of no
// length, which defWalk passes over, leaves it where it was. Each line taken is swapped into
// the next place in dfOrd, so the lines left keep the places they had. Nothing is done past
// CPLINES lines, which Define refuses before it walks them.
// AC and IO are clobbered. Called via jsp.
dkChain,
    local rtn, dkId, dkStep, dkIdx, dkNear, dkNrB, dkNrNx, dkFwd, dkRev, dkPick, dkFar, \
        dkMove, dkNext, dkS, dkP, dkBP, dkBRv, dkD, dkJ, dkA, dkB, dkNX, dkNY, dkCur
    dap rtn
    lac i [lineCount:4]
    dac dkN
    sza i               // skip if there are lines
    jmp rtn
    sub [CPLINES+1]
    sma                 // skip if CPLINES or fewer
    jmp rtn

    // Every line in its own place, and the box of their ends.
    lac [01777]
    dac dkMnX
    dac dkMnY
    dzm dkMxX
    dzm dkMxY
    dzm dkS
dkId,
    lac dkS
    add [dfOrd:2]
    dac dkT
    lac dkS
    dac i dkT
    add [lineFrom:3]
    dac dkT
    lac i dkT
    jda dkBoxPt
    lac dkS
    add [lineTo:3]
    dac dkT
    lac i dkT
    jda dkBoxPt
    idx dkS
    sas dkN             // skip once every line is in
    jmp dkId
    lac dkMnX
    add dkMxX
    sar 1s
    dac dkBX
    lac dkMnY
    add dkMxY
    sar 1s
    dac dkBY
    lac [NOPOINT]
    dac dkCur
    dzm dkS

dkStep,
    lac dkS
    sad dkN             // skip while lines are left
    jmp rtn

    // The first line left with an end at the beam's point.
    lac dkS
    dac dkP
dkIdx,
    lac dkP
    add [dfOrd:2]
    dac dkT
    lac i dkT
    dac dkJ
    add [lineFrom:3]
    dac dkT
    lac i dkT
    sad dkCur           // skip unless its from end is at the beam's point
    jmp dkFwd
    lac dkJ
    add [lineTo:3]
    dac dkT
    lac i dkT
    sad dkCur           // skip unless its to end is
    jmp dkRev
    idx dkP
    sas dkN             // skip once every line left is tried
    jmp dkIdx

    // Else the first with an end nearest the beam.
    lac [0377777]
    dac dkBest
    lac dkS
    dac dkP
dkNear,
    lac dkP
    add [dfOrd:2]
    dac dkT
    lac i dkT
    dac dkJ
    add [lineFrom:3]
    dac dkT
    lac i dkT
    jda dkDist
    dac dkD
    sub dkBest
    sma                 // skip if nearer than the best so far
    jmp dkNrB
    lac dkD
    dac dkBest
    lac dkP
    dac dkBP
    dzm dkBRv
    lac dkD
    sza i               // skip unless at the beam
    jmp dkPick
dkNrB,
    lac dkJ
    add [lineTo:3]
    dac dkT
    lac i dkT
    jda dkDist
    dac dkD
    sub dkBest
    sma                 // skip if nearer than the best so far
    jmp dkNrNx
    lac dkD
    dac dkBest
    lac dkP
    dac dkBP
    lac [0400000]
    dac dkBRv
    lac dkD
    sza i               // skip unless at the beam
    jmp dkPick
dkNrNx,
    idx dkP
    sas dkN             // skip once every line left is tried
    jmp dkNear
    jmp dkPick
dkFwd,
    lac dkP
    dac dkBP
    dzm dkBRv
    jmp dkPick
dkRev,
    lac dkP
    dac dkBP
    lac [0400000]
    dac dkBRv

    // The line at dkBP swapped into place dkS, its direction with it; then the beam to its far
    // end, unless it has no length.
dkPick,
    lac dkBP
    add [dfOrd:2]
    dac dkT
    lac i dkT
    dac dkJ
    lac dkS
    add [dfOrd:2]
    dac dkA
    lac i dkA
    dac i dkT
    lac dkJ
    ior dkBRv
    dac i dkA
    lac dkJ
    add [lineFrom:3]
    dac dkT
    lac i dkT
    dac dkA
    lac dkJ
    add [lineTo:3]
    dac dkT
    lac i dkT
    dac dkB
    lac dkBRv
    sza i               // skip if drawn from its to end
    jmp dkFar
    lac dkA
    lio dkB
    dac dkB
    dio dkA
dkFar,
    lac dkA
    jda dkXY
    lac dkX
    dac dkNX
    lac dkY
    dac dkNY
    lac dkB
    jda dkXY
    lac dkX
    sas dkNX            // skip if the x are the same
    jmp dkMove
    lac dkY
    sad dkNY            // skip unless the y are the same too (no length)
    jmp dkNext
dkMove,
    lac dkX
    dac dkBX
    lac dkY
    dac dkBY
    lac dkB
    dac dkCur
dkNext,
    idx dkS
    jmp dkStep
rtn, jmp .
dkS, 0
dkP, 0
dkBP, 0
dkBRv, 0
dkD, 0
dkJ, 0
dkA, 0
dkB, 0
dkNX, 0
dkNY, 0
dkCur, 0
    endloc

// Point p's coordinates into dkX and dkY.
// Entry: AC = p. AC is clobbered, IO preserved. Called via jda.
dkXY, 0
    local rtn, dxT
    dap rtn
    lac dkXY
    add [pointX:3]
    dac dxT
    lac i dxT
    dac dkX
    lac dkXY
    add [pointY:3]
    dac dxT
    lac i dxT
    dac dkY
rtn, jmp .
dxT, 0
    endloc

// Point p taken into dkChain's box of the lines' ends.
// Entry: AC = p. AC is clobbered, IO preserved. Called via jda.
dkBoxPt, 0
    local rtn, dbMaxX, dbMinY, dbMaxY
    dap rtn
    lac dkBoxPt
    jda dkXY
    lac dkX
    sub dkMnX
    sma                 // skip if left of the box
    jmp dbMaxX
    lac dkX
    dac dkMnX
dbMaxX,
    lac dkMxX
    sub dkX
    sma                 // skip if right of the box
    jmp dbMinY
    lac dkX
    dac dkMxX
dbMinY,
    lac dkY
    sub dkMnY
    sma                 // skip if below the box
    jmp dbMaxY
    lac dkY
    dac dkMnY
dbMaxY,
    lac dkMxY
    sub dkY
    sma                 // skip if above the box
    jmp rtn
    lac dkY
    dac dkMxY
rtn, jmp .
    endloc

// Point p's distance from the beam (dkBX, dkBY), the larger of its distances on the two axes,
// when that is under dkBest; else dkBest or more, the y not read when the x is already that far.
// Entry: AC = p. Exit: AC = the distance. IO is preserved. Called via jda.
dkDist, 0
    local rtn, ddX, ddFar, ddDX, ddDY, ddT
    dap rtn
    lac dkDist
    add [pointX:3]
    dac ddT
    lac i ddT
    sub dkBX
    spa                 // skip unless left of the beam
    cma
    dac ddDX
    sub dkBest
    sma                 // skip if nearer on x than the best so far
    jmp ddFar
    lac dkDist
    add [pointY:3]
    dac ddT
    lac i ddT
    sub dkBY
    spa                 // skip unless below the beam
    cma
    dac ddDY
    sub ddDX
    spa                 // skip if the y's distance is the x's or more
    jmp ddX
    lac ddDY
    jmp rtn
ddX,
    lac ddDX
    jmp rtn
ddFar,
    lac dkBest
rtn, jmp .
ddDX, 0
ddDY, 0
ddT, 0
    endloc

// dkChain's words, shared with its three subroutines: the lines, the box of their ends, the
// beam, a point's coordinates, the nearest distance so far and a pointer.
dkN, 0
dkMnX, 0
dkMxX, 0
dkMnY, 0
dkMxY, 0
dkBX, 0
dkBY, 0
dkX, 0
dkY, 0
dkBest, 0
dkT, 0

// Define, once defineMasterOv has made master dfK (defParts before it, in bank 2). The master's
// points, ptMark's map (instMap), are kept in Copy's store relative to the origin (dfCX, dfCY),
// in the map's order, and its lines and arcs with their point indices mapped; then the counts;
// the copy box, the figure's box (dfMinX to dfMaxY) widened to take in every master point, an
// arc's center among them, relative to the origin, by which a copy's origin is held on the
// canvas (instAt); the attachers, attJ; the sub-instances, Define's blocks (sbBlk), with mNSub
// and mUses; and the constraints among its points (mcScan). Then on
// the canvas every point but the instances' tie points goes, the tie points closing up in order,
// the tie lists following; the caller empties the lines and arcs. The canvas's texts go into the
// master first, the canvas left with none (the text module's txDefine).
// Exit: AC = the points left, the tie points. IO is clobbered. Called by the manager, from its
// stub (instDef).
instDefOv,
    local rtn, dqPt, dqXlo, dqXok, dqYlo, dqYok, dqPtNx, dqLines, dqLn, dqArcs, dqTab, dqArc, \
        dqArcW0, dqArcW, dqTabNx, dqAtt, dqAttW, dqSub0, dqSb, dqSbT, dqMark, dqMk, dqMkNx, \
        dqKeep, dqKpNx, dqRen0, dqRen, dqRnNx, dqI, dqJ, dqT, dqU, dqA, dqX0, dqX1, dqY0, dqY1, \
        rtnW
    dac rtnW
    jsp i [txDefine:012]
    lac i [dfK:2]
    dac dqK
    lac i [dfMinX:2]
    dac dqX0
    lac i [dfMaxX:2]
    dac dqX1
    lac i [dfMinY:2]
    dac dqY0
    lac i [dfMaxY:2]
    dac dqY1

    // The points, and the copy box.
    dzm dqI
dqPt,
    lac dqI
    sad i [pointCount:4] // skip while points remain
    jmp dqLines
    add [ptMark:3]
    dac dqT
    lac i dqT
    sza i               // skip if a master point
    jmp dqPtNx
    sub [1]
    dac dqJ             // its word in the record's points
    lac dqI
    add [pointX:3]
    dac dqT
    lac i dqT
    dac dqV
    sub dqX0
    spa                 // skip unless left of the box
    jmp dqXlo
    lac dqX1
    sub dqV
    sma                 // skip if right of the box
    jmp dqXok
    lac dqV
    dac dqX1
    jmp dqXok
dqXlo,
    lac dqV
    dac dqX0
dqXok,
    lac dqJ
    add [cpX:5]
    dac dqT
    lac dqV
    sub i [dfCX:2]
    dac i dqT
    lac dqI
    add [pointY:3]
    dac dqT
    lac i dqT
    dac dqV
    sub dqY0
    spa                 // skip unless below the box
    jmp dqYlo
    lac dqY1
    sub dqV
    sma                 // skip if above the box
    jmp dqYok
    lac dqV
    dac dqY1
    jmp dqYok
dqYlo,
    lac dqV
    dac dqY0
dqYok,
    lac dqJ
    add [cpY:5]
    dac dqT
    lac dqV
    sub i [dfCY:2]
    dac i dqT
dqPtNx,
