nmFrom, 0
nmTo, 0

// Define's master picked (instKbDone): the text keyboard's block for its name. Its prompt is the
// master's label and "name"; its buffer dfName starts as the master's name, blank for a slot
// not defined, and holds the name typed at OK, which instDef writes to the master's line once
// Define succeeds. The keyboard's resume is the main bank's actDefine, which still finds the
// master in kbPick, since only a picker's line writes it.
// Entry: AC = the master. Exit: AC = the block's 16-bit address. IO is clobbered. Called via jda.
dfNmOpen, 0
    local rtn, dnMove, dnL
    dap rtn
    lac dfNmOpen
    jda mpkLine
    dac dnL
    add [MPKTAG]
    dac nmFrom
    lac dfNmOpen
    add [mLen:5]
    dac nmTo
    lac i nmTo
    sza                 // skip unless the master is defined
    jmp dnMove
    lac [mpkBlank:7]
    dac nmFrom
