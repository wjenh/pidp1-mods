// splib.ac -- the library of masters: a master saved to the tape as an entry of its own, an
// entry loaded into a master, a page of the tape's directory for the library's screen, and an
// entry deleted, on the Type 550 Microtape on the drive in use.
//
// Bank 11, after the tape module. The root part first: the words the library keeps between
// calls, which its callers set. Then the overlay library, read into the window W, in bank 6,
// from the drum when it is called (Docs/UsingOverlays.md): the save, the load, Dir and Delete,
// their helpers, and the words used within one call; it reaches the root's words, and the
// entry buffer in bank 14, through their 16-bit addresses, and the tape through the tape module's
// primitives in this bank's root (sptape.ac, tpMount to tpReadR). Then the root stub libEntry,
// to which the tape module's stub tapeEntry passes the library's entries, so that the main
// bank's tapeCall runs them as it runs the tape's. Last libStep, the steps of Library's rows,
// to which the tape module's tapeStep passes them. The module runs with the extend window open
// throughout, so every indirect address is a 16-bit one, and calls nothing outside W and bank 11
// but the instance module's mFlat, from the load, its mrLoadX, masterBit, mDrawOf, poolRoom,
// msAddr and rwRun, from the stub, and its entry instEntry, from libStep (bank 7).
// Part of sketchpad.am1, included where it stands.
//
// An entry (sketchpad.ah, the library's constants) is one master: the header, the master's
// words held outside its record among them, then its texts, then its record's tables, from a
// block's first word, the rest of its last block zeros. A master holding sub-instances is saved
// as a nested entry: a header of its own, then a part for it and for each master it calls at
// any depth, each laid out as a flat entry and followed by its nesting and its sub-instances. A
// save gathers it all into the entry buffer, lbEBuf, and writes it in one pass; a load reads it
// whole into lbEBuf, checking every block's sum, and judges every header before anything
// changes, so a load that fails leaves the masters as they were. lbEBuf is the start of banks 14
// and 15, which the truss's direct solve uses between main-loop passes (sketchpad.am1), so a
// save or a load starts the truss's analysis again (taReset) before it writes there; Dir and
// Delete leave it alone. Its tables are copied one table at a time, in and out of lbEBuf, since
// the word loops cannot keep up with short runs in a row. A master's record is made resident by
// the stub, before the overlay runs, since an overlay cannot make it so (spinst.ac, mrLoad): so
// a nested entry's save or load copies one part's record at a call and returns TSMORE with tpK
// the next part's master, and the stub makes its record resident and calls again with TELMORE.
// What it keeps across those calls is in lbEBuf's header (LBECUR to LBEOP), since nothing runs
// between them but the stub. Every refusal of a nested entry comes in its first call, before any
// record but the master's is touched.
// A master loaded leaves the master store (mStart MNOPOOL), its old words there stale; its
// caller loads only a master the drawing does not call. Its old texts leave the masters' texts'
// table, the others closing up in order, and the entry's go in after the last, as Define's do
// (sptext.ac, txDefine). A nested entry's other parts each take an empty master, in their order
// among the masters (ruling L2: never one matched by name), and its sub-instances name those
// masters (SBM, mUses).
//
// The tape's directory (sketchpad.ah, the library's directory): the header in block LBDIRBLK,
// where a picture tape keeps its directory, so that each kind of tape refuses the other's
// commands (NOT LIB here, NOT PICT in sptape.ac's tpRdDir), then the pages. An entry is named by
// its slot, its page's and its place's in it. A save takes the first free slot and the first
// run of free blocks long enough in the map, and writes its entry, then the header, then the
// page; a delete writes the page, then the header; so one cut short between the two leaves
// blocks taken that no entry names, never an entry whose blocks another save may take. A blank
// tape, its directory's block all zeros, reads as an empty library, which the first save writes;
// another program's tape is refused, NOT BLANK, by every command (lbRdHdr), when its directory's
// block holds any word.

// The library's words kept between calls.
lbK, 0                  // the master saved, or loaded into
lbSlot, 0               // the entry's slot, 0 to LBSLOTS - 1: a save sets it, a load or delete is
                        // given it
lbPage, 0               // the page Dir shows, which it brings back to the last with an entry
lbBlk, 0                // the entry's first block, from its slot's word or the map
lbBlkN, 0               // the entry's blocks
lbName,                 // the name a save writes, a name's run (NAMEW words)
    table NAMEW - 1, KBPAD
    KBBLANK
lbPhase, 0              // a load's call, LBPONE to LBPSHOW (libEntry)
lbRes, 0                // the refusal LBPSHOW shows, a holder of the master (rwWho) named
lbEAt, 0                // lbEBuf's 16-bit address, which a load's first call gives at TSHELD

// The overlay library: an entry's save and load, Dir and Delete (libEntryOv), with every word
// they use within one call, read again from the drum at each load.
%%overlay library, W
    export libEntryOv

// Run entry n, TELSAVE to TELDEL, on drive tapeDrive: a save of master lbK, its record resident;
// a load of slot lbSlot's entry into master lbK, its record resident; Dir, page lbPage; a delete
// of slot lbSlot's entry; or TELMORE, a nested entry's save or load going on with its next part,
// the drive already selected, that part's master's record resident. As the tape's entries
// (sptape.ac, tapeEntryOv): the break system is
// turned off first and the display set to WAIT (waitList), off the frame; the tape is stopped at
// the end, whatever happened; and the status word's text and the name's line under it are
// written for the result. A load's call that only shows a refusal (lbPhase LBPSHOW, libEntry)
// writes them for lbRes, a holder's name on the line, and does nothing else.
// Entry: IO = n; AC = the return address, which carries the main bank. Exit: AC = the result,
// TSSAVED, TSLLOADED, TSOPEN, TSDELETED, TSHELD, or a refusal or failure, TSNOTAPE to TSFULL,
// TSSLOW to TSOTHER or TSSLOTS; the window open, the display showing WAIT and the break system
// off; or TSMORE, for master tpK's record, teArg TELMORE and no word set for the status. IO is
// clobbered.
// Called through the root stub libEntry, by the manager.
libEntryOv,
    local leRtn, leSel, leRes, leGo, leJmp, leTab, leStop, leNm0, leNm1, leNm2, leNm3, leNmH
    addlocal leMore, leMS
    dac leRtn
    dio leSel
    lsm
    lio [waitList:1]
    dla
    lac i [lbPhase:013]
    sas [LBPSHOW]       // skip if only a holder's refusal is shown
    jmp leGo
    lac i [lbRes:013]
    jmp leStop
leGo,
    lac i [lbK:013]
    dac lbMk
    lac leSel
    sad [TELMORE]       // skip unless a nested entry's next part, the drive selected
    jmp leMore
    jsp i [tpMount:013]
    sza                 // skip if the drive has a tape
    jmp leStop
    lac leSel
    sub [TELSAVE]
    add [leTab]
    dap leJmp
leJmp, jsp .            // the entry's routine, by a jump table, returns here
    jmp leStop
leTab,
    jmp lbSave          // TELSAVE
    jmp lbLoad          // TELLOAD
    jmp lbShow          // TELDIR
    jmp lbDel           // TELDEL
leMore,
    lac i [lbEBuf:016 + LBEOP]
    sad [TELSAVE]       // skip unless a save's
    jmp leMS
    jsp lbLdMore
    jmp leStop
leMS,
    jsp lbSvMore
leStop,
    dac leRes
    cli
    mlc                 // stop, since a moving tape runs off its reel
    lac leRes
    sad [TSMORE]        // skip unless the stub is to make a record resident
    jmp i leRtn

    // The status word's text for the result, while the display shows WAIT.
    lac leRes
    sal 2s
    add [lbMsgs:6]
    dac lbFrom
    lac [msgText:0]
    dac lbTo
    law 4
    jda lbMove

    // And the name's line under it: the name saved, or the entry's loaded, which lbLoad leaves
    // in the header's place in lbEBuf, or deleted, which lbDel leaves in lbTmp, or a holder's
    // for its refusal of a load, blank otherwise.
    lac i [lbPhase:013]
    sad [LBPSHOW]       // skip unless a holder's refusal
    jmp leNmH
    lac leRes
    sas [TSSAVED]       // skip if saved
    jmp leNm1
    lac [lbName:013]
    jmp leNm3
leNm1,
    sas [TSLLOADED]     // skip if loaded
    jmp leNm0
    lac [lbEBuf:016 + LBHNAME]
    jmp leNm3
leNm0,
    sas [TSDELETED]     // skip if deleted
    jmp leNm2
    lac [lbTmp:6]
    jmp leNm3
leNm2,
    lac [lbBlank:6]
    jmp leNm3
leNmH,
    lac i [rwWho:2]     // a holder's refusal: the holder's name, on its picker's line
    add [mpkBlkT:013 + 1]
    dac lbT
    lac i lbT
    add [MPKTAG]
leNm3,
    dac lbFrom
    lac [msgName:0]
    dac lbTo
    law NAMEW
    jda lbMove
    lac leRes
    jmp i leRtn
leRtn, 0
leSel, 0
leRes, 0
    endloc

// Save master lbMk as a new entry: refused, EMPTY, when it has no words, TOO BIG when its entry
// would take more blocks than the buffer holds, and TAPE FULL when no slot is free or no run of
// free blocks is long enough, before anything is written. A master holding sub-instances
// (mNSub) is saved as a nested entry, with every master it calls at any depth (lbSet). Each
// part's header, texts and nesting go into lbEBuf first, from the root's words (lbPartHd), and
// give the entry's size; then the directory's header read (lbRdHdr), the first free slot found
// (lbRoom) and the first run of blocks long enough (lbFit), lbBlk; then each part's record's
// tables, the master's first, here, and each other part's in a call of its own (lbSvMore),
// once the stub has made its master's record resident; then, after the last part, the run list
// (lbList), all before the seek to the entry's first block, since the seek leaves 400 us to
// start the transfer; then its blocks written, and the entry put into the directory (lbEnter),
// lbSlot its slot. lbBlkN is its blocks. A blank directory's tape is taken as blank: the blocks
// the save writes are not read first, since reading them, and blocks 0 and 1 where other
// programs start, costs about 35 s; the user guide warns instead.
// Exit: AC = TSSAVED, TSEMPTY, TSTOOBIG, TSFULL, TSMORE for the next part's record, or
// lbRdHdr's, lbRoom's, a transfer's failure. IO is clobbered. Called via jsp; lbSvMore, the next
// part's call, the same.
lbSave,
    local rtn, lsGo, lsLay, lsLay1, lsNm, lsNmK, lsSized, lsDir, lsFit, lsHd, lsPart, lsP0, lsP1
    addlocal lsLast, lsZero, lsTape, lsW, lsK
    dap rtn
    lac lbMk
    add [mLen:5]
    dac lbT
    lac i lbT
    sza                 // skip if the master has no words
    jmp lsGo
    lac [TSEMPTY]
    jmp rtn
lsGo,
    law 1               // the truss starts again, since lbEBuf is its scratch
    dac i [taReset:013]
    lac [lbEBuf:016]
    dac lbE
    dzm lbNest
    lac lbMk
    add [mNSub:5]
    dac lbT
    lac i lbT
    sza i               // skip if the master holds sub-instances, a nested entry
    jmp lsLay
    law 1
    dac lbNest
    jsp lbSet
    lac [lbEBuf:016 + LBEHW]
    dac lbE

    // Each part's header, texts and nesting, the first part's name the one typed, the others
    // their masters'; lbE left past the last.
lsLay,
    dzm lsK
lsLay1,
    lac lbNest
    sza i               // skip if a nested entry
    jmp lsNm
    lac lsK
    add [lbEBuf:016 + LBESRC]
    dac lbT
    lac i lbT
    dac lbMk
    lac lsK
    sza                 // skip if the first part
    jmp lsNmK
lsNm,
    lac [lbName:013]
    jmp lsHd
lsNmK,
    lac lbMk
    add [mpkBlkT:013 + 1]
    dac lbT
    lac i lbT
    add [MPKTAG]
lsHd,
    dac lbFrom
    jsp lbPartHd
    add lbE
    dac lbE
    lac lbNest
    sza i               // skip if a nested entry
    jmp lsSized
    idx lsK
    sas i [lbEBuf:016 + LBENP] // skip once every part is laid out
    jmp lsLay1
lsSized,
    lac lbE
    sub [lbEBuf:016]
    dac lsW             // the entry's words
    add [0377]
    sar 8s
    dac lbEN            // its blocks
    sub [LBBLKS+1]
    spa                 // skip unless the buffer holds them
    jmp lsDir
    lac [TSTOOBIG]
    jmp rtn
lsDir,
    jsp lbRdHdr
    sza                 // skip if the directory's header was read
    jmp rtn
    jsp lbRoom
    sza                 // skip if a slot is free
    jmp rtn
    jsp lbFit
    sza                 // skip unless no run of blocks is long enough
    jmp lsFit
    lac [TSFULL]
    jmp rtn
lsFit,
    dac i [lbBlk:013]
    lac lbNest
    sza i               // skip if a nested entry, which has a header of its own
    jmp lsPart

    // A nested entry's header, and what the next calls keep, the part in hand the first.
    lac [LBMAGIC]
    dac i [lbEBuf:016]
    law LBFORMAT2
    dac i [lbEBuf:016 + 1]
    lac lsW
    dac i [lbEBuf:016 + LBHWORDS]
    rck
    dio i [lbEBuf:016 + 3] // the generation
    lac [lbName:013]
    dac lbFrom
    lac [lbEBuf:016 + LBHNAME]
    dac lbTo
    law NAMEW
    jda lbMove
    lac lbPg
    dac i [lbEBuf:016 + LBEPG]
    lac lbSl
    dac i [lbEBuf:016 + LBESL]
    law TELSAVE
    dac i [lbEBuf:016 + LBEOP]
    dzm i [lbEBuf:016 + LBECUR]
    jmp lsPart

    // The next part, its master's record resident: a nested entry's.
lbSvMore,
    dap rtn
    law 1
    dac lbNest

    // The part in hand's record's tables (lbRec), the master's record resident; then the next
    // part's call, or the tape.
lsPart,
    lac lbNest
    sza i               // skip if a nested entry
    jmp lsP0
    lac i [lbEBuf:016 + LBECUR]
    jda lbPart
    lac i [lbEBuf:016 + LBECUR]
    add [lbEBuf:016 + LBESRC]
    dac lbT
    lac i lbT
    dac lbMk
    jmp lsP1
lsP0,
    lac [lbEBuf:016]
    dac lbE
    lac i [lbK:013]
    dac lbMk
lsP1,
    dzm lbDir
    jsp lbRec
    lac lbNest
    sza i               // skip if a nested entry
    jmp lsTape
    idx i [lbEBuf:016 + LBECUR]
    sad i [lbEBuf:016 + LBENP] // skip unless every part is in
    jmp lsLast
    add [lbEBuf:016 + LBESRC]
    dac lbT
    lac i lbT
    dac i [tpK:013]
    law TELMORE
    dac i [teArg:013]
    lac [TSMORE]
    jmp rtn

    // The last part in: the directory's page and slot back, as lbRoom left them in lbDPage, the
    // words kept across the calls zeros on the tape, and the entry's size from its header.
lsLast,
    lac i [lbEBuf:016 + LBEPG]
    dac lbPg
    lac i [lbEBuf:016 + LBESL]
    dac lbSl
    jda lbEnt
    dac lbSE
    lac [lbEBuf:016 + LBEMAP]
    dac lbT
    law i LBEHW - LBEMAP
    dac lsK
lsZero,
    dzm i lbT
    idx lbT
    isp lsK             // skip once every word is zero
    jmp lsZero
    lac i [lbEBuf:016 + LBHWORDS]
    dac lsW
    add [0377]
    sar 8s
    dac lbEN

    // The tape: the entry's words, then zeros to its last block's end; then the directory.
lsTape,
    lac lbEN
    dac lbNB
    lac [lbEBuf:016]
    dac lbFirst
    lac [lbZero:6]
    dac lbPad
    lac lsW
    jda lbList
    lac i [lbBlk:013]
    dac i [tpWant:013]
    dzm i [tpRev:013]
    lac lbNB
    dac i [lbBlkN:013]
    cma
    dac i [tpBlk:013]
    lac [lbTpL:6]
    dac i [tpList:013]
    jsp i [tpSeek:013]
    sza                 // skip if at the entry's first block
    jmp rtn
    jsp i [tpWrite:013]
    sza                 // skip if written
    jmp rtn
    jsp lbEnter
rtn, jmp .
lsW, 0
lsK, 0
    endloc

// The parts of master lbMk's nested entry: the master, then each master it calls at any depth,
// in their order among the masters, into lbEBuf's header (LBESRC), their count LBENP. Its
// masters, stR, are found as mCalled's are, the other way: its bit, then the masters each one
// in it holds (mUses), until a pass adds none.
// AC and IO are clobbered. Called via jsp.
lbSet,
    local rtn, stPass, stJ1, stJn, stL, stLn, stR, stX, stJ, stB, stN
    dap rtn
    lac lbMk
    dac i [masterBit:7]
    jsp i [masterBit:7+1]
    dac stR
stPass,
    lac stR
    dac stX
    dzm stJ
    law 1
    dac stB             // master j's bit, M1's first
stJ1,
    lac stR
    and stB
    sza i               // skip if master j is among them
    jmp stJn
    lac stJ
    add [mUses:5]
    dac lbT
    lac i lbT
    ior stR
    dac stR
stJn,
    lac stB
    ral 1s
    dac stB
    idx stJ
    sas [NMASTER]       // skip once every master is looked at
    jmp stJ1
    lac stR
    sas stX             // skip if the pass added none
    jmp stPass

    // The list, the master first.
    lac lbMk
    dac i [lbEBuf:016 + LBESRC]
    law 1
    dac stN
    dzm stJ
    law 1
    dac stB
stL,
    lac stR
    and stB
    sza i               // skip if master j is among them
    jmp stLn
    lac stJ
    sad lbMk            // skip unless the master itself, already first
    jmp stLn
    lac stN
    add [lbEBuf:016 + LBESRC]
    dac lbT
    lac stJ
    dac i lbT
    idx stN
stLn,
    lac stB
    ral 1s
    dac stB
    idx stJ
    sas [NMASTER]       // skip once every master is looked at
    jmp stL
    lac stN
    dac i [lbEBuf:016 + LBENP]
rtn, jmp .
stR, 0
stX, 0
stJ, 0
stB, 0
stN, 0
    endloc

// Part lbE's header for master lbMk, the name's run at lbFrom: the magic, the format, the
// generation and the name; its words held outside its record (lbHead) and its texts' count;
// its texts after the header; and for a nested entry's part (lbNest), its nesting after its
// tables' place, mNSub to mTxOwn. Its words go into its header (LBHWORDS): a flat entry's, from
// its counts (lbSize), and a part's, its nesting and its sub-instances' too, which lbRec copies
// with the tables.
// Exit: AC = the part's words. IO is clobbered. Called via jsp.
lbPartHd,
    local rtn, phNext, phSkip, phEnd, phOut, phI, phW
    dap rtn
    law LBHNAME
    jda lbHA
    dac lbTo
    law NAMEW
    jda lbMove
    lac [LBMAGIC]
    dac i lbE
    law 1
    jda lbHA
    dac lbT
    law LBFORMAT
    dac i lbT
    law 3
    jda lbHA
    dac lbT
    rck
    dio i lbT           // the generation
    dzm lbDir
    jsp lbHead
    jsp lbCount
    dac phW
    law LBHNTX
    jda lbHA
    dac lbT
    lac phW
    dac i lbT

    // Its texts, in their order in the masters' texts' table.
    law LBHDRW
    jda lbHA
    dac lbB
    dzm phI
phNext,
    lac phI
    sad i [mtN:012]     // skip while the masters' texts remain
    jmp phEnd
    add [mtM:013]
    dac lbT
    lac i lbT
    sas lbMk            // skip if the master's
    jmp phSkip
    lac phI
    jda lbText
phSkip,
    idx phI
    jmp phNext
phEnd,
    jsp lbSize
    dac phW
    lac lbNest
    sza i               // skip if a nested entry's part
    jmp phOut
    lac phW
    add lbE
    dac lbB
    law NMASTER
    dac lbStep
    lac lbMk
    add [mNSub:5]
    dac lbAt
    law LBNESTW
    jda lbRun
    law SUBW
    dac lbM
    lac lbMk
    add [mNSub:5]
    dac lbT
    lac i lbT
    jda lbTimes
    add [LBNESTW]
    add phW
    dac phW
phOut,
    law LBHWORDS
    jda lbHA
    dac lbT
    lac phW
    dac i lbT
rtn, jmp .
phI, 0
phW, 0
    endloc

// Load slot lbSlot's entry into master lbMk: the directory's header and the slot's page read,
// the slot's word giving its blocks, lbBlkN from lbBlk (lbRdSlot), EMPTY for a free slot. Its
// blocks are read whole into lbEBuf, every block's sum checked; then its header judged: the
// magic and the format, or it is not an entry (EMPTY). A flat entry's counts each one a master
// can have (lbSane), the words its counts give its header's, and its blocks those words' (BAD
// BLOCK); and room for its texts in the masters' texts' table, with the master's old ones gone
// (NO ROOM). A nested entry's every part judged so, its sub-instances' masters among the
// entry's, and its parts' words the entry's (llNest); then the texts' room over every part; then
// an empty master for each part but the first, which is lbMk (SLOTS), each saved master's in
// lbEBuf's map (LBEMAP). Only then do the tables change, a part at a time (lbIn): a flat entry's
// here; a nested entry's first part here and each other in a call of its own (lbLdMore), once
// the stub has made its master's record resident; then the texts' list to be written again.
// On a load's first call for a master others hold (lbPhase LBPFIRST, libEntry), the tables are
// not changed: it stops once the entry is judged, TSHELD, lbEAt the first part's header.
// Exit: AC = TSLLOADED, TSHELD, TSEMPTY, TSBAD, TSNOROOM, TSSLOTS, TSMORE for the next part's
// record, or lbRdSlot's, tpSeek's or tpRead's failure.
// IO is clobbered. Called via jsp; lbLdMore, the next part's call, the same.
lbLoad,
    local rtn, llRead, llOK, llGo, llNG, llRoom, llNoRm, llEmpty, llBad, llW, llNest, llSrc
    addlocal llPt, llSb, llPtE, llMap, llMp, llMapE, llFree, llFrN, llSlots, llPart, llDone
    addlocal llS, llK, llB, llQ, llP, llC, llX, llT, llJ, llCo, llCs
    dap rtn
    jsp lbRdSlot
    sza                 // skip if the slot holds an entry
    jmp rtn
    lac i [lbBlkN:013]
    dac lbNB
    sub [1]
    spa                 // skip if at least one block
    jmp llEmpty
    sub [LBBLKS]
    spa                 // skip unless more than the buffer holds
    jmp llRead
llEmpty,
    lac [TSEMPTY]
    jmp rtn
llRead,
    law 1               // the truss starts again, since lbEBuf is its scratch
    dac i [taReset:013]
    lac [lbEBuf:016]
    dac lbFirst
    lac [lbSink:6]
    dac lbPad
    lac lbNB
    sal 8s
    jda lbList
    lac i [lbBlk:013]
    dac i [tpWant:013]
    dzm i [tpRev:013]
    lac lbNB
    cma
    dac i [tpBlk:013]
    lac [lbTpL:6]
    dac i [tpList:013]
    jsp i [tpSeek:013]
    sza                 // skip if at the entry's first block
    jmp rtn
    jsp i [tpRead:013]
    sza                 // skip unless a tape error
    jmp rtn
    lac i [tpBad:013]
    sza                 // skip if every block's sum was zero
    jmp llBad

    // The header.
    lac [lbEBuf:016]
    dac lbE
    dzm lbNest
    lac i [lbEBuf:016]
    sas [LBMAGIC]       // skip if an entry's magic
    jmp llEmpty
    lac i [lbEBuf:016 + 1]
    sad [LBFORMAT2]     // skip unless a nested entry
    jmp llNest
    sas [LBFORMAT]      // skip if a flat entry
    jmp llEmpty
    jsp lbSane
    sza                 // skip if its counts are a master's
    jmp llBad
    lac i [lbEBuf:016 + LBHLEN]
    sza i               // skip if the master has words
    jmp llEmpty
    jsp lbSize
    dac llW
    sas i [lbEBuf:016 + LBHWORDS] // skip if the header's words
    jmp llBad
    lac llW
    add [0377]
    sar 8s
    sas lbNB            // skip if its blocks
    jmp llBad
    lac i [lbEBuf:016 + LBHNTX]
    dac llT
    lac i [lbEBuf:016 + LBHCOST]
    dac llCo

    // The room for its texts: the masters' texts, less the master's, and the entry's (a nested
    // entry's every part's), and their costs within MTBUDGET the same way; then a nested entry's
    // masters (llMap).
llRoom,
    jsp lbCount
    cma
    add i [mtN:012]
    add llT
    sub [NMTEXT+1]
    sma                 // skip unless past NMTEXT
    jmp llNoRm
    lac lbMk
    add [txMCost:012]
    dac lbT
    lac llCo
    sub i lbT
    dac llCo
    lac [txMCost:012]
    dac lbT
    law i NMASTER
    dac llC
llCs,
    lac llCo
    add i lbT
    dac llCo
    idx lbT
    isp llC             // skip once every master's cost is in
    jmp llCs
    lac llCo
    sub [MTBUDGET+1]
    sma                 // skip unless past MTBUDGET
    jmp llNoRm
    lac lbNest
    sza                 // skip if a flat entry
    jmp llMap

    // A master others hold: on the first call, nothing more (libEntry's trial follows).
llOK,
    lac i [lbPhase:013]
    sas [LBPFIRST]      // skip if the first call for a master others hold
    jmp llGo
    lac lbE
    dac i [lbEAt:013]
    lac [TSHELD]
    jmp rtn

    // The tables change from here on: a flat entry's in one, a nested entry's a part at a call.
llGo,
    lac lbNest
    sza                 // skip if a flat entry
    jmp llNG
    jsp lbIn
    jmp llDone
llNG,
    dzm i [lbEBuf:016 + LBECUR]
    law TELLOAD
    dac i [lbEBuf:016 + LBEOP]
    jmp llPart

    // The next part, its master's record resident: a nested entry's.
lbLdMore,
    dap rtn
    law 1
    dac lbNest
llPart,
    lac i [lbEBuf:016 + LBECUR]
    jda lbPart
    lac i [lbEBuf:016 + LBECUR]
    add [lbEBuf:016 + LBESRC]
    dac lbT
    lac i lbT
    add [lbEBuf:016 + LBEMAP]
    dac lbT
    lac i lbT
    dac lbMk
    jsp lbIn
    idx i [lbEBuf:016 + LBECUR]
    sad i [lbEBuf:016 + LBENP] // skip unless every part is in
    jmp llDone
    add [lbEBuf:016 + LBESRC]
    dac lbT
    lac i lbT
    add [lbEBuf:016 + LBEMAP]
    dac lbT
    lac i lbT
    dac i [tpK:013]
    law TELMORE
    dac i [teArg:013]
    lac [TSMORE]
    jmp rtn
llDone,
    law 1
    dac i [txDirty:012]
    lac [TSLLOADED]
    jmp rtn

    // A nested entry: its parts' count, then their masters, each a master and none twice, llS
    // their bits.
llNest,
    law 1
    dac lbNest
    lac i [lbEBuf:016 + LBENP]
    sub [1]
    spa                 // skip if at least one part
    jmp llBad
    sub [NMASTER]
    sma                 // skip if at most NMASTER
    jmp llBad
    dzm llS
    dzm llK
llSrc,
    lac llK
    add [lbEBuf:016 + LBESRC]
    dac lbT
    lac i lbT
    spa                 // skip unless negative
    jmp llBad
    sub [NMASTER]
    sma                 // skip if a master
    jmp llBad
    lac i lbT
    dac i [masterBit:7]
    jsp i [masterBit:7+1]
    dac llB
    and llS
    sza                 // skip unless a master twice
    jmp llBad
    lac llB
    ior llS
    dac llS
    idx llK
    sas i [lbEBuf:016 + LBENP] // skip once every part's master is judged
    jmp llSrc

    // Each part: a flat entry's header, its counts a master's and its words some; then its
    // nesting, its sub-instances' count at most NSUB, each one's master one of the parts' and
    // not the part's own; its words its header's. llT the parts' texts, llCo their cost.
    lac [lbEBuf:016 + LBEHW]
    dac lbE
    dzm llK
    dzm llT
    dzm llCo
llPt,
    lac i lbE
    sas [LBMAGIC]       // skip if a part's magic
    jmp llBad
    law 1
    jda lbHW
    sas [LBFORMAT]      // skip if a part's format
    jmp llBad
    jsp lbSane
    sza                 // skip if its counts are a master's
    jmp llBad
    law LBHLEN
    jda lbHW
    sza i               // skip if the master has words
    jmp llBad
    jsp lbSize
    add lbE
    dac llQ             // its nesting
    add [LBNESTW]
    dac llP             // its sub-instances
    lac i llQ
    spa                 // skip unless negative
    jmp llBad
    sub [NSUB+1]
    sma                 // skip if at most NSUB
    jmp llBad
    lac llK
    add [lbEBuf:016 + LBESRC]
    dac lbT
    lac i lbT
    dac i [masterBit:7]
    jsp i [masterBit:7+1]
    dac llB             // the part's own master's bit
    lac i llQ
    sza i               // skip if it has sub-instances
    jmp llPtE
    cma
    dac llC
llSb,
    lac i llP           // SBM
    spa                 // skip unless negative
    jmp llBad
    sub [NMASTER]
    sma                 // skip if a master
    jmp llBad
    lac i llP
    dac i [masterBit:7]
    jsp i [masterBit:7+1]
    dac llX
    and llS
    sza i               // skip if one of the parts' masters
    jmp llBad
    lac llX
    sad llB             // skip unless the part's own
    jmp llBad
    lac llP
    add [SUBW]
    dac llP
    isp llC             // skip once every sub-instance is judged
    jmp llSb
llPtE,
    lac llP
    sub lbE
    dac llX             // the part's words
    law LBHWORDS
    jda lbHW
    sas llX             // skip if its header's
    jmp llBad
    law LBHNTX
    jda lbHW
    add llT
    dac llT
    law LBHCOST
    jda lbHW
    add llCo
    dac llCo
    lac llP
    dac lbE
    idx llK
    sas i [lbEBuf:016 + LBENP] // skip once every part is judged
    jmp llPt

    // The entry's words, the parts', and its blocks, those words'.
    lac lbE
    sub [lbEBuf:016]
    sas i [lbEBuf:016 + LBHWORDS] // skip if the header's words
    jmp llBad
    add [0377]
    sar 8s
    sas lbNB            // skip if its blocks
    jmp llBad
    jmp llRoom

    // The masters, after the texts' room: the first part's lbMk, each other's the next empty
    // master, never lbMk; lbE left at the first part, which the trial reads (lbEAt).
llMap,
    lac i [lbEBuf:016 + LBESRC]
    add [lbEBuf:016 + LBEMAP]
    dac lbT
    lac lbMk
    dac i lbT
    law 1
    dac llK
    dzm llJ
llMp,
    lac llK
    sad i [lbEBuf:016 + LBENP] // skip unless every part has its master
    jmp llMapE
llFree,
    lac llJ
    sad [NMASTER]       // skip unless past the last master
    jmp llSlots
    sad lbMk            // skip unless the master loaded into
    jmp llFrN
    add [mLen:5]
    dac lbT
    lac i lbT
    sza                 // skip if the master is empty
    jmp llFrN
    lac llK
    add [lbEBuf:016 + LBESRC]
    dac lbT
    lac i lbT
    add [lbEBuf:016 + LBEMAP]
    dac lbT
    lac llJ
    dac i lbT
    idx llJ
    idx llK
    jmp llMp
llFrN,
    idx llJ
    jmp llFree
llMapE,
    lac [lbEBuf:016 + LBEHW]
    dac lbE
    jmp llOK
llSlots,
    lac [TSSLOTS]
    jmp rtn
llNoRm,
    lac [TSNOROOM]
    jmp rtn
llBad,
    lac [TSBAD]
rtn, jmp .
llW, 0
llS, 0
llK, 0
llB, 0
llQ, 0
llP, 0
llC, 0
llX, 0
llT, 0
llJ, 0
llCo, 0
    endloc

// Part lbE's tables into master lbMk, its record resident: its old texts out (lbDrop), its words
// outside the record back (lbHead); its nesting words, a flat entry's a master's with no
// sub-instances (the instance module's mFlat) and every text its own (mTxOwn), a part's its
// nesting's, mUses made again from its sub-instances; its texts after the last; its record's
// tables and a part's sub-instances into the resident record (lbRec), each sub-instance's master
// the one its saved master took (LBEMAP); the master out of the store, and the part's name the
// master's, on its line of the masters' picker (mpkL).
// AC and IO are clobbered. Called via jsp.
lbIn,
    local rtn, liNest, liTx0, liTx, liTabs, liSb, liUse, liEnd, liN, liU, liP, liW
    dap rtn
    jsp lbDrop
    law 1
    dac lbDir
    jsp lbHead
    law LBHNTX
    jda lbHW
    dac liW             // its texts' count
    lac lbNest
    sza                 // skip if a flat entry
    jmp liNest
    lac lbMk
    dac i [mFlat:7]
    jsp i [mFlat:7+1]
    lac lbMk
    add [mTxOwn:5]
    dac lbT
    lac liW
    dac i lbT           // every text its own, since a flat entry holds no sub-instances
    jmp liTx0
liNest,
    jsp lbSize
    add lbE
    dac lbB
    law NMASTER
    dac lbStep
    lac lbMk
    add [mNSub:5]
    dac lbAt
    law LBNESTW
    jda lbRun           // mNSub to mTxOwn, mUses made again below
liTx0,
    law LBHDRW
    jda lbHA
    dac lbB
    lac liW
    sza i               // skip if it has texts
    jmp liTabs
    cma
    dac liN
liTx,
    lac i [mtN:012]
    add [mtM:013]
    dac lbT
    lac lbMk
    dac i lbT
    lac i [mtN:012]
    jda lbText
    idx i [mtN:012]
    isp liN             // skip once every text is in
    jmp liTx
liTabs,
    jsp lbRec
    lac lbNest
    sza i               // skip if a nested entry's part
    jmp liEnd

    // Its sub-instances' masters, those their saved masters took, and mUses from them.
    dzm liU
    lac lbMk
    add [mNSub:5]
    dac lbT
    lac i lbT
    sza i               // skip if it has sub-instances
    jmp liUse
    cma
    dac liN
    lac [cpSub:5]
    dac liP
liSb,
    lac i liP           // SBM, the saved master
    add [lbEBuf:016 + LBEMAP]
    dac lbT
    lac i lbT
    dac i liP
    dac i [masterBit:7]
    jsp i [masterBit:7+1]
    ior liU
    dac liU
    lac liP
    add [SUBW]
    dac liP
    isp liN             // skip once every sub-instance is mapped
    jmp liSb
liUse,
    lac lbMk
    add [mUses:5]
    dac lbT
    lac liU
    dac i lbT
liEnd,
    lac lbMk
    add [mStart:5]
    dac lbT
    lac [MNOPOOL]
    dac i lbT
    lac lbMk            // the master takes the part's name, on its picker's line
    add [mpkBlkT:013 + 1]
    dac lbT
    lac i lbT
    add [MPKTAG]
    dac lbTo
    law LBHNAME
    jda lbHA
    dac lbFrom
    law NAMEW
    jda lbMove
rtn, jmp .
liN, 0
liU, 0
liP, 0
liW, 0
    endloc

// Part lbE's master lbMk's record's tables (lbTabs), and a nested entry's part's sub-instances
// (cpSub, as many as its nesting's first word, mNSub), between the resident record and the
// buffer after the part's texts, in or out by lbDir.
// AC is clobbered, IO preserved. Called via jsp.
lbRec,
    local rtn, rcN
    dap rtn
    law LBTXW
    dac lbM
    law LBHNTX
    jda lbHW
    jda lbTimes
    add [LBHDRW]
    add lbE
    dac lbB
    jsp lbTabs
    lac lbNest
    sza i               // skip if a nested entry's part
    jmp rtn
    law SUBW
    dac lbM
    lac i lbB           // its nesting's first word, its sub-instances' count
    jda lbTimes
    dac rcN
    lac lbB
    add [LBNESTW]
    dac lbB
    lac [cpSub:5]
    dac lbAt
    lac rcN
    jda lbRun
rtn, jmp .
rcN, 0
    endloc

// Part k's first word, from the nested entry's first part by each part's words (LBHWORDS), into
// lbE.
// Entry: AC = k. AC is clobbered, IO preserved. Called via jda.
lbPart, 0
    local rtn, lpLoop, lpN
    dap rtn
    lac [lbEBuf:016 + LBEHW]
    dac lbE
    lac lbPart
    sza i               // skip unless the first part
    jmp rtn
    cma
    dac lpN
lpLoop,
    law LBHWORDS
    jda lbHW
    add lbE
    dac lbE
    isp lpN             // skip once past k parts
    jmp lpLoop
rtn, jmp .
lpN, 0
    endloc

// The address of the word at offset n in part lbE.
// Entry: AC = n. Exit: AC = its 16-bit address. IO is preserved. Called via jda.
lbHA, 0
    local rtn
    dap rtn
    lac lbHA
    add lbE
rtn, jmp .
    endloc

// The word at offset n in part lbE.
// Entry: AC = n. Exit: AC = the word. IO is preserved. Called via jda.
lbHW, 0
    local rtn, hwP
    dap rtn
    lac lbHW
    add lbE
    dac hwP
    lac i hwP
rtn, jmp .
hwP, 0
    endloc

// Master lbMk's words held outside its record, between the tables and part lbE's header, in
// or out by lbDir: its directory words, mLen to cpNA, a word of each table NMASTER apart; its
// attachers, cpAtt, cpAX and cpAY, NATT each, and cpNAtt; its constraints' count; its texts'
// cost. The texts' count's word, between the last two, is the caller's. lbB is left past them.
// AC is clobbered, IO preserved. Called via jsp.
lbHead,
    local rtn, lhA
    dap rtn
    law LBHDIR
    jda lbHA
    dac lbB
    law NMASTER
    dac lbStep
    lac lbMk
    add [mLen:5]
    dac lbAt
    law LBDIRW
    jda lbRun
    law 1
    dac lbStep
    law NATT
    dac lbM
    lac lbMk
    jda lbTimes
    dac lhA             // the master's attachers' offset
    add [cpAtt:5]
    dac lbAt
    law NATT
    jda lbRun
    lac lhA
    add [cpAX:5]
    dac lbAt
    law NATT
    jda lbRun
    lac lhA
    add [cpAY:5]
    dac lbAt
    law NATT
    jda lbRun
    lac lbMk
    add [cpNAtt:5]
    dac lbAt
    law 1
    jda lbRun
    lac lbMk
    add [cpNCon:011]
    dac lbAt
    law 1
    jda lbRun
    idx lbB             // past the texts' count
    lac lbMk
    add [txMCost:012]
    dac lbAt
    law 1
    jda lbRun
rtn, jmp .
lhA, 0
    endloc

// The masters' text t's words, between the masters' texts' tables and the buffer from lbB, in or
// out by lbDir, lbB left past them: its offset, scale, characters and words, mtDX to mtW, five
// tables NMTEXT apart; its run, its mtW words in the masters' pool, TXRUN in the buffer, zeros
// after the run's (a save's run found, a load's slot made that long first: the text module's
// mtAtE and mtFitE); its digits' anchor, value and fix, mtAn to mtFix, three tables NMTEXT
// apart. Its master, mtM, is the caller's.
// Entry: AC = t. AC and IO are clobbered. Called via jda.
lbText, 0
    local rtn, lxOut, lxRun, lxPad, lxEnd, lxW, lxN
    dap rtn
    law NMTEXT
    dac lbStep
    lac lbText
    add [mtDX:013]
    dac lbAt
    law 5
    jda lbRun
    lac lbText
    add [mtW:013]
    dac lbAt
    lac i lbAt
    dac lxW
    lio lbText
    lac lbDir
    sza i               // skip if a load's
    jmp lxOut
    jsp i [mtFitE:012]
    jmp lxRun
lxOut,
    jsp i [mtAtE:012]
lxRun,
    dac lbAt
    law 1
    dac lbStep
    lac lxW
    jda lbRun
    lac lxW
    sub [TXRUN]
    sza i               // skip if short of TXRUN
    jmp lxEnd
    dac lxN
lxPad,
    lac lbDir
    sza i               // skip if a load's, which passes the zeros
    dzm i lbB
    idx lbB
    isp lxN             // skip once the pad is done
    jmp lxPad
lxEnd,
    law NMTEXT
    dac lbStep
    lac lbText
    add [mtAn:013]
    dac lbAt
    law 3
    jda lbRun
rtn, jmp .
lxW, 0
lxN, 0
    endloc

// Master lbMk's record's tables (lbRecT), between the resident record and the buffer from lbB,
// in or out by lbDir, each as many words as its count in the master directory times its
// multiplier. A load's counts are the entry's, lbHead having put them back first.
// AC is clobbered, IO preserved. Called via jsp.
lbTabs,
    local rtn, ltLoop, ltP, ltN
    dap rtn
    law 1
    dac lbStep
    lac [lbRecT:6]
    dac ltP
    law i LBRECN
    dac ltN
ltLoop,
    lac i ltP           // the table's first word
    dac lbAt
    idx ltP
    lac i ltP           // the table of counts, by master
    add lbMk
    dac lbT
    idx ltP
    lac i ltP           // the multiplier
    dac lbM
    idx ltP
    lac i lbT
    jda lbTimes
    jda lbRun
    isp ltN             // skip once every table is copied
    jmp ltLoop
rtn, jmp .
ltP, 0
ltN, 0
    endloc

// A flat entry's words, or a part's without its nesting, from the counts in part lbE's header:
// the header, LBTXW a text, and its record's tables as lbRecT takes them, mLen's words, two of
// each point and line, CPATAB of each arc and CW of each constraint.
// Exit: AC = the words. IO is preserved. Called via jsp.
lbSize,
    local rtn, lzW, lzT
    dap rtn
    law LBTXW
    dac lbM
    law LBHNTX
    jda lbHW
    jda lbTimes
    add [LBHDRW]
    dac lzW
    law LBHLEN
    jda lbHW
    add lzW
    dac lzW
    law LBHNP
    jda lbHW
    dac lzT
    law LBHNL
    jda lbHW
    add lzT
    sal 1s
    add lzW
    dac lzW
    law CPATAB
    dac lbM
    law LBHNA
    jda lbHW
    jda lbTimes
    add lzW
    dac lzW
    law CW
    dac lbM
    law LBHNCON
    jda lbHW
    jda lbTimes
    add lzW
rtn, jmp .
lzW, 0
lzT, 0
    endloc

// Whether the counts in part lbE's header are each one a master can have: each of lbBnd's,
// from 0 to its largest.
// Exit: AC = 0 if they are, 1 otherwise. IO is preserved. Called via jsp.
lbSane,
    local rtn, lnLoop, lnBad, lnP, lnQ
    dap rtn
    lac [lbBnd:6]
    dac lnP
lnLoop,
    lac i lnP           // the count's offset in the header, 0 past the last
    sza i               // skip unless every count is judged
    jmp rtn
    add lbE
    dac lnQ
    idx lnP
    lac i lnQ
    spa                 // skip unless negative
    jmp lnBad
    sub i lnP
    sub [1]
    sma                 // skip if at most the largest
    jmp lnBad
    idx lnP
    jmp lnLoop
lnBad,
    law 1
rtn, jmp .
lnP, 0
lnQ, 0
    endloc

// The masters' texts that are master lbMk's.
// Exit: AC = their count. IO is preserved. Called via jsp.
lbCount,
    local rtn, lcLoop, lcEnd, lcI, lcN
    dap rtn
    dzm lcI
    dzm lcN
lcLoop,
    lac lcI
    sad i [mtN:012]     // skip while the masters' texts remain
    jmp lcEnd
    add [mtM:013]
    dac lbT
    lac i lbT
    sad lbMk            // skip unless the master's
    idx lcN
    idx lcI
    jmp lcLoop
lcEnd,
    lac lcN
rtn, jmp .
lcI, 0
lcN, 0
    endloc

// Master lbMk's texts out of the masters' texts' table, the others closing up in order, each
// moved through lbTmp with its master; mtN their count.
// AC and IO are clobbered. Called via jsp.
lbDrop,
    local rtn, ldLoop, ldMoved, ldNext, ldEnd, ldI, ldJ, ldM
    dap rtn
    dzm ldI
    dzm ldJ
ldLoop,
    lac ldI
    sad i [mtN:012]     // skip while the masters' texts remain
    jmp ldEnd
    add [mtM:013]
    dac lbT
    lac i lbT
    sad lbMk            // skip unless the master's, which goes
    jmp ldNext
    dac ldM
    lac ldI
    sad ldJ             // skip unless in place already
    jmp ldMoved
    lac ldJ
    add [mtM:013]
    dac lbT
    lac ldM
    dac i lbT
    dzm lbDir
    lac [lbTmp:6]
    dac lbB
    lac ldI
    jda lbText
    law 1
    dac lbDir
    lac [lbTmp:6]
    dac lbB
    lac ldJ
    jda lbText
ldMoved,
    idx ldJ
ldNext,
    idx ldI
    jmp ldLoop
ldEnd,
    lac ldJ
    dac i [mtN:012]
    jsp i [mtTrimE:012]
rtn, jmp .
ldI, 0
ldJ, 0
ldM, 0
    endloc

// n words between a table, from lbAt by steps of lbStep, and the buffer from lbB, both left past
// them: into the buffer while lbDir is 0 (a save's), out of it otherwise (a load's).
// Entry: AC = n, 0 or more. AC is clobbered, IO preserved. Called via jda.
lbRun, 0
    local rtn, lrLoop, lrOut, lrNext, lrN
    dap rtn
    lac lbRun
    sza i               // skip if there are words
    jmp rtn
    cma
    dac lrN
lrLoop,
    lac lbDir
    sza                 // skip if into the buffer
    jmp lrOut
    lac i lbAt
    dac i lbB
    jmp lrNext
lrOut,
    lac i lbB
    dac i lbAt
lrNext,
    idx lbB
    lac lbAt
    add lbStep
    dac lbAt
    isp lrN             // skip once every word is copied
    jmp lrLoop
rtn, jmp .
lrN, 0
    endloc

// a times m, for the small multipliers, m at least 1.
// Entry: AC = a, lbM = m. Exit: AC = the product. IO is preserved. Called via jda.
lbTimes, 0
    local rtn, ltLoop, ltC, ltS
    dap rtn
    lac lbM
    cma
    dac ltC
    dzm ltS
ltLoop,
    lac ltS
    add lbTimes
    dac ltS
    isp ltC             // skip once a is added m times
    jmp ltLoop
    lac ltS
rtn, jmp .
ltC, 0
ltS, 0
    endloc

// The tape's run list for lbNB blocks, n words from lbFirst (lbEBuf for an entry): then the rest
// of its last block from or to the word lbPad (lbZero for a save, lbSink for a load), if there is
// any; then the closing run, one word from or to it, which the transfer never reaches.
// Entry: AC = n, 1 to lbNB * 256. AC is clobbered, IO preserved. Called via jda.
lbList, 0
    local rtn, llEnd, llQ, llS
    dap rtn
    lac [lbTpL:6]
    dac llQ
    lac lbFirst
    dac i llQ
    idx llQ
    lac lbList
    cma
    dac i llQ
    idx llQ
    law 1
    dac i llQ
    idx llQ
    lac lbNB
    sal 8s
    sub lbList
    sza i               // skip unless the words end on a block's end
    jmp llEnd
    dac llS
    lac lbPad
    dac i llQ
    idx llQ
    lac llS
    cma
    dac i llQ
    idx llQ
    dzm i llQ
    idx llQ
llEnd,
    lac lbPad
    dac i llQ
    idx llQ
    lac [0-1]
    dac i llQ
    idx llQ
    dzm i llQ
rtn, jmp .
llQ, 0
llS, 0
    endloc

// Copy n words from lbFrom to lbTo, both left past them.
// Entry: AC = n, at least 1. AC is clobbered, IO preserved. Called via jda.
lbMove, 0
    local rtn, lmLoop, lmN
    dap rtn
    lac lbMove
    cma
    dac lmN
lmLoop,
    lac i lbFrom
    dac i lbTo
    idx lbFrom
    idx lbTo
    isp lmN             // skip once every word is copied
    jmp lmLoop
rtn, jmp .
lmN, 0
    endloc

// Dir: the directory's header read, and page lbPage, brought back to the last page with an entry
// (the first with none), into lbDPage, from which the keyboard's open writes the screen's sixteen
// lines (spkbd.ac, kbLibFill).
// Exit: AC = TSOPEN, or lbRdHdr's or lbPgIO's failure. IO is clobbered. Called via jsp.
lbShow,
    local rtn, lwLast, lwHave, lwRd, lwN
    dap rtn
    jsp lbRdHdr
    sza                 // skip if the directory's header was read
    jmp rtn
    law LBPAGES - 1
    dac lbPg
lwLast,
    lac lbPg
    add [lbDHdr:5 + LBDCNT]
    dac lbT
    lac i lbT
    sza                 // skip unless the page has an entry
    jmp lwHave
    lac lbPg
    sza i               // skip unless the first page
    jmp lwHave
    sub [1]
    dac lbPg
    jmp lwLast
lwHave,
    lac i [lbPage:013]
    spa                 // skip unless before the first page
    cla
    dac lwN
    sub lbPg
    sma                 // skip if before the last page with an entry
    jmp lwRd
    lac lwN
    dac lbPg
lwRd,
    lac lbPg
    dac i [lbPage:013]
    dzm lbWr
    jsp lbPgIO
    sza                 // skip if the page was read
    jmp rtn
    lac [TSOPEN]
rtn, jmp .
lwN, 0
    endloc

// Delete: slot lbSlot's entry out of the directory, refused, EMPTY, for a free slot. Its name
// is kept in lbTmp for the name's line, not in lbEBuf, which is the truss's while the truss
// runs; its slot's word and name cleared
// in its page and the page written; then its blocks freed in the map and its page's count down,
// and the header written (the file's comment: a cut between the two only loses blocks).
// Exit: AC = TSDELETED, TSEMPTY, or lbRdSlot's or a transfer's failure. IO is clobbered. Called
// via jsp.
lbDel,
    local rtn
    dap rtn
    jsp lbRdSlot
    sza                 // skip if the slot holds an entry
    jmp rtn
    lac lbSE
    add [1]
    dac lbFrom
    lac [lbTmp:6]
    dac lbTo
    law NAMEW
    jda lbMove
    dzm i lbSE
    lac [lbBlank:6]
    dac lbFrom
    lac lbSE
    add [1]
    dac lbTo
    law NAMEW
    jda lbMove
    law 1
    dac lbWr
    jsp lbPgIO
    sza                 // skip if the page was written
    jmp rtn
    dzm lbSetF
    lac i [lbBlkN:013]
    dac lbMN
    lac i [lbBlk:013]
    jda lbMark
    lac lbPg
    add [lbDHdr:5 + LBDCNT]
    dac lbT
    lac i lbT
    sza                 // skip if the count is already 0
    sub [1]
    dac i lbT
    jsp lbHdrIO
    sza                 // skip if the header was written
    jmp rtn
    lac [TSDELETED]
rtn, jmp .
    endloc

// A saved entry into the directory, lbBlkN blocks from lbBlk in slot lbSl of page lbPg, which
// lbRoom read into lbDPage: its blocks taken in the map and its page's count up, the header
// written; then its slot's word, LBDNEST in it for a nested entry (lbEBuf's format), and its
// name, lbName, in the page, the page written (the file's comment). lbSlot is the slot.
// Exit: AC = TSSAVED, or a transfer's failure. IO is clobbered. Called via jsp.
lbEnter,
    local rtn, leW, leFlat
    dap rtn
    law 1
    dac lbSetF
    lac i [lbBlkN:013]
    dac lbMN
    lac i [lbBlk:013]
    jda lbMark
    lac lbPg
    add [lbDHdr:5 + LBDCNT]
    dac lbT
    idx i lbT
    law 1
    dac lbWr
    jsp lbHdrIO
    sza                 // skip if the header was written
    jmp rtn
    lac i [lbBlkN:013]  // the blocks' bits past the low four, at bit 14
    and [060]
    sal 9s
    sal 1s
    dac leW
    lac i [lbBlkN:013]
    and [017]
    ior leW
    dac leW
    lac i [lbBlk:013]
    sal 4s
    ior leW
    dac leW
    lac i [lbEBuf:016 + 1]
    sas [LBFORMAT2]     // skip if a nested entry
    jmp leFlat
    lac leW
    ior [LBDNEST]
    dac leW
leFlat,
    lac leW
    dac i lbSE
    lac [lbName:013]
    dac lbFrom
    lac lbSE
    add [1]
    dac lbTo
    law NAMEW
    jda lbMove
    law 1
    dac lbWr
    jsp lbPgIO
    sza                 // skip if the page was written
    jmp rtn
    lac lbPg
    sal 4s
    add lbSl
    dac i [lbSlot:013]
    lac [TSSAVED]
rtn, jmp .
leW, 0
    endloc

// The first free slot: the first page whose count is below LBLINES, read into lbDPage, and its
// first slot whose word is 0; lbPg, lbSl and lbSE, the slot's word's address.
// Exit: AC = 0, TSFULL with no slot free, or lbPgIO's failure. IO is clobbered. Called via jsp.
lbRoom,
    local rtn, lmPage, lmRead, lmSlot, lmNone
    dap rtn
    dzm lbPg
lmPage,
    lac lbPg
    sad [LBPAGES]       // skip unless past the last page
    jmp lmNone
    add [lbDHdr:5 + LBDCNT]
    dac lbT
    lac i lbT
    sas [LBLINES]       // skip if the page is full
    jmp lmRead
    idx lbPg
    jmp lmPage
lmRead,
    dzm lbWr
    jsp lbPgIO
    sza                 // skip if the page was read
    jmp rtn
    dzm lbSl
lmSlot,
    lac lbSl
    sad [LBLINES]       // skip unless past the page's last slot
    jmp lmNone
    jda lbEnt
    dac lbSE
    lac i lbSE
    sza i               // skip unless the slot is free, AC 0
    jmp rtn
    idx lbSl
    jmp lmSlot
lmNone,
    lac [TSFULL]
rtn, jmp .
    endloc

// The first run of lbEN free blocks in the map, from the block after the directory's to the
// tape's end, then from block 1, so that a save's seeks to its entry and back to the directory
// stay short until the blocks after the directory are taken (52.8 ms a block).
// Exit: AC = its first block, or 0 if there is none. IO is preserved. Called via jsp.
lbFit,
    local rtn, lfFrom, lfLoop, lfFree, lfNext, lfWrap, lfNone, lfB, lfI, lfN, lfW
    dap rtn
    dzm lfW
    law LBDIRBLK + LBPAGES + 1
lfFrom,
    dac lfB
    dac lfI
    dzm lfN
lfLoop,
    lac lfI
    sad [LBTBLOCKS]     // skip unless past the tape's last block
    jmp lfWrap
    jda lbBit
    and i lbBW
    sza i               // skip if the block is taken
    jmp lfFree
    dzm lfN             // taken: the run starts again after it
    lac lfI
    add [1]
    dac lfB
    jmp lfNext
lfFree,
    idx lfN
    sas lbEN            // skip once the run is long enough
    jmp lfNext
    lac lfB
    jmp rtn
lfNext,
    idx lfI
    jmp lfLoop
lfWrap,
    lac lfW
    sza                 // skip unless from block 1 already
    jmp lfNone
    law 1
    dac lfW
    jmp lfFrom
lfNone,
    cla
rtn, jmp .
lfB, 0
lfI, 0
lfN, 0
lfW, 0
    endloc

// lbMN blocks from block b, taken in the map while lbSetF is set, freed otherwise.
// Entry: AC = b. AC is clobbered, IO preserved. Called via jda.
lbMark, 0
    local rtn, lkLoop, lkSet, lkPut, lkC, lkM
    dap rtn
    lac lbMN
    cma
    dac lkC
lkLoop,
    lac lbMark
    jda lbBit
    dac lkM
    lac lbSetF
    sza                 // skip if freed
    jmp lkSet
    lac lkM
    cma
    and i lbBW
    jmp lkPut
lkSet,
    lac lkM
    ior i lbBW
lkPut,
    dac i lbBW
    idx lbMark
    isp lkC             // skip once every block is marked
    jmp lkLoop
rtn, jmp .
lkC, 0
lkM, 0
    endloc

// Block b's bit in the map, lbBW its word's 16-bit address.
// Entry: AC = b. Exit: AC = the bit. IO is preserved. Called via jda.
lbBit, 0
    local rtn, lbtLoop, lbtEnd, lbtC, lbtM
    dap rtn
    lac lbBit
    sar 4s
    add [lbDHdr:5 + LBDMAP]
    dac lbBW
    law 1
    dac lbtM
    lac lbBit
    and [017]
    sza i               // skip unless bit 0
    jmp lbtEnd
    cma
    dac lbtC
lbtLoop,
    lac lbtM
    ral 1s
    dac lbtM
    isp lbtC            // skip once shifted to the block's bit
    jmp lbtLoop
lbtEnd,
    lac lbtM
rtn, jmp .
lbtC, 0
lbtM, 0
    endloc

// Read the directory's header into lbDHdr and judge it: a sum that fails, BAD BLOCK; the picture
// tape's magic, NOT LIB; the library's magic, format and LBDHW, kept; a header all zeros, a blank
// tape, an empty library: every count 0, and the map with block 0 and the directory's blocks
// taken, which the first save writes. Anything else is another program's tape, NOT BLANK, for
// every command, since its pages would read as entries; a word not zero, in the header or the
// block's rest (lbRest), is found as the empty library is made, so a library's magic of another
// format is refused too.
// Exit: AC = 0, TSBAD, TSNOTLIB, TSOTHER, or the transfer's failure. IO is clobbered. Called via
// jsp.
lbRdHdr,
    local rtn, lhPic, lhLib, lhFresh, lhZero, lhRest, lhOK, lhOther
    dap rtn
    dzm lbWr
    jsp lbHdrIO
    sza                 // skip if read
    jmp rtn
    lac i [tpBad:013]
    sza i               // skip if its sum failed
    jmp lhPic
    lac [TSBAD]
    jmp rtn
lhOther,
    law TSOTHER
    jmp rtn
lhPic,
    lac i [lbDHdr:5]
    sas [TPMAGIC]       // skip if a picture tape's directory
    jmp lhLib
    lac [TSNOTLIB]
    jmp rtn
lhLib,
    sas [LBMAGIC]       // skip if the library's magic
    jmp lhFresh
    lac i [lbDHdr:5 + 1]
    sas [LBFORMAT]      // skip if this format
    jmp lhFresh
    lac i [lbDHdr:5 + 2]
    sad [LBDHW]         // skip unless the header's words
    jmp lhOK
lhFresh,
    lac [lbDHdr:5]
    dac lbT
    law i LBDHW
    dac lbM
lhZero,
    lac i lbT
    sza                 // skip if the word is zero
    jmp lhOther
    idx lbT
    isp lbM             // skip once every word is found 0
    jmp lhZero
    lac [lbRest:6]
    dac lbT
    law i LBDREST
    dac lbM
lhRest,
    lac i lbT
    sza                 // skip if the word is zero
    jmp lhOther
    idx lbT
    isp lbM             // skip once every word is found 0
    jmp lhRest
    lac [LBMAGIC]
    dac i [lbDHdr:5]
    law LBFORMAT
    dac i [lbDHdr:5 + 1]
    law LBDHW
    dac i [lbDHdr:5 + 2]
    law 1
    dac i [lbDHdr:5 + LBDMAP] // block 0
    dac lbSetF
    law LBPAGES + 1
    dac lbMN
    law LBDIRBLK
    jda lbMark
lhOK,
    cla
rtn, jmp .
    endloc

// The header, LBDHW words of lbDHdr, to or from block LBDIRBLK: written while lbWr is set, the
// rest of the block zeros; read otherwise, the rest into lbRest (lbHdRRuns), where lbRdHdr tests
// it.
// Exit: AC = 0, or the transfer's failure; a read's failed sum is tpBad's. IO is clobbered.
// Called via jsp.
lbHdrIO,
    local rtn, lhiW
    dap rtn
    lac lbWr
    sza                 // skip if a read
    jmp lhiW
    lac [lbHdRRuns:6]
    dac i [tpList:013]
    law LBDIRBLK
    jda lbBlkIO
    jmp rtn
lhiW,
    lac [lbDHdr:5]
    dac lbFirst
    law LBDHW
    dac lbXN
    law LBDIRBLK
    jda lbXfer
rtn, jmp .
    endloc

// Page lbPg, LBPGW words of lbDPage, to or from its block: written while lbWr is set, read
// otherwise, a read whose sum failed refused, BAD BLOCK.
// Exit: AC = 0, TSBAD, or the transfer's failure. IO is clobbered. Called via jsp.
lbPgIO,
    local rtn, lpOK
    dap rtn
    lac [lbDPage:5]
    dac lbFirst
    law LBPGW
    dac lbXN
    lac lbPg
    add [LBDIRBLK + 1]
    jda lbXfer
    sza                 // skip if done
    jmp rtn
    lac lbWr
    sza                 // skip if a read
    jmp lpOK
    lac i [tpBad:013]
    sza i               // skip if its sum failed
    jmp rtn
    lac [TSBAD]
    jmp rtn
lpOK,
    cla
rtn, jmp .
    endloc

// One block, b, to or from lbXN words from lbFirst, the rest of it zeros or passed over (lbList):
// written while lbWr is set, read otherwise.
// Entry: AC = b. Exit: AC = 0, or tpSeek's, tpRead's or tpWrite's failure. IO is clobbered.
// Called via jda.
lbXfer, 0
    local rtn, lxPad
    dap rtn
    law 1
    dac lbNB
    lac [lbSink:6]
    dac lbPad
    lac lbWr
    sza i               // skip if a write
    jmp lxPad
    lac [lbZero:6]
    dac lbPad
lxPad,
    lac lbXN
    jda lbList
    lac [lbTpL:6]
    dac i [tpList:013]
    lac lbXfer
    jda lbBlkIO
rtn, jmp .
    endloc

// One block, b, to or from the run list at tpList, which the caller sets: written while lbWr is
// set, read otherwise.
// Entry: AC = b. Exit: AC = 0, or tpSeek's, tpRead's or tpWrite's failure. IO is clobbered.
// Called via jda.
lbBlkIO, 0
    local rtn, lbiRd
    dap rtn
    lac lbBlkIO
    dac i [tpWant:013]
    dzm i [tpRev:013]
    law i 1
    dac i [tpBlk:013]
    jsp i [tpSeek:013]
    sza                 // skip if at the block
    jmp rtn
    lac lbWr
    sza i               // skip if a write
    jmp lbiRd
    jsp i [tpWrite:013]
    jmp rtn
lbiRd,
    jsp i [tpRead:013]
rtn, jmp .
    endloc

// Line l's slot's word in lbDPage.
// Entry: AC = l. Exit: AC = its 16-bit address. IO is preserved. Called via jda.
lbEnt, 0
    local rtn
    dap rtn
    law LBDENT
    dac lbM
    lac lbEnt
    jda lbTimes
    add [lbDPage:5]
rtn, jmp .
    endloc

// The directory's header and slot lbSlot's page read, and the slot's entry found: lbPg its page,
// lbSl its place, lbSE its word's address in lbDPage, lbBlk and lbBlkN its first block and blocks
// (sketchpad.ah, the library's directory: the blocks' low four bits, and two more at bit 14).
// Exit: AC = 0, TSEMPTY for a free slot, or lbRdHdr's or lbPgIO's failure. IO is clobbered.
// Called via jsp.
lbRdSlot,
    local rtn, lrUsed
    dap rtn
    jsp lbRdHdr
    sza                 // skip if the directory's header was read
    jmp rtn
    lac i [lbSlot:013]
    sar 4s
    and [LBPAGES - 1]
    dac lbPg
    dzm lbWr
    jsp lbPgIO
    sza                 // skip if the page was read
    jmp rtn
    lac i [lbSlot:013]
    and [LBLINES - 1]
    dac lbSl
    jda lbEnt
    dac lbSE
    lac i lbSE
    sza                 // skip if the slot is free
    jmp lrUsed
    lac [TSEMPTY]
    jmp rtn
lrUsed,
    sar 4s
    and [01777]
    dac i [lbBlk:013]
    lac i lbSE
    sar 9s
    sar 1s
    and [060]
    dac lbT
    lac i lbSE
    and [017]
    ior lbT
    dac i [lbBlkN:013]
    cla
rtn, jmp .
    endloc

// The status word's texts, four words each, by the result, TSSAVED to TSSLOTS, as the tape's
// (sptape.ac, tpMsgs). TSOPEN's and TSMORE's are never shown, nor TSNOTPIC's, the tape's, nor
// Plot's three, TSPLOTTED to TSNOPLOT, nor TSNESTED's, no longer given, nor TSHELD's, which only
// hold their places.
lbMsgs,
    type340 "SAVED    "
    type340 "LOADED   "
    type340 "NO TAPE  "
    type340 "LOCKED   "
    type340 "EMPTY    "
    type340 "BAD BLOCK"
    type340 "NO FLAG  "
    type340 "BAD BLOCK"
    type340 "         "
    type340 "TOO BIG  "
    type340 "         "
    type340 "LOADED   "
    type340 "NO ROOM  "
    type340 "NOT LIB  "
    type340 "         "
    type340 "TAPE FULL"
    type340 "DELETED  "
    type340 "         "
    type340 "         "
    type340 "         "
    type340 "NESTED   "
    type340 "TOO SLOW "
    type340 "DIGITS   "
    type340 "NOT BLANK"
    type340 "         "
    type340 "SLOTS    "

// A blank name's run, which the name's line shows after any result but SAVED, LOADED and
// DELETED, and which a deleted slot's name becomes.
lbBlank,
    table NAMEW - 1, KBPAD
    KBBLANK

// The counts lbSane judges: each one's offset in the header and its largest value, then a 0.
lbBnd,
    LBHLEN; MPOOL1
    LBHNP; CPPTS
    LBHNL; CPLINES
    LBHNA; CPARCS
    LBHNATT; NATT
    LBHNCON; NCPCON
    LBHNTX; NMTEXT
    0

// A master's record's tables, in an entry's order, as the tape's (sptape.ac, tpRecT): each
// table's first word, the directory's table of counts, by master, that gives its words, and the
// count's multiplier.
lbRecT,
    mrWords:5; mLen:5; 1
    cpX:5; cpNP:5; 1
    cpY:5; cpNP:5; 1
    cpFrom:5; cpNL:5; 1
    cpTo:5; cpNL:5; 1
    cpC:5; cpNA:5; 1
    cpS:5; cpNA:5; 1
    cpE:5; cpNA:5; 1
    cpD:5; cpNA:5; 1
    cpK:5; cpNA:5; 1
    cpCon:5; cpNCon:011; CW

// The overlay's words, each set within the call that reads it.
lbMk, 0                 // the master, lbK
lbDir, 0                // 0 into the buffer, a save's; 1 out of it, a load's
lbAt, 0                 // a table's next word, a 16-bit pointer
lbStep, 0               // the table's step
lbB, 0                  // the buffer's next word, a 16-bit pointer
lbM, 0                  // lbTimes' multiplier
lbT, 0                  // a word's 16-bit address, briefly
lbFrom, 0               // lbMove's source and destination, 16-bit pointers
lbTo, 0
lbNB, 0                 // the blocks of lbList's run list
lbEN, 0                 // a save's entry's blocks
lbFirst, 0              // lbList's words' first, a 16-bit pointer
lbXN, 0                 // lbXfer's words
lbWr, 0                 // 1 for a write of the header or a page, 0 for a read
lbPad, 0                // the padding's word, lbZero or lbSink
lbZero, 0               // the word a save's padding repeats
lbSink, 0               // where a load's unkept words go
lbPg, 0                 // the directory's page in lbDPage
lbSl, 0                 // a slot's place in its page
lbSE, 0                 // its word in lbDPage, a 16-bit pointer
lbSetF, 0               // lbMark's choice: 1 takes the blocks, 0 frees them
lbMN, 0                 // lbMark's blocks
lbE, 0                  // the part in hand's first word in lbEBuf, a 16-bit pointer: a flat
                        // entry's lbEBuf, a nested entry's part's after the entry's header
                        // (lbPart)
lbNest, 0               // 1 for a nested entry, 0 for a flat one
lbBW, 0                 // lbBit's word in the map, a 16-bit pointer
lbTpL,                  // the run list on tape (lbList): the words, the padding, the closing
    table 3 * 3, 0
lbHdRRuns,              // the header's read: its words, the block's rest, the closing
    TPRUN(lbDHdr:5, LBDHW)
    TPRUN(lbRest:6, LBDREST)
    lbSink:6; 0 - 1; 0
lbRest,                 // the rest of the header's block, as read (lbHdrIO)
    table LBDREST, 0
lbTmp,                  // a text on its way to another slot (lbDrop), or a deleted entry's name
    table LBTXW, 0

%%endoverlay

// The library's entries (TELSAVE to TELDEL), from the tape module's root stub tapeEntry, which
// jumps here with teStubR and teArg set, Plot's (TEPLOT) going on to its stub (spplot.ac,
// plotEntry): for a save or a load, master lbK's record made resident
// (the instance module's mrLoad, through mrLoadX); then the overlay's entry, through the manager,
// which reads it into W first if W holds another. While a nested entry's save or load asks for
// its next part's master's record (TSMORE), lyCall makes master tpK's record resident and calls
// the overlay again with teArg, which the overlay has made TELMORE; nothing calls the overlay
// after such a loop but with teArg set again.
// A load into a master others hold (mUses) runs in calls of the overlay (lbPhase): the first
// reads and judges the entry and stops there (TSHELD); then,
// from lbEBuf (at lbEAt, which the first call gives), the entry's words go
// into the master's slot in the store (the instance module's poolRoom), its count before its
// crosses worked out from its attachers (its mDrawOf), and its texts' count and digits set for
// the trial (rwTx, rwDig), which runs with the entry's length and count in the master's place
// (its rwRun, RWLIB); the master's own then put back. Refused, a call only shows why, a holder
// named (LBPSHOW), and nothing has changed. Passed, a second call reads the entry again and
// loads it (LBPAGAIN), and the masters holding it are recomposed (RWCOM).
// Entry: teStubR = the return address, which carries the main bank; teArg = the entry. Exit:
// AC = the overlay's result. IO is clobbered. Reached by jmp, from tapeEntry.
libEntry,
    local lyRec, lyGo, lyLoad, lyHl, lyHeld, lyTx, lyTxN, lyTxD, lyCp, lyNoRm, lyRef, lyEnd, \
        lyCall, lyCl, lyCr, lyBack, lyBr, lyWd, lyWr, lyWp, lyB, lyK, lyT, lyN, lyOL, lyOD, lyP, \
        lyQ, lyC
    lac teArg
    sad [TEPLOT]        // skip unless Plot's
    jmp plotEntry
    sad [TELLOAD]       // skip unless a load
    jmp lyLoad
    sas [TELSAVE]       // skip if a save
    jmp lyGo
lyRec,
    jsp lyCall
    jmp i teStubR
lyGo,
    lio teArg
    %%ovcall library, libEntryOv
    jmp i teStubR

    // A load: in one call unless another master holds the master.
lyLoad,
    dzm lbPhase
    lac lbK
    dac i [masterBit:7]
    jsp i [masterBit:7+1]
    dac lyB
    dzm lyK
lyHl,
    lac lyK
    add [mUses:5]
    dac lyT
    lac i lyT
    and lyB
    sza                 // skip unless it holds the master
    jmp lyHeld
    idx lyK
    sas [NMASTER]       // skip once every master is looked at
    jmp lyHl
    jmp lyRec
lyHeld,
    law LBPFIRST
    dac lbPhase
    jsp lyCall
    sas [TSHELD]        // skip if the entry passed, for the trial
    jmp lyEnd

    // The entry's length and count before its crosses in the master's place, its own kept.
    lac lbK
    add [mLen:5]
    dac lyP
    lac i lyP
    dac lyOL
    lac lbK
    add [mDrawLen:5]
    dac lyQ
    lac i lyQ
    dac lyOD
    law LBHLEN
    jda lyWd
    dac lyN
    dac i lyP
    dac i [pbN:7]
    law LBHNATT
    jda lyWd
    dac i [mfNA:7]
    lac lbEAt
    add [LBHDIR + LBDIRW + NATT]
    dac i [mfPX:7]
    add [NATT]
    dac i [mfPY:7]
    lac lyN
    dac i [mDrawOf:7]
    jsp i [mDrawOf:7+1]
    dac i lyQ

    // Its texts' count, their cost (the text module's txDrCo, for the masters' budget) and
    // whether any is digits (an anchor), for the trial; lyT left at its words, which follow the
    // texts.
    law LBHNTX
    jda lyWd
    dac i [rwTx:2]
    law LBHCOST
    jda lyWd
    dac i [txDrCo:012]
    dzm i [rwDig:2]
    lac lbEAt
    add [LBHDRW]
    dac lyT
    lac i [rwTx:2]
    sza i               // skip if it has texts
    jmp lyTxN
    cma
    dac lyC
lyTx,
    lac lyT
    add [5 + TXRUN]
    dac lyQ
    lac i lyQ
    sad [NOPOINT]       // skip if digits
    jmp lyTxD
    law 1
    dac i [rwDig:2]
lyTxD,
    lac lyT
    add [LBTXW]
    dac lyT
    isp lyC             // skip once every text is looked at
    jmp lyTx
lyTxN,

    // Its words into the master's slot in the store, then the trial.
    lac lbK
    add [mStart:5]
    dac lyP
    lac [MNOPOOL]
    dac i lyP
    jsp i [poolRoom:7]
    spa                 // skip if the store has room
    jmp lyNoRm
    dac i lyP
    dac i [msAddr:7]
    jsp i [msAddr:7+1]
    dac lyQ
    lac lyN
    cma
    dac lyC
lyCp,
    lac i lyT
    dac i lyQ
    idx lyT
    idx lyQ
    isp lyC             // skip once every word is copied
    jmp lyCp
    lac lbK
    dac i [rwK:2]
    law RWLIB
    dac i [rwOp:2]
    jsp i [rwRun:7]
    dac lyT
    jsp lyBack
    lac lyT
    sza                 // skip if the masters holding it can take it
    jmp lyRef
    law LBPAGAIN
    dac lbPhase
    jsp lyCall
    sas [TSLLOADED]     // skip if loaded
    jmp lyEnd
    lac lbK
    dac i [rwK:2]
    law RWCOM
    dac i [rwOp:2]
    jsp i [rwRun:7]
    lac [TSLLOADED]
    jmp lyEnd
lyNoRm,
    jsp lyBack
    lac lbK
    dac i [rwWho:2]
    law DEFPROOM
lyRef,
    sub [DEFPBIG]
    add [lyMap:2]
    dac lyT
    lac i lyT
    dac lbRes
    law LBPSHOW
    dac lbPhase
    jsp lyCall
    lac lbRes
lyEnd,
    dzm lbPhase
    jmp i teStubR

    // The overlay's save or load, the master's record resident, and each record it asks for
    // after. Exit: AC = its result. Called via jsp.
lyCall,
    dap lyCr
    lio lbK
lyCl,
    jsp i [mrLoadX:7]
    lio teArg
    %%ovcall library, libEntryOv
    sas [TSMORE]        // skip if the overlay asks for master tpK's record
lyCr, jmp .
    lio tpK
    jmp lyCl

    // The master's own length and count before its crosses back, and it out of the store.
    // Called via jsp.
lyBack,
    dap lyBr
    lac lbK
    add [mLen:5]
    dac lyP
    lac lyOL
    dac i lyP
    lac lbK
    add [mDrawLen:5]
    dac lyP
    lac lyOD
    dac i lyP
    lac lbK
    add [mStart:5]
    dac lyP
    lac [MNOPOOL]
    dac i lyP
lyBr, jmp .

    // The entry's word at offset AC in lbEBuf, which the first call gave (lbEAt). Called via jda.
lyWd, 0
    dap lyWr
    lac lyWd
    add lbEAt
    dac lyWp
    lac i lyWp
lyWr, jmp .
lyWp, 0

    // The trial's refusals, DEFPBIG to DEFPDIGIT, as the library's, are bank 2's lyMap
    // (sketchpad.am1), for this bank's room.
lyB, 0
lyK, 0
lyT, 0
lyN, 0
lyOL, 0
lyOD, 0
lyP, 0
lyQ, 0
lyC, 0
    endloc

// Library's rows, for the tape module's tapeStep, which aims tsGo at the next step and runs it
// with the answer in tsAns. Load, Dir and Delete read page lbPage of the directory (TELDIR) and
// open the library's screen on it (splibdir.ac): Dir's shows it (lbDirBlk), Load's and Delete's
// pick a line (lbLdPick, lbDlPick). Next and Prev turn the page and read it again; the read
// brings it back to the last page with an entry, or to the first (lbShow). A line picked is
// slot lbSlot. Delete deletes it (TELDEL). Load opens the masters' picker for its row (the
// instance module's instKbOpen), a master the drawing calls dim, and loads the entry into the
// master picked, lbK (TELLOAD). Save opens the masters' picker, a master with no words dim, then
// the keyboard on the name, lbName (lbSvBlk): the master's name, or as last saved when the
// master's is blank; it saves master lbK at OK (TELSAVE), and once saved writes the name saved
// to the master's line. A read that fails, a Cancel, or the last entry's result ends the row
// (tsEnd).
// Entry: AC = the row, LBRLOAD to LBRDEL, tsItem its item, for its first step. Exit as
// tapeStep's. Reached by jmp, from tapeStep.
libStep,
    local lyOpen, lyPick, lyTurn, lyPrev, lyRead, lyDel, lySave, lyPkr, lyMast, lySvPk, lySvOK
    addlocal lySvKb, lySvEnd, lyLine, lyLnR, lyMove, lyMvL, lyMvR, lyT, lyFrom, lyTo
    sad [LBRSAVE]       // skip unless Save's row
    jmp lySave
    law lyOpen
    dap tsGo
    law i TELDIR
    jmp i tsRtn

    // The page read: the row's screen on it.
lyOpen,
    lac tsAns
    sas [TSOPEN]        // skip if the read succeeded
    jmp tsEnd
    law lyPick
    dap tsGo
    lac tsItem
    sub [ILIB]
    add [lbRowScr:013]
    dac lyT
    lac i lyT
    jmp i tsRtn
lbRowScr,               // the row's screen
    lbLdPick:5          // Load
    0                   // Save, which reads no page
    lbDirBlk:5          // Dir
    lbDlPick:5          // Delete

    // The screen closed: Next or Prev turns the page, a line picks its slot.
lyPick,
    lac tsAns
    sza i               // skip if a key was picked, not Cancel or Dir's OK
    jmp tsEnd
    lac i [kbPick:6]
    sub [LBPLINE]
    spa                 // skip if a line
    jmp lyTurn
    dac lyT
    lac lbPage
    sal 4s              // LBLINES slots a page
    add lyT
    dac lbSlot
    lac tsItem
    sad [ILIB + LBRDEL] // skip unless Delete's row
    jmp lyDel
    law lyMast
    dap tsGo
    lac [ILBLOAD]
    jmp lyPkr
lyDel,
    law tsEnd
    dap tsGo
    law i TELDEL
    jmp i tsRtn
lyTurn,
    lac i [kbPick:6]
    sas [LBPNEXT]       // skip if Next
    jmp lyPrev
    idx lbPage
    jmp lyRead
lyPrev,
    lac lbPage
    sub [1]
    dac lbPage
lyRead,
    law lyOpen
    dap tsGo
    law i TELDIR
    jmp i tsRtn

    // Save's row: the masters' picker, then (lySvPk) the keyboard on the name.
lySave,
    law lySvPk
    dap tsGo
    lac [ILBSAVE]
lyPkr,
    dac i [instCall:4]
    lio [IEKBOPEN]
    jsp i [instEntry:7]
    jmp i tsRtn

    // Load's masters' picker closed: the entry loaded into the master picked.
lyMast,
    lac tsAns
    sza i               // skip if a master was picked
    jmp tsEnd
    lac i [kbPick:6]
    dac lbK
    law tsEnd
    dap tsGo
    law i TELLOAD
    jmp i tsRtn

    // Save's masters' picker closed: the keyboard on the name for the master picked.
lySvPk,
    lac tsAns
    sza i               // skip if a master was picked
    jmp tsEnd
    lac i [kbPick:6]
    dac lbK
    jsp lyLine
    dac lyFrom
    lac i lyFrom
    sad [KBPAD]         // skip unless the master's name is blank
    jmp lySvKb
    lac [lbName:013]
    dac lyTo
    jsp lyMove
lySvKb,
    law lySvOK
    dap tsGo
    lac [lbSvBlk:5]
    jmp i tsRtn

    // Save's keyboard closed: OK saves the master under the name typed.
lySvOK,
    lac tsAns
    sza i               // skip if OK
    jmp tsEnd
    law lySvEnd
    dap tsGo
    law i TELSAVE
    jmp i tsRtn

    // The save's result: once saved, the name saved is the master's too.
lySvEnd,
    lac tsAns
    sas [TSSAVED]       // skip if saved
    jmp tsEnd
    jsp lyLine
    dac lyTo
    lac [lbName:013]
    dac lyFrom
    jsp lyMove
    jmp tsEnd

    // Master lbK's name's run on the masters' picker (bank 5, mpkL), from the picker's keys' table.
    // Exit: AC = the run's 16-bit address. IO is preserved. Called via jsp.
lyLine,
    dap lyLnR
    lac lbK
    add [mpkBlkT:013 + 1]
    dac lyT
    lac i lyT
    add [MPKTAG]
lyLnR, jmp .

    // Copy a name's run, NAMEW words, from lyFrom to lyTo, 16-bit addresses.
    // AC is clobbered, IO preserved. Called via jsp.
lyMove,
    dap lyMvR
    law i NAMEW
    dac lyT
lyMvL,
    lac i lyFrom
    dac i lyTo
    idx lyFrom
    idx lyTo
    isp lyT             // skip once the run is copied
    jmp lyMvL
lyMvR, jmp .
lyT, 0
lyFrom, 0
lyTo, 0
    endloc
