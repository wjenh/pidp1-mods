// sprows.ac -- which menu rows can act, a row's answer from the census. A row that cannot act
// is drawn dim and passed over by the pen, so a user sees what is possible. spmenus.ac's
// paintAny, onListHit and selectRow ask. Which masters a row can take, the masters' picker shows
// (the instance module's mpkLines).
//
// Bank 9, after the constraint table. Entered from the main bank at rowCan, by jsp i
// [rowCan:011], with the item in rowItem; runs with the extend window open, reading the census
// (bank 11's rowHave) through its 16-bit address, and calls nothing.
// Part of sketchpad.am1, included where it stands.

// The item asked about, written by the main bank before it calls rowCan.
rowItem, 0

// Whether item rowItem's row can act: every test its rowNeeds word names must be in the census;
// a word of ROWLI, either of two.
// Exit: AC positive when the row can act, negative when it cannot (0, drawn dim and acting, is
// no longer given). IO is preserved. Called via jsp i [rowCan:011].
rowCan,
    local rnRtn, rnYes, rnNo, rnDim, rnP
    dac rnRtn
    lac rowItem
    add [rowNeeds:011]
    dac rnP
    lac i [rowHave:013]
    cma
    and i rnP
    sza                 // skip if every test the row needs is passed
    jmp rnNo
rnYes,
    law 1
    jmp i rnRtn
rnNo,
    lac i rnP
    sas [ROWLI]         // skip if two lines or an instance would do
    jmp rnDim
    lac i [rowHave:013]
    and [ROWI | ROWL2]
    sza                 // skip if neither
    jmp rnYes
rnDim,
    law i 1
    jmp i rnRtn
rnRtn, 0
rnP, 0
    endloc

// Item number -> the census's tests its row needs (sketchpad.ah's ROWANY to ROWVIEW), 0 for a
// row that always acts; in itemAct's order (sketchpad.am1). A row owning a sublist needs what
// every row of its sublist needs in common, so it is disabled only when they all are.
rowNeeds,
    0                   // Draw: Line
    0                   // Draw: Circle
    0                   // Draw: Truss >, its Forces always acting
    0                   // Draw: Text
    0                   // Draw: Dim >, its Number always acting
    ROWANY              // Edit: Move
    ROWANY              // Edit: Delete
    0                   // Edit: Constr >, its Show always acting
    ROWIT               // Edit: Size >
    ROWANY              // Edit: Scale, as Move
    ROWM1               // Edit: Change >, as its Dwell and Seq
    ROWI                // Edit: Dismem
    ROWLI               // Edit: Keep >
    ROWLAI              // Picture: Define, texts alone refused (defineMasterOv's DEFEMPTY)
    ROWM1               // Picture: Inst, a master defined
    ROWM1               // Picture: Copy, likewise
    0                   // Picture: Clear, always
    ROWP1               // Picture: Tie
    ROWP1               // Picture: Desig
    ROWM1               // Picture: Name, a master defined
    ROWIT               // Size: x1
    ROWIT               // Size: x2
    ROWIT               // Size: x4
    ROWIT               // Size: x8
    0                   // Misc: Save
    0                   // Misc: Load, only a tape read could tell
    0                   // Misc: Drive >
    0                   // Misc: Dir
    ROWDEL              // Misc: Del cons
    ROWUNF              // Misc: Unfix
    0                   // Misc: Library >, its Load, Dir and Delete always acting
    ROWANY              // Misc: Plot, a point, a text or an instance to draw
    0                   // Drive: D1
    0                   // Drive: D2
    0                   // Drive: D3
    0                   // Drive: D4
    0                   // Drive: D5
    0                   // Drive: D6
    0                   // Drive: D7
    0                   // Drive: D8
    ROWL1               // Constr: Horv
    ROWL2               // Constr: Equal, two lines that are one refused
    ROWL2               // Constr: Paral
    ROWL2               // Constr: Perp
    ROWL1               // Constr: Length
    ROWL1 | ROWP3       // Constr: Mid, a point off the line
    ROWP1               // Constr: Fix
    0                   // Constr: Show
    ROWFREEL            // Truss: Beam
    ROWB | ROWFREEL     // Truss: Load, sharing a member's point
    ROWP1               // Truss: Roller
    ROWO | ROWL1        // Truss: Axis
    0                   // Truss: Forces
    ROWB                // Truss: Stiff
    ROWI | ROWM1        // Change: Master
    ROWI | ROWM2        // Change: Cycle
    ROWM1               // Change: Dwell
    ROWM1               // Change: Seq
    0                   // Dim: Number
    ROWP2 | ROWN        // Dim: Dist
    ROWP2 | ROWN        // Dim: Change
    ROWP1 | ROWN        // Dim: Gap
    ROWI | ROWN         // Dim: Size
    0                   // View: x1
    0                   // View: x2
    0                   // View: x4
    0                   // View: x8
    ROWVIEW             // View: Pan, nothing at x1
    ROWVIEW             // View: Center
    0                   // Library: Load, only a tape read could tell
    ROWM1               // Library: Save, a master defined
    0                   // Library: Dir
    0                   // Library: Delete, as Load
    ROWLI               // Keep: x1/3
    ROWLI               // Keep: x1/2
    ROWLI               // Keep: x1
    ROWLI               // Keep: x2
    ROWLI               // Keep: x3
    ROWI                // Keep: Full
    ROWI                // Keep: Inch
