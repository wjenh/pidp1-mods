    lac [cEntries:011]
    dac soE
soFLoop,
    lac soE
    sad i [cEnd:010]    // skip while entries remain
    jmp soStart
    lac i soE
    sas [CTSZNUM]       // skip if a Z
    jmp soFN
    lac soE
    add [1]
    dac soT
    lac i soT
    sad [NOPOINT]       // skip unless its instance is gone
    jmp soFN
    sub [MAXPTS]
    add [szV:6]
    dac soT
    lac i soT
    sza i               // skip if its size is known
    jmp soFN
    dac soV
    lac soE
    jda szScOf
    sad [NOPOINT]       // skip if it has a scalar
    jmp soFN
    dac soS
    add [scFix:3]
    dac soT
    lac i soT
    sza                 // skip unless set
    jmp soFN
    lac soS
    add [scVal:3]
    dac soT
    lac soV
    mul [0d1000]
    div [SZUNIT * SZINCHU]
    cla                 // no skip means overflow, which a size on the screen cannot make
    sad i soT           // skip if it changed
    jmp soFN
    dac i soT
    law 1
    dac i [cScChg:010]
soFN,
    lac soE
    add [CW]
    dac soE
    jmp soFLoop
soStart,
    law 1
    dac i [vaHold:011]
    dzm i [szIdx:3]
    jmp sfSeek
soOff,
    law TXSOFF
    jmp sfNo
soCon,
    law TXSCONF
    jmp sfNo

// The next instance whose words are wanted; with none left, every size is set.
sfSeek,
    lac i [szIdx:3]
    sad i [instCount:012] // skip while instances remain
    jmp sfAll
    add [szW:3]
    dac soT
    lac i soT
    sas [SZSAME]        // skip unless a new word
    jmp sfHave
    idx i [szIdx:3]
    jmp sfSeek
sfHave,
    lac i [szIdx:3]
    dac i [vaRecI:2]
    law 1
    jmp i rtn

// With instance szIdx's record resident, its words made ready.
szStepOv,
    dac rtn
    lac i [szIdx:3]
    add [szW:3]
    dac soT
    lac i soT
    dac scBW
    lac i [szIdx:3]
    add [iMaster:012]
    dac soT
    lac i soT
    jda scReady
    sza                 // skip if its words are in the store
    jmp sfRoom
    idx i [szIdx:3]
    jmp sfSeek
sfRoom,
    law TXSFULL
    jmp sfNo

sfAll,
    dzm sfI
    lac i [instCount:012]
    sza i               // skip if there are instances
    jmp sfEnd
    cma
    dac soN
sfLoop,
    lac sfI
    add [szW:3]
    dac soT
    lac i soT
    sad [SZSAME]        // skip if a new word
    jmp sfNext
    dac i [sizeArg:4]
    lac sfI
    dac i [penInst:4]
    add [iScale:3]
    dac soT
    lac sfI
    add [uSz:3]
    dac soS
    lac i soT
    dac i soS
    lio [IESIZE]
    jda scIEnt
    sas [3]             // skip if its tie points moved
    jmp sfBad
    lio [MCJDA(arcCall:4)]
    law AECARRY
    jda scMain
    sza i               // skip if an arc could not follow
    jmp sfNext
    lio [IESZBACK]
    jda scIEnt
sfBad,
    sza                 // skip if the size is set
    jmp soCon
sfNext,
    idx sfI
    isp soN             // skip once every instance is looked at
    jmp sfLoop
sfEnd,
    lac i [szRet:3]
    sza                 // skip unless this was a going back
    jmp sfDone
    law 1
    dac i [szUG:3]
sfDone,
    dzm i [vaHold:011]
    lac i [szArg:3]
    dac i [sizeArg:4]
    dzm i [szDirty:3]
    dzm i [szNew:3]
    dzm i [szRet:3]
    cla
    jmp i rtn

    // A refusal: AC = the word to show.
sfNo,
    dac soS
    lac i [szRet:3]
    sza                 // skip unless this was a going back
    jmp sfDone
    lac soS
    dac i [txCall:4]
    lio [TXSAY]
    jsp i [txEntry:012]
    jsp sfCopy
    lac sfSrc
    sub [1]
    dac soT
    sub [MAXINST]
    sma                 // skip if an instance is the source
    jmp sfNoSrc
    lac sfPrv
    sad [NOPOINT]       // skip if it has a size to go back to
    jmp sfNoSrc
    dac soS
    lac soT
    add [szW:3]
    dac soT
    lac soS
    dac i soT
sfNoSrc,
    lac i [szNew:3]
    sza i               // skip if a new entry is refused
    jmp sfGo
    lio [CEUNDO]
    jda scCon
    lio [MCJSP(undoClear:4)]
    jda scMain
    lio [MCJSP(conShow:4)]
    jda scMain
sfGo,
    jmp sfSeek

// Undo of a group's change: the words before go back.
szBackOv,
    dac rtn
    lac i [sizeArg:4]
    dac i [szArg:3]
    jsp sfCopy
    jmp sfSeek

    // szW from uSz, uSz cleared, for a going back from the first instance.
sfCopy,
    dap sfCpR
    lac [szW:3]
    dac soP
    lac [uSz:3]
    dac soQ
    law i MAXINST
    dac soN
sfCpL,
    lac i soQ
    dac i soP
    lac [SZSAME]
    dac i soQ
    idx soP
    idx soQ
    isp soN             // skip once every word is copied
    jmp sfCpL
    law 1
    dac i [szRet:3]
    dac i [vaHold:011]
    dzm i [szIdx:3]
sfCpR, jmp .
rtn, 0
soE, 0
soT, 0
soS, 0
soV, 0
soN, 0
soP, 0
soQ, 0
soR, 0
sfI, 0
sfSrc, 0
sfPrv, 0
    endloc

// The ratios of an S, by its index: A is B times szNum / szDen. Then the working words: the sizes
// known, szV, the instance and value szPut takes, whether a pass told anything, whether two sizes
// disagree.
szNum,
    1
    1
    1
    2
    3
szDen,
    3
    2
    1
    1
    1
szVal, 0
szWho, 0
rxCh, 0
szBad, 0
szV,
    table MAXINST, 0

// Call a main-bank routine through its trampoline mainCall, given the routine's call, a jsp or
// a jda, as an instruction word (MCJSP, MCJDA), and AC a; mainCall's mcI, the IO it is called with,
// is left as the last caller set it, since nothing here calls a routine that reads IO.
// Entry: AC = a, IO = the call. Exit: AC as the routine leaves it. IO is clobbered. Called via
// jda.
scMain, 0
    local rtn
    dap rtn
    lac scMain
    dac i [mcA:4]
    jsp i [mainCall:4]
rtn, jmp .
    endloc

// Call entry n of the constraint module with argument a, as the main bank's conCall does, the
// argument in conCall's word, where conEntry reads it.
// Entry: AC = a, IO = n. Exit: AC as the entry leaves it. IO is clobbered. Called via jda.
scCon, 0
    local rtn
    dap rtn
    lac scCon
    dac i [conCall:4]
    jsp i [conEntry:010]
rtn, jmp .
    endloc

// Call entry n of the instance module with argument a, as the main bank's instCall does, the
// argument in instCall's word, where instEntry reads it.
// Entry: AC = a, IO = n. Exit: AC as the entry leaves it. IO is clobbered. Called via jda.
scIEnt, 0
    local rtn
    dap rtn
    lac scIEnt
    dac i [instCall:4]
    jsp i [instEntry:7]
rtn, jmp .
    endloc
%%endoverlay

// The main bank's six entries, root stubs calling the overlay's (scActOv to scUndoOv) through
// the drum overlay manager, which reads the overlay into W first if W holds another. With
// Scale's Figure or All chosen (scSel SCSGROUP) they call the overlay gscale's one entry instead
// (spgscale.ac's gsEntOv, scGrp), through bank 5's root loop gsRun, which writes the instances
// again between its calls, and an Undo of a group's scale (scUKind SCKGROUP) calls it whatever
// scSel is. IO passes through to the entry; no caller reads the AC that comes back.
// scDone calls nothing with no part held (scOn, which gscale keeps too), so a mode change loads
// nothing, and the one call of it from inside an overlay, when its act entry's call of setMode
// reaches setMode's hook, finds scOn 0, put down by the act entry, and returns; it has its own
// return word, since it then runs inside scAct's call. scAct puts down a part held, in the
// overlay that holds it, before it changes scSel for the row chosen.
// Entry: IO as the overlay's entry. Called via jsp i [X:6], or a jmp i from a routine so called,
// from the main bank.
scAct,
    dac saStubR
    jsp scDone
    lac i [lastItem:4]
    sub [ISCFIG]
    dzm scSel
    sma                 // skip unless Scale's Figure or All, the items from ISCFIG on
    idx scSel
    law 0
    jda scGrp
    %%ovcall scale, scActOv
    jmp i saStubR
scTarget,
    dac saStubR
    law 1
    jda scGrp
    %%ovcall scale, scTargetOv
    jmp i saStubR
scLost,
    dac saStubR
    law 2
    jda scGrp
    %%ovcall scale, scLostOv
    jsp i [vaRec:2]   // the record of an instance just picked up, none after a group
    jmp i saStubR
scEnd,
    dac saStubR
    law 3
    jda scGrp
    %%ovcall scale, scEndOv
    jmp i saStubR
scUndo,
    dac saStubR
    lac scUKind
    sad [SCKGROUP]      // skip unless a group's scale goes back
    jmp suGrp
    sas [SCKINST]       // skip if an instance's size goes back
    jmp suStub
    lac scUInst
    dac i [vaRecI:2]
    jsp i [vaRec:2]
suStub,
    %%ovcall scale, scUndoOv
    jsp i [szUnd:013]   // the sizes of a group it moved
    jmp i saStubR
suGrp,
    law 4
    dac scGrp           // the entry gsEntOv runs, Undo
    jsp i [gsRun:5]
    jmp i saStubR
scDone,
    dac sdStubR
    lac scOn
    sza i               // skip if a part is picked up
    jmp i sdStubR
    law 5
    jda scGrp
    %%ovcall scale, scDoneOv
    jmp i sdStubR
saStubR, 0
sdStubR, 0

// Which overlay Scale mode runs, SCSPART's scale or SCSGROUP's gscale, set by scAct from the row
// chosen.
scSel, 0

// A stub's call of gscale. With scSel SCSGROUP, call gscale's entry n through bank 5's root loop
// gsRun, which calls it through the manager, and return past the stub's own call of scale's
// entry, the 4 words after the jda; else return at once. The word scGrp keeps n for gsEntOv: 0
// act, 1 target, 2 lost, 3 end, 4 undo, 5 done.
// Entry: AC = n. Exit: AC and IO clobbered. Called via jda, from the stubs.
scGrp, 0
    local rtn
    dap rtn
    lac scSel
    sza i               // skip if a group's scale runs
    jmp rtn
    jsp i [gsRun:5]
    lac rtn
    add [4]             // past the stub's call of scale's entry
    dac rtn
rtn, jmp .
    endloc
