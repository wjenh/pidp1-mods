    jmp soWN
    lac szWho
    jda szSide
    sza i               // skip if its master has a size
    jmp soWN
    dac soS
    lac soV
    mul [SZONE / SZUNIT]
    div soS
    jmp soOff           // no skip means overflow
    dac soV
    sub [SZLOW]
