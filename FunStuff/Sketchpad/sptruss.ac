// The forces, a member at a time from taFM. Each is e . (u_B - u_A), times its stiffness when
// that is not 1.0 (taKOf), its magnitude plus a half truncated (fRnd), the sign put back; past
// 17 bits or TAMAXF, too large (taLarge). With an end
// on a roller whose axis is not level (taMI), its first unknowns' part is c_B u_B - c_A u_A
// (tdC's coefficients) in place of (u_B - u_A)_x e_x.
taPForce,
    local foTilt, foY, foRnd, foPlus, foStore, foU, fuZero, fuRtn, foA, foB, foE, foM, foP, foC, \
        foK
    lac taFM
    sad taNM            // skip while members remain
    jmp taOK
    jda taKOf
    dac foK
    lac taFM
    add [taJA:013]
    dac foP
    lac i foP
    dac foA
    lac taFM
    add [taJB:013]
    dac foP
    lac i foP
    dac foB
    lac taFM
    add taFM
    dac foE
    add foE
    add foE
    add [tdE:016]
    dac foE
    lac taFM
    add [taMI:3]
    dac foP
    lac i foP
    sza                 // skip unless an end is a roller on an axis not level
    jmp foTilt

    // (u_B - u_A)_x e_x, then plus (u_B - u_A)_y e_y.
    lac i foB
    jda foU
    jda faLd
    lac i foA
    jda foU
    jda fbLd
    jsp fbNeg
    jsp fAdd
    lac foE
    jda fbLd
    jsp fMul
    lac [foT:013]
    jda faSt
foY,
    lac foB
    add [TANJ+1]
    dac foP
    lac i foP
    jda foU
    jda faLd
    lac foA
    add [TANJ+1]
    dac foP
    lac i foP
    jda foU
    jda fbLd
    jsp fbNeg
    jsp fAdd
    lac foE
    add [3]
    jda fbLd
    jsp fMul
    lac [foT:013]
    jda fbLd
    jsp fAdd
    lac foK
    sza i               // skip if a stiffness not 1.0
    jmp foRnd
    lac [taK:013]
    jda fbLd
    jsp fMul
foRnd,
    jsp fRnd
    spa                 // skip unless past 17 bits
    jmp taLarge
    dac foM
    sub [TAMAXF+1]
    sma                 // skip unless past TAMAXF
    jmp taLarge
    lac fpSg
    sza i               // skip if a compression
    jmp foPlus
    cla
    sub foM
    jmp foStore
foPlus,
    lac foM
foStore,
    dac foM
    lac taFM
    add [taF:013]
    dac foP
    lac foM
    dac i foP
    idx taFM
    lac [taPForce:013]
    jmp taGo

