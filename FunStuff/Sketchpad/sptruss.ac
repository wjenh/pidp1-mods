// Compare the truss's entries and their points with the snapshot, writing it anew (taSnap): each
// Fix's and Roller's type and point, a Roller's axis (taRlD), and each Beam's and Load's type,
// points, parameter word (a Beam's stiffness) and its points' places.
// Exit: AC nonzero if a word, or the snapshot's length, differs. IO is clobbered. Called via jsp.
taCheck,
    local rtn, ckLoop, ckSup, ckLine, ckNext, ckEnd, ckPt, ckPRtn, ckNew, ckNRtn, ckE, ckN, \
        ckW, ckS, ckDiff, ckA, ckB
    dap rtn
    dzm ckDiff
    lac [taSnap:015]
    dac ckS
    lac [cEntries:011]
    dac ckE
    lac i [cCount:011]
    sza i               // skip if the table holds entries
    jmp ckEnd
    cma
    dac ckN
ckLoop,
    lac i ckE
    sad [CTF]           // skip unless a Fix
    jmp ckSup
    sad [CTROLL]        // skip unless a Roller
    jmp ckSup
    sad [CTBEAM]        // skip unless a Beam
    jmp ckLine
    sad [CTLOAD]        // skip unless a Load
    jmp ckLine
ckNext,
    lac ckE
    add [CW]
    dac ckE
    isp ckN
    jmp ckLoop
ckEnd,
    lac ckS
    sas taSnapE         // skip if the snapshot's length is the same
    dac ckDiff
    dac taSnapE
    lac ckDiff
rtn, jmp .
ckSup,
    sas i ckS           // skip if the snapshot has the word
    jda ckNew
    idx ckS
    lac ckE
    add [1]
    dac ckW
    lac i ckW
    sas i ckS           // skip if the snapshot has the word
    jda ckNew
    idx ckS
    lac i ckE
    sas [CTROLL]        // skip if a Roller, whose axis is its line's direction (taRlD)
    jmp ckNext
    lac ckE
    jda taRlD
    lac rlX
    sas i ckS           // skip if the snapshot has the word
    jda ckNew
    idx ckS
    lac rlY
    sas i ckS           // skip if the snapshot has the word
    jda ckNew
    idx ckS
    jmp ckNext
ckLine,
    sas i ckS           // skip if the snapshot has the word
    jda ckNew
    idx ckS
    lac ckE
    add [1]
    dac ckW
    lac i ckW
    dac ckA
    sas i ckS           // skip if the snapshot has the word
    jda ckNew
    idx ckS
    idx ckW
    lac i ckW
    dac ckB
    sas i ckS           // skip if the snapshot has the word
    jda ckNew
    idx ckS
    lac ckE
    add [5]
    dac ckW
    lac i ckW
    sas i ckS           // skip if the snapshot has the word
    jda ckNew
    idx ckS
    lac ckA
    jda ckPt
    lac ckB
    jda ckPt
    jmp ckNext

