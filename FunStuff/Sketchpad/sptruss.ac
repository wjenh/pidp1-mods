foTilt,
    lac foE
    sub [tdE:016]
    add [tdC:015]
    dac foC
    lac i foB
    jda foU
    jda faLd
    lac foC
    add [3]
    jda fbLd
    jsp fMul
    lac i foA
    jda foU
    dac foP
    lio foP
    lac foC
    jda fMS
    lac [foT:013]
    jda faSt
    jmp foY

// AC = the address of unknown AC's displacement in tdY, or of zero (tdZ) when AC is -1.
