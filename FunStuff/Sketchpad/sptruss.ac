// K[i][k] K[j][k] for each k from the later of the two rows' firsts, a term a step (taPFk);
// then the pivot. D = K[i][i], and for each j, l = K[i][j] / D_j (1/D_j from tdRD) put in
// K[i][j]'s place and D less K[i][j] l, a j a step (taPFd). D not positive, or not over 2^-23
// K[i][i], is a mechanism; otherwise 1/D goes to tdRD.
taPFac,
    local fcLoad, fcStore, fcDiag, fcPiv, fcDone, fcBi, fcFi, fcBj, fcE, fcEii, fcT, fcP
    lac taFI
    sad taNU            // skip while rows remain
    jmp fcDone
    add taFI
    add [tdU:016]
    dac fcP
    lac i fcP
    dac fcBi
    idx fcP
    lac i fcP
    dac fcFi
    dac taFJ
taPFj,
    lac taFJ
    sad taFI            // skip unless the diagonal is reached
    jmp fcDiag
    add taFJ
    add [tdU:016]
    dac fcP
    lac i fcP
    dac fcBj
    idx fcP
    lac i fcP
    dac taFK
    sub fcFi
    sma                 // skip if this row's first is the later
    jmp fcLoad
    lac fcFi
    dac taFK
fcLoad,
    lac taFJ
    add taFJ
    add taFJ
    add fcBi
    dac fcE
    jda faLd
taPFk,
    lac taFK
    sad taFJ            // skip while terms remain
    jmp fcStore
    add taFK
    add taFK
    dac fcT
    add fcBj
    lia
    lac fcT
    add fcBi
    jda fMS
    idx taFK
    lac [taPFk:013]
    jmp taGo8
fcStore,
    lac fcE
    jda faSt
    idx taFJ
    lac [taPFj:013]
    jmp taGo

fcDiag,
    lac taFI
    add taFI
    add taFI
    add fcBi
    dac fcEii
    jda faLd
    lac [taD:3]
    jda faSt
    lac fcFi
    dac taFJ
taPFd,
    lac taFJ
    sad taFI            // skip while entries remain
    jmp fcPiv
    add taFJ
    add taFJ
    dac fcT
    add fcBi
    dac fcE
    jda faLd
    lac fcT
    add [tdRD:016]
    jda fbLd
    jsp fMul
    lac [taL:3]
    jda faSt
    lac [taD:3]
    jda faLd
    lio [taL:3]
    lac fcE
    jda fMS
    lac [taD:3]
    jda faSt
    lac [taL:3]
    jda faLd
    lac fcE
    jda faSt
