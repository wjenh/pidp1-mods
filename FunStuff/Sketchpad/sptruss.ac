// The readouts. taFin starts the list's writing for the analysis' state at AC (TAOK or
// TABAD), or for Stiff mode's view (TASTIFF); taPShow waits until a frame has ended since the
// readouts were hidden, then writes one readout a step, in the table's order: a Beam's force
// (taF, the members in the same order) or a Load's magnitude, or three dashes for each with no
// answer; in Stiff mode's view a Beam's stiffness, and nothing for a Load. Then UNSTABLE, with no
// answer, and the list's halt; then the readouts are shown, and the state set, but for Stiff
// mode's view, which is no analysis. A change of the magnifier's view writes the list again
// from taFinGo (taRedo), not counted either.
taFin,
    dac roRes
    dzm roRedo
taFinGo,
    dzm roOK
    dzm roUw
    dzm roK
    lac [cEntries:011]
    dac roE
    lac i [cCount:011]
    sza                 // skip if the table is empty, roN 0 and no entry seen
    cma
    dac roN
    lac [roList:015]
    dac roP
    lac [taPShow:013]
    dac taPhase
taPShow,
    local psNext, psBeam, psStf, psLoad, psPut, psMore, psDone, psCopy, psHalt, psT, psN
    lac i [frameTotal:4]
    sad roHideF         // skip unless no frame has ended since the readouts were hidden
    jmp i taRtn
    sub roHideF
    sad [1]             // skip unless only one has, which may have begun before
    jmp i taRtn
    lac roN
    sza i               // skip if the table holds entries
    jmp psDone
roLoop,
    lac roE
    dac roW
    add [CW]
    dac roE
    lac i roW
    sad [CTBEAM]        // skip unless a Beam
    jmp psBeam
    sad [CTLOAD]        // skip unless a Load
    jmp psLoad
psNext,
    isp roN             // skip once every entry is seen
    jmp roLoop
    jmp psDone
psBeam,
    jsp roMid
    lac roRes
    sad [TASTIFF]       // skip unless Stiff mode's view
    jmp psStf
    lac roK
    add [taF:013]
    dac psT
    idx roK
    lac i psT
    jmp psPut
psStf,
    lac roW
    add [5]
    dac psT
    lac i psT
    and [0377777]
    sza i               // skip unless 1.0, kept as CUNUSED alone
    law STIFFONE
    jmp psPut
psLoad,
    lac roRes
    sad [TASTIFF]       // skip unless Stiff mode's view, which shows no load
    jmp psNext
    jsp roMid
    jsp roLen
psPut,
    dac roV
    jsp roPut
    isp roN             // skip once every entry is seen
    jmp psMore
    jmp psDone
psMore,
    lac [roLoop:013]
    jmp taGo
psDone,
    lac roRes
    sas [TABAD]         // skip if no answer; UNSTABLE follows the readouts
    jmp psHalt
    lac roP
    dac roUw
    lac [roUnst:013]
    dac psT
    law i 6
    dac psN
psCopy,
    lac i psT
    dac i roP
    idx psT
    idx roP
    isp psN
    jmp psCopy
    jsp roGate
psHalt,
    lac [lpoff halt interrupt]
    dac i roP
    law 1
    dac roOK
    dac i [roOn:0]
    lac roRedo
    sza                 // skip unless written again for the view, no state, no analysis counted
    jmp taStill
    lac roRes
    sad [TASTIFF]       // skip unless Stiff mode's view, no state, and no analysis counted
    jmp taStill
    dac taState
    jmp taEnd
psT, 0
psN, 0
    endloc

// A change of the magnifier's view, from the view module's vwEntry. The readouts are written
// again through it, from the state they show, with no new analysis. A list
// written whole (roOK) is hidden and written again at the next pass that runs (taRw), counted as
// no analysis (roRedo); a list being written starts again (taFinGo), counted or not as it was.
// An analysis under way writes its list through the new view when it ends.
// AC and IO are clobbered. Called via jsp i [taRedo:013].
taRedo,
    local rdRtn, rdAgain, rdGo
    dac rdRtn
    lac roOK
    sza i               // skip if the list is written whole
    jmp rdAgain
    dzm roOK
    jsp roHide
    lac [taRw:013]
    dac taPhase
    jmp i rdRtn
rdAgain,
    lac taPhase
    sad [taPShow:013]   // skip unless waiting to write the list
    jmp rdGo
    sas [roLoop:013]    // skip if writing it
    jmp i rdRtn
rdGo,
    lac [taFinGo:013]
    dac taPhase
    jmp i rdRtn
rdRtn, 0
    endloc

// taRedo's phase for a list written whole, the list again, not counted as an analysis.
taRw,
    law 1
    dac roRedo
    jmp taFinGo

// The readouts hidden. penISR starts them no more, and taPShow will wait for a frame end, which
// the main loop counts in frameTotal, after this pass's.
// AC is clobbered, IO preserved. Called via jsp.
roHide,
    dap rhRtn
    lac i [roOn:0]
    sza i               // skip if the readouts are shown
    jmp rhRtn
    dzm i [roOn:0]
    lac i [frameTotal:4]
    dac roHideF
rhRtn, jmp .

// UNSTABLE's first word, when the list has it (roUw), a halt that ends the frame while the tape's
// word is shown at the same place (msgOn), the word's parameter word otherwise. One word written
// whole, so the display may be in the list.
// AC is clobbered, IO preserved. Called via jsp.
roGate,
    local rtn, rgOn, rgSet
    dap rtn
    lac roUw
    sza i               // skip if UNSTABLE is in the list
    jmp rtn
    lac i [msgOn:4]
    sza i               // skip if the tape's word is shown
    jmp rgOn
    lac [lpoff halt interrupt]
    jmp rgSet
rgOn,
    lac [STATPARAM]
rgSet,
    dac i roUw
rtn, jmp .
    endloc

// The entry at roW's line, its midpoint (roMX, roMY), its ends' sums (roSX, roSY), from which
// roPut places the readout through the view, and its vector from A to B (roDX, roDY).
// AC and IO are clobbered. Called via jsp.
roMid,
    local rtn, rmA, rmB, rmT
    dap rtn
    lac roW
    add [1]
    dac rmT
    lac i rmT
    dac rmA
    idx rmT
    lac i rmT
    dac rmB
    lac rmA
    add [pointX:3]
    dac rmT
    lac i rmT
    dac roMX
    lac rmB
    add [pointX:3]
    dac rmT
    lac i rmT
    dac roDX
    add roMX
    dac roSX
    sar 1s
    dac rmT
    lac roDX
    sub roMX
    dac roDX
    lac rmT
    dac roMX
    lac rmA
    add [pointY:3]
    dac rmT
    lac i rmT
    dac roMY
    lac rmB
    add [pointY:3]
    dac rmT
    lac i rmT
    dac roDY
    add roMY
    dac roSY
    sar 1s
    dac rmT
    lac roDY
    sub roMY
    dac roDY
    lac rmT
    dac roMY
rtn, jmp .
rmA, 0
rmB, 0
rmT, 0
    endloc

// AC = ten times the length of (roDX, roDY), the load's magnitude. It is the root of the sum of
// the tenfold parts' squares by Newton's steps, five, from the larger part plus half the smaller,
// which is no less than the root, so the steps come down to it. Each quotient is at most a part,
// so no division overflows; a line of no length gives 0.
// IO is clobbered. Called via jsp.
roLen,
    local rtn, rlV, rlG, rlStep, rlA, rlB, rlQ, rlI
    dap rtn
    lac roDX
    spa
    cma
    dac rlA
    sal 2s
    add rlA
    sal 1s
    dac rlA
    lac roDY
    spa
    cma
    dac rlB
    sal 2s
    add rlB
    sal 1s
    dac rlB
    lac rlA
    sub rlB
    spa                 // skip unless the vertical part is the larger
    jmp rlV
    lac rlB
    sar 1s
    add rlA
    jmp rlG
rlV,
    lac rlA
    sar 1s
    add rlB
rlG,
    dac rlQ
    sza i               // skip unless the line has no length
    jmp rtn
    law i 5
    dac rlI
rlStep,
    lac rlA
    mul rlA
    div rlQ
    cla                 // no skip is overflow, which no quotient here can make
    dac roV
    lac rlB
    mul rlB
    div rlQ
    cla                 // no skip is overflow
    add roV
    add rlQ
    sar 1s
    dac rlQ
    isp rlI
    jmp rlStep
    lac rlQ
rtn, jmp .
rlA, 0
rlB, 0
rlQ, 0
rlI, 0
    endloc

// A readout at roP, beside its line's midpoint (roMX, roMY) and clear of the line (roDX, roDY).
// It is its parameter, y and x words, then its characters three to a word, ending in the end
// code. The characters are roV in decimal, a minus sign first when negative, leading zeros
// suppressed, or with no answer (roRes) three dashes; in Stiff mode's view roV is tenths, written
// as 2.5, or 2 when the tenths are 0. Characters at the labels' size step 14 units and stand 13
// high, so n of them are 14n - 5 wide. Kept inside the screen.
// AC and IO are clobbered. Called via jsp.
roPut,
    local rtn, rpDash, rpNum, rpTen, rpMag, rpDiv, rpOut, rpPos, rpSteep, rpFlatY, rpClamp, \
        rpXOK, rpYOK, rpPack, rpNext, rpFlush, rpChar, rcRtn, rpD, rpE, rpC, rpN, rpT, rpX, rpY, \
        rpW, rpJ, rpA, rpB, rpF
    dap rtn
    lac [roBuf:013]
    dac rpE
    dzm rpN
    dzm rpF
    lac roRes
    sad [TAOK]          // skip unless the forces are known
    jmp rpNum
    sad [TASTIFF]       // skip unless Stiff mode's view
    jmp rpTen
rpDash,
    law 055
    jda rpChar
    law 055
    jda rpChar
    law 055
    jda rpChar
    jmp rpPos
rpNum,
    lac roV
    sma                 // skip if negative, for a minus sign first
    jmp rpMag
    law 055
    jda rpChar
    lac roV
    cma
    dac roV
    jmp rpMag
rpTen,
    lac roV
    mul [1]
    div [0d10]
    cla                 // no skip is overflow, which a division by 10 cannot make
    dac roV
    dio rpF
rpMag,
    lac [roDig:013]
    dac rpD
rpDiv,
    lac roV
    mul [1]
    div [0d10]
    cla                 // no skip is overflow, which a division by 10 cannot make
    dac roV
    dio i rpD
    idx rpD
    lac roV
    sza                 // skip once the digits are all found
    jmp rpDiv
rpOut,
    law i 1
    add rpD
    dac rpD
    lac i rpD
    add [060]
    jda rpChar
    lac rpD
    sas [roDig:013]     // skip once the first digit is out
    jmp rpOut
    lac rpF
    sza i               // skip if a tenths digit follows
    jmp rpPos
    law KCDOT
    jda rpChar
    lac rpF
    add [060]
    jda rpChar

    // Where. The midpoint on the screen, through the view, is the ends' sum shifted by the
    // scale, halved, less the offset; no readout when it is off the screen or above the view's
    // top. The rest in screen units, a readout keeping its size; the slope's terms are ratios,
    // the same at every scale. Over a flat line (|dx| >= |dy|), centered on x, its bottom ROGAP
    // above the line's highest point under it, which is |dy| (7n - 2) / |dx| above the midpoint
    // at the readout's left or right end; beside a steep line, its middle row at the midpoint's
    // height and its left ROGAP right of the line's farthest point beside it, 7 |dx| / |dy| right
    // of the midpoint. A line of no length (dashes only) has no rise. Each quotient is at most
    // its multiplier, so no division overflows; truncation and the midpoint's halving lose under
    // 2 units of ROGAP. Then kept inside the screen, under the view's top.
rpPos,
    lac i [vwSal:014]
    dac rpT
    lac roSX
    xct rpT
    sar 1s
    sub i [vwOutX:014]
    dac roMX
    spa                 // skip unless left of the screen
    jmp rtn
    sub [0d1024]
    sma                 // skip unless past its right edge
    jmp rtn
    lac roSY
    xct rpT
    sar 1s
    sub i [vwOutY:014]
    dac roMY
    spa                 // skip unless below the screen
    jmp rtn
    sub i [vwTopP:014]
    sma                 // skip unless past the view's top
    jmp rtn
    lac rpN
    sal 3s
    sub rpN
    dac rpT             // 7n
    lac roDX
    spa
    cma
    dac rpA             // |dx|
    lac roDY
    spa
    cma
    dac rpB             // |dy|
    lac rpA
    sub rpB
    spa                 // skip unless the line is steep (|dx| - |dy| negative; equals give +0)
    jmp rpSteep
    lac rpA
    sza i               // skip unless the line has no length
    jmp rpFlatY
    lac rpT
    sub [2]
    mul rpB
    div rpA
    cla                 // no skip is overflow, which no quotient here can make
rpFlatY,
    add roMY
    add [ROGAP]
    dac rpY
    lac roMX
    sub rpT
    add [2]
    dac rpX
    jmp rpClamp
rpSteep,
    law 7
    mul rpA
    div rpB
    cla                 // no skip is overflow, which no quotient here can make
    add roMX
    add [ROGAP]
    dac rpX
    lac roMY
    sub [6]
    dac rpY
rpClamp,
    lac rpX
    spa                 // skip unless past the left edge
    cla
    dac rpX
    lac rpT
    sal 1s
    cma
    add [0d1023]
    dac rpT
    sub rpX
    sma                 // skip if past the right edge's limit
    jmp rpXOK
    lac rpT
    dac rpX
rpXOK,
    lac rpY
    spa                 // skip unless past the bottom edge
    cla
    dac rpY
    lac i [vwTop:014]
    sub [0d14]
    dac rpT             // the top's limit, the readout's height under the view's top
    sub rpY
    sma                 // skip if past the top's limit
    jmp rpYOK
    lac rpT
    dac rpY
rpYOK,
    lac [STATPARAM]
    dac i roP
    idx roP
    lac rpY
    ior [y(0) next(point)]
    dac i roP
    idx roP
    lac rpX
    ior [x(0) next(character)]
    dac i roP
    idx roP

    // The characters and the end code, three to a word, the last word's unused places 0.
    law 037
    jda rpChar
    lac [roBuf:013]
    dac rpC
    dzm rpW
    dzm rpJ
rpPack,
    lac rpW
    ral 6s              // rotated, since sal keeps the sign bit, a first code's 040
    ior i rpC
    dac rpW
    idx rpC
    idx rpJ
    sas [3]             // skip once the word is full
    jmp rpNext
    lac rpW
    dac i roP
    idx roP
    dzm rpW
    dzm rpJ
rpNext,
    lac rpC
    sas rpE             // skip once every character is packed
    jmp rpPack
    lac rpJ
    sza i               // skip if a word is part filled
    jmp rtn
rpFlush,
    lac rpW
    ral 6s
    dac rpW
    idx rpJ
    sas [3]             // skip once the word is full
    jmp rpFlush
    lac rpW
    dac i roP
    idx roP
rtn, jmp .

// Character AC added to the buffer, and counted.
// AC is clobbered, IO preserved. Called via jda rpChar.
rpChar, 0
    dap rcRtn
    lac rpChar
    dac i rpE
    idx rpE
    idx rpN
rcRtn, jmp .
rpD, 0
rpE, 0
rpC, 0
rpN, 0
rpT, 0
rpX, 0
rpY, 0
rpW, 0
rpJ, 0
rpA, 0
rpB, 0
rpF, 0
    endloc

// The readouts' state: nonzero while the list holds the truss as it is (roOK); frameTotal when
// they were last hidden (roHideF); the state being written for (roRes); UNSTABLE's first word,
// or 0 (roUw); the next entry, the entries left (negated, for isp) and the members passed
// (roE, roN, roK); the next word written (roP); the entry being written, its value, midpoint,
// ends' sums and vector (roW, roV, roMX, roMY, roSX, roSY, roDX, roDY); nonzero in Stiff mode's
// view (roSt, taView); nonzero while the list is written again for a change of the magnifier's
// view, not counted as an analysis (roRedo, taRedo).
roOK, 0
roHideF, 0
roRes, 0
roUw, 0
roE, 0
roN, 0
roK, 0
roP, 0
roW, 0
roV, 0
roMX, 0
roMY, 0
roSX, 0
roSY, 0
roDX, 0
roDY, 0
roSt, 0
roRedo, 0

// A readout's characters, at most a sign, five digits and the end code; its digits, least
// significant first.
roBuf,
    table 0d8, 0
roDig,
    table 6, 0

// UNSTABLE under the bar's right, the status word's place, copied after the readouts with no
// answer.
roUnst, STATPARAM
    y(STATY) next(point)
    x(STATX) next(character)
    type340 "UNSTABLE"
