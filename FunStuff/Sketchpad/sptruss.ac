    jmp taMech
    lac faS
    sza                 // skip unless D is negative
    jmp taMech
    lac fcEii
    jda fbLd
    law i 0d23
    add fbE
    dac fbE
    jsp fbNeg
    jsp fAdd
    lac faH
    sza i               // skip unless D - 2^-23 K[i][i] is 0
    jmp taMech
    lac faS
    sza                 // skip unless it is negative
    jmp taMech
    lac [taD:3]
    jda faLd
    jsp fRcp
    lac taFI
    add taFI
    add taFI
    add [tdRD:016]
    jda faSt
    idx taFI
    lac [taPFac:013]
    jmp taGo
