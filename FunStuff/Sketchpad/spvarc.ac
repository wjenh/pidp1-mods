vaPX, 0
vaPY, 0
vaQX, 0
vaQY, 0
vaCX0, 0
vaCY0, 0
vaCX1, 0
vaCY1, 0
vaEnt, 0
vaLv, 0
// The run (vaWalk) and the window its vectors are written for (vaFill).
vaRTop, 0
