Bouncing ball on the Type 340 display, gravity + inelastic floor bounce, random start point

// Each bounce chain starts from a random point on either the top edge or the left edge of the
// screen, launches sideways at a constant speed, and falls under a constant downward
// acceleration.
// Every floor bounce reflects the vertical velocity and removes 1/4 of
// its magnitude using an inexpensive shift.
// The cycle repeast either when the ball has bounced down to a near-standstill or when it has drifted off the
// right edge of the screen.
//
// THE BALL SHAPE
// ---------------
// The Type 340 can't draw a circle natively, so the ball is a sprite rendered using increment mode.
// The points have been precomputed externally, no reason to redo each time.
//
// The shape is an invisible straight walk from the center point out to the circle's rightmost
// point, then a boundary trace, all visible, back to that same point.
// Again this runs autonomously in the 340's own processor, the main code doesn't have to do anything.
//
// DISPLAY LIST TECHNIQUE
// -----------------------
// Ball position is computed live, every frame, on the pdp-1 side, changing only the x/y ball position in
// the Type 340 program, the same methodolgy used in circle2.
// Since there is no intrinsic circle generator, increment mode is used to draw a circle sprite.
//
// SHIFT-BASED MOTION, NOT mul
// --------------------------------------
// 
// No fancy prescaling/descaling discipline is needed for a single scalar velocity, so no mul is needed.
// A bounce that/ keeps 3/4 of the incoming speed is just "bvy -= bvy>>2".
// This is the same leaky-integrator-style shift-and-subtract technique the original PDP-1 circle itself used,
// just applied once per bounce instead of once per point.
//
// RANDOM START POINT
// --------------------
// A small fixed-seed xorshift-style generator is used.
// This is also very traditional, simple shift, xor, repeat a few times.
// It's seeded once from a fixed constant at cold load (SEED) and then advances by one
// mix step every time a new chain starts, so successive chains land in different places even
// though the whole sequence is deterministic and reproducible run-to-run.
//
// GRAVITY FROM THE FRONT-PANEL TEST SWITCHES
// ---------------------------------------------
// The test switche are read every time a chain restarts, so the change takes effect the very next chain.
// 0 means "keep the built-in default", set by GRAVITY, below.
// The value is treated as a fixed-point octal 7.7 max value to allow fractional gravity and is loaded
// from the low 6 bits of the switches.
// The max value is appropriately silly rather than useful.
//
// wje/Claude 9-Jul-2026 - initial version by Claude, edited by wje

#include <TYPE340/type340defs.ah>

#define BALLSCALE 1
#define BALLINTENSITY 6
#define FLOORINTENSITY 6

#define SEED 0d26317      // arbitrary nonzero fixed seed for the xorshift generator

#define BALLRADIUS (0d8 << BALLSCALE)    // ball radius, raster units, don't forget the scale factor
#define FLOORY 0d20       // y coordinate of the floor line
#define RESTY (FLOORY + BALLRADIUS + (1 << BALLSCALE)) // y coordinate of the ball's bottom ede, scaled properly
#define GRAVITY 0d20      // default gravity raster units/frame^2 scaled by 8 to allow fractional gravity
#define LAUNCHVX 0d5      // constant horizontal drift -- raster units/frame
#define FLOORY 0d20       // y coordinate the ball rests/bounces on

// We need safety margins so nothing writes past an edge, don't want an edge violation fault
#define TOPSTARTY (0d1024 - BALLRADIUS - 10)    // don't overrund the top
#define LEFTSTARTX (BALLRADIUS + 0d10)          // same for the left edge
#define RIGHTLIMIT (0d1024 - BALLRADIUS - 10)   // and the right edge

#define MINBOUNCE 0d32    // post-bounce |bvy| below this -> chain has settled, scaled

var bx, by, bvx, bvy, tmpval
// Note that successive runs will use the last rndval, to keep up appearances of randomness.
var rndval=SEED, tmpva, dlycnt, gravval

100/
newchain,
    // Read the front-panel test switches fresh every chain. 0 -> keep the default,
    // nonzero -> use the octal o.o value, the decimal point is between the 3 switch groups.
    lat
    and [077]              // only 6 bits, octal 7.7 max
    sza                    // skip (use the switch value) when AC != 0
    jmp useswitches
    lac [GRAVITY]          // 0, use the default
    dac gravval
    jmp gravdone
useswitches,
    dac gravval
gravdone,

    // advance the fixed-seed xorshift-style generator by one mix step (shift, xor, x3)
    jsp rand18
    dac rndval
    and [1]                 // bit 0 chooses the starting edge
    sza
    jmp fromleft

fromtop,
    lac rndval
    sar 2s
    and [0777]               // 0-511
    add [0d150]               // -> 150-661, comfortably inside the screen width
    dac bx
    lac [TOPSTARTY]
    dac by
    jmp launch

fromleft,
    lac rndval
    sar 2s
    and [0777]               // 0-511
    add [0d200]               // -> 200-711, comfortably between the floor and the top
    dac by
    lac [LEFTSTARTX]
    dac bx

launch,
    lac [LAUNCHVX]
    dac bvx
    dzm bvy

// ---- physics + redraw, once per frame ----
frame,
    // gravity, a constant downward accel from the switches or default, it is a scaled value of 7.7 octal max
    lac bvy
    sub gravval
    dac bvy

    // integrate position
    lac bx
    add bvx
    dac bx
    lac bvy
    sar 3s                  // we scale the acceleration by 8 so we can have fractional gravity
    add by
    dac by

    // floor collision -- bounce if the ball has reached or passed the floor this frame
    lac by
    sub [RESTY]
    spa                      // skip (no bounce) when by >= FLOORY
    jmp bounce
    jmp aftercollision
bounce,
    lac [RESTY]
    dac by                   // clamp to the floor
    lac bvy
    cma
    dac bvy                  // reflect: bvy = -bvy (now positive, moving up)
    lac bvy
    sar 2s
    dac tmpval
    lac bvy
    sub tmpval
    dac bvy                  // lose 1/4 of the speed on this bounce (3/4 restitution)

    lac bvy
    sub [MINBOUNCE]
    spa                      // skip, still bouncing when bvy >= MINBOUNCE
    jmp newchain             // too slow to matter now -- settle, start a new chain
aftercollision,

    // drifted off the right edge -- this chain is done too
    lac bx
    sub [RIGHTLIMIT]
    sma                      // skip, still on screen when bx < RIGHTLIMIT
    jmp newchain

    // patch the ball's new position into the live display list
    lac by
    and [01777]
    ior [y(0) next(point)]
    dac bally
    lac bx
    and [01777]
    ior [x(0) next(increment)]
    dac ballx

    lio [prog]
    dla
waitstop,
    dss
    jmp waitstop

    // pacing delay, tune to taste, more negative = slower animation
    lac [0-0d800]
    dac dlycnt
delayloop,
    isp dlycnt
    jmp delayloop

    jmp frame

#include <RANDOM/rand18.ac>

variables
constants

// Begins in parameter mode. bally/ballx are placeholders -- always overwritten by the host
// before the first dla ever runs, same convention cube2.am1 uses for tgty/tgtx.
prog,
    scale(BALLSCALE) intensity(BALLINTENSITY) next(point)
bally, y(0d500) next(point)
ballx, x(0d500) next(increment) // this point is invisible
    // invisible walk from the center out to the circle's rightmost point (BALLRADIUS steps)
    set1(incright) set2(incright) set3(incright) set4(incright)
    set1(incright) set2(incright) set3(incright) set4(incright)
    // digitized radius-8 circle boundary, 64 steps, generated by gen_circle.py -- see header
    visible set1(incup) set2(incup) set3(incup) set4(incleft)
    visible set1(incup) set2(incup) set3(incleft) set4(incup)
    visible set1(incleft) set2(incup) set3(incleft) set4(incleft)
    visible set1(incup) set2(incleft) set3(incleft) set4(incleft)
    visible set1(incleft) set2(incleft) set3(incleft) set4(incdown)
    visible set1(incleft) set2(incleft) set3(incdown) set4(incleft)
    visible set1(incdown) set2(incleft) set3(incdown) set4(incdown)
    visible set1(incleft) set2(incdown) set3(incdown) set4(incdown)
    visible set1(incdown) set2(incdown) set3(incdown) set4(incright)
    visible set1(incdown) set2(incdown) set3(incright) set4(incdown)
    visible set1(incright) set2(incdown) set3(incright) set4(incright)
    visible set1(incdown) set2(incright) set3(incright) set4(incright)
    visible set1(incright) set2(incright) set3(incright) set4(incup)
    visible set1(incright) set2(incright) set3(incup) set4(incright)
    visible set1(incup) set2(incright) set3(incup) set4(incup)
    visible set1(incright) set2(incup) set3(incup) set4(incup)
    end

    // static floor line, drawn every frame right along with the ball
    scale(1) intensity(FLOORINTENSITY) next(point)
    y(FLOORY) next(point)
    x(0d0) show next(vcontinue)
    visible right deltax(0d1)
    halt

start newchain
