Demo of lightpen tracking for the Type 340
// This uses an interrupt-driven lightpen handler.
// 7-Nov-2026 wje - rename and cleanup
// 8-Nov-2026 Claude - the break routine restarts the list after an edge, and the target is held on the screen.
#include <TYPE340/type340defs.ah>
#include <TYPE340/trackingTarget.ah>

// Initial target position
#define TARGETX 0d512
#define TARGETY 0d512
// Where the prompt goes.
#define MSGX 0d100
#define MSGY 0d100

// The target's arms reach TGTHALF from its center on the screen, so its center is held that far
// inside the screen. drp's coordinates are even, 0 to 1022.
#define TGTHALF (TARGETARM << TARGETSCALE)
#define TGTMIN TGTHALF
#define TGTMAX (0d1022 - TGTHALF)

// Set up the interrupt vector
0/
    0                   // loc 0 SBS saves the pre-break AC here
    0                   // loc 1 SBS saves packed(ov1,exd,PC) here; DEBREAK reads it
    0                   // loc 2 SBS saves the pre-break IO here
    jmp penISR          // loc 3 isr executes from here

100/
    // Be sure interrupts are off, flush any pending to avoid spurious lightpen data.
    lsm
    cbs

    // And initialize the 340 location
    lac [y(TARGETY) next(point)
    dac tgtY
    lac [x(TARGETX) next(parameter)
    dac tgtX

    esm         // And now enable interrupts, we're ready.

    // Start the 340, it will run autonomously
    lio [target
    dla

top,            // just loop forever, 340 and the interrupt are doing all the work.
    jmp top

// penISR is entered directly on the 340's break: a lightpen hit, or an edge violation.
penISR,
    local curhitX, curhitY
    // No pen flag: the 340 halted at an edge, which drs cannot resume.
    dsp
    jmp penEdge

    // Drp, like drc, drops the last bit of the coordinates, get back to the full 10 bits
    drp
    lai
    and [0777]
    sal 1s
    jda clamp
    dac curhitY
    lai
    sar 8s
    and [01776
    jda clamp
    dac curhitX

    // Reposition the target and resume the display, now curhitX is in AC
    ior [x(0) next(parameter)]
    dac tgtX
    lac curhitY
    ior [y(0) next(point)]
    dac tgtY

    // Resume the 340 where the hit stopped it. The resume leaves the lightpen off until the
    // target's next lpon, so the target is hit at most once per refresh and moves on the next pass.
    // Restarting the 340 at the target here instead loops on the target while the pen rests on
    // it, since a held pen hits on every pass, and the prompt is never drawn.
    drs
    jmp penExit

    // Start the list again; dla clears the edge flags.
penEdge,
    lio [target
    dla

penExit,
    lio 2               // restore the pre-break IO
    lac 0               // restore the pre-break AC -- must be last before DEBREAK
    jmp i 1             // DEBREAK

curhitX, 0
curhitY, 0
    endloc

// clamp: hold a target coordinate where the whole target stays on the screen.
// Entered by jda with AC = the coordinate, 0 to 1022.
// Returns AC = the coordinate, held to TGTMIN..TGTMAX. IO preserved.
clamp, 0
    dap clampx
    lac clamp
    sub [TGTMIN
    sma                             // below TGTMIN: hold it there
    jmp clamp1
    lac [TGTMIN
    jmp clampx
clamp1,
    lac clamp
    sub [TGTMAX
    sma sza                         // above TGTMAX: hold it there
    jmp clamphi
    lac clamp
    jmp clampx
clamphi,
    lac [TGTMAX
clampx,
    jmp .

// The 340 program
target, lpon scale(1) intensity(6) next(point)

// The origin point, tgtX,tgtY is modified by the pdp-1 code.
// These are placeholders.
tgtY, y(TARGETY) next(point)
tgtX, x(TARGETX) next(parameter)

#include <TYPE340/trackingTarget.ac>

    next(point) charsets(2) scale(1) intensity(5) lpoff
    y(MSGY) next(point)
    x(MSGX) next(character)
    type340 "Drag the target with the lightpen."
    next(subroutine)
    jump target next(parameter)
    halt   // Just for safety, should never be reached.

variables
constants
start 100
