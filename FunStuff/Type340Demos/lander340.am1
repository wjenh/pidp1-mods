    01724

// Score for a landing, 50 times the multiplier.
skz,
    0372                        // 250
    0144                        // 100
    0226                        // 150
    062                         // 50
    0310                        // 200
    0372                        // 250

// Score for a crash in a zone, 5 times the multiplier (outside one it is 5).
sk2,
    031                         // 25
    012                         // 10
    017                         // 15
    05                          // 5
    022                         // 20
    027                         // 25

// Each zone's bit in tgs and cbn.
lzo,
    040
    020
    010
    04
    02
    01

variables
constants

// ======================================================================
// The display list. The 340 starts in parameter mode.
// ======================================================================

dlist,
    scale(0) intensity(TERRI) lpoff next(point)
terrv,
    table 0d103                 // built by bterr: 2 + 99 + 2 words

// The landing pads, brighter, with a short post at each end.
pads,
    intensity(PADI) next(point)
    y(0d243) next(point)
    x(0d50) next(vector)
    visible down deltay(3)
    visible right deltax(0d50)
    visible up deltay(3) end
    next(point)
    y(0d33) next(point)
    x(0d220) next(vector)
    visible down deltay(3)
    visible right deltax(0d40)
    visible up deltay(3) end
    next(point)
    y(0d73) next(point)
    x(0d320) next(vector)
    visible down deltay(3)
    visible right deltax(0d40)
    visible up deltay(3) end
    next(point)
    y(0d43) next(point)
    x(0d440) next(vector)
    visible down deltay(3)
    visible right deltax(0d65)
    visible right deltax(0d65)
    visible up deltay(3) end
    next(point)
    y(0d163) next(point)
    x(0d740) next(vector)
    visible down deltay(3)
    visible right deltax(0d40)
    visible up deltay(3) end
    next(point)
    y(0d363) next(point)
    x(0d960) next(vector)
    visible down deltay(3)
    visible right deltax(0d30)
    visible up deltay(3) end

// The pad multipliers, under each pad.
    intensity(LABI) scale(1) next(subroutine)
lab0sw,
    jump lab0on
lab0on,
    next(point)
    y(0d220) next(point)
    x(0d64) next(character)
    type340 "5X"
lab0off,
    next(subroutine)
lab1sw,
    jump lab1on
lab1on,
    next(point)
    y(0d10) next(point)
    x(0d229) next(character)
    type340 "2X"
lab1off,
    next(subroutine)
lab2sw,
