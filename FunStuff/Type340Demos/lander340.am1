lab2on,
    next(point)
    y(0d50) next(point)
    x(0d329) next(character)
    type340 "3X"
lab2off,
    next(subroutine)
lab3sw,
    jump lab3on
lab3on,
    next(point)
    y(0d20) next(point)
    x(0d494) next(character)
    type340 "1X"
lab3off,
    next(subroutine)
lab4sw,
    jump lab4on
lab4on,
    next(point)
    y(0d140) next(point)
    x(0d749) next(character)
    type340 "4X"
lab4off,
    next(subroutine)
lab5sw,
    jump lab5on
lab5on,
    next(point)
    y(0d340) next(point)
    x(0d964) next(character)
    type340 "5X"
lab5off,

// Status: fuel and the two velocities (hidden between rounds), then the score.
    intensity(HUDI) scale(1) next(subroutine)
hudasw,
    jump hudaoff
hudaon,
    next(point)
    y(0d990) next(point)
    x(0d24) next(character)
    type340 "FUEL"
    next(point)
    y(0d990) next(point)
    x(0d94) next(character)
hudfn,
    0404040
    0404040
    0370000
    next(point)
    y(0d990) next(point)
    x(0d800) next(character)
    type340 "VERT"
    next(point)
    y(0d990) next(point)
    x(0d870) next(subroutine)
hvarr,
    save arrno next(vector)
    next(point)
    y(0d990) next(point)
    x(0d884) next(character)
hudvn,
    0404040
    0404040
    0370000
    next(point)
    y(0d966) next(point)
    x(0d800) next(character)
    type340 "HORIZ"
    next(point)
    y(0d966) next(point)
    x(0d870) next(subroutine)
hharr,
    save arrno next(vector)
    next(point)
    y(0d966) next(point)
    x(0d884) next(character)
hudhn,
    0404040
    0404040
    0370000
hudaoff,
    next(subroutine)
hudbsw,
    jump hudboff
hudbon,
    next(point)
    y(0d966) next(point)
    x(0d24) next(character)
    type340 "SCORE"
    next(point)
    y(0d966) next(point)
    x(0d94) next(character)
hudsn,
    0404040
    0404040
    0370000
hudboff,
    next(subroutine)

// The lightpen targets (start 6 only): a box around a label, the pen on for both.
// Each target's first word is rewritten by rlp to brighten it while it is held.
tgtsw,
    jump tgtoff
tgton,
tgt0p,
    intensity(TGTI) scale(0) lpon next(point)
    y(TGY) next(point)
    x(TGX0) next(vector)
    visible right deltax(TGW0)
    visible up deltay(TGH)
    visible left deltax(TGW0)
    visible down deltay(TGH) end
    scale(1) next(point)
    y(TGY+0d10) next(point)
    x(TGX0+0d10) next(character)
    type340 "< LEFT"
tgt1p,
    intensity(TGTI) scale(0) lpon next(point)
    y(TGY) next(point)
    x(TGX1) next(vector)
    visible right deltax(TGW1)
    visible up deltay(TGH)
    visible left deltax(TGW1)
    visible down deltay(TGH) end
    scale(1) next(point)
    y(TGY+0d10) next(point)
    x(TGX1+0d10) next(character)
    type340 "THRUST"
tgt2p,
    intensity(TGTI) scale(0) lpon next(point)
    y(TGY) next(point)
    x(TGX2) next(vector)
    visible right deltax(TGW2)
    visible up deltay(TGH)
    visible left deltax(TGW2)
    visible down deltay(TGH) end
    scale(1) next(point)
    y(TGY+0d10) next(point)
    x(TGX2+0d10) next(character)
    type340 "RIGHT >"
    lpoff
tgtoff,

// Messages: one at most. With the lightpen, NEW GAME and GAME OVER are targets: a2 sets
// the pen bit in this word.
msgpar,
    intensity(MSGI) scale(2) next(subroutine)
msgsw,
    jump msgoff
msgng,
    next(point)
    y(0d500) next(point)
    x(0d406) next(character)
    type340 "NEW GAME"
    next(subroutine)
    jump msgoff
msggo,
    next(point)
    y(0d500) next(point)
    x(0d392) next(character)
    type340 "GAME OVER"
    next(subroutine)
    jump msgoff
msgbo,
    next(point)
    y(0d500) next(point)
    x(0d448) next(character)
    type340 "BONUS"
msgoff,

// The explosion's debris. The pen goes off here: nothing below is a target.
    lpoff next(subroutine)
partsw,
    jump partoff
parton,
partint,
    intensity(7) scale(0) next(point)
ptw,
    table 0d112                 // y and x for each particle, written by plotp
    y(0d512) next(parameter)    // leave point mode
partoff,

// The LEM and its flame, last: the host keeps them on the screen, but an edge violation
// here would lose nothing else.
    next(subroutine)
lemsw,
    jump lemoff
lemon,
lemint,
    intensity(LEMDIM) scale(0) next(point)
lemy,
    y(0d500) next(point)
lemx,
    x(0d500) next(subroutine)
lemsv,
    save lem2 next(vector)
    next(subroutine)
flsv,
    save flnull next(vector)
lemoff,
    halt

