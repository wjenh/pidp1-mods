Lunar Lander for the Type 340

// Lunar Lander, re-implemented for am1 and the Type 340 display.
//
// The game is Michael Gardi's Lunar Lander for the PDP-1 and the Type 30 display,
// lander.mac in this directory (https://hackaday.io/project/204632-lunar-lander-for-the-pdp-1,
// https://mikesmakes.ca). The rules, physics, scoring and controls are his and are kept as
// they were; what changed is how the picture is made. See NOTES.md for the design, the
// measurements it rests on, and every deliberate difference from the original.
//
// HOW TO PLAY
// -----------
//   start 4   use the Spacewar control boxes (iot 11)
//   start 5   use the test word switches
//   start 6   use the lightpen (the original read a joystick on IOT 15 here; IOT 15 is
//             the Type 340 in this version)
//
//   Bits (either player's box works): 400000 rotate left, 200000 rotate right,
//   100000 thrust. Each press rotates one step (0 = pointing left ... 4 = pointing right);
//   release before the next step. Thrust burns one unit of fuel per game tick.
//
//   With the lightpen, three targets at the top of the screen stand in for the bits:
//   < LEFT, THRUST and RIGHT >. Hold the pen on one to hold its bit; lift and touch again
//   for the next rotation step. NEW GAME and GAME OVER are targets too: touch and lift.
//
//   Land upright, falling slower than 100 and drifting less than 50, on one of the six
//   pads. The pad's multiplier times 50 is the score, plus 100 units of fuel. Landing on
//   all six pays a 1000 point bonus. A crash costs 100 units of fuel and scores 5 times the
//   pad's multiplier inside a zone, 5 outside. The game ends when a crash leaves no fuel.
//
//   Any press-and-release starts a round from "NEW GAME" and a new game from "GAME OVER".
//   Changing Sense Switch 1 during play restarts the game.
//
// HOW IT DRAWS
// ------------
// The 340 runs a resident display list (dlist, at the end of this file) on its own; the
// PDP-1 only issues one dla per refresh and patches a few words between refreshes, while
// the 340 is halted. Anything that appears and disappears (HUD, labels, messages, the LEM,
// the explosion) sits behind a "switch": a subroutine-mode jump the host points either at
// the block or past it. The LEM, its flame and the HUD arrows are vector blocks called with
// save; they are generated by genlem.py and pasted in below.
//
// TIMING
// ------
// The original had no pacing: its speed was however long drawing took, measured on the
// emulator (14-Sep-2026) at about 12.8 game ticks a second in play. Here the 340 refreshes
// every ~20 ms (REFRESH) and the game advances once every TICKN refreshes, ~78 ms. The
// explosion (32 steps, one per ~98 ms in the original) and the landing count-ups are paced
// the same way.
//
// wje/Claude 14-Sep-2026 - Type 340 version

#include <TYPE340/type340defs.ah>
#include <LIGHTPEN/lightpen.ah>

// ---- pacing, in refreshes (each ~20 ms) ----
#define REFRESH 0d750           // delay loop count per refresh, 25 us per pass (dsp, jmp,
                                // isp, jmp)
#define TICKN   4               // refreshes per game tick (the original's frame)
#define EXPN    5               // refreshes per explosion step
#define SCOREN  2               // refreshes per point in the landing score count-up
#define FUELN   3               // refreshes per unit in the landing fuel count-up
#define BONUSN  2               // refreshes per 10 points in the bonus count-up

// ---- intensities (0 dimmest, 7 brightest) ----
#define TERRI   4               // terrain
#define PADI    7               // landing pads
#define LABI    5               // pad multipliers
#define HUDI    5               // status lines
#define MSGI    6               // NEW GAME, GAME OVER, BONUS
#define LEMDIM  5               // the LEM in flight
#define LEMBRT  7               // the LEM after a good landing
#define TGTI    4               // a lightpen target
#define TGTHI   7               // a lightpen target being held

// ---- the lightpen targets: boxes at the top center, text at scale 1 (14 across) ----
#define TGY     0d948           // bottom of the boxes
#define TGH     0d33            // their height
#define TGX0    0d285           // < LEFT
#define TGW0    0d104
#define TGX1    0d453           // THRUST
#define TGW1    0d104
#define TGX2    0d621           // RIGHT >
#define TGW2    0d118
#define TGYMIN  0d928           // a hit at or above this is on a target (drc gives a point
                                // of a box or its label, all at 948 or above)
#define TGX01   0d421           // between LEFT and THRUST
#define TGX12   0d589           // between THRUST and RIGHT
#define APERTURE APERTURE250    // 28 raster units across

// ---- the game's playing field, in game units (the screen is these / 8) ----
#define GMAX    017500          // 8000: top and right edges of the field
#define YSTART  015530          // 7000: starting height
#define XSTART  050             // 40: starting x, the left edge of the screen
#define GWRAP   017430          // 7960: attract mode wraps the LEM back to XSTART here
#define NGVX    0776647         // -600: attract-mode horizontal velocity (moving right)
#define NRVX    0777157         // -400: starting horizontal velocity for a round

#define NEP     070             // explosion particles, 56

// The original's random number generator, unchanged, so a crash scatters its debris the
// same way for the same inputs.
#define RANDOM  lac ran; rar 1s; xor [0355670]; add [0355670]; dac ran

// Point a display switch at its block (show) or past it (hide).
#define SWITCH(sw, target)  lac [jump target]; dac sw

// Show or hide one pad's multiplier according to its bit in tgs.
#define SETLAB(sw, on, off, bit) lac tgs; and [bit]; sza i; jmp .+3; lac [jump on]; jmp .+2; lac [jump off]; dac sw

// Brighten a lightpen target while its bit is held.
#define TGTLIT(p, bit) lac lpin; and [bit]; sza i; jmp .+3; lac [intensity(TGTHI) scale(0) lpon next(point)]; jmp .+2; lac [intensity(TGTI) scale(0) lpon next(point)]; dac p

var gmx, gmy, vx, vy, vel, ful, sco, cbn, rot, thr, th, tv, cin, pin, sw1, tgs, inp
var scx, scy, xmn, xmx, ymn, ymx, xc, yct, zone, tm2, tmp, dly, fsc
var nel, egr, ecx, ecy, ecnt, bty, btc
var hfuel, hsco, hvy, hvx
var lpacc, lpprv, lpin, lpx, lpy
var ran=0

// ---- entry points: the original's ----
3/
    jmp sbf                     // sequence break: dismiss it
    jmp a0                      // 4: control boxes
    jmp a1                      // 5: test word
    jmp a3                      // 6: lightpen (the original's joystick, on IOT 15 -- the
                                //    340's dla here)

// A sequence break should never happen (nothing enables the system), but the 340 requests
// one on an edge violation, so dismiss one the way the original did.
sbf,
    tyi
    lio 2
    lac 0
    lsm
    jmp i 1

a0,
    law rcb                     // read the control boxes
    jmp a1a
a1,
    law rtw                     // read the test word
a1a,
    dap rdin
    SWITCH(tgtsw, tgtoff)       // no lightpen targets
    lac [intensity(MSGI) scale(2) next(subroutine)]
    jmp a2
a3,
    lio [APERTURE]              // the pen's field of view
    dpy-i LIGHTPEN
    law rlp                     // read the lightpen targets
    dap rdin
    SWITCH(tgtsw, tgton)
    lac [intensity(MSGI) scale(2) lpon next(subroutine)]    // NEW GAME, GAME OVER
a2,
    dac msgpar
    dzm lpacc
    dzm lpprv
    jsp bterr                   // build the terrain vectors
    lac [0777777]               // no value on the HUD matches this, so the first update
    dac hfuel                   // writes every field
    dac hsco
    dac hvy
    dac hvx
    jmp ngm

// ---- input ----

// gri -- the raw input word in AC, from whichever device the start address chose.
gri,
    dap grx
    cla
rdin,
    jsp .
grx,
    jmp .

// rcb -- the control boxes; iot 11 answers in IO.
rcb,
    dap rcx
    cli
    iot 11
    lai
rcx,
    jmp .

// rtw -- the test word switches.
rtw,
    dap rtx
    lat
rtx,
    jmp .

// rlp -- the lightpen targets, as the bits the switches would give. A bit is held if its
// target was hit during this game tick or the one before: the pen is seen at most once
// per refresh, and one tick with no hit must not read as a release (that would be a
// second rotation step). Also brightens the targets that are held.
rlp,
    dap rlx
    lac lpacc
    ior lpprv
    dac lpin
    lac lpacc
    dac lpprv
    dzm lpacc
    TGTLIT(tgt0p, 0400000)
    TGTLIT(tgt1p, 0100000)
    TGTLIT(tgt2p, 0200000)
    lac lpin
rlx,
    jmp .

// lphit -- the 340 has paused on a lightpen hit: note which target, and resume. The pen is
// on only for the targets and, in attract mode and at game over, the message, which
// stands for "start" (any bit not otherwise used).
// The target is chosen from the point the pen saw (drc), as on a real 340. Until the
// emulator's lightpen fix of 14-Sep-2026 this used drp, the emulator's own position for the
// pen, because drc could report a point a few characters past the one that matched, far
// enough to land in the next target's box and turn a held THRUST into a rotation.
lphit,
    dap lhx
    drc                         // x/2 in the high 9 bits, y/2 in the low 9
    lai
    and [0777]
    sal 1s
    dac lpy
    lai
    sar 9s
    and [0777]
    sal 1s
    dac lpx
    lac lpy
    sub [TGYMIN]
    spa                         // up among the targets?
    jmp lh3                     //   no: the message
    lac lpx
    sub [TGX01]
    spa
    jmp lh0
    lac lpx
    sub [TGX12]
    spa
    jmp lh1
    lac [0200000]               // RIGHT
    jmp lh4
lh0,
    lac [0400000]               // LEFT
    jmp lh4
lh1,
    lac [0100000]               // THRUST
    jmp lh4
lh3,
    lac [040000]                // start
lh4,
    ior lpacc
    dac lpacc
    drs                         // carry on drawing; the pen stays off until the next pass
lhx,
    jmp .

// ---- display pacing ----

// frame -- draw the display list once and pace the loop. The delay runs while the 340
// draws, so a refresh takes the delay (drawing is far shorter) plus whatever the caller
// did first. Display words may only be changed between calls, while the 340 is halted.
// A lightpen hit pauses the 340 until it is resumed, so both waits watch for one.
frame,
    dap frx
    lio [dlist]
    dla
    law i REFRESH
    dac dly
fr1,
    dsp                         // skip on a lightpen hit
    jmp fr1a
    jsp lphit
fr1a,
    isp dly
    jmp fr1
fr2,
    dsp
    jmp fr2a
    jsp lphit
fr2a,
    dss                         // skip once the display has halted
    jmp fr2
frx,
    jmp .

// frames -- run the number of refreshes in AC (law n / jda frames).
frames,
    0
    dap fsx
    lac frames
    cma
    dac fsc
fs1,
    jsp frame
    isp fsc
    jmp fs1
fsx,
    jmp .

// ---- new game, attract mode, new round ----

ngm,
    dzm sco
    lac [0d1999]                // a full tank
    dac ful
    dzm vy
    lac [NGVX]
    dac vx
    dzm rot                     // pointing left
    lac [YSTART]
    dac gmy
    lac [XSTART]
    dac gmx
    dzm cbn                     // no pads landed on yet
    clf 1                       // and no pad lights
    clf 2
    clf 3
    clf 4
    clf 5
    clf 6
    dzm sw1                     // Sense Switch 1 as it is now; changing it restarts
    lac [1]
    szs 10
    dac sw1
    dzm pin

// Attract mode: the LEM drifts across under "NEW GAME" until a press and release.
    SWITCH(hudasw, hudaoff)
    SWITCH(hudbsw, hudboff)
    SWITCH(msgsw, msgng)
    SWITCH(partsw, partoff)
    SWITCH(lemsw, lemon)
    dzm tgs
    jsp setlab
    lac [intensity(LEMDIM) scale(0) next(point)]
    dac lemint
    dzm thr
atl,
    jsp gri
    dac inp
    sza                         // skip if nothing is pressed now
    jmp atk
    lac pin                     // released: was something pressed last tick?
    sza
    jmp nxr                     //   yes -- start
atk,
    lac inp
    dac pin
    lac [GWRAP]                 // wrap before the LEM reaches the right edge (the original
    sub gmx                     // tested this and did nothing, so agv's edge check started
    sma                         // a round on its own)
    jmp atm1
    lac [XSTART]
    dac gmx
atm1,
    jsp agv                     // drift; it can no longer leave the field
    nop
    dzm vy                      // no gravity in attract mode
    jsp updlem
    law TICKN
    jda frames
    jmp atl

// A new round: back to the top left, pointing left, drifting right.
nxr,
    lac [YSTART]
    dac gmy
    lac [XSTART]
    dac gmx
    dzm vy
    lac [NRVX]
    dac vx
    dzm rot
    lac [077]                   // every pad's multiplier
    dac tgs
    jsp setlab
    lac [intensity(LEMDIM) scale(0) next(point)]
    dac lemint
    SWITCH(hudasw, hudaon)
    SWITCH(hudbsw, hudbon)
    SWITCH(msgsw, msgoff)
    SWITCH(partsw, partoff)
    SWITCH(lemsw, lemon)

// ---- the game tick ----
fr0,
    cla                         // Sense Switch 1 changed? Start a new game.
    szs 10
    lac [1]
    sas sw1
    jmp ngm
    jsp pip                     // controls
    jsp agv                     // gravity and motion
    jmp nxr                     //   no skip: the LEM left the field, start the round again
    jsp updlem
    jsp updhud
    jsp lti                     // returns only if nothing was touched
    law TICKN
    jda frames
    jmp fr0

// pip -- process the controls. Rotation steps once per press; both left and right at once
// is ignored entirely (thrust too), as in the original.
pip,
    dap pix
    jsp gri
    dac cin
    rar 4s                      // fold the other player's bits onto these
    ior cin
    dac cin
    and [0600000]
    sad [0600000]               // skip unless both left and right
    jmp pix
    lac cin
    and [0400000]               // left?
    sza i
    jmp pir
    lac pin
    and [0400000]               // held since last tick?
    sza
    jmp pir
    lac rot
    sza i                       // already pointing left?
    jmp pir
    sub [1]
    dac rot
    jmp pit
pir,
    lac cin
    and [0200000]               // right?
    sza i
    jmp pit
    lac pin
    and [0200000]
    sza
    jmp pit
    lac rot
    sad [4]                     // skip unless already pointing right
    jmp pit
    add [1]
    dac rot
pit,
    dzm thr
    lac cin
    dac pin
    and [0100000]               // thrust?
    sza i
    jmp pix
    lac ful
    sza i                       // any fuel?
    jmp pix
    lac vy                      // th and tv are set by updlem from the orientation of the
    add tv                      // tick before, as the original's drawing code set them
    dac vy
    lac vx
    sub th
    dac vx
    lac ful
    sub [1]
    dac ful
    idx thr
pix,
    jmp .

// agv -- gravity, then move by the velocities (5 fraction bits). Skips on return while
// the LEM is still inside the field.
agv,
    dap agx
    lac vy
    add [2]                     // lunar gravity, 1.62 m/s^2 rounded to 2
    dac vy
    lac gmy
    lio vy
    sir 5s
    dio vel
    sub vel
    dac gmy
    spa
    jmp agx
    lac [GMAX]
    sub gmy
    spa
    jmp agx
    lac gmx
    lio vx
    sir 5s
    dio vel
    sub vel
    dac gmx
    spa
    jmp agx
    lac [GMAX]
    sub gmx
    spa
    jmp agx
    idx agx
agx,
    jmp .

// ---- display updates ----

// updlem -- the LEM's position, shape and flame words, and the thrust components for its
// orientation. The position is held inside this orientation's limits (lxmin and the
// rest, generated with the shapes): the 340 does not clip, and a vector off the edge
// would halt it. Only near an edge does the drawing differ from the game's position.
updlem,
    dap ulx
    lac gmy
    sar 3s
    lio [lymin]
    jda clamp
    and [01777]
    ior [y(0) next(point)]
    dac lemy
    lac gmx
    sar 3s
    add [0d8]                   // the LEM's center is 8 right of the game's x
    lio [lxmin]
    jda clamp
    and [01777]
    ior [x(0) next(subroutine)]
    dac lemx
    lac rot
    add [lemtab]
    dap ul1
ul1,
    lac .
    dac lemsv
    lac rot
    add [thtab]
    dap ul2
ul2,
    lac .
    dac th
    lac rot
    add [tvtab]
    dap ul3
ul3,
    lac .
    dac tv
    lac thr                     // flame, if thrusting, one of four lengths at random
    sza i
    jmp ul5
    RANDOM
    and [3]
    dac tmp
    lac rot
    sal 2s
    add tmp
    add [fltab]
    dap ul4
ul4,
    lac .
    jmp ul6
ul5,
    lac [save flnull next(vector)]
ul6,
    dac flsv
ulx,
    jmp .

// clamp -- the number in AC held between this orientation's entries in a pair of limit
// tables: IO holds the minimum table, the maximum table is the 5 words after it.
// jda clamp; the result is in AC.
clamp,
    0
    dap clx
    dio clp
    lac clp
    add rot
    dap cl1
cl1,
    lac .                       // the minimum
    dac clm
    lac clamp
    sub clm
    spa                         // at or above it?
    jmp cl3                     //   no: the minimum
    lac cl1
    add [5]
    dap cl2
cl2,
    lac .                       // the maximum
    dac clm
    lac clamp
    sub clm
    sma                         // below it?
    jmp cl3                     //   no: the maximum
    lac clamp
    jmp clx
cl3,
    lac clm
clx,
    jmp .
clp,
    0
clm,
    0

// The LEM's shape for each orientation.
lemtab,
    save lem0 next(vector)
    save lem1 next(vector)
    save lem2 next(vector)
    save lem3 next(vector)
    save lem4 next(vector)

// Thrust components for each orientation, the values the original computed from tac=6:
// full thrust sideways at 0 and 4, half each way at 1 and 3, full upward at 2.
thtab,
    0777771                     // -6
    0777774                     // -3
    0
    3
    6
tvtab,
    0
    0777774                     // -3
    0777771                     // -6
    0777774                     // -3
    0

// The flames, four lengths per orientation.
fltab,
    save fl00 next(vector)
    save fl01 next(vector)
    save fl02 next(vector)
    save fl03 next(vector)
    save fl10 next(vector)
    save fl11 next(vector)
    save fl12 next(vector)
    save fl13 next(vector)
    save fl20 next(vector)
    save fl21 next(vector)
    save fl22 next(vector)
    save fl23 next(vector)
    save fl30 next(vector)
    save fl31 next(vector)
    save fl32 next(vector)
    save fl33 next(vector)
    save fl40 next(vector)
    save fl41 next(vector)
    save fl42 next(vector)
    save fl43 next(vector)

// updhud -- rewrite whichever status fields changed.
updhud,
    dap uhx
    lac ful
    sad hfuel                   // skip if it changed
    jmp uh1
    dac hfuel
    lio [hudfn]
    jda fmt6
uh1,
    lac sco
    sad hsco
    jmp uh2
    dac hsco
    lio [hudsn]
    jda fmt6
uh2,
    lac vy                      // falling is positive: a down arrow
    sad hvy
    jmp uh3
    dac hvy
    sza i
    jmp uhv0
    spa
    jmp uhv1
    lio [save arrdn next(vector)]
    jmp uhv2
uhv0,
    lio [save arrno next(vector)]
    jmp uhv2
uhv1,
    lio [save arrup next(vector)]
    cma
uhv2,
    dio hvarr
    lio [hudvn]
    jda fmt6
uh3,
    lac vx                      // positive moves left: a left arrow
    sad hvx
    jmp uhx
    dac hvx
    sza i
    jmp uhh0
    spa
    jmp uhh1
    lio [save arrlf next(vector)]
    jmp uhh2
uhh0,
    lio [save arrno next(vector)]
    jmp uhh2
uhh1,
    lio [save arrrt next(vector)]
    cma
uhh2,
    dio hharr
    lio [hudhn]
    jda fmt6
uhx,
    jmp .

// fmt6 -- write a non-negative number as 6 right-justified 340 characters, packed 3 to a
// word, into the two words whose address is in IO. jda fmt6 with the number in AC.
fmt6,
    0
    dap fmx
    dio fdst
    law fch+5                   // fill from the right
    dac fpt
    law i 6
    dac fcnt
    lac fmt6
    jmp fm2                     // the units digit is always shown
fm1,
    lac fmt6
    sza i                       // nothing left: a leading space
    jmp fm4
fm2,
    lia                         // AC:IO = the number, shifted left one for div
    cla
    scl 1s
    div [0d10]
    jmp fmx                     // (overflow: cannot happen for a non-negative number)
    dac fmt6                    // quotient
    lai                         // remainder
    add [060]                   // the digit's character
    jmp fm3
fm4,
    lac [040]                   // space
fm3,
    dac i fpt
    lac fpt
    sub [1]
    dac fpt
    isp fcnt
    jmp fm1
    lac fch
    ral 6s
    ior fch+1
    ral 6s
    ior fch+2
    dac i fdst
    idx fdst
    lac fch+3
    ral 6s
    ior fch+4
    ral 6s
    ior fch+5
    dac i fdst
fmx,
    jmp .
fdst,
    0
fpt,
    0
fcnt,
    0
fch,
    table 6

// setlab -- show the pad multipliers whose bits are set in tgs.
setlab,
    dap slx
    SETLAB(lab0sw, lab0on, lab0off, 040)
    SETLAB(lab1sw, lab1on, lab1off, 020)
    SETLAB(lab2sw, lab2on, lab2off, 010)
    SETLAB(lab3sw, lab3on, lab3off, 004)
    SETLAB(lab4sw, lab4on, lab4off, 002)
    SETLAB(lab5sw, lab5on, lab5off, 001)
slx,
    jmp .

// bterr -- build the terrain display words from ypt: one point word for the start, then a
// single chain of 99 vectors, one per 10 raster units across. A 340 vector ends exactly at
// its endpoint, so the chain stays on the table's heights all the way across.
//   start:          y(y0) next(point) / x(0) next(vector)
//   each segment:   visible vector
//   last segment:   visible vector end / next(subroutine) / jump pads
bterr,
    dap btx
    law terrv
    dac btd
    lac ypt
    and [01777]
    ior [y(0) next(point)]
    dac i btd
    idx btd
    lac [x(0) next(vector)]
    dac i btd
    idx btd
    law ypt
    dac btp
    law i 0d99
    dac btc
bt1,
    lac i btp
    dac bty
    idx btp
    lac i btp
    sub bty                     // rise to the next point
    sma
    jmp bt2
    cma
    sal 8s
    ior [down]
    jmp bt3
bt2,
    sal 8s
bt3,
    ior [visible right deltax(0d10)]
    dac i btd                   // btd stays on the vector word for now
    isp btc                     // skip after the last segment
    jmp bt4
    lac i btd
    ior [end]
    dac i btd
    idx btd
    lac [next(subroutine)]
    dac i btd
    idx btd
    lac [jump pads]
    dac i btd
    jmp btx
bt4,
    idx btd
    jmp bt1
btx,
    jmp .
btp,
    0
btd,
    0

// ---- collision ----

// lti -- has the LEM touched the ground? Returns if not; otherwise goes on to a landing
// or a crash and never returns. The test is the original's: any terrain point inside
// the box x -7..+23, y -18..+9 around the LEM's screen position. Only the points under
// the box are examined, which gives the same answer as the original's scan of all 100.
lti,
    dap ltx
    lac gmx
    sar 3s
    dac scx
    lac gmy
    sar 3s
    dac scy
    lac scx
    add [0d23]
    dac xmx
    lac scx
    sub [7]
    dac xmn
    lac scy
    add [0d9]
    dac ymx
    lac scy
    sub [0d18]
    dac ymn
    lac xmn                     // first point: xmn * 3/32, a lower bound on xmn/10
    spa
    cla
    dac tmp
    sal 1s
    add tmp
    sar 5s
    dac tmp
    add [ypt]
    dac ltp
    lac tmp                     // and its x, 10 * index
    sal 2s
    add tmp
    sal 1s
    dac xc
lt1,
    lac xc
    sub xmx
    sma                         // skip while still under the box
    jmp ltx
    lac i ltp
    sza i                       // end of the terrain
    jmp ltx
    dac yct
    sub ymx
    sma                         // below the top of the box?
    jmp lt2
    lac yct
    sub ymn
    spa                         // above the bottom of the box?
    jmp lt2
    lac xc
    sub xmn
    spa                         // right of its left edge?
    jmp lt2
    jmp contact
lt2,
    idx ltp
    lac xc
    add [0d10]
    dac xc
    jmp lt1
ltx,
    jmp .
ltp,
    0

// contact -- the LEM touched down. In a landing zone, gently enough and upright, it is a
// landing; anything else is a crash.
contact,
    dzm zone
lz1,
    lac zone
    sad [6]
    jmp crash5                  // not over any zone
    add [lzx]
    dap lz2
lz2,
    lac .
    dac tmp
    lac scx
    sub tmp
    spa                         // at or right of the zone's left end?
    jmp lz4
    lac zone
    add [rzx]
    dap lz3
lz3,
    lac .
    dac tmp
    lac scx
    sub tmp
    sma                         // left of its right end?
    jmp lz4
    jmp cvv
lz4,
    idx zone
    jmp lz1

cvv,
    lac vy
    sub [0144]                  // falling slower than 100?
    sma
    jmp crashz
    lac vx
    spa
    cma
    sub [062]                   // drifting slower than 50?
    sma
    jmp crashz
    lac rot
    sas [2]                     // upright?
    jmp crashz
    jmp landed

// ---- crash ----

crashz,
    lac zone                    // in a zone: 5 times its multiplier
    add [sk2]
    dap cz1
cz1,
    lac .
    jmp crash
crash5,
    lac [5]                     // outside: 5
crash,
    dac tm2
    jsp expset                  // scatter the debris
    lac sco
    add tm2
    dac sco
    lac ful                     // it costs 100 units of fuel
    sub [0144]
    spa
    cla
    dac ful
    dzm vx
    dzm vy
    SWITCH(hudasw, hudaoff)     // the original drew only the terrain and the debris
    SWITCH(hudbsw, hudboff)
    SWITCH(lemsw, lemoff)
    SWITCH(partsw, parton)
    dzm tgs
    jsp setlab
    law i 0d32                  // 32 steps
    dac nel
exl,
    law EXPN
    jda frames
    cla                         // the original exploded inside its main loop, so Sense
    szs 10                      // Switch 1 restarts the game here too
    lac [1]
    sas sw1
    jmp ngm
    jsp expstep
    isp nel
    jmp exl
    law EXPN
    jda frames
    lac ful
    sza
    jmp nxr
    jmp gover

// expset -- the original's explosion: 56 particles within 8 of the center of the LEM's
// box, each moving 1-16 up and -8..7 across per step.
expset,
    dap exx
    lac xmn
    add xmx
    sar 1s
    dac ecx
    lac ymn
    add ymx
    sar 1s
    dac ecy
    law epx
    dac pxp
    law epy
    dac pyp
    law edx
    dac pdxp
    law edy
    dac pdyp
    law i NEP
    dac ecnt
es1,
    RANDOM
    and [017]
    sub [010]
    add ecx
    dac i pxp
    RANDOM
    and [017]
    sub [010]
    add ecy
    dac i pyp
    RANDOM
    and [017]
    add [1]
    dac i pdyp
    RANDOM
    and [017]
    sub [010]
    dac i pdxp
    idx pxp
    idx pyp
    idx pdxp
    idx pdyp
    isp ecnt
    jmp es1
    dzm egr
    lac [intensity(7) scale(0) next(point)]
    dac partint
    jsp plotp
exx,
    jmp .

// expstep -- one step: a little more gravity each time, then move every particle.
expstep,
    dap esx
    idx egr
    law epx
    dac pxp
    law epy
    dac pyp
    law edx
    dac pdxp
    law edy
    dac pdyp
    law i NEP
    dac ecnt
ex1,
    lac i pxp
    add i pdxp
    dac i pxp
    lac i pyp
    add i pdyp
    sub egr
    dac i pyp
    idx pxp
    idx pyp
    idx pdxp
    idx pdyp
    isp ecnt
    jmp ex1
    lac nel                     // fade as it goes, 7 down to 3
    cma
    sar 3s
    add [3]
    and [7]
    ior [intensity(0) scale(0) next(point)]
    dac partint
    jsp plotp
esx,
    jmp .

// plotp -- the particles' point words. One that is off the screen is moved to, not shown.
plotp,
    dap plx
    law epx
    dac pxp
    law epy
    dac pyp
    law ptw
    dac pwp
    law i NEP
    dac ecnt
pl1,
    lac i pyp
    spa
    jmp pl3
    sub [0d1024]
    sma
    jmp pl3
    lac i pxp
    spa
    jmp pl3
    sub [01777]                 // the original stopped short of 1023 too
    sma
    jmp pl3
    lac i pyp
    ior [y(0) next(point)]
    dac i pwp
    idx pwp
    lac i pxp
    ior [x(0) show next(point)]
    jmp pl4
pl3,
    lac [y(0) next(point)]
    dac i pwp
    idx pwp
    lac [x(0) next(point)]
pl4,
    dac i pwp
    idx pwp
    idx pxp
    idx pyp
    isp ecnt
    jmp pl1
plx,
    jmp .
pxp,
    0
pyp,
    0
pdxp,
    0
pdyp,
    0
pwp,
    0

epx,
    table NEP
epy,
    table NEP
edx,
    table NEP
edy,
    table NEP

// ---- landing ----

landed,
    lac zone
    add [skz]
    dap ld1
ld1,
    lac .
    dac tm2
    lac [intensity(LEMBRT) scale(0) next(point)]
    dac lemint
    lac [save flnull next(vector)]
    dac flsv
    lac zone                    // show only this pad's multiplier
    add [lzo]
    dap ld2
ld2,
    lac .
    dac tgs
    jsp setlab
    lac zone                    // and light its program flag
    add [stft]
    dap ld3
ld3,
    xct .
    lac cbn
    ior tgs
    dac cbn
lsc,
    idx sco                     // count the score up
    jsp updhud
    law SCOREN
    jda frames
    lac tm2
    sub [1]
    dac tm2
    sza
    jmp lsc
    lac [0144]                  // then 100 units of fuel
    dac tm2
lfu,
    idx ful
    jsp updhud
    law FUELN
    jda frames
    lac tm2
    sub [1]
    dac tm2
    sza
    jmp lfu
    lac cbn                     // all six pads?
    sas [077]
    jmp nxr
    dzm cbn
    lac [077]
    dac tgs
    jsp setlab
    SWITCH(msgsw, msgbo)
    lac [0d1000]
    dac tm2
lbo,
    lac sco
    add [0d10]
    dac sco
    jsp updhud
    law BONUSN
    jda frames
    lac tm2
    sub [0d10]
    dac tm2
    sza
    jmp lbo
    jmp nxr

// The program flag for each pad.
stft,
    stf 1
    stf 2
    stf 3
    stf 4
    stf 5
    stf 6

// ---- game over ----

gover,
    SWITCH(hudasw, hudaoff)
    SWITCH(hudbsw, hudbon)      // the score stays up
    SWITCH(msgsw, msggo)
    SWITCH(partsw, partoff)
    SWITCH(lemsw, lemoff)
    dzm pin
gol,
    jsp gri
    dac inp
    sza
    jmp gok
    lac pin
    sza
    jmp ngm
gok,
    lac inp
    dac pin
    law TICKN
    jda frames
    jmp gol

