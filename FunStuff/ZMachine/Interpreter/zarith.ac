// zarith.ac -- the arithmetic, comparison, logic, variable, table and random
// opcode handlers, and the V5 shifts EXT:2 and EXT:3.
//
// #included into zmemcore.am1's bank 0, after zdispatch.ac. Bank 0 is
// required: zdispatch.ac's tables hold plain 12-bit bank-0 addresses
// dereferenced with eem OFF (see that file's header).
//
// Entry points: the zdh* handlers, and zaDivMod, which zprint.ac also calls.
// `add` and `je` are in zdispatch.ac. EXT:2 and EXT:3 are reached only in a
// V5 session: below V5 the EXT form is never decoded (zdecode.ac's patched
// zidExtJmp).
//
// A handler is entered by `jmp` from zInterpret's dispatch and leaves by
// `jmp zipNext` (storew and storeb: zprint.ac's zpWatch). It is not a
// subroutine, so neither AC nor IO is live at entry or exit. The four
// helpers zaCmp16, zaMul16, zaDivMod and zaCheckDyn are same-bank `dap`
// routines called with jsp; each states its own AC and IO.
//
// 20-Sep-2026 Claude - comments cut to AM1-CODING-STANDARD.md, no code change.

// Signed 16-bit values on a ones'-complement machine.
// A Z-machine value is 16-bit two's complement (S2.1); the AC is 18-bit ones'
// complement. The two disagree by one on every negative number, so "do the
// arithmetic, then mask to 16 bits" is wrong whenever the 18-bit intermediate
// goes negative: 0 - 1 gives AC = 0777776, which masks to 0xFFFE, not 0xFFFF.
// Two rules avoid it:
//   1. Never let an intermediate go negative. Subtract as a + (65536 - b) and
//      add -1 as the residue 65535, so every masked result is a non-negative
//      sum (zdhSub, zdhDec, zdhDecChk, zaDivMod's negations, zdhRandom).
//   2. Where a value may go negative, use only its sign, which ones'
//      complement gets right (zaCmp16's difference, zaCheckDyn's bounds test).
// `x - x` leaves plus zero; the hazard is a value that is already -0 (from
// `cma`, `cla cma`, `law -0`). The equality tests in zaCmp16 and zaCheckDyn
// and the count-up shift loops are therefore not required, but are correct.

// PDP-1 mul and div.
// mul: `lac a / mul b` leaves the 35-bit product in AC:IO shifted left one
// place (IO's low bit is unused). `scr 1s` realigns it, low 18 bits in IO.
// `lai` + `sar 1s` would be right only if the product fits AC alone, which a
// 16x16 product does not.
// div: the 36-bit AC:IO dividend must be pre-shifted left one place:
//     lac n / lia / cla / scl 1s / div d
// After the skip AC = quotient and IO = remainder, with no correction.
// `div` skips on success and not on overflow. Divide by zero is the only
// overflow reachable here, so that skip is the whole test. Nothing multi-word
// may sit where the skip lands.
// Am1Includes/rand18.ac divides with an unshifted dividend and a `rcr 1s`
// post-shift. That is right only because its dividend is random; do not copy it.

#include <RANDOM/rand18.ac>        // VAR:231 random's generator, used as it stands

// Halt reasons, see zdispatch.ac's ZSTOP_*. Neither is raised: both
// conditions degrade (zaDivMod, zaCheckDyn). zErrReport still has their texts.
#define ZSTOP_DIVZERO 3        // div or mod with a zero divisor (S15)
#define ZSTOP_BADSTORE 4       // storew/storeb outside dynamic memory

#define ZW_MASK 0177777        // the low 16 bits, used by nearly every handler
#define ZA_BIAS 0100000        // 32768, the signed-comparison bias (zaCmp16)

// rand18.ac's load-time default seed, repeated because it does not export it.
// If it changes there, this must change.
#define ZA_SEED_DEFAULT 0x321E3

// Signed 16-bit comparison of zaCmpA with zaCmpB.
// Exit: AC = 0 if A == B, negative if A < B, positive if A > B.
// AC is the result, IO is preserved. Called via jsp.
// Flipping bit 15 (`xor`, not `add`) maps [-32768, 32767] onto [0, 65535] in
// order, so the compare is an unsigned one of two 16-bit values. Equality is
// tested before the subtraction.
zaCmp16,
    local rtn, bb
    dap rtn
    lac zaCmpB
    and [ZW_MASK]              // mask BEFORE the xor: a stray bit above
    xor [ZA_BIAS]              //   bit 15 would survive it and mis-order
    dac bb
    lac zaCmpA
    and [ZW_MASK]
    xor [ZA_BIAS]
    SKIP_NEXT_IF_DIFFERENT bb
    jmp zacEqual               // A == B
    sub bb                     // both biased and positive, so no -0 here
    jmp rtn
zacEqual,
    cla
    jmp rtn
rtn, jmp 0
bb, 0
    endlocal

zaCmpA, 0
zaCmpB, 0

// The low 16 bits of zaMulA * zaMulB.
// Exit: AC = the result. IO is clobbered. Called via jsp.
// No sign handling: the low 16 bits of a two's-complement product are the
// same whether the operands are read as signed or unsigned.
zaMul16,
    local rtn
    dap rtn
    lac zaMulA
    mul zaMulB                 // AC:IO = product << 1
    scr 1s                     // realign; low 18 bits now in IO
    lai
    and [ZW_MASK]
    jmp rtn
rtn, jmp 0
    endlocal

zaMulA, 0
zaMulB, 0

// Signed 16-bit division of zaDivA by zaDivB (S15).
// Exit: the quotient is in zaDivQ and the remainder in zaDivR, both masked to
// 16 bits. AC and IO are clobbered; no register carries a result.
// Called via jsp.
// The quotient truncates toward zero and the remainder takes the sign of the
// dividend: -11/2 = -5 and -11 mod 2 = -1, while 11/-2 = -5 and 11 mod -2 = 1.
// Magnitudes are divided and the signs reapplied, so `div` only sees positive
// values. A divisor of 0 degrades: quotient and remainder are both 0, counted
// in zaDgDivZero in a harness build.
zaDivMod,
    local rtn, negQ, negR, ma, mb
    dap rtn

    // divisor zero: both results 0
    lac zaDivB
    and [ZW_MASK]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zadZero                // divisor is 0

    // split both operands into sign and magnitude. Bit 15 is the sign
    // (S2.1); a negative value's magnitude is (0200000 - v) & 0177777.
    dzm negQ
    dzm negR

    lac zaDivA
    and [ZW_MASK]
    dac ma
    and [0100000]              // sign bit of the 16-bit value
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zadAPos                // dividend >= 0
    lac [0200000]
    sub ma
    and [ZW_MASK]
    dac ma                     // magnitude of the dividend
    law 1
    dac negQ                   // quotient sign flips
    law 1
    dac negR                   // remainder takes the DIVIDEND's sign
zadAPos,

    lac zaDivB
    and [ZW_MASK]
    dac mb
    and [0100000]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zadBPos                // divisor >= 0
    lac [0200000]
    sub mb
    and [ZW_MASK]
    dac mb                     // magnitude of the divisor
    lac negQ
    xor [1]
    dac negQ                   // quotient sign flips again
zadBPos,

    // unsigned magnitude divide, dividend pre-shifted (see the mul and div
    // note above)
    lac ma
    lia                        // IO = magnitude of the dividend
    cla                        // AC = 0 (high half)
    scl 1s                     // AC:IO = dividend << 1
    div mb
    jmp zadZero                // no skip is overflow; unreachable, mb is nonzero
    dac zaDivQ                 // AC = quotient, IO = remainder, no post-shift
    dio zaDivR

    // reapply S15's signs. A zero magnitude negates to 0200000 & 0177777 = 0,
    // so -0 needs no special case.
    lac negQ
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zadQDone               // quotient is positive
    lac [0200000]
    sub zaDivQ
    and [ZW_MASK]
    dac zaDivQ
zadQDone,

    lac negR
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zadRDone               // remainder is positive
    lac [0200000]
    sub zaDivR
    and [ZW_MASK]
    dac zaDivR
zadRDone,
    jmp rtn

zadZero,
#if Z_TEST_HARNESS
    idx zaDgDivZero
#endif
    dzm zaDivQ
    dzm zaDivR
    jmp rtn

rtn, jmp 0
negQ, 0
negR, 0
ma, 0
mb, 0
    endlocal

zaDivA, 0
zaDivB, 0
zaDivQ, 0
zaDivR, 0

// Test-harness degrade counters, one per degrade site, bumped by an `idx`
// there. The interpreter never reads them.
#if Z_TEST_HARNESS
zaDgDivZero, 0                 // div or mod by 0
zaDgBadStore, 0                // storew/storeb outside dynamic memory
#endif

// 2OP:21 sub.
// Computed as a + (65536 - b) so every intermediate is positive: (65536 - b)
// is in [1, 65536] and a in [0, 65535], so the sum fits 17 bits and its low
// 16 are (a - b) mod 65536.
zdhSub,
    lac zdOp1
    and [ZW_MASK]
    dac zaTmp
    lac [0200000]              // 65536
    sub zaTmp                  // both positive and never equal, so no -0
    add zdOp0
    and [ZW_MASK]
    lia
    jsp zdpStore
    jmp zipNext

// 2OP:22 mul.
zdhMul,
    lac zdOp0
    dac zaMulA
    lac zdOp1
    dac zaMulB
    jsp zaMul16
    lia
    jsp zdpStore
    jmp zipNext

// 2OP:23 div.
zdhDiv,
    lac zdOp0
    dac zaDivA
    lac zdOp1
    dac zaDivB
    jsp zaDivMod
    lac zaDivQ
    lia
    jsp zdpStore
    jmp zipNext

// 2OP:24 mod.
zdhMod,
    lac zdOp0
    dac zaDivA
    lac zdOp1
    dac zaDivB
    jsp zaDivMod
    lac zaDivR
    lia
    jsp zdpStore
    jmp zipNext

// 2OP:8 or.
zdhOr,
    lac zdOp0
    ior zdOp1
    and [ZW_MASK]
    lia
    jsp zdpStore
    jmp zipNext

// 2OP:9 and.
zdhAnd,
    lac zdOp0
    and zdOp1
    and [ZW_MASK]
    lia
    jsp zdpStore
    jmp zipNext

// 1OP:143 not (V1-4), VAR:248 not (V5). S15: "all 16 bits reversed".
// One body, two dispatch entries patched at boot (zpatch.ac): 1OP:15 below
// V5, VAR:24 in V5, where 1OP:15 becomes call_1n.
zdhNot,
    lac zdOp0
    xor [ZW_MASK]              // complement exactly the low 16 bits
    and [ZW_MASK]
    lia
    jsp zdpStore
    jmp zipNext

// 2OP:7 test. S15: branch if bitmap & flags == flags.
zdhTest,
    lac zdOp0
    and zdOp1
    and [ZW_MASK]
    dac zaTmp
    lac zdOp1
    and [ZW_MASK]
    SKIP_NEXT_IF_DIFFERENT zaTmp
    jmp zdhTestYes             // (bitmap & flags) == flags
    cli                        // condition false
    jsp zdpBranch
    jmp zipNext
zdhTestYes,
    lac [1]
    lia
    jsp zdpBranch
    jmp zipNext

// 2OP:2 jl.
zdhJl,
    lac zdOp0
    dac zaCmpA
    lac zdOp1
    dac zaCmpB
    jsp zaCmp16
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zdhJlNo                // A >= B
    lac [1]
    lia
    jsp zdpBranch
    jmp zipNext
zdhJlNo,
    cli
    jsp zdpBranch
    jmp zipNext

// 2OP:3 jg. "A > B" is neither A < B nor A == B. zaCmp16 returns a positive
// nonzero for greater, so zero and sign are tested separately; a bare `spa`
// would also accept the equal case.
zdhJg,
    lac zdOp0
    dac zaCmpA
    lac zdOp1
    dac zaCmpB
    jsp zaCmp16
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zdhJgNo                // A == B
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp zdhJgNo                // A < B
    lac [1]
    lia
    jsp zdpBranch
    jmp zipNext
zdhJgNo,
    cli
    jsp zdpBranch
    jmp zipNext

// 1OP:128 jz.
zdhJz,
    lac zdOp0
    and [ZW_MASK]
    SKIP_NEXT_IF_AC_ZERO
    jmp zdhJzNo                // operand is nonzero
    lac [1]
    lia
    jsp zdpBranch
    jmp zipNext
zdhJzNo,
    cli
    jsp zdpBranch
    jmp zipNext

// The seven S6.3.4 indirect-reference opcodes: store, load, inc, dec,
// inc_chk, dec_chk and pull.
// Their variable operand is a variable NUMBER, and for number 0 S6.3.4 has
// the stack read or written IN PLACE rather than popped or pushed.
// zVarIndirect is a one-shot modifier that zReadVar and zWriteVar each read
// and clear. It is set immediately before the call it modifies, because
// several of these handlers also make a normal-mode access (load's own store
// byte, store's second operand) and an early set would hit the wrong one.

// 2OP:13 store (variable) value. zdOp0 is the variable NUMBER.
zdhStore,
    lac [1]
    dac zVarIndirect
    lac zdOp0
    and [0377]
    lio zdOp1
    jda zWriteVar
    lem
    jmp zipNext

// 1OP:142 load (variable) -> (result). The READ is indirect (S6.3.4); the
// store byte that follows is an ordinary one and must not be.
zdhLoad,
    lac [1]
    dac zVarIndirect
    lac zdOp0
    and [0377]
    lia
    jsp zReadVar
    lem
    lia
    jsp zdpStore               // ordinary store, normal mode
    jmp zipNext

// 1OP:133 inc and 1OP:134 dec.
// Both read the variable in place, adjust by one with 16-bit wrap and write
// it back in place. S15 is signed, so -1 increments to 0 and 0 decrements to
// -1; adding the delta and masking to 16 bits gives exactly that, provided
// the delta is a positive 16-bit residue.
zdhInc,
    lac [1]
    dac zaDelta
    jmp zaAdjust

zdhDec,
    lac [0177777]              // -1 (mod 65536), not `law i 1`: the positive
                               //   residue keeps the sum in [0, 131070], where
                               //   the mask is exact
    dac zaDelta
    jmp zaAdjust

// The body shared by inc and dec: reached by jmp, ends in `jmp zipNext`.
zaAdjust,
    lac zdOp0
    and [0377]
    dac zaVarNum
    lac [1]
    dac zVarIndirect
    lac zaVarNum
    lia
    jsp zReadVar
    lem
    add zaDelta
    and [ZW_MASK]              // 16-bit wrap; also absorbs -0
    dac zaTmp
    lac [1]
    dac zVarIndirect
    lac zaVarNum
    lio zaTmp
    jda zWriteVar
    lem
    jmp zipNext

// 2OP:5 inc_chk and 2OP:4 dec_chk. S15: adjust the variable FIRST, then
// branch if the new value is greater than (less than) the value operand,
// signed.
zdhIncChk,
    lac [1]
    dac zaDelta
    jmp zaAdjChk

zdhDecChk,
    lac [0177777]              // -1 as a positive residue; see zdhDec
    dac zaDelta
    jmp zaAdjChk

zaAdjChk,
    lac zdOp0
    and [0377]
    dac zaVarNum
    lac [1]
    dac zVarIndirect
    lac zaVarNum
    lia
    jsp zReadVar
    lem
    add zaDelta
    and [ZW_MASK]
    dac zaTmp
    dac zaCmpA                 // the NEW value is what gets compared
    lac [1]
    dac zVarIndirect
    lac zaVarNum
    lio zaTmp
    jda zWriteVar
    lem

    lac zdOp1
    dac zaCmpB
    jsp zaCmp16
    dac zaTmp                  // 0 equal, negative less, positive greater

    // Which entry got here, tested by value not sign: both deltas are
    // positive 16-bit residues.
    lac zaDelta
    SKIP_NEXT_IF_DIFFERENT [1]
    jmp zaChkInc               // delta is 1: inc_chk

    // dec_chk: branch if new < value
    lac zaTmp
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zaChkNo                // not less
    jmp zaChkYes

zaChkInc,
    // inc_chk: branch if new > value, that is not equal and not less
    lac zaTmp
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaChkNo                // equal
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp zaChkNo                // less

zaChkYes,
    lac [1]
    lia
    jsp zdpBranch
    jmp zipNext
zaChkNo,
    cli
    jsp zdpBranch
    jmp zipNext

// VAR:232 push.
zdhPush,
    lac zdOp0
    and [ZW_MASK]
    lia
    jsp zStackPush
    lem
    jmp zipNext

// VAR:233 pull (variable). Pops the stack and writes the value to the
// variable whose NUMBER is zdOp0. The pop is a real one; only the write is
// indirect, so `pull sp` replaces the new top in place instead of pushing
// the value straight back.
zdhPull,
    jsp zStackPop
    lem
    dac zaTmp
    lac [1]
    dac zVarIndirect
    lac zdOp0
    and [0377]
    lio zaTmp
    jda zWriteVar
    lem
    jmp zipNext

// The array-access four: thin wrappers over zmemcore.am1's primitives.

// 2OP:15 loadw. S15: array-->word-index, the word at array + 2*word-index.
zdhLoadw,
    lac zdOp1
    and [ZW_MASK]
    sal 1s                     // 2*index
    add zdOp0
    and [ZW_MASK]
    lia
    jsp zFetchWord
    lem
    lia
    jsp zdpStore
    jmp zipNext

// 2OP:16 loadb. S15: array->byte-index, the byte at array + byte-index.
zdhLoadb,
    lac zdOp0
    add zdOp1
    and [ZW_MASK]
    lia
    jsp zFetchByte
    lem
    lia
    jsp zdpStore
    jmp zipNext

// VAR:225 storew and VAR:226 storeb.
// Both end at zprint.ac's zpWatch rather than zipNext. A store at or below
// header byte 0x11 may have changed Flags2 bit 0, which is how V3 stories ask
// for a transcript (`script` is `storew #0 #8`), and S7.4 has the interpreter
// keep stream 2 in step with it. zpWatch reads zaTmp, the address just
// written; zStoreWord and zStoreByte leave it alone.
zdhStorew,
    lac zdOp1
    and [ZW_MASK]
    sal 1s
    add zdOp0
    and [ZW_MASK]
    dac zaTmp
    jsp zaCheckDyn             // not writable: the store is refused
    lac zaTmp
    lio zdOp2
    jda zStoreWord
    lem
    jmp zpWatch                // Flags2 bit 0 (S7.4), then zipNext

zdhStoreb,
    lac zdOp0
    add zdOp1
    and [ZW_MASK]
    dac zaTmp
    jsp zaCheckDyn
    lac zaTmp
    lio zdOp2
    jda zStoreByte
    lem
    jmp zpWatch                // as storew

// VAR:253 copy_table first second size (V5). Stores and branches nothing.
// S15: second = 0 zeroes |size| bytes of first. Size negative copies |size|
// bytes forwards even when the tables overlap and that corrupts first
// (Beyond Zork's fill idiom depends on it). Size positive copies in whichever
// direction does not corrupt first. Size 0 copies nothing. A zeroing call
// with a negative size is not defined by S15; |size| is used for both forms.
// The destination must be dynamic. Its last byte is tested against
// zhStaticBase before anything moves, and a destination that reaches static
// memory is refused whole: zStoreByte has no bound check of its own.
// Ranges: every operand is a 16-bit pattern, 0..0xFFFF, never negative, and
// every intermediate stays far inside +-0377777, so each test bounds before
// it subtracts. `sub [1]` of 1 leaves plus zero, and `add` of +1 or -1 never
// makes minus zero. The source pointer is masked to 16 bits at each fetch, so
// a source running past 0xFFFF wraps to 0: spec-illegal, degraded not halted.
// The byte loop costs about 70 instructions a byte, so the forward shapes
// stories use take the word path at zaCtFwd, with the same result including
// the refusal and the wrap.
zdhCopyTable,
    // n = |size|
    lac zdOp2
    and [0100000]              // the 16-bit sign bit of size
    dac zaCtNeg                // nonzero: size is negative, copy forward
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaCtPos                // size is positive or 0
    lac [0200000]
    sub zdOp2                  // 0x10000 - size: 1..0x8000, both operands
    jmp zaCtHaveN              //   positive, so no sign question arises
zaCtPos,
    lac zdOp2
zaCtHaveN,
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zipNext                // size 0: nothing to copy or zero
    dac zaCtCount

    // dst = second, or first when zeroing
    lac zdOp1
    SKIP_NEXT_IF_AC_NOT_ZERO
    lac zdOp0                  // second = 0: zero first in place
    dac zaCtDst

    // refuse a destination that reaches static memory
    add zaCtCount              // dst is still in AC
    sub [1]                    // the last byte to be written, 0..0x17FFE
    sub zhStaticBase           // negative iff that byte is dynamic
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zipNext                // it reaches static memory: write nothing

    // direction. Forward (step +1 from the first byte of each) unless the
    // size is positive, this is a copy, and second lies above first INSIDE
    // the source, the only case where a forward copy could overwrite source
    // bytes before they are read. Every forward call enters at zaCtFwd, which
    // picks the word path or the byte loop; a backward one goes straight to
    // the byte loop.
    law zipNext
    dac zaCtNext               // where the byte loop ends: the whole call
    lac zdOp0
    dac zaCtSrc
    lac [1]
    dac zaCtStep
    lac zaCtNeg
    SKIP_NEXT_IF_AC_ZERO
    jmp zaCtFwd                // negative size: forward, always
    lac zdOp1
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaCtFwd                // zeroing: direction is moot
    lac zdOp0
    sub zdOp1                  // first - second
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zaCtFwd                // second at or below first: forward is safe
    lac zdOp1
    sub zdOp0
    sub zaCtCount              // second - first - n; equal gives plus zero
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zaCtFwd                // no overlap: forward is safe
    // backward: both pointers start at their LAST byte and step -1
    lac zaCtCount
    sub [1]
    dac zaCtStep               // n - 1, parked in the step word briefly
    add zaCtSrc
    dac zaCtSrc                // first + n - 1
    lac zaCtStep
    add zaCtDst
    dac zaCtDst                // second + n - 1, below zhStaticBase (tested)
    lac [-1]
    dac zaCtStep

    // the byte loop
zaCtLoop,
    cli                        // the byte to store, when zeroing
    lac zdOp1
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaCtPut                // zeroing: IO = 0 already
    lac zaCtSrc
    and [ZW_MASK]              // a source past 0xFFFF wraps
    lia
    jsp zFetchByte             // AC = the source byte
    lem                        //   (zFetchByte returns with eem on)
    lia
zaCtPut,
    lac zaCtDst
    jda zStoreByte             // IO = the byte
    lem
    lac zaCtSrc
    add zaCtStep
    dac zaCtSrc
    lac zaCtDst
    add zaCtStep
    dac zaCtDst
    lac zaCtCount
    sub [1]                    // 1 - 1 is plus zero, so the skip ends it
    dac zaCtCount
    SKIP_NEXT_IF_AC_ZERO
    jmp zaCtLoop               // bytes remain
    jmp i zaCtNext             // zipNext, or the word path's next step

// The forward word path. It moves whole words, about 10 instructions per two
// bytes against about 70 per byte in the byte loop, and calls the undo hook
// once per 64-word page instead of once per byte.
// It takes these forward shapes: zeroing; the fill idiom (size negative and
// second = first + 1, so every byte becomes the byte at first); and a copy
// whose source and destination have the same parity, whose source ends at or
// below 0xFFFF (the byte loop wraps past it, a word pointer would not) and
// below zhResidentTop (read in place; it can be as high as 0x18000).
// Overlap is safe: a destination below its source writes only words already
// read, and a negative size with an even distance reads each word after it
// was wholly written, as the byte copy would. Anything else keeps the byte
// loop.
// The destination is dynamic, so resident, and its word pointer is
// (addr >> 1) + DYNMEM_BANK1 * 010000, as in zStoreByte. An odd first byte and
// an odd last byte go through the byte loop (count 1, zaCtNext steering it
// back), and the source pointer advances with the destination.
// The undo hook runs for the first word and whenever the destination pointer
// reaches a page's first word (low six bits 0) with words still to write.
// It is called unconditionally: copy_table is V5+ and a census image's zuHook
// is a stub that returns. zuHook takes the pointer in AC with the window open
// and returns AC = the pointer, window open; IO is not preserved, and nothing
// here reads it after the call.
zaCtFwd,
    lac zdOp1
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaCtSetZ               // zeroing: the word is 0
    lac zaCtNeg
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaCtCopyQ              // positive size: a copy, perhaps
    lac zdOp0
    add [1]
    SKIP_NEXT_IF_DIFFERENT zdOp1
    jmp zaCtSetF               // second = first + 1: the fill
zaCtCopyQ,
    lac zdOp0
    xor zdOp1
    and [1]
    SKIP_NEXT_IF_AC_ZERO
    jmp zaCtLoop               // different parity: words do not line up
    lac zaCtSrc
    add zaCtCount
    sub [1]                    // the last source byte, 0..0x17FFE
    dac zaCtW
    sub [0200000]              // - 0x10000
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zaCtLoop               // it wraps: the byte loop's case
    lac zaCtW
    sub zhResidentTop
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zaCtLoop               // some of it is pageable
    dzm zaCtMode               // 0: copy words
    jmp zaCtSplit
zaCtSetF,
    lio zdOp0                  // the fill byte is the byte at first
    jsp zFetchByte             // AC = it
    lem                        //   (zFetchByte returns with eem on)
    jmp zaCtSetW
zaCtSetZ,
    cla
zaCtSetW,
    dac zaCtW
    sal 8s
    ior zaCtW
    dac zaCtW                  // the fill word, byte << 8 | byte
    lac [1]
    dac zaCtMode               // 1: store the fill word

zaCtSplit,
    lac zaCtDst
    and [1]
    dac zaCtLead               // 1: an odd destination's first byte
    lac zaCtCount
    sub zaCtLead
    dac zaCtW2                 // the bytes after it
    sar 1s
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaCtLoop               // no whole word: all bytes
    dac zaCtWords
    lac zaCtW2
    and [1]
    dac zaCtTrail              // 1: an odd byte left at the end
    lac zaCtLead
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaCtWordPh             // even: straight to the words
    dac zaCtCount              // 1: the byte loop does the leading byte,
    law zaCtWordPh             //   then comes back here
    dac zaCtNext
    jmp zaCtLoop

zaCtWordPh,
    lac zaCtDst
    sar 1s                     // even and 0..0x3FFF: a word index
    add [DYNMEM_BANK1*010000]
    dac zaCtPD
    lac zaCtSrc
    sar 1s                     // 0..0xFFFF (tested): read only in copy mode
    add [DYNMEM_BANK1*010000]
    dac zaCtPS
    lac zaCtWords
    dac zaCtWC
    eem                        // the pointers are 16-bit
    lac zaCtPD
    crossBankjda(zuHook:*, NOEEM)  // the first word's page
    lac zaCtMode
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaCtCpLp               // copying
zaCtSetLp,
    lac zaCtW
    dac i zaCtPD
    lac zaCtWC
    sub [1]
    dac zaCtWC
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaCtWDone              // the last word is written
    idx zaCtPD                 // AC = the next word's pointer
    and [077]
    SKIP_NEXT_IF_AC_ZERO
    jmp zaCtSetLp              // same page
    lac zaCtPD
    crossBankjda(zuHook:*, NOEEM)
    jmp zaCtSetLp
zaCtCpLp,
    lac i zaCtPS
    dac i zaCtPD
    lac zaCtWC
    sub [1]
    dac zaCtWC
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaCtWDone              // the last word is written
    idx zaCtPS
    idx zaCtPD                 // AC = the next word's pointer
    and [077]
    SKIP_NEXT_IF_AC_ZERO
    jmp zaCtCpLp               // same page
    lac zaCtPD
    crossBankjda(zuHook:*, NOEEM)
    jmp zaCtCpLp
zaCtWDone,
    lem
    lac zaCtWords
    sal 1s                     // the bytes the words moved
    dac zaCtW2
    add zaCtSrc
    dac zaCtSrc
    lac zaCtW2
    add zaCtDst
    dac zaCtDst
    law zipNext
    dac zaCtNext
    lac zaCtTrail
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zipNext                // no byte left: done
    dac zaCtCount              // 1: the byte loop does the trailing byte
    jmp zaCtLoop

// copy_table's working words. Not reentrant, like every handler here.
zaCtNeg, 0                     // nonzero if size was negative
zaCtCount, 0                   // bytes still to move, n down to 1
zaCtSrc, 0                     // the next source byte address
zaCtDst, 0                     // the next destination byte address
zaCtStep, 0                    // +1 forward, -1 (0777776) backward
zaCtNext, 0                    // where the byte loop goes when done
zaCtMode, 0                    // 0 copy words, 1 store zaCtW
zaCtW, 0                       // the fill word; a scratch word first
zaCtW2, 0                      // scratch
zaCtLead, 0                    // 1 if the destination starts odd
zaCtTrail, 0                   // 1 if an odd byte is left at the end
zaCtWords, 0                   // whole words to move
zaCtWC, 0                      // words still to move
zaCtPD, 0                      // the destination word pointer
zaCtPS, 0                      // the source word pointer

// VAR:247 scan_table x table len [form] -> (result) ?(label) (V4+).
// S15: is x one of the len words in table? If so store the address where it
// first occurs and branch; if not store 0 and don't. The form is as the
// Standard 1.1 errata corrects it (bit 7, not bit 8): bit 7 set for words,
// clear for bytes; bits 0-6 the length of each field in bytes, the first word
// or byte of a field being the one compared. The default is 0x82 (0202):
// words, two bytes apart.
// The form is honored whenever present, in V4 too (S15's "only used in
// Version 5?" is a question). Presence is judged by operand COUNT, not value,
// so an explicit form of 0 means bytes with fields of length 0, not the
// default.
// Nothing halts. len 0 or omitted (the decoder leaves it 0) finds nothing; a
// field length of 0 compares the same field len times; x above 0xFF against a
// byte table finds nothing; a table running past 0xFFFF wraps to 0, as
// copy_table's source does. The table may be anywhere below 0x10000, at an
// odd address too; zFetchWord takes any byte address.
// The count runs len..1 by `sub [1]`, which ends on plus zero, and the compare
// is `sad` of two 0..0xFFFF values, so no sign question arises.
// The store comes before the branch (S4.7.1), as a store to sp pushes onto
// the frame a returning branch then discards; both exits end
// `jsp zdpBranch; jmp zipNext`, keeping zdpReturn's invariant (zdispatch.ac).
// A hit at address 0 stores 0 and still branches: the branch follows "found",
// not the stored value.
zdhScanTable,
    lac [0202]                 // S15's default form: words, 2-byte fields
    dac zaStForm
    lac zdOpCount
    SKIP_NEXT_IF_SAME [4]
    jmp zaStHaveForm           // three operands: the default
    lac zdOp3
    dac zaStForm
zaStHaveForm,
    lac zaStForm
    and [0177]                 // bits 0-6: the field length in bytes
    dac zaStLen
    lac zdOp1
    dac zaStPtr                // the field being compared
    lac zdOp2
    dac zaStCount              // fields still to compare, len down to 1
zaStLoop,
    lac zaStCount
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaStMiss               // none left: not found
    lio zaStPtr
    lac zaStForm
    and [0200]                 // bit 7: a word table
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaStByte               // a byte table
    jsp zFetchWord             // AC = the field's first word
    jmp zaStCmp
zaStByte,
    jsp zFetchByte             // AC = the field's first byte
zaStCmp,
    lem                        // both fetches return with eem on
    SKIP_NEXT_IF_DIFFERENT zdOp0
    jmp zaStHit                // this field is x
    lac zaStPtr
    add zaStLen
    and [ZW_MASK]              // past 0xFFFF wraps
    dac zaStPtr
    lac zaStCount
    sub [1]
    dac zaStCount
    jmp zaStLoop
zaStHit,
    lio zaStPtr                // the address where x first occurs
    jsp zdpStore
    lac [1]
    lia
    jsp zdpBranch              // found: the condition is true
    jmp zipNext
zaStMiss,
    cli
    jsp zdpStore               // not found: 0
    cli
    jsp zdpBranch
    jmp zipNext

// scan_table's working words. Not reentrant, like every handler here.
zaStForm, 0                    // the form: bit 7 words, bits 0-6 field length
zaStLen, 0                     // the field length in bytes, 0..0177
zaStPtr, 0                     // the address of the field being compared
zaStCount, 0                   // fields still to compare

// Check that a store address lies in dynamic memory, which S15 requires of
// storew and storeb. On call zaTmp = the Z-machine byte address.
// Returns to the caller if the address is dynamic. If not, the store is
// refused: control goes straight to zipNext, so nothing is written and the
// instruction is over. The only callers, zdhStorew and zdhStoreb, have
// nothing pending when abandoned. A harness build counts it in zaDgBadStore.
// AC is clobbered, IO is preserved. Called via jsp.
// The boundary test before the subtraction is redundant: an address of exactly
// zhStaticBase subtracts to +0, which `sma` reads as not negative.
zaCheckDyn,
    local rtn
    dap rtn
    lac zaTmp
    SKIP_NEXT_IF_DIFFERENT zhStaticBase
    jmp zacdBad                // on the boundary
    sub zhStaticBase           // only the sign is used, which ones'
    SKIP_NEXT_IF_AC_NEGATIVE   //   complement gets right
    jmp zacdBad                // above the base: not writable
    jmp rtn
zacdBad,
#if Z_TEST_HARNESS
    idx zaDgBadStore
#endif
    jmp zipNext                // refused: nothing is written
rtn, jmp 0
    endlocal

// VAR:231 random (S15), on Am1Includes/rand18.ac.
//   range > 0   uniform 1..range
//   range < 0   seed the generator with |range|, return 0
//   range == 0  S15 says to reseed "in as random a way as the interpreter
//               can". There is no entropy source, so it reseeds to rand18.ac's
//               own load-time constant and the sequence repeats as after a load.
// rand18 does not preserve IO and is not reentrant.
zdhRandom,
    lac zdOp0
    and [ZW_MASK]
    dac zaTmp
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zdhRandReseed          // range == 0

    lac zaTmp
    and [0100000]              // sign bit of the 16-bit range
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zdhRandPos             // range > 0

    // range < 0: seed with the magnitude, return 0
    lac [0200000]
    sub zaTmp
    and [ZW_MASK]
    lia
    jsp rand18seed             // seed comes from IO
    lem
    cli
    jsp zdpStore               // S15: the return value is 0
    jmp zipNext

zdhRandReseed,
    lac [ZA_SEED_DEFAULT]
    lia
    jsp rand18seed
    lem
    cli
    jsp zdpStore
    jmp zipNext

zdhRandPos,
    // Uniform 1..range: an 18-bit xorshift value, forced non-negative,
    // modulo range (through zaDivMod), plus 1.
    jsp rand18
    lem
    and [077777]               // 15 bits: zaDivMod reads bit 15 as a sign
    dac zaDivA
    lac zaTmp
    dac zaDivB                 // range, known positive and nonzero here
    jsp zaDivMod
    lac zaDivR
    add [1]                    // 1..range
    and [ZW_MASK]
    lia
    jsp zdpStore
    jmp zipNext

// EXT:2 log_shift and EXT:3 art_shift (V5).
// S15: places positive shifts left, negative shifts right, range -15..+15.
// log_shift zeroes the sign on a right shift; art_shift preserves it.
zdhLogShift,
    dzm zaArith
    jmp zaShift

zdhArtShift,
    lac [1]
    dac zaArith
    jmp zaShift

zaShift,
    lac zdOp0
    and [ZW_MASK]
    dac zaTmp
    lac zdOp1
    and [ZW_MASK]
    dac zaShiftN
    and [0100000]              // sign of `places`
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaShiftLeft            // places >= 0

    // right by |places|
    lac [0200000]
    sub zaShiftN
    and [ZW_MASK]
    dac zaShiftN

    // art_shift on a negative value must shift the sign down with it, so
    // sign-extend the 16-bit value to 18 bits, shift arithmetically, then
    // re-mask.
    lac zaArith
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaShiftRLoop           // log_shift: zeroes come in
    lac zaTmp
    and [0100000]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zaShiftRLoop           // value >= 0: nothing to extend
    lac zaTmp
    xor [0600000]              // set bits 16-17 of the 18-bit word, so the
    dac zaTmp                  //   PDP-1 sign matches the Z-machine sign

// Both loops count up from 0 to zaShiftN and end on equality.
zaShiftRLoop,
    dzm zaShiftI
zaShiftRNext,
    lac zaShiftI
    SKIP_NEXT_IF_DIFFERENT zaShiftN
    jmp zaShiftDone            // i == n
    add [1]
    dac zaShiftI
    lac zaTmp
    sar 1s                     // arithmetic: replicates the sign bit
    dac zaTmp
    jmp zaShiftRNext

zaShiftLeft,
    dzm zaShiftI
zaShiftLNext,
    lac zaShiftI
    SKIP_NEXT_IF_DIFFERENT zaShiftN
    jmp zaShiftDone
    add [1]
    dac zaShiftI
    lac zaTmp
    sal 1s
    dac zaTmp
    jmp zaShiftLNext

zaShiftDone,
    lac zaTmp
    and [ZW_MASK]
    lia
    jsp zdpStore
    jmp zipNext

zaArith, 0
zaShiftN, 0
zaShiftI, 0

// Working storage shared by the handlers in this file.
zaTmp, 0
zaDelta, 0
zaVarNum, 0
