// zboot.ac -- story header parsing, memory layout and resident load.
// #include-only fragment (no `start`/`stop`), pulled into zmemcore.am1's
// ZLEAF_BANK section first among the leaf fragments, so the header words
// it owns are defined above their readers.
//
// It reads the story's header off the drum, refuses a file this
// interpreter cannot run, computes the memory layout, copies the resident
// region from the drum into banks 0d1 upward, and sets the header fields
// the interpreter owns. One image runs whichever V3, V4 or V5 story
// zloader last copied onto the drum.
//
// The resident region is as much of the story as fits in Z_RESIDENT_WORDS
// words, never less than dynamic memory; zhResidentTop is the byte
// address every fetch routes on (step 8).
//
// Entry points, all called via farjsp:
//   zBootInit    no arguments. AC = 0 (ZBOOT_OK) if the story on the drum
//                booted, else the ZBOOT_* code that refused it; IO is
//                clobbered. Never prints and never halts (see zmemcore.am1's
//                `boot` header).
//   zBootRefuse  IO = a ZBOOT_* code. Prints the matching refusal on the
//                open DCS2 channel. AC and IO are clobbered.
//   zbRestHdr    no arguments. Sets the header fields again after a
//                restore. AC and IO are clobbered.
//
// Dependencies: zmemcore.am1's manifest constants (Z_PAGE_WORDS,
// Z_STACK_WORDS, Z_MAX_DYN_BANKS, Z_RESIDENT_WORDS, Z_DRUM_TRACKS,
// DYNMEM_BANK1, DYNMEM_CACHE_BANK), zdispatch.ac's ZSTOP_* numbering,
// skipmacros.ah, memory.ah, type550defs.ah, zpatch.ac's zpApply (bank
// ZPATCH_BANK), and, all in bank 0 and assembled before this #include,
// zfDrumFillPage, fillTrack, fillTrackOffset, zhStaticBase, zhInitialPC,
// zhGlobalsAddr, zhResidentTop and zstack.ac's zsGlobPtr. Plus zPrintChar,
// which is in this bank.
//
// Where the parsed words live. A cross-bank read is three words and an
// eem hazard where an in-bank read is one word and neither, so the words
// bank-0 code reads are written into bank 0 here at boot:
//   zhStaticBase     bank 0   zarith.ac
//   zhInitialPC      bank 0   zdispatch.ac
//   zhGlobalsAddr    bank 0   zstack.ac
//   zhResidentTop    bank 0   zmemcore.am1 -- computed, not a header
//                             field, and bank 0 only (step 8)
//   zhObjTableAddr   ZLEAF    zobjects.ac
//   zhObjEntriesBase ZLEAF    zobjects.ac
//   zhFileLenPlus1   ZLEAF    zobjects.ac
//   zhDictAddr       ZLEAF    zparser.ac
//   zhAbbrevAddr     ZLEAF    ztext.ac
// zFetchContainingWord tests zhResidentTop on every fetch, the hottest
// path in the program; boot pays a fardac once. zhObjEntriesBase and
// zhFileLenPlus1 are precomputed so every use stays one instruction. The
// remaining words are read by zsave.ac, in this bank.
//
// The window. The entry points farenter (closing it) and farrtn (opening
// it). By the in-bank pointer rule (zmemcore.am1, above `bank
// ZLEAF_BANK`), an indirect through a bare in-bank pointer is only correct
// with eem off: with eem on it resolves in bank 0. This file has three
// indirects, of two kinds:
//   zbHdrWord's `lac i ptr`      a full (bank:offset) pointer into
//                                zCacheSlot0 in bank 0d13: eem on for it,
//                                and closed again.
//   zBootRefuse's `lac i msgPtr` a bare pointer at a message in this bank:
//                                eem off, with a `lem` after each
//                                zPrintChar, which returns with it open.
//   zbHeaderSetup's `lac i ptr`  a bare pointer into its table: eem off,
//                                with a `lem` after each zStoreWord.

#ifndef ZBOOT_AC_H
#define ZBOOT_AC_H

#include <memory.ah>
#include <AIDS/skipmacros.ah>
#include <MICROTAPE/type550defs.ah>

// What zBootInit returns: zdispatch.ac's ZSTOP_* codes, aliased, so `boot`
// writes the value straight into zdpStopReason, and the refusal it prints
// (then the error prompt and the end of the session, not a halt) needs no
// mapping. A headless script reads the same number from testBootResult,
// which testBootInit writes before it halts.
// Only a file this interpreter cannot run at all produces a code. The
// saves are on a tape image, so the story may have the whole drum.
#define ZBOOT_OK      0
#define ZBOOT_BADVER  ZSTOP_BADVER
#define ZBOOT_TOOBIG  ZSTOP_TOOBIG
#define ZBOOT_TOODYN  ZSTOP_TOODYN

// The header fields' word indices. The story is packed two bytes a word,
// big-endian (zloader.h's zl_pack_word), so for an even byte address the
// containing word is the Z-machine word there, which every field below is.
// Each is (byteOffset >> 1), read with no shifting or masking. The byte
// offsets are zloader.h's ZH_* set, Standard 1.1's V1-V5 header.
#define ZBH_VERSION      0d0    // byte 0x00, in the word's high half
#define ZBH_HIGHMEM      0d2    // byte 0x04
#define ZBH_INITIAL_PC   0d3    // byte 0x06
#define ZBH_DICT         0d4    // byte 0x08
#define ZBH_OBJTABLE     0d5    // byte 0x0A
#define ZBH_GLOBALS      0d6    // byte 0x0C
#define ZBH_STATIC_BASE  0d7    // byte 0x0E -- also the dynamic-memory size
#define ZBH_FLAGS2       0d8    // byte 0x10
#define ZBH_ABBREV       0d12   // byte 0x18
#define ZBH_FILE_LENGTH  0d13   // byte 0x1A -- in units, not bytes (step 3)
#define ZBH_CHECKSUM     0d14   // byte 0x1C

// The property-defaults table, which object entries follow (S12.2), is
// 0d62 bytes in V3 and 0d126 in V4+: the patched word zbPropDefBytes.

// One past the largest byte address any version can have: object,
// property and dictionary addresses are 16-bit. It is zobjects.ac's
// zObjCount sentinel at V4+, where there is no byte count to use (step 3)
// and the word count plus one would not bound the addresses. In V3 the
// sentinel is zhFileLenPlus1, the story's length in bytes plus one.
#define ZB_ADDR_CEILING  0d65536

// A V5 story whose file sets Flags2's UNDO bit has undo, and keeps at
// most eleven banks resident, because the rest of the region, in
// ZCOLD_BANK, is then the undo log (zsave.ac). Used by steps 3 and 8 and
// by zbHeaderSetup.
#define ZB_FLAGS2_UNDO   020          // Flags2 bit 4
#define ZB_UNDO_CAP      0130000      // eleven banks, in words

// Reads and checks the story header, loads the resident region and sets
// the interpreter's header fields.
// Exit:  AC = ZBOOT_OK, or a ZBOOT_* refusal.
// AC is the result, IO is clobbered. Called via farjsp; returns with the
// window open (farrtn).
// The version is checked first, since the header's fields mean what the
// version says; zpApply then patches the version-dependent words the
// arithmetic reads. The capacity checks come before the load, which is
// what would overwrite ZCOLD_BANK's code. It never prints and never halts
// (see zmemcore.am1's `boot` and `testBootInit`).
zBootInit,
    local rtn, pageNo, pageCount, trackNo, inTrack, fillDest, storyTracks, cap
    farenter(rtn)              // the window is closed from here, except
                               //   inside the far* macros

    // 0. The save tape's drive, stopped. A machine restarted at a new
    // entry point comes back in here, and not every start passes through a
    // halt, which stops the tapes. With no tape mounted the stop is refused
    // (UNABLE), which changes nothing; zsvMount's `mse` clears the flag.
    lio [mtu2]
    mse
    cli
    mlc

    // 1. The header page, read without the page cache, whose address
    // translation depends on zhStaticBase, which this step produces.
    // zCacheSlot0 is 0d256 words, uninitialized, and slot0Tag is 0 (empty)
    // until the first real miss: fill it with page 0 (track 0, offset 0,
    // since the whole file sits on the drum from track 0), read the header
    // out of it, and leave slot0Tag at 0 so the first pageable fetch
    // refills it. Nothing else on boot's path touches the cache.
    cla
    fardac(fillTrack:0)
    cla
    fardac(fillTrackOffset:0)
    farjsp(zfDrumFillPage:0)
    zCacheSlot0:DYNMEM_CACHE_BANK   // the trailing destination, a constant here
    lem                        // farrtn left the window open

    // 2. The version, checked before anything is believed. V3, V4 and V5
    // are claimed. The byte is 0..0377, so the differences cannot
    // overflow, and 3 - 3 leaves plus zero.
    lio [ZBH_VERSION]
    jsp zbHdrWord
    sar 8s                     // the version byte is the word's high half
    and [0377]
    dac zhVersion
    sub [3]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp zbiBadVer                           // V1, V2 or 0
    sub [3]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zbiBadVer                           // V6 and up
    // Every version-dependent word, before anything below reads one
    // (zbPropDefBytes, zbFlScale, ...). The walk is total: see zpatch.ac.
    lio zhVersion
    farjsp(zpApply:*)
    lem                        // farrtn left the window open

    // 3. The rest of the header.
    lio [ZBH_HIGHMEM]
    jsp zbHdrWord
    dac zhHighMemBase

    lio [ZBH_INITIAL_PC]
    jsp zbHdrWord
    fardac(zhInitialPC:0)      // bank 0 only: zdispatch.ac is its one reader

    lio [ZBH_DICT]
    jsp zbHdrWord
    dac zhDictAddr

    lio [ZBH_OBJTABLE]
    jsp zbHdrWord
    dac zhObjTableAddr

    lio [ZBH_GLOBALS]
    jsp zbHdrWord
    fardac(zhGlobalsAddr:0)    // bank 0 only: zstack.ac's two reads
    // zstack.ac's zsGlobPtr, zReadVar's in-place pointer: global 16's
    // resident word, less 16. Only for an even address, where the
    // containing word is the Z-machine word; an odd one stores 0, and
    // zReadVar keeps zFetchWord's path. The globals are dynamic memory, so
    // always resident. Stored at every boot, so no session inherits
    // another story's pointer.
    cli
    rcr 1s                     // AC = the word index; IO's sign = the low bit
    add [DYNMEM_BANK1*010000-0d16]
    spi
    cla                           // odd: 0, no pointer
    fardac(zsGlobPtr:0)

    lio [ZBH_STATIC_BASE]
    jsp zbHdrWord
    dac zbStaticBase           // this bank's copy, for the arithmetic below
    fardac(zhStaticBase:0)     // and bank 0's, zarith.ac's store bound

    lio [ZBH_FLAGS2]
    jsp zbHdrWord
    dac zhFlags2

    // Undo, for a V5 story whose file asks for it (Flags2 bit 4), and never
    // in a census image, whose tables hold bank 14 where the undo code and
    // its stack copy would be. zbUndoBit is 020 or 0: the bit zbHeaderSetup
    // leaves in Flags2, and step 8's test for the smaller resident region.
    // zuBoot records it and discards any snapshot before the load and the
    // header writes below, so no store of this boot is logged against an
    // earlier session's snapshot.
    dzm zbUndoBit
#if !Z_CENSUS
    lac zhVersion
    SKIP_NEXT_IF_SAME [5]
    jmp zbiUndoSet                // V3 or V4: no undo
    lac zhFlags2
    and [ZB_FLAGS2_UNDO]
    dac zbUndoBit              // 020 if the story asks for undo, else 0
zbiUndoSet,
#endif
    lio zbUndoBit
    farjsp(zuBoot:*)           // zsave.ac, bank 14
    lem                        // farrtn left the window open

    lio [ZBH_ABBREV]
    jsp zbHdrWord
    dac zhAbbrevAddr

    // The file length is in units of 2 bytes for V1-V3, 4 for V4-V5 and 8
    // for V6-V8 (S11.1.6). The AC is 18-bit ones' complement, largest
    // positive 0d131071, so V3's length in bytes (at most 0d131070) fits
    // but V4/V5's (at most 0d262140) does not: it would read as negative,
    // and every `sar` and sign test would answer backwards. So every
    // version computes the length in words, at most 0d131070, the unit
    // every consumer wants (storyTracks below, zsave.ac's `verify` walk).
    // V3's unit is a word. At V4+ zhFileLengthBytes is left zero, and
    // nothing reads it. Three words are patched.
    lio [ZBH_FILE_LENGTH]
    jsp zbHdrWord
zbFlScale,
    nop                        // patched: V4/V5 `sal 1s`, the field x2 =
                               //   the length in words
    dac zhFileLengthWords
zbFlBytes,
    sal 1s                     // patched: V4/V5 `cla`, zeroed rather than
    dac zhFileLengthBytes      //   left wrong
    add zbFlAdd                // V3: bytes + 1; V4/V5: 0 + ZB_ADDR_CEILING
    dac zhFileLenPlus1         // zobjects.ac's zObjCount sentinel

    lio [ZBH_CHECKSUM]
    jsp zbHdrWord
    dac zhChecksum

    // 4. The constant-expression words.
    lac zhObjTableAddr
    add zbPropDefBytes         // patched: 0d62 (V3), 0d126 (V4+)
    dac zhObjEntriesBase

    // 5. The dynamic-memory size, rounded up. An odd static base is legal,
    // and its last word then holds one byte of dynamic memory and one of
    // static; truncating would leave that byte unloaded.
    lac zbStaticBase
    add [1]
    sar 1s
    dac zhDynWords

    lac zhDynWords
    add [0d4095]
    sar 6s
    sar 6s                     // 0d9 is the largest shift count, so 6+6
    dac zhDynBanks

    lac zhDynBanks
    SKIP_NEXT_IF_DIFFERENT [Z_MAX_DYN_BANKS]
    jmp zbiDynOk                                 // exactly fits
    sub [Z_MAX_DYN_BANKS]      // unequal, so no -0: only the sign is used
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zbiTooDyn                 // more banks than there are
zbiDynOk,

    // 6. The story's size against the drum. storyWords is
    // zhFileLengthWords (step 3), parked in zhResidentWords for step 8 to
    // clip. zloader.c installs the story to the header's declared length
    // and drops any padding, so both programs agree on the size. A length
    // field of 0 is the exception: zloader installs the whole file, this
    // reaches 0 tracks and passes, and step 8 keeps dynamic memory alone.
    // The track count is taken by rotating, not shifting: past 126,976
    // words the sum passes 0377777 and a `sar` would fill with the sign.
    // The 18-bit sum is still right unsigned (under 2^18), so it is rotated
    // right 12 places and masked to its top six bits. Step 5 can shift:
    // dynamic memory is at most 32,768 words.
    lac zhFileLengthWords
    dac zhResidentWords        // storyWords, for step 8
    add [0d4095]
    rar 6s
    rar 6s                     // the sum's top six bits, now its bottom six
    and [077]
    dac storyTracks

    lac storyTracks
    SKIP_NEXT_IF_DIFFERENT [Z_DRUM_TRACKS]
    jmp zbiSizeOk                               // fills the drum exactly
    sub [Z_DRUM_TRACKS]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zbiTooBig                 // over the end of the drum
zbiSizeOk,

    // 7. There is no step 7: zsave.ac's zsvMount sizes a save's tape
    // position from zhDynWords when a save or restore first needs it.

    // 8. How much of the story to keep resident. Every fetch below
    // zhResidentTop reads banks 1..N directly; only high memory above it
    // goes through the page cache.
    //     residentWords = min(storyWords, zbResidentCap)
    //     residentWords = max(residentWords, zhDynWords)
    //     zhResidentTop = residentWords << 1        (a byte address)
    // The max is the coherency invariant, zhResidentTop >= zhStaticBase:
    // stores write only the resident copy (zResidentWordPtr), and the one
    // store bound, zarith.ac's zaCheckDyn, is on zhStaticBase, so an
    // address below the static base must never be served from the cache.
    // It also makes every odd header (a zero or short length field, which
    // some early V3 files carry, or a cap of 0) keep dynamic memory alone.
    // The arithmetic stays positive: storyWords is at most 0d131070 and
    // the cap 0137000, so the byte address is at most 0276000, and `sal`
    // zero-fills. The top is always below 0x20000, which lets
    // zFetchContainingWord's V4+ sign test stay first.
    // Unlike step 5, neither compare needs an equality test: an equal pair
    // gives the same answer down either arm, and the sub leaves +0.
    // A story with undo keeps at most ZB_UNDO_CAP words, since ZCOLD_BANK
    // below its code is the undo log. The smaller cap is used, in `cap`;
    // zbResidentCap is not changed, as the next story may have no undo.
    lac zbResidentCap
    dac cap
    lac zbUndoBit
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zbiCap                    // no undo: zbResidentCap as it is
    lac cap
    sub [ZB_UNDO_CAP]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp zbiCap                       // below eleven banks: keep it
    lac [ZB_UNDO_CAP]
    dac cap
zbiCap,
    lac cap
    sub zhResidentWords        // cap - storyWords
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zbiCapOk                  // it fits under the cap
    lac cap
    dac zhResidentWords        // over: keep the first `cap` words
zbiCapOk,
    lac zhResidentWords
    sub zhDynWords             // residentWords - dynWords
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zbiFloorOk                // at or above dynamic memory: keep it
    lac zhDynWords
    dac zhResidentWords        // never less than dynamic memory
zbiFloorOk,
    lac zhResidentWords
    sal 1s                     // the byte address of the first word not kept
    fardac(zhResidentTop:0)    // bank 0 only: zFetchContainingWord's router

    // 9. The resident region, loaded from the drum. A drum track and a
    // memory bank are both 0d4096 words, so for 0d256-word page p:
    //     drum track       =  p >> 4          destination bank = (p >> 4) + 1
    //     in-track offset  = (p & 017) << 8   in-bank offset   = the same
    // and each quantity is computed once and used twice (zResidentWordPtr
    // would re-derive them from a byte address). The identity holds for
    // tracks 0..0d11 against banks 1..0d12, all the region can reach.
    // Each page costs about one drum revolution, so a full region takes
    // several seconds. The page count is rounded up: a partial last page
    // over-reads words at or above zhResidentTop, which no fetch reads, and
    // never reaches ZCOLD_BANK's code, since the cap is whole pages.
    lac zhResidentWords
    add [0d255]
    sar 8s
    dac pageCount

    cla
    dac pageNo
zbiLoadLoop,
    lac pageNo
    SKIP_NEXT_IF_DIFFERENT pageCount
    jmp zbiLoadDone                       // every page is loaded

    lac pageNo
    sar 4s
    dac trackNo                // the drum track, and one below the bank

    lac pageNo
    and [017]
    sal 8s
    dac inTrack                // the in-track offset and the in-bank offset

    lac trackNo
    fardac(fillTrack:0)
    lac inTrack
    fardac(fillTrackOffset:0)

    lac trackNo
    add [DYNMEM_BANK1]
    sal 6s
    sal 6s                     // AC = the destination bank << 12
    ior inTrack
    dac fillDest               // zfDrumFillPage's trailing destination,
    farjsp(zfDrumFillPage:0)   //   which varies per page
fillDest, 0
    lem                        // farrtn left the window open

    idx pageNo
    jmp zbiLoadLoop
zbiLoadDone,
    // 10. The header fields the interpreter sets: after the copy, so they
    // land in the resident words the story reads, and on every boot, so a
    // restart (which re-runs this routine) sets them again. eem is off:
    // the loop's last act was the `lem` after zfDrumFillPage.
zbiHdrSetup,
    jsp zbV3Flags1             // patched: V4/V5 `jsp zbHeaderSetup`

    cla                        // AC = ZBOOT_OK
    farrtn(rtn)

zbiBadVer,
    lac [ZBOOT_BADVER]
    farrtn(rtn)

zbiTooDyn,
    lac [ZBOOT_TOODYN]
    farrtn(rtn)

zbiTooBig,
    lac [ZBOOT_TOOBIG]
    farrtn(rtn)

rtn, 0
pageNo, 0
pageCount, 0
trackNo, 0
inTrack, 0
storyTracks, 0
cap, 0
    endlocal

// Reads one word of the story header from the cache slot zBootInit filled.
// Entry: IO = a header word index, 0..0d31; the window is closed.
// Exit:  AC = the packed story word at that index.
// AC is the result, IO is clobbered. Called via jsp, same bank only;
// returns with the window closed.
zbHdrWord,
    local rtn, ptr
    dap rtn
    lai
    add [zCacheSlot0:DYNMEM_CACHE_BANK]
    dac ptr                    // a full (bank:offset) pointer, so the
    eem                        //   indirect needs the window open,
    lac i ptr
    lem                        //   and closed again
    jmp rtn
rtn, jmp 0
ptr, 0
    endlocal

// Writes the V4+ header fields S11.1 marks "Int", the interpreter's own
// answers, which the story reads at run time.
// No arguments. AC and IO are clobbered. Called via jsp, same bank only,
// with the window closed, which the bare-pointer table walk needs; returns
// with it closed. Two callers: zBootInit at zbiHdrSetup, and zbRestHdr
// after every restore (V4/V5's values of those patched words).
//
//   byte       field                        value
//   0x00-0x01  version, Flags1              the story's (zbHdrVer), 0234;
//                                             0200 in plain mode;
//                                             V5 0235 if the client claimed
//                                             color
//   0x1E       interpreter number           1 (DECSystem-20)
//   0x1F       interpreter version          'A'
//   0x20       screen height, lines         the terminal's rows (24)
//   0x21       screen width, characters     the terminal's columns (80)
//   0x22 (V5)  screen width in units        the columns again
//   0x24 (V5)  screen height in units       the rows again
//   0x26 (V5)  font width, height in units  1, 1
//   0x2C (V5)  default background, foreground  2 (black), 9 (white)
//   0x10 (V5)  Flags2: bits 3, 5, 7, 8 cleared; bit 4 too
//              unless the story has undo
//
// The size is the connection's. ztext.ac's zTermQuery asks the terminal
// before every session's zBootInit and writes zbHdrTab's three size words
// (zbHdrSize, zbHdrWidthU, zbHdrHeightU) and zbF1Mask. The figures in
// brackets are their initial values: what an image that never asks (every
// test entry) writes, and what the query writes for a client that answered
// badly or not at all. zpApply patches two neighbors of these words at
// every boot, after the query (zbHdrVer and zbHdrV5), and none of the four.
//
// Flags1 = 0234: bit 7, timed input, honored by read_char, sread through
// V4 and V5 aread (a census build reads lines untimed: zinput.ac's
// `#if Z_CENSUS`). Bits 2-4 are bold, italic and fixed-space, which
// set_text_style renders (zscreen.ac), italic as underline. Bit 0 (colors)
// is set only in V5's value in zpApply's table, 0235, and kept only for a
// client that claimed color. The byte is written whole. zbHdrVer is masked
// with zbF1Mask here rather than in the query, because zpApply rewrites
// zbHdrVer at every boot, after the query. The mask clears bit 0 unless
// color was claimed, and in plain mode bits 2-4 too; its initial value
// clears bit 0.
//
// The default colors, 0x2C background 2 and 0x2D foreground 9, black and
// white, are what zscreen.ac's zsReset means by the default (SGR 39 and
// 49): V5 only, like the rest of the table from 0x22, and written whether
// or not color was claimed.
//
// Interpreter 1, version 'A', which a story prints in its banner. The
// height is the terminal's, not S8.4.1's "infinite" 255: V5 stories size
// full-screen menus from it (`loadb 0 0x20; sub 1; split_window`). The
// interpreter never pages (no [MORE]); the terminal scrolls the lower
// window. The width is what stories compute their margins from.
//
// Flags2: S11.1 has the interpreter clear bits 3, 4, 5, 7 and 8 (pictures,
// UNDO, mouse, sound, menus) if it cannot provide them. Only UNDO is
// provided, and only to a story whose file asks for it: zbUndoBit puts
// bit 4 back. Bit 6 (colors) is left as the story set it; availability is
// Flags1 bit 0. Bits 0-2 are the story's and the transcript's, and
// zsave.ac's restart merges its own survivors in after zBootInit returns.
//
// A restore runs all of this again. A save carries dynamic memory, header
// included, as the image and terminal that made it set it; S11.1 marks
// every field above "Rst", and the size is the connection's, so a game
// saved on a 30x100 terminal and restored on a 24x80 one is told 24x80.
// Nothing written here is summed by `verify` (from 0x40), no zh* word
// zBootInit parsed changes, and Flags2's bits 0-2 are left alone. The
// Standard revision word, 0x32, stays 0.
//
// V5 also sets the keypad's mode: the last call, ztext.ac's zkKeypad,
// sends ESC = to a client that answered the query when the story's
// terminating characters take the keypad. A restart or restore sends it
// again, which a terminal takes as a no-op.
#define ZB_HDR_END      0777         // not an even header byte address
#define ZB_FLAGS1       0234         // bit 7 timed input; bits 2-4 styles
#define ZB_F1_COLOR     1            // bit 0, colors: V5's value only
#define ZB_COLORS       0d2*0400+0d9 // 0x2C background black, 0x2D foreground white
#define ZB_INTERP_NUM   1            // DECSystem-20
#define ZB_INTERP_VER   0101         // 'A'
#define ZB_SCREEN_H     030          // 24 lines: zbHdrTab's initial size
#define ZB_SCREEN_W     0120         // 80 characters
#define ZB_FLAGS2_KEEP  0177107      // V5: every bit but 3, 4, 5, 7 and 8

zbHeaderSetup,
    local rtn, ptr, addr
    dap rtn
    lac zbHdrVer               // Flags1's color and style bits, masked per
    and zbF1Mask               //   the client, after zpApply rewrote the word
    dac zbHdrVer
    law zbHdrTab
    dac ptr                    // a bare in-bank pointer: eem must be off
zbhsLoop,
    lac i ptr                  // the byte address, or ZB_HDR_END
    SKIP_NEXT_IF_DIFFERENT [ZB_HDR_END]
    jmp zbhsFlags2                          // the end of the table
    dac addr
    idx ptr
    lac i ptr
    lia                        // IO = the word to write there
    idx ptr
    lac addr
    farjda(zStoreWord:0)
    lem                        // farrtn left the window open, and the next
    jmp zbhsLoop               //   `lac i ptr` needs it shut
zbhsFlags2,
    jmp zbhsRet                // patched: V5 `nop`, Flags2 is V5's alone
    lio [0d16]                 // Flags2, the word at 0x10
    farjsp(zFetchWord:0)
    lem
    and [ZB_FLAGS2_KEEP]
    ior zbUndoBit              // bit 4 stays for a story with undo
    lia
    lac [0d16]
    farjda(zStoreWord:0)
    lem
    lac [1]                    // arm zReadLine's S switch (ztext.ac) until
    dac zsFirst                //   the first line of this boot, restart or
                               //   restore
    jsp zkKeypad               // ESC =, the keypad's application mode, for
                               //   a story whose terminating characters
                               //   take the keypad (ztext.ac; eem is off)
zbhsRet,
    jmp rtn
rtn, jmp 0
ptr, 0
addr, 0
    endlocal

// The V3 counterpart of zbHeaderSetup: sets the V1-3 Flags1 bits S11.1
// marks "Int" and "Rst" that this interpreter has an answer for, and
// leaves the rest of the byte as the story shipped it.
// No arguments. AC and IO are clobbered. Called via jsp, same bank only;
// returns with the window closed. Two callers: zBootInit at zbiHdrSetup
// (boot, every `restart` and each serve-loop connect), and zbRestHdr
// after every restore (V3's values of those patched words).
//
//   bit 4  "Status line not available?"   cleared: zdhShowStatus draws it
//   bit 5  "Screen-splitting available?"  set: split_window works in V3
//   bit 6  "Is a variable-pitch font      cleared: a terminal's
//           the default?"                 font is fixed-pitch
//
// Bits 1-3 are the story's (status line type, the two-disc flag). A story
// that tests bit 5 before splitting would otherwise not split. Plain mode
// leaves bit 5 set: window 1's text still comes out, as lines.
zbV3Flags1,
    local rtn
    dap rtn
    lio [1]                    // Flags1, header byte 1
    farjsp(zFetchByte:0)
    lem                        // farrtn left the window open
    and [0257]                 // bit 4 clear: the status line is available;
                               //   bit 6 clear: fixed-pitch
    ior [040]                  // bit 5 set: the screen can be split
    lia
    lac [1]
    farjda(zStoreByte:0)
    lem
    jmp rtn
rtn, jmp 0
    endlocal

// Sets the header fields S11.1 marks "Rst" again after a restore, since
// the save carries whatever the image and terminal that made it wrote.
// zsave.ac's restore calls it once memory is the save's (zsvrDone).
// No arguments. AC and IO are clobbered. Called via farjsp; returns with
// the window open (farrtn). The call is patched: V3 runs zbV3Flags1,
// V4/V5 zbHeaderSetup, both entered with the window closed by farenter.
zbRestHdr,
    local rtn
    farenter(rtn)
zbrhCall,
    jsp zbV3Flags1             // patched: V4/V5 `jsp zbHeaderSetup`
    farrtn(rtn)
rtn, 0
    endlocal

// The (byte address, word) pairs, ended by ZB_HDR_END. Each word is two
// header bytes, high byte first, as S11 lays them out. Two words are
// patched: the version byte (zbHdrVer), and zbHdrV5, which ends the table
// after 0x20 unless the story is V5. Three are the connection's, written
// by ztext.ac's zTermQuery: zbHdrSize, zbHdrWidthU and zbHdrHeightU.
zbHdrTab,
    0                                    // 0x00: version, Flags1
zbHdrVer, 3*0400+ZB_FLAGS1               // patched: the story's version
    0d30                                 // 0x1E: interpreter number, version
    ZB_INTERP_NUM*0400+ZB_INTERP_VER
    0d32                                 // 0x20: height, width in characters
zbHdrSize, ZB_SCREEN_H*0400+ZB_SCREEN_W  // the query's rows, columns
zbHdrV5, ZB_HDR_END                      // patched: V5 0d34, 0x22: width in units
zbHdrWidthU, ZB_SCREEN_W                 // the query's columns
    0d36                                 // 0x24: height in units
zbHdrHeightU, ZB_SCREEN_H                // the query's rows
    0d38                                 // 0x26: font width, height in units
    0401
    0d44                                 // 0x2C, 0x2D: the default colors
    ZB_COLORS
    ZB_HDR_END

// What zbHeaderSetup masks zbHdrVer with, written by the query at every
// connect: bit 0 (colors) clear unless the client claimed color, and
// Flags1's bits 2-4 (the styles) clear in plain mode. The initial value,
// what a test entry runs with, clears bit 0.
zbF1Mask, 0777776

// The two patched constants zBootInit reads (step 3, and the
// property-defaults note at the top of this file).
zbPropDefBytes, 0d62                     // patched: V4/V5 0d126
zbFlAdd, 1                               // patched: V4/V5 ZB_ADDR_CEILING

// Prints the refusal for a failed zBootInit on the DCS2 channel the
// caller has opened. Any code but ZBOOT_TOOBIG or ZBOOT_TOODYN prints the
// version message, so no refusal goes unexplained.
// Entry: IO = the ZBOOT_* code.
// No result. AC and IO are clobbered. Called via farjsp, from `boot`
// only; returns with the window open (farrtn). It is separate from
// zBootInit so every refusal can be reached with no client attached
// (zmemcore.am1's testBootInit).
zBootRefuse,
    local rtn, msgPtr, packed, code
    farenter(rtn)              // the window closed, for the bare-pointer walk
    lai
    dac code

    SKIP_NEXT_IF_DIFFERENT [ZBOOT_TOOBIG]
    jmp zbrBigMsg
    lac code
    SKIP_NEXT_IF_DIFFERENT [ZBOOT_TOODYN]
    jmp zbrDynMsg
    law zbMsgBadVer                            // everything else
    jmp zbrHaveMsg
zbrBigMsg,
    law zbMsgTooBig
    jmp zbrHaveMsg
zbrDynMsg,
    law zbMsgTooDyn
zbrHaveMsg,
    dac msgPtr

    // The message is an `ascii` block: two characters a word, the first in
    // the high 9 bits, ended by a zero byte (Docs/UsingAM1.md, "Ascii").
    // Its line breaks are \r, ZSCII 13, not \n: zPrintChar passes 13 as the
    // Z-machine's newline and drops 10 as an out-of-range control code.
zbrLoop,
    lac i msgPtr               // a bare pointer: eem must be off
    dac packed
    sar 9s                     // the first character, from the high half
    and [0777]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zbrDone                   // the zero byte: the end of the string
    lia
    jsp zPrintChar             // this bank; returns with the window open,
    lem                        //   so close it

    lac packed
    and [0777]                 // the second character, from the low half
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zbrDone
    lia
    jsp zPrintChar
    lem

    idx msgPtr
    jmp zbrLoop
zbrDone,
    farrtn(rtn)

rtn, 0
msgPtr, 0
packed, 0
code, 0
    endlocal

// The refusal messages, short: they cost a word per two characters of this
// bank. They say which condition fired; the numbers are in zhVersion,
// zhDynBanks and zhFileLengthWords for anyone reading core. Under `boot`
// the machine then waits at the error prompt; under testBootInit it halts.
zbMsgBadVer,
    ascii "\rNot a V3, V4 or V5 story file.\r"
zbMsgTooBig,
    ascii "\rStory is too large for the drum.\r"
zbMsgTooDyn,
    ascii "\rStory dynamic memory is too large.\r"

// The boot-parsed header words this bank's leaf fragments read (see this
// file's header for which reader wants which).
zhObjTableAddr, 0
zhObjEntriesBase, 0
zhFileLenPlus1, 0
zhDictAddr, 0
zhAbbrevAddr, 0

// Read by zsave.ac: zhChecksum for `verify` and a save's identity,
// zhDynWords for a save's size, zhFileLengthWords (every version: step 3)
// for `verify`'s walk, and zhFlags2 for the transcript and fixed-pitch
// bits the spec has the interpreter maintain.
zhVersion, 0
zhHighMemBase, 0
zhChecksum, 0
zhFileLengthBytes, 0
zhFileLengthWords, 0
zhFlags2, 0
zhDynWords, 0
zhDynBanks, 0

// The resident region's size in words, as step 8 left it. Nothing reads
// it (the router uses zhResidentTop); it is kept for tests and for anyone
// reading a halted machine.
zhResidentWords, 0

// How many words boot may keep resident: Z_RESIDENT_WORDS in every build.
// A word, not a literal, so a test can poke it before `start
// testBootInit` (the CPU is halted until then); 0 reduces the region to
// dynamic memory. A value above Z_RESIDENT_WORDS is outside the contract:
// it would load over ZCOLD_BANK's code.
zbResidentCap, Z_RESIDENT_WORDS

// 020 (Flags2's UNDO bit) when this session's story has undo, else 0.
// zBootInit sets it; zbHeaderSetup puts the bit back into Flags2, and
// step 8 lowers the cap by it.
zbUndoBit, 0

// This bank's working copy of the static base. Not named zhStaticBase,
// the bank-0 word zarith.ac reads: am1 keeps a symbol table per bank, so a
// bare reference in this bank would silently pick up a different word.
zbStaticBase, 0

#endif // ZBOOT_AC_H
