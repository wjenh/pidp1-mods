// ========================================================================
// zfont3.ac -- font 3: the translator from a font 3 code to the bytes the
// connection's terminal draws it with, and the VT220 soft font.
//
// #include-only fragment, assembled into bank ZPATCH_BANK (0d14) after
// zsave.ac. Entry points: zfSend and zfLoad, both far calls (farenter,
// farrtn), from bank 15 (ztext.ac's zpcSend and zTermQuery) and bank 13
// (zscreen.ac's zsPutUpper).
//
// ---- The tiers ----------------------------------------------------------
// ztext.ac's zTermQuery decides one for each connection, in zsTier:
//   3  A  soft font   the DA reply lists 7 (DRCS). The font is loaded
//                     once, at connect (zfLoad, below), into G1, and each
//                     character goes as SO, its own code, SI
//   2  U  Unicode     the UTF-8 test reported column 2. The code point of
//                     zfExact, or of zfSafe after the player's S (zsSafe)
//                     for a code that has a safe entry, UTF-8 encoded.
//                     No SO, no SI
//   1  D  DEC         the terminal answered, but not as A or U. G1 is DEC
//                     Special Graphics (ESC ) 0, sent at connect): a line
//                     or a corner goes as SO, its DEC byte, SI; anything
//                     else as its stand-in
//   0  C  plain       a silent client: the stand-in, and no escapes
// SO and SI go round EVERY character on tiers A and D, never a held shift:
// DCS2 echoes typing in whatever set is locked in.
//
// Every glyph is one column, whatever its bytes: zsPutUpper counts one.
//
// ---- The tables ---------------------------------------------------------
// Built from the font 3 glyphs of the Z-Machine Standard (S16):
//   zfInfo    95 words, 32-126: the stand-in, the DEC byte, the safe index
//   zfExact   95 words, 32-126: tier U's code point
//   zfSafe    30 words: the safe code points
//   zfGlyph   94 glyphs, 33-126, 5 words each: the soft font's sixels
// zfGlyph and zfLoad are left out of a census image (Z_CENSUS): the census
// keeps its tables at the top of this bank, from 04440, and a census
// image never offers tier A.
// ========================================================================

#ifndef ZFONT3_AC_H
#define ZFONT3_AC_H

#include <memory.ah>
#include <AIDS/skipmacros.ah>

#define ZF_SO 016                        // shift out: G1
#define ZF_SI 017                        // shift in: G0

// ========================================================================
// zfSend -- sends a font 3 code's bytes for the connection's tier with `tcc`.
// Called via farjsp(zfSend:*); returns with the window open (farrtn).
//   IO in   a font 3 code, 32-126 (range-checked by the caller; 13 is
//           the caller's). With 0400000 added: send nothing, only look up.
//   AC out  the code's ASCII stand-in, for the transcript.
// ========================================================================
zfSend,
    local rtn, code, look, info, cp, ptr
    farenter(rtn)                        // the window is closed: `lac i ptr`
    dio code
    lac code
    and [0400000]
    dac look                             // nonzero: look up only
    lac code
    and [0177]
    dac code
    add [zfInfo-0d32]
    dac ptr
    lac i ptr
    dac info
    lac look
    SKIP_NEXT_IF_AC_ZERO                 // sza: skip (fallthrough) to send
    jmp zfsRet                              // no-skip: the stand-in only
    farlac(zsTier:*)                     // AC = the tier; the window closed again
    SKIP_NEXT_IF_DIFFERENT [3]           // sad: skip (fallthrough) unless A
    jmp zfsSoft
    SKIP_NEXT_IF_DIFFERENT [2]           // sad: skip (fallthrough) unless U
    jmp zfsUni
    SKIP_NEXT_IF_DIFFERENT [1]           // sad: skip (fallthrough) unless D
    jmp zfsDec

// Tier C, and tier D's codes with no DEC byte: the stand-in.
zfsStand,
    lac info
    and [0177]
    lia
    tcc
zfsRet,
    lac info
    and [0177]                           // AC = the stand-in
    farrtn(rtn)

// Tier A: SO, the code, SI. A space has no glyph in the soft font (it
// holds 33-126) and goes as a space, which is its stand-in.
zfsSoft,
    lac code
    SKIP_NEXT_IF_DIFFERENT [0d32]        // sad: skip (fallthrough) unless a space
    jmp zfsStand
    dac cp
zfsShift,                                // SO, cp, SI
    lio [ZF_SO]
    tcc
    lio cp
    tcc
    lio [ZF_SI]
    tcc
    jmp zfsRet

// Tier D: the DEC byte in SO and SI, or the stand-in.
zfsDec,
    lac info
    sar 7s
    and [037]
    SKIP_NEXT_IF_AC_NOT_ZERO             // sza i: skip (fallthrough) if a DEC byte
    jmp zfsStand
    add [0140]
    dac cp
    jmp zfsShift

// Tier U: the safe code point if the player chose the safe set and the
// code has one, else the exact one; then UTF-8.
zfsUni,
    lac info
    sar 9s
    sar 3s
    and [077]                            // the safe index, 1-30, or 0
    SKIP_NEXT_IF_AC_NOT_ZERO             // sza i: skip (fallthrough) if it has one
    jmp zfsExact
    add [zfSafe-1]
    dac ptr
    farlac(zsSafe:*)
    SKIP_NEXT_IF_AC_NOT_ZERO             // sza i: skip (fallthrough) if S was chosen
    jmp zfsExact
    jmp zfsCp
zfsExact,
    lac code
    add [zfExact-0d32]
    dac ptr
zfsCp,
    lac i ptr                            // the window is closed
    dac cp

// UTF-8: below 0200 one byte; below 04000 two, 110xxxxx 10xxxxxx; else
// three, 1110xxxx 10xxxxxx 10xxxxxx. Every code point is below U+10000
// and positive, so `sar` brings in zeros.
    sub [0200]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE         // sma i: skip (fallthrough) if 0200 or above
    jmp zfsOne
    lac cp
    sub [04000]
    SKIP_NEXT_IF_AC_NEGATIVE             // sma: skip (fallthrough) if below 04000
    jmp zfsThree
    lac cp
    sar 6s
    ior [0300]
    lia
    tcc
    jmp zfsLow
zfsThree,
    lac cp
    sar 9s
    sar 3s
    ior [0340]
    lia
    tcc
    lac cp
    sar 6s
    and [077]
    ior [0200]
    lia
    tcc
zfsLow,
    lac cp
    and [077]
    ior [0200]
    jmp zfsByte
zfsOne,
    lac cp
zfsByte,
    lia
    tcc
    jmp zfsRet

rtn, 0
code, 0
look, 0
info, 0
cp, 0
ptr, 0
    endlocal

#if !Z_CENSUS
// ========================================================================
// zfLoad -- sends the soft font, then designates it into G1. Called via
// farjsp(zfLoad:*) from zTermQuery on tier A, once for each connection.
// No arguments; AC and IO clobbered; returns with the window open.
//
//   ESC P 1 ; 1 ; 0 ; 4 ; 1 ; 1 { SP @   DECDLD: font buffer 1, from
//                                          character 1 (033, '!'), erase
//                                          the set, a 7x10 matrix (Pcms
//                                          4), 80 columns, a text font
//   94 glyphs, each  upper/lower,  separated by ';'
//   ESC \                                  the string terminator
//   ESC ) SP @                             G1 = the soft set
// (DEC's VT220 Programmer Reference, section 4.16.)
// About 1,530 bytes, on `tcc`, as zTermQuery sends its query.
// ========================================================================
zfLoad,
    local rtn, ptr, w, k, n3, ng
    farenter(rtn)                        // the window is closed: `lac i ptr`
    lio [zfDldHead]
    jsp zfPuts
    law zfGlyph
    dac ptr
    law i 0d94
    dac ng
zflGlyph,
    dzm k                                // sixels sent of this glyph
zflWord,
    lac i ptr
    dac w
    idx ptr
    law i 3
    dac n3
zflSix,
    lac w
    ral 6s                               // the next sixel into the low six bits
    dac w
    and [077]
    add [077]                            // '?' is sixel 0
    lia
    tcc
    idx k                                // AC = sixels sent
    SKIP_NEXT_IF_DIFFERENT [7]           // sad: skip (fallthrough) unless the band ends
    jmp zflSlash
    SKIP_NEXT_IF_DIFFERENT [0d14]        // sad: skip (fallthrough) unless the glyph ends
    jmp zflEnd
zflNext,
    isp n3
    jmp zflSix                              // no-skip: this word has more
    jmp zflWord
zflSlash,
    lio [0d47]                           // '/': the lower band
    tcc
    jmp zflNext
zflEnd,
    isp ng
    jmp zflSemi                             // no-skip: glyphs remain
    lio [zfDldTail]
    jsp zfPuts
    farrtn(rtn)
zflSemi,
    lio [0d59]                           // ';': the next glyph
    tcc
    jmp zflGlyph

// zfPuts -- sends a 0-terminated table of one byte a word with `tcc`.
// Called via jsp, from zfLoad only. IO = a bare in-bank pointer to the
// table. The window is closed.
zfPuts,
    dap zfpX
    dio zfpP
zfpLoop,
    lac i zfpP
    SKIP_NEXT_IF_AC_NOT_ZERO             // sza i: skip (fallthrough) on a byte
    jmp zfpX
    lia
    tcc
    idx zfpP
    jmp zfpLoop
zfpX, jmp .
zfpP, 0

rtn, 0
ptr, 0
w, 0
k, 0
n3, 0
ng, 0
    endlocal

zfDldHead,                               // ESC P 1;1;0;4;1;1 { SP @
    033
    0d80                                 // 'P'
    0d49                                 // '1'
    0d59                                 // ';'
    0d49                                 // '1'
    0d59
    0d48                                 // '0'
    0d59
    0d52                                 // '4'
    0d59
    0d49                                 // '1'
    0d59
    0d49                                 // '1'
    0d123                                // '{'
    0d32                                 // SP
    0d64                                 // '@'
    0
zfDldTail,                               // ESC \, then ESC ) SP @
    033
    0d92                                 // '\'
    033
    0d41                                 // ')'
    0d32
    0d64
    0
#endif // !Z_CENSUS

