    lac propSave
    sub [1]
    sal 1s
    add zhObjTableAddr
    and [0177777]                  // 16 bits -- the header's invariant
    lia
    farjsp(zFetchWord:0)
    crossBankrtn(rtn, NOEEM)

rtn, 0
propSave, 0
dataAddr, 0
