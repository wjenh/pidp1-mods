    jmp zgpaNotFound3                  // no-skip: found == 0
    add [1]
    crossBankrtn(rtn, NOEEM)

zgpaNotFound3,
    cla
    farrtn(rtn)

rtn, 0
found, 0
    endlocal

// zGetPropLen -- a property's length.
// On call IO has a property DATA address, as returned by zGetPropAddr.
// Returns AC = the property's length in bytes (1-8 in V3, 1-64 in V4+).
// Address 0 returns 0, per S15's "@get_prop_len 0 must return 0".
// Called via jsp.
// The entry label is shared; the jump after it is PATCHED (zpatch.ac) to
// the version's body.
zGetPropLen,
zGetPropLenFork,
    jmp zGetPropLenV3                  // PATCHED: V4/V5 `jmp zGetPropLenV4`
// zGetPropLenV4 -- the section header's one length rule; zpFindProp and
// zGetNextProp walk by calling it:
//   - the byte before the data has bit 7 set: bits 0-5, and 0 means 64;
//   - bit 7 clear: bit 6 set gives 2, clear gives 1.
// S15 says get_prop_len of an address that is not a property's should
// halt "if it can efficiently check". It cannot: the byte before is read
// as a header whatever it is, as in V3.
zGetPropLenV4,
    local rtn, sizeByte
    farenter(rtn)
    lai
    SKIP_NEXT_IF_AC_NOT_ZERO       // sza i: skip (fallthrough) if addr != 0
    jmp zgplZero                       // no-skip: addr == 0
    sub [1]
    lia
    farjsp(zFetchByte:0)           // AC = the byte before the data
    dac sizeByte
    and [0200]
    SKIP_NEXT_IF_AC_NOT_ZERO       // sza i: skip (fallthrough) if bit 7 is set
    jmp zgplOne                        // no-skip: a one-byte header
    lac sizeByte
    and [077]                      // a two-byte header's length field
    SKIP_NEXT_IF_AC_NOT_ZERO       // sza i: skip if the field is nonzero...
    lac [0d64]                         // ...else S12.4.2.1.1: 0 means 64
    crossBankrtn(rtn, NOEEM)

zgplOne,
    lac sizeByte
    and [0100]
    sar 6s
    add [1]                        // bit 6: 2, else 1
    farrtn(rtn)

zgplZero,
    cla
    farrtn(rtn)

rtn, 0
sizeByte, 0
    endlocal
// zGetPropLenV3 -- the size byte just before the data gives the length.
zGetPropLenV3,
    local rtn
    farenter(rtn)
    lai
    SKIP_NEXT_IF_AC_NOT_ZERO       // sza i: skip (fallthrough) if addr != 0
    jmp zgplZero3                       // no-skip: addr == 0
    sub [1]
    lia
    farjsp(zFetchByte:0)
    sar 5s
    add [1]
    crossBankrtn(rtn, NOEEM)

zgplZero3,
    cla
    farrtn(rtn)

rtn, 0
    endlocal

