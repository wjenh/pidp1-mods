// and checking object trees.
//
// testSetLinks: testObjIn = object, testArg2In = parent,
// testObjValueIn = sibling, testArg3In = child.
testSetLinks,
    lac testObjIn
    lio testArg2In
    jda zSetParent
    lac testObjIn
    lio testObjValueIn
    jda zSetSibling
    lac testObjIn
    lio testArg3In
    jda zSetChild
    hlt

// testObjLinks: testObjIn = object. testObjLinksOut = (parent<<8)|sibling
// -- both are single bytes in V3, so the pair fits an 18-bit word with
// room to spare -- and testObjResultOut = child.
//
// V3 ONLY in meaning. In a V4+ session the links are 16 bits and the
// packing loses them. testSetLinks is fine in both.
testObjLinks,
    lio testObjIn
    jsp zGetParent
    sal 8s
    dac testObjLinksOut
    lio testObjIn
    jsp zGetSibling
    ior testObjLinksOut
    dac testObjLinksOut
    lio testObjIn
    jsp zGetChild
    dac testObjResultOut
    hlt

#endif // Z_TEST_HARNESS

#endif // ZOBJECTS_AC_H
