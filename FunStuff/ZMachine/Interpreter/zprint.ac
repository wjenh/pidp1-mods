// zprint.ac -- the print and output opcode handlers, the status line's
// entry, and the transcript's Flags2 sync.
//
// #included into zmemcore.am1's bank 0, after zobjops.ac. print_num's
// formatter and the status line's body are zstatus.ac's, in ZCOLD_BANK.
//
// Entry points: the zdh* opcode handlers; zPrintStatus (jsp, also called
// by zinput.ac's sread); zpWatch, the tail of zarith.ac's storew and
// storeb. A handler is entered by `jmp` from zInterpret and leaves by
// `jmp zipNext`, so neither AC nor IO is live at entry or exit. Only EXT:12
// check_unicode stores; nothing here branches.
//
// Bank qualifiers: ZCOLD_BANK and ZLEAF_BANK are assembled after bank 0, so
// every cross-bank call here is a forward reference, `sym:*`.
//
// A same-bank call to zstack.ac or zmemcore.am1 (zFetchByte, zStoreByte,
// zStackPop) returns through `farrtn`, which leaves extend mode on, so each
// is followed by `lem`. zUnpackString returns by `jmp rtn` and needs none.
// A cross-bank farjsp/farjda also returns with extend mode on and gets no
// `lem`: zInterpret's `lem` after zInstDecode closes the window every
// iteration, and nothing in this file dereferences a pointer outside bank 0.
// That is safe only in bank 0; see the in-bank pointer rule in
// zmemcore.am1, above `bank ZLEAF_BANK`.
//
// Output stream 2 is the line printer (S7.1.2.2). The per-character work,
// `flb` and `prl`, is in ztext.ac's router in ZLEAF_BANK. The device setup,
// `lpf` and `lpm`, is here: `lpf` reads a filename string through IO, and a
// bare address is unambiguous only in bank 0. The Flags2 sync is here too,
// where zStoreByte is same-bank, and runs both ways (S7.4): output_stream
// keeps the bit truthful (zpFlags2On/Off), and a story's own storew/storeb
// of the bit opens or closes the transcript (zpWatch).
//
// IOT 45 is the Type 62 or the Type 64 printer, chosen at run time by
// `lptType64` in pidp1.config, and the two reuse the same IOT numbers for
// different functions (iot 0045 is the 62's `prl` and the 64's `lpb`; iot
// 1045 the 62's `flb` and the 64's `pas`). zmemcore.am1 picks one at build
// time with ZLPT_TYPE64 (default 0, the Type 62). For a transcript that
// comes out empty or scrambled, check first that the build flag and the
// config agree. `lpf` and `lpm` (iot 3045, 3145) are common to both.
// On the Type 62, `flb` takes its character from IO, and a line is committed
// by `prl` followed by `slp`, single-spaced with LPT_SP0. On the Type 64 the
// pair is one `pas`, where SP0 means overstrike and writes nothing, so the
// router uses SP1 and a Type 64 transcript is double-spaced.
//
// 0OP:9 is `pop` in V1-4 and `catch` in V5; the dispatch entry is patched
// (zdpE0op9). Nothing here halts: every bad input degrades.

zpTmp, 0

// Set or clear the transcript bit, Flags2 bit 0, at header byte 0x11
// (S11.1). S7.4 requires the bit to hold stream 2's current state; these
// are the output_stream half of that, zpWatch the storew/storeb half.
// AC and IO are clobbered. Called via jsp, same bank only; returns with the
// window closed.
zpFlags2On,
    local rtn
    dac rtn
    lac [0d17]
    lia
    jsp zFetchByte
    lem
    ior [1]
    lia
    lac [0d17]
    jda zStoreByte
    lem
    jmp i rtn
rtn, 0
    endlocal

zpFlags2Off,
    local rtn
    dac rtn
    lac [0d17]
    lia
    jsp zFetchByte
    lem
    and [0376]
    lia
    lac [0d17]
    jda zStoreByte
    lem
    jmp i rtn
rtn, 0
    endlocal

// 1OP:135 print_addr: print the string at a byte address. No address
// guard: zDecodeString's zdsBad covers a malformed string.
zdhPrintAddr,
    lac zdOp0
    and [ZW_MASK]
    lia
    farjsp(zDecodeString:*)
    jmp zipNext

// 1OP:141 print_paddr: print the string at a packed address.
zdhPrintPaddr,
    lac zdOp0
    and [ZW_MASK]
    lia
    jsp zUnpackString
    lia
    farjsp(zDecodeString:*)
    jmp zipNext

// VAR:229 print_char: print one ZSCII code. zPrintChar drops an
// out-of-range code itself (zpcBad).
zdhPrintChar,
    lac zdOp0
    and [ZW_MASK]
    lia
    farjsp(zPrintChar:*)
    jmp zipNext

// EXT:11 print_unicode and EXT:12 check_unicode (V5) share zpuPrintable, so
// the two never disagree about a code point.
// Printable here is Unicode 32 to 126 and nothing else: everything past
// zPrintChar is a raw byte on the DCS2 channel, ZSCII 32-126 is ASCII
// (S3.8.3), and there is no translation table above 126. Unicode 10 and 13
// are outside the set too; a story that wants a line break has new_line.
// A code point above 0xFFFF cannot be an operand, so ZW_MASK settles the
// range.

// Test whether a code is printable.
// Entry: IO = the 16-bit code.
// Exit: AC = the code if it can be printed, 0 if not (ZSCII 0 prints
// nothing either way). IO is preserved. Called via jsp, same bank; no
// `lem` after it.
zpuPrintable,
    local rtn, code
    dap rtn
    lai
    dac code
    sub [0d32]
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp zpuNo                    // below 32: a control code
    lac code
    sub [0d127]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zpuNo                    // 127 or above
    lac code
    jmp rtn
zpuNo,
    cla
    jmp rtn
rtn, jmp 0
code, 0
    endlocal

// EXT:11 print_unicode: print one Unicode code point. A code that cannot be
// printed becomes `?` (ZSCII 63), the Standard's answer, rather than being
// dropped as print_char's is.
zdhPrintUnicode,
    lac zdOp0
    and [ZW_MASK]
    lia
    jsp zpuPrintable
    SKIP_NEXT_IF_AC_ZERO
    jmp zpuSend                  // printable: AC is the code
    lac [0d63]
zpuSend,
    lia
    farjsp(zPrintChar:*)
    jmp zipNext

// EXT:12 check_unicode: stores 3 (bit 0 printable, bit 1 receivable) for a
// code in the set, 0 otherwise. Both bits are the same fact here: the
// channel carries raw bytes both ways.
zdhCheckUnicode,
    lac zdOp0
    and [ZW_MASK]
    lia
    jsp zpuPrintable
    SKIP_NEXT_IF_AC_ZERO
    lac [3]                      // skipped when not printable: AC stays 0
    lia
    jsp zdpStore
    jmp zipNext

// VAR:230 print_num: print a signed 16-bit value in decimal.
zdhPrintNum,
    lio zdOp0
    farjsp(zpDecimal:*)
    jmp zipNext

// 0OP:185 pop: discard the top of the stack. V1-4 only (zdpE0op9).
zdhPop,
    jsp zStackPop
    lem
    jmp zipNext

// Draw the V3 status line; reached only in a V3 session. The work is
// zstatus.ac's zpStatus. This stub stays in bank 0 because sread calls it
// through a patched one-word jsp (zisStatus, zpatch.ac): S15 has V1-3
// `read` redisplay the status line.
// AC and IO are clobbered. Called via jsp, from bank 0; returns with the
// window open, as the cross-bank call leaves it.
zPrintStatus,
    local rtn
    dap rtn
    farjsp(zpStatus:*)
rtn, jmp 0
    endlocal

// 0OP:188 show_status.
zdhShowStatus,
    jsp zPrintStatus
    jmp zipNext

// VAR:243 output_stream: operand 0 is a signed stream number, positive
// selects, negative deselects, zero does nothing (S7.1.2.2). Operand 1,
// when present, is stream 3's table address.
// The sign is taken from bit 15 and the magnitude as 65536 - value, so no
// intermediate goes negative.
zdhOutputStream,
    lac zdOp0
    and [ZW_MASK]
    dac zpTmp
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zipNext                  // stream 0
    lac zpTmp
    and [0100000]
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zdosSelect               // positive

    // deselect
    lac [0200000]
    sub zpTmp
    dac zpTmp
    lac zpTmp
    SKIP_NEXT_IF_SAME [2]
    jmp zdosDesel                // not the transcript
    jsp zpFlags2Off
zdosDesel,
    lac zpTmp
    lia
    farjsp(zOutDeselect:*)       // flushes a partial transcript line
    jmp zipNext

// Flags2 bit 0 written by the story (S7.4). zarith.ac's storew and storeb
// end here by `jmp`, in place of zipNext. V3 stories ask for a transcript
// this way: `script` is `loadw #0 #8; or sp #1; storew #0 #8 sp`.
// zaTmp holds the byte address just written, masked and checked by
// zaCheckDyn. Only a store at 0..0x11 can reach Flags2's low byte, so a
// store at 0x12 and up costs four instructions. The bit is compared with
// zosTrans, which is exact because zosTrans is only ever 0 or 1 (zOutSelect
// and zOutDeselect are its only writers). A bit set with stream 2 off takes
// output_stream 2's select path (zpFlags2On rewrites the bit harmlessly;
// zdosSel3 hands zOutSelect the store's zdOp1, which stream 2 ignores). A
// bit cleared with stream 2 on jumps to zdosDesel, past zpFlags2Off.
// Not watched: copy_table and tokenise writing into the header, and restore
// and restart, which keep bits 0 and 1 themselves (zsave.ac, S6.1.3).
zpWatch,
    lac zaTmp
    sub [0d18]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zipNext                  // 0x12 or above: not the flags
    lac [0d17]                   // header byte 0x11, Flags2's low byte
    lia
    jsp zFetchByte
    lem
    and [1]
    dac zpTmp
    farlac(zosTrans:*)
    SKIP_NEXT_IF_DIFFERENT zpTmp
    jmp zipNext                  // bit and stream agree
    lio [2]
    dio zpTmp                    // stream 2 for the paths below; AC kept
    SKIP_NEXT_IF_AC_ZERO
    jmp zdosDesel                // stream was on and the bit is clear

    // select
zdosSelect,
    lac zpTmp
    SKIP_NEXT_IF_SAME [2]
    jmp zdosSel3                 // not the transcript
    // the printer is opened here in bank 0: `lpf` reads its name through IO
    lio [zpTransName]
    lpf
    lio [1]
    lpm                          // ASCII mode; resets the device state
    jsp zpFlags2On
zdosSel3,
    // Stream 3's table address is passed only when a second operand is
    // present. Without one (spec-illegal) a stale operand word would let
    // zOutSelect write its count word to a wild address, so pass 0.
    cli
    lac zdOpCount
    SKIP_NEXT_IF_DIFFERENT [1]
    jmp zdosNoTab                // one operand: no table
    lio zdOp1
zdosNoTab,
    lac zpTmp
    farjda(zOutSelect:*)
    jmp zipNext

// VAR:244 input_stream: stream 0 is the keyboard, stream 1 a command file
// (S10.2). There is no file input here, so the request is recorded in
// zisRequested and nothing changes.
zdhInputStream,
    lac zdOp0
    and [ZW_MASK]
    dac zisRequested
    jmp zipNext

zisRequested, 0

// The transcript's one fixed path: two interpreters running at once would
// write over each other.
zpTransName,
    ascii "/tmp/ztranscript.txt"

