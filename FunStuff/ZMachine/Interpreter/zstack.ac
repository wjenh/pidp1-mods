// zstack.ac -- the Z-machine evaluation stack, call frames and variable
// access (S4.2.2, S5, S6).
// #include-only fragment, assembled into zmemcore.am1's bank 0. The
// zStack table itself lives in bank DYNMEM_STACK_BANK (13).
//
// Depends on zmemcore.am1 (zStack, DYNMEM_STACK_BANK, Z_STACK_WORDS,
// zFetchByte, zFetchWord, zStoreWord), zboot.ac's zhGlobalsAddr,
// skipmacros.ah and memory.ah.
//
// Entry points: zStackInit, zStackPush, zStackPop, zCallFrame, zCallReturn,
// zFrameArgCount, zUnwindTo, zReadVar, zWriteVar. Each captures the full
// return address and returns with the window open (farrtn or
// crossBankrtn). The internal helpers zsGet, zsPut, zsTopIndex and
// zsFrameSync are bank-0 only (`dap rtn`/`jmp rtn`) and return with the
// window closed; zsFrameSync is also called by zdispatch.ac.
//
// The frame layout. One `zStack` array holds the evaluation stack and the
// call frames, addressed by zSP (the next free slot) and zFP (the base
// index of the current routine's frame):
//   zStack[zFP+0]              return PC (Z-machine byte address)
//   zStack[zFP+1]              caller's zFP
//   zStack[zFP+2]              result variable number, or ZRV_DISCARD
//   zStack[zFP+3]              local count N (0-15, S5.2); in a V5 session,
//                              two fields -- see below
//   zStack[zFP+4 .. zFP+3+N]   the N locals
//   zStack[zFP+4+N .. zSP-1]   this routine's own evaluation stack
// In a V5 session the count word is argc << 4 | N, where argc is how many
// arguments the call supplied (0-7); V5's check_arg_count (S15) needs it.
// V1-4 sessions store N alone (zCallFrame's patched zcfArgcShift).
// zsFrameSync and zCallReturn mask the word with `and [017]`, and
// zFrameArgCount shifts it with `sar 4s`. Any other reader of zFP+3 must
// mask.
// The result-variable field carries a call's store byte (S4.6) from the
// call to the return. ZRV_DISCARD marks a frame whose result is thrown
// away (V5's call_vn family, and the initial pseudo-frame).
// zFP is the value zSP had before the frame's header went on, so a
// return's `zSP := zFP` discards the header, the locals and any stray
// evaluation-stack values in one step (S6.3.2). The return PC is one
// word: every Z-machine byte address fits in 18 bits.
//
// The frame cache. Three bank-0 words describe the current frame, so a
// local access or a pop does not go to bank 13 to learn its shape:
//   zsNLoc     N, the count word masked with 017
//   zsLocPtr   the 16-bit pointer to zStack[zFP+3]: local v is at +v
//   zsEvBase   zFP+4+N, the first evaluation-stack slot
// Every change to zFP or to the frame's count word must be followed by a
// refresh. A missed site fails silently: a stale cache reads another
// frame's local. The sites, all in bank 0:
//   zStackInit, zUnwindTo                   jsp zsFrameSync
//   zCallFrame                              sets the three words itself
//   zCallReturn                             refills them inline, with
//                                             zsFrameSync's computation
//   zdispatch.ac's zdhRestore (the tape
//     restore, on success), zdhRestoreUndo
//     and testRestoreFromSlot               jsp zsFrameSync
// The restores write zFP in bank 14 (zsave.ac); their bank-0 callers do
// the refresh. A test that pokes zFP or a count word directly must
// `start testFrameSync` before anything reads a local or pops.
//
// The initial state. zStackInit lays down a pseudo-frame at index 0
// (return PC 0, saved FP ZFP_NONE, result variable ZRV_DISCARD, local
// count 0) and sets zFP = 0, zSP = 4: S5.5's initial environment in the
// layout of every real frame. A local access there finds local count 0
// and takes the missing-local path, and a return from it finds ZFP_NONE
// and halts.

#ifndef ZSTACK_AC_H
#define ZSTACK_AC_H

#include <memory.ah>
#include <AIDS/skipmacros.ah>

// The "no enclosing frame" marker in the initial pseudo-frame's saved-FP
// field. No real frame base can equal it: a frame's header alone is 3
// words, so the largest possible base is Z_STACK_WORDS-3.
#define ZFP_NONE Z_STACK_WORDS

// The "throw this routine's result away" marker in a frame's
// result-variable field: one past the largest variable number (S4.2.2
// numbers them 0-255).
#define ZRV_DISCARD 0400

// Stop reasons for this file's halts. Under boot each halt ends the
// session with an error report (zmemcore.am1's zSessionFail) instead of
// stopping the machine; under a test entry zdpStopReason is left
// unchanged. They belong to zdispatch.ac's ZSTOP_* list but are defined
// here because this file is assembled first. ZSTOP_BADVAR is not produced
// (a missing local degrades); it keeps its number and zErrReport its text.
#define ZSTOP_STACK  0d12      // the Z stack: empty, full, or no frame to return to
#define ZSTOP_BADVAR 0d13      // a local variable the routine does not have

// Addressing zStack. A word's 16-bit (bank:offset) pointer is its index
// plus the assembler-computed `zStack:DYNMEM_STACK_BANK`, dereferenced
// with `eem`, `lac i` or `dio i`, then `lem`. The bank number is a
// compile-time constant, so nothing shifts at run time and nothing
// hardcodes zStack's offset. There is no bounds check anywhere: every
// caller validates the index first (against zSP, the frame's local count,
// or Z_STACK_WORDS).

// Reads a zStack word. Internal.
// Entry: IO = the zStack index.
// Exit:  AC = zStack[index].
// AC is the result, IO is preserved. Called via jsp; returns with the
// window closed.
zsGet,
    local rtn, ptr
    dap rtn
    lai
    add [zStack:DYNMEM_STACK_BANK] // its 16-bit pointer
    dac ptr
    eem                            // the pointer names bank 13
    lac i ptr
    lem                            // bank-0 code runs with eem off
    jmp rtn
rtn, jmp 0
ptr, 0
    endlocal

// Writes a zStack word. Internal.
// Entry: AC = the zStack index, IO = the value.
// No result. AC is clobbered, IO is preserved. Called via jda; returns
// with the window closed.
zsPut, 0
    local rtn, ptr
    dap rtn
    lac zsPut                      // the deposited index
    add [zStack:DYNMEM_STACK_BANK] // its 16-bit pointer
    dac ptr
    eem                            // the pointer names bank 13
    dio i ptr                      // IO is still the value
    lem                            // bank-0 code runs with eem off
    jmp rtn
rtn, jmp 0
ptr, 0
    endlocal

// Refills the frame cache (zsNLoc, zsLocPtr, zsEvBase; see the file
// header) from zFP and the current frame's count word. Internal.
// N is the count word masked with 017, which also keeps local numbers
// above N on the missing-local path when a call supplied more arguments
// than the routine has locals. zSP equal to zsEvBase means the routine
// has pushed nothing (S6.3.1); zSP below it means the frame chain is
// corrupt.
// No arguments, no result. AC is clobbered, IO is preserved, which
// zdispatch.ac's zdhRestoreUndo relies on. Called via jsp; returns with
// the window closed.
zsFrameSync,
    local rtn
    dap rtn
    lac zFP
    add [zStack:DYNMEM_STACK_BANK] // the pointer to zStack[zFP]...
    add [3]
    dac zsLocPtr                   // ...+3, the count word; local v is at +v
    eem                            // it names bank 13
    lac i zsLocPtr
    lem                            // bank-0 code runs with eem off
    and [017]                      // N only: argc << 4 rides above it in V5
    dac zsNLoc
    add zFP
    add [4]
    dac zsEvBase                   // zFP+4+N
    jmp rtn
rtn, jmp 0
    endlocal

// Locates the current routine's top-of-stack value. Internal.
// Exit:  AC = the zStack index of the top value, zSP-1.
// AC is the result, IO is preserved. Called via jsp; returns with the
// window as it found it.
// Halts if the routine has pushed nothing (S6.3.1), or if zSP is below
// zsEvBase (a corrupt frame chain). The equality test comes first because
// the empty case, zSP == zsEvBase, needs its own branch.
zsTopIndex,
    local rtn
    dap rtn
    lac zSP
    SKIP_NEXT_IF_DIFFERENT zsEvBase
    jmp ztiFail                         // nothing pushed

    sub zsEvBase                   // AC still holds zSP
    SKIP_NEXT_IF_AC_NOT_NEGATIVE
    jmp ztiFail                       // zSP below the base: the frame is corrupt

    lac zSP
    sub [1]
    jmp rtn

// Under boot, the session ends with an error report. Every halt in this
// file has this shape: the jumps come to a *Fail label, which halts only
// under a test entry.
ztiFail,
    lac zServing
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp ztiEmpty                      // a test entry: halt
    lac [ZSTOP_STACK]
    jmp zSessionFail
ztiEmpty,
    hlt
rtn, jmp 0
    endlocal

// Resets the Z-machine stack to its start-of-game state: the initial
// pseudo-frame (see the file header), zFP = 0, zSP = 4. Also clears
// zVarIndirect, so a stale one-shot modifier cannot survive a restart.
// No arguments, no result. AC and IO are clobbered. Called via jsp;
// returns with the window open.
zStackInit,
    local rtn
    dac rtn

    cla
    dac zFP                        // the pseudo-frame's base is index 0
    dac zVarIndirect

    cli
    cla
    jda zsPut                      // zStack[0] = 0, the return PC, never used

    lio [ZFP_NONE]
    lac [1]
    jda zsPut                      // zStack[1] = ZFP_NONE, no enclosing frame

    lio [ZRV_DISCARD]
    lac [2]
    jda zsPut                      // zStack[2] = ZRV_DISCARD: S5.5 makes a
                                   //   return from here illegal, but the
                                   //   field must hold something defined

    cli
    lac [3]
    jda zsPut                      // zStack[3] = 0, no locals (S5.5); in a
                                   //   V5 session also argc 0

    lac [4]
    dac zSP                        // the evaluation stack starts past the header
    jsp zsFrameSync                // the frame cache, for frame 0
    farrtn(rtn)
rtn, 0
    endlocal

// Pushes a value onto the Z-machine stack.
// Entry: IO = the value (a 16-bit Z-machine word).
// No result. AC is clobbered, IO is preserved. Called via jsp; returns
// with the window open.
// Halts on overflow (zSP already at Z_STACK_WORDS). An equality test is
// enough: zSP advances one word at a time here, and zCallFrame, which
// advances it by a whole frame, does its own >= check first.
zStackPush,
    local rtn, ptr
    dac rtn
    lac zSP
    SKIP_NEXT_IF_DIFFERENT [Z_STACK_WORDS]
    jmp zpuFail                                // the stack is full

    add [zStack:DYNMEM_STACK_BANK] // AC still holds zSP: the slot's pointer
    dac ptr
    idx zSP                        // the slot is taken
    eem                            // the pointer names bank 13
    dio i ptr                      // IO is still the value
    crossBankrtn(rtn, NOEEM)       // the `eem` just above opened the window

zpuFail,                           // see ztiFail
    lac zServing
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zpuOverflow                   // a test entry: halt
    lac [ZSTOP_STACK]
    jmp zSessionFail
zpuOverflow,
    hlt
rtn, 0
ptr, 0
    endlocal

// Pops a value from the Z-machine stack. Underflow (S6.3.1) halts inside
// zsTopIndex.
// Exit:  AC = the popped value.
// AC is the result, IO is preserved. Called via jsp; returns with the
// window open.
zStackPop,
    local rtn, ptr
    dac rtn
    jsp zsTopIndex                 // AC = zSP-1, or a halt if nothing is pushed
    dac zSP                        // the popped slot becomes the new top
    add [zStack:DYNMEM_STACK_BANK] // the slot's pointer
    dac ptr
    eem                            // the pointer names bank 13
    lac i ptr
    crossBankrtn(rtn, NOEEM)       // the `eem` just above opened the window
rtn, 0
ptr, 0
    endlocal

// Pushes a new call frame for a routine (S5, S6.4).
// Entry: AC = the routine's unpacked byte address, IO = the argument count
//        (0-7; V3 itself caps at 3, S6.4.1), and these words:
//          zCallFrameRetPC    the byte address to resume the caller at
//          zCallFrameResVar   the variable the return value is to be
//                             stored into (S4.6), or ZRV_DISCARD; recorded
//                             in the frame, handed back by zCallReturn
//          zdOp1..zdOp7       the arguments, read in place from the
//                             decoder's operand block (zdecode.ac); these
//                             words must stay consecutive
// Exit:  AC = the byte address of the routine's first instruction (S5.3).
// AC is the result, IO is clobbered. Called via jda; returns with the
// window open (farrtn), and its callers close it.
//
// The routine header is read (S5.2, S5.2.1) and the count and the room
// checked before anything is written. The frame is then written through
// one pointer: the four header words, locals 1..k from the arguments,
// where k = min(argc, N) (S6.4.4), then locals k+1..N from their initial
// values. Spare arguments are thrown away (S6.4.4.1).
//
// The header has two forms, chosen by three words boot patches for the
// story's version (zpatch.ac): zcfArgcShift, zcfInitForm and zcfFirstN.
//   V1-4  a local-count byte, then that many 2-byte initial values; the
//         first instruction is at addr + 1 + 2N. Local k+1's initial value
//         is at addr + 1 + 2k.
//   V5    a local-count byte and nothing else: every local starts at
//         zero, and the first instruction is at addr + 1 (S5.2.1, S5.3).
//         zcfInitForm is patched to a jump to the zero-fill loop.
// In a V5 session the count word also records argc, the number of
// arguments the call supplied (S15), even when some are thrown away.
//
// The window: zFetchByte and zFetchWord return with it open, and the frame
// is written with it open. The argument reads `lac i argPtr` use a bare
// bank-0 address, which under the window resolves to bank 0, where
// zdOp1.. are. Each V1-4 initial-value fetch is made with the window
// closed.
//
// Halts (see ztiFail) on a local count above 15 (S5.2) and on stack
// overflow. Both tests run before the frame is written, so a refused call
// changes nothing in zStack.
zCallFrame, 0
    local rtn, addrSave, argc, nLocals, newSP, nArgs, hdrAddr, ptr, argPtr, cnt
    dac rtn
    lac zCallFrame                 // the deposited routine address
    dac addrSave
    dio argc

    // The routine header's local-count byte (S5.2).
    lio addrSave
    jsp zFetchByte                 // returns with the window open
    dac nLocals

    SKIP_NEXT_IF_DIFFERENT [0d15]
    jmp zcfCountOk                    // exactly 15, the legal maximum
    sub [0d15]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zcfFail                       // above 15: spec-illegal

zcfCountOk,
    // Is there room for the whole frame, the header and N locals?
    lac zSP
    add [4]
    add nLocals
    dac newSP                      // where zSP ends up if this call proceeds
    SKIP_NEXT_IF_DIFFERENT [Z_STACK_WORDS]
    jmp zcfRoomOk                              // it fills the stack exactly: legal
    sub [Z_STACK_WORDS]
    SKIP_NEXT_IF_AC_NEGATIVE
    jmp zcfFail                       // past the end of zStack

zcfRoomOk,
    // The header, at zStack[zSP], the new frame's base.
    lac zSP
    add [zStack:DYNMEM_STACK_BANK] // the pointer to zStack[newFP]
    dac ptr
    eem                            // it names bank 13 (the window is open
                                   //   already off zFetchByte, but two
                                   //   labels stand between)
    lac zCallFrameRetPC
    dac i ptr                      // zStack[newFP+0] = the return PC
    idx ptr
    lac zFP
    dac i ptr                      // zStack[newFP+1] = the caller's frame base
    idx ptr
    lac zCallFrameResVar
    dac i ptr                      // zStack[newFP+2] = the result variable,
                                   //   or ZRV_DISCARD
    idx ptr                        // AC = the pointer to zStack[newFP+3]:
    dac zsLocPtr                   //   the frame cache's local pointer. Nothing
                                   //   reads the cache before zFP changes below.
    lac argc                       // V5: argc << 4 | N
zcfArgcShift,
    cla                            // patched: V5 `sal 4s`. V1-4 keep `cla`,
    ior nLocals                    //   so the word is N alone
    dac i ptr                      // zStack[newFP+3] = the local count (and,
    idx ptr                        //   in V5, the supplied-argument count)

    // k = min(argc, N), the locals the arguments fill (S6.4.4).
    lac argc
    sub nLocals                    // argc - N
    SKIP_NEXT_IF_AC_NEGATIVE       // skip the cla if argc < N
    cla                               // argc >= N: k is N, added to 0
    add nLocals                    // argc < N: (argc - N) + N = argc. Never
    dac nArgs                      //   -0: x + -x leaves plus zero, so argc 0
                                   //   gives +0
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zcfLocals                     // no argument lands in a local

    // Locals 1..k: the arguments, zdOp1.. in order.
    cma
    dac cnt                        // -k, for isp: k trips
    lac [zdOp1]
    dac argPtr                     // a bare bank-0 address: under the window
                                   //   it resolves to bank 0
zcfArgLoop,
    lac i argPtr                   // argument j
    dac i ptr                      //   into local j
    idx ptr
    idx argPtr
    isp cnt
    jmp zcfArgLoop

zcfLocals,
    // Locals k+1..N: their initial values (V1-4), or zero (V5).
    lac nLocals
    sub nArgs                      // N - k, never negative
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zcfLocalsDone                 // every local has its argument
    cma
    dac cnt                        // -(N - k), for isp
    lac nArgs
zcfInitForm,
    sal 1s                         // patched: V5 `jmp zcfZeroFill`. V1-4: 2k
    add addrSave
    add [1]
    dac hdrAddr                    // local k+1's initial value: addr + 1 + 2k
zcfInitLoop,
    lem                            // the fetch runs with the window closed
    lio hdrAddr
    jsp zFetchWord                 // AC = the initial value; the window open again
    dac i ptr
    idx ptr
    idx hdrAddr
    idx hdrAddr                    // the next 2-byte initial value
    isp cnt
    jmp zcfInitLoop
    jmp zcfLocalsDone              // every local written
zcfZeroFill,                       // V5 only: every local starts at zero
    cli                            //   (S5.2.1). The window is open, from
zcfZeroLoop,                       //   the header writes above
    dio i ptr
    idx ptr
    isp cnt
    jmp zcfZeroLoop

zcfLocalsDone,
    // The new frame is the current one: the old top of stack is its base.
    // The rest of the frame cache is set here rather than by zsFrameSync:
    // nLocals is the count byte, 0-15, so it needs no mask, and the new
    // routine's evaluation stack starts where zSP now does. zsLocPtr was
    // set above.
    lac zSP
    dac zFP
    lac nLocals
    dac zsNLoc
    lac newSP
    dac zSP
    dac zsEvBase

    // The first instruction (S5.3). V1-4: past the count byte and the N
    // 2-byte initial values. V5: just past the count byte, since the
    // patched `cla` makes the 2N term 0.
    lac nLocals
zcfFirstN,
    sal 1s                         // patched: V5 `cla`
    add addrSave
    add [1]
    farrtn(rtn)

zcfFail,                           // see ztiFail
    lac zServing
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zcfOverflow                   // a test entry: halt
    lac [ZSTOP_STACK]
    jmp zSessionFail
zcfBadCount,
zcfOverflow,
    hlt

rtn, 0
addrSave, 0
argc, 0
nLocals, 0
newSP, 0
nArgs, 0
hdrAddr, 0
ptr, 0
argPtr, 0
cnt, 0
    endlocal

// Returns from the current routine (S6.4.5), restoring zSP and zFP (see
// the file header) and refilling the frame cache for the caller's frame.
// Entry: IO = the return value.
// Exit:  AC = the caller's resume PC (the return PC this frame recorded),
//        IO = the return value, passed straight back, and
//        zCallReturnResVar = the variable the call's store byte named, or
//        ZRV_DISCARD.
// AC and IO are both results. Called via jsp; returns with the window
// open (crossBankrtn NOEEM), and zdpReturn, the one caller, closes it.
// The caller applies the store after this routine has restored the
// caller's frame, so a store to $00 or a local lands in the caller's
// frame. Halts (see ztiFail) on a return from the initial environment
// (saved FP == ZFP_NONE, S5.5), with nothing changed.
zCallReturn,
    local rtn, valSave, retPC, savedFP, ptr
    dac rtn
    dio valSave

    lac zFP
    add [zStack:DYNMEM_STACK_BANK] // the pointer to zStack[zFP]
    dac ptr
    eem                            // it names bank 13
    lac i ptr
    dac retPC                      // zStack[zFP+0]
    idx ptr
    lac i ptr                      // zStack[zFP+1], the caller's frame base;
    SKIP_NEXT_IF_DIFFERENT [ZFP_NONE]  //   nothing may go between the two
    jmp zcrFail                           // a return from the initial
                                          //   environment (S5.5)
    dac savedFP
    idx ptr
    lac i ptr
    dac zCallReturnResVar          // zStack[zFP+2], where the caller wanted
                                   //   the result put (S4.6), read while zFP
                                   //   still names the returning frame

    lac zFP
    dac zSP                        // discards the header, locals and stray
    lac savedFP                    //   values (S6.3.2)
    dac zFP

    // The caller's frame, cached: zsFrameSync's computation, inline, before
    // the dispatch loop's store, which may be to one of its locals.
    add [zStack:DYNMEM_STACK_BANK] // AC still holds the new zFP
    add [3]
    dac zsLocPtr                   // the pointer to zStack[zFP+3]
    lac i zsLocPtr                 // the count word: the window is still open
    and [017]                      // N only: argc << 4 rides above it in V5
    dac zsNLoc
    add zFP
    add [4]
    dac zsEvBase                   // zFP+4+N

    lio valSave                    // IO = the return value
    lac retPC                      // AC = the caller's resume PC
    crossBankrtn(rtn, NOEEM)       // the `eem` above opened the window

zcrFail,                           // see ztiFail
    lem                            // reached with the window open: close it
    lac zServing
    SKIP_NEXT_IF_AC_NOT_ZERO
    jmp zcrNoFrame                    // a test entry: halt
    lac [ZSTOP_STACK]
    jmp zSessionFail
zcrNoFrame,
    hlt
rtn, 0
valSave, 0
retPC, 0
savedFP, 0
ptr, 0
    endlocal

// The number of arguments the current routine's call supplied, for V5's
// check_arg_count (S15).
// Exit:  AC = the count, 0-7: the high field of the frame's count word,
//        argc << 4 | N. The word is at most 0177, so `sar 4s` alone
//        extracts it. The initial pseudo-frame's word is 0, so 0 there.
// AC is the result, IO is clobbered. Called via jsp; returns with the
// window open (farrtn), and the caller closes it.
zFrameArgCount,
    local rtn
    dac rtn
    lac zFP
    add [3]
    lia
    jsp zsGet                      // AC = argc << 4 | N
    sar 4s                         // AC = argc
    farrtn(rtn)
rtn, 0
    endlocal

// Unwinds to a frame, for V5's throw.
// Entry: IO = a frame value as catch stores it (zdispatch.ac's zdhCatch
//        stores zFP, the zStack index of the frame's base).
// Exit:  AC = 1 if that value is the base of a frame on the live chain,
//        with zFP set to it: the caller then does an ordinary return, and
//        zCallReturn's `zSP := zFP` discards every frame above it
//        (S6.3.2). Otherwise AC = 0, and nothing is changed.
// AC is the result, IO is clobbered. Called via jsp; returns with the
// window open (farrtn), and the caller closes it.
// The walk starts at zFP and follows each frame's saved-FP word
// (zStack[fp+1]). It tests for ZFP_NONE before a match, so a frame value
// equal to ZFP_NONE (0d1024, a legal 16-bit operand) cannot match the end
// of the chain. Saved FPs strictly decrease, so the walk ends. Frame 0,
// the pseudo-frame, is on the chain; a throw to it halts in zCallReturn's
// S5.5 guard.
zUnwindTo,
    local rtn, want
    dac rtn
    dio want
    lac zFP
zutWalk,
    SKIP_NEXT_IF_DIFFERENT [ZFP_NONE]
    jmp zutNone                           // off the end of the chain
    SKIP_NEXT_IF_DIFFERENT want
    jmp zutFound                          // this frame is the one
    add [1]                            // AC still holds the frame's base:
    lia                                //   IO = base + 1
    jsp zsGet                          // AC = this frame's caller's base
    jmp zutWalk

zutFound,
    dac zFP                            // AC is the frame's base
    jsp zsFrameSync                    // the caller's zCallReturn syncs again;
                                       //   this keeps the routine safe on its own
    lac [1]
    farrtn(rtn)

zutNone,
    cla                                // zFP untouched
    farrtn(rtn)
rtn, 0
want, 0
    endlocal

// ZREADVAR(slow, fail) -- the variable read, as a macro: the one copy of
// zReadVar's rules. zReadVar is an expansion of it, and so are zdecode.ac's
// four operand sites, where the call cost more than the read.
// Entry: AC = the variable number, 0-255. The window must be open: every
//        arm ends in `lac i` through a 16-bit pointer into the stack bank
//        or dynamic memory.
// Exit:  falls out with AC = the value and the window still open, for the
//        stack, a local the frame has, and a global when zsGlobPtr is
//        formed. The other two cases jump out for the expansion site to
//        finish, with zrvNum holding the number: `slow`, a global when
//        zsGlobPtr is 0 (an odd globals address), and `fail`, a local the
//        frame lacks.
// AC is the result, IO is preserved. zVarIndirect is cleared on every
// path, the two jumps included. A pop moves zSP; a halt inside zsTopIndex
// is an empty stack, as for zReadVar.
// zrvNum and zrvPtr are scratch shared by every expansion. Nothing the
// macro calls reads a variable, so two expansions are never live at once.
// The labels are local to each expansion, because cpp generates no unique
// labels (see ZDFETCH1 in zdecode.ac).
//
// Subtracting 16 leaves AC negative for a local and not for a global. The
// local bound is N - v >= 0, where both come from masks and are 0-15, so
// the subtraction cannot produce minus zero.
//
// zsGlobPtr is the 16-bit pointer to global 16's word less 16, so adding
// the variable number lands on the global's word. That word is the
// Z-machine word only at an even globals address, which is why boot leaves
// zsGlobPtr 0 at an odd one.
#define ZREADVAR(slow, fail)                    \
    local rvGlob, rvPeek, rvStack, rvTop, rvDeref; \
    dac zrvNum;                                 \
    SKIP_NEXT_IF_AC_NOT_ZERO;                   \
    jmp rvStack;                                \
    sub [0d16];                                 \
    SKIP_NEXT_IF_AC_NEGATIVE;                   \
    jmp rvGlob;                                 \
    dzm zVarIndirect;                           \
    lac zsNLoc;                                 \
    sub zrvNum;                                 \
    SKIP_NEXT_IF_AC_NOT_NEGATIVE;               \
    jmp fail;                                   \
    lac zrvNum;                                 \
    add zsLocPtr;                               \
    jmp rvDeref;                                \
rvGlob,                                         \
    dzm zVarIndirect;                           \
    lac zsGlobPtr;                              \
    SKIP_NEXT_IF_AC_NOT_ZERO;                   \
    jmp slow;                                   \
    add zrvNum;                                 \
    jmp rvDeref;                                \
rvPeek,                                         \
    jsp zsTopIndex;                             \
    jmp rvTop;                                  \
rvStack,                                        \
    lac zVarIndirect;                           \
    dzm zVarIndirect;                           \
    SKIP_NEXT_IF_AC_ZERO;                       \
    jmp rvPeek;                                 \
    jsp zsTopIndex;                             \
    dac zSP;                                    \
rvTop,                                          \
    add [zStack:DYNMEM_STACK_BANK];             \
rvDeref,                                        \
    dac zrvPtr;                                 \
    lac i zrvPtr;                               \
    endlocal

// Reads a Z-machine variable.
// Entry: IO = the variable number (0-255, S4.2.2).
// Exit:  AC = the variable's value:
//   $00        the stack: popped (S6.3), or peeked in place when
//              zVarIndirect is set
//   $01-$0f    the current frame's locals, found through the frame cache.
//              A number beyond the frame's local count reads 0: S4.2.2
//              calls it illegal but asks for no halt, and the number may
//              be one the story computed (the indirect opcodes). A harness
//              build counts it in zsDgBadLocalRead.
//   $10-$ff    the global table, zhGlobalsAddr + 2*(n-16) (S6.2): read in
//              place through zsGlobPtr when boot formed it, else through
//              zFetchWord
// AC is the result. IO is preserved, except through zFetchWord on an odd
// globals address, which clobbers it. Called via jsp; returns with the
// window open.
//
// zVarIndirect is the one-shot modifier for S6.3.4's seven
// indirect-reference opcodes (inc, dec, inc_chk, dec_chk, load, store,
// pull), where a reference to the stack reads or writes the top item in
// place instead of popping or pushing it. The caller (zarith.ac) sets it
// nonzero just before the call; zReadVar and zWriteVar clear it on every
// path, so a forgotten reset cannot leak into the next operand. Only the
// stack arm reads it.
// The body is ZREADVAR, above; the two cases it hands back finish here.
zReadVar,
    local rtn
    dac rtn
    lai
    eem                            // ZREADVAR's entry condition
    ZREADVAR(zrvGlobSlow, zrvFail)
    crossBankrtn(rtn, NOEEM)       // the macro leaves the window open

zrvGlobSlow,
    lac zrvNum
    sal 1s
    sub [0d32]                     // 2*varNum - 32 == 2*(varNum - 16)
    add zhGlobalsAddr
    lia
    jsp zFetchWord
    crossBankrtn(rtn, NOEEM)

zrvFail,                           // no such local: it reads 0
#if Z_TEST_HARNESS
    idx zsDgBadLocalRead               // the degrade ran
#endif
    cla
    farrtn(rtn)
rtn, 0
    endlocal

// ZWRITEVAR(fail) -- the variable write, as a macro: the one copy of
// zWriteVar's rules. zWriteVar is an expansion of it, and so is
// zdispatch.ac's zdpStore, which every storing instruction ends in.
// Entry: AC = the variable number, 0-255, IO = the value. The window must
//        be open: the stack and local arms end in `dio i` through a 16-bit
//        pointer into the stack bank.
// Exit:  falls out with the value written and the window still open, for
//        the stack, a local the frame has, and a global. A local the frame
//        lacks jumps to `fail` with nothing written, zwvNum holding the
//        number and IO still the value.
// AC is clobbered. IO is preserved, except on the global arm, where
// zStoreWord clobbers it. zVarIndirect is cleared on every path, the jump
// included. A push onto a full stack ends at zStackPush's zpuFail, and a
// write in place on an empty one inside zsTopIndex.
// A global is written through zStoreWord, never through zsGlobPtr:
// zStoreWord carries the undo hook.
// zwvNum and zwvPtr are scratch shared by every expansion. Nothing the
// macro calls writes a variable, so two expansions are never live at once.
// The local bound is ZREADVAR's, N - v >= 0.
//
// The push arm is last and falls out, so the commonest store takes no
// jump after the dispatch. It forms the slot's pointer before the `idx`,
// which is why it keeps its own `dac`/`dio i` rather than sharing one.
#define ZWRITEVAR(fail)                         \
    local wvGlob, wvPoke, wvStack, wvDone;      \
    dac zwvNum;                                 \
    SKIP_NEXT_IF_AC_NOT_ZERO;                   \
    jmp wvStack;                                \
    sub [0d16];                                 \
    SKIP_NEXT_IF_AC_NEGATIVE;                   \
    jmp wvGlob;                                 \
    dzm zVarIndirect;                           \
    lac zsNLoc;                                 \
    sub zwvNum;                                 \
    SKIP_NEXT_IF_AC_NOT_NEGATIVE;               \
    jmp fail;                                   \
    lac zwvNum;                                 \
    add zsLocPtr;                               \
    dac zwvPtr;                                 \
    dio i zwvPtr;                               \
    jmp wvDone;                                 \
wvGlob,                                         \
    dzm zVarIndirect;                           \
    lac zwvNum;                                 \
    sal 1s;                                     \
    sub [0d32];                                 \
    add zhGlobalsAddr;                          \
    jda zStoreWord;                             \
    jmp wvDone;                                 \
wvPoke,                                         \
    jsp zsTopIndex;                             \
    add [zStack:DYNMEM_STACK_BANK];             \
    dac zwvPtr;                                 \
    dio i zwvPtr;                               \
    jmp wvDone;                                 \
wvStack,                                        \
    lac zVarIndirect;                           \
    dzm zVarIndirect;                           \
    SKIP_NEXT_IF_AC_ZERO;                       \
    jmp wvPoke;                                 \
    lac zSP;                                    \
    SKIP_NEXT_IF_DIFFERENT [Z_STACK_WORDS];     \
    jmp zpuFail;                                \
    add [zStack:DYNMEM_STACK_BANK];             \
    dac zwvPtr;                                 \
    idx zSP;                                    \
    dio i zwvPtr;                               \
wvDone,                                         \
    endlocal

// Writes a Z-machine variable, with zReadVar's three-way dispatch and
// zVarIndirect modifier. Variable $00 pushes (S6.3), or writes the top
// item in place when zVarIndirect is set. A local the frame does not have
// drops the write, counted in zsDgBadLocalWrite in a harness build.
// Globals are written through zStoreWord, which carries the undo hook.
// Entry: AC = the variable number (0-255), IO = the value.
// No result. AC is clobbered; IO is the value on return, except after a
// global. Called via jda; returns with the window open.
// The body is ZWRITEVAR, above.
zWriteVar, 0
    local rtn
    dac rtn
    lac zWriteVar                  // the deposited variable number
    eem                            // ZWRITEVAR's entry condition
    ZWRITEVAR(zwvFail)
    crossBankrtn(rtn, NOEEM)       // the macro leaves the window open

zwvFail,                           // no such local: nothing written
#if Z_TEST_HARNESS
    idx zsDgBadLocalWrite              // the degrade ran
#endif
    farrtn(rtn)
rtn, 0
    endlocal

// The stack machine's state, in bank 0. zSP is the next free zStack slot,
// zFP the base index of the current frame; both are meaningless until
// zStackInit has run.
zSP, 0
zFP, 0

// The frame cache (see the file header): N, the pointer to zStack[zFP+3],
// and zFP+4+N. Assembled with the initial pseudo-frame's values (N 0,
// frame 0), so an image nothing has run yet agrees with the frame
// zStackInit lays down: a pop there halts as empty rather than reading the
// frame header.
zsNLoc, 0
zsLocPtr, zStack:DYNMEM_STACK_BANK+3
zsEvBase, 4

// zReadVar's pointer for a global: the 16-bit pointer to global 16's
// resident word, less 16, so adding a variable number 16-255 lands on its
// global. zboot.ac's zBootInit forms it from zhGlobalsAddr when that
// address is even, and stores 0 when it is odd, which sends every global
// read through zFetchWord. 0 until boot has run. Writes do not use it:
// zWriteVar uses zStoreWord, which carries the undo hook.
zsGlobPtr, 0

// zCallFrame's resume-PC input (see its header).
zCallFrameRetPC, 0

// zCallFrame's result-variable input: the variable the routine's return
// value is to be stored into, or ZRV_DISCARD. It goes into the frame at
// zFP+2 and comes back out of zCallReturn in zCallReturnResVar.
zCallFrameResVar, 0

// zCallReturn's third result (see its header).
zCallReturnResVar, 0

// zReadVar's and zWriteVar's one-shot S6.3.4 modifier (see zReadVar's
// header), read and cleared by both.
zVarIndirect, 0

// ZREADVAR's scratch: the variable number, which an expansion's `slow` and
// `fail` targets read back, and the 16-bit pointer an arm dereferences.
zrvNum, 0
zrvPtr, 0

// ZWRITEVAR's scratch, the same pair for a write: `fail` reads zwvNum back.
zwvNum, 0
zwvPtr, 0

// Degrade counters: bumped by one `idx` at the site, read by a test with a
// bare `show`, never read by the interpreter, absent from production.
#if Z_TEST_HARNESS
zsDgBadLocalRead, 0            // a read of a local the frame lacks
zsDgBadLocalWrite, 0           // a write to a local the frame lacks
#endif

// Test-driver scaffolding (ad1). Each entry is run with `start` and ends
// in `hlt`. zVarIndirect, zdOp1..zdOp7 (testCallFrame's arguments), zSP,
// zFP and the frame-cache words are plain bank-0 words, set and read
// directly with ad1's `set`/`show`; after poking zFP or a count word, a
// test must `start testFrameSync`.
// Guarded by Z_TEST_HARNESS (default 1, defined in zmemcore.am1); a
// production build assembles with -DZ_TEST_HARNESS=0 and omits all of it.
#if Z_TEST_HARNESS

testStackValueIn, 0
testStackIndexIn, 0
testStackVarIn, 0
testStackAddrIn, 0
testStackArgcIn, 0
testStackRetPCIn, 0
testStackResultOut, 0
testStackResultIoOut, 0

testStackInit,
    jsp zStackInit
    hlt

testStackPush,
    lio testStackValueIn
    jsp zStackPush
    hlt

testStackPop,
    jsp zStackPop
    dac testStackResultOut
    hlt

// A raw zStack read, to inspect a frame's layout directly. No bounds check.
testStackPeek,
    lio testStackIndexIn
    jsp zsGet
    dac testStackResultOut
    hlt

testCallFrame,
    lac testStackRetPCIn
    dac zCallFrameRetPC
    lac testStackAddrIn
    lio testStackArgcIn
    jda zCallFrame
    dac testStackResultOut
    hlt

testCallReturn,
    lio testStackValueIn
    jsp zCallReturn
    dac testStackResultOut
    dio testStackResultIoOut       // both results
    hlt

testReadVar,
    lio testStackVarIn
    jsp zReadVar
    dac testStackResultOut
    hlt

testWriteVar,
    lac testStackVarIn
    lio testStackValueIn
    jda zWriteVar
    hlt

// Refills the frame cache after a test has poked zFP or a count word.
testFrameSync,
    jsp zsFrameSync
    hlt

#endif // Z_TEST_HARNESS

#endif // ZSTACK_AC_H
