  53:               // ---- SBS interrupt handler frame (locations 0-3) -------------------------
  54:               //
  55:               // The break sequence saves: AC at 0, packed-PC+flags at 1, IO at 2,
  56:               // then starts executing from location 3.
  57:               // Return: 'jmp i 1' jumps to the saved PC and asserts DEBREAK.
  59: 000004        0/
  60: 000000 000000 0      // loc 0: SBS saves old AC here during a break
  61: 000001 000000 0      // loc 1: SBS saves packed(ov1, exd, PC) here
  62: 000002 000000 0      // loc 2: SBS saves IO here
  63: 000003 600323 jmp clkInt32ms      // loc 3: dispatch to the 32ms interrupt handler
  65:               // ---- program origin ------------------------------------------------------
  67: 000004        100/
  69: 000100        begin,
  70: 000100 620525 jsp resetResults
  72:               // Reset all clock state to a known-clean starting condition.
  73:               // 'cls' with AC=0: op = (AC >> 8) & 017 = 0, so the else branch fires
  74:               // and sets enabled = enable32ms = enable1min = 0.
  75:               // 'cct' with AC=0: count=0, the else branch clears the cctcks flag and
  76:               // counterCompleteNeeded; no IOCOMPLETE is asserted (no modifier).
  77:               // 'cbs' clears b3 (synchronized), b4 (held), and b2 (raw) break state.
  79: 000101 760200 cla
  80: 000102 722032 iot 2032      // disable clock
  81: 000103 760200 cla
  82: 000104 722132 iot 2132      // reset countdown; clears cctcks (no modifier = no hang)
  83: 000105 720056 cbs      // clear any pending SBS breaks
  85: 000106 200706 lac [bannerMsg]

  86: 000107 170462 jda typetext
  88:               // ---- T01-1: rck returns 0 when clock is disabled -------------------------
  89:               //
  90:               // All IOTs in the 30-37 device range clear IO before the plugin runs.
  91:               // When enabled=0, IOT_32.c's plain-rck branch leaves IO at 0.
  93: 000110 720032 iot 32      // IO = counter if enabled, 0 if disabled
  94: 000111 760040 lai      // AC <- IO
  95: 000112 640100 sza      // skip if AC == 0 (disabled: expected)
  96: 000113 600120 jmp t1fail
  97: 000114 220707 lio [0]
;
  97: 000115 200722 lac [lbl1]
;
  97: 000116 170543 jda reportResult;
  97: 000117 600123 jmp t1done
  98: 000120        t1fail,
  99: 000120 220710 lio [1]
;
  99: 000121 200722 lac [lbl1]
;
  99: 000122 170543 jda reportResult
 100: 000123        t1done,
 102:               // ---- T01-2: rck returns non-zero after enabling clock --------------------
 103:               //
 104:               // Enable clock with no interrupt flags (clsena only in AC).
 105:               // Spin ~1000 iterations to allow the 1ms counter to accumulate ticks.
 106:               // Each loop iteration costs about 3 instructions at ~5us each, so 1000
 107:               // iterations = ~15ms, giving ~15 ticks guaranteed.
 109: 000123 200711 lac [2000]
      // AC = clsena (2000 octal): enable, no interrupts
 110: 000124 722032 iot 2032      // IOT 2032: configure clock
 112: 000125 000000 local spCnt2
 113: 000125 340132 dzm spCnt2
 114: 000126        spLp2,
 115: 000126 440132 idx spCnt2      // spCnt2++; AC = spCnt2
 116: 000127 500712 sad [1750]
      // skip if AC != 1000 (still looping); no-skip when AC == 1000
 117: 000130 600133 jmp spLp3      // AC == 1000 (no-skip): done, jump to exit and over storage
 118: 000131 600126 jmp spLp2      // AC != 1000 (skip case): loop back
 119: 000132 000000 spCnt2, 0      // storage must precede the loop that references it
 120: 000133 000000 endloc
 122: 000133        spLp3,
 123: 000133 720032 iot 32      // IO = current 1ms counter value (should be > 0)
 124: 000134 760040 lai      // AC <- IO
 125: 000135 650100 sza i      // skip if AC != 0 (counter is running)
 126: 000136 600143 jmp t2fail
 127: 000137 220707 lio [0]
;
 127: 000140 200723 lac [lbl2]
;
 127: 000141 170543 jda reportResult;
 127: 000142 600146 jmp t2done
 128: 000143        t2fail,
 129: 000143 220710 lio [1]
;
 129: 000144 200723 lac [lbl2]
;
 129: 000145 170543 jda reportResult
 130: 000146        t2done,
 132:               // ---- T01-3: counter advances monotonically between two reads -------------
 133:               //
 134:               // Read rck, save the value, spin ~1000 iterations, read rck again.
 135:               // Check: first reading < second reading (counter must have advanced).
 136:               // The 1ms counter runs 0-59999 and then wraps; a 15ms delay cannot wrap.
 138: 000146 720032 iot 32
 139: 000147 760040 lai
 140: 000150 240457 dac firstRead      // save first counter sample
 142: 000151 000000 local spCnt3
 143: 000151 340156 dzm spCnt3
 144: 000152        spLp3b,
 145: 000152 440156 idx spCnt3
 146: 000153 500712 sad [1750]
      // skip if AC != 1000; no-skip when AC == 1000
 147: 000154 600157 jmp t3spDone      // AC == 1000 (no-skip): done
 148: 000155 600152 jmp spLp3b      // AC != 1000 (skip case): loop back
 149: 000156 000000 spCnt3, 0
 150: 000157 000000 endloc
 152: 000157        t3spDone,
 153: 000157 720032 iot 32
 154: 000160 760040 lai      // AC = second counter sample
 155: 000161 240460 dac secondRead
 157: 000162 200457 lac firstRead
 158: 000163 420460 sub secondRead      // AC = first - second; negative means second > first
 159: 000164 640400 sma      // skip if AC < 0 (second > first: counter advanced)
 160: 000165 600172 jmp t3fail
 161: 000166 220707 lio [0]
;
 161: 000167 200724 lac [lbl3]
;
 161: 000170 170543 jda reportResult;
 161: 000171 600175 jmp t3done
 162: 000172        t3fail,
 163: 000172 220710 lio [1]
;
 163: 000173 200724 lac [lbl3]
;
 163: 000174 170543 jda reportResult
 164: 000175        t3done,
 166:               // ---- T01-4: rck returns 0 after disabling clock --------------------------
 167:               //
 168:               // AC=0 -> op=0 -> else branch in IOT_32.c -> enabled=0.
 169:               // Subsequent rck leaves IO at 0 (IO cleared by IOT, not overwritten
 170:               // because the enabled check fails).
 172: 000175 760200 cla
 173: 000176 722032 iot 2032      // disable clock
 174: 000177 720032 iot 32
 175: 000200 760040 lai
 176: 000201 640100 sza      // skip if AC == 0 (disabled again)
 177: 000202 600207 jmp t4fail
 178: 000203 220707 lio [0]
;
 178: 000204 200725 lac [lbl4]
;
 178: 000205 170543 jda reportResult;
 178: 000206 600212 jmp t4done
 179: 000207        t4fail,
 180: 000207 220710 lio [1]
;
 180: 000210 200725 lac [lbl4]
;
 180: 000211 170543 jda reportResult
 181: 000212        t4done,
 183:               // ---- T01-5: countdown timer fires and sets cctcks (polling) --------------
 184:               //
 185:               // 'cct' with no modifier: completion=0, so counterCompleteNeeded=0 and no
 186:               // ioh stall.  The IOT returns immediately after setting the countdown.
 187:               // When iotPoll() counts down to 0 it sets CKS bit cctcks (000020 octal).
 188:               // Poll 'cks' in a tight loop until that bit appears, with a safety
 189:               // timeout of 5000 iterations (>> the 20ms countdown period).
 190:               // The main clock does not need to be enabled for the countdown to work;
 191:               // IOT_32.c calls enablePolling(200) independently when count > 0.
 193: 000212 200714 lac [24]
      // countdown value = 20 ms
 194: 000213 722132 iot 2132      // IOT 2132: set countdown, no modifier
 196: 000214 000000 local plCnt5
 197: 000214 340227 dzm plCnt5
 198: 000215        plLp5,
 199: 000215 720033 cks      // IO <- CKS status bits (IOTs 30-37 clear IO first)
 200: 000216 760040 lai      // AC <- IO
 201: 000217 020715 and [20]
      // isolate countdown-complete flag (000020)
 202: 000220 640100 sza      // skip if AC == 0 (cctcks not set: still waiting)
 203: 000221 600230 jmp t5pass      // jmp fires when AC != 0 (cctcks set: done)
 204: 000222 440227 idx plCnt5      // still waiting; bump timeout counter
 205: 000223 200227 lac plCnt5
 206: 000224 500726 sad [11610]
      // skip at 5000 iterations (timed out): falls to jmp t5fail
 207: 000225 600234 jmp t5fail      // timed out: jump to fail and past storage
 208: 000226 600215 jmp plLp5
 209: 000227 000000 plCnt5, 0
 210: 000230 000000 endloc
 212: 000230        t5pass,
 213: 000230 220707 lio [0]
;
 213: 000231 200727 lac [lbl5]
;
 213: 000232 170543 jda reportResult;
 213: 000233 600237 jmp t5done
 214: 000234        t5fail,
 215: 000234 220710 lio [1]
;
 215: 000235 200727 lac [lbl5]
;
 215: 000236 170543 jda reportResult
 216: 000237        t5done,
 218:               // ---- T01-6: countdown timer completion pulse via ioh wait ----------------
 219:               //
 220:               // 'cct i': B5 set -> nac=1 -> completion=1 -> counterCompleteNeeded=1.
 221:               // B5 also causes pdp1.c to set ioh=1, spinning on the IOT until ios=1.
 222:               // When iotPoll() counts down to 0 it fires IOCOMPLETE (ios=1), releasing
 223:               // the ioh stall.  If execution reaches the next instruction, it passed.
 225: 000237 200730 lac [36]
      // countdown value = 30 ms
 226: 000240 732132 iot 2132 i      // IOT 2132 with i: set countdown and block until done
 228:               // if we reach here, the ioh was released => completion worked
 229: 000241 220707 lio [0]
;
 229: 000242 200731 lac [lbl6]
;
 229: 000243 170543 jda reportResult
 231:               // ---- T01-7: countdown reset (count=0) clears the cctcks flag ------------
 232:               //
 233:               // After T01-6's countdown fired, iotPoll set cctcks.  'cct' with AC=0
 234:               // resets: count=0 causes the else branch which calls
 235:               //   CKS(pdp1P) &= ~COUNTER_CKS_FLAG   (line at the top of the handler)
 236:               // before entering the else, so the flag is cleared unconditionally.
 237:               // Immediately poll cks to confirm.
 239: 000244 760200 cla
 240: 000245 722132 iot 2132      // reset countdown; AC=0 clears cctcks, no modifier
 242: 000246 720033 cks
 243: 000247 760040 lai
 244: 000250 020715 and [20]

 245: 000251 640100 sza      // skip if cctcks == 0 (cleared: expected)
 246: 000252 600257 jmp t7fail
 247: 000253 220707 lio [0]
;
 247: 000254 200732 lac [lbl7]
;
 247: 000255 170543 jda reportResult;
 247: 000256 600262 jmp t7done
 248: 000257        t7fail,
 249: 000257 220710 lio [1]
;
 249: 000260 200732 lac [lbl7]
;
 249: 000261 170543 jda reportResult
 250: 000262        t7done,
 252:               // ---- T01-8: 32ms SBS interrupt fires within expected window --------------
 253:               //
 254:               // Setup: the interrupt handler (clkInt32ms) is at location 3, set up
 255:               // by the '0/' block at the top of this program.  The handler increments
 256:               // intFlag and returns via 'jmp i 1' (DEBREAK).
 257:               //
 258:               // The spin loop below uses 3 instructions per iteration; at ~5us/cycle
 259:               // and ~5 cycles per instruction, 5000 iterations take roughly 75ms,
 260:               // which comfortably spans at least two 32ms interrupt periods.
 261:               //
 262:               // After the spin, we disable SBS and the clock BEFORE calling any
 263:               // typewriter output routines: the interrupt handler clobbers AC, so
 264:               // allowing it to fire inside typetext/jda sequences would corrupt them.
 265:               //
 266:               // cls flag encoding for clsena clsims (channel 0):
 267:               //   bit e (2000): enable clock
 268:               //   bit i (0400): enable 32ms interrupt
 269:               //   clfmms (0017): channel field = 0
 270:               //   -> AC = 2000 | 0400 = 2400 octal
 271:               //
 272:               // With sbs16=0 (SBS256), req(pdp, 0) sets b2=1 unconditionally, and the
 273:               // break saves at locations 0-3 regardless of the channel argument.
 275: 000262 340461 dzm intFlag      // clear interrupt count before arming
 277: 000263 720055 esm      // enable sequence break master (sbm=1)
 278: 000264 200716 lac [2000 400]
      // AC = 2400 octal: enable clock + 32ms interrupt
 279: 000265 722032 iot 2032      // IOT 2032: configure clock; channel32ms = AC & 017 = 0
 281: 000266 000000 local spCnt8
 282: 000266 340273 dzm spCnt8
 283: 000267        spLp8,
 284: 000267 440273 idx spCnt8
 285: 000270 500726 sad [11610]
      // skip if AC != 5000; no-skip when AC == 5000
 286: 000271 600274 jmp t8spDone      // AC == 5000 (no-skip): done
 287: 000272 600267 jmp spLp8      // AC != 5000 (skip case): loop back
 288: 000273 000000 spCnt8, 0
 289: 000274 000000 endloc
 291: 000274        t8spDone,
 292:               // Disable SBS and clock before any typewriter I/O.
 293: 000274 720056 cbs      // clear b3/b4/b2; sbm stays 1 but no new requests pending
 294: 000275 760200 cla
 295: 000276 722032 iot 2032      // disable clock (AC=0 -> op=0 -> enabled=0)
 297: 000277 200461 lac intFlag
 298: 000300 650100 sza i      // skip if intFlag != 0 (at least one interrupt fired)
 299: 000301 600306 jmp t8fail
 300: 000302 220707 lio [0]
;
 300: 000303 200733 lac [lbl8]
;
 300: 000304 170543 jda reportResult;
 300: 000305 600311 jmp t8done
 301: 000306        t8fail,
 302: 000306 220710 lio [1]
;
 302: 000307 200733 lac [lbl8]
;
 302: 000310 170543 jda reportResult
 303: 000311        t8done,
 305:               // ---- Summary and re-run prompt -------------------------------------------
 307: 000311 620647 jsp printSummary
 309: 000312 760001 clf 1      // discard any keypress that arrived during the test
 310: 000313 200734 lac [rerunMsg]

 311: 000314 170462 jda typetext
 312: 000315 720054 lsm      // be sure interrupts are disabled now
 314: 000316 000000 local waitKey
 315: 000316        waitKey,
 316: 000316 650001 szf 1 i      // skip if PF1 is set (key available)
 317: 000317 600316 jmp waitKey      // PF1 clear: no key yet, keep waiting
 318: 000320 720004 tyi      // read key; clears tbs; IO <- 6-bit key code
 319: 000321 760001 clf 1      // clear PF1 (tyi clears tbs but NOT PF1)
 320: 000322 000000 endloc
 322: 000322 600100 jmp begin      // re-run
 324:               // ---- 32ms SBS interrupt handler (T01-8) ----------------------------------
 325:               //
 326:               // Entry point: location 3 (see '0/' block at top of file).
 327:               // On arrival, the break sequence has already saved the interrupted
 328:               // program's AC/PC/IO to locations 0-2.
 329:               // 'idx intFlag' increments the flag word; AC receives the new value
 330:               // (we do not preserve it -- the main spin loop reloads AC at its top).
 331:               // 'jmp i 1' performs DEBREAK: reads the saved PC from location 1,
 332:               // clears b3/b4 (the held-break registers), and jumps to the saved PC.
 334: 000323        clkInt32ms,
 335: 000323 440461 idx intFlag      // intFlag++; AC = new intFlag value
 336: 000324 610001 jmp i 1      // DEBREAK: restore PC from loc 1, clear held-break state
 338:               // ---- Test label strings --------------------------------------------------
 339: 000325 000000 bannerMsg, // text "
TIMESHARING CLOCK TEST
"
