File /home/wje/PDP-1/pidp1-mods/Am1Includes/TESTUTIL/reportResult.ac
   3:           /*
   4:            * reportResult - helper for self-checking PDP-1 test programs.
   5:            *
   6:            * Prints a caller-supplied label on the typewriter followed by " PASS", " FAIL", or " SKIP"
   7:            * and a newline, then increments the corresponding running counter so a whole test
   8:            * suite can finish with a printed summary.
   9:            *
  10:            * Each counter can also be incremented via the addFail, addPass, and addSkip jsp subroutines, adding one
  11:            * to the count.
  12:            * Just remember that reportResult always increments it also.
  13:            *
  14:            * jsp resetResults reset all the counts to 0.
  15:            *
  16:            * Calling convention for reportResult:
  17:            *   AC -- address of the label's text block. The block must be produced by the 'text' directive
  18:            *         and followed by a word containing the flex/concise stop code, 013.
  19:            *   IO -- the result code: REPORT_PASS, REPORT_FAIL, or REPORT_SKIP, defined in reportResult.ah.
  20:            *          Any other value is treated as REPORT_FAIL.
  21:            * Called via jda. Neither AC nor IO is preserved.
  22:            *
  23:            * Example:
  24:            *   lac [secLabel        // address of a 'text "section name"' block ending in a 013 stop word
  25:            *   lio [REPORT_PASS
  26:            *   jda reportResult
  27:            *
  28:            * The printSummary subroutine takes no arguments.
  29:            * Tt prints the three running totals accumulated since the last resetResults call on one line.
  30:            * Called via jsp. Neither AC nor IO is preserved.
  31:            */

File /home/wje/PDP-1/pidp1-mods/Am1Includes/TYO/typetext.ac
   7:               // Type a line of characters on the typewriter.
   8:               // The characters consist of a list of words produced by the text pseudo-op, flex code.
   9:               // AC contains the address of the list produced by text.
  10:               // A word following the last entry must be 013, stop.
  11:               // It does not set the initial shift state, it's whatever the typewriter is in.
  12:               // Uses AC and IO registers.
  13:               // Called via jda.
  14: 000462 000000 typetext, 0
  15: 000463 000000 local rtn, cnt, chr, top, loop, nxt
  16: 000463 260505 dap rtn
  17: 000464 210462 top, lac i typetext      // fetch next word from text
  18: 000465 500717 sad [13]
  19: 000466 600505 jmp rtn      // end marker
  20: 000467 240507 dac chr      // we have to dig out the 3 chars
  21: 000470 200721 lac [-3]
  22: 000471 240506 dac cnt
  23: 000472 440462 idx typetext      // set up for next word
  24: 000473        loop,
  25: 000473 200507 lac chr
  26: 000474 764000 cli
  27: 000475 663077 rcl 6s      // lop off the top 6 bits, into IO
  28: 000476 240507 dac chr
  29: 000477 760040 lai      // original high 6 bits now in AC low 6 bits
  30: 000500 760020 lia
  31: 000501 730003 tyo i
  32: 000502 460506 nxt, isp cnt
  33: 000503 600473 jmp loop
  34: 000504 600464 jmp top
  35: 000505 600505 rtn, jmp .
  37: 000506 000000 cnt, 0
  38: 000507 000000 chr, 0
  39: 000510 000000 endloc
