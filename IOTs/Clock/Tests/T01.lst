   4:               // Convert the binary number representing a single decimal digit to its fio-dec character value.
   5:               // IO contains the input value and has the character on return.
   6:               // Uses AC and IO registers.
   7:               // Called via jsp.
   8: 000510        numbertofio,
   9: 000510 000000 local rtn
  10: 000510 260524 dap rtn
  11: 000511 760040 lai
  12: 000512 640200 spa
  13: 000513 600523 jmp bad      // negative number
  14: 000514 420713 sub [12]
  15: 000515 650200 spa i
  16: 000516 600523 jmp bad      // greater than 9
  17: 000517 760040 lai      // use the now-validated digit, but 0 is a special case
  18: 000520 650100 sza i
  19: 000521 220715 lio [20]
  20: 000522 600524 jmp rtn
  21: 000523 760200 bad, cla      // just return a space
  22: 000524 600524 rtn, jmp .
  23: 000525 000000 endloc
