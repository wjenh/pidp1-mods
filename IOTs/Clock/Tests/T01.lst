 121:               // digitToFlex -- convert a binary digit to its flex/concise typewriter code.
 122:               // Digits 1-9 happen to use flex codes 1-9 (octal 001-011) directly; only 0 is irregular, using
 123:               // flex code 020 octal instead. Verified against Tools/AM1/parsefns.c's ascii2concise table.
 124:               // Called via jsp -- note this is jsp, not jda: there is no reserved word at the entry point to
 125:               // receive an auto-deposited value, so the argument is passed in IO, not AC. AC is NOT a safe
 126:               // channel for an argument across a jsp call: jsp overwrites AC with the return address before
 127:               // the callee's first instruction runs, so anything the caller left in AC is gone by the time
 128:               // this code can look at it. IO survives untouched, which is why it's used here instead -- see
 129:               // Claude/skill-updates/examples-additions.md's "Gotcha: jsp vs jda" note.
 130:               // IO in: digit (0-9, binary). IO out: the flex code. AC is clobbered, not preserved.
 131: 000606        digitToFlex,
 132: 000606 000000 local rtn
 133: 000606 260614 dap rtn
 134: 000607 760040 lai      // AC <- IO (the digit), only so it can be tested below
 135: 000610 640100 sza      // skip if AC == 0 (the one irregular case)
 136: 000611 600614 jmp rtn      // AC is 1-9: IO already holds the correct code (== the digit)
 137: 000612 700020 law 20      // AC == 0: flex code is 020 octal, not 0
 138: 000613 760020 lia      // IO <- AC (020)
 139: 000614 600614 rtn, jmp .
 140: 000615 000000 endloc
 142:               // printCount -- print a count (0-99 assumed) as one or two decimal digits via tyo, with no
 143:               // leading zero and no trailing text.
 144:               // Uses repeated subtraction for divide-by-10 in case hardware multiply/divide is not enabled.
 145:               // Called via jsp. IO in: the count. Neither AC nor IO is preserved across the call.
 146: 000615        printCount,
 147: 000615 000000 local rtn, units, tens
 148: 000615 260644 dap rtn
 149: 000616 340646 dzm tens
 150: 000617 320645 dio units      // in case there is no tens digit
 151: 000620 760040 lai      // AC <- IO (the count)
 152: 000621 420713 sub [12]  //  one or two digits?
 153: 000622 640200 spa      // >= 10, two digits
 154: 000623 600641 jmp afterTensDigit
 155: 000624        tensLoop,
 156: 000624 420713 sub [12]
 157: 000625 640200 spa      // skip if AC >= 0, there's room for (at least) one more ten
 158: 000626 600631 jmp tensDone
 159: 000627 440646 idx tens
 160: 000630 600624 jmp tensLoop
 161: 000631        tensDone,
 162: 000631 400713 add [12]  //  undo the subtraction that went negative; AC is now 0-9
 163: 000632 240645 dac units
 164: 000633 200646 lac tens
 165: 000634 650100 sza i      // if tens == 0, don't print it to suppress a leading zero
 166: 000635 600641 jmp afterTensDigit
 167: 000636 220646 lio tens
 168: 000637 620510 jsp numbertofio
 169: 000640 730003 tyo i
 170: 000641        afterTensDigit,
 171: 000641 220645 lio units
 172: 000642 620510 jsp numbertofio
 173: 000643 730003 tyo i
 174: 000644 600644 rtn, jmp .
 175: 000645 000000 units, 0
 176: 000646 000000 tens, 0
 177: 000647 000000 endloc
