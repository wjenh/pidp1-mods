T12: DCS2 TELNET MODE TEST
/*
 * T12.am1 -- End-to-end test of DCS2 telnet mode (dcftel): server mode,
 *            character-mode greeting, IAC negotiation refusal, IAC escaping,
 *            and cr/lf collapsing/expansion.
 *
 * Harness required:
 *   ./dcstestharness telnet-echo-client 127.0.0.1 2112
 *   Start the harness AFTER this program is running and waiting for a
 *   connection (typewriter will print "T12 listening" when ready).
 *
 *   The harness verifies the 15-byte character-mode greeting DCS2 sends on
 *   accept, sends an unsolicited option probe and verifies DCS2 refuses it,
 *   then sends a 10-byte data stream (an escaped IAC pair plus a mix of a
 *   cr/lf pair, a bare lf, and a bare cr) and verifies the 11 bytes this
 *   program echoes back match what re-escaping/re-expanding that decoded
 *   data should produce.
 *
 * What the program does:
 *   1. Opens channel 0 as a TCP server (dcftel dcfecho, no dcfflex) on
 *      port 2112.
 *   2. Signals readiness by printing "T12 listening" on the typewriter.
 *   3. Polls rcs until the harness connects (dsfcon set).
 *   4. ROC to force cur_chan to channel 0 (same reason as T02 -- no data
 *      has arrived yet at connect time).
 *   5. Reads 8 characters one at a time (rch rchclr), verifying each
 *      against the value telnet-mode input collapsing should have produced,
 *      and echoes each one straight back (tcc) so the harness can verify
 *      the output side independently.
 *   6. SCBCLEAR closes channel 0.
 *
 * The 8 expected decoded characters (see dcstestharness.c's
 * modeTelnetEchoClient for the raw bytes that produce them):
 *   0377 (an escaped IAC pair, unescaped to a literal 0xFF)
 *   'A'
 *   012  (LF -- from a cr/lf pair collapsing to one line-end character)
 *   'B'
 *   012  (LF -- a bare lf, passed through unchanged in ascii mode)
 *   'C'
 *   015  (CR -- a bare cr with no following lf, passed through unchanged)
 *   'D'
 *
 * Tests:
 *   T12-1  Channel reaches CONNECTED state after harness connects
 *   T12-2..T12-9  Each of the 8 decoded characters matches expectations
 *   T12-10 Channel closes cleanly after SCBCLEAR
 *
 * Assembler: am1 v1.28+
 * Assemble:  am1 -b T12.am1
 */

#include <DCS/dcs2defs.ah>
#include <TESTUTIL/reportResult.ah>

octal

// ---- expected decoded byte values -----------------------------------------

#define byte_ff  0377        // escaped IAC pair, unescaped to a literal 0xFF
#define byte_A   0101        // 'A'
#define byte_lf1 012         // cr/lf pair collapses to one lf
#define byte_B   0102        // 'B'
#define byte_lf2 012         // bare lf, passed through unchanged
#define byte_C   0103        // 'C'
#define byte_cr  015         // bare cr, passed through unchanged (no following lf)
#define byte_D   0104        // 'D'

100/

begin,
    jsp resetResults        // clear pass/fail/skip counters before each run
    lio [scbrst]
    scb

// ---- open server channel 0 ------------------------------------------------
//
// Control block at ctl12: dcftel dcfecho (server mode), channel 0, port 2112.
// No dcfflex -- ascii mode, so telnet cr/lf rules apply directly to the raw
// bytes with no Concise translation in between.

    lio [scbset ctl12]
    scb
    lai
    and [dserr]
    sza
    jmp halterr             // server open failed (port in use?)

// ---- signal readiness on typewriter ---------------------------------------

    lac [rdymsg]
    jda typetext

// ---- T12-1: wait for harness connection -----------------------------------

waitcon,
    lio [0]
    rcs
    lai
    and [dsfser]
    sza
    jmp t1_fail
    lio [0]
    rcs
    lai
    and [dsfcon]
    sza i
    jmp waitcon

    lio [REPORT_PASS]
    lac [lbl1]
    jda reportResult
    jmp t1_done
t1_fail,
    lio [REPORT_FAIL]
    lac [lbl1]
    jda reportResult
    jmp halterr
t1_done,

// ---- select channel 0 as current channel via ROC --------------------------

    lio [0]
    roc
    lai
    and [dserr]
    sza
    jmp halterr

// ---- T12-2: byte 0 -- 0377 (unescaped IAC pair) ---------------------------

pollrdy1,
    lio [0]
    rcs
    lai
    and [dsfcls dsfser]
    sza
    jmp b1_fail
    lio [0]
    rcs
    lai
    and [dsfrdy]
    sza i
    jmp pollrdy1

    rch rchclr
    lai
    and [dserr]
    sza
    jmp b1_fail
    lai
    sub [byte_ff]
    sza
    jmp b1_fail
    lio [REPORT_PASS]
    lac [lbl2]
    jda reportResult
    jmp b1_done
b1_fail,
    lio [REPORT_FAIL]
    lac [lbl2]
    jda reportResult
b1_done,
    lio [byte_ff]
    tcc

// ---- T12-3: byte 1 -- 'A' --------------------------------------------------

pollrdy2,
    lio [0]
    rcs
    lai
    and [dsfcls dsfser]
    sza
    jmp b2_fail
    lio [0]
    rcs
    lai
    and [dsfrdy]
    sza i
    jmp pollrdy2

    rch rchclr
    lai
    and [dserr]
    sza
    jmp b2_fail
    lai
    sub [byte_A]
    sza
    jmp b2_fail
    lio [REPORT_PASS]
    lac [lbl3]
    jda reportResult
    jmp b2_done
b2_fail,
    lio [REPORT_FAIL]
    lac [lbl3]
    jda reportResult
b2_done,
    lio [byte_A]
    tcc

// ---- T12-4: byte 2 -- lf (cr/lf pair collapsed) ---------------------------

pollrdy3,
    lio [0]
    rcs
    lai
    and [dsfcls dsfser]
    sza
    jmp b3_fail
    lio [0]
    rcs
    lai
    and [dsfrdy]
    sza i
    jmp pollrdy3

    rch rchclr
    lai
    and [dserr]
    sza
    jmp b3_fail
    lai
    sub [byte_lf1]
    sza
    jmp b3_fail
    lio [REPORT_PASS]
    lac [lbl4]
    jda reportResult
    jmp b3_done
b3_fail,
    lio [REPORT_FAIL]
    lac [lbl4]
    jda reportResult
b3_done,
    lio [byte_lf1]
    tcc

// ---- T12-5: byte 3 -- 'B' --------------------------------------------------

pollrdy4,
    lio [0]
    rcs
    lai
    and [dsfcls dsfser]
    sza
    jmp b4_fail
    lio [0]
    rcs
    lai
    and [dsfrdy]
    sza i
    jmp pollrdy4

    rch rchclr
    lai
    and [dserr]
    sza
    jmp b4_fail
    lai
    sub [byte_B]
    sza
    jmp b4_fail
    lio [REPORT_PASS]
    lac [lbl5]
    jda reportResult
    jmp b4_done
b4_fail,
    lio [REPORT_FAIL]
    lac [lbl5]
    jda reportResult
b4_done,
    lio [byte_B]
    tcc

// ---- T12-6: byte 4 -- lf (bare lf, passed through) ------------------------

pollrdy5,
    lio [0]
    rcs
    lai
    and [dsfcls dsfser]
    sza
    jmp b5_fail
    lio [0]
    rcs
    lai
    and [dsfrdy]
    sza i
    jmp pollrdy5

    rch rchclr
    lai
    and [dserr]
    sza
    jmp b5_fail
    lai
    sub [byte_lf2]
    sza
    jmp b5_fail
    lio [REPORT_PASS]
    lac [lbl6]
    jda reportResult
    jmp b5_done
b5_fail,
    lio [REPORT_FAIL]
    lac [lbl6]
    jda reportResult
b5_done,
    lio [byte_lf2]
    tcc

// ---- T12-7: byte 5 -- 'C' --------------------------------------------------

pollrdy6,
    lio [0]
    rcs
    lai
    and [dsfcls dsfser]
    sza
    jmp b6_fail
    lio [0]
    rcs
    lai
    and [dsfrdy]
    sza i
    jmp pollrdy6

    rch rchclr
    lai
    and [dserr]
    sza
    jmp b6_fail
    lai
    sub [byte_C]
    sza
    jmp b6_fail
    lio [REPORT_PASS]
    lac [lbl7]
    jda reportResult
    jmp b6_done
b6_fail,
    lio [REPORT_FAIL]
    lac [lbl7]
    jda reportResult
b6_done,
    lio [byte_C]
    tcc

// ---- T12-8: byte 6 -- cr (bare cr, no following lf) -----------------------

pollrdy7,
    lio [0]
    rcs
    lai
    and [dsfcls dsfser]
    sza
    jmp b7_fail
    lio [0]
    rcs
    lai
    and [dsfrdy]
    sza i
    jmp pollrdy7

    rch rchclr
    lai
    and [dserr]
    sza
    jmp b7_fail
    lai
    sub [byte_cr]
    sza
    jmp b7_fail
    lio [REPORT_PASS]
    lac [lbl8]
    jda reportResult
    jmp b7_done
b7_fail,
    lio [REPORT_FAIL]
    lac [lbl8]
    jda reportResult
b7_done,
    lio [byte_cr]
    tcc

// ---- T12-9: byte 7 -- 'D' --------------------------------------------------

pollrdy8,
    lio [0]
    rcs
    lai
    and [dsfcls dsfser]
    sza
    jmp b8_fail
    lio [0]
    rcs
    lai
    and [dsfrdy]
    sza i
    jmp pollrdy8

    rch rchclr
    lai
    and [dserr]
    sza
    jmp b8_fail
    lai
    sub [byte_D]
    sza
    jmp b8_fail
    lio [REPORT_PASS]
    lac [lbl9]
    jda reportResult
    jmp b8_done
b8_fail,
    lio [REPORT_FAIL]
    lac [lbl9]
    jda reportResult
b8_done,
    lio [byte_D]
    tcc

// ---- T12-10: SCBCLEAR and verify closed ------------------------------------

    lio [ctl12]
    scb

    local
waitclosed,
    lio [0]
    rcs
    lai
    and [dsfopn]
    sza i
    jmp %closed_ok
    jmp waitclosed
%closed_ok,
    lio [REPORT_PASS]
    lac [lbl10]
    jda reportResult
    endloc

// ---- cleanup and halt ------------------------------------------------------

    lio [scbrst]
    scb

    jsp printSummary
    hlt
    jmp begin

halterr,
    hlt
    jmp begin

// ---- labels and strings ----------------------------------------------------

rdymsg,
    text "T12 listening on 2112\n"
    013

lbl1,
    text "T12-1 connected"
    013
lbl2,
    text "T12-2 byte0 0xff"
    013
lbl3,
    text "T12-3 byte1 A"
    013
lbl4,
    text "T12-4 byte2 lf"
    013
lbl5,
    text "T12-5 byte3 B"
    013
lbl6,
    text "T12-6 byte4 lf"
    013
lbl7,
    text "T12-7 byte5 C"
    013
lbl8,
    text "T12-8 byte6 cr"
    013
lbl9,
    text "T12-9 byte7 D"
    013
lbl10,
    text "T12-10 chan closed"
    013

// ---- channel control block (server mode, telnet, channel 0, port 2112) ---
//
// word 0: dcftel + dcfecho + dcfsrv, channel 0
// word 1: port = 2112

octal
ctl12,
    dcftel+dcfecho+dcfsrv
decimal
    2112
octal

#include <TYO/typetext.ac>
#include <TESTUTIL/reportResult.ac>
constants

start begin
