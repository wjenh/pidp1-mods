DCS2 CLIENT ECHO TEST -- tyi keyboard input, send via DCS2, receive echo, print via tyo
/*
 * dcstest.am1 -- DCS2 client-mode echo test for the PDP-1D emulator.
 *
 * Purpose:
 *   Exercise the DCS2 (IOT 22) client path end-to-end.  The program opens
 *   channel 0 as a TCP client targeting 127.0.0.1:2022, waits for the
 *   connection to be established, then loops:
 *
 *       (szf 1 i / tyi / clf 1)  -->  tcb  -->  [echo server]  -->  rch rchclr  -->  tyo C
 *
 *   Run dcsecho (the companion C program) on port 2022 before starting this.
 *
 * Character encoding note:
 *   tyi delivers a 6-bit Concise/Flexo code in IO[bits 0-5].  tcb sends
 *   the low 8 bits of IO as a raw byte (binary mode, dcfflex not set).
 *   The echo server returns the same byte; rch places it back in IO[0-7].
 *   tyo reads IO[0-5] and drives the typewriter, so the round-trip is
 *   transparent and the character displayed matches the character typed.
 *
 * Control block layout (client mode, channel 0):
 *   word 0: flags + channel number  (0 = channel 0, no option flags)
 *   word 1: port number             (2022 decimal)
 *   word 2: IP address high 16 bits (127.0 = 0x7F00 = 32512 decimal)
 *   word 3: IP address low  16 bits (0.1   = 0x0001 =      1 decimal)
 *
 * Assembler: am1 v1.28+
 * Assemble:  am1 -b dcstest.am1
 */

#include <DCS/dcs2defs.ah>

// All numeric literals without an explicit 0x/0d/0o prefix are octal.
// Switch to decimal for the port and IP values where decimal is natural.
octal

// ---------------------------------------------------------------------------
// Program origin.  Location 100 avoids the trap/interrupt vectors at 0-7
// and the small scratch area at 10-17 sometimes used by system software.
// ---------------------------------------------------------------------------
100/

// ---- open the client channel ----------------------------------------------
//
// IO is loaded with  scbset | address-of-ctl  before executing scb.
// scbset (010000) encodes the SCBOPEN command in IO bits 12-14 as seen by
// manageChannelBlock():  cmd = (io >> 12) & 07  →  1 = SCBOPEN.
// The low 12 bits are the address of the control block in the current bank.
//
// After scb, IO is 0 on success or has the error flag (dserr, bit 17) set.
// We isolate just the error flag bit and halt if it is nonzero.

begin,
    lio [scbset ctl]    // IO = scbset | address(ctl) -- open command + CB addr
    scb                 // execute SCB; IO <- 0 or error code
    lai                 // AC <- IO  (move result to AC for test)
    and [dserr]         // isolate error flag bit
    sza                 // skip if AC = 0  (no error) -- continue past halt
    jmp halterr         // AC != 0: error flag set -- halt

// ---- poll until the TCP connection is established -------------------------
//
// rcs reads the channel's internal control_flags into IO.
// We isolate the dsfcon (connected) bit and loop until it is set.
// The DCS2 iotPoll() thread drives the non-blocking connect() to completion
// in the background; this loop yields to it naturally.
//
// We also watch dsfser (socket error) and dsfcls (connection lost) so that
// a refused connection causes a halt rather than an infinite loop.

waitcon,
    lio [0]             // IO <- 0 = channel number 0 (for rcs)
    rcs                 // IO <- channel 0 status flags
    lai                 // AC <- IO
    and [dsfser dsfcls] // isolate error/lost bits  (OR, since space = OR)
    sza                 // skip if AC = 0  (no error bits) -- continue past halt
    jmp halterr         // AC != 0: socket error or remote close -- halt

    lio [0]             // IO <- channel 0 again for the connected check
    rcs
    lai
    and [dsfcon]        // isolate connected flag
    sza i               // skip if AC != 0  (now connected)
    jmp waitcon         // not yet connected -- keep polling

// ---- select channel 0 as the send band -----------------------------------
//
// ssb uses IO & 077 as the channel number and records it in send_chan.
// tcb then uses send_chan for output rather than the current-receive channel.
// This separation is important: tcb and rch can operate on different channels,
// and making the send channel explicit avoids relying on cur_chan being valid
// before any character has been received.

    cli                 // IO <- 0  (channel 0)
    ssb                 // send_chan <- 0

// ---- main loop: tyi -> tcb -> poll -> rch -> tyo -------------------------

keyloop,

    // --- read one character from the keyboard ---
    //
    // tyi is completely asynchronous and does NOT honor the C (in-out wait)
    // flag.  The correct idiom (PDP-1 Handbook, Type-In section):
    //   1. Poll Program Flag 1 (PF1) until set -- PF1 is set by the hardware
    //      when a typewriter key is struck and the code placed in the buffer.
    //   2. Execute tyi WITHOUT the C flag.  It clears IO, then transfers the
    //      typewriter buffer to IO[bits 0-5], and clears the type-in status
    //      bit (tbs).
    //   3. Clear PF1 explicitly with clf 1.  tyi clears tbs only; PF1 remains
    //      set until the programmer clears it.  Without this, the next szf 1 i
    //      would skip immediately on the next loop iteration, re-reading the
    //      stale buffer character rather than waiting for a new keypress.
    //
    // szf 1 (skip if PF1 = zero) with the i bit (010000) inverts the sense:
    // szf 1 i = skip if PF1 is non-zero (key available).

    local getkey
getkey,
    szf 1 i             // skip if PF1 set (key in typewriter buffer)
    jmp getkey          // PF1 clear -- no key yet, keep polling
    tyi                 // PF1 set: IO <- typewriter buffer; clears tbs
    clf 1               // clear PF1 -- required so next poll waits for new key
    endlocal

    // --- send the character via DCS2 ---
    //
    // tcb sends IO & 0xFF (low 8 bits) to the TCP socket of send_chan.
    // On success IO is cleared to 0.  On failure the error flag is set.
    // We test the error flag before proceeding so a dropped connection halts
    // cleanly rather than looping silently.

    tcb                 // transmit IO[0-7] to server; IO <- 0 or error
    lai                 // AC <- IO
    and [dserr]         // isolate error flag
    sza                 // skip if AC = 0  (no error) -- continue past halt
    jmp halterr         // AC != 0: send failed -- halt

    // --- poll for the echoed character ---
    //
    // iotPoll() sets CNTL_RREADY (dsfrdy) on a channel when data arrives and
    // auto-assigns cur_chan to that channel if none is currently locked.
    // We poll rcs until dsfrdy is set, at which point rch will succeed.
    //
    // We also check for connection loss (dsfcls) so a server shutdown does
    // not produce an infinite loop.

pollrdy,
    lio [0]             // IO <- channel 0
    rcs                 // IO <- channel status
    lai                 // AC <- status
    and [dsfcls]        // check if remote closed
    sza                 // skip if AC = 0  (not closed) -- continue past halt
    jmp halterr         // AC != 0: remote end closed -- halt

    lio [0]             // IO <- channel 0 again for dsfrdy check
    rcs
    lai
    and [dsfrdy]        // isolate "character ready" flag
    sza i               // skip if AC != 0  (data available)
    jmp pollrdy         // not ready yet -- keep polling

    // --- read the echoed character ---
    //
    // rch reads the next character from cur_chan (which iotPoll has set to
    // channel 0 because data arrived) into IO.  In binary mode (no dcfflex)
    // the low 8 bits of IO receive the raw byte.
    //
    // The rchclr flag (bit 7 of the instruction word, 002000) is REQUIRED.
    // Without it, rch uses "IO &= 0xFF" before ORing in the received byte,
    // which preserves any status bits left in IO by the preceding rcs call.
    // rcs leaves at minimum dsfopn|dsfcon|dsfrdy = 025 octal in IO[low 8 bits].
    // Those bits survive the "&= 0xFF" and corrupt the result: for 'a' = 061,
    // 025 | 061 = 065 = 'e'.  rchclr forces IO = 0 first, avoiding the ORing.
    //
    // rch does NOT release cur_chan (use rchr to release after reading).
    // Because this program uses only channel 0, leaving cur_chan locked to
    // channel 0 is harmless and avoids an unnecessary rsc per loop iteration.

    rch rchclr          // IO <- 0, then IO |= received byte (rchclr clears first)
    lai                 // AC <- IO
    and [dserr]         // isolate error flag
    sza                 // skip if AC = 0  (no error) -- continue past halt
    jmp halterr         // AC != 0: receive failed -- halt

    // --- print the character ---
    //
    // tyo C reads IO bits 0-5 as a 6-bit Concise code and drives the
    // typewriter output, blocking until the character is printed.
    // Because the server echoes back exactly what we sent (which originated
    // from tyi), IO[0-5] holds the original Concise code and the correct
    // character is displayed.

    tyo i               // output IO[0-5] to typewriter; block until done

    jmp keyloop         // next character

// ---- error / halt ---------------------------------------------------------
//
// IO holds the error code (from scb, rcs, tcb, or rch) when we arrive here.
// The programmer can examine it via the EXAMINE IO console function.

halterr,
    hlt                 // halt; IO contains the failing error code
    jmp begin           // CONTINUE pressed -- restart from the top

// ---------------------------------------------------------------------------
// DCS2 channel control block for client mode.
//
// Layout required by manageChannelBlock() in IOT_22.c (SCBOPEN path):
//   word 0  [*rqstP++] : option flags  |  channel number in bits 0-5
//   word 1  [*rqstP++] : TCP port number
//   word 2  [*rqstP++] : IP address high 16 bits  (only for client channels)
//   word 3  [*rqstP  ] : IP address low  16 bits
//
// The IP address is reconstructed as:
//   sin_addr = htonl( (word2 << 16) | word3 )
//
// For 127.0.0.1 = 0x7F000001:
//   word 2 = 0x7F00 = 127*256 = 32512 decimal
//   word 3 = 0x0001 = 1 decimal
//
// No option flags are set: no dcfsrv (client, not server), no dcfflex
// (binary/raw mode), no dcftel, no dcfecho, no interrupt enables.
// Channel number = 0 in the low 6 bits.
// ---------------------------------------------------------------------------

decimal                 // switch to decimal for the IP/port values

ctl,
    0                   // word 0: flags=0, channel=0
    2022                // word 1: port 2022
    32512               // word 2: IP high = 0x7F00 = 127.0.x.x
    1                   // word 3: IP low  = 0x0001 = x.x.0.1

octal                   // restore octal default

// Emit any constants accumulated by [expr] usages above.
constants

start begin
