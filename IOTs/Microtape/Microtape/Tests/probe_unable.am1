Microtape probe -- tape unable

#include <MICROTAPE/type550defs.ah>

// Phase 5 of Magtape/TASK-TYPE550.md. Needs drive 1 mounted, drive 2 mounted locked
// (2 <image>,locked in microtapes.txt) and no line for drive 3.
// Each check selects a drive, loads a control word, and looks at the ERF and UNABLE bits
// at once; the refusals are immediate. Checks 3 and 4 are the control legs: the same
// drives, commands they may carry out.
//   1  drive 3, no tape: move          refused (101000)
//   2  drive 2, locked: write          refused (101000)
//   3  drive 2, locked: read           accepted (0)
//   4  drive 1: write                  accepted (0)
//   5  no drive selected: move         refused (101000)
//   6  mse clears UNABLE and ERF       (0)
// Halts at pass with AC = 0, or at fail with AC = the failing check and IO = the status.

#define TRY(num, unit, ctlword, expect) \
    law num; \
    dac which; \
    lio [unit]; \
    mse; \
    lio [ctlword]; \
    mlc; \
    mrs; \
    dio got; \
    lac got; \
    and [mterf mtunab]; \
    sas [expect]; \
    jmp fail; \
    cli; \
    mlc

100/
begin,
    TRY(1, mtu3, mtgo mtmove, mterf mtunab)
    TRY(2, mtu2, mtgo mtwrit, mterf mtunab)
    TRY(3, mtu2, mtgo mtread, 0)
    TRY(4, mtu1, mtgo mtwrit, 0)
    TRY(5, 0, mtgo mtmove, mterf mtunab)
    law 6
    dac which
    lio [mtu1]
    mse                     // clears UNABLE and ERF
    mrs
    dio got
    lac got
    and [mterf mtunab]
    sza                     // skip if both are clear
    jmp fail
pass,
    hlt                     // AC = 0: every check passed
    jmp begin

fail,
    lac which
    lio got
    hlt                     // AC = the failing check, IO = the status word
    jmp begin

which,  0
got,    0

constants

start begin
