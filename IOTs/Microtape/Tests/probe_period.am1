Microtape probe -- the search block period, timed with the 1 ms clock

#include <MICROTAPE/type550defs.ah>
#include <CLOCK/clockdefs.ah>

// Phase 5 of Magtape/TASK-TYPE550.md. Needs drive 1 mounted and the IOT 32 clock.
// Searches drive 1 forward and times 5, then 10 block periods from search flag to search
// flag with the 1 ms clock. At 52.8 ms a block, expect 264 and 528 ms (octal 410 and
// 1020), give or take the clock's millisecond. The 5-block time is the control leg: it
// must be half the 10-block time.
// Halts at done with AC = the 10-block time and IO = the 5-block time, in ms,
// or at fail with AC = the status word.

100/
begin,
    lac [clsena]
    cls                     // enable the clock (its control word is in AC)
    lio [mtu1]
    mse
    lio [mtgo mtsrch]
    mlc                     // search forward
    law i 1
    jda count               // the first search flag
    rck                     // IO = the ms clock
    dio t0
    law i 5
    jda count               // five more
    rck
    dio t1
    law i 12
    jda count               // ten (octal 12) more
    rck
    dio t2
    cli
    mlc                     // stop the tape

    lac t1
    sub t0
    dac diff
    jsp wrap
    dac five
    lac t2
    sub t1
    dac diff
    jsp wrap
    lio five
done,
    hlt                     // AC = 10 blocks, IO = 5 blocks, in ms
    jmp begin

fail,
    mrs
    dio stat
    lac stat
    hlt                     // AC = the status word
    jmp begin

// Takes as many search flags as jda left, negated, in count, clearing each with mrd.
// An error flag goes to fail.
count,
    0
    dap countx
cnt1,
    mrs                     // IO = status
    spi i                   // skip if the data flag is up
    jmp cnt2
    mrd
    isp count
    jmp cnt1
countx,
    jmp .
cnt2,
    ril 2s                  // the error flag to IO bit 0
    spi i                   // skip if it is up
    jmp cnt1                // nothing yet
    jmp fail

// Returns AC = diff, corrected for the clock's wrap from 59999 to 0.
wrap,
    dap wrapx
    lac diff
    sma                     // skip if negative: the clock wrapped
    jmp wrapx
    add [0d60000]
wrapx,
    jmp .

t0,     0
t1,     0
t2,     0
five,   0
stat,   0
diff,   0

constants

start begin
