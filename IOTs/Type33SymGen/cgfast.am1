Type 33 symbol generator fast rendering

#include <SYMGEN/type33iots.ah>

#define YSTART 0d300
#define YDELTA 0d50
#define XSTART -0d450
#define SIZE 2
#define AUTOSPACE 4
#define BRIGHTNESS 2

#define clrnum dzm ones; dzm tens; dzm hundreds; dzm thousands

100/
strt,
    // Unpack the text lines first
    lio [buf1
    lac [line1
    jda unpacktext
    dio buf1len

    lio [buf2
    lac [line2
    jda unpacktext
    dio buf2len

    lio [buf3
    lac [line3
    jda unpacktext
    dio buf3len

    lio [buf4
    lac [line4
    jda unpacktext
    dio buf4len

    law SIZE AUTOSPACE (BRIGHTNESS << 6)
    lia
    iot glf
    clrnum
loop,
    law YSTART
    dac yoffset
    sal 8s
    lia
    lac xoffset
    iot sdb 200
    lio buf1len
    lac [buf1
    jda renderchars

    lac yoffset
    sub [YDELTA
    dac yoffset
    sal 8s
    lia
    lac xoffset
    iot sdb 200
    lio buf2len
    lac [buf2
    jda renderchars

    lac yoffset
    sub [YDELTA
    dac yoffset
    sal 8s
    lia
    lac xoffset
    iot sdb 200
    lio buf3len
    lac [buf3
    jda renderchars

    lac yoffset
    sub [YDELTA
    dac yoffset
    sal 8s
    lia
    lac xoffset
    iot sdb 200
    lio buf4len
    lac [buf4
    jda renderchars

    jsp updnum
    jmp loop

updnum,             // jsp call
    local rtn
    dap rtn
    cli
    law i 400
    iot sdb 200

    lac thousands
    jda drawdigit

    lac hundreds
    jda drawdigit

    lac tens
    jda drawdigit

    lac ones
    jda drawdigit

    jsp updatedigits
rtn, jmp .
    endloc

updatedigits,        // increment ones, ripple overflow up, jsp call
    local rtn
    dap rtn

    idx ones
    sas [0d10
    jmp rtn

    dzm ones
    idx tens
    sas [0d10
    jmp rtn

    dzm tens
    idx hundreds
    sas [0d10
    jmp rtn

    dzm hundreds
    idx thousands
    sad [0d10
    dzm thousands

rtn, jmp .
    endloc

xoffset, XSTART << 10
yoffset, 0

ones, 0
tens, 0
hundreds, 0
thousands, 0

line1,
    text 'The Type 30 Digital Display'
    013
buf1,
table 100
buf1len, 0

line2,
    text 'and the Type 33 Symbol Generator'
    013
buf2,
table 100
buf2len, 0

line3,
    text 'provide fast man-machine'
    013
buf3,
table 100
buf3len, 0

line4,
    text 'communication'
    013
buf4,
table 100
buf4len, 0

#include <SYMGEN/type33unpack.ac>
#include <SYMGEN/type33drawdigits.ac>

constants

start strt
