Test of the Type 340 display increment mode
// Draw a 4 dot square, under its lower left corner, the tip of a 4 dot plus.
// Under the bottom tip of the plus spaced down 2 spaces, a vertical line of 4 dots.
#include <TYPE340/type340defs.ah>

#define XORIGIN 0d600
#define YORIGIN 0d600

100/
top, lio [prog
    dla
    dss
    jmp .-1
    jmp top

// Begins in PARAM mode
prog, scale(3) intensity(3) next(point)
    y(YORIGIN) next(point)
    x(XORIGIN) next(increment)

    visible set1(incleft) set2(incup) set3(incright) set4(incdown)
    visible set1(incdown|incleft) set2(incdown|incright) set3(incdown|incleft) set4(incup|incleft)
    set1(incdown|incright) set2(incdown) set3(0) set4(0)
    visible set1(incdown) set2(incdown) set3(incdown) set4(incdown)
    end

    halt

start top
