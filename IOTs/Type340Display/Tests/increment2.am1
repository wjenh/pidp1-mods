Test of the Type 340 display increment mode
// Draw a diamond.
#include <TYPE340/type340defs.ah>

#define XORIGIN 0d500
#define YORIGIN 0d500

100/
top, lio [prog
    dla
    dss
    jmp .-1
    jmp top

// Begins in PARAM mode
prog,
    scale(3) intensity(3) next(point)
    x(XORIGIN) next(point)
    y(YORIGIN) next(subroutine)
    visible set1(incright|incup) set2(incright|incup) set3(incright|incup) set4(incright|incup)
    visible set1(incright|incdown) set2(incright|incdown) set3(incright|incdown) set4(incright|incdown)
    visible set1(incleft|incdown) set2(incleft|incdown) set3(incleft|incdown) set4(incleft|incdown)
    visible set1(incleft|incup) set2(incleft|incup) set3(incleft|incup) set4(incleft|incup) end
    halt

start top
