Test of the Type 340 display increment mode
// Draw four nested diamonds with their left point coincident.
#include <TYPE340/type340defs.ah>

#define XORIGIN 0d500
#define YORIGIN 0d500

100/
top, lio [prog
    dla
    dss
    jmp .-1
    jmp top

// Begins in PARAM mode
prog,
    SCALE(3) INTENSITY(3) NEXTMODE(POINT)
    POINTX(XORIGIN) NEXTMODE(POINT)
    POINTY(YORIGIN) NEXTMODE(SUBROUTINE)
    SAVE diamond NEXTMODE(INCREMENT)
    SCALE(2) INTENSITY(3) NEXTMODE(POINT)
    POINTX(XORIGIN) NEXTMODE(POINT)
    POINTY(YORIGIN) NEXTMODE(SUBROUTINE)
    SAVE diamond NEXTMODE(INCREMENT)
    SCALE(1) INTENSITY(3) NEXTMODE(POINT)
    POINTX(XORIGIN) NEXTMODE(POINT)
    POINTY(YORIGIN) NEXTMODE(SUBROUTINE)
    SAVE diamond NEXTMODE(INCREMENT)
    SCALE(0) INTENSITY(3) NEXTMODE(POINT)
    POINTX(XORIGIN) NEXTMODE(POINT)
    POINTY(YORIGIN) NEXTMODE(SUBROUTINE)
    SAVE diamond NEXTMODE(INCREMENT)
    STOP

diamond,
    INCVISIBLE SET1(INCRIGHT|INCUP) SET2(INCRIGHT|INCUP) SET3(INCRIGHT|INCUP) SET4(INCRIGHT|INCUP)
    INCVISIBLE SET1(INCRIGHT|INCDOWN) SET2(INCRIGHT|INCDOWN) SET3(INCRIGHT|INCDOWN) SET4(INCRIGHT|INCDOWN)
    INCVISIBLE SET1(INCLEFT|INCDOWN) SET2(INCLEFT|INCDOWN) SET3(INCLEFT|INCDOWN) SET4(INCLEFT|INCDOWN)
    INCVISIBLE SET1(INCLEFT|INCUP) SET2(INCLEFT|INCUP) SET3(INCLEFT|INCUP) SET4(INCLEFT|INCUP)
    INCDONE

start top
