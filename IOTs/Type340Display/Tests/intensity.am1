Test of the Type 340 display intensity settings
// Draw 8 vectors, one at each intensity level, increasing upwards
#include <TYPE340/type340defs.ah>

100/
top, lio [prog
    dla
    dss
    jmp .-1
    jmp top

// Begins in PARAM mode
prog, scale(0) intensity(0) next(point)
    y(0d512) next(point)
    x(0d512) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(1) next(point)
    y(0d524) next(point)
    x(0d512) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(2) next(point)
    y(0d534) next(point)
    x(0d512) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(3) next(point)
    y(0d544) next(point)
    x(0d512) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(4) next(point)
    y(0d554) next(point)
    x(0d512) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(5) next(point)
    y(0d564) next(point)
    x(0d512) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(6) next(point)
    y(0d574) next(point)
    x(0d512) show next(vector)
    visible up deltay(0) right deltax(0d120) end

    scale(0) intensity(7) next(point)
    y(0d584) next(point)
    x(0d512) show next(vector)
    visible up deltay(0) right deltax(0d120) end
    halt

start top
