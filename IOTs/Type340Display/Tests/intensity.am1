Test of the Type 340 display intensity settings
// Draw 8 vectors, one at each intensity level, increasing upwards
#include <TYPE340/type340defs.ah>

100/
top, lio [prog
    dla
    dss
    jmp .-1
    jmp top

// Begins in PARAM mode
prog, SCALE(0) INTENSITY(0) NEXTMODE(POINT)
    POINTY(0d512) NEXTMODE(POINT)
    POINTX(0d512) DRAWPOINT NEXTMODE(VECTOR)
    VECVISIBLE UP DELTAY(0) RIGHT DELTAX(0d120) VECDONE

    SCALE(0) INTENSITY(1) NEXTMODE(POINT)
    POINTY(0d524) NEXTMODE(POINT)
    POINTX(0d512) DRAWPOINT NEXTMODE(VECTOR)
    VECVISIBLE UP DELTAY(0) RIGHT DELTAX(0d120) VECDONE

    SCALE(0) INTENSITY(2) NEXTMODE(POINT)
    POINTY(0d534) NEXTMODE(POINT)
    POINTX(0d512) DRAWPOINT NEXTMODE(VECTOR)
    VECVISIBLE UP DELTAY(0) RIGHT DELTAX(0d120) VECDONE

    SCALE(0) INTENSITY(3) NEXTMODE(POINT)
    POINTY(0d544) NEXTMODE(POINT)
    POINTX(0d512) DRAWPOINT NEXTMODE(VECTOR)
    VECVISIBLE UP DELTAY(0) RIGHT DELTAX(0d120) VECDONE

    SCALE(0) INTENSITY(4) NEXTMODE(POINT)
    POINTY(0d554) NEXTMODE(POINT)
    POINTX(0d512) DRAWPOINT NEXTMODE(VECTOR)
    VECVISIBLE UP DELTAY(0) RIGHT DELTAX(0d120) VECDONE

    SCALE(0) INTENSITY(5) NEXTMODE(POINT)
    POINTY(0d564) NEXTMODE(POINT)
    POINTX(0d512) DRAWPOINT NEXTMODE(VECTOR)
    VECVISIBLE UP DELTAY(0) RIGHT DELTAX(0d120) VECDONE

    SCALE(0) INTENSITY(6) NEXTMODE(POINT)
    POINTY(0d574) NEXTMODE(POINT)
    POINTX(0d512) DRAWPOINT NEXTMODE(VECTOR)
    VECVISIBLE UP DELTAY(0) RIGHT DELTAX(0d120) VECDONE

    SCALE(0) INTENSITY(7) NEXTMODE(POINT)
    POINTY(0d584) NEXTMODE(POINT)
    POINTX(0d512) DRAWPOINT NEXTMODE(VECTOR)
    VECVISIBLE UP DELTAY(0) RIGHT DELTAX(0d120) VECDONE
    STOP

start top
