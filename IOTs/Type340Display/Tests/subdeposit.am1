Test of the Type 340 display subroutine deposit
// Draw three triangles vetically in vector mode via nested subroutines
#include <TYPE340/type340defs.ah>

#define XORIGIN 0d460
#define YORIGIN 0d700
#define SIDE 0d120

100/
top, lio [prog
    dla
    cla
    dss
    jmp .-1
    jmp top

// Begins in PARAM mode
prog, scale(0) intensity(4) next(subroutine)
    save subr next(subroutine)
    halt

triangle,
    visible up deltay(SIDE) right deltax(SIDE/2)
    visible down deltay(SIDE) right deltax(SIDE/2)
    visible deltay(0) left deltax(SIDE)
    end

subr,
    deposit done
    next(point)
    y(YORIGIN) next(point)
    x(XORIGIN) show next(subroutine)
    save triangle next(vector)
    next(point)
    y(YORIGIN - SIDE*2) next(point)
    x(XORIGIN) show next(subroutine)
    save triangle next(vector)
    next(point)
    y(YORIGIN - SIDE*4) next(point)
    x(XORIGIN) show next(subroutine)
    save triangle next(vector)
    next(subroutine)
done, 0

start top
