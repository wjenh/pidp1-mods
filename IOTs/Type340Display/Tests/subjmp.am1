Test of the Type 340 display subroutine mode
// Draw a triangle in vector mode, loop via jump
// This one is a different shape for variety.
#include <TYPE340/type340defs.ah>

#define XORIGIN 0d512
#define YORIGIN 0d512
#define SIDE 0d120

100/
top, lio [prog
    dla
    cla
loop, idx tmp
    jmp loop
tmp, 0

// Begins in PARAM mode
prog, scale(0) intensity(3) next(point)
    y(YORIGIN) next(point)
    x(XORIGIN) show next(vector)
    visible up deltay(SIDE) right deltax(SIDE/2)
    visible down deltay(SIDE) right deltax(SIDE/2)
    visible deltay(0) left deltax(SIDE)
    end
    next(subroutine)      // end sets parameter mode
    jump prog next(parameter)
    halt

start top
