Test of the Type 340 display test save and jump
// Draw three triangles in vector mode, side by side, via save and jump
#include <TYPE340/type340defs.ah>

#define XORIGIN 0d350
#define YORIGIN 0d800
#define SIDE 0d120

100/
top, lio [prog
    dla
    cla
    dss
    jmp .-1
    jmp top

// Begins in PARAM mode
prog, SCALE(0) INTENSITY(4) NEXTMODE(POINT)
    POINTY(YORIGIN) NEXTMODE(POINT)
    POINTX(XORIGIN) DRAWPOINT NEXTMODE(SUBROUTINE)
    SAVE triangle NEXTMODE(VECTOR)
    NEXTMODE(POINT)
    POINTY(YORIGIN - SIDE*2) NEXTMODE(POINT)
    POINTX(XORIGIN + SIDE) DRAWPOINT NEXTMODE(SUBROUTINE)
    SAVE triangle NEXTMODE(VECTOR)
    NEXTMODE(POINT)
    POINTY(YORIGIN - SIDE*4) NEXTMODE(POINT)
    POINTX(XORIGIN + SIDE*2) DRAWPOINT NEXTMODE(SUBROUTINE)
    SAVE triangle NEXTMODE(VECTOR)
    STOP

triangle,
    VECVISIBLE UP DELTAY(SIDE) RIGHT DELTAX(SIDE/2)
    VECVISIBLE DOWN DELTAY(SIDE) RIGHT DELTAX(SIDE/2)
    VECVISIBLE DELTAY(0) LEFT DELTAX(SIDE)
    VECDONE

start top
