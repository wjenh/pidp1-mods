Test of the Type 340 display, vector continue mode
// Draw a diagonal line
#include <TYPE340/type340defs.ah>

#define XORIGIN 0
#define YORIGIN 0

100/
top, lio [prog
    dla
    dss
    jmp .-1
    jmp top

// Begins in PARAM mode
prog, scale(0) intensity(3) next(point)
    y(YORIGIN) next(point)
    x(XORIGIN) show next(vcontinue)
    visible up deltay(0d50) right deltax(0d50)
    end
    halt

start top
