f13_lowcode: -O1 moves bank 0 code across the address a query's number names
bank 2
%%window wa, 1000, 1777
%%overlay o1, wa
o1Go, jmp .
%%endoverlay
%%overlay o2, wa
o2Go, jmp .
%%endoverlay
%%overlay o3, wa
o3Go, jmp .
%%endoverlay
%%overlay o4, wa
o4Go, jmp .
%%endoverlay
%%overlay o5, wa
o5Go, jmp .
%%endoverlay
%%overlay o6, wa
o6Go, jmp .
%%endoverlay
bank 0
4/
go,     lac val
%%optimize
        cla
        lac val
%%endoptimize
        dac val
        %%ovresident o6
        hlt
val,    0
%%ovtable
        start go
