Test rg10: local scoping
// predefined locals, addlocal (tgt joins the scope local c opened),
// loc/endloc abbreviations, privates
100/
    local a, b
    jmp a
    a, hlt
    b, hlt
    endlocal

    local c
    addlocal d, tgt
    jmp tgt
    c, hlt
    d, hlt
    tgt, hlt
    endlocal

    loc e
    e, hlt
    endloc

    private f
    local g
    f, 10
    endloc
    lac f
    endloc

stop
