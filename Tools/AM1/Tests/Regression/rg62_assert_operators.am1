Test rg62: the nine assert operators, each true and, under !, false
// Every assert holds. The words are those of the same program with its
// assert lines left blank, which the .ref pins. Comparisons are signed, -0
// equals +0, and an address above 0100000 is positive.
100/
go, lac hi:*
    hlt
assert 1 == 1 && !(1 == 2), "=="
assert 1 != 2 && !(0777777 != 0), "!="
assert -3 < 0 && !(0 < -3) && 0400000 < 0777776, "<"
assert -3 <= -3 && !(1 <= -3) && 0777777 <= 0, "<="
assert 2 > -1 && !(-1 > 2) && 0377777 > 0400000, ">"
assert 0 >= 0777777 && !(-1 >= 0), ">="
assert (1 == 1 && 5) && !(1 && 0) && !(0 && 1) && !(0 && 0), "&&"
assert (1 || 0) && (0 || 1) && (1 || 1) && !(0 || 0), "||"
assert !0 == 1 && !5 == 0 && !!5 == 1 && !-1 == 0, "!"
assert 0777777 == 0 && 0 == 0777777 && !(0777777 < 0) && !(0 < 0777777), "-0 and +0"
assert hi:* > 0100000 && hi:* == 0100200 && !(hi:* < 0), "above 0100000"
assert 1 || 0 && 0, "&& binds tighter than ||"
assert 1 < 2 == 1, "< binds tighter than =="
assert !(2 | 1 == 1), "== binds looser than |"
assert 1 + 1 == 2 && 6 - 2 * 2 > 1, "arithmetic first"
bank 010
200/
hi, 0
bank 0
start go
