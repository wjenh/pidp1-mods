   27       000001      cksdrm=1
   28                   
   29                   
   30                   / Which bank we load the track image into, 1
   31       010000      bnk=10000
   32       000001      bnkno=1
   33 00100             100/
   34                   
   35                   / load bank 1 mem from drum 010
   36 00100 220136           lio (drmrd 100000
   37 00101 720061           iot dia
   38 00102 764000           cli
   39 00103 720062           iot dwc
   40 00104 220137           lio (10000
   41 00105 720063           iot dcl
