Test of local scoping
100/
    var a=2
    private d

    loc a, b
    addlocal x, y, a2   // a2 was the ad-hoc local %a until task A36
    jmp a2
        local b
        lac x
        jmp c
        jmp a2
        jmp a
    b, 0
        endloc 2
    d, jmp b        // nested address declaration of outer scope declared but not resolved local
       jmp d
    a2, 0
    a, 1
    b, 0
    x, 0
    endloc
    endloc        // and the outermost scope closed

c, 3

start 100
