Test of local scoping
100/
    var a=2
    private d

    loc a, b
    addlocal x, y
    jmp %a
        local b
        lac x
        jmp c
        jmp %a
        jmp a
    b, 0
        endloc 2
    d, jmp b        // nested address declaration of outer scope declared but not resolved local
       jmp d
    %a, 0
    a, 1
    b, 0
    x, 0
    endloc
    endloc        // and the outermost scope closed

c, 3

start 100
