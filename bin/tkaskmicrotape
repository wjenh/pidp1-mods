#!/bin/python3

# The file dialog pdp1central's Microtape tab uses: it takes an existing tape or a new name,
# since mtp mounts either (a new one is made blank when the tape is first used). A save dialog
# takes both; with confirmoverwrite off it does not ask whether to replace an existing file,
# which mounting never does. The chosen path is printed; nothing is printed on cancel.
# Usage: tkaskmicrotape [directory]     the directory to start in
#
# 02-Oct-2026 wje (Claude) - written.

import sys
import tkinter
import tkinter.filedialog

start = sys.argv[1] if len(sys.argv) > 1 else '/opt/pidp1-mods/Microtapes'
root = tkinter.Tk()
root.withdraw()
file = tkinter.filedialog.asksaveasfilename(initialdir=start, confirmoverwrite=False,
    title='Mount a microtape')
if file:
    print(file)
