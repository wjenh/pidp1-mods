# This file sets startup defaults for various configurable features.
# Comment lines like this and empty lines are ignored.
# Otherwise, lines of the form 'option=value' are recognized.
# Spaces are ignored.
# For options that are on or off, 'y', 'yes', 'on' all mean enabled,
# any other value means off.

# The debugger server that ad1 and fastload connect to, one client at a time, on either port.
# ad1port is the loopback port (localmachine, 127.0.0.1 only).
# Set it to 0 or off to disable it.
# The default is port 1044 and enabled.
#ad1port=1044

# ad1remoteport listens on all interfaces at the same time as ad1port.
# It is off by default, uncomment to allow remote debugging and fastloading.
# IT HAS NO AUTHENTICATION, enable it only on a network you trust.
# Use ad1 -h host:port to reach it from another machine.
#ad1remoteport=1045

# The throttle paces the emulated CPU to real time.
# It runs the CPU until simtime is ahead of the wall clock by throttleburst microseconds,
# then waits in chunks of at most throttlequantum microseconds, rechecking after each chunk.
# The default (1000) reproduces the emulator's original cadence, a burst of cycles followed by
# about a millisecond of waiting.
# A shorter quantum (try 100 or 50) makes anything paced by the wall clock track real time more closely
# at the cost of more wakeups per second on the host.
#throttlequantum=1000

# throttleburst is how far, in microseconds, simtime must get ahead of the wall clock before the
# throttle waits at all.
# The default, 100, runs about 20 cycles between waits, so the host wakes the emulator far less
# often.
# 0 waits whenever simtime is ahead at all, one to five cycles between waits, the behavior before
# this setting.
# The most is 250, since the Type 340 runs on the wall clock and can absorb a lead only up to that.
#throttleburst=100

# throttlespin is the final stretch of each wait, in microseconds, that busy-spins on the CPU
# instead of sleeping to avoid the scheduler's wakeup latency at very short quanta.
# 0, the default, never spins.
# 5 measurements found little headroom to spare for it once a Type 340 program and the panel driver
# are also running, so raise it only if a shorter throttlequantum alone is not enough
# and a CPU core can be spared for it.
#throttlespin=0

# throttlemaxlag bounds how long, in milliseconds, the throttle will run flat out
# to catch up after real time gets far ahead of simtime.
# Past this, the rest of the deficit is forgiven rather than run off in one unpaced burst.
# The default, 20 is well above anything an ordinary running program should see,
# it should only ever fire after a real stall.
#throttlemaxlag=20

# Enable/disable various PDP-1D extensions
# lai and lia are available in the main branch pidp1 if compiled in.
# Here they are controlled by this setting.
# This also enables lsw/swp, since those are just an or of lai and lia.
lailia=on

# Enable the PDP-1D extensions, lai, lia, sni, szi, cmi, lsw/swp, but not the extended-extended ones.
# Enabling this DOES enable lailia even if they are disabled above.
# Disabling this does NOT disable lailia if enabled above.
core1D=on

# Enable all PDP-1D extensions including lai, lia, sni, szi, cmi, lsw/swp, scf, sci, iif, ifi, and ida.
# Enabling this DOES enable lailia and core1D even if disabled above
# Disabling this does NOT disable lailia or core1D if they are enabled above.
all1D=on

# Enable/disable various features.
muldiv=on
# This is the 16 channel break system.
sbs16=off

# sdb and dpyshift can conflict.
# sdb is an extended version of dpy used by the Type 33 Symbol Generator.
# dpyshift is an extended version of dpy that allows origin-shifting, implemented by sonme PDP-1's.
# If both are on, an attempt is made to distinguish between them, but it's possible the wrong
# choice will be made.
# If so, sdb will be done, then dpyshift.
# This will make any symbol generator chars positioned incorrectly.
# If you get strange behavior, turn one off, preferably dpyshift.
sdb=on
dpyshift=off

# Apparently there was at least one PDP-1 that supported dual screens for spacewar.
# There is some support for this, but it has not been tested, not sure it's even important.
# It used a hack with the intensity setting in the dpy command that will break a lot of other stuff.
twoscreens=off

# Enable lightpen support in pidp1.
lightpen=on
# Enable motion filtering
motionPrediction=on

# An aperture of 22 corresponds to a physical aperture of 0.200 inches.
aperture=22

# The gui and Type 30 of course need to be able to find the config tile for these to work.
# If running on a remote system, copy the config file to /opt/pidp1-mods on that system,
# or use the command line flags if available.

# The unified control gui checks this.
guilightpen=yes

# The standalone type 30 display checks this.
type30lightpen=yes
# The default size is 1024, change to what you want, also via command line -s size.
type30size=1024
# The default is yes, also via sommand line -n, for no border.
type30border=yes

# The type 340 display checks this.
# If two charsets are enabled, then lower-shift characters come from the second one.
# If not, lower-shift means display characters vertially.
two340charsets=no

# The following control the audio subsystem.
# These values give excellent results.
# It is important to read the UsingAudio.md document in Docs before changing values!!!
# gain sets the 4 channel mixer gain, caution, too high and clipping will occur.
# tuning shifts the frequency, only available if SDL3 is present.
# pdp1audio changes all of these while the emulator runs.
# audio=on allows audio, but it still must be turned on via pdp1audio.
audio=off

# Each program flag goes through its own RC low-pass filter, just like the original and the
# Computer History Museum's PDP-1.
# Each channel corresponds to a program flag, PF1-4.
# cutoff sets the -3 dB point of all four outputs, in Hz; cutoff1-cutoff4 set each separately
# and override cutoff. A flag with neither gets the default, below.
# The hardware's analog filters had cutoffs of 1020, 925, 423 and 220 Hz according to figures provided by
# the Computer History Museum and should give the original authentic sound.
# The filters run on the emulator's clock so the sample rate does not change them.
# cutoff by itself isn't authentic, but gives a reasonable compromise sound.
#cutoff=781
cutoff1=1020
cutoff2=925
cutoff3=423
cutoff4=220

# Gain adjusts the volume, but a value that is too large will cause clipping of the audio, adjust with caution.
gain=0.95

# The real PDP-1s didn't have a precision clock controlling the 5 usec cycle time.
# Instead, each had a simple oscillator that was not crystal controlled.
# This meant that not only did different PDP-1s have slightly different cycle times,
# a given PDP-1's cycle time drifted over time.
# Tuning adjusts the precise frequency the emulator uses to simulate the original PDP-1 drift.
# If you watch any videos of Peter Samson using his music program on the real PDP-1, you'll see him
# frequently changing switches.
# He's adjusting the timing of the synthesizer loop in real time. By ear.
# If you have good pitch recognition and a particular piece of music sounds flat or sharp, adjust this value.
# This feature only works for the SDL3 version, SDL2 doesn't have the capability.
tuning=1.0

# Samplerate sets how often audio is sent to SDL in rate samples per second.
# The samples are timed by the emulator clock so any rate is exact and each sample reads
# the filters at the emulator cycle rate.
# Neither the cutoffs nor the PF edges depend on samplerate.
# 48000 is the native rate of most USB audio devices, this avoids SDL sampling conversions.
samplerate=48000

# audiodepth is how much sound, in milliseconds, is kept queued ahead of the audio device.
# A pause of the emulator shorter than this is not heard.
# It is also how far the sound trails the program flag lamps, not noticeable visually.
# The emulator holds the queue near this depth by itself, matching the audio device's real playback
# rate so the sound stays synchronized with the PF lights.
# Range 10 to 500, default 40.
# Keep it above what the audio device takes at a time, commonly about 20 ms, or it will run out of samples
# and the sound will break up.
# 30 or more is safe.
# With a tuning other than 1.0 the sound can't stay with the lamps, it is played faster or slower
# than the program runs.
# The queue is then only kept from growing past 250 ms, or four times the depth if it is more.
audiodepth=40

# Settings for the IOT 45 line printer
# The line printer type defaults to Type 62
lptType64=false

# Set the number of lines the spacing field advances for setting 0-7.
# A setting of 0 means overstrike, -1 means form feed.
# Note that the Type 62 does overstrikes differently, so setting it here isn't necessary.
# This is for the Type 62.
# For the 64, typical would be 0,1,2,3,11,22,33,44,-1
lptLineSpacing=1,2,3,4,11,22,33,-1
# Set the lines per page.
# The default is 66 lines per page.
# This affects the delay time when a form feed is requested.
lptLines=66
# Normally, a form feed puts a form feed character in the file.
# If this is on, the necessary number of newlines is used instead.
lptNoFF=yes

# A new memory image file format is provided and is recommended.
# It is much easier to read.
# If this is on, the new format will be used, else the old format.
# If on, old or new format files will be read but saved in the new format.
# If off, old or new format files will be read but saved in the old format.
# Basically, this is transparent to pidp-1, it's for human convenience.
newmemfile=true

# Timing statistics can be gathered for the pidp-1 intruction cycle time.
# If enabled, whenever the pidp-1 enters stop state, the current timing data
# is written to the file /tmp/pidp1-timing.txt in readable form.
# The file will grow as long as timing is on, updated on each stop.
# Remove it when you are done with it.
# This is primarily useful for seeing now much time is being used in a cycle.
pidp1timing=off

# Timing statistics for the displays, separate from pidp1timing.
# If enabled, the Type 340 thread appends one line a second to /tmp/pidp1-340timing.txt while it is
# running a display program, and the display worker appends one line a second to
# /tmp/pidp1-dpytiming.txt for as long as the display subsystem is running, halted or not.
# Both files grow as long as this is on, remove them when you are done with them.
# This is only useful for looking at how the display threads spend their host time.
displaytiming=off

# Adjust the maximum brightness of the hardware panel lights.
# This is an integer number ranging from 0 to 100, off to max brightness.
# Many people think full bright is too bright, adjust as you like.
# This is a brightness cap, not a scaliing factor, so dimmer lights will still appear as they should.
panelbrightness=80

# Adjust the light turnon and turnoff times.
# These are floating point numbers ranging from 0.0 to 1.0, SEE THE DOCUMENTATION.
# These values are not correct to closely mimic the original ones, but it looks nice.
# The proper ones are in the documentation.
panelonalpha=0.45
paneloffalpha=0.04

# This determines whether or not the new panel driver sets realtime fifo priority.
# It is generally not needed, but if flicker is a problem, enable it.
# It has essentially no cpu loading impact.
panelrealtime=false

# These tune the new panel driver's lamp scanning, for the hardware panel.
# The values shown are the driver's own defaults.
# panellevels is the number of brightness levels each lamp can show, 8 to 64.
# The row scan time stays the same, so more levels means shorter steps between them.
#panellevels=8
# panelcycletime is how often, in microseconds, the lamp brightnesses are recomputed from the
# emulator's counts, at least 100.
# At the emulator's 5 us cycle, 1000 is about 200 cycles a sample.
#panelcycletime=1000
# panelscantime is the time, in microseconds, to scan one row of lamps through all its levels,
# at least 100.
#panelscantime=1000

# If you get to the point you just can't stand waiting on the (accurately) slow typewriter,
# you can pretend someone invented a supercharged soroban and up it to 200 chars/sec instead of 10.
# Heresy? Well,then don't use it.
fasttyo=false

# Type 550 Microtape break channel.
# Set the sequence break channel for the data, block end, and error flags.
# The default is 2.
#microtapesbs=2
