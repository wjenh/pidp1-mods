CC=gcc -O3 -Wall
#CC=gcc -g -Wall

INC=-I..

# Detect SDL3 here,  a plain "make" in this directory will build the correct version of audio.c and link properly.
# pkg-config is used rather than dpkg-query (which is what install.sh uses for the same check)
# because this project targets Linux generally, not just Debian/Ubuntu derivatives.
# If pkg-config itself isn't present, this degrades gracefully to the SDL2 path rather than failing the build.
HAVE_SDL3 := $(shell pkg-config --exists sdl3 2>/dev/null && echo 1)

ifeq ($(HAVE_SDL3),1)
LIBS=-lpthread -lm -lSDL3
else
LIBS=-lpthread -lm -lSDL2
endif

# 21-Jun-2026 wje (Claude) - restructured.
# (wje - Claude rocks for things like this. Welcome to the new world.)
# Previously most sources were fed straight into the
# final link command as raw .c files, so they were recompiled from scratch on every build whether
# they had changed or not, and header dependencies were hand-maintained per file (and had drifted
# out of date, e.g. pdp1.o's rule was missing ../common.h). Every source, including the ones that
# live one directory up, now gets a real .o with a real timestamp, and -MMD/-MP let gcc discover
# header dependencies itself rather than someone maintaining that list by hand.
# Add a new source by adding it to LOCAL_SRCS for those in this directory  or PARENT_SRCS
# for those one directory up. Nothing else needs to change.
LOCAL_SRCS = main.c panel1.c typtelnet.c audio.c lowpass.c pdp1.c dynamicIots.c \
    highSpeedChannels.c configuration.c display.c lpPredictor.c ad1server.c console.c papertape.c
PARENT_SRCS = ../common.c ../pollfd.c ../logger.c

OBJS = $(LOCAL_SRCS:.c=.o) $(notdir $(PARENT_SRCS:.c=.o))
DEPS = $(OBJS:.o=.d)

.PHONY: all clean

all: pdp1

# symbol-exports.ldr lists what the plugins may call, so a change to it alone relinks.
pdp1: $(OBJS) symbol-exports.ldr
	$(CC) -Wl,--dynamic-list=symbol-exports.ldr -o $@ $(OBJS) $(LIBS)

# Compile rule for sources in this directory.
%.o: %.c
	$(CC) -c $< $(INC) -MMD -MP -o $@

# Compile rule for sources living in the parent directory. The object still lands here, since
# that's where the final link step looks for it.
%.o: ../%.c
	$(CC) -c $< $(INC) -MMD -MP -o $@

# audio.c's #include of sdl3.h has to see a current copy, not a stale one from a previous build
# under different SDL availability. The pattern rule above doesn't know about that on its own
# (and parallel builds, e.g. "make -j", can't be trusted to order things correctly without an
# explicit edge), so this adds the one prerequisite that actually matters by hand.
audio.o: sdl3.h

# Auto-generated header dependencies, one per object file, produced by -MMD/-MP above. The
# leading "-" means a missing .d (e.g. before the first build has ever run) is not an error.
-include $(DEPS)

# sdl3.h is checked against the HAVE_SDL3 test above every time this file is read, so it can never
# disagree with the library actually being linked, but it is rewritten only when the answer
# changes. So audio.o is recompiled when SDL3 comes or goes, and not otherwise, and an unchanged
# tree is up to date (make -q). It always exists; for SDL2 it holds no define. audio.c guards its
# #include of it with __has_include, so a fresh checkout that has never been built still compiles.
# 27-Sep-2026 Claude: written only on a change; before, it was phony and rewritten on every build,
# which recompiled audio.c and relinked pdp1 every time.
$(shell if [ "$(HAVE_SDL3)" = 1 ]; then d='\043define HAVE_SDL3 1'; \
    else d='// SDL2: HAVE_SDL3 is not defined'; fi; \
    printf "// Generated by Makefile. Do not edit -- rewritten when the SDL3 check's answer changes.\n$$d\n" > sdl3.h.new; \
    if cmp -s sdl3.h.new sdl3.h; then rm -f sdl3.h.new; else mv -f sdl3.h.new sdl3.h; fi)

clean:
	rm -f $(OBJS) $(DEPS) sdl3.h pdp1
