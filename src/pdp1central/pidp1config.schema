# The pidp1.config settings, for pdp1central's settings editor.
# A 'reader', below is the program that uses a setting.
# One setting per line: name|group|type|range|default|reader|applies|label|summary
# name: the setting name as it appears in the config file.
# type: bool, int, float, text, choice, or port (an int, or off).
# range: lowval..highval, or empty for no restriction.
#   For float or int, lowval..highval.
#   For choice, str[,str...]
# default: what the reader uses when the config file has no setting; - when there is no single value.
# applies: when a change takes effect.
#   reload is a SIGHUP to pdp1, panel is a SIGHUP to the panel driver, run is a SIGHUP to pdp1 after
#     which it applies when the emulator goes to run state (START or CONTINUE),
#   restart is a pdp1 restart,
#   program is a restart of the reader,
#   none is never,
#   -sticky can be appended, the reader assigns the setting only when a config file line is present,
#     a new value applies but going back to the default needs a restart of the reader.
# label: if present, is displayed as the name instead of the name field.
# summary: in the editor as the "tool tip" when the entry is hovered over.
# Docs/UsingTheConfigFile.md describes each setting, pidp1.config.example shows the use.

# Debugger
ad1port|Debugger|port|0..65535|1044|pdp1|restart||The local port ad1 and fastload connect to; 0 or off disables it
ad1remoteport|Debugger|port|0..65535|off|pdp1|restart||The port on all interfaces, the port a remote debugger uses

# Emulator tuning
throttleburst|Throttle|int|0..250|10|pdp1|reload||How far, in microseconds, simulated time must lead the wall clock before the throttle waits
throttlequantum|Throttle|int|0..1000000|1000|pdp1|reload||The longest single wait, in microseconds
throttlespin|Throttle|int|0..1000000|0|pdp1|reload||Time in microseconds spent spinning instead of sleeping
throttlemaxlag|Throttle|int|0..1000000|20|pdp1|reload||How far, in milliseconds, the emulator can fall behind before a wwait is skipped
pidp1timing|Timing|bool||off|pdp1|reload-sticky||Append the emulator's timing to /tmp/pidp1-timing.txt at each stop

# Emulator features
lailia|CPU|bool||off|pdp1|reload||The PDP-1D lai and lia instructions, always on if core1D or all1D is on
core1D|CPU|bool||on|pdp1|reload||The core PDP-1D extensions; always on while all1D is on
all1D|CPU|bool||off|pdp1|reload||All the PDP-1D extensions
muldiv|CPU|bool||on|pdp1|reload||Hardware multiply and divide
sbs16|CPU|bool||off|pdp1|reload||The 16-channel sequence break system

# Display features
aperture|Displays|int|1..63|22| Type 30 and 340|run-sticky||The lightpen's aperture, 22 is 0.200 inches
# Type 30
sdb|Displays|bool||off|Type 30|run||The Type 33 symbol generator's extended dpy
dpyshift|Displays|bool||off|Type 30|run||The origin-shifting extended dpy, can conflict with sdb
twoscreens|Displays|bool||off|Type 30|run||Dual Type 30 screens, untested
# Type 340
two340charsets|Displays|bool||off|Type 340|reload-sticky||Lower-shift characters from the second character set
# Misc display
guilightpen|Displays|bool||off|pdp1_periph|program||The lightpen in the unified control gui
displaytiming|Timing|bool||off|pdp1|restart||Append the display threads' timing to /tmp/pidp1-340timing.txt and /tmp/pidp1-dpytiming.txt; the 340 follows a reload, the 30 only a restart

# Audtio features
audio|Audio|bool||off|pdp1|reload|audio enabled|Allows audio; Turn audio on (Control tab) or pdp1audio on starts it
cutoff|Audio|float|1.0..100000.0|-|pdp1|reload||The low-pass cutoff of all four program flag channels, in Hz, default is the CHM values
cutoff1|Audio|float|1.0..100000.0|1020|pdp1|reload||Program flag 1's cutoff in Hz, default is CHM value
cutoff2|Audio|float|1.0..100000.0|925|pdp1|reload||Program flag 2's cutoff in Hz, default is CHM value
cutoff3|Audio|float|1.0..100000.0|423|pdp1|reload||Program flag 3's cutoff in Hz, default is CHM value
cutoff4|Audio|float|1.0..100000.0|270|pdp1|reload||Program flag 4's cutoff in Hz, default is CHM value
gain|Audio|float|0.0..100.0|0.95|pdp1|reload||The mixer gain; too high and the sound clips
tuning|Audio|float|0.001..100.0|1.0|pdp1|reload||Shifts the frequency; SDL3 only
samplerate|Audio|int|8000..192000|48000|pdp1|reload||Samples a second sent to SDL
audiodepth|Audio|int|10..500|40|pdp1|reload||Milliseconds of sound kept queued ahead of the device
# The 4-channel DAC
dacgain|Audio|float|0.0..100.0|1.0|DAC|reload||The DAC mixer gain
dacroom|Audio|text||voices|DAC|reload||The DAC room setting
daconset|Audio|int|0..1000|8|DAC|reload||The DAC onset delay, in milliseconds

# Misc device features
fasttyo|Devices|bool||off|typewriter|reload||output at 200 characters a second instead of 10
punchspeed|Devices|int|63..1000|63|punch|reload||Typewriter output at 200 characters a second instead of 10

# Line printer features
lptType64|Devices|bool||off|printer|restart||A Type 64 line printer instead of a Type 62
lptLineSpacing|Devices|text||-|printer|restart||Lines advanced for each spacing setting 0-7, comma separated with no spaces, such as 1,2,3,4,11,22,33,-1
lptLines|Devices|int|1..1000|66|printer|restart||Lines per page
lptNoFF|Devices|bool||off|printer|restart||Newlines instead of a form feed character

# Microtape features
microtapesbs|Devices|int|0..15|2|Microtape|reload||The Type 550 microtape's sequence break channel

# Plotter features
plottermodel|Devices|choice|560,563,565|560|Plotter|reload||The plotter type, CalComp 560, 563, or 565
plotterfile|Devices|text||plotter.png|Plotter|reload||The filename to save a plot to, %d numbers sheets, relative to /opt/pidp1-mods unless /path
plotterstep|Devices|int|0..100000|5000|Plotter|reload||The time in microsecs a pen move takes
plotterpendown|Devices|int|0..1000|100|Plotter|reload||The time in millisecs a pen down takes
plotterpenup|Devices|int|0..1000|100|Plotter|reload||The time in millisecs pen up takes
plotterpen|Devices|int|1..50|1|Plotter|reload||The width of the line the pen draws
plotteridle|Devices|int|0...30|5|Plotter|reload||The idle time in seconds before a print is saved, 0 is never
plottersbs|Devices|int|0...15|0|Plotter|reload||The sbs channel the plotter uses, 1-15, 0 for none
plottercks|Devices|int|0...17|7|Plotter|reload||The cks bit the plotter uses, 0-17
plotterorigin|Devices|int|0..7|0|Plotter|reload||The steps from the paper left edge where the pen starts

# Hardware panel features
panelbrightness|Panel|int|0..100|100|newpanel|panel-sticky||The brightness cap of the hardware panel's lamps
panelonalpha|Panel|float|0.0..1.0|0.45|newpanel|panel-sticky||The lamps' turn-on rate
paneloffalpha|Panel|float|0.0..1.0|0.04|newpanel|panel-sticky||The lamps' turn-off rate
panelrealtime|Panel|bool||off|newpanel|restart||Realtime priority for the panel driver
panellevels|Panel|int|8..64|8|newpanel|panel-sticky||Brightness levels
panelcycletime|Panel|int|100..1000000|1000|newpanel|panel-sticky||How often the lamp brightnesses are recomputed, in microseconds
panelscantime|Panel|int|100..1000000|1000|newpanel|panel-sticky||The time to scan one row of lamps, in microseconds
